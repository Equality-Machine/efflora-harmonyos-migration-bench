+import { AegisActivity, PAGE_INTRO } from './AegisActivity';
+import { RESULT_OK } from './Intent';
+import { Dialogs } from './dialogs/Dialogs';
+import { IntroBaseActivity } from './intro/IntroBaseActivity';
+import { SlideIndicator } from './intro/SlideIndicator';
+import { WelcomeSlide, WelcomeSlideView } from './slides/WelcomeSlide';
+import { SecurityPickerSlide, SecurityPickerSlideView } from './slides/SecurityPickerSlide';
+import { SecuritySetupSlide, SecuritySetupSlideView } from './slides/SecuritySetupSlide';
+import { DoneSlide, DoneSlideView } from './slides/DoneSlide';
+import { VaultFile } from '../vault/VaultFile';
+import { VaultRepository } from '../vault/VaultRepository';
+import { ThemeHelper } from '../helpers/ThemeHelper';
+import { AegisModule } from '../AegisModule';
+import { NotificationService } from '../services/NotificationService';
+
+/**
+ * Port of IntroActivity (the controller part, extending IntroBaseActivity).
+ */
+export class IntroActivityController extends IntroBaseActivity {
+  private _activity: AegisActivity;
+
+  constructor(uiContext: UIContext, activity: AegisActivity) {
+    super(uiContext);
+    this._activity = activity;
+    this.addSlide(new WelcomeSlide());
+    this.addSlide(new SecurityPickerSlide());
+    this.addSlide(new SecuritySetupSlide());
+    this.addSlide(new DoneSlide());
+  }
+
+  protected onBeforeSlideChanged(oldSlide: string | null, newSlide: string): boolean {
+    try {
+      this._activity.getUIContext().getFocusController().clearFocus();
+    } catch (e) {
+      // ignore
+    }
+
+    if (oldSlide === SecurityPickerSlide.TYPE
+      && newSlide === SecuritySetupSlide.TYPE
+      && this.getState().cryptType === SecurityPickerSlide.CRYPT_TYPE_NONE) {
+      this.skipToSlide(DoneSlide.TYPE);
+      return true;
+    }
+
+    if (oldSlide === WelcomeSlide.TYPE
+      && newSlide === SecurityPickerSlide.TYPE
+      && this.getState().imported) {
+      this.skipToSlide(DoneSlide.TYPE);
+      return true;
+    }
+
+    return false;
+  }
+
+  protected onAfterSlideChanged(oldSlide: string | null, newSlide: string): void {
+    // request permission to show the "vault unlocked" notification
+    if (newSlide === DoneSlide.TYPE && this.getState().creds !== null) {
+      NotificationService.requestPermission(AegisModule.getAbilityContext());
+    }
+  }
+
+  protected onDonePressed(): void {
+    const state = this.getState();
+    const creds = state.creds;
+    const vaultManager = this._activity.getVaultManager();
+    if (!state.imported) {
+      const cryptType = state.cryptType;
+      if (cryptType === SecurityPickerSlide.CRYPT_TYPE_INVALID
+        || (cryptType === SecurityPickerSlide.CRYPT_TYPE_NONE && creds !== null)
+        || (cryptType === SecurityPickerSlide.CRYPT_TYPE_PASS && (creds === null || !creds.getSlots().hasPasswordSlot()))
+        || (cryptType === SecurityPickerSlide.CRYPT_TYPE_BIOMETRIC && (creds === null || !creds.getSlots().hasPasswordSlot()
+          || !creds.getSlots().hasBiometricSlot()))) {
+        throw new Error(`State of SecuritySetupSlide not properly propagated, cryptType: ${cryptType}`);
+      }
+
+      try {
+        vaultManager.initNew(cryptType === SecurityPickerSlide.CRYPT_TYPE_NONE ? null : creds);
+      } catch (e) {
+        Dialogs.showErrorDialog(this._activity.getUIContext(), $r('app.string.vault_init_error'), e as Error);
+        return;
+      }
+    } else {
+      let vaultFile: VaultFile;
+      try {
+        vaultFile = VaultRepository.readVaultFile(AegisModule.getContext());
+      } catch (e) {
+        Dialogs.showErrorDialog(this._activity.getUIContext(), $r('app.string.vault_load_error'), e as Error);
+        return;
+      }
+
+      try {
+        vaultManager.loadFrom(vaultFile, creds);
+      } catch (e) {
+        Dialogs.showErrorDialog(this._activity.getUIContext(), $r('app.string.vault_load_error'), e as Error);
+        return;
+      }
+    }
+
+    this._activity.getPreferences().setIntroDone(true);
+    this._activity.setResult(RESULT_OK, null);
+    this._activity.finish();
+  }
+}
+
+@Entry
+@Component
+struct IntroActivity {
+  private _activity: AegisActivity = new AegisActivity(this.getUIContext(), PAGE_INTRO);
+  private _intro: IntroActivityController = new IntroActivityController(this.getUIContext(), this._activity);
+  private _swiperController: SwiperController = new SwiperController();
+  @State slidePosition: number = 0;
+
+  aboutToAppear(): void {
+    this._activity.onCreate();
+    this._activity.setOnLockedCallback((userInitiated: boolean) => {
+    });
+    this._intro.setOnPositionChangedListener((position: number) => {
+      this.slidePosition = position;
+      this._swiperController.changeIndex(position, true);
+    });
+  }
+
+  onPageShow(): void {
+    this._activity.onResume();
+  }
+
+  aboutToDisappear(): void {
+    this._activity.onDestroy();
+  }
+
+  onBackPress(): boolean {
+    this._intro.goToPreviousSlide();
+    return true;
+  }
+
+  private getWelcome(): WelcomeSlide {
+    return this._intro.getSlide(WelcomeSlide.TYPE) as WelcomeSlide;
+  }
+
+  private getPicker(): SecurityPickerSlide {
+    return this._intro.getSlide(SecurityPickerSlide.TYPE) as SecurityPickerSlide;
+  }
+
+  private getSetup(): SecuritySetupSlide {
+    return this._intro.getSlide(SecuritySetupSlide.TYPE) as SecuritySetupSlide;
+  }
+
+  build() {
+    Column() {
+      Swiper(this._swiperController) {
+        WelcomeSlideView({ slide: this.getWelcome() })
+        SecurityPickerSlideView({ slide: this.getPicker() })
+        SecuritySetupSlideView({ slide: this.getSetup() })
+        DoneSlideView()
+      }
+      .index(this.slidePosition)
+      .loop(false)
+      .indicator(false)
+      .disableSwipe(true)
+      .layoutWeight(1)
+
+      Row() {
+        Button() {
+          Image($r('app.media.ic_outline_arrow_left_alt_24'))
+            .width(24)
+            .height(24)
+            .fillColor($r('app.color.theme_onSurface'))
+        }
+        .type(ButtonType.Circle)
+        .width(48)
+        .height(48)
+        .backgroundColor(Color.Transparent)
+        .visibility(this._intro.isPreviousVisible() && this.slidePosition >= 0 ? Visibility.Visible : Visibility.Hidden)
+        .id('btnPrevious')
+        .onClick(() => this._intro.goToPreviousSlide())
+
+        SlideIndicator({ slideCount: this._intro.getSlides().length, currentSlide: this.slidePosition })
+          .layoutWeight(1)
+
+        Button() {
+          Image(this._intro.isLastSlide() && this.slidePosition >= 0 ? $r('app.media.ic_outline_check_24') :
+            $r('app.media.ic_outline_arrow_right_alt_24'))
+            .width(24)
+            .height(24)
+            .fillColor($r('app.color.theme_onPrimary'))
+        }
+        .type(ButtonType.Circle)
+        .width(56)
+        .height(56)
+        .backgroundColor($r('app.color.theme_primary'))
+        .id('btnNext')
+        .onClick(() => this._intro.goToNextSlide())
+      }
+      .width('100%')
+      .padding({ left: 16, right: 16, bottom: 24, top: 8 })
+      .justifyContent(FlexAlign.Center)
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
