+
+  /**
+   * Decodes the picked image, downsampling very large images (like Glide does for the KropView).
+   */
+  private static async decodeForEditing(bytes: Uint8Array): Promise<image.PixelMap> {
+    const maxSize = 2048;
+    const source = image.createImageSource(BitmapHelper.toArrayBuffer(bytes));
+    try {
+      const size = source.getImageInfoSync().size;
+      if (size.width > maxSize || size.height > maxSize) {
+        const ratio = Math.min(maxSize / size.width, maxSize / size.height);
+        const opts: image.DecodingOptions = {
+          desiredSize: { width: Math.max(1, Math.floor(size.width * ratio)), height: Math.max(1, Math.floor(size.height * ratio)) }
+        };
+        return await source.createPixelMap(opts);
+      }
+      return await source.createPixelMap();
+    } finally {
+      source.release();
+    }
+  }
