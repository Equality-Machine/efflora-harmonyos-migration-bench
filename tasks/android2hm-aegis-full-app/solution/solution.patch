@@ -0,0 +1,114 @@
+import { fileIo } from '@kit.CoreFileKit';
+import { ProgressDialogTask } from './ProgressDialogTask';
+import { AegisModule } from '../../AegisModule';
+import { IOUtils } from '../../util/IOUtils';
+
+export class ImportFileTaskParams {
+  private readonly _uri: string;
+  private readonly _namePrefix: string | null;
+  private readonly _nameSuffix: string | null;
+
+  constructor(uri: string, namePrefix: string | null, nameSuffix: string | null) {
+    this._uri = uri;
+    this._namePrefix = namePrefix;
+    this._nameSuffix = nameSuffix;
+  }
+
+  getUri(): string {
+    return this._uri;
+  }
+
+  getNamePrefix(): string | null {
+    return this._namePrefix;
+  }
+
+  getNameSuffix(): string | null {
+    return this._nameSuffix;
+  }
+}
+
+export class ImportFileTaskResult {
+  private readonly _uri: string;
+  private readonly _file: string | null;
+  private readonly _e: Error | null;
+
+  constructor(uri: string, file: string | null, e: Error | null) {
+    this._uri = uri;
+    this._file = file;
+    this._e = e;
+  }
+
+  getUri(): string {
+    return this._uri;
+  }
+
+  /**
+   * Returns the sandbox path of the temporary copy of the file.
+   */
+  getFile(): string | null {
+    return this._file;
+  }
+
+  getError(): string | null {
+    if (this._e === null) {
+      return null;
+    }
+
+    return `ImportFileTask(uri="${this._uri}"): ${this._e.name}: ${this._e.message}`;
+  }
+}
+
+export type ImportFileTaskCallback = (result: ImportFileTaskResult) => void;
+
+/**
+ * ImportFileTask reads a file picked through the DocumentViewPicker and
+ * writes it to a temporary file in the cache directory.
+ */
+export class ImportFileTask extends ProgressDialogTask {
+  private readonly _cb: ImportFileTaskCallback;
+
+  constructor(uiContext: UIContext, cb: ImportFileTaskCallback) {
+    super(uiContext, $r('app.string.reading_file'));
+    this._cb = cb;
+  }
+
+  execute(params: ImportFileTaskParams): void {
+    this.run<ImportFileTaskResult>(async () => ImportFileTask.doInBackground(params))
+      .then((result: ImportFileTaskResult) => this.onPostExecuteResult(result))
+      .catch((e: Error) => this.onPostExecuteResult(new ImportFileTaskResult(params.getUri(), null, e)));
+  }
+
+  private onPostExecuteResult(result: ImportFileTaskResult): void {
+    this._cb(result);
+  }
+
+  static doInBackground(p: ImportFileTaskParams): ImportFileTaskResult {
+    const uri = p.getUri();
+    try {
+      const prefix = p.getNamePrefix() !== null ? `${p.getNamePrefix()}-` : '';
+      const suffix = p.getNameSuffix() !== null ? `-${p.getNameSuffix()}` : '';
+      const tempFile = ImportFileTask.createTempFile(prefix, suffix, AegisModule.getContext().cacheDir);
+      IOUtils.copy(uri, tempFile);
+      return new ImportFileTaskResult(uri, tempFile, null);
+    } catch (e) {
+      return new ImportFileTaskResult(uri, null, e as Error);
+    }
+  }
+
+  /**
+   * Replacement for File.createTempFile(prefix, suffix, dir).
+   */
+  static createTempFile(prefix: string, suffix: string, dir: string): string {
+    IOUtils.mkdirs(dir);
+    for (let i = 0; i < 100; i++) {
+      const rand = Math.floor(Math.random() * 0x7fffffff);
+      const path = `${dir}/${prefix}${Date.now()}${rand}${suffix.length > 0 ? suffix : '.tmp'}`;
+      if (!IOUtils.exists(path)) {
+        const file = fileIo.openSync(path, fileIo.OpenMode.CREATE | fileIo.OpenMode.WRITE_ONLY);
+        fileIo.closeSync(file);
+        return path;
+      }
+    }
+    throw new Error(`Unable to create a temporary file in ${dir}`);
+  }
+}
