+export enum NeutralMode {
+  ACTION = 0,
+  DETAILS_THEN_COPY = 1,
+  COPY = 2,
+  SHOW_DETAILS = 3
+}
+
+export class GenericDialogParams {
+  title: ResourceStr = '';
+  message: ResourceStr = '';
+  explanation: ResourceStr = '';
+  details: string = '';
+  detailsVisible: boolean = false;
+  icon: Resource | null = null;
+  iconColor: ResourceColor = $r('app.color.theme_error');
+  checkboxLabel: ResourceStr = '';
+  checkboxRequired: boolean = false;
+  positive: DialogButtonSpec | null = null;
+  negative: DialogButtonSpec | null = null;
+  neutral: DialogButtonSpec | null = null;
+  neutralMode: NeutralMode = NeutralMode.ACTION;
+  copiedToast: ResourceStr = '';
+  handle: DialogHandle = new DialogHandle();
+}
+
+@Component
+export struct GenericDialogView {
+  params: GenericDialogParams = new GenericDialogParams();
+  @State checked: boolean = false;
+  @State detailsVisible: boolean = false;
+  @State neutralCopy: boolean = false;
+  @State neutralHidden: boolean = false;
+
+  aboutToAppear(): void {
+    this.detailsVisible = this.params.detailsVisible;
+    this.neutralCopy = this.params.neutralMode === NeutralMode.COPY;
+  }
+
+  private onNeutral(): void {
+    const mode = this.params.neutralMode;
+    if (mode === NeutralMode.DETAILS_THEN_COPY && !this.detailsVisible) {
+      this.detailsVisible = true;
+      this.neutralCopy = true;
+      return;
+    }
+    if (mode === NeutralMode.SHOW_DETAILS) {
+      this.detailsVisible = true;
+      this.neutralHidden = true;
+      return;
+    }
+    if (mode === NeutralMode.COPY || mode === NeutralMode.DETAILS_THEN_COPY) {
+      ClipboardUtils.copyText(this.params.details, false);
+      if (this.params.copiedToast !== '') {
+        this.getUIContext().getPromptAction().showToast({ message: this.params.copiedToast });
+      }
+      return;
+    }
+    this.params.handle.dismiss();
+    if (this.params.neutral !== null && this.params.neutral.action !== null) {
+      this.params.neutral.action(this.checked);
+    }
+  }
+
+  build() {
+    Column() {
+      if (this.params.icon !== null) {
+        Image(this.params.icon)
+          .width(24)
+          .height(24)
+          .fillColor(this.params.iconColor)
+          .margin({ bottom: 16 })
+      }
+      DialogTitle(this.params.title)
+      Scroll() {
+        Column() {
+          if (this.params.message !== '') {
+            DialogMessage(this.params.message)
+          }
+          if (this.params.explanation !== '') {
+            Text(this.params.explanation)
+              .fontSize(14)
+              .fontColor($r('app.color.theme_onSurfaceVariant'))
+              .width('100%')
+              .margin({ bottom: 12 })
+          }
+          if (this.detailsVisible && this.params.details !== '') {
+            Text(this.params.details)
+              .fontSize(13)
+              .fontFamily('monospace')
+              .copyOption(CopyOptions.LocalDevice)
+              .fontColor($r('app.color.theme_onSurfaceVariant'))
+              .width('100%')
+              .margin({ bottom: 12 })
+          }
+          if (this.params.checkboxLabel !== '') {
+            Row() {
+              Checkbox()
+                .select(this.checked)
+                .onChange((v: boolean) => {
+                  this.checked = v;
+                })
+              Text(this.params.checkboxLabel)
+                .fontSize(14)
+                .fontColor($r('app.color.theme_onSurface'))
+                .layoutWeight(1)
+                .onClick(() => {
+                  this.checked = !this.checked;
+                })
+            }
+            .width('100%')
+          }
+        }
+      }
+      .constraintSize({ maxHeight: 420 })
+      .scrollBar(BarState.Auto)
+
+      Row() {
+        if (this.params.neutral !== null && !this.neutralHidden) {
+          Button(this.neutralCopy ? $r('app.string.copy') : this.params.neutral.label)
+            .dialogButton()
+            .margin({ left: 0 })
+            .onClick(() => this.onNeutral())
+        }
+        Blank()
+        if (this.params.negative !== null) {
+          Button(this.params.negative.label)
+            .dialogButton()
+            .onClick(() => {
+              this.params.handle.dismiss();
+              if (this.params.negative !== null && this.params.negative.action !== null) {
+                this.params.negative.action(this.checked);
+              }
+            })
+        }
+        if (this.params.positive !== null) {
+          Button(this.params.positive.label)
+            .dialogButton()
+            .enabled(!this.params.checkboxRequired || this.checked)
+            .opacity(!this.params.checkboxRequired || this.checked ? 1 : 0.4)
+            .onClick(() => {
+              this.params.handle.dismiss();
+              if (this.params.positive !== null && this.params.positive.action !== null) {
+                this.params.positive.action(this.checked);
+              }
+            })
+        }
+      }
+      .width('100%')
+      .margin({ top: 16 })
+    }
+    .dialogContainer()
+  }
+}
+
+@Builder
+export function buildGenericDialog(params: GenericDialogParams) {
+  GenericDialogView({ params: params })
