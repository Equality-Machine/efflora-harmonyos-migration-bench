+import { util } from '@kit.ArkTS';
+
+/**
+ * UUIDs are represented as lowercase strings throughout the app (replacement for java.util.UUID).
+ */
+export class UUID {
+  private constructor() {
+  }
+
+  static randomUUID(): string {
+    return util.generateRandomUUID(false).toLowerCase();
+  }
+
+  static isValid(s: string): boolean {
+    return new RegExp('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$').test(s);
+  }
+
+  static fromString(s: string): string {
+    if (!UUID.isValid(s)) {
+      throw new Error(`Invalid UUID string: ${s}`);
+    }
+    return s.toLowerCase();
+  }
+}
diff --git a/entry/src/main/ets/util/UUIDMap.ets b/entry/src/main/ets/util/UUIDMap.ets
new file mode 100644
index 0000000..2834bd1
--- /dev/null
+++ b/entry/src/main/ets/util/UUIDMap.ets
@@ -0,0 +1,152 @@
+import { UUID } from './UUID';
+import { CollectionUtils } from './CollectionUtils';
+
+/**
+ * Port of UUIDMap.Value: a value that is identified by a UUID.
+ */
+export abstract class UUIDMapValue {
+  private _uuid: string;
+
+  protected constructor(uuid?: string) {
+    this._uuid = uuid !== undefined ? uuid : UUID.randomUUID();
+  }
+
+  getUUID(): string {
+    return this._uuid;
+  }
+
+  /**
+   * Resets the UUID of this value by generating a new random one.
+   * The caller must ensure that this Value is not in a UUIDMap yet. Otherwise, bad things will happen.
+   */
+  resetUUID(): void {
+    this._uuid = UUID.randomUUID();
+  }
+
+  equals(o: Object | null): boolean {
+    if (this === o) {
+      return true;
+    }
+    if (!(o instanceof UUIDMapValue)) {
+      return false;
+    }
+    return this.getUUID() === (o as UUIDMapValue).getUUID();
+  }
+}
+
+/**
+ * A map data structure abstraction for storing values with a UUID as the key. Keys
+ * must be specified by the value itself, instead of separately. Insertion order is maintained.
+ */
+export class UUIDMap<T extends UUIDMapValue> {
+  private _map: Map<string, T> = new Map<string, T>();
+
+  /**
+   * Adds a value to the internal map.
+   * @throws Error if a map value with the UUID of the given value already exists.
+   */
+  add(value: T): void {
+    const uuid = value.getUUID();
+    if (this._map.has(uuid)) {
+      throw new Error(`Existing value found with UUID: ${uuid}`);
+    }
+    this._map.set(uuid, value);
+  }
+
+  /**
+   * Removes a value from the internal map.
+   * @return The old value that is now no longer present in the internal map.
+   */
+  remove(value: T): T {
+    const oldValue = this.getByUUID(value.getUUID());
+    this._map.delete(oldValue.getUUID());
+    return oldValue;
+  }
+
+  /**
+   * Clears the internal map.
+   */
+  wipe(): void {
+    this._map.clear();
+  }
+
+  /**
+   * Replaces an old value (with the same UUID as the new given value) in the
+   * internal map with the new given value.
+   * @return The old value that is now no longer present in the internal map.
+   */
+  replace(newValue: T): T {
+    const oldValue = this.getByUUID(newValue.getUUID());
+    this._map.set(oldValue.getUUID(), newValue);
+    return oldValue;
+  }
+
+  /**
+   * Moves value1 to the position of value2.
+   */
+  move(value1: T, value2: T): void {
+    const values = this.getValues();
+    let vi1 = -1;
+    let vi2 = -1;
+    for (let i = 0; i < values.length; i++) {
+      const value = values[i];
+      if (value.getUUID() === value1.getUUID()) {
+        vi1 = i;
+      }
+      if (value.getUUID() === value2.getUUID()) {
+        vi2 = i;
+      }
+    }
+
+    if (vi1 < 0) {
+      throw new Error(`No value found for value1 with UUID: ${value1.getUUID()}`);
+    }
+    if (vi2 < 0) {
+      throw new Error(`No value found for value2 with UUID: ${value2.getUUID()}`);
+    }
+
+    CollectionUtils.move(values, vi1, vi2);
+
+    this._map.clear();
+    for (const value of values) {
+      this._map.set(value.getUUID(), value);
+    }
+  }
+
+  /**
+   * Reports whether the internal map contains a value with the UUID of the given value.
+   */
+  has(value: T): boolean {
+    return this._map.has(value.getUUID());
+  }
+
+  /**
+   * Reports whether the internal map contains a value with the given UUID.
+   */
+  hasUUID(uuid: string): boolean {
+    return this._map.has(uuid);
+  }
+
+  /**
+   * Returns a copy of the list of values in the internal map.
+   */
+  getValues(): T[] {
+    return Array.from(this._map.values());
+  }
+
+  size(): number {
+    return this._map.size;
+  }
+
+  /**
+   * Retrieves an entry from the internal map that has the given UUID.
+   * @throws Error if no map value exists with the given UUID.
+   */
+  getByUUID(uuid: string): T {
+    const value = this._map.get(uuid);
+    if (value === undefined) {
+      throw new Error(`No value found with UUID: ${uuid}`);
+    }
+    return value;
+  }
+}
diff --git a/entry/src/main/ets/util/Uri.ets b/entry/src/main/ets/util/Uri.ets
