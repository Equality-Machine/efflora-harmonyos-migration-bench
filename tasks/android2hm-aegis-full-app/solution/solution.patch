+import { OtpInfo } from './OtpInfo';
+import { TotpInfo } from './TotpInfo';
+import { OtpInfoException } from './OtpInfoException';
+import { YAOTP } from '../crypto/otp/YAOTP';
+import { JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+
+export class YandexInfo extends TotpInfo {
+  static readonly DEFAULT_ALGORITHM: string = 'SHA256';
+  static readonly DIGITS: number = 8;
+
+  static readonly SECRET_LENGTH: number = 16;
+  static readonly SECRET_FULL_LENGTH: number = 26;
+  static readonly ID: string = 'yandex';
+  static readonly HOST_ID: string = 'yaotp';
+
+  private _pin: string | null = null;
+
+  constructor(secret: Uint8Array, pin?: string | null) {
+    super(secret, YandexInfo.DEFAULT_ALGORITHM, YandexInfo.DIGITS, TotpInfo.DEFAULT_PERIOD);
+    this.setSecret(YandexInfo.parseSecret(secret));
+    this._pin = pin === undefined ? null : pin;
+  }
+
+  getOtp(time?: number): string {
+    if (this._pin === null) {
+      throw new Error('PIN must be set before generating an OTP');
+    }
+    const t = time !== undefined ? time : Math.floor(Date.now() / 1000);
+    const otp = YAOTP.generateOTP(this.getSecret(), this._pin, this.getDigits(), this.getAlgorithm(true), this.getPeriod(), t);
+    return otp.toString();
+  }
+
+  getPin(): string | null {
+    return this._pin;
+  }
+
+  setPin(pin: string): void {
+    this._pin = pin;
+  }
+
+  getTypeId(): string {
+    return YandexInfo.ID;
+  }
+
+  getType(): string {
+    const id = this.getTypeId();
+    return id.substring(0, 1).toUpperCase() + id.substring(1);
+  }
+
+  toJson(): JSONObject {
+    const result = super.toJson();
+    result.put('pin', this.getPin());
+    return result;
+  }
+
+  equals(o: Object | null): boolean {
+    if (!(o instanceof YandexInfo)) {
+      return false;
+    }
+    const info = o as YandexInfo;
+    return super.equals(o) && this.getPin() === info.getPin();
+  }
+
+  static parseSecret(secret: Uint8Array): Uint8Array {
+    YandexInfo.validateSecret(secret);
+    if (secret.length !== YandexInfo.SECRET_LENGTH) {
+      return Bytes.copyOfRange(secret, 0, YandexInfo.SECRET_LENGTH);
+    }
+    return secret;
+  }
+
+  /**
+   * Port of ChecksumIsValid
+   * From: https://github.com/norblik/KeeYaOtp/blob/188a1a99f13f82e4ef8df8a1b9b9351ba236e2a1/KeeYaOtp/Core/Secret.cs
+   * License: GPLv3+
+   */
+  static validateSecret(secret: Uint8Array): void {
+    if (secret.length !== YandexInfo.SECRET_LENGTH && secret.length !== YandexInfo.SECRET_FULL_LENGTH) {
+      throw new OtpInfoException(`Invalid Yandex secret length: ${secret.length} bytes`);
+    }
+
+    // Secrets originating from a QR code do not have a checksum, so we assume those are valid
+    if (secret.length === YandexInfo.SECRET_LENGTH) {
+      return;
+    }
+
+    const originalChecksum = (((secret[secret.length - 2] & 0x0F) << 8) | (secret[secret.length - 1] & 0xff)) & 0xffff;
+
+    let accum = 0;
+    let accumBits = 0;
+
+    let inputTotalBitsAvailable = secret.length * 8 - 12;
+    let inputIndex = 0;
+    let inputBitsAvailable = 8;
+
+    while (inputTotalBitsAvailable > 0) {
+      let requiredBits = 13 - accumBits;
+      if (inputTotalBitsAvailable < requiredBits) {
+        requiredBits = inputTotalBitsAvailable;
+      }
+
+      while (requiredBits > 0) {
+        let curInput = (secret[inputIndex] & ((1 << inputBitsAvailable) - 1)) & 0xff;
+        const bitsToRead = Math.min(requiredBits, inputBitsAvailable);
+
+        curInput >>= inputBitsAvailable - bitsToRead;
+        accum = ((accum << bitsToRead) | curInput) & 0xffff;
+
+        inputTotalBitsAvailable -= bitsToRead;
+        requiredBits -= bitsToRead;
+        inputBitsAvailable -= bitsToRead;
+        accumBits += bitsToRead;
+
+        if (inputBitsAvailable === 0) {
+          inputIndex += 1;
+          inputBitsAvailable = 8;
+        }
+      }
+
+      if (accumBits === 13) {
+        accum ^= 0x18F3;
+      }
+      accumBits = 16 - YandexInfo.getNumberOfLeadingZeros(accum);
+    }
+
+    if (accum !== originalChecksum) {
+      throw new OtpInfoException('Yandex secret checksum invalid');
+    }
+  }
+
+  private static getNumberOfLeadingZeros(v: number): number {
+    let value = v & 0xffff;
+    if (value === 0) {
+      return 16;
+    }
+    let n = 0;
+    if ((value & 0xFF00) === 0) {
+      n += 8;
+      value = (value << 8) & 0xffff;
+    }
+    if ((value & 0xF000) === 0) {
+      n += 4;
+      value = (value << 4) & 0xffff;
+    }
+    if ((value & 0xC000) === 0) {
+      n += 2;
+      value = (value << 2) & 0xffff;
+    }
+    if ((value & 0x8000) === 0) {
+      n++;
+    }
+    return n;
+  }
+}
+
+OtpInfo.registerFactory(YandexInfo.ID, (type: string, secret: Uint8Array, algo: string, digits: number, obj: JSONObject): OtpInfo => {
+  return new YandexInfo(secret, obj.getString('pin'));
+});
