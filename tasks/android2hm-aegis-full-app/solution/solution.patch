+    return new VaultGroupModel(group, null, null);
+  }
+
+  static fromPlaceholder(type: GroupPlaceholderType): VaultGroupModel {
+    const res = GroupPlaceholderTypeUtils.getStringRes(type);
+    let name = '';
+    try {
+      name = AegisModule.getContext().resourceManager.getStringSync(res.id);
+    } catch (e) {
+      name = ResUtils.getString(AegisModule.getContext(), type === GroupPlaceholderType.ALL ? 'all' :
+        (type === GroupPlaceholderType.NEW_GROUP ? 'new_group' : 'no_group'));
+    }
+    return new VaultGroupModel(null, type, name);
+  }
