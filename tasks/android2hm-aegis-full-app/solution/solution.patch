+import { AegisModule } from '../../../AegisModule';
+import { VaultManager } from '../../../vault/VaultManager';
+
+class IconPackAdapterListenerImpl implements IconPackAdapterListener {
+  private _cb: (pack: IconPack) => void;
+
+  constructor(cb: (pack: IconPack) => void) {
+    this._cb = cb;
+  }
+
+  onRemoveIconPack(pack: IconPack): void {
+    this._cb(pack);
+  }
+}
+
+/**
+ * Port of IconPacksManagerFragment (res/layout/fragment_icon_packs.xml): lists the imported icon
+ * packs and allows importing (ZIP) and removing them.
+ */
+@Entry
+@Component
+struct IconPacksManagerFragment {
+  @State tick: number = 0;
+  @State fabVisible: boolean = true;
+  @State isEmpty: boolean = true;
+  private _activity: AegisActivity | null = null;
+  private _iconPackManager: IconPackManager = AegisModule.provideIconPackManager();
+  private _vaultManager: VaultManager = AegisModule.provideVaultManager();
+  private _adapter: IconPackAdapter = new IconPackAdapter(new IconPackAdapterListenerImpl((pack: IconPack) => {
+    this.onRemoveIconPack(pack);
+  }));
+  private _fabScrollHelper: FabScrollHelper = new FabScrollHelper((visible: boolean) => {
+    this.fabVisible = visible;
+  });
+
+  aboutToAppear(): void {
+    const activity = new AegisActivity(this.getUIContext(), PAGE_PREFS_ICON_PACKS);
+    this._activity = activity;
+    activity.onCreate();
+    if (activity.abortIfOrphan()) {
+      return;
+    }
+
+    activity.setResult(RESULT_OK, new Intent(PAGE_PREFS_ICON_PACKS).putExtra('needsRecreate', true));
+    this._iconPackManager = activity.getIconPackManager();
+    this._vaultManager = activity.getVaultManager();
+    this.onViewCreated();
+  }
+
+  onPageShow(): void {
+    if (this._activity !== null) {
+      this._activity.onResume();
+    }
+  }
+
+  aboutToDisappear(): void {
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  onViewCreated(): void {
+    this._adapter.setOnDataSetChangedListener(() => {
+      this.tick++;
+    });
+
+    for (const pack of this._iconPackManager.getIconPacks()) {
+      this._adapter.addIconPack(pack);
+    }
+
+    this.updateEmptyState();
+  }
+
+  onRemoveIconPack(pack: IconPack): void {
+    Dialogs.showSimpleDialog(this.getUIContext(), $r('app.string.remove_icon_pack'),
+      $r('app.string.remove_icon_pack_description'),
+      $r('app.string.yes'), () => {
+        this.removeIconPack(pack);
+      },
+      $r('app.string.no'), null, undefined, undefined, true);
+  }
+
+  private importIconPack(uri: string): void {
+    const task = new ImportIconPackTask(this.getUIContext(), (result: ImportIconPackTaskResult) => {
+      const e = result.getException();
+      if (e instanceof IconPackExistsException) {
+        const existing = (e as IconPackExistsException).getIconPack();
+        Dialogs.showSimpleDialog(this.getUIContext(), $r('app.string.error_occurred'),
+          $r('app.string.icon_pack_import_exists_error'),
+          $r('app.string.yes'), () => {
+            if (this.removeIconPack(existing)) {
+              this.importIconPack(uri);
+            }
+          },
+          $r('app.string.no'), null, undefined, undefined, true);
+      } else if (e !== null) {
+        Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.icon_pack_import_error'), e);
+      } else {
+        const pack = result.getIconPack();
+        if (pack !== null) {
+          this._adapter.addIconPack(pack);
+        }
+        this.updateEmptyState();
+      }
+    });
+    task.execute(new ImportIconPackTaskParams(this._iconPackManager, uri));
+  }
+
+  private removeIconPack(pack: IconPack): boolean {
+    try {
+      this._iconPackManager.removeIconPack(pack);
+    } catch (e) {
+      Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.icon_pack_delete_error'), e as Error);
+      return false;
+    }
+
+    this._adapter.removeIconPack(pack);
+    this.updateEmptyState();
+    return true;
+  }
+
+  private startImportIconPack(): void {
+    this._vaultManager.fireIntentLauncher<string | null>(() => SafHelper.selectFile())
+      .then((uri: string | null) => {
+        if (uri !== null) {
+          this.importIconPack(uri);
+        }
+      })
+      .catch((e: Error) => {
+        hilog.error(0x0000, 'IconPacksManager', 'Unable to pick an icon pack: %{public}s', e.message);
+      });
+  }
+
+  private updateEmptyState(): void {
+    this.isEmpty = this._adapter.getItemCount() === 0;
+  }
+
+  private getIconPacks(tick: number): IconPack[] {
+    return this._adapter.getIconPacks();
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.pref_section_icon_packs'),
+        backgroundColorValue: ThemeHelper.isAmoled() ? '#000000' : $r('app.color.theme_surface'),
+        onBack: () => {
+          if (this._activity !== null) {
+            this._activity.finish();
+          }
+        }
+      })
+      Stack({ alignContent: Alignment.BottomEnd }) {
+        if (this.isEmpty) {
+          Column() {
+            Image($r('app.media.ic_outline_package_variant_24'))
+              .width(75)
+              .height(75)
+              .fillColor($r('app.color.theme_onSurfaceVariant'))
+            Text($r('app.string.no_icon_packs_title'))
+              .fontSize(18)
+              .fontColor($r('app.color.theme_onSurface'))
+              .padding({ top: 17 })
+            Text($r('app.string.no_icon_packs'))
+              .width(300)
+              .fontSize(14)
+              .lineSpacing(LengthMetrics.vp(5))
+              .padding({ top: 7 })
+              .textAlign(TextAlign.Center)
+              .fontColor($r('app.color.theme_onSurfaceVariant'))
+          }
+          .width('100%')
+          .height('100%')
+          .justifyContent(FlexAlign.Center)
+          .padding({ bottom: 150 })
+        } else {
+          List() {
+            ForEach(this.getIconPacks(this.tick), (pack: IconPack, index: number) => {
+              ListItem() {
+                IconPackHolder({
+                  pack: pack,
+                  onDeleteClickListener: () => this._adapter.onDeleteClick(index)
+                })
+              }
+            }, (pack: IconPack, index: number) => `${pack.getUUID()}-${pack.getVersion()}-${index}-${this.tick}`)
+          }
+          .width('100%')
+          .height('100%')
+          .onDidScroll((xOffset: number, yOffset: number) => {
+            this._fabScrollHelper.onScroll(xOffset, yOffset);
+          })
+        }
+
+        if (this.fabVisible) {
+          Button({ type: ButtonType.Normal }) {
+            Image($r('app.media.ic_outline_add_24'))
+              .width(24)
+              .height(24)
+              .fillColor($r('app.color.theme_onPrimaryContainer'))
+          }
+          .width(56)
+          .height(56)
+          .borderRadius(16)
+          .backgroundColor($r('app.color.theme_primaryContainer'))
+          .margin(16)
+          .onClick(() => this.startImportIconPack())
+        }
+      }
+      .layoutWeight(1)
+      .width('100%')
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
