+  }
+
+  setIsAndroidBackupsEnabled(enabled: boolean): void {
+    this.putBoolean('pref_android_backups', enabled);
+    this.setAndroidBackupResult(null);
+  }
+
+  isBackupsEnabled(): boolean {
+    return this.getBoolean('pref_backups', false);
+  }
+
+  setIsBackupsEnabled(enabled: boolean): void {
+    this.putBoolean('pref_backups', enabled);
+    this.setBuiltInBackupResult(null);
+  }
+
+  isBackupReminderEnabled(): boolean {
+    return this.getBoolean('pref_backup_reminder', true);
+  }
+
+  setIsBackupReminderEnabled(enabled: boolean): void {
+    this.putBoolean('pref_backup_reminder', enabled);
+  }
+
+  getBackupsLocation(): string | null {
+    return this.getString('pref_backups_location', null);
+  }
+
+  getFocusSearchEnabled(): boolean {
+    return this.getBoolean('pref_focus_search', false);
+  }
+
+  setFocusSearch(enabled: boolean): void {
+    this.putBoolean('pref_focus_search', enabled);
+  }
+
+  setLatestExportTimeNow(): void {
+    this.putInt('pref_export_latest', Date.now());
+    this.setIsBackupReminderNeeded(false);
+  }
+
+  getLatestBackupOrExportTime(): Date | null {
+    const dates: Date[] = [];
+
+    const l = this.getInt('pref_export_latest', 0);
+    if (l > 0) {
+      dates.push(new Date(l));
+    }
+
+    const builtinRes = this.getBuiltInBackupResult();
+    if (builtinRes !== null) {
+      dates.push(builtinRes.getTime());
+    }
+
+    const androidRes = this.getAndroidBackupResult();
+    if (androidRes !== null) {
+      dates.push(androidRes.getTime());
+    }
+
+    if (dates.length === 0) {
+      return null;
+    }
+
+    let max = dates[0];
+    for (const d of dates) {
+      if (d.getTime() > max.getTime()) {
+        max = d;
+      }
+    }
+    return max;
+  }
+
+  /**
+   * Sets the backups location. The isDirectory flag replaces DocumentsContract.isTreeUri.
+   */
+  setBackupsLocation(location: string | null, isDirectory?: boolean): void {
+    this.putRawString('pref_backups_location', location);
+    if (isDirectory !== undefined) {
+      this.putBoolean('pref_backups_location_is_dir', isDirectory);
+    }
+  }
+
+  getBackupsVersionCount(): number {
+    return this.getInt('pref_backups_versions', 5);
+  }
+
+  setBackupsVersionCount(versions: number): void {
+    this.putInt('pref_backups_versions', versions);
+  }
+
+  setAndroidBackupResult(res: BackupResult | null): void {
+    this.setBackupResult(false, res);
+  }
+
+  setBuiltInBackupResult(res: BackupResult | null): void {
+    this.setBackupResult(true, res);
+  }
+
+  getAndroidBackupResult(): BackupResult | null {
+    return this.getBackupResult(false);
+  }
+
+  getBuiltInBackupResult(): BackupResult | null {
+    return this.getBackupResult(true);
+  }
+
+  getErroredBackupResult(): BackupResult | null {
+    let res = this.getBuiltInBackupResult();
+    if (res !== null && !res.isSuccessful()) {
+      return res;
+    }
+    res = this.getAndroidBackupResult();
+    if (res !== null && !res.isSuccessful()) {
+      return res;
+    }
+    return null;
+  }
+
+  private setBackupResult(isBuiltInBackup: boolean, res: BackupResult | null): void {
+    let json: string | null = null;
+    if (res !== null) {
+      res.setIsBuiltIn(isBuiltInBackup);
+      json = res.toJson();
+    }
+    this.putRawString(Preferences.getBackupResultKey(isBuiltInBackup), json);
+  }
+
+  private getBackupResult(isBuiltInBackup: boolean): BackupResult | null {
+    const json = this.getString(Preferences.getBackupResultKey(isBuiltInBackup), null);
+    if (json === null) {
+      return null;
+    }
+    try {
+      const res = BackupResult.fromJson(json);
+      res.setIsBuiltIn(isBuiltInBackup);
+      return res;
+    } catch (e) {
+      return null;
+    }
+  }
+
+  private static getBackupResultKey(isBuiltInBackup: boolean): string {
+    return isBuiltInBackup ? 'pref_backups_result_builtin' : 'pref_backups_result_android';
+  }
+
+  setIsBackupReminderNeeded(needed: boolean): void {
+    if (this.isBackupsReminderNeeded() !== needed) {
+      this.putBoolean('pref_backups_reminder_needed', needed);
+    }
+  }
+
+  isBackupsReminderNeeded(): boolean {
+    return this.getBoolean('pref_backups_reminder_needed', false);
+  }
+
+  setIsPlaintextBackupWarningNeeded(needed: boolean): void {
+    this.putBoolean('pref_plaintext_backup_warning_needed', needed);
+  }
+
+  isPlaintextBackupWarningNeeded(): boolean {
+    return !this.isPlaintextBackupWarningDisabled()
+      && this.getBoolean('pref_plaintext_backup_warning_needed', false);
+  }
+
+  setIsPlaintextBackupWarningDisabled(disabled: boolean): void {
+    this.putBoolean('pref_plaintext_backup_warning_disabled', disabled);
+  }
+
+  isPlaintextBackupWarningDisabled(): boolean {
+    return this.getBoolean('pref_plaintext_backup_warning_disabled', false);
+  }
+
+  isPinKeyboardEnabled(): boolean {
+    return this.getBoolean('pref_pin_keyboard', false);
+  }
+
+  isTimeSyncWarningEnabled(): boolean {
+    return this.getBoolean('pref_warn_time_sync', true);
+  }
+
+  setIsTimeSyncWarningEnabled(enabled: boolean): void {
+    this.putBoolean('pref_warn_time_sync', enabled);
+  }
+
+  getCopyBehavior(): CopyBehavior {
+    return CopyBehaviorUtils.fromInteger(this.getInt('pref_current_copy_behavior', 0));
+  }
+
+  setCopyBehavior(copyBehavior: CopyBehavior): void {
+    this.putInt('pref_current_copy_behavior', copyBehavior);
+  }
+
+  isMinimizeOnCopyEnabled(): boolean {
+    return this.getBoolean('pref_minimize_on_copy', false);
+  }
+
+  /**
+   * Stores the group filter. The 'null' group (entries without a group) is stored as JSON null.
+   */
+  setGroupFilter(groupFilter: Set<string | null>): void {
+    const json = new JSONArray();
+    for (const g of Array.from(groupFilter)) {
+      json.put(g);
+    }
+    this.putRawString('pref_group_filter_uuids', json.toString());
+  }
+
+  getGroupFilter(): Set<string | null> {
+    const raw = this.getString('pref_group_filter_uuids', null);
+    const filter = new Set<string | null>();
+    if (raw === null || raw.length === 0) {
+      return filter;
+    }
+    try {
+      const json = new JSONArray(raw);
+      for (let i = 0; i < json.length(); i++) {
+        filter.add(json.isNull(i) ? null : json.getString(i));
+      }
+      return filter;
+    } catch (e) {
+      return new Set<string | null>();
+    }
+  }
+
+  getBackupVersioningStrategy(): BackupsVersioningStrategy {
+    const uri = this.getBackupsLocation();
+    if (uri === null) {
+      return BackupsVersioningStrategy.UNDEFINED;
+    }
+    if (this.getBoolean('pref_backups_location_is_dir', true)) {
+      return BackupsVersioningStrategy.MULTIPLE_BACKUPS;
+    } else {
+      return BackupsVersioningStrategy.SINGLE_BACKUP;
+    }
+  }
+}
diff --git a/entry/src/main/ets/SortCategory.ets b/entry/src/main/ets/SortCategory.ets
new file mode 100644
index 0000000..331e3d9
--- /dev/null
+++ b/entry/src/main/ets/SortCategory.ets
@@ -0,0 +1,78 @@
+import { Comparator, Comparators } from './helpers/comparators/Comparator';
+import { AccountNameComparator } from './helpers/comparators/AccountNameComparator';
+import { IssuerNameComparator } from './helpers/comparators/IssuerNameComparator';
+import { UsageCountComparator } from './helpers/comparators/UsageCountComparator';
+import { LastUsedComparator } from './helpers/comparators/LastUsedComparator';
+import { VaultEntry } from './vault/VaultEntry';
+
+export enum SortCategory {
+  CUSTOM = 0,
+  ACCOUNT = 1,
+  ACCOUNT_REVERSED = 2,
+  ISSUER = 3,
+  ISSUER_REVERSED = 4,
+  USAGE_COUNT = 5,
+  LAST_USED = 6
+}
+
+export class SortCategoryUtils {
+  static fromInteger(x: number): SortCategory {
+    return x >= 0 && x <= 6 ? x as SortCategory : SortCategory.CUSTOM;
+  }
+
+  static values(): SortCategory[] {
+    return [SortCategory.CUSTOM, SortCategory.ACCOUNT, SortCategory.ACCOUNT_REVERSED, SortCategory.ISSUER,
+      SortCategory.ISSUER_REVERSED, SortCategory.USAGE_COUNT, SortCategory.LAST_USED];
+  }
+
+  static getComparator(category: SortCategory): Comparator<VaultEntry> | null {
+    let comparator: Comparator<VaultEntry> | null = null;
+    switch (category) {
+      case SortCategory.ACCOUNT:
+        comparator = Comparators.thenComparing<VaultEntry>(new AccountNameComparator(), new IssuerNameComparator());
+        break;
+      case SortCategory.ACCOUNT_REVERSED:
+        comparator = Comparators.reverseOrder<VaultEntry>(
+          Comparators.thenComparing<VaultEntry>(new AccountNameComparator(), new IssuerNameComparator()));
+        break;
+      case SortCategory.ISSUER:
+        comparator = Comparators.thenComparing<VaultEntry>(new IssuerNameComparator(), new AccountNameComparator());
+        break;
+      case SortCategory.ISSUER_REVERSED:
+        comparator = Comparators.reverseOrder<VaultEntry>(
+          Comparators.thenComparing<VaultEntry>(new IssuerNameComparator(), new AccountNameComparator()));
+        break;
+      case SortCategory.USAGE_COUNT:
+        comparator = Comparators.reverseOrder<VaultEntry>(new UsageCountComparator());
+        break;
+      case SortCategory.LAST_USED:
+        comparator = Comparators.reverseOrder<VaultEntry>(new LastUsedComparator());
+        break;
+      default:
+        break;
+    }
+    return comparator;
+  }
+
+  /**
+   * Returns the title of the menu item corresponding to the sort category (menu_main.xml).
+   */
+  static getMenuItem(category: SortCategory): Resource {
+    switch (category) {
+      case SortCategory.ACCOUNT:
+        return $r('app.string.sort_alphabetically_name');
+      case SortCategory.ACCOUNT_REVERSED:
+        return $r('app.string.sort_alphabetically_name_reverse');
+      case SortCategory.ISSUER:
+        return $r('app.string.sort_alphabetically');
+      case SortCategory.ISSUER_REVERSED:
+        return $r('app.string.sort_alphabetically_reverse');
+      case SortCategory.USAGE_COUNT:
+        return $r('app.string.sort_usage_count');
+      case SortCategory.LAST_USED:
+        return $r('app.string.sort_last_used');
+      default:
+        return $r('app.string.sort_custom');
+    }
+  }
+}
