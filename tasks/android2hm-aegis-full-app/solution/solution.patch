@@ -0,0 +1,39 @@
+import { CryptoUtils, SecretKey } from './CryptoUtils';
+import { CryptResult } from './CryptResult';
+import { CryptParameters } from './CryptParameters';
+import { MasterKeyException } from './MasterKeyException';
+
+export class MasterKey {
+  private _key: SecretKey;
+
+  constructor(key: SecretKey) {
+    if (key === null || key === undefined) {
+      throw new Error('Key cannot be null');
+    }
+    this._key = key;
+  }
+
+  static generate(): MasterKey {
+    return new MasterKey(CryptoUtils.generateKey());
+  }
+
+  encrypt(bytes: Uint8Array): CryptResult {
+    try {
+      return CryptoUtils.encrypt(bytes, this._key);
+    } catch (e) {
+      throw new MasterKeyException(`Encryption failed: ${(e as Error).message}`);
+    }
+  }
+
+  decrypt(bytes: Uint8Array, params: CryptParameters): CryptResult {
+    try {
+      return CryptoUtils.decrypt(bytes, this._key, params);
+    } catch (e) {
+      throw new MasterKeyException(`Decryption failed: ${(e as Error).message}`);
+    }
+  }
+
+  getBytes(): Uint8Array {
+    return this._key.getEncoded();
+  }
+}
