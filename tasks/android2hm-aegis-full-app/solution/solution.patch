@@ -0,0 +1,161 @@
+import { AegisActivity, PAGE_PREFS_BEHAVIOR } from '../../AegisActivity';
+import { Toolbar } from '../../components/Toolbar';
+import { Dialogs } from '../../dialogs/Dialogs';
+import { PreferencesFragment } from './PreferencesFragment';
+import { Preference, PreferenceScreen } from '../../preferences/Preference';
+import { PreferenceResources } from '../../preferences/PreferenceResources';
+import { PreferenceScreenView } from '../../preferences/PreferenceScreenView';
+import { PreferenceDialogs } from '../../preferences/PreferenceDialogs';
+import { ThemeHelper } from '../../../helpers/ThemeHelper';
+import { Preferences } from '../../../Preferences';
+import { CopyBehaviorUtils } from '../../../CopyBehavior';
+import { AegisModule } from '../../../AegisModule';
+import { ResUtils } from '../../../util/ResUtils';
+
+function getStringArray(name: string): string[] {
+  return ResUtils.getStringArray(AegisModule.getContext(), name);
+}
+
+/**
+ * Port of BehaviorPreferencesFragment (res/xml/preferences_behavior.xml).
+ */
+@Entry
+@Component
+struct BehaviorPreferencesFragment {
+  @State tick: number = 0;
+  private _activity: AegisActivity | null = null;
+  private _fragment: PreferencesFragment | null = null;
+  private _prefs: Preferences = AegisModule.getPreferences();
+
+  aboutToAppear(): void {
+    const activity = new AegisActivity(this.getUIContext(), PAGE_PREFS_BEHAVIOR);
+    this._activity = activity;
+    activity.onCreate();
+    if (activity.abortIfOrphan()) {
+      return;
+    }
+
+    this._fragment = new PreferencesFragment(activity, () => {
+      this.tick++;
+    });
+    this._prefs = activity.getPreferences();
+    this.onCreatePreferences();
+  }
+
+  onPageShow(): void {
+    if (this._activity !== null) {
+      this._activity.onResume();
+    }
+    if (this._fragment !== null) {
+      this._fragment.onResume();
+    }
+  }
+
+  aboutToDisappear(): void {
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  private getString(name: string, args?: Array<string | number>): string {
+    return (this._activity as AegisActivity).getString(name, args);
+  }
+
+  onCreatePreferences(): void {
+    const fragment = this._fragment as PreferencesFragment;
+    fragment.addPreferencesFromResource(PreferenceResources.preferences_behavior());
+
+    const currentSearchBehaviorPreference = fragment.requirePreference<Preference>('pref_search_behavior');
+    currentSearchBehaviorPreference.setSummary(this.getSearchBehaviorSummary());
+    currentSearchBehaviorPreference.setOnPreferenceClickListener((preference: Preference) => {
+      const items = Preferences.SEARCH_BEHAVIOR_SETTINGS;
+      const textItems = getStringArray('pref_search_behavior_types');
+      const checkedItems: boolean[] = [];
+      for (let i = 0; i < items.length; i++) {
+        checkedItems.push(this._prefs.isSearchBehaviorTypeEnabled(items[i]));
+      }
+
+      // the positive button is only enabled if at least one item is checked
+      PreferenceDialogs.showMultiChoiceDialog(this.getUIContext(), $r('app.string.pref_search_behavior_prompt'),
+        textItems, checkedItems, true, (checked: boolean[]) => {
+          let searchBehavior = 0;
+          for (let i = 0; i < checked.length; i++) {
+            if (checked[i]) {
+              searchBehavior |= items[i];
+            }
+          }
+
+          this._prefs.setSearchBehaviorMask(searchBehavior);
+          currentSearchBehaviorPreference.setSummary(this.getSearchBehaviorSummary());
+        });
+      return true;
+    });
+
+    const copyBehaviorTitles = getStringArray('copy_behavior_titles');
+    const currentCopyBehavior = this._prefs.getCopyBehavior() as number;
+    const copyBehaviorPreference = fragment.requirePreference<Preference>('pref_copy_behavior');
+    copyBehaviorPreference.setSummary(`${this.getString('selected')}: ${copyBehaviorTitles[currentCopyBehavior]}`);
+    copyBehaviorPreference.setOnPreferenceClickListener((preference: Preference) => {
+      const currentCopyBehavior1 = this._prefs.getCopyBehavior() as number;
+
+      Dialogs.showSingleChoiceDialog(this.getUIContext(), this.getString('choose_copy_behavior'), copyBehaviorTitles,
+        currentCopyBehavior1, (i: number) => {
+          this._prefs.setCopyBehavior(CopyBehaviorUtils.fromInteger(i));
+          copyBehaviorPreference.setSummary(`${this.getString('selected')}: ${copyBehaviorTitles[i]}`);
+        }, true);
+
+      return true;
+    });
+
+    const entryPausePreference = fragment.requirePreference<Preference>('pref_pause_entry');
+    entryPausePreference.setEnabled(this._prefs.isTapToRevealEnabled() || this._prefs.isEntryHighlightEnabled());
+
+    const entryHighlightPreference = fragment.requirePreference<Preference>('pref_highlight_entry');
+    entryHighlightPreference.setOnPreferenceChangeListener((preference: Preference, newValue: Object) => {
+      entryPausePreference.setEnabled(this._prefs.isTapToRevealEnabled() || (newValue as boolean));
+      return true;
+    });
+  }
+
+  private getSearchBehaviorSummary(): string {
+    const settings = Preferences.SEARCH_BEHAVIOR_SETTINGS;
+    const descriptions = getStringArray('pref_search_behavior_types');
+
+    let builder = '';
+    for (let i = 0; i < settings.length; i++) {
+      if (this._prefs.isSearchBehaviorTypeEnabled(settings[i])) {
+        if (builder.length !== 0) {
+          builder += ', ';
+        }
+
+        builder += descriptions[i].toLowerCase();
+      }
+    }
+
+    return this.getString('pref_search_behavior_summary', [builder]);
+  }
+
+  private getScreen(): PreferenceScreen {
+    return (this._fragment as PreferencesFragment).getPreferenceScreen();
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.pref_section_behavior_title'),
+        backgroundColorValue: ThemeHelper.isAmoled() ? '#000000' : $r('app.color.theme_surface'),
+        onBack: () => {
+          if (this._activity !== null) {
+            this._activity.finish();
+          }
+        }
+      })
+      if (this._fragment !== null) {
+        PreferenceScreenView({ screenProvider: () => this.getScreen(), tick: this.tick })
+      }
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
