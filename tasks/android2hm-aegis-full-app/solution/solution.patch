+      if (hasText && this._depth > 0) {
+        this._name = null;
+        this._text = text;
+        this._eventType = XmlPullParser.TEXT;
+        return this._eventType;
+      }
+      text = '';
+      hasText = false;
+      if (this._src.startsWith('</', this._pos)) {
+        return this.parseEndTag();
+      }
+      return this.parseStartTag();
+    }
+    if (hasText && this._depth > 0) {
+      this._name = null;
+      this._text = text;
+      this._eventType = XmlPullParser.TEXT;
+      return this._eventType;
+    }
+    if (this._openTags.length > 0) {
+      throw new XmlPullParserException(`Unexpected end of document, unclosed tag: ${this._openTags[this._openTags.length - 1]}`);
+    }
+    this._name = null;
+    this._eventType = XmlPullParser.END_DOCUMENT;
+    return this._eventType;
+  }
+
+  private skipDoctype(): void {
+    let depth = 0;
+    let i = this._pos + 2;
+    while (i < this._src.length) {
+      const c = this._src.charAt(i);
+      if (c === '[') {
+        depth++;
+      }
+      else if (c === ']') {
+        depth--;
+      }
+      else if (c === '>' && depth <= 0) {
+        this._pos = i + 1;
+        return;
+      }
+      i++;
+    }
+    throw new XmlPullParserException('Unterminated doctype declaration');
+  }
+
+  private static isNameChar(c: string): boolean {
+    return !(c === ' ' || c === '\t' || c === '\n' || c === '\r' || c === '/' || c === '>' || c === '=' || c === '<');
+  }
+
+  private static isSpace(c: string): boolean {
+    return c === ' ' || c === '\t' || c === '\n' || c === '\r';
+  }
+
+  private readName(): string {
+    const start = this._pos;
+    while (this._pos < this._src.length && XmlPullParser.isNameChar(this._src.charAt(this._pos))) {
+      this._pos++;
+    }
+    if (start === this._pos) {
+      throw new XmlPullParserException(`Expected a name at position ${start}`);
+    }
+    return this._src.substring(start, this._pos);
+  }
+
+  private skipSpaces(): void {
+    while (this._pos < this._src.length && XmlPullParser.isSpace(this._src.charAt(this._pos))) {
+      this._pos++;
+    }
+  }
+
+  private parseEndTag(): number {
+    this._pos += 2;
+    const name = this.readName();
+    this.skipSpaces();
+    if (this._src.charAt(this._pos) !== '>') {
+      throw new XmlPullParserException(`Expected '>' after end tag ${name}`);
+    }
+    this._pos++;
+    const open = this._openTags.pop();
+    if (open !== name) {
+      throw new XmlPullParserException(`End tag ${name} does not match start tag ${open !== undefined ? open : ''}`);
+    }
+    this._name = name;
+    this._eventType = XmlPullParser.END_TAG;
+    return this._eventType;
+  }
+
+  private parseStartTag(): number {
+    this._pos++;
+    const name = this.readName();
+    const attrs: XmlAttribute[] = [];
+    while (true) {
+      this.skipSpaces();
+      if (this._pos >= this._src.length) {
+        throw new XmlPullParserException(`Unterminated start tag ${name}`);
+      }
+      const c = this._src.charAt(this._pos);
+      if (c === '>') {
+        this._pos++;
+        break;
+      }
+      if (c === '/') {
+        if (this._src.charAt(this._pos + 1) !== '>') {
+          throw new XmlPullParserException(`Expected '>' in empty element tag ${name}`);
+        }
+        this._pos += 2;
+        this._pendingEndTag = name;
+        break;
+      }
+      const attrName = this.readName();
+      this.skipSpaces();
+      if (this._src.charAt(this._pos) !== '=') {
+        throw new XmlPullParserException(`Expected '=' after attribute ${attrName}`);
+      }
+      this._pos++;
+      this.skipSpaces();
+      const quote = this._src.charAt(this._pos);
+      if (quote !== '"' && quote !== '\'') {
+        throw new XmlPullParserException(`Expected a quote for the value of attribute ${attrName}`);
+      }
+      const end = this._src.indexOf(quote, this._pos + 1);
+      if (end < 0) {
+        throw new XmlPullParserException(`Unterminated value of attribute ${attrName}`);
+      }
+      attrs.push(new XmlAttribute(attrName, XmlPullParser.decodeEntities(this._src.substring(this._pos + 1, end))));
+      this._pos = end + 1;
+    }
+    if (this._pendingEndTag === null) {
+      this._openTags.push(name);
+    }
+    this._depth++;
+    this._name = name;
+    this._attributes = attrs;
+    this._eventType = XmlPullParser.START_TAG;
+    return this._eventType;
+  }
+
+  static decodeEntities(s: string): string {
+    if (s.indexOf('&') < 0) {
+      return s;
+    }
+    let out = '';
+    let i = 0;
+    while (i < s.length) {
+      const amp = s.indexOf('&', i);
+      if (amp < 0) {
+        out += s.substring(i);
+        break;
+      }
+      out += s.substring(i, amp);
+      const semi = s.indexOf(';', amp);
+      if (semi < 0) {
+        throw new XmlPullParserException('Unterminated entity reference');
+      }
+      const entity = s.substring(amp + 1, semi);
+      if (entity === 'amp') {
+        out += '&';
+      }
+      else if (entity === 'lt') {
+        out += '<';
+      }
+      else if (entity === 'gt') {
+        out += '>';
+      }
+      else if (entity === 'quot') {
+        out += '"';
+      }
+      else if (entity === 'apos') {
+        out += '\'';
+      }
+      else if (entity.startsWith('#x') || entity.startsWith('#X')) {
+        out += String.fromCodePoint(parseInt(entity.substring(2), 16));
+      }
+      else if (entity.startsWith('#')) {
+        out += String.fromCodePoint(parseInt(entity.substring(1), 10));
+      }
+      else {
+        throw new XmlPullParserException(`Unknown entity: &${entity};`);
+      }
+      i = semi + 1;
+    }
+    return out;
+  }
+}
