+import { IntroActivityInterface } from './IntroActivityInterface';
+import { IntroState } from './IntroState';
+
+/**
+ * Port of SlideFragment: the logic part of a slide of the intro. The UI of each slide is a
+ * component that is bound to an instance of a subclass.
+ */
+export abstract class SlideFragment implements IntroActivityInterface {
+  private _parent: IntroActivityInterface | null = null;
+  private _uiContext: UIContext | null = null;
+
+  abstract getType(): string;
+
+  onAttach(parent: IntroActivityInterface, uiContext: UIContext): void {
+    this._parent = parent;
+    this._uiContext = uiContext;
+  }
+
+  onResume(): void {
+  }
+
+  isFinished(): boolean {
+    return true;
+  }
+
+  onNotFinishedError(): void {
+  }
+
+  onSaveIntroState(introState: IntroState): void {
+  }
+
+  goToNextSlide(): void {
+    this.getParent().goToNextSlide();
+  }
+
+  goToPreviousSlide(): void {
+    this.getParent().goToPreviousSlide();
+  }
+
+  skipToSlide(type: string): void {
+    this.getParent().skipToSlide(type);
+  }
+
+  getState(): IntroState {
+    return this.getParent().getState();
+  }
+
+  protected requireUIContext(): UIContext {
+    if (this._uiContext === null) {
+      throw new Error('This method must not be called before onAttach()');
+    }
+    return this._uiContext;
+  }
+
+  private getParent(): IntroActivityInterface {
+    if (this._parent === null) {
+      throw new Error('This method must not be called before onAttach()');
+    }
+    return this._parent;
+  }
+}
