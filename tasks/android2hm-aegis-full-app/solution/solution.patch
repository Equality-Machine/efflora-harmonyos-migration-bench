@@ -0,0 +1,28 @@
+import { Uri } from '../util/Uri';
+
+export class GoogleAuthInfoException extends Error {
+  private readonly _uri: Uri | null;
+  private readonly _cause: Error | null;
+
+  constructor(uri: Uri | null, message: string, cause?: Error) {
+    super(cause !== undefined && cause.message !== message ? `${message} (${cause.message})` : message);
+    this.name = 'GoogleAuthInfoException';
+    this._uri = uri;
+    this._cause = cause !== undefined ? cause : null;
+  }
+
+  static fromCause(uri: Uri | null, cause: Error): GoogleAuthInfoException {
+    return new GoogleAuthInfoException(uri, cause.message);
+  }
+
+  getCause(): Error | null {
+    return this._cause;
+  }
+
+  /**
+   * Reports whether the scheme of the URI is phonefactor://.
+   */
+  isPhoneFactor(): boolean {
+    return this._uri !== null && this._uri.getScheme() !== null && this._uri.getScheme() === 'phonefactor';
+  }
+}
diff --git a/entry/src/main/ets/otp/GoogleAuthProtos.ets b/entry/src/main/ets/otp/GoogleAuthProtos.ets
new file mode 100644
index 0000000..7168f84
--- /dev/null
+++ b/entry/src/main/ets/otp/GoogleAuthProtos.ets
@@ -0,0 +1,126 @@
+import { ProtoReader, ProtoWriter } from '../util/Protobuf';
+
+/**
+ * Hand-written port of the generated protobuf classes for google_auth.proto.
+ */
+export enum Algorithm {
+  ALGORITHM_UNSPECIFIED = 0,
+  ALGORITHM_SHA1 = 1,
+  ALGORITHM_SHA256 = 2,
+  ALGORITHM_SHA512 = 3,
+  ALGORITHM_MD5 = 4
+}
+
+export enum DigitCount {
+  DIGIT_COUNT_UNSPECIFIED = 0,
+  DIGIT_COUNT_SIX = 1,
+  DIGIT_COUNT_EIGHT = 2
+}
+
+export enum OtpType {
+  OTP_TYPE_UNSPECIFIED = 0,
+  OTP_TYPE_HOTP = 1,
+  OTP_TYPE_TOTP = 2
+}
+
+export class OtpParameters {
+  secret: Uint8Array = new Uint8Array(0);
+  name: string = '';
+  issuer: string = '';
+  algorithm: number = Algorithm.ALGORITHM_UNSPECIFIED;
+  digits: number = DigitCount.DIGIT_COUNT_UNSPECIFIED;
+  type: number = OtpType.OTP_TYPE_UNSPECIFIED;
+  counter: number = 0;
+
+  static parseFrom(data: Uint8Array): OtpParameters {
+    const p = new OtpParameters();
+    const reader = new ProtoReader(data);
+    for (const f of reader.readAll()) {
+      switch (f.fieldNumber) {
+        case 1:
+          p.secret = f.bytes;
+          break;
+        case 2:
+          p.name = f.asString();
+          break;
+        case 3:
+          p.issuer = f.asString();
+          break;
+        case 4:
+          p.algorithm = f.asNumber();
+          break;
+        case 5:
+          p.digits = f.asNumber();
+          break;
+        case 6:
+          p.type = f.asNumber();
+          break;
+        case 7:
+          p.counter = f.asNumber();
+          break;
+        default:
+          break;
+      }
+    }
+    return p;
+  }
+
+  toByteArray(): Uint8Array {
+    return new ProtoWriter()
+      .writeBytesField(1, this.secret)
+      .writeStringField(2, this.name)
+      .writeStringField(3, this.issuer)
+      .writeVarintField(4, this.algorithm)
+      .writeVarintField(5, this.digits)
+      .writeVarintField(6, this.type)
+      .writeVarintField(7, this.counter)
+      .toBytes();
+  }
+}
+
+export class MigrationPayload {
+  otpParameters: OtpParameters[] = [];
+  version: number = 0;
+  batchSize: number = 0;
+  batchIndex: number = 0;
+  batchId: number = 0;
+
+  static parseFrom(data: Uint8Array): MigrationPayload {
+    const payload = new MigrationPayload();
+    const reader = new ProtoReader(data);
+    for (const f of reader.readAll()) {
+      switch (f.fieldNumber) {
+        case 1:
+          payload.otpParameters.push(OtpParameters.parseFrom(f.bytes));
+          break;
+        case 2:
+          payload.version = f.asNumber();
+          break;
+        case 3:
+          payload.batchSize = f.asNumber();
+          break;
+        case 4:
+          payload.batchIndex = f.asNumber();
+          break;
+        case 5:
+          payload.batchId = f.asNumber();
+          break;
+        default:
+          break;
+      }
+    }
+    return payload;
+  }
+
+  toByteArray(): Uint8Array {
+    const writer = new ProtoWriter();
+    for (const p of this.otpParameters) {
+      writer.writeBytesField(1, p.toByteArray());
+    }
+    writer.writeVarintField(2, this.version)
+      .writeVarintField(3, this.batchSize)
+      .writeVarintField(4, this.batchIndex)
+      .writeVarintField(5, this.batchId);
+    return writer.toBytes();
+  }
+}
diff --git a/entry/src/main/ets/otp/HotpInfo.ets b/entry/src/main/ets/otp/HotpInfo.ets
