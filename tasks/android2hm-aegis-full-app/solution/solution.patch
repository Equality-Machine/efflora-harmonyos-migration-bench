diff --git a/entry/src/main/ets/importers/FreeOtpImporter.ets b/entry/src/main/ets/importers/FreeOtpImporter.ets
new file mode 100644
index 0000000..efc7ab2
--- /dev/null
+++ b/entry/src/main/ets/importers/FreeOtpImporter.ets
@@ -0,0 +1,480 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState, DecryptListener } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { CryptoUtils, SecretKey } from '../crypto/CryptoUtils';
+import { HotpInfo } from '../otp/HotpInfo';
+import { OtpInfo } from '../otp/OtpInfo';
+import { SteamInfo } from '../otp/SteamInfo';
+import { TotpInfo } from '../otp/TotpInfo';
+import { DialogButtonSpec, GenericDialogParams } from '../ui/dialogs/DialogViews';
+import { Dialogs } from '../ui/dialogs/Dialogs';
+import { PBKDFTask, PBKDFTaskParams } from '../ui/tasks/PBKDFTask';
+import { JSONArray, JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+import { DataInputStream } from '../util/DataInputStream';
+import { PreferenceParser } from '../util/PreferenceParser';
+import { VaultEntry } from '../vault/VaultEntry';
+
+const _subPath: string = 'shared_prefs/tokens.xml';
+
+const _pkgName: string = 'org.fedorahosted.freeotp';
+
+export class FreeOtpImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    return this.getAppPathForPackage(_pkgName, _subPath);
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    return FreeOtpImporter.readSync(stream);
+  }
+
+  /**
+   * Synchronous variant of read(), also used by FreeOtpPlusImporter.
+   */
+  static readSync(stream: Uint8Array): DatabaseImporterState {
+    const dataInStream = new DataInputStream(stream);
+    let magic = -1;
+    if (dataInStream.available() >= 2) {
+      dataInStream.mark(2);
+      magic = dataInStream.readUnsignedShort();
+      dataInStream.reset();
+    }
+    if (magic === FreeOtpImporterSerializedHashMapParser.MAGIC) {
+      return FreeOtpImporter.readV2(dataInStream);
+    }
+    else {
+      return FreeOtpImporter.readV1(stream);
+    }
+  }
+
+  private static readV1(stream: Uint8Array): FreeOtpImporterDecryptedStateV1 {
+    try {
+      const entries: JSONObject[] = [];
+      for (const entry of PreferenceParser.parseBytes(stream)) {
+        if (entry.Name !== 'tokenOrder') {
+          entries.push(new JSONObject(entry.Value));
+        }
+      }
+      return new FreeOtpImporterDecryptedStateV1(entries);
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  private static readV2(stream: DataInputStream): FreeOtpImporterEncryptedState {
+    try {
+      const entries = FreeOtpImporterSerializedHashMapParser.parse(stream);
+      const mk = entries.get('masterKey');
+      if (mk === undefined) {
+        throw new DatabaseImporterException('No master key found in the backup file');
+      }
+      const mkObj = new JSONObject(mk);
+      return new FreeOtpImporterEncryptedState(mkObj, entries);
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterException) {
+        throw e as DatabaseImporterException;
+      }
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  /**
+   * Finds the GCM nonce in the DER encoded cipher parameters (an OCTET STRING, possibly wrapped in a SEQUENCE).
+   */
+  static parseNonce(parameters: Uint8Array): Uint8Array {
+    const prim = DerElement.parse(parameters, 0);
+    if (prim.tag === DerElement.TAG_OCTET_STRING) {
+      return prim.content;
+    }
+    if (prim.tag === DerElement.TAG_SEQUENCE) {
+      let pos = 0;
+      while (pos < prim.content.length) {
+        const enc = DerElement.parse(prim.content, pos);
+        if (enc.tag === DerElement.TAG_OCTET_STRING) {
+          return enc.content;
+        }
+        pos = enc.end;
+      }
+    }
+    throw new DatabaseImporterException('Unable to find nonce in parameters');
+  }
+
+  static toBytes(array: JSONArray): Uint8Array {
+    const bytes = new Uint8Array(array.length());
+    for (let i = 0; i < array.length(); i++) {
+      bytes[i] = array.getInt(i) & 0xff;
+    }
+    return bytes;
+  }
+}
+
+/**
+ * A minimal DER (ASN.1) element reader (replacement for the BouncyCastle ASN.1 classes).
+ */
+class DerElement {
+  static readonly TAG_OCTET_STRING: number = 0x04;
+  static readonly TAG_SEQUENCE: number = 0x30;
+  tag: number = 0;
+  content: Uint8Array = new Uint8Array(0);
+  end: number = 0;
+
+  static parse(data: Uint8Array, offset: number): DerElement {
+    if (offset + 2 > data.length) {
+      throw new DatabaseImporterException('Invalid DER encoding: unexpected end of data');
+    }
+    const el = new DerElement();
+    el.tag = data[offset];
+    let pos = offset + 1;
+    let len = data[pos++];
+    if ((len & 0x80) !== 0) {
+      const n = len & 0x7f;
+      if (n === 0 || n > 4 || pos + n > data.length) {
+        throw new DatabaseImporterException('Invalid DER encoding: bad length');
+      }
+      len = 0;
+      for (let i = 0; i < n; i++) {
+        len = len * 256 + data[pos++];
+      }
+    }
+    if (pos + len > data.length) {
+      throw new DatabaseImporterException('Invalid DER encoding: length exceeds data');
+    }
+    el.content = Bytes.copyOfRange(data, pos, pos + len);
+    el.end = pos + len;
+    return el;
+  }
+}
+
+export class FreeOtpImporterEncryptedState extends DatabaseImporterState {
+  private static readonly MASTER_KEY_SIZE: number = 32 * 8;
+  private readonly _mkAlgo: string;
+  private readonly _mkCipher: string;
+  private readonly _mkCipherText: Uint8Array;
+  private readonly _mkParameters: Uint8Array;
+  private readonly _mkToken: Uint8Array;
+  private readonly _mkSalt: Uint8Array;
+  private readonly _mkIterations: number;
+  private readonly _entries: Map<string, string>;
+
+  constructor(mkObj: JSONObject, entries: Map<string, string>) {
+    super(true);
+    this._mkAlgo = mkObj.getString('mAlgorithm');
+    if (this._mkAlgo !== 'PBKDF2withHmacSHA1' && this._mkAlgo !== 'PBKDF2withHmacSHA512') {
+      throw new DatabaseImporterException(`Unexpected master key KDF: ${this._mkAlgo}`);
+    }
+    const keyObj = mkObj.getJSONObject('mEncryptedKey');
+    this._mkCipher = keyObj.getString('mCipher');
+    if (this._mkCipher !== 'AES/GCM/NoPadding') {
+      throw new DatabaseImporterException(`Unexpected master key cipher: ${this._mkCipher}`);
+    }
+    this._mkCipherText = FreeOtpImporter.toBytes(keyObj.getJSONArray('mCipherText'));
+    this._mkParameters = FreeOtpImporter.toBytes(keyObj.getJSONArray('mParameters'));
+    this._mkToken = Bytes.fromUtf8(keyObj.getString('mToken'));
+    this._mkSalt = FreeOtpImporter.toBytes(mkObj.getJSONArray('mSalt'));
+    this._mkIterations = mkObj.getInt('mIterations');
+    this._entries = entries;
+  }
+
+  async decryptWithPassword(password: string): Promise<DatabaseImporterState> {
+    const params = this.getKeyDerivationParams(password, this._mkAlgo);
+    const passKey = await PBKDFTask.deriveKey(params);
+    return this.decryptWithKey(passKey);
+  }
+
+  decryptWithKey(passKey: SecretKey): DatabaseImporterState {
+    let masterKeyBytes: Uint8Array;
+    try {
+      const nonce = FreeOtpImporter.parseNonce(this._mkParameters);
+      masterKeyBytes = CryptoUtils.decryptGcmWithAppendedTag(passKey.getEncoded(), nonce, this._mkCipherText, this._mkToken);
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    const masterKey = new SecretKey(masterKeyBytes);
+    return new FreeOtpImporterDecryptedStateV2(this._entries, masterKey);
+  }
+
+  decrypt(uiContext: UIContext, listener: DecryptListener): void {
+    const params = new GenericDialogParams();
+    params.title = $r('app.string.importer_warning_title_freeotp2');
+    params.message = $r('app.string.importer_warning_message_freeotp2');
+    params.icon = $r('app.media.ic_outline_warning_24');
+    params.positive = new DialogButtonSpec($r('app.string.ok'), (checked: boolean) => {
+      Dialogs.showPasswordInputDialog(uiContext, (password: string) => {
+        const kdfParams = this.getKeyDerivationParams(password, this._mkAlgo);
+        const task = new PBKDFTask(uiContext, (key: SecretKey) => {
+          try {
+            const state = this.decryptWithKey(key);
+            listener.onStateDecrypted(state);
+          }
+          catch (e) {
+            listener.onError(e as Error);
+          }
+        }, (e: Error) => listener.onError(e));
+        task.execute(kdfParams);
+      }, () => listener.onCanceled(), undefined, $r('app.string.enter_password_aegis_title'));
+    });
+    Dialogs.showGeneric(uiContext, params, false);
+  }
+
+  private getKeyDerivationParams(password: string, algo: string): PBKDFTaskParams {
+    return new PBKDFTaskParams(algo, FreeOtpImporterEncryptedState.MASTER_KEY_SIZE, password, this._mkSalt, this._mkIterations);
+  }
+}
+
+export class FreeOtpImporterDecryptedStateV2 extends DatabaseImporterState {
+  private readonly _entries: Map<string, string>;
+  private readonly _masterKey: SecretKey;
+
+  constructor(entries: Map<string, string>, masterKey: SecretKey) {
+    super(false);
+    this._entries = entries;
+    this._masterKey = masterKey;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    this._entries.forEach((value: string, key: string) => {
+      if (key.endsWith('-token') || key === 'masterKey') {
+        return;
+      }
+      try {
+        const encObj = new JSONObject(value);
+        const tokenKey = `${key}-token`;
+        const tokenValue = this._entries.get(tokenKey);
+        if (tokenValue === undefined) {
+          return;
+        }
+        const tokenObj = new JSONObject(tokenValue);
+        const vaultEntry = this.convertEntry(encObj, tokenObj);
+        result.addEntry(vaultEntry);
+      }
+      catch (e) {
+        if (e instanceof DatabaseImporterEntryException) {
+          result.addError(e);
+        }
+        // JSONException: ignored
+      }
+    });
+    return result;
+  }
+
+  private convertEntry(encObj: JSONObject, tokenObj: JSONObject): VaultEntry {
+    try {
+      const keyObj = new JSONObject(encObj.getString('key'));
+      const cipherName = keyObj.getString('mCipher');
+      if (cipherName !== 'AES/GCM/NoPadding') {
+        throw new DatabaseImporterException(`Unexpected cipher: ${cipherName}`);
+      }
+      const cipherText = FreeOtpImporter.toBytes(keyObj.getJSONArray('mCipherText'));
+      const parameters = FreeOtpImporter.toBytes(keyObj.getJSONArray('mParameters'));
+      const token = Bytes.fromUtf8(keyObj.getString('mToken'));
+      const nonce = FreeOtpImporter.parseNonce(parameters);
+      const secretBytes = CryptoUtils.decryptGcmWithAppendedTag(this._masterKey.getEncoded(), nonce, cipherText, token);
+      const secretArray = new JSONArray();
+      for (let i = 0; i < secretBytes.length; i++) {
+        // Java bytes are signed
+        const b = secretBytes[i];
+        secretArray.put(b >= 0x80 ? b - 0x100 : b);
+      }
+      tokenObj.put('secret', secretArray);
+      return FreeOtpImporterDecryptedStateV1.convertEntry(tokenObj);
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, tokenObj.toString());
+    }
+  }
+}
+
+export class FreeOtpImporterDecryptedStateV1 extends DatabaseImporterState {
+  private readonly _entries: JSONObject[];
+
+  constructor(entries: JSONObject[]) {
+    super(false);
+    this._entries = entries;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    for (const obj of this._entries) {
+      try {
+        const entry = FreeOtpImporterDecryptedStateV1.convertEntry(obj);
+        result.addEntry(entry);
+      }
+      catch (e) {
+        result.addError(e as DatabaseImporterEntryException);
+      }
+    }
+    return result;
+  }
+
+  static convertEntry(obj: JSONObject): VaultEntry {
+    try {
+      const type = obj.getString('type').toLowerCase();
+      const algo = obj.optString('algo', OtpInfo.DEFAULT_ALGORITHM);
+      const digits = obj.optInt('digits', OtpInfo.DEFAULT_DIGITS);
+      const secret = FreeOtpImporter.toBytes(obj.getJSONArray('secret'));
+      const issuer = obj.getString('issuerExt');
+      const name = obj.optString('label');
+      let info: OtpInfo;
+      switch (type) {
+        case 'totp': {
+          const period = obj.optInt('period', TotpInfo.DEFAULT_PERIOD);
+          if (issuer === 'Steam') {
+            info = new SteamInfo(secret, algo, digits, period);
+          }
+          else {
+            info = new TotpInfo(secret, algo, digits, period);
+          }
+          break;
+        }
+        case 'hotp':
+          info = new HotpInfo(secret, algo, digits, obj.getLong('counter'));
+          break;
+        default:
+          throw new DatabaseImporterException('unsupported otp type: ' + type);
+      }
+      return new VaultEntry(info, name, issuer);
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, obj.toString());
+    }
+  }
+}
+
+export class FreeOtpImporterSerializedHashMapParserParseException extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'ParseException';
+  }
+}
+
+/**
+ * Parses a Java serialized java.util.HashMap<String, String> (the format of FreeOTP 2 backups).
+ */
+export class FreeOtpImporterSerializedHashMapParser {
+  static readonly MAGIC: number = 0xaced;
+  static readonly VERSION: number = 5;
+  static readonly SERIAL_VERSION_UID: bigint = BigInt('362498820763181265');
+  static readonly TC_NULL: number = 0x70;
+  static readonly TC_REFERENCE: number = 0x71;
+  static readonly TC_CLASSDESC: number = 0x72;
+  static readonly TC_OBJECT: number = 0x73;
+  static readonly TC_STRING: number = 0x74;
+  static readonly TC_LONGSTRING: number = 0x7c;
+
+  // the first handle that is assigned to an object in the stream
+  static readonly BASE_WIRE_HANDLE: number = 0x7e0000;
+
+  private constructor() {
+  }
+
+  static parse(inStream: DataInputStream): Map<string, string> {
+    const map = new Map<string, string>();
+    // strings can be referenced by their handle if they occur more than once;
+    // handles 0 and 1 are taken by the class descriptor and the HashMap object
+    const handles: string[] = ['', ''];
+    // Read/validate the magic number and version
+    const magic = inStream.readUnsignedShort();
+    const version = inStream.readUnsignedShort();
+    if (magic !== FreeOtpImporterSerializedHashMapParser.MAGIC || version !== FreeOtpImporterSerializedHashMapParser.VERSION) {
+      throw new FreeOtpImporterSerializedHashMapParserParseException('Not a serialized Java Object');
+    }
+    // Read the class descriptor info for HashMap
+    let b = inStream.readByte();
+    if (b !== FreeOtpImporterSerializedHashMapParser.TC_OBJECT) {
+      throw new FreeOtpImporterSerializedHashMapParserParseException(`Expected an object, found: ${b}`);
+    }
+    b = inStream.readByte();
+    if (b !== FreeOtpImporterSerializedHashMapParser.TC_CLASSDESC) {
+      throw new FreeOtpImporterSerializedHashMapParserParseException(`Expected a class desc, found: ${b}`);
+    }
+    FreeOtpImporterSerializedHashMapParser.parseClassDescriptor(inStream);
+    // Not interested in the capacity of the map
+    inStream.readInt();
+    // Read the number of elements in the HashMap
+    const size = inStream.readInt();
+    // Parse each key-value pair in the map
+    for (let i = 0; i < size; i++) {
+      const key = FreeOtpImporterSerializedHashMapParser.parseStringObject(inStream, handles);
+      const value = FreeOtpImporterSerializedHashMapParser.parseStringObject(inStream, handles);
+      map.set(key, value);
+    }
+    return map;
+  }
+
+  private static parseClassDescriptor(inputStream: DataInputStream): void {
+    // Check whether we're dealing with a HashMap and a version we support
+    const className = FreeOtpImporterSerializedHashMapParser.parseUTF(inputStream);
+    if (className !== 'java.util.HashMap') {
+      throw new FreeOtpImporterSerializedHashMapParserParseException(`Unexpected class name: ${className}`);
+    }
+    const serialVersionUID = inputStream.readLong();
+    if (serialVersionUID !== FreeOtpImporterSerializedHashMapParser.SERIAL_VERSION_UID) {
+      throw new FreeOtpImporterSerializedHashMapParserParseException(`Unexpected serial version UID: ${serialVersionUID.toString()}`);
+    }
+    // Read past all of the fields in the class
+    const fieldDescriptor = inputStream.readByte();
+    if (fieldDescriptor === FreeOtpImporterSerializedHashMapParser.TC_NULL) {
+      return;
+    }
+    let totalFieldSkip = 0;
+    const fieldCount = inputStream.readUnsignedShort();
+    for (let i = 0; i < fieldCount; i++) {
+      const fieldType = String.fromCharCode(inputStream.readUnsignedByte());
+      FreeOtpImporterSerializedHashMapParser.parseUTF(inputStream);
+      switch (fieldType) {
+        case 'F': // float (4 bytes)
+        case 'I': // int (4 bytes)
+          totalFieldSkip += 4;
+          break;
+        default:
+          throw new FreeOtpImporterSerializedHashMapParserParseException(`Unexpected field type: ${fieldType}`);
+      }
+    }
+    // skip the end of the class annotation, the (null) super class descriptor and the field values
+    inputStream.skipBytes(totalFieldSkip);
+    // Not sure what these bytes are, just skip them
+    inputStream.skipBytes(4);
+  }
+
+  private static parseStringObject(inputStream: DataInputStream, handles: string[]): string {
+    const objectType = inputStream.readByte();
+    if (objectType === FreeOtpImporterSerializedHashMapParser.TC_REFERENCE) {
+      const handle = inputStream.readInt() - FreeOtpImporterSerializedHashMapParser.BASE_WIRE_HANDLE;
+      if (handle < 2 || handle >= handles.length) {
+        throw new FreeOtpImporterSerializedHashMapParserParseException(`Invalid string reference: ${handle}`);
+      }
+      return handles[handle];
+    }
+    let length: number;
+    if (objectType === FreeOtpImporterSerializedHashMapParser.TC_STRING) {
+      length = inputStream.readUnsignedShort();
+    }
+    else if (objectType === FreeOtpImporterSerializedHashMapParser.TC_LONGSTRING) {
+      length = Number(inputStream.readLong());
+    }
+    else {
+      throw new FreeOtpImporterSerializedHashMapParserParseException(`Expected a string object, found: ${objectType}`);
+    }
+    const strBytes = new Uint8Array(length);
+    inputStream.readFully(strBytes);
+    const str = DataInputStream.decodeModifiedUtf8(strBytes);
+    handles.push(str);
+    return str;
+  }
+
+  private static parseUTF(inputStream: DataInputStream): string {
+    const length = inputStream.readUnsignedShort();
+    const strBytes = new Uint8Array(length);
+    inputStream.readFully(strBytes);
+    return Bytes.toUtf8(strBytes);
+  }
+}
diff --git a/entry/src/main/ets/importers/FreeOtpPlusImporter.ets b/entry/src/main/ets/importers/FreeOtpPlusImporter.ets
