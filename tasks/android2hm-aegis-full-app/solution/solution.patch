new file mode 100644
index 0000000..c653cc2
--- /dev/null
+++ b/entry/src/main/ets/database/AuditLogRepository.ets
@@ -0,0 +1,86 @@
+import { AuditLogDao } from './AuditLogDao';
+import { AuditLogEntry } from './AuditLogEntry';
+import { EventType } from '../EventType';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+
+export type AuditLogObserver = (entries: AuditLogEntry[]) => void;
+
+export class AuditLogRepository {
+  private readonly _auditLogDao: AuditLogDao;
+  private _observers: AuditLogObserver[] = [];
+  private _queue: Promise<void> = Promise.resolve();
+
+  constructor(auditLogDao: AuditLogDao) {
+    this._auditLogDao = auditLogDao;
+  }
+
+  getAllAuditLogEntries(): Promise<AuditLogEntry[]> {
+    return this._auditLogDao.getAll();
+  }
+
+  /**
+   * Replacement for observing the LiveData returned by the Room DAO.
+   */
+  observe(observer: AuditLogObserver): void {
+    this._observers.push(observer);
+    this.notifyObservers();
+  }
+
+  removeObserver(observer: AuditLogObserver): void {
+    this._observers = this._observers.filter((o: AuditLogObserver) => o !== observer);
+  }
+
+  private notifyObservers(): void {
+    if (this._observers.length === 0) {
+      return;
+    }
+    this._auditLogDao.getAll().then((entries: AuditLogEntry[]) => {
+      for (const o of this._observers) {
+        o(entries);
+      }
+    }).catch(() => {
+    });
+  }
+
+  addVaultUnlockedEvent(): void {
+    this.insert(new AuditLogEntry(EventType.VAULT_UNLOCKED));
+  }
+
+  addBackupCreatedEvent(): void {
+    this.insert(new AuditLogEntry(EventType.VAULT_BACKUP_CREATED));
+  }
+
+  addAndroidBackupCreatedEvent(): void {
+    this.insert(new AuditLogEntry(EventType.VAULT_ANDROID_BACKUP_CREATED));
+  }
+
+  addVaultExportedEvent(): void {
+    this.insert(new AuditLogEntry(EventType.VAULT_EXPORTED));
+  }
+
+  addEntrySharedEvent(reference: string): void {
+    this.insert(new AuditLogEntry(EventType.ENTRY_SHARED, reference));
+  }
+
+  addVaultUnlockFailedPasswordEvent(): void {
+    this.insert(new AuditLogEntry(EventType.VAULT_UNLOCK_FAILED_PASSWORD));
+  }
+
+  addVaultUnlockFailedBiometricsEvent(): void {
+    this.insert(new AuditLogEntry(EventType.VAULT_UNLOCK_FAILED_BIOMETRICS));
+  }
+
+  /**
+   * Inserts the entry on a serial queue (replacement for the single thread executor).
+   */
+  insert(auditLogEntry: AuditLogEntry): void {
+    this._queue = this._queue.then(async () => {
+      try {
+        await this._auditLogDao.insert(auditLogEntry);
+        this.notifyObservers();
+      } catch (e) {
+        hilog.error(0x0000, 'AuditLogRepository', 'insert failed: %{public}s', (e as Error).message);
+      }
+    });
+  }
+}
