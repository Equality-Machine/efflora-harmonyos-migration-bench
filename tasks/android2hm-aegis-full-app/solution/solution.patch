+      .width('100%')
+      .height('100%')
+      .padding({ top: this.appBarInsetTop })
+      .backgroundColor(ThemeHelper.getBackgroundColor())
+
+      if (this.fabOpen) {
+        Column()
+          .width('100%')
+          .height('100%')
+          .backgroundColor('#66000000')
+          .transition(TransitionEffect.OPACITY)
+          .onClick(() => this._fabMenuHelper.close())
+      }
+
+      if (!this.actionMode) {
+        this.FabMenu()
+      }
+    }
+    .width('100%')
+    .height('100%')
+  }
+}
+
+/**
+ * Forwards the EntryListView events to the MainActivity page (MainActivity implements
+ * EntryListView.Listener in Java).
+ */
+class MainEntryListListener implements EntryListViewListener {
+  private _main: MainActivity;
+
+  constructor(main: MainActivity) {
+    this._main = main;
+  }
+
+  onEntryClick(entry: VaultEntry): void {
+    this._main.onEntryClick(entry);
+  }
+
+  onEntryMove(entry1: VaultEntry, entry2: VaultEntry): void {
+    this._main.onEntryMove(entry1, entry2);
+  }
+
+  onEntryDrop(entry: VaultEntry): void {
+    this._main.onEntryDrop(entry);
+  }
+
+  onEntryChange(entry: VaultEntry): void {
+    this._main.onEntryChange(entry);
+  }
+
+  onEntryCopy(entry: VaultEntry): void {
+    this._main.onEntryCopy(entry);
+  }
+
+  onLongEntryClick(entry: VaultEntry): void {
+    this._main.onLongEntryClick(entry);
+  }
+
+  onScroll(dx: number, dy: number): void {
+    this._main.onScroll(dx, dy);
+  }
+
+  onSelect(entry: VaultEntry): void {
+    this._main.onSelect(entry);
+  }
+
+  onDeselect(entry: VaultEntry): void {
+    this._main.onDeselect(entry);
+  }
+
+  onListChange(): void {
+    this._main.onListChange();
