@@ -0,0 +1,151 @@
+import { AegisActivity, PAGE_LICENSES } from './AegisActivity';
+import { Toolbar } from './components/Toolbar';
+import { Dialogs } from './dialogs/Dialogs';
+import { ThemeHelper } from '../helpers/ThemeHelper';
+import { JSONArray, JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+import { AegisModule } from '../AegisModule';
+
+class Library {
+  id: string = '';
+  name: string = '';
+  version: string = '';
+  author: string = '';
+  description: string = '';
+  website: string = '';
+  licenseNames: string[] = [];
+  licenseUrls: string[] = [];
+}
+
+/**
+ * Port of LicensesActivity (AboutLibraries' LibsActivity): lists the third party libraries and
+ * their licenses from res/raw/aboutlibraries.json, with search.
+ */
+@Entry
+@Component
+struct LicensesActivity {
+  private _activity: AegisActivity = new AegisActivity(this.getUIContext(), PAGE_LICENSES);
+  private _libraries: Library[] = [];
+  @State query: string = '';
+
+  aboutToAppear(): void {
+    this._activity.onCreate();
+    this._libraries = LicensesActivity.loadLibraries();
+  }
+
+  onPageShow(): void {
+    this._activity.onResume();
+  }
+
+  aboutToDisappear(): void {
+    this._activity.onDestroy();
+  }
+
+  private static loadLibraries(): Library[] {
+    const res: Library[] = [];
+    try {
+      const raw = Bytes.toUtf8(AegisModule.getContext().resourceManager.getRawFileContentSync('aboutlibraries.json'));
+      const obj = new JSONObject(raw);
+      const licenses = obj.getJSONObject('licenses');
+      const libs = obj.getJSONArray('libraries');
+      for (let i = 0; i < libs.length(); i++) {
+        const l = libs.getJSONObject(i);
+        const lib = new Library();
+        lib.id = l.optString('uniqueId', `${i}`);
+        lib.name = l.optString('name', lib.id);
+        lib.version = l.optString('artifactVersion', '');
+        lib.description = l.optString('description', '');
+        lib.website = l.optString('website', '');
+        const devs = l.optJSONArray('developers');
+        if (devs !== null && devs.length() > 0) {
+          const d = devs.optJSONObject(0);
+          lib.author = d !== null ? d.optString('name', '') : '';
+        }
+        const org = l.optJSONObject('organization');
+        if (lib.author.length === 0 && org !== null) {
+          lib.author = org.optString('name', '');
+        }
+        const licIds: JSONArray | null = l.optJSONArray('licenses');
+        if (licIds !== null) {
+          for (let j = 0; j < licIds.length(); j++) {
+            const lic = licenses.optJSONObject(licIds.getString(j));
+            if (lic !== null) {
+              lib.licenseNames.push(lic.optString('name', licIds.getString(j)));
+              lib.licenseUrls.push(lic.optString('url', ''));
+            }
+          }
+        }
+        res.push(lib);
+      }
+    } catch (e) {
+      // ignore
+    }
+    res.sort((a: Library, b: Library) => a.name.toLowerCase() < b.name.toLowerCase() ? -1 : 1);
+    return res;
+  }
+
+  private getFiltered(): Library[] {
+    const q = this.query.toLowerCase().trim();
+    if (q.length === 0) {
+      return this._libraries;
+    }
+    return this._libraries.filter((l: Library) => l.name.toLowerCase().indexOf(q) >= 0 || l.author.toLowerCase().indexOf(q) >= 0);
+  }
+
+  private showLicense(lib: Library): void {
+    const message = `${lib.description}\n\n${lib.licenseNames.map((n: string, i: number) => `${n}\n${lib.licenseUrls[i]}`).join('\n\n')}`;
+    Dialogs.showSimpleDialog(this.getUIContext(), lib.name, message, $r('app.string.ok'), null, null, null);
+  }
+
+  build() {
+    Column() {
+      Toolbar({ title: $r('app.string.title_activity_licenses'), onBack: () => this._activity.finish() })
+      Search({ value: this.query, placeholder: $r('app.string.search') })
+        .margin({ left: 16, right: 16, bottom: 8 })
+        .onChange((v: string) => {
+          this.query = v;
+        })
+      List() {
+        ForEach(this.getFiltered(), (lib: Library) => {
+          ListItem() {
+            Column() {
+              Row() {
+                Text(lib.name)
+                  .fontSize(16)
+                  .fontWeight(FontWeight.Medium)
+                  .fontColor($r('app.color.theme_onSurface'))
+                  .layoutWeight(1)
+                Text(lib.version)
+                  .fontSize(13)
+                  .fontColor($r('app.color.theme_onSurfaceVariant'))
+              }
+              .width('100%')
+              if (lib.author.length > 0) {
+                Text(lib.author)
+                  .fontSize(13)
+                  .fontColor($r('app.color.theme_onSurfaceVariant'))
+                  .width('100%')
+              }
+              if (lib.licenseNames.length > 0) {
+                Text(lib.licenseNames.join(', '))
+                  .fontSize(12)
+                  .fontColor($r('app.color.theme_primary'))
+                  .width('100%')
+                  .margin({ top: 4 })
+              }
+            }
+            .padding(16)
+            .borderRadius(12)
+            .backgroundColor($r('app.color.theme_surfaceContainer'))
+            .margin({ left: 16, right: 16, bottom: 8 })
+            .onClick(() => this.showLicense(lib))
+          }
+        }, (lib: Library) => lib.id)
+      }
+      .layoutWeight(1)
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
