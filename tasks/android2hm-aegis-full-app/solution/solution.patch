index 0000000..62629a4
--- /dev/null
+++ b/entry/src/main/ets/ui/tasks/ProgressDialogTask.ets
@@ -0,0 +1,48 @@
+import { DialogHandle } from '../dialogs/DialogHandle';
+import { buildProgressDialog, ProgressDialogParams } from '../dialogs/DialogViews';
+
+/**
+ * Port of ProgressDialogTask (an AsyncTask that shows a progress dialog while it runs).
+ */
+export class ProgressDialogTask {
+  private _uiContext: UIContext;
+  private _message: ResourceStr;
+  private _handle: DialogHandle | null = null;
+
+  constructor(uiContext: UIContext, message: ResourceStr) {
+    this._uiContext = uiContext;
+    this._message = message;
+  }
+
+  protected onPreExecute(): void {
+    const params = new ProgressDialogParams();
+    params.message = this._message;
+    this._handle = DialogHandle.open<ProgressDialogParams>(this._uiContext, wrapBuilder(buildProgressDialog), params,
+      params.handle, false);
+  }
+
+  protected onPostExecute(): void {
+    if (this._handle !== null && this._handle.isShowing()) {
+      this._handle.dismiss();
+    }
+    this._handle = null;
+  }
+
+  protected getUIContext(): UIContext {
+    return this._uiContext;
+  }
+
+  /**
+   * Runs the given background work while showing the progress dialog.
+   */
+  protected async run<T>(work: () => Promise<T>): Promise<T> {
+    this.onPreExecute();
+    // give the dialog a chance to appear before starting the CPU heavy work
+    await new Promise<void>((resolve: () => void) => setTimeout(resolve, 50));
+    try {
+      return await work();
+    } finally {
+      this.onPostExecute();
+    }
+  }
+}
