diff --git a/entry/src/main/ets/AccountNamePosition.ets b/entry/src/main/ets/AccountNamePosition.ets
new file mode 100644
index 0000000..51f21c9
--- /dev/null
+++ b/entry/src/main/ets/AccountNamePosition.ets
@@ -0,0 +1,11 @@
+export enum AccountNamePosition {
+  HIDDEN = 0,
+  END = 1,
+  BELOW = 2
+}
+
+export class AccountNamePositionUtils {
+  static fromInteger(x: number): AccountNamePosition {
+    return x >= 0 && x <= 2 ? x as AccountNamePosition : AccountNamePosition.END;
+  }
+}
diff --git a/entry/src/main/ets/AegisApplication.ets b/entry/src/main/ets/AegisApplication.ets
new file mode 100644
index 0000000..4552dbd
--- /dev/null
+++ b/entry/src/main/ets/AegisApplication.ets
@@ -0,0 +1,27 @@
+import { window } from '@kit.ArkUI';
+import { AegisApplicationBase } from './AegisApplicationBase';
+import { AegisModule } from './AegisModule';
+
+/**
+ * Port of AegisApplication (the Hilt application class).
+ */
+export class AegisApplication extends AegisApplicationBase {
+  /**
+   * Sets FLAG_SECURE (privacy mode) on the main window if enabled in the preferences.
+   */
+  static applySecureScreen(win: window.Window): void {
+    const secure = AegisModule.getPreferences().isSecureScreenEnabled();
+    win.setWindowPrivacyMode(secure).catch(() => {
+    });
+  }
+
+  static refreshSecureScreen(): void {
+    if (!AegisModule.hasAbilityContext()) {
+      return;
+    }
+    window.getLastWindow(AegisModule.getAbilityContext()).then((win: window.Window) => {
+      AegisApplication.applySecureScreen(win);
+    }).catch(() => {
+    });
+  }
+}
diff --git a/entry/src/main/ets/AegisApplicationBase.ets b/entry/src/main/ets/AegisApplicationBase.ets
new file mode 100644
index 0000000..ead6118
--- /dev/null
+++ b/entry/src/main/ets/AegisApplicationBase.ets
@@ -0,0 +1,107 @@
+import { common, ApplicationStateChangeCallback } from '@kit.AbilityKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { VaultManager, LockListener } from './vault/VaultManager';
+import { Preferences } from './Preferences';
+import { VaultLockReceiver } from './receivers/VaultLockReceiver';
+import { IOUtils } from './util/IOUtils';
+import { AegisModule } from './AegisModule';
+import { PAGE_MAIN } from './ui/AegisActivity';
+
+/**
+ * Global lock handler: when the vault is locked while a page other than MainActivity is shown,
+ * all pages are finished and MainActivity is shown again (which will then ask for authentication).
+ */
+class AppLockListener implements LockListener {
+  onLocked(userInitiated: boolean): void {
+    const uiContext = AegisModule.getUIContext();
+    if (uiContext === null) {
+      return;
+    }
+    try {
+      const router = uiContext.getRouter();
+      const state = router.getState();
+      const current = `${state.path}${state.name}`;
+      if (current.indexOf(PAGE_MAIN) >= 0 && router.getLength() === '1') {
+        return;
+      }
+      if (current.indexOf(PAGE_MAIN) >= 0) {
+        router.clear();
+        return;
+      }
+      router.clear();
+      router.replaceUrl({ url: PAGE_MAIN }).catch(() => {
+      });
+    } catch (e) {
+      hilog.error(0x0000, 'AegisApplication', 'Unable to reset pages after lock: %{public}s', (e as Error).message);
+    }
+  }
+}
+
+/**
+ * Port of AegisApplicationBase: initializes the app wide state when the ability is created.
+ */
+export class AegisApplicationBase {
+  private static _instance: AegisApplicationBase | null = null;
+
+  private _vaultManager: VaultManager | null = null;
+  private _lockReceiver: VaultLockReceiver = new VaultLockReceiver();
+  private _lockListener: AppLockListener = new AppLockListener();
+  private _stateCallback: ApplicationStateChangeCallback | null = null;
+
+  static getInstance(): AegisApplicationBase {
+    if (AegisApplicationBase._instance === null) {
+      AegisApplicationBase._instance = new AegisApplicationBase();
+    }
+    return AegisApplicationBase._instance;
+  }
+
+  onCreate(context: common.UIAbilityContext): void {
+    if (this._vaultManager !== null) {
+      return;
+    }
+    AegisModule.init(context.getApplicationContext());
+    AegisModule.setAbilityContext(context);
+    this._vaultManager = AegisModule.provideVaultManager();
+    this._vaultManager.registerLockListener(this._lockListener);
+
+    // lock the vault when the screen is turned off
+    this._lockReceiver.register();
+
+    // lock the app if the user moves the application to the background
+    this._stateCallback = new AppLifecycleObserver(this._vaultManager);
+    context.getApplicationContext().on('applicationStateChange', this._stateCallback);
+
+    // clear the cache directory on startup, to make sure no temporary vault export files remain
+    IOUtils.clearDirectory(context.cacheDir, false);
+  }
+
+  onDestroy(context: common.UIAbilityContext): void {
+    this._lockReceiver.unregister();
+    if (this._stateCallback !== null) {
+      try {
+        context.getApplicationContext().off('applicationStateChange', this._stateCallback);
+      } catch (e) {
+        // ignore
+      }
+    }
+  }
+}
+
+class AppLifecycleObserver extends ApplicationStateChangeCallback {
+  private _vaultManager: VaultManager;
+
+  constructor(vaultManager: VaultManager) {
+    super();
+    this._vaultManager = vaultManager;
+  }
+
+  onApplicationForeground(): void {
+  }
+
+  onApplicationBackground(): void {
+    if (this._vaultManager.isAutoLockEnabled(Preferences.AUTO_LOCK_ON_MINIMIZE)
+      && !this._vaultManager.isAutoLockBlocked()) {
+      this._vaultManager.lock(false);
+    }
+  }
+}
diff --git a/entry/src/main/ets/AegisBackupAgent.ets b/entry/src/main/ets/AegisBackupAgent.ets
new file mode 100644
index 0000000..5441428
--- /dev/null
+++ b/entry/src/main/ets/AegisBackupAgent.ets
@@ -0,0 +1,88 @@
+import { common } from '@kit.AbilityKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { Preferences, BackupResult } from './Preferences';
+import { AuditLogRepository } from './database/AuditLogRepository';
+import { AppDatabase } from './database/AppDatabase';
+import { VaultRepository } from './vault/VaultRepository';
+import { IOUtils } from './util/IOUtils';
+
+const TAG: string = 'AegisBackupAgent';
+
+/**
+ * Port of AegisBackupAgent: participates in the system backup (EntryBackupAbility). Before the
+ * system backs up files/backup, an exportable copy of the vault is written there. On restore, the
+ * copy is moved back into place.
+ */
+export class AegisBackupAgent {
+  private _context: common.Context;
+  private _prefs: Preferences;
+  private _auditLogRepository: AuditLogRepository;
+
+  constructor(context: common.Context) {
+    // Cannot use the shared singletons here, because the app may be launched in a restricted mode on restore
+    this._context = context;
+    this._prefs = new Preferences(context);
+    this._auditLogRepository = new AuditLogRepository(new AppDatabase(context).auditLogDao());
+  }
+
+  onFullBackup(): void {
+    hilog.info(0x0000, TAG, 'onFullBackup() called');
+    if (!this._prefs.isAndroidBackupsEnabled()) {
+      hilog.info(0x0000, TAG, 'onFullBackup() skipped: system backups disabled in preferences');
+      this.deleteBackupDir();
+      return;
+    }
+
+    try {
+      this.fullBackup();
+      this._auditLogRepository.addAndroidBackupCreatedEvent();
+      this._prefs.setAndroidBackupResult(BackupResult.fromException(null));
+    } catch (e) {
+      hilog.error(0x0000, TAG, 'onFullBackup() failed: %{public}s', (e as Error).message);
+      this._prefs.setAndroidBackupResult(BackupResult.fromException(e as Error));
+      throw e as Error;
+    }
+    hilog.info(0x0000, TAG, 'onFullBackup() finished');
+  }
+
+  private fullBackup(): void {
+    // copy the vault to the files/backup directory, which is included in backup_config.json
+    this.createBackupDir();
+    try {
+      const vaultFile = VaultRepository.readVaultFile(this._context);
+      IOUtils.writeFile(this.getVaultBackupFile(), vaultFile.exportable().toBytes());
+    } catch (e) {
+      this.deleteBackupDir();
+      throw e as Error;
+    }
+  }
+
+  onRestoreFile(): void {
+    hilog.info(0x0000, TAG, 'onRestoreFile() called');
+    const vaultBackupFile = this.getVaultBackupFile();
+    if (IOUtils.exists(vaultBackupFile)) {
+      try {
+        VaultRepository.writeToFile(this._context, IOUtils.readFile(vaultBackupFile));
+      } finally {
+        this.deleteBackupDir();
+      }
+    }
+    hilog.info(0x0000, TAG, 'onRestoreFile() finished');
+  }
+
+  onQuotaExceeded(backupDataBytes: number, quotaBytes: number): void {
+    hilog.error(0x0000, TAG, 'onQuotaExceeded() called: backupDataBytes=%{public}d, quotaBytes=%{public}d', backupDataBytes, quotaBytes);
+  }
+
+  private createBackupDir(): void {
+    IOUtils.mkdirs(`${this._context.filesDir}/backup`);
+  }
+
+  private deleteBackupDir(): void {
+    IOUtils.clearDirectory(`${this._context.filesDir}/backup`, true);
+  }
+
+  private getVaultBackupFile(): string {
+    return `${this._context.filesDir}/backup/${VaultRepository.FILENAME}`;
+  }
+}
diff --git a/entry/src/main/ets/AegisModule.ets b/entry/src/main/ets/AegisModule.ets
