diff --git a/entry/src/main/ets/vault/slots/Slot.ets b/entry/src/main/ets/vault/slots/Slot.ets
new file mode 100644
index 0000000..bbada5e
--- /dev/null
+++ b/entry/src/main/ets/vault/slots/Slot.ets
@@ -0,0 +1,128 @@
+import { UUIDMapValue } from '../../util/UUIDMap';
+import { UUID } from '../../util/UUID';
+import { CryptParameters } from '../../crypto/CryptParameters';
+import { Cipher, SoftwareCipher } from '../../crypto/Cipher';
+import { SecretKey } from '../../crypto/CryptoUtils';
+import { MasterKey } from '../../crypto/MasterKey';
+import { Hex } from '../../encoding/Hex';
+import { JSONObject } from '../../util/JSONObject';
+import { SlotException } from './SlotException';
+import { SlotIntegrityException } from './SlotIntegrityException';
+
+export type SlotFactory = (uuid: string, key: Uint8Array, keyParams: CryptParameters, obj: JSONObject) => Slot;
+
+export abstract class Slot extends UUIDMapValue {
+  static readonly TYPE_RAW: number = 0x00;
+  static readonly TYPE_PASSWORD: number = 0x01;
+  static readonly TYPE_BIOMETRIC: number = 0x02;
+
+  private static _factories: Map<number, SlotFactory> = new Map<number, SlotFactory>();
+
+  private _encryptedMasterKey: Uint8Array = new Uint8Array(0);
+  private _encryptedMasterKeyParams: CryptParameters | null = null;
+
+  protected constructor(uuid?: string, key?: Uint8Array, keyParams?: CryptParameters) {
+    super(uuid);
+    if (key !== undefined) {
+      this._encryptedMasterKey = key;
+    }
+    if (keyParams !== undefined) {
+      this._encryptedMasterKeyParams = keyParams;
+    }
+  }
+
+  static registerFactory(type: number, factory: SlotFactory): void {
+    Slot._factories.set(type, factory);
+  }
+
+  /**
+   * Decrypts the encrypted master key in this slot using the given cipher and returns it.
+   * @throws SlotException if a generic crypto operation error occurred.
+   * @throws SlotIntegrityException if an error occurred while verifying the integrity of the slot.
+   */
+  async getKey(cipher: Cipher): Promise<MasterKey> {
+    if (this._encryptedMasterKeyParams === null) {
+      throw new SlotException('Slot has no key');
+    }
+    let data: Uint8Array;
+    try {
+      data = await cipher.decrypt(this._encryptedMasterKey, this._encryptedMasterKeyParams);
+    } catch (e) {
+      if (cipher instanceof SoftwareCipher) {
+        throw new SlotIntegrityException((e as Error).message);
+      }
+      throw new SlotException((e as Error).message);
+    }
+    return new MasterKey(new SecretKey(data));
+  }
+
+  /**
+   * Encrypts the given master key using the given cipher and stores the result in this slot.
+   * @throws SlotException if a generic crypto operation error occurred.
+   */
+  async setKey(masterKey: MasterKey, cipher: Cipher): Promise<void> {
+    try {
+      const masterKeyBytes = masterKey.getBytes();
+      const res = await cipher.encrypt(masterKeyBytes);
+      this._encryptedMasterKey = res.getData();
+      this._encryptedMasterKeyParams = res.getParams();
+    } catch (e) {
+      throw new SlotException((e as Error).message);
+    }
+  }
+
+  static createEncryptCipher(key: SecretKey): Cipher {
+    return new SoftwareCipher(key, null);
+  }
+
+  createDecryptCipher(key: SecretKey): Cipher {
+    return new SoftwareCipher(key, this._encryptedMasterKeyParams !== null ? this._encryptedMasterKeyParams.getNonce() : null);
+  }
+
+  getEncryptedMasterKey(): Uint8Array {
+    return this._encryptedMasterKey;
+  }
+
+  getEncryptedMasterKeyParams(): CryptParameters | null {
+    return this._encryptedMasterKeyParams;
+  }
+
+  toJson(): JSONObject {
+    const obj = new JSONObject();
+    obj.put('type', this.getType());
+    obj.put('uuid', this.getUUID());
+    obj.put('key', Hex.encode(this._encryptedMasterKey));
+    obj.put('key_params', this._encryptedMasterKeyParams !== null ? this._encryptedMasterKeyParams.toJson() : null);
+    return obj;
+  }
+
+  static fromJson(obj: JSONObject): Slot {
+    try {
+      let uuid: string;
+      if (!obj.has('uuid')) {
+        uuid = UUID.randomUUID();
+      } else {
+        uuid = UUID.fromString(obj.getString('uuid'));
+      }
+
+      const key = Hex.decode(obj.getString('key'));
+      const keyParams = CryptParameters.fromJson(obj.getJSONObject('key_params'));
+      const factory = Slot._factories.get(obj.getInt('type'));
+      if (factory === undefined) {
+        throw new SlotException('unrecognized slot type');
+      }
+      return factory(uuid, key, keyParams, obj);
+    } catch (e) {
+      if (e instanceof SlotException) {
+        throw e as SlotException;
+      }
+      throw new SlotException((e as Error).message);
+    }
+  }
+
+  abstract getType(): number;
+
+  clone(): Slot {
+    return Slot.fromJson(new JSONObject(this.toJson().toString()));
+  }
+}
