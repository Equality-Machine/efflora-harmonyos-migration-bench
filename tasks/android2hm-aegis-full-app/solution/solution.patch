+  private parseEntry(): VaultEntry {
+    if (this._textSecret.length === 0) {
+      throw new EditEntryActivityParseException('Secret is a required field.');
+    }
+
+    const type = this._dropdownType;
+    const algo = this._dropdownAlgo;
+    const lowerCasedType = type.toLowerCase();
+
+    if (lowerCasedType === YandexInfo.ID || lowerCasedType === MotpInfo.ID) {
+      const pinLength = this._textPin.length;
+      if (pinLength < 4) {
+        throw new EditEntryActivityParseException('PIN is a required field. Must have a minimum length of 4 digits.');
+      }
+      if (pinLength !== 4 && lowerCasedType === MotpInfo.ID) {
+        throw new EditEntryActivityParseException('PIN must have a length of 4 digits.');
+      }
+    }
+
+    const digits = EditEntryActivity.parseInteger(this._textDigits);
+    if (digits === null || digits > 2147483647 || digits < -2147483648) {
+      throw new EditEntryActivityParseException('Digits is not an integer.');
+    }
+
+    let secret: Uint8Array;
+    try {
+      const secretString = EditTextHelper.getEditTextChars(this._textSecret).join('');
+      secret = (lowerCasedType === MotpInfo.ID) ? Hex.decode(secretString) : GoogleAuthInfo.parseSecret(secretString);
+    } catch (e) {
+      const exceptionMessage = (lowerCasedType === MotpInfo.ID) ?
+        'Secret is not valid hexadecimal' : 'Secret is not valid base32.';
