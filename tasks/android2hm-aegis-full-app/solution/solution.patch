+import { image } from '@kit.ImageKit';
+import { VaultEntry } from '../../vault/VaultEntry';
+import { IconPackIcon } from '../../icons/IconPack';
+import { VaultEntryIconLoader } from './VaultEntryIconLoader';
+import { VaultEntryIconKey } from './VaultEntryIconKey';
+import { TextDrawable } from '../../textdrawable/TextDrawable';
+import { TextDrawableHelper, TextDrawableInfo } from '../../helpers/TextDrawableHelper';
+
+/**
+ * Port of GlideHelper. Entry icons are displayed with the EntryIconView component.
+ */
+export class GlideHelper {
+  private constructor() {
+  }
+
+  /**
+   * Returns the key that must be passed to EntryIconView to display the icon of the given entry.
+   */
+  static getEntryIconKey(entry: VaultEntry): string {
+    const icon = entry.getIcon();
+    if (icon === null) {
+      return '';
+    }
+    VaultEntryIconLoader.register(icon);
+    return new VaultEntryIconKey(icon).toString();
+  }
+
+  /**
+   * Returns the URI of an icon pack icon that can be passed to an Image component.
+   */
+  static loadIcon(icon: IconPackIcon): string {
+    const file = icon.getFile();
+    return file !== null ? GlideHelper.loadIconFile(file) : '';
+  }
+
+  static loadIconFile(file: string): string {
+    return file.startsWith('file://') ? file : `file://${file}`;
+  }
+}
+
+/**
+ * Displays the icon of a vault entry, or a TextDrawable with the first letter of the issuer
+ * (or name) if the entry doesn't have an icon.
+ */
+@Component
+export struct EntryIconView {
+  @Prop @Watch('onKeyChanged') iconKey: string = '';
+  @Prop issuer: string = '';
+  @Prop name: string = '';
+  @Prop iconSize: number = 40;
+  @State pixelMap: image.PixelMap | null = null;
+
+  aboutToAppear(): void {
+    this.onKeyChanged();
+  }
+
+  onKeyChanged(): void {
+    if (this.iconKey.length === 0) {
+      this.pixelMap = null;
+      return;
+    }
+    const key = this.iconKey;
+    VaultEntryIconLoader.load(key, Math.max(64, this.iconSize * 3)).then((pm: image.PixelMap | null) => {
+      if (this.iconKey === key) {
+        this.pixelMap = pm;
+      }
+    });
+  }
+
+  private getDrawable(): TextDrawableInfo {
+    const info = TextDrawableHelper.generate(this.issuer, this.name);
+    return info !== null ? info : new TextDrawableInfo('', 0x00000000);
+  }
+
+  build() {
+    Stack() {
+      if (this.iconKey.length > 0 && this.pixelMap !== null) {
+        Image(this.pixelMap)
+          .width(this.iconSize)
+          .height(this.iconSize)
+          .objectFit(ImageFit.Contain)
+      } else {
+        TextDrawable({ text: this.getDrawable().text, color: this.getDrawable().color, drawableSize: this.iconSize })
+      }
+    }
+    .width(this.iconSize)
+    .height(this.iconSize)
+  }
+}
diff --git a/entry/src/main/ets/ui/glide/SvgDecoder.ets b/entry/src/main/ets/ui/glide/SvgDecoder.ets
new file mode 100644
index 0000000..1cd3ad6
--- /dev/null
+++ b/entry/src/main/ets/ui/glide/SvgDecoder.ets
@@ -0,0 +1,34 @@
+import { image } from '@kit.ImageKit';
+
+/**
+ * Port of SvgDecoder / SvgBytesDecoder / SvgDrawableTranscoder: SVG icons are decoded to a PixelMap
+ * by the image kit.
+ */
+export class SvgDecoder {
+  static async decode(bytes: Uint8Array, size: number): Promise<image.PixelMap | null> {
+    try {
+      const buf = bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength);
+      const source = image.createImageSource(buf);
+      try {
+        const opts: image.DecodingOptions = size > 0 ? { desiredSize: { width: size, height: size } } : {};
+        return await source.createPixelMap(opts);
+      } finally {
+        source.release();
+      }
+    } catch (e) {
+      return null;
+    }
+  }
+}
+
+export class SvgBytesDecoder {
+  static async decode(bytes: Uint8Array, size: number): Promise<image.PixelMap | null> {
+    return SvgDecoder.decode(bytes, size);
+  }
+}
+
+export class SvgDrawableTranscoder {
+  static transcode(pixelMap: image.PixelMap): image.PixelMap {
+    return pixelMap;
+  }
+}
