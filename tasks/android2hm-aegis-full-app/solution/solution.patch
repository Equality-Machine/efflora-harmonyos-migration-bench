@@ -0,0 +1,31 @@
+import { Hex } from '../../encoding/Hex';
+import { CryptoUtils } from '../CryptoUtils';
+import { Bytes } from '../../util/Bytes';
+
+export class MOTP {
+  private readonly _code: string;
+  private readonly _digits: number;
+
+  private constructor(code: string, digits: number) {
+    this._code = code;
+    this._digits = digits;
+  }
+
+  static generateOTP(secret: Uint8Array, algo: string, digits: number, period: number, pin: string, time?: number): MOTP {
+    const t = time !== undefined ? time : Math.floor(Date.now() / 1000);
+    const timeBasedCounter = Math.floor(t / period);
+    const secretAsString = Hex.encode(secret);
+    const toDigest = `${timeBasedCounter}${secretAsString}${pin}`;
+    const code = MOTP.getDigest(algo, Bytes.fromUtf8(toDigest));
+    return new MOTP(code, digits);
+  }
+
+  protected static getDigest(algo: string, toDigest: Uint8Array): string {
+    const digest = CryptoUtils.digest(algo, toDigest);
+    return Hex.encode(digest);
+  }
+
+  toString(): string {
+    return this._code.substring(0, this._digits);
+  }
+}
diff --git a/entry/src/main/ets/crypto/otp/OTP.ets b/entry/src/main/ets/crypto/otp/OTP.ets
