@@ -0,0 +1,99 @@
+import { webview } from '@kit.ArkWeb';
+import { common } from '@kit.AbilityKit';
+import { DialogHandle } from './DialogHandle';
+import { Theme } from '../../Theme';
+import { Bytes } from '../../util/Bytes';
+import { ResUtils } from '../../util/ResUtils';
+import { AegisModule } from '../../AegisModule';
+
+export class SimpleWebViewDialogParams {
+  title: ResourceStr = '';
+  content: string = '';
+  handle: DialogHandle = new DialogHandle();
+}
+
+@Component
+export struct SimpleWebViewDialogView {
+  params: SimpleWebViewDialogParams = new SimpleWebViewDialogParams();
+  private _controller: webview.WebviewController = new webview.WebviewController();
+
+  build() {
+    Column() {
+      Text(this.params.title)
+        .fontSize(22)
+        .fontColor($r('app.color.theme_onSurface'))
+        .width('100%')
+        .margin({ bottom: 12 })
+      Web({ src: '', controller: this._controller })
+        .javaScriptAccess(false)
+        .fileAccess(false)
+        .onlineImageAccess(false)
+        .height(420)
+        .width('100%')
+        .onControllerAttached(() => {
+          this._controller.loadData(this.params.content, 'text/html', 'UTF-8');
+        })
+      Row() {
+        Blank()
+        Button($r('app.string.ok'))
+          .backgroundColor(Color.Transparent)
+          .fontColor($r('app.color.theme_primary'))
+          .onClick(() => this.params.handle.dismiss())
+      }
+      .width('100%')
+      .margin({ top: 12 })
+    }
+    .padding(24)
+    .width('92%')
+    .borderRadius(28)
+    .backgroundColor($r('app.color.theme_surfaceContainerHigh'))
+  }
+}
+
+@Builder
+export function buildSimpleWebViewDialog(params: SimpleWebViewDialogParams) {
+  SimpleWebViewDialogView({ params: params })
+}
+
+/**
+ * Port of SimpleWebViewDialog: shows an HTML asset in a WebView inside a dialog.
+ */
+export abstract class SimpleWebViewDialog {
+  private _theme: Theme = Theme.SYSTEM;
+  private readonly _title: string;
+
+  protected constructor(title: string) {
+    this._title = title;
+  }
+
+  protected abstract getContent(context: common.Context): string;
+
+  setTheme(theme: Theme): SimpleWebViewDialog {
+    this._theme = theme;
+    return this;
+  }
+
+  private isDark(): boolean {
+    return this._theme === Theme.DARK || this._theme === Theme.AMOLED;
+  }
+
+  protected getBackgroundColor(): string {
+    return this._theme === Theme.AMOLED ? 'rgb(20, 20, 20)' : (this.isDark() ? 'rgb(41, 42, 45)' : 'rgb(233, 231, 236)');
+  }
+
+  protected getTextColor(): string {
+    return this.isDark() ? 'rgb(228, 226, 230)' : 'rgb(27, 27, 31)';
+  }
+
+  show(uiContext: UIContext): void {
+    const context = AegisModule.getContext();
+    const params = new SimpleWebViewDialogParams();
+    params.title = ResUtils.getString(context, this._title);
+    params.content = this.getContent(context);
+    DialogHandle.open<SimpleWebViewDialogParams>(uiContext, wrapBuilder(buildSimpleWebViewDialog), params, params.handle, true);
+  }
+
+  protected static readAssetAsString(context: common.Context, name: string): string {
+    return Bytes.toUtf8(context.resourceManager.getRawFileContentSync(name));
+  }
+}
diff --git a/entry/src/main/ets/ui/fragments/preferences/AppearancePreferencesFragment.ets b/entry/src/main/ets/ui/fragments/preferences/AppearancePreferencesFragment.ets
new file mode 100644
index 0000000..632a1e2
--- /dev/null
+++ b/entry/src/main/ets/ui/fragments/preferences/AppearancePreferencesFragment.ets
@@ -0,0 +1,272 @@
+import { i18n } from '@kit.LocalizationKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { AegisActivity, PAGE_GROUP_MANAGER, PAGE_PREFS_APPEARANCE } from '../../AegisActivity';
+import { Intent } from '../../Intent';
+import { Toolbar } from '../../components/Toolbar';
+import { Dialogs } from '../../dialogs/Dialogs';
+import { PreferencesFragment } from './PreferencesFragment';
+import { Preference, PreferenceScreen } from '../../preferences/Preference';
+import { PreferenceResources } from '../../preferences/PreferenceResources';
+import { PreferenceScreenView } from '../../preferences/PreferenceScreenView';
+import { ThemeHelper } from '../../../helpers/ThemeHelper';
+import { ThemeMap } from '../../../ThemeMap';
+import { Preferences, CodeGroupingUtils } from '../../../Preferences';
+import { ThemeUtils } from '../../../Theme';
+import { ViewMode, ViewModeUtils } from '../../../ViewMode';
+import { AccountNamePosition, AccountNamePositionUtils } from '../../../AccountNamePosition';
+import { AegisModule } from '../../../AegisModule';
+import { ResUtils } from '../../../util/ResUtils';
+
+function getStringArray(name: string): string[] {
+  return ResUtils.getStringArray(AegisModule.getContext(), name);
+}
+
+/**
+ * Applies the language from the preferences to the app (replacement for the locale override that
+ * Aegis applies to the activity contexts). The preferred language is persisted by the system.
+ */
+function applyLanguage(lang: string): void {
+  try {
+    if (lang === 'system') {
+      // 'default' only takes effect after a restart: apply the system language right away first
+      i18n.System.setAppPreferredLanguage(i18n.System.getSystemLanguage());
+      i18n.System.setAppPreferredLanguage('default');
+      return;
+    }
+    i18n.System.setAppPreferredLanguage(toLanguageTag(lang));
+  } catch (e) {
+    hilog.warn(0x0000, 'AppearancePreferences', 'Unable to set the language: %{public}s', (e as Error).message);
+  }
+}
+
+function toLanguageTag(lang: string): string {
+  if (lang === 'zh_CN') {
+    return 'zh-Hans-CN';
+  } else if (lang === 'zh_TW') {
+    return 'zh-Hant-TW';
+  }
+  return lang.replace('_', '-');
+}
+
+/**
+ * Port of AppearancePreferencesFragment (res/xml/preferences_appearance.xml).
+ */
+@Entry
+@Component
+struct AppearancePreferencesFragment {
+  @State tick: number = 0;
+  private _activity: AegisActivity | null = null;
+  private _fragment: PreferencesFragment | null = null;
+  private _prefs: Preferences = AegisModule.getPreferences();
+  private _groupsPreference: Preference | null = null;
+  private _resetUsageCountPreference: Preference | null = null;
+  private _currentAccountNamePositionPreference: Preference | null = null;
+
+  aboutToAppear(): void {
+    const activity = new AegisActivity(this.getUIContext(), PAGE_PREFS_APPEARANCE);
+    this._activity = activity;
+    activity.onCreate();
+    if (activity.abortIfOrphan()) {
+      return;
+    }
+
+    this._fragment = new PreferencesFragment(activity, () => {
+      this.tick++;
+    });
+    this._prefs = activity.getPreferences();
+    this.onCreatePreferences();
+  }
+
+  onPageShow(): void {
+    if (this._activity !== null) {
+      this._activity.onResume();
+    }
+    if (this._fragment !== null) {
+      this._fragment.onResume();
+    }
+  }
+
+  aboutToDisappear(): void {
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  private requireActivity(): AegisActivity {
+    return this._activity as AegisActivity;
+  }
+
+  private requireContext(): UIContext {
+    return this.getUIContext();
+  }
+
+  private getString(name: string, args?: Array<string | number>): string {
+    return this.requireActivity().getString(name, args);
+  }
+
+  /**
+   * Replacement for Activity.recreate(): applies the theme again and rebuilds the preference screen.
+   */
+  private recreate(): void {
+    this.requireActivity().getThemeHelper().setTheme(ThemeMap.DEFAULT);
+    this.onCreatePreferences();
+  }
+
+  onCreatePreferences(): void {
+    const fragment = this._fragment as PreferencesFragment;
+    fragment.addPreferencesFromResource(PreferenceResources.preferences_appearance());
+
+    this._groupsPreference = fragment.requirePreference<Preference>('pref_groups');
+    this._groupsPreference.setOnPreferenceClickListener((preference: Preference) => {
+      const intent = new Intent(PAGE_GROUP_MANAGER);
+      this.requireActivity().startActivity(intent);
+      return true;
+    });
+
+    this._resetUsageCountPreference = fragment.requirePreference<Preference>('pref_reset_usage_count');
+    this._resetUsageCountPreference.setOnPreferenceClickListener((preference: Preference) => {
+      Dialogs.showSimpleDialog(this.requireContext(),
+        $r('app.string.preference_reset_usage_count'),
+        $r('app.string.preference_reset_usage_count_dialog'),
+        $r('app.string.yes'), () => this._prefs.clearUsageCount(),
+        $r('app.string.no'), null);
+      return true;
+    });
+
+    const themeTitles = getStringArray('theme_titles');
+    const currentTheme = this._prefs.getCurrentTheme() as number;
+    const darkModePreference = fragment.requirePreference<Preference>('pref_dark_mode');
+    darkModePreference.setSummary(`${this.getString('selected')}: ${themeTitles[currentTheme]}`);
+    darkModePreference.setOnPreferenceClickListener((preference: Preference) => {
+      const currentTheme1 = this._prefs.getCurrentTheme() as number;
+
+      Dialogs.showSingleChoiceDialog(this.requireContext(), $r('app.string.choose_theme'), themeTitles, currentTheme1,
+        (i: number) => {
+          this._prefs.setCurrentTheme(ThemeUtils.fromInteger(i));
+          this.recreate();
+        }, true);
+
+      return true;
+    });
+
+    // Material You dynamic colors are not available on HarmonyOS
+    const dynamicColorsPreference = fragment.requirePreference<Preference>('pref_dynamic_colors');
+    dynamicColorsPreference.setEnabled(false);
+    dynamicColorsPreference.setOnPreferenceChangeListener((preference: Preference, newValue: Object) => {
+      setTimeout(() => this.recreate(), 0);
+      return true;
+    });
+
+    const langPreference = fragment.requirePreference<Preference>('pref_lang');
+    const langs = getStringArray('pref_lang_values');
+    const langNames = getStringArray('pref_lang_entries');
+    const curLangIndex = langs.indexOf(this._prefs.getLanguage()) >= 0 ? langs.indexOf(this._prefs.getLanguage()) : 0;
+    langPreference.setSummary(langNames.length > curLangIndex ? langNames[curLangIndex] : '');
+    langPreference.setOnPreferenceClickListener((preference: Preference) => {
+      Dialogs.showSingleChoiceDialog(this.requireContext(), $r('app.string.pref_lang_title'), langNames, curLangIndex,
+        (newLangIndex: number) => {
+          this._prefs.setLanguage(langs[newLangIndex]);
+          langPreference.setSummary(langNames[newLangIndex]);
+          applyLanguage(langs[newLangIndex]);
+
+          this.recreate();
+        }, true);
+      return true;
+    });
+
+    const viewModeTitles = getStringArray('view_mode_titles');
+    const currentViewMode = this._prefs.getCurrentViewMode() as number;
+    const viewModePreference = fragment.requirePreference<Preference>('pref_view_mode');
+    viewModePreference.setSummary(`${this.getString('selected')}: ${viewModeTitles[currentViewMode]}`);
+    viewModePreference.setOnPreferenceClickListener((preference: Preference) => {
+      const currentViewMode1 = this._prefs.getCurrentViewMode() as number;
+
+      Dialogs.showSingleChoiceDialog(this.requireContext(), $r('app.string.choose_view_mode'), viewModeTitles,
+        currentViewMode1, (i: number) => {
+          this._prefs.setCurrentViewMode(ViewModeUtils.fromInteger(i));
+          viewModePreference.setSummary(`${this.getString('selected')}: ${viewModeTitles[i]}`);
+          this.refreshAccountNamePositionText();
+        }, true);
+
+      return true;
+    });
+
+    // pref_expiration_state: the color of the codes is always changed when they are about to expire
+    fragment.requirePreference<Preference>('pref_expiration_state');
+
+    const codeGroupings = getStringArray('pref_code_groupings_values');
+    const codeGroupingNames = getStringArray('pref_code_groupings');
+    const codeDigitGroupingPreference = fragment.requirePreference<Preference>('pref_code_group_size_string');
+    codeDigitGroupingPreference.setOnPreferenceClickListener((preference: Preference) => {
+      const currentCodeGroupingIndex = codeGroupings.indexOf(CodeGroupingUtils.nameOf(this._prefs.getCodeGroupSize()));
+
+      Dialogs.showSingleChoiceDialog(this.requireContext(), $r('app.string.pref_code_group_size_title'), codeGroupingNames,
+        currentCodeGroupingIndex, (newCodeGroupingIndex: number) => {
+          this._prefs.setCodeGroupSize(CodeGroupingUtils.valueOf(codeGroupings[newCodeGroupingIndex]));
+        }, true);
+      return true;
+    });
+
+    const accountNamePositionTitles = getStringArray('account_name_position_titles');
+    const currentAccountNamePosition = this._prefs.getAccountNamePosition() as number;
+    const accountNamePositionPreference = fragment.requirePreference<Preference>('pref_account_name_position');
+    this._currentAccountNamePositionPreference = accountNamePositionPreference;
+    accountNamePositionPreference.setSummary(
+      `${this.getString('selected')}: ${accountNamePositionTitles[currentAccountNamePosition]}`);
+    accountNamePositionPreference.setOnPreferenceClickListener((preference: Preference) => {
+      const currentAccountNamePosition1 = this._prefs.getAccountNamePosition() as number;
+
+      Dialogs.showSingleChoiceDialog(this.requireContext(), this.getString('choose_account_name_position'),
+        accountNamePositionTitles, currentAccountNamePosition1, (i: number) => {
+          this._prefs.setAccountNamePosition(AccountNamePositionUtils.fromInteger(i));
+          accountNamePositionPreference.setSummary(`${this.getString('selected')}: ${accountNamePositionTitles[i]}`);
+          this.refreshAccountNamePositionText();
+        }, true);
+
+      return true;
+    });
+
+    this.refreshAccountNamePositionText();
+  }
+
+  private refreshAccountNamePositionText(): void {
+    if (this._currentAccountNamePositionPreference === null) {
+      return;
+    }
+    const titles = getStringArray('account_name_position_titles');
+    const override = this._prefs.getCurrentViewMode() === ViewMode.TILES
+      && this._prefs.getAccountNamePosition() === AccountNamePosition.END;
+    const position = titles[this._prefs.getAccountNamePosition() as number];
+
+    if (override) {
+      this._currentAccountNamePositionPreference.setSummary(
+        `${this.getString('selected')}: ${position}. ${this.getString('pref_account_name_position_summary_override')}`);
+    } else {
+      this._currentAccountNamePositionPreference.setSummary(`${this.getString('selected')}: ${position}`);
+    }
+  }
+
+  private getScreen(): PreferenceScreen {
+    return (this._fragment as PreferencesFragment).getPreferenceScreen();
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.pref_section_appearance_title'),
+        backgroundColorValue: ThemeHelper.isAmoled() ? '#000000' : $r('app.color.theme_surface'),
+        onBack: () => {
+          if (this._activity !== null) {
+            this._activity.finish();
+          }
+        }
+      })
+      if (this._fragment !== null) {
+        PreferenceScreenView({ screenProvider: () => this.getScreen(), tick: this.tick })
+      }
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
diff --git a/entry/src/main/ets/ui/fragments/preferences/AuditLogPreferencesFragment.ets b/entry/src/main/ets/ui/fragments/preferences/AuditLogPreferencesFragment.ets
new file mode 100644
index 0000000..675d899
--- /dev/null
+++ b/entry/src/main/ets/ui/fragments/preferences/AuditLogPreferencesFragment.ets
@@ -0,0 +1,143 @@
+import { LengthMetrics } from '@kit.ArkUI';
+import { AegisActivity, PAGE_PREFS_AUDIT_LOG } from '../../AegisActivity';
+import { Intent, RESULT_OK } from '../../Intent';
+import { Toolbar } from '../../components/Toolbar';
+import { AuditLogAdapter } from '../../views/AuditLogAdapter';
+import { AuditLogHolder } from '../../views/AuditLogHolder';
+import { AuditLogEntryModel } from '../../models/AuditLogEntryModel';
+import { ThemeHelper } from '../../../helpers/ThemeHelper';
+import { AuditLogEntry } from '../../../database/AuditLogEntry';
+import { AuditLogObserver, AuditLogRepository } from '../../../database/AuditLogRepository';
+import { AegisModule } from '../../../AegisModule';
+import { VaultEntry } from '../../../vault/VaultEntry';
+import { VaultManager } from '../../../vault/VaultManager';
+
+/**
+ * Port of AuditLogPreferencesFragment (res/layout/fragment_audit_log.xml): shows the audit log events.
+ */
+@Entry
+@Component
+struct AuditLogPreferencesFragment {
+  @State tick: number = 0;
+  @State isEmpty: boolean = false;
+  private _activity: AegisActivity | null = null;
+  private _auditLogRepository: AuditLogRepository = AegisModule.provideAuditLogRepository();
+  private _vaultManager: VaultManager = AegisModule.provideVaultManager();
+  private _adapter: AuditLogAdapter = new AuditLogAdapter();
+  private _observer: AuditLogObserver | null = null;
+
+  aboutToAppear(): void {
+    const activity = new AegisActivity(this.getUIContext(), PAGE_PREFS_AUDIT_LOG);
+    this._activity = activity;
+    activity.onCreate();
+    if (activity.abortIfOrphan()) {
+      return;
+    }
+
+    activity.setResult(RESULT_OK, new Intent(PAGE_PREFS_AUDIT_LOG).putExtra('needsRecreate', true));
+    this._auditLogRepository = activity.getAuditLogRepository();
+    this._vaultManager = activity.getVaultManager();
+    this.onViewCreated();
+  }
+
+  onPageShow(): void {
+    if (this._activity !== null) {
+      this._activity.onResume();
+    }
+  }
+
+  aboutToDisappear(): void {
+    if (this._observer !== null) {
+      this._auditLogRepository.removeObserver(this._observer);
+      this._observer = null;
+    }
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  onViewCreated(): void {
+    this._adapter.setOnDataSetChangedListener(() => {
+      this.tick++;
+    });
+
+    const observer: AuditLogObserver = (entries1: AuditLogEntry[]) => {
+      this.isEmpty = entries1.length === 0;
+
+      const models: AuditLogEntryModel[] = [];
+      for (const entry of entries1) {
+        let referencedEntry: VaultEntry | null = null;
+        const reference = entry.getReference();
+        if (reference !== null && this._vaultManager.isVaultLoaded()) {
+          const referencedEntryUUID = reference.toLowerCase();
+          if (this._vaultManager.getVault().hasEntryByUUID(referencedEntryUUID)) {
+            referencedEntry = this._vaultManager.getVault().getEntryByUUID(referencedEntryUUID);
+          }
+        }
+
+        models.push(new AuditLogEntryModel(entry, referencedEntry));
+      }
+      this._adapter.setAuditLogEntryModels(models);
+    };
+    this._observer = observer;
+    this._auditLogRepository.observe(observer);
+  }
+
+  private getModels(tick: number): AuditLogEntryModel[] {
+    return this._adapter.getAuditLogEntryModels();
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.pref_section_audit_log_title'),
+        backgroundColorValue: ThemeHelper.isAmoled() ? '#000000' : $r('app.color.theme_surface'),
+        onBack: () => {
+          if (this._activity !== null) {
+            this._activity.finish();
+          }
+        }
+      })
+      if (this.isEmpty) {
+        Column() {
+          Image($r('app.media.ic_timeline_24'))
+            .width(75)
+            .height(75)
+            .fillColor($r('app.color.theme_onSurfaceVariant'))
+          Text($r('app.string.no_events_title'))
+            .fontSize(18)
+            .fontColor($r('app.color.theme_onSurface'))
+            .padding({ top: 17 })
+          Text($r('app.string.no_events_description'))
+            .width(300)
+            .fontSize(14)
+            .lineSpacing(LengthMetrics.vp(5))
+            .padding({ top: 7 })
+            .textAlign(TextAlign.Center)
+            .fontColor($r('app.color.theme_onSurfaceVariant'))
+        }
+        .layoutWeight(1)
+        .width('100%')
+        .justifyContent(FlexAlign.Center)
+        .padding({ bottom: 150 })
+      } else {
+        // replacement for the SpacesItemDecoration (8dp around every item)
+        List({ space: 8 }) {
+          ForEach(this.getModels(this.tick), (model: AuditLogEntryModel, index: number) => {
+            ListItem() {
+              AuditLogHolder({ model: model })
+            }
+          }, (model: AuditLogEntryModel, index: number) =>
+          `${model.getAuditLogEntry().getId()}-${model.getAuditLogEntry().getTimestamp()}-${index}-${this.tick}`)
+        }
+        .layoutWeight(1)
+        .width('100%')
+        .padding({ left: 8, right: 8, top: 8, bottom: 8 })
+        .scrollBar(BarState.Auto)
+      }
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
diff --git a/entry/src/main/ets/ui/fragments/preferences/BackupsPreferencesFragment.ets b/entry/src/main/ets/ui/fragments/preferences/BackupsPreferencesFragment.ets
