+import { ImportEntry } from '../models/ImportEntry';
+
+/**
+ * Port of ImportEntriesAdapter: the list of entries that are about to be imported.
+ */
+export class ImportEntriesAdapter {
+  private _entries: ImportEntry[] = [];
+  private _onChange: (() => void) | null = null;
+
+  setOnChangeListener(listener: () => void): void {
+    this._onChange = listener;
+  }
+
+  private notifyChanged(): void {
+    if (this._onChange !== null) {
+      this._onChange();
+    }
+  }
+
+  addEntry(entry: ImportEntry): void {
+    this._entries.push(entry);
+    this.notifyChanged();
+  }
+
+  getEntries(): ImportEntry[] {
+    return this._entries;
+  }
+
+  getCheckedEntries(): ImportEntry[] {
+    return this._entries.filter((e: ImportEntry) => e.isChecked());
+  }
+
+  toggleCheckboxes(): void {
+    const checkedEntries = this.getCheckedEntries().length;
+    if (checkedEntries === 0 || checkedEntries !== this._entries.length) {
+      this.setCheckboxStates(true);
+    } else {
+      this.setCheckboxStates(false);
+    }
+  }
+
+  setCheckboxStates(checked: boolean, uuids?: string[]): void {
+    for (const entry of this._entries) {
+      if (uuids === undefined || uuids.indexOf(entry.getEntry().getUUID()) >= 0) {
+        entry.setIsChecked(checked);
+      }
+    }
+    this.notifyChanged();
+  }
+
+  getItemCount(): number {
+    return this._entries.length;
+  }
+}
