+import { ComponentContent } from '@kit.ArkUI';
+import { DialogHandle } from './DialogHandle';
+
+/**
+ * Replacement for com.google.android.material.bottomsheet.BottomSheetDialog on top of
+ * UIContext.openBindSheet. The content is built by the given builder.
+ */
+export class BottomSheetDialog {
+  private constructor() {
+  }
+
+  static open<T extends Object>(uiContext: UIContext, builder: WrappedBuilder<[T]>, params: T, handle: DialogHandle,
+    cancelable: boolean, height?: SheetSize | Length): DialogHandle {
+    const content = new ComponentContent<T>(uiContext, builder, params);
+    const options: SheetOptions = {
+      height: height !== undefined ? height : SheetSize.FIT_CONTENT,
+      dragBar: true,
+      showClose: false,
+      preferType: SheetType.BOTTOM,
+      backgroundColor: $r('app.color.theme_surfaceContainerLow'),
+      onWillDismiss: (action: DismissSheetAction) => {
+        if (cancelable) {
+          action.dismiss();
+        }
+      },
+      onDisappear: () => {
+        handle.markDismissed();
+      }
+    };
+    handle.setCloser(() => {
+      uiContext.closeBindSheet(content).catch(() => {
+      });
+    });
+    uiContext.openBindSheet(content, options).catch(() => {
+      handle.markDismissed();
+    });
+    return handle;
+  }
+}
