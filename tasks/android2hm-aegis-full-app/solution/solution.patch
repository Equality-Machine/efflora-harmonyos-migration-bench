@@ -0,0 +1,70 @@
+import { ComponentContent, promptAction } from '@kit.ArkUI';
+
+/**
+ * Handle to a dialog that was opened through Dialogs.open(). Replacement for android.app.Dialog.
+ */
+export class DialogHandle {
+  private _closer: (() => void) | null = null;
+  private _onDismiss: (() => void) | null = null;
+  private _showing: boolean = false;
+
+  setCloser(closer: () => void): void {
+    this._closer = closer;
+    this._showing = true;
+  }
+
+  setOnDismissListener(listener: () => void): void {
+    this._onDismiss = listener;
+  }
+
+  isShowing(): boolean {
+    return this._showing;
+  }
+
+  dismiss(): void {
+    if (!this._showing) {
+      return;
+    }
+    this._showing = false;
+    if (this._closer !== null) {
+      this._closer();
+    }
+    if (this._onDismiss !== null) {
+      this._onDismiss();
+    }
+  }
+
+  /**
+   * Called when the dialog was dismissed by the system (back press / touch outside).
+   */
+  markDismissed(): void {
+    if (this._showing) {
+      this._showing = false;
+      if (this._onDismiss !== null) {
+        this._onDismiss();
+      }
+    }
+  }
+
+  static open<T extends Object>(uiContext: UIContext, builder: WrappedBuilder<[T]>, params: T, handle: DialogHandle,
+    cancelable: boolean): DialogHandle {
+    const content = new ComponentContent<T>(uiContext, builder, params);
+    const options: promptAction.BaseDialogOptions = {
+      autoCancel: cancelable,
+      alignment: DialogAlignment.Center,
+      onWillDismiss: (action: DismissDialogAction) => {
+        if (cancelable) {
+          action.dismiss();
+          handle.markDismissed();
+        }
+      }
+    };
+    handle.setCloser(() => {
+      uiContext.getPromptAction().closeCustomDialog(content).catch(() => {
+      });
+    });
+    uiContext.getPromptAction().openCustomDialog(content, options).catch(() => {
+    });
+    return handle;
+  }
+}
