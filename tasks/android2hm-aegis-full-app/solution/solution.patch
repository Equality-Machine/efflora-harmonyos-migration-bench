@@ -0,0 +1,56 @@
+import { common } from '@kit.AbilityKit';
+import { settings } from '@kit.BasicServicesKit';
+import { AegisModule } from '../AegisModule';
+
+/**
+ * Port of AnimationsHelper.Scale: the system wide animation duration scales.
+ */
+export class AnimationsHelperScale {
+  static readonly ANIMATOR: AnimationsHelperScale = new AnimationsHelperScale(settings.display.ANIMATOR_DURATION_SCALE);
+  static readonly TRANSITION: AnimationsHelperScale = new AnimationsHelperScale(settings.display.TRANSITION_ANIMATION_SCALE);
+
+  private readonly _setting: string;
+
+  private constructor(setting: string) {
+    this._setting = setting;
+  }
+
+  getValue(context?: common.Context): number {
+    try {
+      const ctx: common.Context = context !== undefined ? context :
+        (AegisModule.hasAbilityContext() ? AegisModule.getAbilityContext() : AegisModule.getContext());
+      const value = parseFloat(settings.getValueSync(ctx, this._setting, '1.0'));
+      return isNaN(value) ? 1.0 : value;
+    } catch (e) {
+      return 1.0;
+    }
+  }
+
+  isZero(context?: common.Context): boolean {
+    return this.getValue(context) === 0;
+  }
+}
+
+/**
+ * Port of AnimationsHelper. ArkUI animations are described by their duration (in ms), so these
+ * helpers scale a duration by the system wide animation scale.
+ */
+export class AnimationsHelper {
+  private constructor() {
+  }
+
+  /**
+   * Returns the given animation duration scaled by the given system animation scale (default: ANIMATOR).
+   */
+  static loadScaledAnimation(context: common.Context | undefined, duration: number, scale?: AnimationsHelperScale): number {
+    const s = scale !== undefined ? scale : AnimationsHelperScale.ANIMATOR;
+    return Math.floor(duration * s.getValue(context));
+  }
+
+  /**
+   * Returns the given layout animation duration scaled by the given system animation scale (default: ANIMATOR).
+   */
+  static loadScaledLayoutAnimation(context: common.Context | undefined, duration: number, scale?: AnimationsHelperScale): number {
+    return AnimationsHelper.loadScaledAnimation(context, duration, scale);
+  }
+}
diff --git a/entry/src/main/ets/helpers/BiometricSlotInitializer.ets b/entry/src/main/ets/helpers/BiometricSlotInitializer.ets
new file mode 100644
index 0000000..ae1e8b5
--- /dev/null
+++ b/entry/src/main/ets/helpers/BiometricSlotInitializer.ets
@@ -0,0 +1,113 @@
+import { BiometricSlot } from '../vault/slots/BiometricSlot';
+import { KeyStoreHandle } from '../crypto/KeyStoreHandle';
+import { Cipher, KeyStoreCipher } from '../crypto/Cipher';
+import { BiometricPrompt, BiometricPromptInfo, BiometricAuthenticationCallback } from './BiometricsHelper';
+
+export interface BiometricSlotInitializerListener {
+  onInitializeSlot(slot: BiometricSlot, cipher: Cipher): void;
+
+  onSlotInitializationFailed(errorCode: number, errString: string): void;
+}
+
+/**
+ * A class that can prepare initialization of a BiometricSlot by generating a new
+ * key in HUKS and authenticating a cipher for it through the biometric prompt.
+ */
+export class BiometricSlotInitializer implements BiometricAuthenticationCallback {
+  private _slot: BiometricSlot | null = null;
+  private _cipher: KeyStoreCipher | null = null;
+  private _listener: BiometricSlotInitializerListener;
+  private _prompt: BiometricPrompt = new BiometricPrompt();
+
+  constructor(listener: BiometricSlotInitializerListener) {
+    this._listener = listener;
+  }
+
+  /**
+   * Generates a new key in HUKS for the new BiometricSlot, initializes a cipher with it and shows
+   * a biometric prompt to the user for authentication. If authentication is successful, the new
+   * slot will be initialized and delivered back through the listener.
+   */
+  async authenticate(info: BiometricPromptInfo): Promise<void> {
+    if (this._slot !== null) {
+      throw new Error('Biometric authentication already in progress');
+    }
+
+    const keyStore = new KeyStoreHandle();
+
+    // generate a new HUKS key and assign it the UUID of the new slot as an alias
+    const slot = new BiometricSlot();
+    let challenge: Uint8Array;
+    try {
+      await keyStore.generateKey(slot.getUUID());
+      const cipher = keyStore.createEncryptCipher(slot.getUUID());
+      challenge = await cipher.init();
+      this._cipher = cipher;
+    } catch (e) {
+      this._slot = slot;
+      this.failWith(e as Error);
+      return;
+    }
+
+    this._slot = slot;
+    this._prompt.authenticate(info, challenge, this);
+  }
+
+  /**
+   * Cancels the biometric prompt and resets the state of the initializer. It will
+   * also attempt to delete the previously generated HUKS key.
+   */
+  cancelAuthentication(): void {
+    if (this._slot === null) {
+      throw new Error('Biometric authentication not in progress');
+    }
+    this.reset();
+    this._prompt.cancelAuthentication();
+  }
+
+  private reset(): void {
+    if (this._slot !== null) {
+      // clean up the unused HUKS key
+      // this is non-critical, so just fail silently if an error occurs
+      const uuid = this._slot.getUUID();
+      const keyStore = new KeyStoreHandle();
+      keyStore.containsKey(uuid).then((contains: boolean) => {
+        if (contains) {
+          keyStore.deleteKey(uuid).catch(() => {
+          });
+        }
+      }).catch(() => {
+      });
+      if (this._cipher !== null) {
+        this._cipher.abort();
+        this._cipher = null;
+      }
+      this._slot = null;
+    }
+  }
+
+  private fail(errorCode: number, errString: string): void {
+    this.reset();
+    this._listener.onSlotInitializationFailed(errorCode, errString);
+  }
+
+  private failWith(e: Error): void {
+    this.fail(0, `${e.name}: ${e.message}`);
+  }
+
+  onAuthenticationError(errorCode: number, errString: string): void {
+    this.fail(errorCode, errString);
+  }
+
+  onAuthenticationSucceeded(token: Uint8Array): void {
+    if (this._slot === null || this._cipher === null) {
+      return;
+    }
+    this._cipher.setAuthToken(token);
+    const slot = this._slot;
+    const cipher = this._cipher;
+    this._slot = null;
+    this._cipher = null;
+    this._listener.onInitializeSlot(slot, cipher);
+  }
+}
diff --git a/entry/src/main/ets/helpers/BiometricsHelper.ets b/entry/src/main/ets/helpers/BiometricsHelper.ets
new file mode 100644
index 0000000..aa00445
--- /dev/null
+++ b/entry/src/main/ets/helpers/BiometricsHelper.ets
@@ -0,0 +1,102 @@
+import { userAuth } from '@kit.UserAuthenticationKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { UiThreadExecutor } from './UiThreadExecutor';
+
+/**
+ * Replacement for androidx.biometric.BiometricPrompt.PromptInfo
+ */
+export class BiometricPromptInfo {
+  title: string;
+  subtitle: string;
+  negativeButtonText: string;
+
+  constructor(title: string, subtitle: string, negativeButtonText: string) {
+    this.title = title;
+    this.subtitle = subtitle;
+    this.negativeButtonText = negativeButtonText;
+  }
+}
+
+export interface BiometricAuthenticationCallback {
+  onAuthenticationSucceeded(token: Uint8Array): void;
+
+  onAuthenticationError(errorCode: number, errString: string): void;
+}
+
+/**
+ * Wrapper around the user authentication framework (replacement for BiometricPrompt).
+ */
+export class BiometricPrompt {
+  private _instance: userAuth.UserAuthInstance | null = null;
+
+  authenticate(info: BiometricPromptInfo, challenge: Uint8Array, callback: BiometricAuthenticationCallback): void {
+    const authParam: userAuth.AuthParam = {
+      challenge: challenge,
+      authType: [userAuth.UserAuthType.FINGERPRINT, userAuth.UserAuthType.FACE],
+      authTrustLevel: userAuth.AuthTrustLevel.ATL3
+    };
+    const widgetParam: userAuth.WidgetParam = {
+      title: info.subtitle.length > 0 ? `${info.title}\n${info.subtitle}` : info.title,
+      navigationButtonText: info.negativeButtonText
+    };
+    try {
+      const instance = userAuth.getUserAuthInstance(authParam, widgetParam);
+      this._instance = instance;
+      instance.on('result', {
+        onResult: (result: userAuth.UserAuthResult) => {
+          this._instance = null;
+          new UiThreadExecutor().execute(() => this.dispatch(result, callback));
+        }
+      });
+      instance.start();
+    } catch (e) {
+      hilog.error(0x0000, 'BiometricsHelper', 'Unable to start authentication: %{public}s', JSON.stringify(e));
+      const code = (e as Record<string, Object>)['code'];
+      callback.onAuthenticationError(typeof code === 'number' ? code as number : -1, (e as Error).message);
+    }
+  }
+
+  private dispatch(result: userAuth.UserAuthResult, callback: BiometricAuthenticationCallback): void {
+    if (result.result === userAuth.UserAuthResultCode.SUCCESS && result.token !== undefined) {
+      callback.onAuthenticationSucceeded(result.token);
+    } else {
+      callback.onAuthenticationError(result.result, `${result.result}`);
+    }
+  }
+
+  cancelAuthentication(): void {
+    if (this._instance !== null) {
+      try {
+        this._instance.cancel();
+      } catch (e) {
+        // ignore
+      }
+      this._instance = null;
+    }
+  }
+}
+
+export class BiometricsHelper {
+  private constructor() {
+  }
+
+  static isCanceled(errorCode: number): boolean {
+    return errorCode === userAuth.UserAuthResultCode.CANCELED;
+  }
+
+  /**
+   * Reports whether strong biometric authentication (fingerprint or face, ATL3) is available.
+   */
+  static isAvailable(): boolean {
+    const types: userAuth.UserAuthType[] = [userAuth.UserAuthType.FINGERPRINT, userAuth.UserAuthType.FACE];
+    for (const type of types) {
+      try {
+        userAuth.getAvailableStatus(type, userAuth.AuthTrustLevel.ATL3);
+        return true;
+      } catch (e) {
+        // not available
+      }
+    }
+    return false;
+  }
+}
diff --git a/entry/src/main/ets/helpers/BitmapHelper.ets b/entry/src/main/ets/helpers/BitmapHelper.ets
new file mode 100644
index 0000000..e24db25
--- /dev/null
+++ b/entry/src/main/ets/helpers/BitmapHelper.ets
@@ -0,0 +1,114 @@
+import { image } from '@kit.ImageKit';
+import { VaultEntryIcon } from '../vault/VaultEntryIcon';
+import { IconType } from '../icons/IconType';
+
+/**
+ * Port of BitmapHelper. Android Bitmaps are replaced by ImageKit PixelMaps.
+ */
+export class BitmapHelper {
+  private constructor() {
+  }
+
+  /**
+   * Scales the given PixelMap to the given maximum width/height, while keeping the aspect ratio intact.
+   * The given PixelMap is not modified, a new (scaled) PixelMap is returned.
+   */
+  static async resize(bitmap: image.PixelMap, maxWidth: number, maxHeight: number): Promise<image.PixelMap> {
+    if (maxHeight <= 0 || maxWidth <= 0) {
+      return bitmap;
+    }
+
+    const size = bitmap.getImageInfoSync().size;
+    const maxRatio = maxWidth / maxHeight;
+    const ratio = size.width / size.height;
+
+    let width = maxWidth;
+    let height = maxHeight;
+    if (maxRatio > 1) {
+      width = Math.floor(maxHeight * ratio);
+    } else {
+      height = Math.floor(maxWidth / ratio);
+    }
+
+    width = Math.max(1, width);
+    height = Math.max(1, height);
+    return await bitmap.createScaledPixelMap(width / size.width, height / size.height, image.AntiAliasingLevel.MEDIUM);
+  }
+
+  /**
+   * Returns the dimensions of the encoded image, without decoding the full image.
+   */
+  static getImageSize(bytes: Uint8Array): image.Size | null {
+    let source: image.ImageSource | null = null;
+    try {
+      source = image.createImageSource(BitmapHelper.toArrayBuffer(bytes));
+      return source.getImageInfoSync().size;
+    } catch (e) {
+      return null;
+    } finally {
+      if (source !== null) {
+        source.release();
+      }
+    }
+  }
+
+  static isVaultEntryIconOptimized(icon: VaultEntryIcon): boolean {
+    const size = BitmapHelper.getImageSize(icon.getBytes());
+    const width = size !== null ? size.width : -1;
+    const height = size !== null ? size.height : -1;
+    return width <= VaultEntryIcon.MAX_DIMENS && height <= VaultEntryIcon.MAX_DIMENS;
+  }
+
+  /**
+   * Reports whether the given PixelMap has an alpha channel (replacement for Bitmap.hasAlpha()).
+   */
+  static hasAlpha(bitmap: image.PixelMap): boolean {
+    const alphaType = bitmap.getImageInfoSync().alphaType;
+    return alphaType !== image.AlphaType.OPAQUE && alphaType !== image.AlphaType.UNKNOWN;
+  }
+
+  /**
+   * Decodes the given encoded image (PNG, JPEG, ...) into a PixelMap (replacement for BitmapFactory.decodeByteArray).
+   */
+  static async decodeByteArray(bytes: Uint8Array): Promise<image.PixelMap> {
+    const source = image.createImageSource(BitmapHelper.toArrayBuffer(bytes));
+    try {
+      return await source.createPixelMap();
+    } finally {
+      source.release();
+    }
+  }
+
+  static async toVaultEntryIcon(bitmap: image.PixelMap, iconType: IconType): Promise<VaultEntryIcon> {
+    let bmp = bitmap;
+    const size = bmp.getImageInfoSync().size;
+    if (size.width > VaultEntryIcon.MAX_DIMENS || size.height > VaultEntryIcon.MAX_DIMENS) {
+      bmp = await BitmapHelper.resize(bmp, VaultEntryIcon.MAX_DIMENS, VaultEntryIcon.MAX_DIMENS);
+    }
+
+    let type = iconType;
+    const packer = image.createImagePacker();
+    let data: ArrayBuffer;
+    try {
+      if (type === IconType.PNG) {
+        const opts: image.PackingOption = { format: 'image/png', quality: 100 };
+        data = await packer.packToData(bmp, opts);
+      } else {
+        type = IconType.JPEG;
+        const opts: image.PackingOption = { format: 'image/jpeg', quality: 90 };
+        data = await packer.packToData(bmp, opts);
+      }
+    } finally {
+      packer.release();
+      if (bmp !== bitmap) {
+        bmp.release();
+      }
+    }
+
+    return new VaultEntryIcon(new Uint8Array(data), type);
+  }
+
+  static toArrayBuffer(bytes: Uint8Array): ArrayBuffer {
+    return bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength) as ArrayBuffer;
+  }
+}
