@@ -0,0 +1,89 @@
+import { AegisActivity, PAGE_PREFS_MAIN } from '../../AegisActivity';
+import { Intent } from '../../Intent';
+import { Toolbar } from '../../components/Toolbar';
+import { PreferencesFragment } from './PreferencesFragment';
+import { Preference, PreferenceScreen } from '../../preferences/Preference';
+import { PreferenceResources } from '../../preferences/PreferenceResources';
+import { PreferenceScreenView } from '../../preferences/PreferenceScreenView';
+import { ThemeHelper } from '../../../helpers/ThemeHelper';
+
+/**
+ * Port of MainPreferencesFragment: the list of preference sections (res/xml/preferences.xml).
+ */
+@Entry
+@Component
+struct MainPreferencesFragment {
+  @State tick: number = 0;
+  private _activity: AegisActivity | null = null;
+  private _fragment: PreferencesFragment | null = null;
+
+  aboutToAppear(): void {
+    const activity = new AegisActivity(this.getUIContext(), PAGE_PREFS_MAIN);
+    this._activity = activity;
+    activity.onCreate();
+    if (activity.abortIfOrphan()) {
+      return;
+    }
+
+    this._fragment = new PreferencesFragment(activity, () => {
+      this.tick++;
+    });
+    this.onCreatePreferences();
+  }
+
+  onPageShow(): void {
+    if (this._activity !== null) {
+      this._activity.onResume();
+    }
+    if (this._fragment !== null) {
+      this._fragment.onResume();
+    }
+  }
+
+  aboutToDisappear(): void {
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  onCreatePreferences(): void {
+    const fragment = this._fragment as PreferencesFragment;
+    fragment.addPreferencesFromResource(PreferenceResources.preferences());
+    fragment.getPreferenceScreen().setOnPreferenceStartFragmentCallback((pref: Preference) => {
+      return this.onPreferenceStartFragment(pref);
+    });
+  }
+
+  private onPreferenceStartFragment(pref: Preference): boolean {
+    const url = pref.getFragment();
+    if (url === null || this._activity === null) {
+      return false;
+    }
+    this._activity.startActivity(new Intent(url));
+    return true;
+  }
+
+  private getScreen(): PreferenceScreen {
+    return (this._fragment as PreferencesFragment).getPreferenceScreen();
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.action_settings'),
+        backgroundColorValue: ThemeHelper.isAmoled() ? '#000000' : $r('app.color.theme_surface'),
+        onBack: () => {
+          if (this._activity !== null) {
+            this._activity.finish();
+          }
+        }
+      })
+      if (this._fragment !== null) {
+        PreferenceScreenView({ screenProvider: () => this.getScreen(), tick: this.tick })
+      }
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
diff --git a/entry/src/main/ets/ui/fragments/preferences/PreferencesFragment.ets b/entry/src/main/ets/ui/fragments/preferences/PreferencesFragment.ets
new file mode 100644
index 0000000..9720241
--- /dev/null
+++ b/entry/src/main/ets/ui/fragments/preferences/PreferencesFragment.ets
@@ -0,0 +1,124 @@
+import { Preferences } from '../../../Preferences';
+import { VaultManager } from '../../../vault/VaultManager';
+import { AuditLogRepository } from '../../../database/AuditLogRepository';
+import { AegisActivity } from '../../AegisActivity';
+import { Intent, RESULT_OK } from '../../Intent';
+import { Dialogs } from '../../dialogs/Dialogs';
+import { Preference, PreferenceScreen } from '../../preferences/Preference';
+
+/**
+ * Port of the abstract PreferencesFragment base class. ArkUI pages can't inherit, so every
+ * preference page owns an instance of this helper, which holds the preference screen and the
+ * shared logic (scroll to the requested preference, save the vault, look up preferences).
+ */
+export class PreferencesFragment {
+  // activity request codes
+  static readonly CODE_EXPORT: number = 5;
+  static readonly CODE_EXPORT_PLAIN: number = 6;
+  static readonly CODE_EXPORT_GOOGLE_URI: number = 7;
+  static readonly CODE_EXPORT_HTML: number = 8;
+
+  protected _prefs: Preferences;
+  protected _vaultManager: VaultManager;
+  protected _auditLogRepository: AuditLogRepository;
+
+  private _activity: AegisActivity;
+  private _screen: PreferenceScreen = new PreferenceScreen('', []);
+  private _onChanged: () => void;
+
+  /**
+   * @param activity the AegisActivity helper of the page that hosts this fragment.
+   * @param onChanged called every time the preference screen changed and has to be re-rendered.
+   */
+  constructor(activity: AegisActivity, onChanged: () => void) {
+    this._activity = activity;
+    this._onChanged = onChanged;
+    this._prefs = activity.getPreferences();
+    this._vaultManager = activity.getVaultManager();
+    this._auditLogRepository = activity.getAuditLogRepository();
+
+    // the main list must refresh after any visit to the preferences
+    activity.setResult(RESULT_OK, new Intent(activity.getIntent().url).putExtra('needsRecreate', true));
+  }
+
+  /**
+   * Replacement for addPreferencesFromResource(R.xml.xxx): the screens are defined in PreferenceResources.
+   */
+  addPreferencesFromResource(screen: PreferenceScreen): void {
+    this._screen = screen;
+    this._screen.setOnChangedListener(() => this._onChanged());
+    this._onChanged();
+  }
+
+  getPreferenceScreen(): PreferenceScreen {
+    return this._screen;
+  }
+
+  getActivity(): AegisActivity {
+    return this._activity;
+  }
+
+  requireActivity(): AegisActivity {
+    return this._activity;
+  }
+
+  requireContext(): UIContext {
+    return this._activity.getUIContext();
+  }
+
+  getPreferences(): Preferences {
+    return this._prefs;
+  }
+
+  getVaultManager(): VaultManager {
+    return this._vaultManager;
+  }
+
+  getAuditLogRepository(): AuditLogRepository {
+    return this._auditLogRepository;
+  }
+
+  getString(name: string, args?: Array<string | number>): string {
+    return this._activity.getString(name, args);
+  }
+
+  /**
+   * Called from onPageShow. Scrolls to the preference that was requested through the "pref" extra.
+   */
+  onResume(): void {
+    const intent = this._activity.getIntent();
+    const preference = intent.getStringExtra('pref');
+    if (preference !== null) {
+      this.scrollToPreference(preference);
+      intent.removeExtra('pref');
+    }
+  }
+
+  scrollToPreference(key: string): void {
+    this._screen.scrollToPreference(key);
+  }
+
+  saveAndBackupVault(): boolean {
+    try {
+      this._vaultManager.saveAndBackup();
+    } catch (e) {
+      Dialogs.showErrorDialog(this.requireContext(), $r('app.string.saving_error'), e as Error);
+      return false;
+    }
+
+    return true;
+  }
+
+  findPreference(key: string): Preference | null {
+    return this._screen.findPreference(key);
+  }
+
+  requirePreference<T extends Preference>(key: string): T {
+    const pref = this.findPreference(key);
+    if (pref === null) {
+      throw new Error(`Preference ${key} not found`);
+    }
+
+    return pref as T;
+  }
+}
diff --git a/entry/src/main/ets/ui/fragments/preferences/SecurityPreferencesFragment.ets b/entry/src/main/ets/ui/fragments/preferences/SecurityPreferencesFragment.ets
