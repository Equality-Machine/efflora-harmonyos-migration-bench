@@ -0,0 +1,353 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState, DecryptListener } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { SqlImporterHelper, SqlImporterHelperEntry, SqlImporterHelperCursor } from './SqlImporterHelper';
+import { CryptoUtils, SecretKey } from '../crypto/CryptoUtils';
+import { Argon2Parameters, Argon2ParametersBuilder } from '../crypto/bc/Argon2Parameters';
+import { Base32 } from '../encoding/Base32';
+import { HotpInfo } from '../otp/HotpInfo';
+import { OtpInfo } from '../otp/OtpInfo';
+import { SteamInfo } from '../otp/SteamInfo';
+import { TotpInfo } from '../otp/TotpInfo';
+import { Dialogs } from '../ui/dialogs/Dialogs';
+import { Argon2Task, Argon2TaskParams } from '../ui/tasks/Argon2Task';
+import { PBKDFTask, PBKDFTaskParams } from '../ui/tasks/PBKDFTask';
+import { JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+import { DataInputStream, EOFException } from '../util/DataInputStream';
+import { VaultEntry } from '../vault/VaultEntry';
+
+const HEADER: string = 'AUTHENTICATORPRO';
+
+const HEADER_LEGACY: string = 'AuthenticatorPro';
+
+const PKG_NAME: string = 'com.stratumauth.app';
+
+const PKG_DB_PATH: string = 'databases/authenticator.db3';
+
+export enum StratumImporterAlgorithm {
+  SHA1 = 0,
+  SHA256 = 1,
+  SHA512 = 2
+}
+
+const ALGORITHM_NAMES: string[] = ['SHA1', 'SHA256', 'SHA512'];
+
+/**
+ * Replacement for Algorithm.values()[i].name().
+ */
+function algorithmName(i: number): string {
+  if (i < 0 || i >= ALGORITHM_NAMES.length || Math.floor(i) !== i) {
+    throw new DatabaseImporterException(`Unsupported algorithm: ${i}`);
+  }
+
+  return ALGORITHM_NAMES[i];
+}
+
+export class StratumImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    return this.getAppPathForPackage(PKG_NAME, PKG_DB_PATH);
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    return isInternal ? this.readInternal(stream) : StratumImporter.readExternal(stream);
+  }
+
+  private async readInternal(stream: Uint8Array): Promise<DatabaseImporterState> {
+    const entries = await new SqlImporterHelper(this.requireContext()).read<StratumImporterSqlEntry>((cursor: SqlImporterHelperCursor) => new StratumImporterSqlEntry(cursor), stream, 'authenticator');
+    return new StratumImporterSqlState(entries);
+  }
+
+  private static readExternal(data: Uint8Array): DatabaseImporterState {
+    let obj: JSONObject | null = null;
+    try {
+      obj = new JSONObject(Bytes.toUtf8(data));
+    }
+    catch (e) {
+      obj = null;
+    }
+    if (obj !== null) {
+      return new StratumImporterJsonState(obj);
+    }
+    return StratumImporter.readEncrypted(new DataInputStream(data));
+  }
+
+  private static readEncrypted(stream: DataInputStream): DatabaseImporterState {
+    try {
+      const headerBytes = new Uint8Array(Bytes.fromUtf8(HEADER).length);
+      stream.readFully(headerBytes);
+      const header = Bytes.toLatin1(headerBytes);
+      switch (header) {
+        case HEADER:
+          return StratumImporterEncryptedState.parseHeader(stream);
+        case HEADER_LEGACY:
+          return StratumImporterLegacyEncryptedState.parseHeader(stream);
+        default:
+          throw new DatabaseImporterException('Invalid file header');
+      }
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterException) {
+        throw e as DatabaseImporterException;
+      }
+      if (e instanceof EOFException) {
+        throw new DatabaseImporterException('Invalid file header');
+      }
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  static parseOtpInfo(type: number, secret: Uint8Array, algo: string, digits: number, period: number, counter: number): OtpInfo {
+    switch (type) {
+      case 1:
+        return new HotpInfo(secret, algo, digits, counter);
+      case 2:
+        return new TotpInfo(secret, algo, digits, period);
+      case 4:
+        return new SteamInfo(secret, algo, digits, period);
+      default:
+        throw new DatabaseImporterEntryException(`Unsupported otp type: ${type}`, null);
+    }
+  }
+}
+
+export class StratumImporterEncryptedState extends DatabaseImporterState {
+  private static readonly KEY_SIZE: number = 32;
+  private static readonly MEMORY_COST: number = 16; // 2^16 KiB = 64 MiB
+  private static readonly PARALLELISM: number = 4;
+  private static readonly ITERATIONS: number = 3;
+  private static readonly SALT_SIZE: number = 16;
+  private static readonly IV_SIZE: number = 12;
+  private readonly _salt: Uint8Array;
+  private readonly _iv: Uint8Array;
+  private readonly _data: Uint8Array;
+
+  constructor(salt: Uint8Array, iv: Uint8Array, data: Uint8Array) {
+    super(true);
+    this._salt = salt;
+    this._iv = iv;
+    this._data = data;
+  }
+
+  async decryptWithPassword(password: string): Promise<StratumImporterJsonState> {
+    const params = this.getKeyDerivationParams(password);
+    const key = await Argon2Task.doInBackground(params);
+    return this.decryptWithKey(key);
+  }
+
+  decryptWithKey(key: SecretKey): StratumImporterJsonState {
+    try {
+      // AES/GCM/NoPadding, the tag is appended to the ciphertext
+      const decrypted = CryptoUtils.decryptGcmWithAppendedTag(key.getEncoded(), this._iv, this._data);
+      return new StratumImporterJsonState(new JSONObject(Bytes.toUtf8(decrypted)));
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  decrypt(uiContext: UIContext, listener: DecryptListener): void {
+    Dialogs.showPasswordInputDialog(uiContext, (password: string) => {
+      const params = this.getKeyDerivationParams(password);
+      const task = new Argon2Task(uiContext, (key: SecretKey) => {
+        try {
+          const state = this.decryptWithKey(key);
+          listener.onStateDecrypted(state);
+        }
+        catch (e) {
+          listener.onError(e as Error);
+        }
+      }, (e: Error) => listener.onError(e));
+      task.execute(params);
+    }, () => listener.onCanceled(), undefined, $r('app.string.enter_password_aegis_title'));
+  }
+
+  private getKeyDerivationParams(password: string): Argon2TaskParams {
+    const argon2Params = new Argon2ParametersBuilder(Argon2Parameters.ARGON2_id)
+      .withIterations(StratumImporterEncryptedState.ITERATIONS)
+      .withParallelism(StratumImporterEncryptedState.PARALLELISM)
+      .withMemoryPowOfTwo(StratumImporterEncryptedState.MEMORY_COST)
+      .withSalt(this._salt)
+      .build();
+    return new Argon2TaskParams(password, argon2Params, StratumImporterEncryptedState.KEY_SIZE);
+  }
+
+  static parseHeader(stream: DataInputStream): StratumImporterEncryptedState {
+    const salt = new Uint8Array(StratumImporterEncryptedState.SALT_SIZE);
+    stream.readFully(salt);
+    const iv = new Uint8Array(StratumImporterEncryptedState.IV_SIZE);
+    stream.readFully(iv);
+    return new StratumImporterEncryptedState(salt, iv, stream.readAll());
+  }
+}
+
+export class StratumImporterLegacyEncryptedState extends DatabaseImporterState {
+  private static readonly ITERATIONS: number = 64000;
+  private static readonly KEY_SIZE: number = 32 * 8;
+  private static readonly SALT_SIZE: number = 20;
+  private static readonly BLOCK_SIZE: number = 16;
+  private readonly _salt: Uint8Array;
+  private readonly _iv: Uint8Array;
+  private readonly _data: Uint8Array;
+
+  constructor(salt: Uint8Array, iv: Uint8Array, data: Uint8Array) {
+    super(true);
+    this._salt = salt;
+    this._iv = iv;
+    this._data = data;
+  }
+
+  async decryptWithPassword(password: string): Promise<StratumImporterJsonState> {
+    const params = this.getKeyDerivationParams(password);
+    const key = await PBKDFTask.deriveKey(params);
+    return this.decryptWithKey(key);
+  }
+
+  decryptWithKey(key: SecretKey): StratumImporterJsonState {
+    try {
+      // AES/CBC/PKCS5Padding
+      const decrypted = CryptoUtils.aes(false, 'CBC', 'PKCS7', key.getEncoded(), this._iv, this._data);
+      return new StratumImporterJsonState(new JSONObject(Bytes.toUtf8(decrypted)));
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  decrypt(uiContext: UIContext, listener: DecryptListener): void {
+    Dialogs.showPasswordInputDialog(uiContext, (password: string) => {
+      const params = this.getKeyDerivationParams(password);
+      const task = new PBKDFTask(uiContext, (key: SecretKey) => {
+        try {
+          const state = this.decryptWithKey(key);
+          listener.onStateDecrypted(state);
+        }
+        catch (e) {
+          listener.onError(e as Error);
+        }
+      }, (e: Error) => listener.onError(e));
+      task.execute(params);
+    }, () => listener.onCanceled(), undefined, $r('app.string.enter_password_aegis_title'));
+  }
+
+  private getKeyDerivationParams(password: string): PBKDFTaskParams {
+    return new PBKDFTaskParams('PBKDF2WithHmacSHA1', StratumImporterLegacyEncryptedState.KEY_SIZE, password, this._salt, StratumImporterLegacyEncryptedState.ITERATIONS);
+  }
+
+  static parseHeader(stream: DataInputStream): StratumImporterLegacyEncryptedState {
+    const salt = new Uint8Array(StratumImporterLegacyEncryptedState.SALT_SIZE);
+    stream.readFully(salt);
+    const iv = new Uint8Array(StratumImporterLegacyEncryptedState.BLOCK_SIZE);
+    stream.readFully(iv);
+    return new StratumImporterLegacyEncryptedState(salt, iv, stream.readAll());
+  }
+}
+
+export class StratumImporterJsonState extends DatabaseImporterState {
+  private readonly _obj: JSONObject;
+
+  constructor(obj: JSONObject) {
+    super(false);
+    this._obj = obj;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const res = new DatabaseImporterResult();
+    try {
+      const array = this._obj.getJSONArray('Authenticators');
+      for (let i = 0; i < array.length(); i++) {
+        const obj = array.getJSONObject(i);
+        try {
+          res.addEntry(StratumImporterJsonState.convertEntry(obj));
+        }
+        catch (e) {
+          res.addError(e as DatabaseImporterEntryException);
+        }
+      }
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    return res;
+  }
+
+  private static convertEntry(obj: JSONObject): VaultEntry {
+    try {
+      const type = obj.getInt('Type');
+      const issuer = obj.getString('Issuer');
+      const nullableUsername = obj.get('Username');
+      const username = nullableUsername === JSONObject.NULL ? '' : String(nullableUsername);
+      const secret = Base32.decode(obj.getString('Secret'));
+      const algo = algorithmName(obj.getInt('Algorithm'));
+      const digits = obj.getInt('Digits');
+      const period = obj.getInt('Period');
+      const counter = obj.getInt('Counter');
+      const info = StratumImporter.parseOtpInfo(type, secret, algo, digits, period, counter);
+      return new VaultEntry(info, username, issuer);
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, null);
+    }
+  }
+}
+
+export class StratumImporterSqlState extends DatabaseImporterState {
+  private readonly _entries: StratumImporterSqlEntry[];
+
+  constructor(entries: StratumImporterSqlEntry[]) {
+    super(false);
+    this._entries = entries;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const res = new DatabaseImporterResult();
+    for (const entry of this._entries) {
+      try {
+        res.addEntry(entry.convert());
+      }
+      catch (e) {
+        res.addError(e as DatabaseImporterEntryException);
+      }
+    }
+    return res;
+  }
+}
+
+export class StratumImporterSqlEntry extends SqlImporterHelperEntry {
+  private readonly _type: number;
+  private readonly _issuer: string;
+  private readonly _username: string;
+  private readonly _secret: string;
+  private readonly _algo: number;
+  private readonly _digits: number;
+  private readonly _period: number;
+  private readonly _counter: number;
+
+  constructor(cursor: SqlImporterHelperCursor) {
+    super(cursor);
+    this._type = SqlImporterHelper.getInt(cursor, 'type');
+    this._issuer = SqlImporterHelper.getStringOrDefault(cursor, 'issuer', '');
+    this._username = SqlImporterHelper.getStringOrDefault(cursor, 'username', '');
+    this._secret = SqlImporterHelper.getStringOrDefault(cursor, 'secret', '');
+    this._algo = SqlImporterHelper.getInt(cursor, 'algorithm');
+    this._digits = SqlImporterHelper.getInt(cursor, 'digits');
+    this._period = SqlImporterHelper.getInt(cursor, 'period');
+    this._counter = SqlImporterHelper.getInt(cursor, 'counter');
+  }
+
+  convert(): VaultEntry {
+    try {
+      const secret = Base32.decode(this._secret);
+      const info = StratumImporter.parseOtpInfo(this._type, secret, algorithmName(this._algo), this._digits, this._period, this._counter);
+      return new VaultEntry(info, this._username, this._issuer);
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, null);
+    }
+  }
+}
