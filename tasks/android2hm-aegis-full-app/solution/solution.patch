@@ -0,0 +1,37 @@
+import { window } from '@kit.ArkUI';
+import { AegisModule } from '../AegisModule';
+
+/**
+ * Port of ViewHelper.
+ */
+export class ViewHelper {
+  private constructor() {
+  }
+
+  /**
+   * Returns the padding (in vp) the app bar needs at the top/left/right so that it isn't drawn
+   * below the system bars or the display cutout. This is only non-zero if the window is laid out
+   * in full screen (immersive) mode.
+   */
+  static async setupAppBarInsets(uiContext: UIContext): Promise<Padding> {
+    const padding: Padding = { top: 0, left: 0, right: 0, bottom: 0 };
+    try {
+      const win = await window.getLastWindow(AegisModule.getAbilityContext());
+      const props = win.getWindowProperties();
+      if (!props.isLayoutFullScreen) {
+        return padding;
+      }
+      const systemArea = win.getWindowAvoidArea(window.AvoidAreaType.TYPE_SYSTEM);
+      const cutoutArea = win.getWindowAvoidArea(window.AvoidAreaType.TYPE_CUTOUT);
+      const top = Math.max(systemArea.topRect.height, cutoutArea.topRect.height);
+      const left = Math.max(systemArea.leftRect.width, cutoutArea.leftRect.width);
+      const right = Math.max(systemArea.rightRect.width, cutoutArea.rightRect.width);
+      padding.top = uiContext.px2vp(top);
+      padding.left = uiContext.px2vp(left);
+      padding.right = uiContext.px2vp(right);
+    } catch (e) {
+      // keep the default padding
+    }
+    return padding;
+  }
+}
