+/**
+ * Port of SimpleItemTouchHelperCallback: keeps track of whether long press drag is enabled and
+ * which entry may be dragged. The drag itself is handled by the List component of EntryListView.
+ */
+export class SimpleItemTouchHelperCallback {
+  private _selectedEntry: VaultEntry | null = null;
+  private _isLongPressDragEnabled: boolean = true;
+  private _dragFlags: number = 0;
+
+  isLongPressDragEnabled(): boolean {
+    return this._isLongPressDragEnabled;
+  }
+
+  setIsLongPressDragEnabled(enabled: boolean): void {
+    this._isLongPressDragEnabled = enabled;
+  }
+
+  setSelectedEntry(entry: VaultEntry | null): void {
+    this._selectedEntry = entry;
+  }
+
+  getSelectedEntry(): VaultEntry | null {
+    return this._selectedEntry;
+  }
+
+  setDragFlags(dragFlags: number): void {
+    this._dragFlags = dragFlags;
+  }
+
+  getDragFlags(): number {
+    return this._dragFlags;
+  }
+
+  canDrag(entry: VaultEntry): boolean {
+    return this._isLongPressDragEnabled && this._selectedEntry !== null && this._selectedEntry.getUUID() === entry.getUUID();
+  }
+}
