@@ -0,0 +1,18 @@
+import { Slot } from './Slot';
+import { RawSlot } from './RawSlot';
+import { CryptParameters } from '../../crypto/CryptParameters';
+import { JSONObject } from '../../util/JSONObject';
+
+export class BiometricSlot extends RawSlot {
+  constructor(uuid?: string, key?: Uint8Array, keyParams?: CryptParameters) {
+    super(uuid, key, keyParams);
+  }
+
+  getType(): number {
+    return Slot.TYPE_BIOMETRIC;
+  }
+}
+
+Slot.registerFactory(Slot.TYPE_BIOMETRIC, (uuid: string, key: Uint8Array, keyParams: CryptParameters, obj: JSONObject): Slot => {
+  return new BiometricSlot(uuid, key, keyParams);
+});
diff --git a/entry/src/main/ets/vault/slots/PasswordSlot.ets b/entry/src/main/ets/vault/slots/PasswordSlot.ets
new file mode 100644
index 0000000..4648b88
--- /dev/null
+++ b/entry/src/main/ets/vault/slots/PasswordSlot.ets
@@ -0,0 +1,91 @@
+import { Slot } from './Slot';
+import { RawSlot } from './RawSlot';
+import { CryptParameters } from '../../crypto/CryptParameters';
+import { SCryptParameters } from '../../crypto/SCryptParameters';
+import { CryptoUtils, SecretKey } from '../../crypto/CryptoUtils';
+import { Cipher } from '../../crypto/Cipher';
+import { MasterKey } from '../../crypto/MasterKey';
+import { Hex } from '../../encoding/Hex';
+import { JSONObject } from '../../util/JSONObject';
+
+export class PasswordSlot extends RawSlot {
+  private _repaired: boolean = false;
+  private _isBackup: boolean = false;
+  private _params: SCryptParameters | null = null;
+
+  constructor(uuid?: string, key?: Uint8Array, keyParams?: CryptParameters, scryptParams?: SCryptParameters,
+    repaired?: boolean, isBackup?: boolean) {
+    super(uuid, key, keyParams);
+    this._params = scryptParams !== undefined ? scryptParams : null;
+    this._repaired = repaired === true;
+    this._isBackup = isBackup === true;
+  }
+
+  toJson(): JSONObject {
+    const obj = super.toJson();
+    const params = this._params as SCryptParameters;
+    obj.put('n', params.getN());
+    obj.put('r', params.getR());
+    obj.put('p', params.getP());
+    obj.put('salt', Hex.encode(params.getSalt()));
+    obj.put('repaired', this._repaired);
+    obj.put('is_backup', this._isBackup);
+    return obj;
+  }
+
+  /**
+   * Derives a key from the given password with new scrypt parameters and remembers the parameters.
+   */
+  async deriveKeyWithParams(password: string, params: SCryptParameters): Promise<SecretKey> {
+    const key = await CryptoUtils.deriveKeyFromPassword(password, params);
+    this._params = params;
+    return key;
+  }
+
+  async deriveKey(password: string): Promise<SecretKey> {
+    return CryptoUtils.deriveKeyFromPassword(password, this._params as SCryptParameters);
+  }
+
+  async deriveKeyFromBytes(data: Uint8Array): Promise<SecretKey> {
+    return CryptoUtils.deriveKey(data, this._params as SCryptParameters);
+  }
+
+  async setKey(masterKey: MasterKey, cipher: Cipher): Promise<void> {
+    await super.setKey(masterKey, cipher);
+    this._repaired = true;
+  }
+
+  /**
+   * Reports whether this slot was repaired and is no longer affected by issue #95.
+   */
+  isRepaired(): boolean {
+    return this._repaired;
+  }
+
+  /**
+   * Reports whether this slot is a backup password slot.
+   */
+  isBackup(): boolean {
+    return this._isBackup;
+  }
+
+  setIsBackup(isBackup: boolean): void {
+    this._isBackup = isBackup;
+  }
+
+  getType(): number {
+    return Slot.TYPE_PASSWORD;
+  }
+}
+
+Slot.registerFactory(Slot.TYPE_PASSWORD, (uuid: string, key: Uint8Array, keyParams: CryptParameters, obj: JSONObject): Slot => {
+  const scryptParams = new SCryptParameters(
+    obj.getInt('n'),
+    obj.getInt('r'),
+    obj.getInt('p'),
+    Hex.decode(obj.getString('salt'))
+  );
+  const repaired = obj.optBoolean('repaired', false);
+  const isBackup = obj.optBoolean('is_backup', false);
+  return new PasswordSlot(uuid, key, keyParams, scryptParams, repaired, isBackup);
+});
