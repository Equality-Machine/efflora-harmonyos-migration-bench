+
+  private handleIncomingIntent(): void {
+    if (!this._activity.getVaultManager().isVaultLoaded()) {
+      return;
+    }
+
+    const intent = IncomingIntent.getPending();
+    if (intent === null || intent.action === null) {
+      return;
+    }
+
+    switch (intent.action) {
+      case ACTION_VIEW: {
+        const uri = intent.data;
+        intent.data = null;
+        intent.action = null;
+        if (uri !== null) {
+          let info: GoogleAuthInfo;
+          try {
+            info = GoogleAuthInfo.parseUri(uri);
+          } catch (e) {
+            Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.unable_to_process_deeplink'), e as Error);
+            break;
+          }
+          this.startEditEntryActivityForNew(VaultEntry.fromGoogleAuthInfo(info));
+        }
+        break;
+      }
+      case ACTION_SEND:
+      case ACTION_SEND_MULTIPLE: {
+        const streams = intent.streams;
+        const text = intent.text;
+        intent.action = null;
+        intent.streams = [];
+        intent.text = null;
+        if (streams.length > 0) {
+          this.startDecodeQrCodeImages(streams);
+        }
+        if (text !== null) {
+          let info: GoogleAuthInfo;
+          try {
+            info = GoogleAuthInfo.parseUri(text);
+          } catch (e) {
+            Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.unable_to_process_shared_text'), e as Error);
+            break;
+          }
+          this.startEditEntryActivityForNew(VaultEntry.fromGoogleAuthInfo(info));
+        }
+        break;
+      }
+      default:
+        break;
+    }
+  }
