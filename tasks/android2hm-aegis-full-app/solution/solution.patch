diff --git a/entry/src/main/ets/ui/intro/IntroBaseActivity.ets b/entry/src/main/ets/ui/intro/IntroBaseActivity.ets
new file mode 100644
index 0000000..b8d1893
--- /dev/null
+++ b/entry/src/main/ets/ui/intro/IntroBaseActivity.ets
@@ -0,0 +1,124 @@
+import { IntroActivityInterface } from './IntroActivityInterface';
+import { IntroState } from './IntroState';
+import { SlideFragment } from './SlideFragment';
+
+/**
+ * Port of IntroBaseActivity: manages the list of slides and the navigation between them.
+ */
+export abstract class IntroBaseActivity implements IntroActivityInterface {
+  private _state: IntroState = new IntroState();
+  private _slides: SlideFragment[] = [];
+  private _position: number = 0;
+  private _uiContext: UIContext;
+  private _onChange: ((position: number) => void) | null = null;
+
+  constructor(uiContext: UIContext) {
+    this._uiContext = uiContext;
+  }
+
+  setOnPositionChangedListener(listener: (position: number) => void): void {
+    this._onChange = listener;
+  }
+
+  getSlides(): SlideFragment[] {
+    return this._slides;
+  }
+
+  getSlide(type: string): SlideFragment | null {
+    const slide = this._slides.find((s: SlideFragment) => s.getType() === type);
+    return slide !== undefined ? slide : null;
+  }
+
+  getCurrentItem(): number {
+    return this._position;
+  }
+
+  private getCurrentSlide(): SlideFragment {
+    return this._slides[this._position];
+  }
+
+  goToNextSlide(): void {
+    const pos = this._position;
+    if (pos !== this._slides.length - 1) {
+      const currentSlide = this.getCurrentSlide();
+      if (currentSlide.isFinished()) {
+        currentSlide.onSaveIntroState(this._state);
+        this.setPagerPositionDelta(pos, 1);
+      } else {
+        currentSlide.onNotFinishedError();
+      }
+    } else {
+      this.onDonePressed();
+    }
+  }
+
+  goToPreviousSlide(): void {
+    const pos = this._position;
+    if (pos !== 0 && pos !== this._slides.length - 1) {
+      this.setPagerPositionDelta(pos, -1);
+    }
+  }
+
+  skipToSlide(type: string): void {
+    const i = this._slides.findIndex((s: SlideFragment) => s.getType() === type);
+    if (i === -1) {
+      throw new Error(`Cannot skip to slide of type ${type} because it is not in the slide list`);
+    }
+    this.setPagerPosition(i);
+  }
+
+  protected onBeforeSlideChanged(oldSlide: string | null, newSlide: string): boolean {
+    return false;
+  }
+
+  protected onAfterSlideChanged(oldSlide: string | null, newSlide: string): void {
+  }
+
+  private setPagerPosition(pos: number): void {
+    const oldSlide = this.getCurrentSlide().getType();
+    const newSlide = this._slides[pos].getType();
+    if (!this.onBeforeSlideChanged(oldSlide, newSlide)) {
+      this._position = pos;
+      this._slides[pos].onResume();
+    }
+    this.onAfterSlideChanged(oldSlide, newSlide);
+    this.updatePagerControls();
+  }
+
+  private setPagerPositionDelta(pos: number, delta: number): void {
+    this.setPagerPosition(pos + delta);
+  }
+
+  private updatePagerControls(): void {
+    if (this._onChange !== null) {
+      this._onChange(this._position);
+    }
+  }
+
+  isPreviousVisible(): boolean {
+    return this._position !== 0 && this._position !== this._slides.length - 1;
+  }
+
+  isLastSlide(): boolean {
+    return this._position === this._slides.length - 1;
+  }
+
+  getState(): IntroState {
+    return this._state;
+  }
+
+  protected abstract onDonePressed(): void;
+
+  addSlide(slide: SlideFragment): void {
+    if (this._slides.some((s: SlideFragment) => s.getType() === slide.getType())) {
+      throw new Error(`Only one slide of type ${slide.getType()} may be added to the intro`);
+    }
+    slide.onAttach(this, this._uiContext);
+    this._slides.push(slide);
+    if (this._slides.length === 1) {
+      const type = this._slides[0].getType();
+      this.onBeforeSlideChanged(null, type);
+      this.onAfterSlideChanged(null, type);
+    }
+  }
+}
