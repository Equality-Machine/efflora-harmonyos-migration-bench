index 0000000..ccc68ec
--- /dev/null
+++ b/entry/src/main/ets/ui/preferences/SwitchPreference.ets
@@ -0,0 +1,31 @@
+import { OnPreferenceChangeListener, PreferenceAttrs, SwitchPreferenceCompat } from './Preference';
+
+/**
+ * Port of SwitchPreference: a SwitchPreferenceCompat that can be (un)checked silently, without
+ * triggering its change listener.
+ */
+export class SwitchPreference extends SwitchPreferenceCompat {
+  private _listener: OnPreferenceChangeListener | null = null;
+
+  constructor(attrs: PreferenceAttrs) {
+    super(attrs);
+  }
+
+  setOnPreferenceChangeListener(listener: OnPreferenceChangeListener | null): void {
+    super.setOnPreferenceChangeListener(listener);
+    this._listener = listener;
+  }
+
+  /**
+   * Sets the checked state. If silent is true, the change listener is not notified.
+   */
+  setChecked(checked: boolean, silent?: boolean): void {
+    if (silent === true) {
+      super.setOnPreferenceChangeListener(null);
+    }
+    super.setChecked(checked);
+    if (silent === true) {
+      super.setOnPreferenceChangeListener(this._listener);
+    }
+  }
+}
