+import { SlideFragment } from '../intro/SlideFragment';
+import { IntroState } from '../intro/IntroState';
+import { BiometricsHelper } from '../../helpers/BiometricsHelper';
+
+export class SecurityPickerSlide extends SlideFragment {
+  static readonly TYPE: string = 'SecurityPickerSlide';
+
+  static readonly CRYPT_TYPE_INVALID: number = 0;
+  static readonly CRYPT_TYPE_NONE: number = 1;
+  static readonly CRYPT_TYPE_PASS: number = 2;
+  static readonly CRYPT_TYPE_BIOMETRIC: number = 3;
+
+  private _checked: number = SecurityPickerSlide.CRYPT_TYPE_INVALID;
+  private _canUseBio: boolean = false;
+  private _listener: (() => void) | null = null;
+
+  constructor() {
+    super();
+    this.updateBiometricsOption(true);
+  }
+
+  getType(): string {
+    return SecurityPickerSlide.TYPE;
+  }
+
+  setOnChangeListener(listener: () => void): void {
+    this._listener = listener;
+  }
+
+  onResume(): void {
+    this.updateBiometricsOption(false);
+  }
+
+  private updateBiometricsOption(autoSelect: boolean): void {
+    this._canUseBio = BiometricsHelper.isAvailable();
+    if (!this._canUseBio && this._checked === SecurityPickerSlide.CRYPT_TYPE_BIOMETRIC) {
+      this._checked = SecurityPickerSlide.CRYPT_TYPE_PASS;
+    }
+    if (this._canUseBio && autoSelect) {
+      this._checked = SecurityPickerSlide.CRYPT_TYPE_BIOMETRIC;
+    }
+    if (this._listener !== null) {
+      this._listener();
+    }
+  }
+
+  canUseBio(): boolean {
+    return this._canUseBio;
+  }
+
+  getChecked(): number {
+    return this._checked;
+  }
+
+  check(type: number): void {
+    this._checked = type;
+    if (this._listener !== null) {
+      this._listener();
+    }
+  }
+
+  isFinished(): boolean {
+    return this._checked !== SecurityPickerSlide.CRYPT_TYPE_INVALID;
+  }
+
+  onNotFinishedError(): void {
+    this.requireUIContext().getPromptAction().showToast({ message: $r('app.string.snackbar_authentication_method') });
+  }
+
+  onSaveIntroState(introState: IntroState): void {
+    introState.cryptType = this._checked;
+  }
+}
+
+@Component
+export struct SecurityPickerSlideView {
+  slide: SecurityPickerSlide | null = null;
+  @State checked: number = SecurityPickerSlide.CRYPT_TYPE_INVALID;
+  @State canUseBio: boolean = false;
+
+  aboutToAppear(): void {
+    const slide = this.slide as SecurityPickerSlide;
+    slide.setOnChangeListener(() => {
+      this.checked = slide.getChecked();
+      this.canUseBio = slide.canUseBio();
+    });
+    this.checked = slide.getChecked();
+    this.canUseBio = slide.canUseBio();
+  }
+
+  @Builder
+  Option(type: number, title: Resource, description: Resource, enabled: boolean) {
+    Row() {
+      Radio({ value: `${type}`, group: 'authenticationMethod' })
+        .checked(this.checked === type)
+        .enabled(enabled)
+        .onChange((v: boolean) => {
+          if (v && this.slide !== null) {
+            this.slide.check(type);
+          }
+        })
+      Column() {
+        Text(title)
+          .fontSize(16)
+          .fontColor($r('app.color.theme_onSurface'))
+        Text(description)
+          .fontSize(13)
+          .fontColor($r('app.color.theme_onSurfaceVariant'))
+      }
+      .alignItems(HorizontalAlign.Start)
+      .layoutWeight(1)
+      .margin({ left: 8 })
+    }
+    .width('100%')
+    .padding({ top: 12, bottom: 12 })
+    .opacity(enabled ? 1 : 0.4)
+    .onClick(() => {
+      if (enabled && this.slide !== null) {
+        this.slide.check(type);
+      }
+    })
+  }
+
+  build() {
+    Column() {
+      Text($r('app.string.choose_authentication_method'))
+        .fontSize(24)
+        .fontColor($r('app.color.theme_onSurface'))
+        .width('100%')
+      Text($r('app.string.authentication_method_explanation'))
+        .fontSize(14)
+        .fontColor($r('app.color.theme_onSurfaceVariant'))
+        .width('100%')
+        .margin({ top: 12, bottom: 16 })
+      this.Option(SecurityPickerSlide.CRYPT_TYPE_NONE, $r('app.string.authentication_method_none'),
+        $r('app.string.authentication_method_none_description'), true)
+      this.Option(SecurityPickerSlide.CRYPT_TYPE_PASS, $r('app.string.authentication_method_password'),
+        $r('app.string.authentication_method_password_description'), true)
+      this.Option(SecurityPickerSlide.CRYPT_TYPE_BIOMETRIC, $r('app.string.authentication_method_biometrics'),
+        $r('app.string.authentication_method_biometrics_description'), this.canUseBio)
+    }
+    .width('100%')
+    .height('100%')
+    .padding(24)
+  }
+}
