+import { Bytes } from './Bytes';
+
+export class XmlPullParserException extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'XmlPullParserException';
+  }
+}
+
+export class XmlAttribute {
+  readonly name: string;
+  readonly value: string;
+
+  constructor(name: string, value: string) {
+    this.name = name;
+    this.value = value;
+  }
+}
+
+/**
+ * A small non-validating XML pull parser with the same semantics as the parts of
+ * org.xmlpull.v1.XmlPullParser (android.util.Xml.newPullParser() without namespace processing)
+ * that are used by the importers: next(), nextTag(), require(), getName(), getText(),
+ * getAttributeValue() and getEventType().
+ *
