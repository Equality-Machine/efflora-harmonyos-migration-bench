+++ b/entry/src/main/ets/importers/TotpAuthenticatorImporter.ets
@@ -0,0 +1,176 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState, DecryptListener } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { CryptoUtils } from '../crypto/CryptoUtils';
+import { Base32 } from '../encoding/Base32';
+import { Base64 } from '../encoding/Base64';
+import { Hex } from '../encoding/Hex';
+import { TotpInfo } from '../otp/TotpInfo';
+import { Dialogs } from '../ui/dialogs/Dialogs';
+import { JSONArray, JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+import { PreferenceParser } from '../util/PreferenceParser';
+import { VaultEntry } from '../vault/VaultEntry';
+
+const _subPath: string = 'shared_prefs/TOTP_Authenticator_Preferences.xml';
+
+const _pkgName: string = 'com.authenticator.authservice2';
+
+// WARNING: DON'T DO THIS IN YOUR OWN CODE
+// this is a hardcoded password and nonce, used solely to decrypt TOTP Authenticator backups
+const PASSWORD: string = 'TotpAuthenticator';
+
+const IV: Uint8Array = new Uint8Array(16);
+
+const PREF_KEY: string = 'STATIC_TOTP_CODES_LIST';
+
+export class TotpAuthenticatorImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    return this.getAppPathForPackage(_pkgName, _subPath);
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    try {
+      if (isInternal) {
+        let data: string | null = null;
+        for (const entry of PreferenceParser.parseBytes(stream)) {
+          if (entry.Name === PREF_KEY) {
+            data = entry.Value;
+          }
+        }
+        if (data === null) {
+          throw new DatabaseImporterException(`Key ${PREF_KEY} not found in shared preference file`);
+        }
+        const entries = TotpAuthenticatorImporter.parse(data);
+        return new TotpAuthenticatorImporterDecryptedState(entries);
+      }
+      else {
+        const cipherText = Base64.decodeBytes(stream);
+        return new TotpAuthenticatorImporterEncryptedState(cipherText);
+      }
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterException) {
+        throw e as DatabaseImporterException;
+      }
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  static parse(data: string): JSONObject[] {
+    const array = new JSONArray(data);
+    const entries: JSONObject[] = [];
+    for (let i = 0; i < array.length(); ++i) {
+      const obj = array.getJSONObject(i);
+      entries.push(obj);
+    }
+    return entries;
+  }
+}
+
+export class TotpAuthenticatorImporterEncryptedState extends DatabaseImporterState {
+  private _data: Uint8Array;
+
+  constructor(data: Uint8Array) {
+    super(true);
+    this._data = data;
+  }
+
+  decryptWithPassword(password: string): TotpAuthenticatorImporterDecryptedState {
+    try {
+      // WARNING: DON'T DO THIS IN YOUR OWN CODE
+      // this is not a secure way to derive a key from a password
+      const keyBytes = CryptoUtils.digest('SHA256', CryptoUtils.toBytes(password));
+      const bytes = CryptoUtils.aes(false, 'CBC', 'PKCS7', keyBytes, IV, this._data);
+      const obj = new JSONObject(Bytes.toUtf8(bytes));
+      const keys = obj.keys();
+      let entries: JSONObject[] = [];
+      if (keys.length > 0) {
+        entries = TotpAuthenticatorImporter.parse(keys[0]);
+      }
+      return new TotpAuthenticatorImporterDecryptedState(entries);
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  decrypt(uiContext: UIContext, listener: DecryptListener): void {
+    Dialogs.showSimpleDialog(uiContext, '', $r('app.string.choose_totpauth_importer'), $r('app.string.yes'), () => {
+      Dialogs.showPasswordInputDialog(uiContext, (password: string) => {
+        this.decryptAndNotify(password, listener);
+      }, () => listener.onCanceled());
+    }, $r('app.string.no'), () => {
+      this.decryptAndNotify(PASSWORD, listener);
+    });
+  }
+
+  private decryptAndNotify(password: string, listener: DecryptListener): void {
+    try {
+      const state = this.decryptWithPassword(password);
+      listener.onStateDecrypted(state);
+    }
+    catch (e) {
+      listener.onError(e as Error);
+    }
+  }
+}
+
+export class TotpAuthenticatorImporterDecryptedState extends DatabaseImporterState {
+  private _objs: JSONObject[];
+
+  constructor(objs: JSONObject[]) {
+    super(false);
+    this._objs = objs;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    for (const obj of this._objs) {
+      try {
+        const entry = TotpAuthenticatorImporterDecryptedState.convertEntry(obj);
+        result.addEntry(entry);
+      }
+      catch (e) {
+        result.addError(e as DatabaseImporterEntryException);
+      }
+    }
+    return result;
+  }
+
+  private static convertEntry(obj: JSONObject): VaultEntry {
+    try {
+      const base = obj.getInt('base');
+      const secretString = obj.getString('key');
+      let secret: Uint8Array;
+      switch (base) {
+        case 16:
+          secret = Hex.decode(secretString);
+          break;
+        case 32:
+          secret = Base32.decode(secretString);
+          break;
+        case 64:
+          secret = Base64.decode(secretString);
+          break;
+        default:
+          throw new DatabaseImporterEntryException(`Unsupported secret encoding: base ${base}`, obj.toString());
+      }
+      const info = new TotpInfo(secret);
+      const name = obj.optString('name');
+      const issuer = obj.optString('issuer');
+      return new VaultEntry(info, name, issuer);
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterEntryException) {
+        throw e as DatabaseImporterEntryException;
+      }
+      throw new DatabaseImporterEntryException((e as Error).message, obj.toString());
+    }
+  }
+}
