+  private static buildImportError(fileName: string, e: Error | string): string {
+    const msg = typeof e === 'string' ? e as string : `${(e as Error).name}: ${(e as Error).message}`;
+    return `${fileName}:\n${msg}`;
+  }
+
+  private startDecodeQrCodeImages(uris: string[]): void {
+    const task = new QrDecodeTask(this.getUIContext(), (results: QrDecodeTaskResult[]) => {
+      const errors: string[] = [];
+      const entries: VaultEntry[] = [];
+      const googleAuthExports: GoogleAuthInfoExport[] = [];
+
+      for (const res of results) {
+        const ex = res.getException();
+        if (ex !== null) {
+          errors.push(MainActivity.buildImportError(res.getFileName(), ex));
+          continue;
+        }
+
+        try {
+          const text = res.getResult() as string;
+          const scanned = Uri.parse(text);
+          if (scanned.getScheme() === GoogleAuthInfo.SCHEME_EXPORT) {
+            const exp = GoogleAuthInfo.parseExportUriObj(scanned);
+            for (const info of exp.getEntries()) {
+              entries.push(VaultEntry.fromGoogleAuthInfo(info));
+            }
+            googleAuthExports.push(exp);
+          } else {
+            const info = GoogleAuthInfo.parseUri(text);
+            entries.push(VaultEntry.fromGoogleAuthInfo(info));
+          }
+        } catch (e) {
+          errors.push(MainActivity.buildImportError(res.getFileName(), e as Error));
+        }
+      }
+
+      const dialogDismissHandler = () => this.importScannedEntries(entries);
+      if (googleAuthExports.length > 0) {
+        const isSingleBatch = GoogleAuthInfoExport.isSingleBatch(googleAuthExports);
+        if (!isSingleBatch && errors.length > 0) {
+          errors.push(this._activity.getString('unrelated_google_auth_batches_error'));
+          Dialogs.showMultiErrorDialog(this.getUIContext(), $r('app.string.import_error_title'),
+            $r('app.string.no_tokens_can_be_imported'), errors, null);
+          return;
+        } else if (!isSingleBatch) {
+          Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.import_google_auth_failure'),
+            this._activity.getString('unrelated_google_auth_batches_error'));
+          return;
+        } else {
+          const missingIndices = GoogleAuthInfoExport.getMissingIndices(googleAuthExports);
+          if (missingIndices.length !== 0) {
+            Dialogs.showPartialGoogleAuthImportWarningDialog(this.getUIContext(), missingIndices, entries.length, errors,
+              dialogDismissHandler);
+            return;
+          }
+        }
+      }
+
+      if ((errors.length > 0 && results.length > 1) || errors.length > 1) {
+        Dialogs.showMultiErrorDialog(this.getUIContext(), $r('app.string.import_error_title'),
+          this._activity.getString('unable_to_read_qrcode_files', [uris.length - errors.length, uris.length]),
+          errors, dialogDismissHandler);
+      } else if (errors.length > 0) {
+        Dialogs.showErrorDialog(this.getUIContext(),
+          this._activity.getString('unable_to_read_qrcode_file', [results[0].getFileName()]), errors[0], dialogDismissHandler);
+      } else {
+        this.importScannedEntries(entries);
+      }
+    });
+    task.execute(uris);
+  }
+
+  private importScannedEntries(entries: VaultEntry[]): void {
+    if (entries.length === 1) {
+      this.startEditEntryActivityForNew(entries[0]);
+    } else if (entries.length > 1) {
+      for (const entry of entries) {
+        this._activity.getVaultManager().getVault().addEntry(entry);
+      }
+
+      if (this.saveAndBackupVault()) {
+        this._activity.showToast(this._activity.getQuantityString('added_new_entries', entries.length), true);
+      }
+
+      this._entryListView.setEntries(this._activity.getVaultManager().getVault().getEntries());
+      this.setGroups(this._activity.getVaultManager().getVault().getUsedGroups());
+    }
+  }
