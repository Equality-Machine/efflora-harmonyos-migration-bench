@@ -0,0 +1,59 @@
+import { IconPack } from '../../icons/IconPack';
+
+export interface IconPackAdapterListener {
+  onRemoveIconPack(pack: IconPack): void;
+}
+
+/**
+ * Port of IconPackAdapter: holds the list of icon packs shown by IconPacksManagerFragment, which
+ * renders an IconPackHolder per item.
+ */
+export class IconPackAdapter {
+  private _listener: IconPackAdapterListener;
+  private _iconPacks: IconPack[] = [];
+  private _onChanged: (() => void) | null = null;
+
+  constructor(listener: IconPackAdapterListener) {
+    this._listener = listener;
+  }
+
+  setOnDataSetChangedListener(listener: (() => void) | null): void {
+    this._onChanged = listener;
+  }
+
+  addIconPack(pack: IconPack): void {
+    this._iconPacks.push(pack);
+    this.notifyDataSetChanged();
+  }
+
+  removeIconPack(pack: IconPack): void {
+    const position = this._iconPacks.findIndex((p: IconPack) => p.equals(pack));
+    if (position >= 0) {
+      this._iconPacks.splice(position, 1);
+      this.notifyDataSetChanged();
+    }
+  }
+
+  getIconPacks(): IconPack[] {
+    return this._iconPacks;
+  }
+
+  /**
+   * Called when the delete button of the holder at the given position is pressed.
+   */
+  onDeleteClick(position: number): void {
+    if (position >= 0 && position < this._iconPacks.length) {
+      this._listener.onRemoveIconPack(this._iconPacks[position]);
+    }
+  }
+
+  getItemCount(): number {
+    return this._iconPacks.length;
+  }
+
+  private notifyDataSetChanged(): void {
+    if (this._onChanged !== null) {
+      this._onChanged();
+    }
+  }
+}
