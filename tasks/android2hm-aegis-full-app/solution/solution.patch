+      const intent = new Intent(PAGE_AUTH);
+      intent.putExtra('inhibitBioPrompt', inhibitBioPrompt);
+      ActivityManager.startActivityForResult(this.getUIContext(), intent, (result: ActivityResult) => {
+        this._isAuthenticating = false;
+        if (result.resultCode === RESULT_OK) {
+          this.onDecryptResult();
+        } else if (!this._activity.getVaultManager().isVaultLoaded()) {
