index 0000000..5f957fd
--- /dev/null
+++ b/entry/src/main/ets/util/zip/LocalFileHeader.ets
@@ -0,0 +1,45 @@
+
+
+/**
+ * Port of net.lingala.zip4j.model.LocalFileHeader (the parts needed for reading).
+ */
+export class LocalFileHeader {
+  fileName: string = '';
+  versionNeededToExtract: number = 0;
+  generalPurposeFlag: number = 0;
+  compressionMethod: number = 0;
+  lastModifiedTime: number = 0;
+  crc: number = 0;
+  compressedSize: number = 0;
+  uncompressedSize: number = 0;
+  localHeaderOffset: number = 0;
+
+  // AES extra data record (0x9901)
+  aesVersion: number = 0;
+  aesKeyStrength: number = 0;
+  aesCompressionMethod: number = 0;
+
+  getFileName(): string {
+    return this.fileName;
+  }
+
+  isEncrypted(): boolean {
+    return (this.generalPurposeFlag & 0x1) !== 0;
+  }
+
+  isDirectory(): boolean {
+    return this.fileName.endsWith('/');
+  }
+
+  isDataDescriptorExists(): boolean {
+    return (this.generalPurposeFlag & 0x8) !== 0;
+  }
+
+  isAesEncrypted(): boolean {
+    return this.compressionMethod === 99;
+  }
+
+  getCompressionMethod(): number {
+    return this.isAesEncrypted() ? this.aesCompressionMethod : this.compressionMethod;
+  }
+}
