+import { AssignIconEntry } from '../models/AssignIconEntry';
+
+/**
+ * Replacement for AssignIconAdapter.Listener.
+ */
+export class AssignIconAdapterListener {
+  private readonly _onClick: (entry: AssignIconEntry) => void;
+
+  constructor(onClick: (entry: AssignIconEntry) => void) {
+    this._onClick = onClick;
+  }
+
+  onAssignIconEntryClick(entry: AssignIconEntry): void {
+    this._onClick(entry);
+  }
+}
+
+/**
+ * Port of AssignIconAdapter: the data source of the list in AssignIconsActivity.
+ */
+export class AssignIconAdapter implements IDataSource {
+  private readonly _listener: AssignIconAdapterListener;
+  private readonly _entries: AssignIconEntry[];
+  private _observers: DataChangeListener[] = [];
+
+  constructor(listener: AssignIconAdapterListener) {
+    this._listener = listener;
+    this._entries = [];
+  }
+
+  addEntries(entries: AssignIconEntry[]): void {
+    for (const entry of entries) {
+      this._entries.push(entry);
+    }
+    for (const observer of this._observers) {
+      observer.onDataReloaded();
+    }
+  }
+
+  getListener(): AssignIconAdapterListener {
+    return this._listener;
+  }
+
+  /**
+   * Port of the click listener set in onBindViewHolder.
+   */
+  onBindViewHolder(position: number): void {
+    this._listener.onAssignIconEntryClick(this._entries[position]);
+  }
+
+  getItemCount(): number {
+    return this._entries.length;
+  }
+
+  totalCount(): number {
+    return this.getItemCount();
+  }
+
+  getData(index: number): AssignIconEntry {
+    return this._entries[index];
+  }
+
+  registerDataChangeListener(listener: DataChangeListener): void {
+    if (this._observers.indexOf(listener) < 0) {
+      this._observers.push(listener);
+    }
+  }
+
+  unregisterDataChangeListener(listener: DataChangeListener): void {
+    const idx = this._observers.indexOf(listener);
+    if (idx >= 0) {
+      this._observers.splice(idx, 1);
+    }
+  }
+}
diff --git a/entry/src/main/ets/ui/views/AssignIconHolder.ets b/entry/src/main/ets/ui/views/AssignIconHolder.ets
