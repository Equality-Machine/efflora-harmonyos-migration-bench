diff --git a/entry/src/main/ets/ui/views/IconRecyclerView.ets b/entry/src/main/ets/ui/views/IconRecyclerView.ets
new file mode 100644
index 0000000..da51f80
--- /dev/null
+++ b/entry/src/main/ets/ui/views/IconRecyclerView.ets
@@ -0,0 +1,179 @@
+import { IconPackIcon } from '../../icons/IconPack';
+import { IconAdapter, IconAdapterCategoryHeader, VIEW_TYPE_CATEGORY } from './IconAdapter';
+import { IconHolder } from './IconHolder';
+import { IconCategoryHolder } from './IconCategoryHolder';
+
+/**
+ * A row of the icon grid: either a category header or up to spanCount icons.
+ */
+export class IconRecyclerViewRow {
+  key: string;
+  category: IconAdapterCategoryHeader | null;
+  icons: IconPackIcon[];
+
+  constructor(key: string, category: IconAdapterCategoryHeader | null, icons: IconPackIcon[]) {
+    this.key = key;
+    this.category = category;
+    this.icons = icons;
+  }
+}
+
+class IconRowDataSource implements IDataSource {
+  private _rows: IconRecyclerViewRow[] = [];
+  private _listeners: DataChangeListener[] = [];
+
+  setRows(rows: IconRecyclerViewRow[]): void {
+    this._rows = rows;
+    for (const l of this._listeners) {
+      l.onDataReloaded();
+    }
+  }
+
+  totalCount(): number {
+    return this._rows.length;
+  }
+
+  getData(index: number): IconRecyclerViewRow {
+    return this._rows[index];
+  }
+
+  registerDataChangeListener(listener: DataChangeListener): void {
+    if (this._listeners.indexOf(listener) < 0) {
+      this._listeners.push(listener);
+    }
+  }
+
+  unregisterDataChangeListener(listener: DataChangeListener): void {
+    const idx = this._listeners.indexOf(listener);
+    if (idx >= 0) {
+      this._listeners.splice(idx, 1);
+    }
+  }
+}
+
+/**
+ * Port of IconRecyclerView: an auto-fit grid (span count = width / column width) that shows the
+ * items of an IconAdapter. Category headers span the full width.
+ */
+@Component
+export struct IconRecyclerView {
+  adapter: IconAdapter | null = null;
+  @Prop columnWidth: number = 75;
+  @State private _spanCount: number = 1;
+  @State private _cellWidth: number = 75;
+  private _dataSource: IconRowDataSource = new IconRowDataSource();
+  private _generation: number = 0;
+  private _scroller: Scroller = new Scroller();
+  private _observer: () => void = () => {
+    this.rebuild(true);
+  };
+
+  aboutToAppear(): void {
+    if (this.adapter !== null) {
+      this.adapter.registerObserver(this._observer);
+    }
+    this.rebuild(false);
+  }
+
+  aboutToDisappear(): void {
+    if (this.adapter !== null) {
+      this.adapter.unregisterObserver(this._observer);
+    }
+  }
+
+  getSpanCount(): number {
+    return this._spanCount;
+  }
+
+  private onMeasureWidth(width: number): void {
+    if (this.columnWidth > 0) {
+      const spanCount = Math.max(1, Math.floor(width / this.columnWidth));
+      this._cellWidth = Math.floor(width / spanCount);
+      if (spanCount !== this._spanCount) {
+        this._spanCount = spanCount;
+        this.rebuild(false);
+      }
+    }
+  }
+
+  private rebuild(dataChanged: boolean): void {
+    if (dataChanged) {
+      this._generation++;
+    }
+    const rows: IconRecyclerViewRow[] = [];
+    const adapter = this.adapter;
+    if (adapter !== null) {
+      let current: IconPackIcon[] = [];
+      const flush = () => {
+        if (current.length > 0) {
+          rows.push(new IconRecyclerViewRow(`${this._generation}:${this._spanCount}:i${rows.length}`, null, current));
+          current = [];
+        }
+      };
+      const count = adapter.getItemCount();
+      for (let i = 0; i < count; i++) {
+        if (adapter.getItemViewType(i) === VIEW_TYPE_CATEGORY) {
+          flush();
+          const category = adapter.getCategoryAt(i);
+          if (category !== null) {
+            rows.push(new IconRecyclerViewRow(`${this._generation}:${this._spanCount}:c${rows.length}`, category, []));
+          }
+        } else {
+          current.push(adapter.getIconAt(i));
+          if (current.length >= this._spanCount) {
+            flush();
+          }
+        }
+      }
+      flush();
+    }
+    this._dataSource.setRows(rows);
+  }
+
+  private onIconClick(icon: IconPackIcon): void {
+    if (this.adapter !== null) {
+      this.adapter.onIconClick(icon);
+    }
+  }
+
+  private onCategoryClick(category: IconAdapterCategoryHeader): void {
+    if (this.adapter !== null) {
+      this.adapter.onCategoryClick(category);
+    }
+  }
+
+  build() {
+    List({ scroller: this._scroller }) {
+      LazyForEach(this._dataSource, (row: IconRecyclerViewRow) => {
+        ListItem() {
+          if (row.category !== null) {
+            IconCategoryHolder({
+              header: row.category,
+              onCategoryClick: (header: IconAdapterCategoryHeader) => this.onCategoryClick(header)
+            })
+          } else {
+            Row() {
+              ForEach(row.icons, (icon: IconPackIcon) => {
+                IconHolder({
+                  icon: icon,
+                  columnWidth: this.columnWidth,
+                  cellWidth: this._cellWidth,
+                  onIconClick: (i: IconPackIcon) => this.onIconClick(i)
+                })
+              }, (icon: IconPackIcon, index: number) => `${index}:${icon.getRelativeFilename()}`)
+            }
+            .width('100%')
+            .alignItems(VerticalAlign.Top)
+          }
+        }
+      }, (row: IconRecyclerViewRow) => row.key)
+    }
+    .width('100%')
+    .height('100%')
+    .scrollBar(BarState.Auto)
+    .cachedCount(4)
+    .onAreaChange((oldValue: Area, newValue: Area) => {
+      this.onMeasureWidth(Number(newValue.width));
+    })
+  }
+}
