+    const entries = await helper.read<MicrosoftAuthImporterEntry>((cursor: SqlImporterHelperCursor) => new MicrosoftAuthImporterEntry(cursor), stream, 'accounts');
+    return new MicrosoftAuthImporterState(entries);
+  }
+
+  async readFromApp(): Promise<DatabaseImporterState> {
+    const path = this.getAppPath();
+    const helper = new SqlImporterHelper(this.requireContext());
+    const entries = await helper.readFromPath<MicrosoftAuthImporterEntry>((cursor: SqlImporterHelperCursor) => new MicrosoftAuthImporterEntry(cursor), path, 'accounts');
+    return new MicrosoftAuthImporterState(entries);
+  }
+}
+
+export class MicrosoftAuthImporterState extends DatabaseImporterState {
+  private _entries: MicrosoftAuthImporterEntry[];
+
+  constructor(entries: MicrosoftAuthImporterEntry[]) {
+    super(false);
+    this._entries = entries;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    for (const sqlEntry of this._entries) {
+      try {
+        const type = sqlEntry.getType();
+        if (type === TYPE_TOTP || type === TYPE_MICROSOFT) {
+          const entry = MicrosoftAuthImporterState.convertEntry(sqlEntry);
+          result.addEntry(entry);
+        }
+      }
+      catch (e) {
+        result.addError(e as DatabaseImporterEntryException);
+      }
+    }
+    return result;
+  }
+
+  private static convertEntry(entry: MicrosoftAuthImporterEntry): VaultEntry {
+    try {
+      let secret: Uint8Array;
+      let digits = 6;
+      const secretString = entry.getSecret();
+      if (secretString === null) {
+        throw new DatabaseImporterException('Secret is empty');
+      }
+      switch (entry.getType()) {
+        case TYPE_TOTP:
+          secret = GoogleAuthInfo.parseSecret(secretString);
+          break;
+        case TYPE_MICROSOFT:
+          digits = 8;
+          secret = Base64.decode(secretString);
+          break;
+        default:
+          throw new DatabaseImporterEntryException(`Unsupported OTP type: ${entry.getType()}`, entry.toString());
+      }
+      const info = new TotpInfo(secret, OtpInfo.DEFAULT_ALGORITHM, digits, TotpInfo.DEFAULT_PERIOD);
+      return new VaultEntry(info, entry.getUserName(), entry.getIssuer());
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterEntryException) {
+        throw e as DatabaseImporterEntryException;
+      }
+      throw new DatabaseImporterEntryException((e as Error).message, entry.toString());
+    }
+  }
+}
+
+export class MicrosoftAuthImporterEntry extends SqlImporterHelperEntry {
+  private _type: number;
+  private _secret: string | null;
+  private _issuer: string;
+  private _userName: string;
+
+  constructor(cursor: SqlImporterHelperCursor) {
+    super(cursor);
+    this._type = SqlImporterHelper.getInt(cursor, 'account_type');
+    this._secret = SqlImporterHelper.getString(cursor, 'oath_secret_key');
+    this._issuer = SqlImporterHelper.getStringOrDefault(cursor, 'name', '');
+    this._userName = SqlImporterHelper.getStringOrDefault(cursor, 'username', '');
+  }
+
+  getType(): number {
+    return this._type;
+  }
+
+  getSecret(): string | null {
+    return this._secret;
+  }
+
+  getIssuer(): string {
+    return this._issuer;
+  }
+
+  getUserName(): string {
+    return this._userName;
+  }
+
+  toString(): string {
+    return `MicrosoftAuthImporterEntry{type=${this._type}, issuer=${this._issuer}, userName=${this._userName}}`;
+  }
+}
diff --git a/entry/src/main/ets/importers/ProtonAuthenticatorImporter.ets b/entry/src/main/ets/importers/ProtonAuthenticatorImporter.ets
new file mode 100644
index 0000000..612e49f
--- /dev/null
+++ b/entry/src/main/ets/importers/ProtonAuthenticatorImporter.ets
@@ -0,0 +1,179 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState, DecryptListener } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { CryptoUtils, SecretKey } from '../crypto/CryptoUtils';
+import { Argon2Parameters, Argon2ParametersBuilder } from '../crypto/bc/Argon2Parameters';
+import { Base32 } from '../encoding/Base32';
+import { Base64 } from '../encoding/Base64';
+import { GoogleAuthInfo } from '../otp/GoogleAuthInfo';
+import { SteamInfo } from '../otp/SteamInfo';
+import { Dialogs } from '../ui/dialogs/Dialogs';
+import { Argon2Task, Argon2TaskParams } from '../ui/tasks/Argon2Task';
+import { JSONObject } from '../util/JSONObject';
+import { JsonUtils } from '../util/JsonUtils';
+import { Bytes } from '../util/Bytes';
+import { Uri } from '../util/Uri';
+import { VaultEntry } from '../vault/VaultEntry';
+
+export class ProtonAuthenticatorImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    throw new DatabaseImporterException('Unsupported operation');
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    try {
+      const contents = Bytes.toUtf8(stream);
+      const json = new JSONObject(contents);
+      if (json.has('salt') && json.has('content')) {
+        const version = json.getInt('version');
+        if (version !== 1) {
+          throw new DatabaseImporterException(`Unsupported version: ${version}`);
+        }
+        const salt = Base64.decode(json.getString('salt'));
+        const content = Base64.decode(json.getString('content'));
+        return new ProtonAuthenticatorImporterEncryptedState(salt, content);
+      }
+      return new ProtonAuthenticatorImporterDecryptedState(json);
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterException) {
+        throw e as DatabaseImporterException;
+      }
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+}
+
+export class ProtonAuthenticatorImporterEncryptedState extends DatabaseImporterState {
+  private static readonly KEY_SIZE: number = 32;
+  private static readonly MEMORY_KB: number = 19 * 1024;
+  private static readonly ITERATIONS: number = 2;
+  private static readonly PARALLELISM: number = 1;
+  private static readonly NONCE_SIZE: number = 12;
+  private static readonly TAG_SIZE: number = 16;
+  private static readonly AAD: Uint8Array = Bytes.fromUtf8('proton.authenticator.export.v1');
+  private readonly _salt: Uint8Array;
+  private readonly _content: Uint8Array;
+
+  constructor(salt: Uint8Array, content: Uint8Array) {
+    super(true);
+    this._salt = salt;
+    this._content = content;
+  }
+
+  async decryptWithPassword(password: string): Promise<ProtonAuthenticatorImporterDecryptedState> {
+    const params = this.getKeyDerivationParams(password);
+    const key = await Argon2Task.doInBackground(params);
+    return this.decryptWithKey(key);
+  }
+
+  private decryptWithKey(key: SecretKey): ProtonAuthenticatorImporterDecryptedState {
+    try {
+      const nonceSize = ProtonAuthenticatorImporterEncryptedState.NONCE_SIZE;
+      if (this._content.length < nonceSize + ProtonAuthenticatorImporterEncryptedState.TAG_SIZE) {
+        throw new DatabaseImporterException('Encrypted content is too short');
+      }
+      const nonce = Bytes.copyOfRange(this._content, 0, nonceSize);
+      const ct = Bytes.copyOfRange(this._content, nonceSize, this._content.length);
+      const plaintext = CryptoUtils.decryptGcmWithAppendedTag(key.getEncoded(), nonce, ct, ProtonAuthenticatorImporterEncryptedState.AAD);
+      return new ProtonAuthenticatorImporterDecryptedState(new JSONObject(Bytes.toUtf8(plaintext)));
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterException) {
+        throw e as DatabaseImporterException;
+      }
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  decrypt(uiContext: UIContext, listener: DecryptListener): void {
+    Dialogs.showPasswordInputDialog(uiContext, (password: string) => {
+      const params = this.getKeyDerivationParams(password);
+      const task = new Argon2Task(uiContext, (key: SecretKey) => {
+        try {
+          const state = this.decryptWithKey(key);
+          listener.onStateDecrypted(state);
+        }
+        catch (e) {
+          listener.onError(e as Error);
+        }
+      }, (e: Error) => listener.onError(e));
+      task.execute(params);
+    }, () => listener.onCanceled(), $r('app.string.enter_password_proton_message'));
+  }
+
+  private getKeyDerivationParams(password: string): Argon2TaskParams {
+    const argon2Params = new Argon2ParametersBuilder(Argon2Parameters.ARGON2_id)
+      .withVersion(Argon2Parameters.ARGON2_VERSION_13)
+      .withIterations(ProtonAuthenticatorImporterEncryptedState.ITERATIONS)
+      .withParallelism(ProtonAuthenticatorImporterEncryptedState.PARALLELISM)
+      .withMemoryAsKB(ProtonAuthenticatorImporterEncryptedState.MEMORY_KB)
+      .withSalt(this._salt)
+      .build();
+    return new Argon2TaskParams(password, argon2Params, ProtonAuthenticatorImporterEncryptedState.KEY_SIZE);
+  }
+}
+
+export class ProtonAuthenticatorImporterDecryptedState extends DatabaseImporterState {
+  private readonly _json: JSONObject;
+
+  constructor(json: JSONObject) {
+    super(false);
+    this._json = json;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    try {
+      const entries = this._json.getJSONArray('entries');
+      for (let i = 0; i < entries.length(); i++) {
+        const entry = entries.getJSONObject(i);
+        try {
+          result.addEntry(ProtonAuthenticatorImporterDecryptedState.convertEntry(entry));
+        }
+        catch (e) {
+          result.addError(e as DatabaseImporterEntryException);
+        }
+      }
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    return result;
+  }
+
+  private static convertEntry(entry: JSONObject): VaultEntry {
+    let content: JSONObject;
+    let name: string | null;
+    let uriString: string;
+    try {
+      content = entry.getJSONObject('content');
+      name = JsonUtils.optString(content, 'name');
+      if (name === null) {
+        name = '';
+      }
+      uriString = content.getString('uri');
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, entry.toString());
+    }
+    try {
+      const uri = Uri.parse(uriString);
+      const host = uri.getHost();
+      if (uri.getScheme() === 'steam' && host !== null) {
+        const otp = new SteamInfo(Base32.decode(host));
+        return new VaultEntry(otp, name, 'Steam');
+      }
+      const info = GoogleAuthInfo.parseUriObj(uri);
+      return new VaultEntry(info.getOtpInfo(), name, info.getIssuer());
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, uriString);
+    }
+  }
+}
diff --git a/entry/src/main/ets/importers/SqlImporterHelper.ets b/entry/src/main/ets/importers/SqlImporterHelper.ets
new file mode 100644
index 0000000..a8a2db0
--- /dev/null
+++ b/entry/src/main/ets/importers/SqlImporterHelper.ets
@@ -0,0 +1,229 @@
+import { common } from '@kit.AbilityKit';
+import { fileIo } from '@kit.CoreFileKit';
+import { relationalStore } from '@kit.ArkData';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { CryptoUtils } from '../crypto/CryptoUtils';
+import { Hex } from '../encoding/Hex';
+import { IOUtils } from '../util/IOUtils';
+
+export type SqlImporterHelperCursor = relationalStore.ResultSet;
+
+/**
+ * Creates an entry from the current row of the cursor (replacement for the Entry(Cursor) constructor
+ * that is invoked through reflection on Android).
+ */
+export type SqlImporterHelperEntryFactory<T extends SqlImporterHelperEntry> = (cursor: SqlImporterHelperCursor) => T;
+
+export abstract class SqlImporterHelperEntry {
+  constructor(cursor: SqlImporterHelperCursor) {
+  }
+}
+
+/**
+ * Reads the rows of a table of an SQLite database. The database is copied to a temporary file in the
+ * database directory of the app, opened with relationalStore and deleted afterwards.
+ */
+export class SqlImporterHelper {
+  private _context: common.Context;
+
+  constructor(context: common.Context) {
+    this._context = context;
+  }
+
+  /**
+   * Reads the given table of the database at the given path (including any -journal/-wal/-shm files).
+   */
+  async readFromPath<T extends SqlImporterHelperEntry>(type: SqlImporterHelperEntryFactory<T>, path: string, table: string): Promise<T[]> {
+    const name = SqlImporterHelper.newTempName();
+    const dir = this.getDatabaseDir();
+    const fileCopies: string[] = [];
+    const baseName = path.substring(path.lastIndexOf('/') + 1);
+    try {
+      for (const file of SqlImporterHelper.findDatabaseFiles(path)) {
+        // create temporary copies of the database files so that relationalStore can open them
+        const suffix = file.substring(file.lastIndexOf('/') + 1 + baseName.length);
+        const fileCopy = `${dir}/${name}${suffix}`;
+        fileCopies.push(fileCopy);
+        IOUtils.copy(file, fileCopy);
+      }
+    }
+    catch (e) {
+      SqlImporterHelper.deleteFiles(fileCopies);
+      if (e instanceof DatabaseImporterException) {
+        throw e as DatabaseImporterException;
+      }
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    try {
+      return await this.readFile(type, name, table);
+    }
+    finally {
+      SqlImporterHelper.deleteFiles(fileCopies);
+    }
+  }
+
+  private static findDatabaseFiles(path: string): string[] {
+    const idx = path.lastIndexOf('/');
+    const parent = idx > 0 ? path.substring(0, idx) : '/';
+    const name = path.substring(idx + 1);
+    let files: string[] = [];
+    try {
+      files = fileIo.listFileSync(parent).filter((n: string) => n.startsWith(name)).map((n: string) => `${parent}/${n}`);
+    }
+    catch (e) {
+      files = [];
+    }
+    if (files.length === 0) {
+      throw new DatabaseImporterException(`File does not exist: ${path}`);
+    }
+    return files;
+  }
+
+  /**
+   * Reads the given table of the SQLite database contained in the given bytes.
+   */
+  async read<T extends SqlImporterHelperEntry>(type: SqlImporterHelperEntryFactory<T>, inStream: Uint8Array, table: string): Promise<T[]> {
+    const name = SqlImporterHelper.newTempName();
+    const file = `${this.getDatabaseDir()}/${name}`;
+    try {
+      // create a temporary copy of the database so that relationalStore can open it
+      IOUtils.writeFile(file, inStream);
+    }
+    catch (e) {
+      SqlImporterHelper.deleteFiles([file]);
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    try {
+      return await this.readFile(type, name, table);
+    }
+    finally {
+      // always delete the temporary file
+      SqlImporterHelper.deleteFiles([file, `${file}-journal`, `${file}-wal`, `${file}-shm`]);
+    }
+  }
+
+  private async readFile<T extends SqlImporterHelperEntry>(type: SqlImporterHelperEntryFactory<T>, name: string, table: string): Promise<T[]> {
+    const config: relationalStore.StoreConfig = {
+      name: name,
+      securityLevel: relationalStore.SecurityLevel.S1
+    };
+    let store: relationalStore.RdbStore | null = null;
+    let cursor: relationalStore.ResultSet | null = null;
+    try {
+      store = await relationalStore.getRdbStore(this._context, config);
+      cursor = await store.querySql(`SELECT * FROM ${table}`);
+      const entries: T[] = [];
+      if (cursor.goToFirstRow()) {
+        do {
+          const entry = type(cursor);
+          entries.push(entry);
+        } while (cursor.goToNextRow());
+      }
+      return entries;
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterException) {
+        throw e as DatabaseImporterException;
+      }
+      const err = e as Error;
+      throw new DatabaseImporterException(err.message !== undefined ? err.message : String(e));
+    }
+    finally {
+      if (cursor !== null) {
+        cursor.close();
+      }
+      if (store !== null) {
+        try {
+          await store.close();
+        }
+        catch (e) {
+          // ignore
+        }
+      }
+      try {
+        await relationalStore.deleteRdbStore(this._context, config);
+      }
+      catch (e) {
+        // ignore, the files are deleted by the caller as well
+      }
+    }
+  }
+
+  /**
+   * The directory in which relationalStore opens databases by name.
+   */
+  private getDatabaseDir(): string {
+    const dir = `${this._context.databaseDir}/rdb`;
+    IOUtils.mkdirs(dir);
+    return dir;
+  }
+
+  private static newTempName(): string {
+    return `db-import-${Hex.encode(CryptoUtils.generateRandomBytes(8))}.db`;
+  }
+
+  private static deleteFiles(files: string[]): void {
+    for (const f of files) {
+      try {
+        if (IOUtils.exists(f)) {
+          fileIo.unlinkSync(f);
+        }
+      }
+      catch (e) {
+        // ignore
+      }
+    }
+  }
+
+  /**
+   * Returns the index of the column with the given name, or -1 if there is no such column.
+   */
+  static getColumnIndex(cursor: SqlImporterHelperCursor, columnName: string): number {
+    try {
+      return cursor.getColumnIndex(columnName);
+    }
+    catch (e) {
+      return -1;
+    }
+  }
+
+  private static requireColumnIndex(cursor: SqlImporterHelperCursor, columnName: string): number {
+    const index = SqlImporterHelper.getColumnIndex(cursor, columnName);
+    if (index < 0) {
+      throw new DatabaseImporterException(`Column not found: ${columnName}`);
+    }
+    return index;
+  }
+
+  static getString(cursor: SqlImporterHelperCursor, columnName: string): string | null {
+    const index = SqlImporterHelper.requireColumnIndex(cursor, columnName);
+    if (cursor.isColumnNull(index)) {
+      return null;
+    }
+    return cursor.getString(index);
+  }
+
+  static getStringOrDefault(cursor: SqlImporterHelperCursor, columnName: string, def: string): string {
+    const res = SqlImporterHelper.getString(cursor, columnName);
+    if (res === null) {
+      return def;
+    }
+    return res;
+  }
+
+  static getInt(cursor: SqlImporterHelperCursor, columnName: string): number {
+    const index = SqlImporterHelper.requireColumnIndex(cursor, columnName);
+    if (cursor.isColumnNull(index)) {
+      return 0;
+    }
+    return Math.trunc(cursor.getLong(index)) | 0;
+  }
+
+  static getLong(cursor: SqlImporterHelperCursor, columnName: string): number {
+    const index = SqlImporterHelper.requireColumnIndex(cursor, columnName);
+    if (cursor.isColumnNull(index)) {
+      return 0;
+    }
+    return cursor.getLong(index);
+  }
+}
diff --git a/entry/src/main/ets/importers/SteamImporter.ets b/entry/src/main/ets/importers/SteamImporter.ets
