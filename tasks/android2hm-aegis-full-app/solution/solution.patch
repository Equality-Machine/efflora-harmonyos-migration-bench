+import { AssignIconEntry, AssignIconEntryListener } from '../models/AssignIconEntry';
+import { EntryIconView, GlideHelper } from '../glide/GlideHelper';
+
+/**
+ * Port of AssignIconHolder (layout card_assign_icon_entry): shows the current and the new icon of an entry.
+ */
+@Component
+export struct AssignIconHolder {
+  entry: AssignIconEntry | null = null;
+  onEntryClick: (entry: AssignIconEntry) => void = (entry: AssignIconEntry) => {
+  };
+  @State private _issuer: string = '';
+  @State private _accountName: string = '';
+  @State private _oldIconKey: string = '';
+  @State private _newIcon: string = '';
+  @State private _hasNewIcon: boolean = false;
+
+  aboutToAppear(): void {
+    if (this.entry !== null) {
+      this.setData(this.entry);
+      this.entry.setOnResetListener(new AssignIconEntryListener(() => this.onNewIconChanged()));
+    }
+  }
+
+  aboutToDisappear(): void {
+    if (this.entry !== null) {
+      this.entry.setOnResetListener(null);
+    }
+  }
+
+  setData(entry: AssignIconEntry): void {
+    this._issuer = entry.getEntry().getIssuer();
+    this._accountName = entry.getEntry().getName();
+    this._oldIconKey = GlideHelper.getEntryIconKey(entry.getEntry());
+    this.setNewIcon();
+  }
+
+  private setNewIcon(): void {
+    const icon = this.entry !== null ? this.entry.getNewIcon() : null;
+    this._hasNewIcon = icon !== null;
+    this._newIcon = icon !== null ? GlideHelper.loadIcon(icon) : '';
+  }
+
+  onNewIconChanged(): void {
+    this.setNewIcon();
+  }
+
+  build() {
+    Column() {
+      Text(this._issuer)
+        .fontSize(18)
+        .fontWeight(FontWeight.Bold)
+        .fontColor($r('app.color.theme_onSurface'))
+        .maxLines(1)
+        .textOverflow({ overflow: TextOverflow.Ellipsis })
+        .width('100%')
+      Text(this._accountName)
+        .fontSize(14)
+        .fontColor($r('app.color.theme_onSurfaceVariant'))
+        .maxLines(1)
+        .textOverflow({ overflow: TextOverflow.Ellipsis })
+        .width('100%')
+        .margin({ bottom: 8 })
+      Row() {
+        Stack() {
+          EntryIconView({ iconKey: this._oldIconKey, issuer: this._issuer, name: this._accountName, iconSize: 60 })
+        }
+        .width(60)
+        .height(60)
+        .borderRadius(30)
+        .clip(true)
+
+        Image($r('app.media.baseline_arrow_right_24'))
+          .width(32)
+          .height(32)
+          .opacity(0.7)
+          .fillColor($r('app.color.theme_onSurface'))
+          .margin({ left: 5, right: 15 })
+
+        if (this._hasNewIcon) {
+          Image(this._newIcon)
+            .width(60)
+            .height(60)
+            .borderRadius(30)
+            .clip(true)
+            .objectFit(ImageFit.Contain)
+        } else {
+          Image($r('app.media.ic_unselected'))
+            .width(60)
+            .height(60)
+            .fillColor($r('app.color.theme_onSurfaceVariant'))
+        }
+
+        Blank()
+
+        Image($r('app.media.ic_outline_reset_image_24'))
+          .width(24)
+          .height(24)
+          .fillColor($r('app.color.theme_onSurfaceVariant'))
+          .margin({ left: 15, right: 15 })
+          .visibility(this._hasNewIcon ? Visibility.Visible : Visibility.Hidden)
+          .onClick(() => {
+            if (this.entry !== null) {
+              this.entry.setNewIcon(null);
+            }
+          })
+      }
+      .width('100%')
+      .alignItems(VerticalAlign.Center)
+    }
+    .width('100%')
+    .padding({ top: 10, bottom: 10, left: 14 })
+    .borderRadius(12)
+    .backgroundColor($r('app.color.theme_surfaceContainerLow'))
+    .onClick(() => {
+      if (this.entry !== null) {
+        this.onEntryClick(this.entry);
+      }
+    })
+  }
+}
