index 0000000..a2112b4
--- /dev/null
+++ b/entry/src/main/ets/ui/PanicResponderActivity.ets
@@ -0,0 +1,45 @@
+import { common, Want } from '@kit.AbilityKit';
+import { promptAction } from '@kit.ArkUI';
+import { VaultRepository } from '../vault/VaultRepository';
+import { AegisModule } from '../AegisModule';
+import { ExitActivity } from './ExitActivity';
+import { ACTION_PANIC_TRIGGER } from './IncomingIntent';
+import { ResUtils } from '../util/ResUtils';
+import { TrustedIntents } from '../info/guardianproject/trustedintents/TrustedIntents';
+import { GuardianProjectRSA4096 } from '../info/guardianproject/GuardianProjectRSA4096';
+import { GuardianProjectFDroidRSA2048 } from '../crypto/pins/GuardianProjectFDroidRSA2048';
+
+/**
+ * Port of PanicResponderActivity: wipes the vault and exits the app when a panic trigger is received
+ * (if enabled in the preferences). It doesn't have a UI.
+ */
+export class PanicResponderActivity {
+  static readonly PANIC_TRIGGER_ACTION: string = ACTION_PANIC_TRIGGER;
+
+  static onCreate(context: common.UIAbilityContext, want: Want): void {
+    const prefs = AegisModule.getPreferences();
+    if (!prefs.isPanicTriggerEnabled()) {
+      try {
+        promptAction.showToast({ message: ResUtils.getString(context, 'panic_trigger_ignore_toast') });
+      } catch (e) {
+        // ignore
+      }
+      return;
+    }
+
+    const trustedIntents = TrustedIntents.get();
+    trustedIntents.addTrustedSigner(new GuardianProjectRSA4096());
+    trustedIntents.addTrustedSigner(new GuardianProjectFDroidRSA2048());
+    const intent = trustedIntents.getIntentFromTrustedSender(want);
+
+    if (intent !== null && intent.action === PanicResponderActivity.PANIC_TRIGGER_ACTION) {
+      VaultRepository.deleteFile(context);
+      AegisModule.provideVaultManager().lock(false);
+      PanicResponderActivity.finishApp(context);
+    }
+  }
+
+  private static finishApp(context: common.UIAbilityContext): void {
+    ExitActivity.exitAppAndRemoveFromRecents(context);
+  }
+}
diff --git a/entry/src/main/ets/ui/PreferencesActivity.ets b/entry/src/main/ets/ui/PreferencesActivity.ets
new file mode 100644
index 0000000..5effba5
--- /dev/null
+++ b/entry/src/main/ets/ui/PreferencesActivity.ets
@@ -0,0 +1,123 @@
+import { AegisActivity, PAGE_PREFERENCES } from './AegisActivity';
+import { Intent } from './Intent';
+import { Toolbar } from './components/Toolbar';
+import { PreferencesFragment } from './fragments/preferences/PreferencesFragment';
+import { Preference, PreferenceScreen } from './preferences/Preference';
+import { PreferenceResources } from './preferences/PreferenceResources';
+import { PreferenceScreenView } from './preferences/PreferenceScreenView';
+import { ThemeHelper } from '../helpers/ThemeHelper';
+
+/**
+ * Port of PreferencesActivity. It shows the MainPreferencesFragment (the list of sections) and opens
+ * the section pages on top of it. Supported extras:
+ *  - "fragment": the URL (PAGE_PREFS_*) of a section to open immediately.
+ *  - "pref": the key of a preference in that section to scroll to and highlight.
+ * The page always finishes with RESULT_OK (extra "needsRecreate" = true), so MainActivity refreshes.
+ */
+@Entry
+@Component
+struct PreferencesActivity {
+  @State tick: number = 0;
+  private _activity: AegisActivity | null = null;
+  private _fragment: PreferencesFragment | null = null;
+
+  aboutToAppear(): void {
+    const activity = new AegisActivity(this.getUIContext(), PAGE_PREFERENCES);
+    this._activity = activity;
+    activity.onCreate();
+    if (activity.abortIfOrphan()) {
+      return;
+    }
+
+    this._fragment = new PreferencesFragment(activity, () => {
+      this.tick++;
+    });
+    this._fragment.addPreferencesFromResource(PreferenceResources.preferences());
+    this._fragment.getPreferenceScreen().setOnPreferenceStartFragmentCallback((pref: Preference) => {
+      return this.onPreferenceStartFragment(pref);
+    });
+
+    const requestedFragment = this.getRequestedFragment();
+    if (requestedFragment !== null) {
+      // the "pref" extra is meant for the requested fragment
+      const intent = new Intent(requestedFragment);
+      const pref = activity.getIntent().getStringExtra('pref');
+      if (pref !== null) {
+        intent.putExtra('pref', pref);
+        activity.getIntent().removeExtra('pref');
+      }
+      setTimeout(() => this.showFragment(intent), 50);
+    }
+  }
+
+  onPageShow(): void {
+    if (this._activity !== null) {
+      this._activity.onResume();
+    }
+    if (this._fragment !== null) {
+      this._fragment.onResume();
+    }
+  }
+
+  aboutToDisappear(): void {
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  onBackPress(): boolean {
+    return false;
+  }
+
+  onOptionsItemSelected(itemId: string): boolean {
+    if (itemId === 'home' && this._activity !== null) {
+      this._activity.finish();
+      return true;
+    }
+    return false;
+  }
+
+  onPreferenceStartFragment(pref: Preference): boolean {
+    const url = pref.getFragment();
+    if (url === null) {
+      return false;
+    }
+    this.showFragment(new Intent(url));
+    return true;
+  }
+
+  private showFragment(intent: Intent): void {
+    if (this._activity !== null) {
+      this._activity.startActivity(intent);
+    }
+  }
+
+  private getRequestedFragment(): string | null {
+    if (this._activity === null) {
+      return null;
+    }
+    return this._activity.getIntent().getStringExtra('fragment');
+  }
+
+  private getScreen(): PreferenceScreen {
+    return (this._fragment as PreferencesFragment).getPreferenceScreen();
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.action_settings'),
+        backgroundColorValue: ThemeHelper.isAmoled() ? '#000000' : $r('app.color.theme_surface'),
+        onBack: () => {
+          this.onOptionsItemSelected('home');
+        }
+      })
+      if (this._fragment !== null) {
+        PreferenceScreenView({ screenProvider: () => this.getScreen(), tick: this.tick })
+      }
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
diff --git a/entry/src/main/ets/ui/ScannerActivity.ets b/entry/src/main/ets/ui/ScannerActivity.ets
new file mode 100644
index 0000000..ea48fd8
--- /dev/null
+++ b/entry/src/main/ets/ui/ScannerActivity.ets
@@ -0,0 +1,220 @@
+import { camera } from '@kit.CameraKit';
+import { AegisActivity, PAGE_SCANNER } from './AegisActivity';
+import { Intent, RESULT_OK } from './Intent';
+import { Dialogs } from './dialogs/Dialogs';
+import { Toolbar, ToolbarMenuItem } from './components/Toolbar';
+import { QrCodeAnalyzer, QrCodeAnalyzerListener } from '../helpers/QrCodeAnalyzer';
+import { VaultEntry } from '../vault/VaultEntry';
+import { GoogleAuthInfo } from '../otp/GoogleAuthInfo';
+import { GoogleAuthInfoException } from '../otp/GoogleAuthInfoException';
+import { Uri } from '../util/Uri';
+import { AegisModule } from '../AegisModule';
+
+class ScannerListener implements QrCodeAnalyzerListener {
+  private _cb: (result: string) => void;
+
+  constructor(cb: (result: string) => void) {
+    this._cb = cb;
+  }
+
+  onQrCodeDetected(result: string): void {
+    this._cb(result);
+  }
+}
+
+/**
+ * Port of ScannerActivity: scans QR codes with the camera (Scan Kit custom scanner on an
+ * XComponent surface). Google Authenticator export batches can be scanned one QR code after the
+ * other.
+ */
+@Entry
+@Component
+struct ScannerActivity {
+  private _activity: AegisActivity = new AegisActivity(this.getUIContext(), PAGE_SCANNER);
+  private _analyzer: QrCodeAnalyzer = new QrCodeAnalyzer(new ScannerListener((r: string) => this.onQrCodeDetected(r)));
+  private _xcomponentController: XComponentController = new XComponentController();
+  private _surfaceId: string = '';
+  private _batchId: number = 0;
+  private _batchIndex: number = -1;
+  private _entries: VaultEntry[] = [];
+  private _finishing: boolean = false;
+  private _analysisPaused: boolean = false;
+  private _lenses: number = 0;
+  @State torchOn: boolean = false;
+  @State viewWidth: number = 0;
+  @State viewHeight: number = 0;
+
+  aboutToAppear(): void {
+    this._activity.onCreate();
+    if (this._activity.abortIfOrphan()) {
+      return;
+    }
+    try {
+      const manager = camera.getCameraManager(AegisModule.getContext());
+      this._lenses = manager.getSupportedCameras().length;
+    } catch (e) {
+      this._lenses = 0;
+    }
+    if (this._lenses === 0) {
+      this._activity.showToast($r('app.string.no_cameras_available'), true);
+      this._finishing = true;
+      this._activity.finish();
+    }
+  }
+
+  onPageShow(): void {
+    this._activity.onResume();
+    if (this._surfaceId.length > 0 && !this._finishing) {
+      this.bindPreview();
+    }
+  }
+
+  onPageHide(): void {
+    this.unbindPreview();
+  }
+
+  aboutToDisappear(): void {
+    this._analyzer.release();
+    this._activity.onDestroy();
+  }
+
+  private bindPreview(): void {
+    if (this.viewWidth <= 0 || this.viewHeight <= 0) {
+      return;
+    }
+    this._analysisPaused = false;
+    this._analyzer.start(this._surfaceId, this.viewWidth, this.viewHeight);
+  }
+
+  private unbindPreview(): void {
+    this._analysisPaused = true;
+    this._analyzer.stop();
+  }
+
+  private getMenuItems(): ToolbarMenuItem[] {
+    return [
+      new ToolbarMenuItem('action_camera', $r('app.string.switch_camera'),
+        this.torchOn ? $r('app.media.ic_outline_camera_rear_24') : $r('app.media.ic_outline_camera_front_24'), true)
+        .setVisible(this._lenses > 0)
+    ];
+  }
+
+  private onOptionsItemSelected(id: string): void {
+    if (id === 'action_camera') {
+      // the custom scanner always uses the rear camera; this action toggles its torch instead
+      this.torchOn = !this.torchOn;
+      this._analyzer.setTorch(this.torchOn);
+    }
+  }
+
+  onQrCodeDetected(result: string): void {
+    if (this._finishing || this._analysisPaused) {
+      return;
+    }
+
+    try {
+      const uri = Uri.parse(result.trim());
+      if (uri.getScheme() !== null && uri.getScheme() === GoogleAuthInfo.SCHEME_EXPORT) {
+        this.handleExportUri(uri);
+      } else {
+        this.handleUri(uri);
+      }
+    } catch (e) {
+      this.unbindPreview();
+      const isPhoneFactor = e instanceof GoogleAuthInfoException && (e as GoogleAuthInfoException).isPhoneFactor();
+      Dialogs.showErrorDialog(this.getUIContext(),
+        isPhoneFactor ? $r('app.string.read_qr_error_phonefactor') : $r('app.string.read_qr_error'),
+        e as Error, () => this.bindPreview());
+      return;
+    }
+
+    if (!this._finishing) {
+      setTimeout(() => this._analyzer.rescan(), 500);
+    }
+  }
+
+  private handleUri(uri: Uri): void {
+    const info = GoogleAuthInfo.parseUriObj(uri);
+    const entries: VaultEntry[] = [VaultEntry.fromGoogleAuthInfo(info)];
+    this.finishWith(entries);
+  }
+
+  private handleExportUri(uri: Uri): void {
+    const exp = GoogleAuthInfo.parseExportUriObj(uri);
+    if (this._batchId === 0) {
+      this._batchId = exp.getBatchId();
+    }
+
+    const batchIndex = exp.getBatchIndex();
+    if (this._batchId !== exp.getBatchId()) {
+      this._activity.showToast($r('app.string.google_qr_export_unrelated'));
+    } else if (this._batchIndex === -1 || this._batchIndex === batchIndex - 1) {
+      for (const info of exp.getEntries()) {
+        this._entries.push(VaultEntry.fromGoogleAuthInfo(info));
+      }
+
+      this._batchIndex = batchIndex;
+      if (this._batchIndex + 1 === exp.getBatchSize()) {
+        this.finishWith(this._entries);
+      }
+
+      this._activity.showToast(this._activity.getQuantityString('google_qr_export_scanned', exp.getBatchSize(),
+        [this._batchIndex + 1, exp.getBatchSize()]));
+    } else if (this._batchIndex !== batchIndex) {
+      this._activity.showToast(this._activity.getString('google_qr_export_unexpected', [this._batchIndex + 1, batchIndex + 1]));
+    }
+  }
+
+  private finishWith(entries: VaultEntry[]): void {
+    this._finishing = true;
+    this.unbindPreview();
+    const intent = new Intent(PAGE_SCANNER);
+    intent.putExtra('entries', entries);
+    this._activity.setResult(RESULT_OK, intent);
+    this._activity.finish();
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.title_activity_scan_qr'),
+        menuItems: this.getMenuItems(),
+        backgroundColorValue: '#000000',
+        onBack: () => this._activity.finish(),
+        onMenuItemClick: (id: string) => this.onOptionsItemSelected(id)
+      })
+      Stack() {
+        XComponent({ id: 'scanner_preview', type: XComponentType.SURFACE, controller: this._xcomponentController })
+          .onLoad(() => {
+            this._surfaceId = this._xcomponentController.getXComponentSurfaceId();
+            this.bindPreview();
+          })
+          .width('100%')
+          .height('100%')
+        Column()
+          .width(240)
+          .height(240)
+          .borderWidth(2)
+          .borderColor('#CCFFFFFF')
+          .borderRadius(16)
+      }
+      .layoutWeight(1)
+      .width('100%')
+      .onAreaChange((oldValue: Area, newValue: Area) => {
+        const w = Number(newValue.width);
+        const h = Number(newValue.height);
+        if (w !== this.viewWidth || h !== this.viewHeight) {
+          this.viewWidth = w;
+          this.viewHeight = h;
+          if (this._surfaceId.length > 0) {
+            this._xcomponentController.setXComponentSurfaceRect({ surfaceWidth: vp2px(w), surfaceHeight: vp2px(h) });
+            this.bindPreview();
+          }
+        }
+      })
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor('#000000')
+  }
+}
diff --git a/entry/src/main/ets/ui/TransferEntriesActivity.ets b/entry/src/main/ets/ui/TransferEntriesActivity.ets
new file mode 100644
index 0000000..8fd8e8b
--- /dev/null
+++ b/entry/src/main/ets/ui/TransferEntriesActivity.ets
@@ -0,0 +1,203 @@
+import { image } from '@kit.ImageKit';
+import { window } from '@kit.ArkUI';
+import { AegisActivity, PAGE_TRANSFER_ENTRIES } from './AegisActivity';
+import { Dialogs } from './dialogs/Dialogs';
+import { Toolbar } from './components/Toolbar';
+import { Transferable } from '../otp/Transferable';
+import { GoogleAuthInfo, GoogleAuthInfoExport } from '../otp/GoogleAuthInfo';
+import { QrCodeHelper } from '../helpers/QrCodeHelper';
+import { ThemeHelper } from '../helpers/ThemeHelper';
+import { ClipboardUtils } from '../util/ClipboardUtils';
+import { Theme } from '../Theme';
+import { AegisModule } from '../AegisModule';
+import { MetricsHelper } from '../helpers/MetricsHelper';
+
+/**
+ * Port of TransferEntriesActivity: shows the entries (or Google Authenticator export batches) as
+ * QR codes, one after the other.
+ */
+@Entry
+@Component
+struct TransferEntriesActivity {
+  private _activity: AegisActivity = new AegisActivity(this.getUIContext(), PAGE_TRANSFER_ENTRIES);
+  private _authInfos: Transferable[] = [];
+  private _isMaxBrightnessSet: boolean = false;
+  @State currentEntryCount: number = 1;
+  @State qrImage: image.PixelMap | null = null;
+  @State issuer: string = '';
+  @State accountName: string = '';
+  @State isExport: boolean = false;
+  @State qrSize: number = 280;
+
+  aboutToAppear(): void {
+    this._activity.onCreate();
+    if (this._activity.abortIfOrphan()) {
+      return;
+    }
+    const infos = this._activity.getIntent().getExtra('authInfos');
+    this._authInfos = infos !== null ? infos as Transferable[] : [];
+    if (this._authInfos.length > 0) {
+      this.generateQR();
+    }
+  }
+
+  onPageShow(): void {
+    this._activity.onResume();
+  }
+
+  aboutToDisappear(): void {
+    if (this._isMaxBrightnessSet) {
+      this.setBrightness(-1);
+    }
+    this._activity.onDestroy();
+  }
+
+  private setBrightness(brightnessAmount: number): void {
+    window.getLastWindow(AegisModule.getAbilityContext()).then((win: window.Window) => {
+      win.setWindowBrightness(brightnessAmount).catch(() => {
+      });
+    }).catch(() => {
+    });
+  }
+
+  private onNextClick(): void {
+    if (this.currentEntryCount < this._authInfos.length) {
+      this.currentEntryCount++;
+      this.generateQR();
+    } else {
+      this._activity.finish();
+    }
+  }
+
+  private onPreviousClick(): void {
+    if (this.currentEntryCount > 1) {
+      this.currentEntryCount--;
+      this.generateQR();
+    }
+  }
+
+  private onCopyClick(): void {
+    const selectedEntry = this._authInfos[this.currentEntryCount - 1];
+    try {
+      ClipboardUtils.copyText(selectedEntry.getUri().toString(), true);
+      this._activity.showToast($r('app.string.uri_copied_to_clipboard'));
+    } catch (e) {
+      Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.unable_to_copy_uri_to_clipboard'), e as Error);
+    }
+  }
+
+  private onQrClick(): void {
+    if (!this._isMaxBrightnessSet) {
+      this.setBrightness(1);
+      this._isMaxBrightnessSet = true;
+    } else {
+      // -1 restores the system brightness
+      this.setBrightness(-1);
+      this._isMaxBrightnessSet = false;
+    }
+  }
+
+  private generateQR(): void {
+    const selectedEntry = this._authInfos[this.currentEntryCount - 1];
+    if (selectedEntry instanceof GoogleAuthInfo) {
+      const entry = selectedEntry as GoogleAuthInfo;
+      this.issuer = entry.getIssuer();
+      this.accountName = entry.getAccountName();
+      this.isExport = false;
+    } else if (selectedEntry instanceof GoogleAuthInfoExport) {
+      this.isExport = true;
+    }
+
+    const backgroundColor = this._activity.getThemeHelper().getConfiguredTheme() === Theme.LIGHT ? 0xFFEFEDF1 : 0xFFFFFFFF;
+    let text: string;
+    try {
+      text = selectedEntry.getUri().toString();
+    } catch (e) {
+      Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.unable_to_generate_qrcode'), e as Error);
+      return;
+    }
+    const px = MetricsHelper.convertDpToPixels(this.qrSize);
+    QrCodeHelper.encodeToBitmap(text, px, px, backgroundColor).then((pm: image.PixelMap) => {
+      this.qrImage = pm;
+    }).catch((e: Error) => {
+      Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.unable_to_generate_qrcode'), e);
+    });
+  }
+
+  private getCountText(): string {
+    return this._activity.getQuantityString('qr_count', this._authInfos.length, [this.currentEntryCount, this._authInfos.length]);
+  }
+
+  build() {
+    Column() {
+      Toolbar({ title: $r('app.string.title_activity_transfer'), onBack: () => this._activity.finish() })
+      Scroll() {
+        Column() {
+          Text(this.isExport ? $r('app.string.google_auth_compatible_transfer_description') :
+            $r('app.string.transfer_entry_description'))
+            .fontSize(15)
+            .textAlign(TextAlign.Center)
+            .fontColor($r('app.color.theme_onSurfaceVariant'))
+            .margin({ top: 16, bottom: 16 })
+          Stack() {
+            if (this.qrImage !== null) {
+              Image(this.qrImage)
+                .width(this.qrSize)
+                .height(this.qrSize)
+                .interpolation(ImageInterpolation.None)
+            }
+          }
+          .width(this.qrSize)
+          .height(this.qrSize)
+          .borderRadius(16)
+          .clip(true)
+          .onClick(() => this.onQrClick())
+
+          if (!this.isExport) {
+            Text(this.issuer)
+              .fontSize(18)
+              .fontWeight(FontWeight.Bold)
+              .fontColor($r('app.color.theme_onSurface'))
+              .margin({ top: 16 })
+            Text(this.accountName)
+              .fontSize(15)
+              .fontColor($r('app.color.theme_onSurfaceVariant'))
+          }
+          if (this._authInfos.length > 0 && this._authInfos[0] instanceof GoogleAuthInfo) {
+            Button($r('app.string.copy_uri'))
+              .backgroundColor(Color.Transparent)
+              .fontColor($r('app.color.theme_primary'))
+              .margin({ top: 12 })
+              .onClick(() => this.onCopyClick())
+          }
+          Text(this.getCountText())
+            .fontSize(14)
+            .fontColor($r('app.color.theme_onSurfaceVariant'))
+            .margin({ top: 16 })
+          Row() {
+            Button($r('app.string.previous'))
+              .visibility(this.currentEntryCount > 1 ? Visibility.Visible : Visibility.Hidden)
+              .onClick(() => this.onPreviousClick())
+            Blank()
+            Button(this.currentEntryCount === this._authInfos.length ? $r('app.string.done') : $r('app.string.next'))
+              .visibility(this._authInfos.length !== 1 ? Visibility.Visible : Visibility.Hidden)
+              .onClick(() => this.onNextClick())
+          }
+          .width('100%')
