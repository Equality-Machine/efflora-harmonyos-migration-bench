+import { OtpInfo } from './OtpInfo';
+import { TotpInfo } from './TotpInfo';
+import { TOTP } from '../crypto/otp/TOTP';
+import { JSONObject } from '../util/JSONObject';
+
+export class SteamInfo extends TotpInfo {
+  static readonly ID: string = 'steam';
+  static readonly DIGITS: number = 5;
+
+  constructor(secret: Uint8Array, algorithm?: string, digits?: number, period?: number) {
+    super(secret, algorithm !== undefined ? algorithm : OtpInfo.DEFAULT_ALGORITHM,
+      digits !== undefined ? digits : SteamInfo.DIGITS,
+      period !== undefined ? period : TotpInfo.DEFAULT_PERIOD);
+  }
+
+  getOtp(time?: number): string {
+    this.checkSecret();
+    const t = time !== undefined ? time : Math.floor(Date.now() / 1000);
+    const otp = TOTP.generateOTP(this.getSecret(), this.getAlgorithm(true), this.getDigits(), this.getPeriod(), t);
+    return otp.toSteamString();
+  }
+
+  getTypeId(): string {
+    return SteamInfo.ID;
+  }
+
+  getType(): string {
+    const id = this.getTypeId();
+    return id.substring(0, 1).toUpperCase() + id.substring(1);
+  }
+}
+
+OtpInfo.registerFactory(SteamInfo.ID, (type: string, secret: Uint8Array, algo: string, digits: number, obj: JSONObject): OtpInfo => {
+  return new SteamInfo(secret, algo, digits, obj.getInt('period'));
+});
