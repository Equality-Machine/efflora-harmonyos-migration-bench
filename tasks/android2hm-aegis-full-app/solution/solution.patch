+export type OnPreferenceChangeListener = (preference: Preference, newValue: Object) => boolean;
+export type OnPreferenceStartFragmentCallback = (preference: Preference) => boolean;
+
+/**
+ * The attributes that can be set on a preference in the XML resource (res/xml/preferences_*.xml).
+ */
+export interface PreferenceAttrs {
+  key?: string;
+  title?: ResourceStr;
+  summary?: ResourceStr;
+  icon?: Resource;
+  iconSpaceReserved?: boolean;
+  dependency?: string;
+  persistent?: boolean;
+  defaultValue?: boolean;
+  selectable?: boolean;
