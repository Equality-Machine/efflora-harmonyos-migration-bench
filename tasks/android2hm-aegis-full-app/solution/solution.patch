+/**
+ * Port of SecurityPreferencesFragment (res/xml/preferences_security.xml).
+ */
+@Entry
+@Component
+struct SecurityPreferencesFragment {
+  @State tick: number = 0;
+  private _activity: AegisActivity | null = null;
+  private _fragment: PreferencesFragment | null = null;
+  private _prefs: Preferences = AegisModule.getPreferences();
+  private _vaultManager: VaultManager = AegisModule.provideVaultManager();
+  private _encryptionPreference: SwitchPreference | null = null;
+  private _biometricsPreference: SwitchPreference | null = null;
+  private _autoLockPreference: Preference | null = null;
+  private _setPasswordPreference: Preference | null = null;
+  private _passwordReminderPreference: Preference | null = null;
+  private _pinKeyboardPreference: SwitchPreferenceCompat | null = null;
+  private _backupPasswordPreference: SwitchPreference | null = null;
+  private _backupPasswordChangePreference: Preference | null = null;
+  private _biometricSlotInitializer: BiometricSlotInitializer | null = null;
+
+  aboutToAppear(): void {
+    const activity = new AegisActivity(this.getUIContext(), PAGE_PREFS_SECURITY);
+    this._activity = activity;
+    activity.onCreate();
+    if (activity.abortIfOrphan()) {
+      return;
+    }
+
+    this._fragment = new PreferencesFragment(activity, () => {
+      this.tick++;
+    });
+    this._prefs = activity.getPreferences();
+    this._vaultManager = activity.getVaultManager();
+    this.onCreatePreferences();
+  }
+
+  onPageShow(): void {
+    if (this._activity !== null) {
+      this._activity.onResume();
+    }
+    this.onResume();
+  }
+
+  aboutToDisappear(): void {
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  onResume(): void {
+    if (this._fragment === null || !this._vaultManager.isVaultLoaded()) {
+      return;
+    }
+    this._fragment.onResume();
+    this.updateEncryptionPreferences();
+  }
+
+  private requireFragment(): PreferencesFragment {
+    return this._fragment as PreferencesFragment;
+  }
+
+  private requireContext(): UIContext {
+    return this.getUIContext();
+  }
+
+  onCreatePreferences(): void {
+    const fragment = this.requireFragment();
+    fragment.addPreferencesFromResource(PreferenceResources.preferences_security());
+
+    const screenPreference = fragment.requirePreference<Preference>('pref_secure_screen');
+    screenPreference.setOnPreferenceChangeListener((preference: Preference, newValue: Object) => {
+      // persist the value before applying it to the window (FLAG_SECURE -> privacy mode)
+      this._prefs.putBoolean('pref_secure_screen', newValue as boolean);
+      AegisApplication.refreshSecureScreen();
+      return true;
+    });
+
+    const tapToRevealTimePreference = fragment.requirePreference<Preference>('pref_tap_to_reveal_time');
+    tapToRevealTimePreference.setSummary(`${this._prefs.getTapToRevealTime()} seconds`);
+    tapToRevealTimePreference.setOnPreferenceClickListener((preference: Preference) => {
+      Dialogs.showTapToRevealTimeoutPickerDialog(this.requireContext(), this._prefs.getTapToRevealTime(),
+        (n: number) => {
+          this._prefs.setTapToRevealTime(n);
+          tapToRevealTimePreference.setSummary(`${n} seconds`);
+        });
+      return false;
+    });
+
+    const pinKeyboardPreference = fragment.requirePreference<SwitchPreferenceCompat>('pref_pin_keyboard');
+    this._pinKeyboardPreference = pinKeyboardPreference;
+    const update = () => this.updateEncryptionPreferences();
+
+    this._encryptionPreference = fragment.requirePreference<SwitchPreference>('pref_encryption');
+    this._encryptionPreference.setOnPreferenceChangeListener((preference: Preference, newValue: Object) => {
+      if (!this._vaultManager.getVault().isEncryptionEnabled()) {
+        Dialogs.showSetPasswordDialog(this.requireContext(), new EnableEncryptionListener(fragment, pinKeyboardPreference,
+          update));
+      } else {
+        Dialogs.showSimpleDialog(this.requireContext(), $r('app.string.disable_encryption'),
+          $r('app.string.disable_encryption_description'),
+          $r('app.string.yes'), () => {
+            this.disableEncryption();
+          },
+          $r('app.string.no'), null, undefined, undefined, true);
+      }
+
+      return false;
+    });
+
+    this._biometricsPreference = fragment.requirePreference<SwitchPreference>('pref_biometrics');
+    this._biometricsPreference.setOnPreferenceChangeListener((preference: Preference, newValue: Object) => {
+      const creds = this._vaultManager.getVault().getCredentials() as VaultFileCredentials;
+      const slots = creds.getSlots();
+
+      if (!slots.hasBiometricSlot()) {
+        if (BiometricsHelper.isAvailable()) {
+          const initializer = new BiometricSlotInitializer(new RegisterBiometricsListener(fragment, update));
+          this._biometricSlotInitializer = initializer;
+          const info = new BiometricPromptInfo(getString('set_up_biometric'), '', getString('cancel'));
+          this._vaultManager.setBlockAutoLock(true);
+          initializer.authenticate(info).catch((e: Error) => {
+            Dialogs.showErrorDialog(this.requireContext(), $r('app.string.encryption_enable_biometrics_error'), e);
+          });
+        }
+      } else {
+        // remove the biometric slot
+        const slot = slots.findBiometricSlot() as BiometricSlot;
+        slots.remove(slot);
+        this._vaultManager.getVault().setCredentials(creds);
+
+        // remove the KeyStore key
+        const handle = new KeyStoreHandle();
+        handle.deleteKey(slot.getUUID()).catch(() => {
+        });
+
+        fragment.saveAndBackupVault();
+        this.updateEncryptionPreferences();
+      }
+
+      return false;
+    });
+
+    this._setPasswordPreference = fragment.requirePreference<Preference>('pref_password');
+    this._setPasswordPreference.setOnPreferenceClickListener((preference: Preference) => {
+      Dialogs.showSetPasswordDialog(this.requireContext(), new SetPasswordListener(fragment, pinKeyboardPreference, update));
+      return false;
+    });
+
+    pinKeyboardPreference.setOnPreferenceChangeListener((preference: Preference, newValue: Object) => {
+      if (!(newValue as boolean)) {
+        return true;
+      }
+
+      Dialogs.showPasswordInputDialog(this.requireContext(), (password: string) => {
+        if (isDigitsOnly(password)) {
+          const slots = (this._vaultManager.getVault().getCredentials() as VaultFileCredentials).getSlots()
+            .findRegularPasswordSlots();
+          const listener = new PasswordConfirmationListener(this.requireContext(), pinKeyboardPreference);
+          const task = new PasswordSlotDecryptTask(this.requireContext(),
+            (result: PasswordSlotDecryptResult | null, e: Error | null) => listener.onTaskFinished(result));
+          task.execute(slots, password);
+        } else {
+          pinKeyboardPreference.setChecked(false);
+          showPinKeyboardErrorDialog(this.requireContext(), $r('app.string.pin_keyboard_error_description'));
+        }
+      }, () => {
+        pinKeyboardPreference.setChecked(false);
+      }, $r('app.string.pin_keyboard_description'), $r('app.string.set_password_confirm'));
+      return false;
+    });
+
+    const autoLockPreference = fragment.requirePreference<Preference>('pref_auto_lock');
+    this._autoLockPreference = autoLockPreference;
+    autoLockPreference.setSummary(this.getAutoLockSummary());
+    autoLockPreference.setOnPreferenceClickListener((preference: Preference) => {
+      const items = Preferences.AUTO_LOCK_SETTINGS;
+      const textItems = getStringArray('pref_auto_lock_types');
+      const checkedItems: boolean[] = [];
+      for (let i = 0; i < items.length; i++) {
+        checkedItems.push(this._prefs.isAutoLockTypeEnabled(items[i]));
+      }
+
+      PreferenceDialogs.showMultiChoiceDialog(this.requireContext(), $r('app.string.pref_auto_lock_prompt'), textItems,
+        checkedItems, false, (checked: boolean[]) => {
+          let autoLock = Preferences.AUTO_LOCK_OFF;
+          for (let i = 0; i < checked.length; i++) {
+            if (checked[i]) {
+              autoLock |= items[i];
+            }
+          }
+
+          this._prefs.setAutoLockMask(autoLock);
+          autoLockPreference.setSummary(this.getAutoLockSummary());
+        });
+
+      return false;
+    });
+
+    const passwordReminderPreference = fragment.requirePreference<Preference>('pref_password_reminder_freq');
+    this._passwordReminderPreference = passwordReminderPreference;
+    passwordReminderPreference.setSummary(this.getPasswordReminderSummary());
+    passwordReminderPreference.setOnPreferenceClickListener((preference: Preference) => {
+      const currFreq = this._prefs.getPasswordReminderFrequency();
+      const items: PassReminderFreq[] = [PassReminderFreq.NEVER, PassReminderFreq.WEEKLY, PassReminderFreq.BIWEEKLY,
+        PassReminderFreq.MONTHLY, PassReminderFreq.QUARTERLY];
+      const textItems = items.map((f: PassReminderFreq) =>
+        ResUtils.getStringRes(AegisModule.getContext(), PassReminderFreqUtils.getStringRes(f)));
+
+      Dialogs.showSingleChoiceDialog(this.requireContext(), $r('app.string.pref_password_reminder_title'), textItems,
+        currFreq as number, (i: number) => {
+          const freq = PassReminderFreqUtils.fromInteger(i);
+          this._prefs.setPasswordReminderFrequency(freq);
+          passwordReminderPreference.setSummary(this.getPasswordReminderSummary());
+        }, true);
+      return false;
+    });
+
+    this._backupPasswordPreference = fragment.requirePreference<SwitchPreference>('pref_backup_password');
+    this._backupPasswordPreference.setOnPreferenceChangeListener((preference: Preference, newValue: Object) => {
+      if (!this._vaultManager.getVault().isBackupPasswordSet()) {
+        Dialogs.showSetPasswordDialog(this.requireContext(), new SetBackupPasswordListener(fragment, update));
+      } else {
+        const creds = this._vaultManager.getVault().getCredentials() as VaultFileCredentials;
+        const slots = creds.getSlots();
+        for (const slot of slots.findBackupPasswordSlots()) {
+          slots.remove(slot);
+        }
+        this._vaultManager.getVault().setCredentials(creds);
+
+        fragment.saveAndBackupVault();
+        this.updateEncryptionPreferences();
+      }
+
+      return false;
+    });
+
+    this._backupPasswordChangePreference = fragment.requirePreference<Preference>('pref_backup_password_change');
+    this._backupPasswordChangePreference.setOnPreferenceClickListener((preference: Preference) => {
+      Dialogs.showSetPasswordDialog(this.requireContext(), new SetBackupPasswordListener(fragment, update));
+      return false;
+    });
+
+    this.updateEncryptionPreferences();
+  }
+
+  private disableEncryption(): void {
+    this._vaultManager.disableEncryption().then(() => {
+      this._prefs.setIsBackupsEnabled(false);
+      this._prefs.setIsAndroidBackupsEnabled(false);
+      this.updateEncryptionPreferences();
+    }).catch((e: Error) => {
+      Dialogs.showErrorDialog(this.requireContext(), $r('app.string.disable_encryption_error'), e);
+    });
+  }
+
+  private updateEncryptionPreferences(): void {
+    if (this._encryptionPreference === null || this._setPasswordPreference === null
+      || this._biometricsPreference === null || this._autoLockPreference === null
+      || this._pinKeyboardPreference === null || this._backupPasswordPreference === null
+      || this._backupPasswordChangePreference === null || this._passwordReminderPreference === null
+      || !this._vaultManager.isVaultLoaded()) {
+      return;
+    }
+
+    const encrypted = this._vaultManager.getVault().isEncryptionEnabled();
+    const backupPasswordSet = this._vaultManager.getVault().isBackupPasswordSet();
+    this._encryptionPreference.setChecked(encrypted, true);
+    this._setPasswordPreference.setVisible(encrypted);
+    this._biometricsPreference.setVisible(encrypted);
+    this._autoLockPreference.setVisible(encrypted);
+    this._pinKeyboardPreference.setVisible(encrypted);
+    const backupPasswordCategory: PreferenceCategory | null = this._backupPasswordPreference.getParent();
+    if (backupPasswordCategory !== null) {
+      backupPasswordCategory.setVisible(encrypted);
+    }
+    this._backupPasswordPreference.setChecked(backupPasswordSet, true);
+    this._backupPasswordChangePreference.setVisible(backupPasswordSet);
+
+    if (encrypted) {
+      const slots = (this._vaultManager.getVault().getCredentials() as VaultFileCredentials).getSlots();
+      const multiBackupPassword = slots.findBackupPasswordSlots().length > 1;
+      const multiPassword = slots.findRegularPasswordSlots().length > 1;
+      const multiBio = slots.getBiometricSlots().length > 1;
+      const canUseBio = BiometricsHelper.isAvailable();
+      this._setPasswordPreference.setEnabled(!multiPassword);
+      this._biometricsPreference.setEnabled(canUseBio && !multiBio);
+      this._biometricsPreference.setChecked(slots.hasBiometricSlot(), true);
+      this._passwordReminderPreference.setVisible(slots.hasBiometricSlot());
+      this._backupPasswordChangePreference.setEnabled(!multiBackupPassword);
+    } else {
+      this._setPasswordPreference.setEnabled(false);
+      this._biometricsPreference.setEnabled(false);
+      this._biometricsPreference.setChecked(false, true);
+      this._passwordReminderPreference.setVisible(false);
+      this._backupPasswordChangePreference.setEnabled(false);
+    }
+  }
+
+  private getPasswordReminderSummary(): string {
+    const freq = this._prefs.getPasswordReminderFrequency();
+    if (freq === PassReminderFreq.NEVER) {
+      return getString('pref_password_reminder_summary_disabled');
+    }
+
+    const freqString = ResUtils.getStringRes(AegisModule.getContext(), PassReminderFreqUtils.getStringRes(freq))
+      .toLowerCase();
+    return getString('pref_password_reminder_summary', [freqString]);
+  }
+
+  private getAutoLockSummary(): string {
+    const settings = Preferences.AUTO_LOCK_SETTINGS;
+    const descriptions = getStringArray('pref_auto_lock_types');
+
+    let builder = '';
+    for (let i = 0; i < settings.length; i++) {
+      if (this._prefs.isAutoLockTypeEnabled(settings[i])) {
+        if (builder.length !== 0) {
+          builder += ', ';
+        }
+
+        builder += descriptions[i].toLowerCase();
+      }
+    }
+
+    if (builder.length === 0) {
+      return getString('pref_auto_lock_summary_disabled');
+    }
+
+    return getString('pref_auto_lock_summary', [builder]);
+  }
+
+  private getScreen(): PreferenceScreen {
+    return this.requireFragment().getPreferenceScreen();
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.pref_section_security_title'),
+        backgroundColorValue: ThemeHelper.isAmoled() ? '#000000' : $r('app.color.theme_surface'),
+        onBack: () => {
+          if (this._activity !== null) {
+            this._activity.finish();
+          }
+        }
+      })
+      if (this._fragment !== null) {
+        PreferenceScreenView({ screenProvider: () => this.getScreen(), tick: this.tick })
+      }
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
