+/**
+ * Port of com.amulyakhare.textdrawable.TextDrawable: a round shape with a letter in the middle.
+ */
+@Component
+export struct TextDrawable {
+  @Prop text: string = '';
+  @Prop color: number = 0xFF616161;
+  @Prop drawableSize: number = 40;
+  @Prop round: boolean = true;
+
+  build() {
+    Stack() {
+      Text(this.text)
+        .fontSize(this.drawableSize * 0.45)
+        .fontColor(Color.White)
+        .fontWeight(FontWeight.Medium)
+    }
+    .width(this.drawableSize)
+    .height(this.drawableSize)
+    .borderRadius(this.round ? this.drawableSize / 2 : 4)
+    .backgroundColor(this.color)
+  }
+}
diff --git a/entry/src/main/ets/textdrawable/util/ColorGenerator.ets b/entry/src/main/ets/textdrawable/util/ColorGenerator.ets
new file mode 100644
index 0000000..dfb3990
--- /dev/null
+++ b/entry/src/main/ets/textdrawable/util/ColorGenerator.ets
@@ -0,0 +1,41 @@
+/**
+ * Port of com.amulyakhare.textdrawable.util.ColorGenerator
+ */
+export class ColorGenerator {
+  static readonly DEFAULT: ColorGenerator = ColorGenerator.create([
+    0xfff16364, 0xfff58559, 0xfff9a43e, 0xffe4c62e, 0xff67bf74, 0xff59a2be, 0xff2093cd, 0xffad62a7, 0xff805781
+  ]);
+  static readonly MATERIAL: ColorGenerator = ColorGenerator.create([
+    0xffe57373, 0xfff06292, 0xffba68c8, 0xff9575cd, 0xff7986cb, 0xff64b5f6, 0xff4fc3f7, 0xff4dd0e1, 0xff4db6ac,
+    0xff81c784, 0xffaed581, 0xffff8a65, 0xffd4e157, 0xffffd54f, 0xffffb74d, 0xffa1887f, 0xff90a4ae
+  ]);
+
+  private readonly _colors: number[];
+
+  static create(colorList: number[]): ColorGenerator {
+    return new ColorGenerator(colorList);
+  }
+
+  private constructor(colorList: number[]) {
+    this._colors = colorList;
+  }
+
+  getRandomColor(): number {
+    return this._colors[Math.floor(Math.random() * this._colors.length)];
+  }
+
+  /**
+   * Java String.hashCode()
+   */
+  static hashCode(key: string): number {
+    let h = 0;
+    for (let i = 0; i < key.length; i++) {
+      h = (Math.imul(31, h) + key.charCodeAt(i)) | 0;
+    }
+    return h;
+  }
+
+  getColor(key: string): number {
+    return this._colors[Math.abs(ColorGenerator.hashCode(key)) % this._colors.length];
+  }
+}
