@@ -0,0 +1,104 @@
+import { util } from '@kit.ArkTS';
+
+/**
+ * Byte array helpers (replacement for java.util.Arrays / ByteBuffer / String(bytes, UTF_8)).
+ */
+export class Bytes {
+  private constructor() {
+  }
+
+  static fromUtf8(s: string): Uint8Array {
+    const encoder = new util.TextEncoder('utf-8');
+    return encoder.encodeInto(s);
+  }
+
+  static toUtf8(data: Uint8Array): string {
+    const decoder = util.TextDecoder.create('utf-8', { ignoreBOM: true });
+    return decoder.decodeToString(data, { stream: false });
+  }
+
+  static fromLatin1(s: string): Uint8Array {
+    const out = new Uint8Array(s.length);
+    for (let i = 0; i < s.length; i++) {
+      out[i] = s.charCodeAt(i) & 0xff;
+    }
+    return out;
+  }
+
+  static toLatin1(data: Uint8Array): string {
+    let s = '';
+    for (let i = 0; i < data.length; i++) {
+      s += String.fromCharCode(data[i]);
+    }
+    return s;
+  }
+
+  static concat(arrays: Uint8Array[]): Uint8Array {
+    let len = 0;
+    for (const a of arrays) {
+      len += a.length;
+    }
+    const out = new Uint8Array(len);
+    let off = 0;
+    for (const a of arrays) {
+      out.set(a, off);
+      off += a.length;
+    }
+    return out;
+  }
+
+  static copyOfRange(data: Uint8Array, from: number, to: number): Uint8Array {
+    const out = new Uint8Array(to - from);
+    out.set(data.subarray(from, Math.min(to, data.length)));
+    return out;
+  }
+
+  static copy(data: Uint8Array): Uint8Array {
+    return Bytes.copyOfRange(data, 0, data.length);
+  }
+
+  static equals(a: Uint8Array | null, b: Uint8Array | null): boolean {
+    if (a === b) {
+      return true;
+    }
+    if (a === null || b === null || a.length !== b.length) {
+      return false;
+    }
+    for (let i = 0; i < a.length; i++) {
+      if (a[i] !== b[i]) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  /**
+   * Encodes the given (non-negative) integer as a big endian 8 byte array.
+   */
+  static longToBytesBE(value: number): Uint8Array {
+    const out = new Uint8Array(8);
+    let v = BigInt(Math.floor(value));
+    for (let i = 7; i >= 0; i--) {
+      out[i] = Number(v & BigInt(0xff));
+      v = v >> BigInt(8);
+    }
+    return out;
+  }
+
+  static intToBytesBE(value: number): Uint8Array {
+    const out = new Uint8Array(4);
+    out[0] = (value >>> 24) & 0xff;
+    out[1] = (value >>> 16) & 0xff;
+    out[2] = (value >>> 8) & 0xff;
+    out[3] = value & 0xff;
+    return out;
+  }
+
+  static readIntBE(data: Uint8Array, offset: number): number {
+    return ((data[offset] << 24) | (data[offset + 1] << 16) | (data[offset + 2] << 8) | data[offset + 3]) >>> 0;
+  }
+
+  static fromNumbers(nums: number[]): Uint8Array {
+    return new Uint8Array(nums);
+  }
+}
diff --git a/entry/src/main/ets/util/ClipboardUtils.ets b/entry/src/main/ets/util/ClipboardUtils.ets
