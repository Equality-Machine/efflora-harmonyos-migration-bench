+  private doShortcutActions(): void {
+    const intent = IncomingIntent.getPending();
+    if (intent === null || intent.extraAction === null || !this._activity.getVaultManager().isVaultLoaded()) {
+      return;
+    }
+
+    switch (intent.extraAction) {
+      case LaunchScannerTileService.ACTION:
