diff --git a/entry/src/main/ets/icons/IconPackManager.ets b/entry/src/main/ets/icons/IconPackManager.ets
new file mode 100644
index 0000000..af22b75
--- /dev/null
+++ b/entry/src/main/ets/icons/IconPackManager.ets
@@ -0,0 +1,202 @@
+import { common } from '@kit.AbilityKit';
+import { fileIo } from '@kit.CoreFileKit';
+import { zlib } from '@kit.BasicServicesKit';
+import { IconPack } from './IconPack';
+import { IconPackException } from './IconPackException';
+import { IconPackExistsException } from './IconPackExistsException';
+import { IOUtils } from '../util/IOUtils';
+import { UUID } from '../util/UUID';
+
+export class IconPackManager {
+  private static readonly _packDefFilename: string = 'pack.json';
+
+  private _iconsBaseDir: string;
+  private _cacheDir: string;
+  private _iconPacks: IconPack[];
+
+  constructor(context: common.Context) {
+    this._iconPacks = [];
+    this._iconsBaseDir = `${context.filesDir}/icons`;
+    this._cacheDir = context.cacheDir;
+    this.rescanIconPacks();
+  }
+
+  private getIconPackByUUID(uuid: string): IconPack | null {
+    const packs = this._iconPacks.filter((i: IconPack) => i.getUUID() === uuid);
+    return packs.length === 0 ? null : packs[0];
+  }
+
+  hasIconPack(): boolean {
+    return this._iconPacks.length > 0;
+  }
+
+  getIconPacks(): IconPack[] {
+    return this._iconPacks.slice();
+  }
+
+  removeIconPack(pack: IconPack): void {
+    try {
+      const dir = this.getIconPackDir(pack);
+      IconPackManager.deleteDir(dir);
+      // remove the parent UUID directory if it's empty now
+      const parent = `${this._iconsBaseDir}/${pack.getUUID()}`;
+      if (IOUtils.exists(parent) && fileIo.listFileSync(parent).length === 0) {
+        fileIo.rmdirSync(parent);
+      }
+    } catch (e) {
+      throw new IconPackException((e as Error).message);
+    }
+    this._iconPacks = this._iconPacks.filter((p: IconPack) => !p.equals(pack));
+  }
+
+  /**
+   * Imports the icon pack ZIP file at the given path.
+   */
+  async importPack(inFile: string): Promise<IconPack> {
+    const tmpDir = `${this._cacheDir}/iconpack-${Date.now()}`;
+    try {
+      // extract the ZIP file to a temporary directory
+      IOUtils.mkdirs(tmpDir);
+      await zlib.decompressFile(inFile, tmpDir);
+
+      // read and parse the icon pack definition file of the icon pack
+      const defPath = `${tmpDir}/${IconPackManager._packDefFilename}`;
+      if (!IOUtils.exists(defPath)) {
+        throw new Error('Unable to find pack.json in the root of the ZIP file');
+      }
+      const defBytes = IOUtils.readFile(defPath);
+      const pack = IconPack.fromBytes(defBytes);
+
+      // create a new directory to store the icon pack, based on the UUID and version
+      const packDir = this.getIconPackDir(pack);
+      if (IOUtils.exists(packDir)) {
+        throw new IconPackExistsException(pack);
+      }
+
+      const existingPack = this.getIconPackByUUID(pack.getUUID());
+      if (existingPack !== null) {
+        throw new IconPackExistsException(existingPack);
+      }
+
+      IOUtils.mkdirs(packDir);
+
+      // copy each of the defined icons to the icon pack directory
+      for (const icon of pack.getIcons()) {
+        const rel = icon.getRelativeFilename();
+        if (rel.indexOf('..') >= 0 || rel.startsWith('/')) {
+          throw new Error('Attempted to write outside of the icon pack directory');
+        }
+        const src = `${tmpDir}/${rel}`;
+        if (!IOUtils.exists(src)) {
+          throw new Error(`Unable to find ${rel} relative to the root of the ZIP file`);
+        }
+        const destFile = `${packDir}/${rel}`;
+        const slash = destFile.lastIndexOf('/');
+        IOUtils.mkdirs(destFile.substring(0, slash));
+        IOUtils.copy(src, destFile);
+
+        // after successful copy of the icon, store the new filename
+        icon.setFile(destFile);
+      }
+
+      // write the icon pack definition file to the newly created directory
+      IOUtils.writeFile(`${packDir}/${IconPackManager._packDefFilename}`, defBytes);
+
+      // after successful extraction of the icon pack, store the new directory
+      pack.setDirectory(packDir);
+      this._iconPacks.push(pack);
+      return pack;
+    } catch (e) {
+      if (e instanceof IconPackException) {
+        throw e as IconPackException;
+      }
+      throw new IconPackException((e as Error).message);
+    } finally {
+      IOUtils.clearDirectory(tmpDir, true);
+    }
+  }
+
+  private rescanIconPacks(): void {
+    this._iconPacks = [];
+    if (!IOUtils.exists(this._iconsBaseDir)) {
+      return;
+    }
+    let dirs: string[] = [];
+    try {
+      dirs = fileIo.listFileSync(this._iconsBaseDir);
+    } catch (e) {
+      return;
+    }
+
+    for (const name of dirs) {
+      const dir = `${this._iconsBaseDir}/${name}`;
+      try {
+        if (!fileIo.statSync(dir).isDirectory()) {
+          continue;
+        }
+      } catch (e) {
+        continue;
+      }
+
+      if (!UUID.isValid(name)) {
+        continue;
+      }
+      const uuid = UUID.fromString(name);
+
+      const versionDir = IconPackManager.getLatestVersionDir(dir);
+      if (versionDir !== null) {
+        let pack: IconPack;
+        try {
+          const bytes = IOUtils.readFile(`${versionDir}/${IconPackManager._packDefFilename}`);
+          pack = IconPack.fromBytes(bytes);
+          pack.setDirectory(versionDir);
+        } catch (e) {
+          continue;
+        }
+
+        for (const icon of pack.getIcons()) {
+          icon.setFile(`${versionDir}/${icon.getRelativeFilename()}`);
+        }
+
+        // do a sanity check on the UUID and version
+        const versionName = versionDir.substring(versionDir.lastIndexOf('/') + 1);
+        if (pack.getUUID() === uuid && pack.getVersion() === Number.parseInt(versionName, 10)) {
+          this._iconPacks.push(pack);
+        }
+      }
+    }
+  }
+
+  private getIconPackDir(pack: IconPack): string {
+    return `${this._iconsBaseDir}/${pack.getUUID()}/${pack.getVersion()}`;
+  }
+
+  private static getLatestVersionDir(packDir: string): string | null {
+    let dirs: string[] = [];
+    try {
+      dirs = fileIo.listFileSync(packDir);
+    } catch (e) {
+      return null;
+    }
+
+    let latestVersion = -1;
+    for (const versionDir of dirs) {
+      if (!new RegExp('^\\d+$').test(versionDir)) {
+        continue;
+      }
+      const version = Number.parseInt(versionDir, 10);
+      if (latestVersion === -1 || version > latestVersion) {
+        latestVersion = version;
+      }
+    }
+
+    if (latestVersion === -1) {
+      return null;
+    }
+    return `${packDir}/${latestVersion}`;
+  }
+
+  private static deleteDir(dir: string): void {
+    IOUtils.clearDirectory(dir, true);
+  }
+}
diff --git a/entry/src/main/ets/icons/IconType.ets b/entry/src/main/ets/icons/IconType.ets
new file mode 100644
index 0000000..b4addec
--- /dev/null
+++ b/entry/src/main/ets/icons/IconType.ets
@@ -0,0 +1,62 @@
+export enum IconType {
+  INVALID = 0,
+  SVG = 1,
+  PNG = 2,
+  JPEG = 3
+}
+
+export class IconTypeUtils {
+  static fromMimeType(mimeType: string): IconType {
+    switch (mimeType) {
+      case 'image/svg+xml':
+        return IconType.SVG;
+      case 'image/png':
+        return IconType.PNG;
+      case 'image/jpeg':
+        return IconType.JPEG;
+      default:
+        return IconType.INVALID;
+    }
+  }
+
+  static fromFilename(filename: string): IconType {
+    const dot = filename.lastIndexOf('.');
+    const ext = dot >= 0 ? filename.substring(dot + 1).toLowerCase() : '';
+    switch (ext) {
+      case 'svg':
+        return IconType.SVG;
+      case 'png':
+        return IconType.PNG;
+      case 'jpg':
+      // intentional fallthrough
+      case 'jpeg':
+        return IconType.JPEG;
+      default:
+        return IconType.INVALID;
+    }
+  }
+
+  static toMimeType(type: IconType): string {
+    switch (type) {
+      case IconType.SVG:
+        return 'image/svg+xml';
+      case IconType.PNG:
+        return 'image/png';
+      case IconType.JPEG:
+        return 'image/jpeg';
+      default:
+        throw new Error(`Can't convert icon type ${type} to MIME type`);
+    }
+  }
+
+  static toExtension(type: IconType): string {
+    switch (type) {
+      case IconType.SVG:
+        return 'svg';
+      case IconType.PNG:
+        return 'png';
+      default:
+        return 'jpg';
+    }
+  }
+}
diff --git a/entry/src/main/ets/importers/AegisImporter.ets b/entry/src/main/ets/importers/AegisImporter.ets
new file mode 100644
index 0000000..c5881f0
--- /dev/null
+++ b/entry/src/main/ets/importers/AegisImporter.ets
@@ -0,0 +1,176 @@
+import { common } from '@kit.AbilityKit';
+import {
+  DatabaseImporter, DatabaseImporterResult, DatabaseImporterState, DecryptListener
+} from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { Dialogs } from '../ui/dialogs/Dialogs';
+import { PasswordSlotDecryptResult, PasswordSlotDecryptTask } from '../ui/tasks/PasswordSlotDecryptTask';
+import { JSONObject } from '../util/JSONObject';
+import { VaultEntry } from '../vault/VaultEntry';
+import { VaultFile } from '../vault/VaultFile';
+import { VaultFileCredentials } from '../vault/VaultFileCredentials';
+import { VaultGroup } from '../vault/VaultGroup';
+import { PasswordSlot } from '../vault/slots/PasswordSlot';
+import { SlotList } from '../vault/slots/SlotList';
+
+export class AegisImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    throw new DatabaseImporterException('Unsupported operation');
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    try {
+      const file = VaultFile.fromBytes(stream);
+      if (file.isEncrypted()) {
+        return new AegisImporterEncryptedState(file);
+      }
+      return new AegisImporterDecryptedState(file.getContent());
+    } catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+}
+
+export class AegisImporterEncryptedState extends DatabaseImporterState {
+  private _file: VaultFile;
+
+  constructor(file: VaultFile) {
+    super(true);
+    this._file = file;
+  }
+
+  getSlots(): SlotList {
+    return this._file.getHeader().getSlots();
+  }
+
+  decryptWithCredentials(creds: VaultFileCredentials): AegisImporterDecryptedState {
+    let obj: JSONObject;
+    try {
+      obj = this._file.getContentDecrypted(creds);
+    } catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+
+    return new AegisImporterDecryptedState(obj, creds);
+  }
+
+  async decryptWithPassword(password: string): Promise<AegisImporterDecryptedState> {
+    const slots: PasswordSlot[] = this.getSlots().getPasswordSlots();
+    const result = await PasswordSlotDecryptTask.decrypt(slots, password);
+    if (result === null) {
+      throw new DatabaseImporterException('Password incorrect');
+    }
+    const creds = new VaultFileCredentials(result.getKey(), this.getSlots());
+    return this.decryptWithCredentials(creds);
+  }
+
+  /**
+   * Asks for the password and tries to decrypt the master key with it using the password slots of the
+   * vault. Biometric slots can't be used for imported files.
+   */
+  decrypt(uiContext: UIContext, listener: DecryptListener): void {
+    Dialogs.showPasswordInputDialog(uiContext, (password: string) => {
+      const slots: PasswordSlot[] = this.getSlots().getPasswordSlots();
+      const task = new PasswordSlotDecryptTask(uiContext, (result: PasswordSlotDecryptResult | null, error: Error | null) => {
+        try {
+          if (error !== null) {
+            throw new DatabaseImporterException(error.message);
+          }
+          if (result === null) {
+            throw new DatabaseImporterException('Password incorrect');
+          }
+
+          const creds = new VaultFileCredentials(result.getKey(), this.getSlots());
+          const state = this.decryptWithCredentials(creds);
+          listener.onStateDecrypted(state);
+        } catch (e) {
+          listener.onError(e as Error);
+        }
+      });
+      task.execute(slots, password);
+    }, () => listener.onCanceled(), undefined, $r('app.string.enter_password_aegis_title'));
+  }
+}
+
+export class AegisImporterDecryptedState extends DatabaseImporterState {
+  private _obj: JSONObject;
+  private _creds: VaultFileCredentials | null;
+
+  constructor(obj: JSONObject, creds?: VaultFileCredentials | null) {
+    super(false);
+    this._obj = obj;
+    this._creds = creds !== undefined ? creds : null;
+  }
+
+  getCredentials(): VaultFileCredentials | null {
+    return this._creds;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+
+    try {
+      if (this._obj.has('groups')) {
+        const groupArray = this._obj.getJSONArray('groups');
+        for (let i = 0; i < groupArray.length(); i++) {
+          const groupObj = groupArray.getJSONObject(i);
+          try {
+            const group = AegisImporterDecryptedState.convertGroup(groupObj);
+            if (!result.getGroups().has(group)) {
+              result.addGroup(group);
+            }
+          } catch (e) {
+            if (!(e instanceof DatabaseImporterEntryException)) {
+              throw e as Error;
+            }
+            result.addError(e);
+          }
+        }
+      }
+
+      const entryArray = this._obj.getJSONArray('entries');
+      for (let i = 0; i < entryArray.length(); i++) {
+        const entryObj = entryArray.getJSONObject(i);
+        try {
+          const entry = AegisImporterDecryptedState.convertEntry(entryObj);
+          for (const groupUuid of Array.from(entry.getGroups())) {
+            if (!result.getGroups().hasUUID(groupUuid)) {
+              entry.getGroups().delete(groupUuid);
+            }
+          }
+          result.addEntry(entry);
+        } catch (e) {
+          if (!(e instanceof DatabaseImporterEntryException)) {
+            throw e as Error;
+          }
+          result.addError(e);
+        }
+      }
+    } catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+
+    return result;
+  }
+
+  private static convertEntry(obj: JSONObject): VaultEntry {
+    try {
+      return VaultEntry.fromJson(obj);
+    } catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, obj.toString());
+    }
+  }
+
+  private static convertGroup(obj: JSONObject): VaultGroup {
+    try {
+      return VaultGroup.fromJson(obj);
+    } catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, obj.toString());
+    }
+  }
+}
diff --git a/entry/src/main/ets/importers/AndOtpImporter.ets b/entry/src/main/ets/importers/AndOtpImporter.ets
new file mode 100644
index 0000000..656867a
--- /dev/null
+++ b/entry/src/main/ets/importers/AndOtpImporter.ets
@@ -0,0 +1,241 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState, DecryptListener } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { CryptoUtils, SecretKey } from '../crypto/CryptoUtils';
+import { CryptParameters } from '../crypto/CryptParameters';
+import { Base32 } from '../encoding/Base32';
+import { HotpInfo } from '../otp/HotpInfo';
+import { OtpInfo } from '../otp/OtpInfo';
+import { SteamInfo } from '../otp/SteamInfo';
+import { TotpInfo } from '../otp/TotpInfo';
+import { Dialogs } from '../ui/dialogs/Dialogs';
+import { PBKDFTask, PBKDFTaskParams } from '../ui/tasks/PBKDFTask';
+import { JSONArray, JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+import { ResUtils } from '../util/ResUtils';
+import { VaultEntry } from '../vault/VaultEntry';
+import { AegisModule } from '../AegisModule';
+
+const INT_SIZE: number = 4;
+
+const NONCE_SIZE: number = 12;
+
+const TAG_SIZE: number = 16;
+
+const SALT_SIZE: number = 12;
+
+const KEY_SIZE: number = 256; // bits
+
+/**
+ * Splits like Java's String.split(): trailing empty strings are removed.
+ */
+function javaSplit(s: string, separator: string): string[] {
+  const parts = s.split(separator);
+  while (parts.length > 1 && parts[parts.length - 1].length === 0) {
+    parts.pop();
+  }
+
+  return parts;
+}
+
+export class AndOtpImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    throw new DatabaseImporterException('Unsupported operation');
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    const bytes = Bytes.copy(stream);
+    try {
+      return AndOtpImporter.readBytes(bytes);
+    }
+    catch (e) {
+      // andOTP doesn't have a proper way to indicate whether a file is encrypted
+      // so, if we can't parse it as JSON, we'll have to assume it is
+      return new AndOtpImporterEncryptedState(bytes);
+    }
+  }
+
+  static readBytes(bytes: Uint8Array): AndOtpImporterDecryptedState {
+    const array = new JSONArray(Bytes.toUtf8(bytes));
+    return new AndOtpImporterDecryptedState(array);
+  }
+}
+
+export class AndOtpImporterEncryptedState extends DatabaseImporterState {
+  private _data: Uint8Array;
+
+  constructor(data: Uint8Array) {
+    super(true);
+    this._data = data;
+  }
+
+  private decryptContent(key: SecretKey, offset: number): AndOtpImporterDecryptedState {
+    if (this._data.length < offset + NONCE_SIZE + TAG_SIZE) {
+      throw new DatabaseImporterException('File is too short to be an encrypted andOTP backup');
+    }
+    const nonce = Bytes.copyOfRange(this._data, offset, offset + NONCE_SIZE);
+    const tag = Bytes.copyOfRange(this._data, this._data.length - TAG_SIZE, this._data.length);
+    const params = new CryptParameters(nonce, tag);
+    try {
+      const encrypted = Bytes.copyOfRange(this._data, offset + NONCE_SIZE, this._data.length - TAG_SIZE);
+      const result = CryptoUtils.decrypt(encrypted, key, params);
+      return AndOtpImporter.readBytes(result.getData());
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  private getKeyDerivationParams(password: string): PBKDFTaskParams {
+    if (this._data.length < INT_SIZE + SALT_SIZE) {
+      throw new DatabaseImporterException('File is too short to be an encrypted andOTP backup');
+    }
+    const iterations = Bytes.readIntBE(this._data, 0) | 0;
+    if (iterations < 1) {
+      throw new DatabaseImporterException(`Invalid number of iterations for PBKDF: ${iterations}`);
+    }
+    // If number of iterations is this high, it's probably not an andOTP file, so
+    // abort early in order to prevent having to wait for an extremely long key derivation
+    // process, only to find out that the user picked the wrong file
+    if (iterations > 10000000) {
+      throw new DatabaseImporterException(`Unexpectedly high number of iterations: ${iterations}`);
+    }
+    const salt = Bytes.copyOfRange(this._data, INT_SIZE, INT_SIZE + SALT_SIZE);
+    return new PBKDFTaskParams('PBKDF2WithHmacSHA1', KEY_SIZE, password, salt, iterations);
+  }
+
+  decryptOldFormat(password: string): AndOtpImporterDecryptedState {
+    // WARNING: DON'T DO THIS IN YOUR OWN CODE
+    // this exists solely to support the old andOTP backup format
+    // it is not a secure way to derive a key from a password
+    const keyBytes = CryptoUtils.digest('SHA256', CryptoUtils.toBytes(password));
+    const key = new SecretKey(keyBytes);
+    return this.decryptContent(key, 0);
+  }
+
+  decryptNewFormat(key: SecretKey): AndOtpImporterDecryptedState {
+    return this.decryptContent(key, INT_SIZE + SALT_SIZE);
+  }
+
+  async decryptNewFormatWithPassword(password: string): Promise<AndOtpImporterDecryptedState> {
+    const params = this.getKeyDerivationParams(password);
+    const key = await PBKDFTask.deriveKey(params);
+    return this.decryptNewFormat(key);
+  }
+
+  private decryptWithFormat(uiContext: UIContext, password: string, oldFormat: boolean, listener: DecryptListener): void {
+    if (oldFormat) {
+      const state = this.decryptOldFormat(password);
+      listener.onStateDecrypted(state);
+    }
+    else {
+      const params = this.getKeyDerivationParams(password);
+      const task = new PBKDFTask(uiContext, (key: SecretKey) => {
+        try {
+          const state = this.decryptNewFormat(key);
+          listener.onStateDecrypted(state);
+        }
+        catch (e) {
+          listener.onError(e as Error);
+        }
+      }, (e: Error) => listener.onError(e));
+      task.execute(params);
+    }
+  }
+
+  decrypt(uiContext: UIContext, listener: DecryptListener): void {
+    const context = AegisModule.getContext();
+    const choices: string[] = [
+      ResUtils.getString(context, 'andotp_new_format'),
+      ResUtils.getString(context, 'andotp_old_format')
+    ];
+    Dialogs.showSingleChoiceDialog(uiContext, $r('app.string.choose_andotp_importer'), choices, 0, (i: number) => {
+      Dialogs.showPasswordInputDialog(uiContext, (password: string) => {
+        try {
+          this.decryptWithFormat(uiContext, password, i !== 0, listener);
+        }
+        catch (e) {
+          listener.onError(e as Error);
+        }
+      }, () => listener.onCanceled());
+    });
+  }
+}
+
+export class AndOtpImporterDecryptedState extends DatabaseImporterState {
+  private _obj: JSONArray;
+
+  constructor(obj: JSONArray) {
+    super(false);
+    this._obj = obj;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    for (let i = 0; i < this._obj.length(); i++) {
+      let obj: JSONObject;
+      try {
+        obj = this._obj.getJSONObject(i);
+      }
+      catch (e) {
+        throw new DatabaseImporterException((e as Error).message);
+      }
+      try {
+        const entry = AndOtpImporterDecryptedState.convertEntry(obj);
+        result.addEntry(entry);
+      }
+      catch (e) {
+        result.addError(e as DatabaseImporterEntryException);
+      }
+    }
+    return result;
+  }
+
+  private static convertEntry(obj: JSONObject): VaultEntry {
+    try {
+      const type = obj.getString('type').toLowerCase();
+      const algo = obj.getString('algorithm');
+      const digits = obj.getInt('digits');
+      const secret = Base32.decode(obj.getString('secret'));
+      let info: OtpInfo;
+      switch (type) {
+        case 'hotp':
+          info = new HotpInfo(secret, algo, digits, obj.getLong('counter'));
+          break;
+        case 'totp':
+          info = new TotpInfo(secret, algo, digits, obj.getInt('period'));
+          break;
+        case 'steam':
+          info = new SteamInfo(secret, algo, digits, obj.optInt('period', TotpInfo.DEFAULT_PERIOD));
+          break;
+        default:
+          throw new DatabaseImporterException('unsupported otp type: ' + type);
+      }
+      let name: string;
+      let issuer = '';
+      if (obj.has('issuer')) {
+        name = obj.getString('label');
+        issuer = obj.getString('issuer');
+      }
+      else {
+        const parts = javaSplit(obj.getString('label'), ' - ');
+        if (parts.length > 1) {
+          issuer = parts[0];
+          name = parts[1];
+        }
+        else {
+          name = parts[0];
+        }
+      }
+      return new VaultEntry(info, name, issuer);
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, obj.toString());
+    }
+  }
+}
