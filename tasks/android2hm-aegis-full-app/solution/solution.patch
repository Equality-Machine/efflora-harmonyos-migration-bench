diff --git a/entry/src/main/ets/ui/glide/VaultEntryIconLoader.ets b/entry/src/main/ets/ui/glide/VaultEntryIconLoader.ets
new file mode 100644
index 0000000..01767c4
--- /dev/null
+++ b/entry/src/main/ets/ui/glide/VaultEntryIconLoader.ets
@@ -0,0 +1,81 @@
+import { image } from '@kit.ImageKit';
+import { VaultEntryIcon } from '../../vault/VaultEntryIcon';
+import { IOUtils } from '../../util/IOUtils';
+import { IconType } from '../../icons/IconType';
+import { SvgBytesDecoder } from './SvgDecoder';
+
+/**
+ * Port of the Glide model loader for vault entry icons: decodes the icon bytes into a PixelMap
+ * that is cached in memory (keyed by the hash of the icon, see VaultEntryIconKey). Icons are never
+ * written to disk.
+ */
+export class VaultEntryIconLoader {
+  private static _icons: Map<string, VaultEntryIcon> = new Map<string, VaultEntryIcon>();
+  private static _cache: Map<string, image.PixelMap> = new Map<string, image.PixelMap>();
+  private static readonly MAX_CACHE: number = 200;
+
+  /**
+   * Makes the given icon available to EntryIconView components through its key.
+   */
+  static register(icon: VaultEntryIcon | null): string {
+    if (icon === null) {
+      return '';
+    }
+    const key = icon.getHashString();
+    VaultEntryIconLoader._icons.set(key, icon);
+    return key;
+  }
+
+  static getIcon(key: string): VaultEntryIcon | null {
+    const icon = VaultEntryIconLoader._icons.get(key);
+    return icon !== undefined ? icon : null;
+  }
+
+  static async load(key: string, size: number): Promise<image.PixelMap | null> {
+    const cached = VaultEntryIconLoader._cache.get(key);
+    if (cached !== undefined) {
+      return cached;
+    }
+    const icon = VaultEntryIconLoader._icons.get(key);
+    if (icon === undefined) {
+      return null;
+    }
+    const pm = icon.getType() === IconType.SVG ? await SvgBytesDecoder.decode(icon.getBytes(), size) :
+      await VaultEntryIconLoader.decode(icon.getBytes(), size);
+    if (pm !== null) {
+      if (VaultEntryIconLoader._cache.size >= VaultEntryIconLoader.MAX_CACHE) {
+        VaultEntryIconLoader._cache.clear();
+      }
+      VaultEntryIconLoader._cache.set(key, pm);
+    }
+    return pm;
+  }
+
+  static async decode(bytes: Uint8Array, size: number): Promise<image.PixelMap | null> {
+    try {
+      const buf = bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength);
+      const source = image.createImageSource(buf);
+      try {
+        const opts: image.DecodingOptions = size > 0 ? { desiredSize: { width: size, height: size } } : {};
+        return await source.createPixelMap(opts);
+      } finally {
+        source.release();
+      }
+    } catch (e) {
+      return null;
+    }
+  }
+
+  static async decodeFile(path: string, size: number): Promise<image.PixelMap | null> {
+    try {
+      return await VaultEntryIconLoader.decode(IOUtils.readFile(path), size);
+    } catch (e) {
+      return null;
+    }
+  }
+
+  static clear(): void {
+    VaultEntryIconLoader._cache.clear();
+    VaultEntryIconLoader._icons.clear();
+  }
+}
