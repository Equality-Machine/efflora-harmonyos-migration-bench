+        return attr.value;
+      }
+    }
+    return null;
+  }
+
+  getPositionDescription(): string {
+    const before = this._src.substring(0, this._pos);
+    const line = before.split('\n').length;
+    return `${XmlPullParser.typeName(this._eventType)} ${this._name !== null ? this._name : ''} @${line}`;
+  }
