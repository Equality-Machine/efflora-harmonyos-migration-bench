@@ -0,0 +1,50 @@
+export enum PassReminderFreq {
+  NEVER = 0,
+  WEEKLY = 1,
+  BIWEEKLY = 2,
+  MONTHLY = 3,
+  QUARTERLY = 4
+}
+
+export class PassReminderFreqUtils {
+  static getDurationMillis(freq: PassReminderFreq): number {
+    let weeks: number;
+    switch (freq) {
+      case PassReminderFreq.WEEKLY:
+        weeks = 1;
+        break;
+      case PassReminderFreq.BIWEEKLY:
+        weeks = 2;
+        break;
+      case PassReminderFreq.MONTHLY:
+        weeks = 4;
+        break;
+      case PassReminderFreq.QUARTERLY:
+        weeks = 13;
+        break;
+      default:
+        weeks = 0;
+        break;
+    }
+    return weeks * 7 * 24 * 60 * 60 * 1000;
+  }
+
+  static getStringRes(freq: PassReminderFreq): Resource {
+    switch (freq) {
+      case PassReminderFreq.WEEKLY:
+        return $r('app.string.password_reminder_freq_weekly');
+      case PassReminderFreq.BIWEEKLY:
+        return $r('app.string.password_reminder_freq_biweekly');
+      case PassReminderFreq.MONTHLY:
+        return $r('app.string.password_reminder_freq_monthly');
+      case PassReminderFreq.QUARTERLY:
+        return $r('app.string.password_reminder_freq_quarterly');
+      default:
+        return $r('app.string.password_reminder_freq_never');
+    }
+  }
+
+  static fromInteger(i: number): PassReminderFreq {
+    return i >= 0 && i <= 4 ? i as PassReminderFreq : PassReminderFreq.BIWEEKLY;
+  }
+}
diff --git a/entry/src/main/ets/Preferences.ets b/entry/src/main/ets/Preferences.ets
new file mode 100644
index 0000000..c05a8bf
--- /dev/null
+++ b/entry/src/main/ets/Preferences.ets
@@ -0,0 +1,738 @@
+import { preferences } from '@kit.ArkData';
+import { common } from '@kit.AbilityKit';
+import { i18n } from '@kit.LocalizationKit';
+import { PassReminderFreq, PassReminderFreqUtils } from './PassReminderFreq';
+import { SortCategory, SortCategoryUtils } from './SortCategory';
+import { Theme, ThemeUtils } from './Theme';
+import { ViewMode, ViewModeUtils } from './ViewMode';
+import { AccountNamePosition, AccountNamePositionUtils } from './AccountNamePosition';
+import { CopyBehavior, CopyBehaviorUtils } from './CopyBehavior';
+import { BackupsVersioningStrategy } from './BackupsVersioningStrategy';
+import { JSONArray, JSONObject } from './util/JSONObject';
+import { JsonUtils } from './util/JsonUtils';
+import { TimeUtils } from './util/TimeUtils';
+import { VaultBackupPermissionException } from './vault/VaultBackupPermissionException';
+
+export enum CodeGrouping {
+  HALVES = -1,
+  NO_GROUPING = -2,
+  GROUPING_TWOS = 2,
+  GROUPING_THREES = 3,
+  GROUPING_FOURS = 4
+}
+
+export class CodeGroupingUtils {
+  static readonly NAMES: string[] = ['HALVES', 'NO_GROUPING', 'GROUPING_TWOS', 'GROUPING_THREES', 'GROUPING_FOURS'];
+  static readonly VALUES: CodeGrouping[] = [CodeGrouping.HALVES, CodeGrouping.NO_GROUPING, CodeGrouping.GROUPING_TWOS,
+    CodeGrouping.GROUPING_THREES, CodeGrouping.GROUPING_FOURS];
+
+  static valueOf(name: string): CodeGrouping {
+    const i = CodeGroupingUtils.NAMES.indexOf(name);
+    return i >= 0 ? CodeGroupingUtils.VALUES[i] : CodeGrouping.GROUPING_THREES;
+  }
+
+  static nameOf(g: CodeGrouping): string {
+    const i = CodeGroupingUtils.VALUES.indexOf(g);
+    return i >= 0 ? CodeGroupingUtils.NAMES[i] : 'GROUPING_THREES';
+  }
+
+  static getValue(g: CodeGrouping): number {
+    return g as number;
+  }
+}
+
+export class BackupResult {
+  private readonly _time: Date;
+  private _isBuiltIn: boolean = false;
+  private readonly _error: string | null;
+  private readonly _isPermissionError: boolean;
+
+  constructor(time: Date, error: string | null, isPermissionError: boolean) {
+    this._time = time;
+    this._error = error;
+    this._isPermissionError = isPermissionError;
+  }
+
+  static fromException(e: Error | null): BackupResult {
+    return new BackupResult(new Date(), e === null ? null : `${e.name}: ${e.message}`, e instanceof VaultBackupPermissionException);
+  }
+
+  getError(): string | null {
+    return this._error;
+  }
+
+  isSuccessful(): boolean {
+    return this._error === null;
+  }
+
+  getTime(): Date {
+    return this._time;
+  }
+
+  getElapsedSince(context: common.Context): string {
+    return TimeUtils.getElapsedSince(context, this._time);
+  }
+
+  isBuiltIn(): boolean {
+    return this._isBuiltIn;
+  }
+
+  setIsBuiltIn(isBuiltIn: boolean): void {
+    this._isBuiltIn = isBuiltIn;
+  }
+
+  isPermissionError(): boolean {
+    return this._isPermissionError;
+  }
+
+  toJson(): string {
+    const obj = new JSONObject();
+    obj.put('time', this._time.getTime());
+    obj.put('error', this._error === null ? null : this._error);
+    obj.put('isPermissionError', this._isPermissionError);
+    return obj.toString();
+  }
+
+  static fromJson(json: string): BackupResult {
+    const obj = new JSONObject(json);
+    const time = obj.getLong('time');
+    const error = JsonUtils.optString(obj, 'error');
+    const isPermissionError = obj.optBoolean('isPermissionError', false);
+    return new BackupResult(new Date(time), error, isPermissionError);
+  }
+}
+
+/**
+ * Port of the SharedPreferences backed Preferences class, on top of @ohos.data.preferences.
+ */
+export class Preferences {
+  static readonly AUTO_LOCK_OFF: number = 1 << 0;
+  static readonly AUTO_LOCK_ON_BACK_BUTTON: number = 1 << 1;
+  static readonly AUTO_LOCK_ON_MINIMIZE: number = 1 << 2;
+  static readonly AUTO_LOCK_ON_DEVICE_LOCK: number = 1 << 3;
+
+  static readonly SEARCH_IN_ISSUER: number = 1 << 0;
+  static readonly SEARCH_IN_NAME: number = 1 << 1;
+  static readonly SEARCH_IN_NOTE: number = 1 << 2;
+  static readonly SEARCH_IN_GROUPS: number = 1 << 3;
+
+  static readonly BACKUPS_VERSIONS_INFINITE: number = -1;
+
+  static readonly AUTO_LOCK_SETTINGS: number[] = [
+    Preferences.AUTO_LOCK_ON_BACK_BUTTON,
+    Preferences.AUTO_LOCK_ON_MINIMIZE,
+    Preferences.AUTO_LOCK_ON_DEVICE_LOCK
+  ];
+
+  static readonly SEARCH_BEHAVIOR_SETTINGS: number[] = [
+    Preferences.SEARCH_IN_ISSUER,
+    Preferences.SEARCH_IN_NAME,
+    Preferences.SEARCH_IN_NOTE,
+    Preferences.SEARCH_IN_GROUPS
+  ];
+
+  static readonly PREFS_NAME: string = 'aegis_preferences';
+
+  private _prefs: preferences.Preferences;
+
+  constructor(context: common.Context) {
+    const options: preferences.Options = { name: Preferences.PREFS_NAME };
+    this._prefs = preferences.getPreferencesSync(context, options);
+
+    if (this.getPasswordReminderTimestamp().getTime() === 0) {
+      this.resetPasswordReminderTimestamp();
+    }
+
+    this.migratePreferences();
+  }
+
+  // --- raw accessors ---
+
+  contains(key: string): boolean {
+    return this._prefs.hasSync(key);
+  }
+
+  getBoolean(key: string, def: boolean): boolean {
+    const v = this._prefs.getSync(key, def);
+    return typeof v === 'boolean' ? v as boolean : def;
+  }
+
+  putBoolean(key: string, value: boolean): void {
+    this._prefs.putSync(key, value);
+    this.flush();
+  }
+
+  getInt(key: string, def: number): number {
+    const v = this._prefs.getSync(key, def);
+    return typeof v === 'number' ? v as number : def;
+  }
+
+  putInt(key: string, value: number): void {
+    this._prefs.putSync(key, value);
+    this.flush();
+  }
+
+  getString(key: string, def: string | null): string | null {
+    if (!this._prefs.hasSync(key)) {
+      return def;
+    }
+    const v = this._prefs.getSync(key, '');
+    return typeof v === 'string' ? v as string : def;
+  }
+
+  getRawString(key: string, def: string): string {
+    const v = this.getString(key, def);
+    return v === null ? def : v;
+  }
+
+  putRawString(key: string, value: string | null): void {
+    if (value === null) {
+      this.remove(key);
+      return;
+    }
+    this._prefs.putSync(key, value);
+    this.flush();
+  }
+
+  remove(key: string): void {
+    if (this._prefs.hasSync(key)) {
+      this._prefs.deleteSync(key);
+      this.flush();
+    }
+  }
+
+  private flush(): void {
+    this._prefs.flush().catch(() => {
+    });
+  }
+
+  migratePreferences(): void {
+    // Change copy on tap to copy behavior to new preference and delete the old key
+    const prefCopyOnTapKey = 'pref_copy_on_tap';
+    if (this.contains(prefCopyOnTapKey)) {
+      const isCopyOnTapEnabled = this.getBoolean(prefCopyOnTapKey, false);
+      if (isCopyOnTapEnabled) {
+        this.setCopyBehavior(CopyBehavior.SINGLETAP);
+      }
+      this.remove(prefCopyOnTapKey);
+    }
+  }
+
+  isTapToRevealEnabled(): boolean {
+    return this.getBoolean('pref_tap_to_reveal', false);
+  }
+
+  isGroupMultiselectEnabled(): boolean {
+    return this.getBoolean('pref_groups_multiselect', false);
+  }
+
+  isEntryHighlightEnabled(): boolean {
+    return this.getBoolean('pref_highlight_entry', false);
+  }
+
+  isHapticFeedbackEnabled(): boolean {
+    return this.getBoolean('pref_haptic_feedback', true);
+  }
+
+  isPauseFocusedEnabled(): boolean {
+    const dependenciesEnabled = this.isTapToRevealEnabled() || this.isEntryHighlightEnabled();
+    if (!dependenciesEnabled) {
+      return false;
+    }
+    return this.getBoolean('pref_pause_entry', false);
+  }
+
+  isPanicTriggerEnabled(): boolean {
+    return this.getBoolean('pref_panic_trigger', false);
+  }
+
+  setIsPanicTriggerEnabled(enabled: boolean): void {
+    this.putBoolean('pref_panic_trigger', enabled);
+  }
+
+  isSecureScreenEnabled(): boolean {
+    // screen security should be enabled by default
+    return this.getBoolean('pref_secure_screen', true);
+  }
+
+  getPasswordReminderFrequency(): PassReminderFreq {
+    const key = 'pref_password_reminder_freq';
+    if (this.contains(key) || this.getBoolean('pref_password_reminder', true)) {
+      const i = this.getInt(key, PassReminderFreq.BIWEEKLY);
+      return PassReminderFreqUtils.fromInteger(i);
+    }
+    return PassReminderFreq.NEVER;
+  }
+
+  setPasswordReminderFrequency(freq: PassReminderFreq): void {
+    this.putInt('pref_password_reminder_freq', freq);
+  }
+
+  isPasswordReminderNeeded(currTime?: number): boolean {
+    const now = currTime !== undefined ? currTime : Date.now();
+    const freq = this.getPasswordReminderFrequency();
+    if (freq === PassReminderFreq.NEVER) {
+      return false;
+    }
+    const duration = now - this.getPasswordReminderTimestamp().getTime();
+    return duration >= PassReminderFreqUtils.getDurationMillis(freq);
+  }
+
+  getPasswordReminderTimestamp(): Date {
+    return new Date(this.getInt('pref_password_reminder_counter', 0));
+  }
+
+  setPasswordReminderTimestamp(timestamp: number): void {
+    this.putInt('pref_password_reminder_counter', timestamp);
+  }
+
+  resetPasswordReminderTimestamp(): void {
+    this.setPasswordReminderTimestamp(Date.now());
+  }
+
+  onlyShowNecessaryAccountNames(): boolean {
+    return this.getBoolean('pref_shared_issuer_account_name', false);
+  }
+
+  isIconVisible(): boolean {
+    return this.getBoolean('pref_show_icons', true);
+  }
+
+  getShowNextCode(): boolean {
+    return this.getBoolean('pref_show_next_code', false);
+  }
+
+  getShowExpirationState(): boolean {
+    return this.getBoolean('pref_expiration_state', true);
+  }
+
+  getCodeGroupSize(): CodeGrouping {
+    const value = this.getRawString('pref_code_group_size_string', 'GROUPING_THREES');
+    return CodeGroupingUtils.valueOf(value);
+  }
+
+  setCodeGroupSize(codeGroupSize: CodeGrouping): void {
