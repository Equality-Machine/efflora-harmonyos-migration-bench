+/**
+ * A menu item of the toolbar (replacement for the XML menus + MenuItem).
+ */
+export class ToolbarMenuItem {
+  id: string;
+  title: ResourceStr;
+  icon: Resource | null;
+  showAsAction: boolean;
+  visible: boolean = true;
+  checkable: boolean = false;
+  checked: boolean = false;
+  group: string = '';
+  children: ToolbarMenuItem[] = [];
+
+  constructor(id: string, title: ResourceStr, icon: Resource | null, showAsAction: boolean) {
+    this.id = id;
+    this.title = title;
+    this.icon = icon;
+    this.showAsAction = showAsAction;
+  }
+
+  setVisible(visible: boolean): ToolbarMenuItem {
+    this.visible = visible;
+    return this;
+  }
+
+  setCheckable(group: string, checked: boolean): ToolbarMenuItem {
+    this.checkable = true;
+    this.group = group;
+    this.checked = checked;
+    return this;
+  }
+
+  setChildren(children: ToolbarMenuItem[]): ToolbarMenuItem {
+    this.children = children;
+    return this;
+  }
+}
+
+/**
+ * Replacement for the MaterialToolbar / ActionBar.
+ */
+@Component
+export struct Toolbar {
+  @Prop title: ResourceStr = '';
+  @Prop subtitle: ResourceStr = '';
+  @Prop showBack: boolean = true;
+  @Prop menuItems: ToolbarMenuItem[] = [];
+  @Prop backgroundColorValue: ResourceColor = $r('app.color.theme_surface');
+  @Prop navigationIcon: Resource = $r('app.media.ic_outline_arrow_left_alt_24');
+  @Prop navigationId: string = 'navigate_up';
+  onBack: () => void = () => {
+  };
+  onMenuItemClick: (id: string) => void = (id: string) => {
+  };
+
+  @Builder
+  SubMenu(item: ToolbarMenuItem) {
+    Menu() {
+      ForEach(item.children.filter((c: ToolbarMenuItem) => c.visible), (child: ToolbarMenuItem) => {
+        MenuItem({
+          startIcon: child.checkable ? (child.checked ? $r('app.media.ic_outline_check_24') : undefined) : (child.icon !== null ? child.icon : undefined),
+          content: child.title
+        })
+          .onClick(() => this.onMenuItemClick(child.id))
+      }, (child: ToolbarMenuItem) => child.id + (child.checked ? '1' : '0'))
+    }
+  }
+
+  @Builder
+  OverflowMenu() {
+    Menu() {
+      ForEach(this.menuItems.filter((m: ToolbarMenuItem) => m.visible && !m.showAsAction), (item: ToolbarMenuItem) => {
+        if (item.children.length > 0) {
+          MenuItem({ content: item.title, builder: (): void => this.SubMenu(item) })
+        } else {
+          MenuItem({
+            startIcon: item.checkable ? (item.checked ? $r('app.media.ic_outline_check_24') : undefined) : undefined,
+            content: item.title
+          })
+            .onClick(() => this.onMenuItemClick(item.id))
+        }
+      }, (item: ToolbarMenuItem) => item.id + (item.checked ? '1' : '0'))
+    }
+  }
+
+  @Builder
+  ActionMenu(item: ToolbarMenuItem) {
+    Menu() {
+      ForEach(item.children.filter((c: ToolbarMenuItem) => c.visible), (child: ToolbarMenuItem) => {
+        MenuItem({
+          startIcon: child.checkable ? (child.checked ? $r('app.media.ic_outline_check_24') : $r('app.media.ic_unselected')) : undefined,
+          content: child.title
+        })
+          .onClick(() => this.onMenuItemClick(child.id))
+      }, (child: ToolbarMenuItem) => child.id + (child.checked ? '1' : '0'))
+    }
+  }
+
+  build() {
+    Row() {
+      if (this.showBack) {
+        Image(this.navigationIcon)
+          .width(24)
+          .height(24)
+          .fillColor($r('app.color.theme_onSurface'))
+          .margin({ left: 16, right: 16 })
+          .id(this.navigationId)
+          .onClick(() => this.onBack())
+      } else {
+        Blank().width(16).layoutWeight(0)
+      }
+      Column() {
+        Text(this.title)
+          .fontSize(20)
+          .fontColor($r('app.color.theme_onSurface'))
+          .maxLines(1)
+          .textOverflow({ overflow: TextOverflow.Ellipsis })
+        if (this.subtitle !== '') {
+          Text(this.subtitle)
+            .fontSize(14)
+            .fontColor($r('app.color.theme_onSurfaceVariant'))
+            .maxLines(1)
+            .textOverflow({ overflow: TextOverflow.Ellipsis })
+        }
+      }
+      .alignItems(HorizontalAlign.Start)
+      .layoutWeight(1)
+
+      ForEach(this.menuItems.filter((m: ToolbarMenuItem) => m.visible && m.showAsAction), (item: ToolbarMenuItem) => {
+        if (item.children.length > 0) {
+          Image(item.icon !== null ? item.icon : $r('app.media.ic_outline_more_vert_24'))
+            .width(24)
+            .height(24)
+            .fillColor($r('app.color.theme_onSurface'))
+            .margin({ left: 8, right: 8 })
+            .id(item.id)
+            .bindMenu(this.ActionMenu(item))
+        } else {
+          Image(item.icon !== null ? item.icon : $r('app.media.ic_outline_check_24'))
+            .width(24)
+            .height(24)
+            .fillColor($r('app.color.theme_onSurface'))
+            .margin({ left: 8, right: 8 })
+            .id(item.id)
+            .onClick(() => this.onMenuItemClick(item.id))
+        }
+      }, (item: ToolbarMenuItem) => item.id + (item.visible ? '1' : '0') + JSON.stringify(item.children.map((c: ToolbarMenuItem) => c.checked)))
+
+      if (this.menuItems.filter((m: ToolbarMenuItem) => m.visible && !m.showAsAction).length > 0) {
+        Image($r('app.media.ic_outline_more_vert_24'))
+          .width(24)
+          .height(24)
+          .fillColor($r('app.color.theme_onSurface'))
+          .margin({ left: 8, right: 12 })
+          .id('overflow_menu')
+          .bindMenu(this.OverflowMenu())
+      } else {
+        Blank().width(8).layoutWeight(0)
+      }
+    }
+    .width('100%')
+    .height(56)
+    .backgroundColor(this.backgroundColorValue)
+    .alignItems(VerticalAlign.Center)
+  }
+}
