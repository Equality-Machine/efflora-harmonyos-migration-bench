+import { OtpInfo } from './OtpInfo';
+import { OtpInfoException } from './OtpInfoException';
+import { HOTP } from '../crypto/otp/HOTP';
+import { JSONObject } from '../util/JSONObject';
+
+export class HotpInfo extends OtpInfo {
+  static readonly ID: string = 'hotp';
+  static readonly DEFAULT_COUNTER: number = 0;
+
+  private _counter: number = 0;
+
+  constructor(secret: Uint8Array, algorithm?: string, digits?: number, counter?: number) {
+    super(secret, algorithm, digits);
+    this.setCounter(counter !== undefined ? counter : HotpInfo.DEFAULT_COUNTER);
+  }
+
+  getOtp(time?: number): string {
+    this.checkSecret();
+    const otp = HOTP.generateOTP(this.getSecret(), this.getAlgorithm(true), this.getDigits(), this.getCounter());
+    return otp.toString();
+  }
+
+  getTypeId(): string {
+    return HotpInfo.ID;
+  }
+
+  toJson(): JSONObject {
+    const obj = super.toJson();
+    obj.put('counter', this.getCounter());
+    return obj;
+  }
+
+  getCounter(): number {
+    return this._counter;
+  }
+
+  static isCounterValid(counter: number): boolean {
+    return Number.isInteger(counter) && counter >= 0;
+  }
+
+  setCounter(counter: number): void {
+    if (!HotpInfo.isCounterValid(counter)) {
+      throw new OtpInfoException(`bad counter: ${counter}`);
+    }
+    this._counter = counter;
+  }
+
+  incrementCounter(): void {
+    this.setCounter(this.getCounter() + 1);
+  }
+
+  equals(o: Object | null): boolean {
+    if (!(o instanceof HotpInfo)) {
+      return false;
+    }
+    const info = o as HotpInfo;
+    return super.equals(o) && this.getCounter() === info.getCounter();
+  }
+}
+
+OtpInfo.registerFactory(HotpInfo.ID, (type: string, secret: Uint8Array, algo: string, digits: number, obj: JSONObject): OtpInfo => {
+  return new HotpInfo(secret, algo, digits, obj.getLong('counter'));
+});
