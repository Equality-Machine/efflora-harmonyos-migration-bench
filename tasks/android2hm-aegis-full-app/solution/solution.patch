@@ -0,0 +1,78 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { Base32 } from '../encoding/Base32';
+import { HotpInfo } from '../otp/HotpInfo';
+import { OtpInfo } from '../otp/OtpInfo';
+import { TotpInfo } from '../otp/TotpInfo';
+import { VaultEntry } from '../vault/VaultEntry';
+import { JSONArray, JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+
+export class DuoImporter extends DatabaseImporter {
+  private static readonly _pkgName: string = 'com.duosecurity.duomobile';
+  private static readonly _subPath: string = 'files/duokit/accounts.json';
+
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    return this.getAppPathForPackage(DuoImporter._pkgName, DuoImporter._subPath);
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    try {
+      const contents = Bytes.toUtf8(stream);
+      return new DuoImporterDecryptedState(new JSONArray(contents));
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+}
+
+export class DuoImporterDecryptedState extends DatabaseImporterState {
+  private readonly _array: JSONArray;
+
+  constructor(array: JSONArray) {
+    super(false);
+    this._array = array;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    try {
+      for (let i = 0; i < this._array.length(); i++) {
+        const entry = this._array.getJSONObject(i);
+        try {
+          result.addEntry(DuoImporterDecryptedState.convertEntry(entry));
+        }
+        catch (e) {
+          result.addError(e as DatabaseImporterEntryException);
+        }
+      }
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    return result;
+  }
+
+  private static convertEntry(entry: JSONObject): VaultEntry {
+    try {
+      const label = entry.optString('name');
+      const otpData = entry.getJSONObject('otpGenerator');
+      const secret = Base32.decode(otpData.getString('otpSecret'));
+      const counter: number | null = otpData.has('counter') ? otpData.getLong('counter') : null;
+      const otp: OtpInfo = counter === null
+        ? new TotpInfo(secret)
+        : new HotpInfo(secret, OtpInfo.DEFAULT_ALGORITHM, OtpInfo.DEFAULT_DIGITS, counter);
+      return new VaultEntry(otp, label, '');
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, entry.toString());
+    }
+  }
+}
