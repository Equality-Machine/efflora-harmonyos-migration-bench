+export class CollectionUtils {
+  private constructor() {
+  }
+
+  static move<T>(list: T[], fromIndex: number, toIndex: number): void {
+    if (fromIndex === toIndex) {
+      return;
+    }
+    const item = list.splice(fromIndex, 1)[0];
+    list.splice(toIndex, 0, item);
+  }
+}
diff --git a/entry/src/main/ets/util/CsvParser.ets b/entry/src/main/ets/util/CsvParser.ets
new file mode 100644
index 0000000..89cce3d
--- /dev/null
+++ b/entry/src/main/ets/util/CsvParser.ets
@@ -0,0 +1,135 @@
+
+
+/**
+ * A CSV row with access to the cells by header name (replacement for org.simpleflatmapper.lightningcsv.Row).
+ */
+export class CsvRow {
+  private readonly _headers: string[];
+  private readonly _values: string[];
+
+  constructor(headers: string[], values: string[]) {
+    this._headers = headers;
+    this._values = values;
+  }
+
+  /**
+   * Returns the value of the cell in the column with the given header, or null if there is no such column.
+   */
+  get(key: string): string | null {
+    const i = this._headers.indexOf(key);
+    if (i < 0) {
+      return null;
+    }
+    return i < this._values.length ? this._values[i] : null;
+  }
+
+  getAt(index: number): string | null {
+    return index < this._values.length ? this._values[index] : null;
+  }
+
+  size(): number {
+    return this._values.length;
+  }
+}
+
+/**
+ * A small RFC 4180 CSV parser (replacement for org.simpleflatmapper.csv.CsvParser). Supports quoted
+ * cells (with "" as an escaped quote), line breaks inside of quoted cells and LF/CRLF/CR line endings.
+ */
+export class CsvParser {
+  private readonly _separator: string;
+  private readonly _quote: string;
+
+  private constructor(separator: string, quote: string) {
+    this._separator = separator;
+    this._quote = quote;
+  }
+
+  static separator(separator: string): CsvParser {
+    return new CsvParser(separator, '"');
+  }
+
+  quote(quote: string): CsvParser {
+    return new CsvParser(this._separator, quote);
+  }
+
+  /**
+   * Parses the given CSV text and returns all rows as arrays of cells (including the header row).
+   */
+  parse(text: string): string[][] {
+    const rows: string[][] = [];
+    let row: string[] = [];
+    let cell = '';
+    let inQuotes = false;
+    let cellStarted = false;
+    let i = 0;
+    const s = text.length > 0 && text.charCodeAt(0) === 0xfeff ? text.substring(1) : text;
+    while (i < s.length) {
+      const c = s.charAt(i);
+      if (inQuotes) {
+        if (c === this._quote) {
+          if (i + 1 < s.length && s.charAt(i + 1) === this._quote) {
+            cell += this._quote;
+            i += 2;
+            continue;
+          }
+          inQuotes = false;
+          i++;
+          continue;
+        }
+        cell += c;
+        i++;
+        continue;
+      }
+      if (c === this._quote && !cellStarted) {
+        inQuotes = true;
+        cellStarted = true;
+        i++;
+      }
+      else if (c === this._separator) {
+        row.push(cell);
+        cell = '';
+        cellStarted = false;
+        i++;
+      }
+      else if (c === '\r' || c === '\n') {
+        row.push(cell);
+        rows.push(row);
+        row = [];
+        cell = '';
+        cellStarted = false;
+        if (c === '\r' && i + 1 < s.length && s.charAt(i + 1) === '\n') {
+          i++;
+        }
+        i++;
+      }
+      else {
+        cell += c;
+        cellStarted = true;
+        i++;
+      }
+    }
+    if (cellStarted || row.length > 0 || cell.length > 0) {
+      row.push(cell);
+      rows.push(row);
+    }
+    // drop empty lines
+    return rows.filter((r: string[]) => !(r.length === 1 && r[0].length === 0));
+  }
+
+  /**
+   * Parses the given CSV text, using the first row as the header row.
+   */
+  rowIterator(text: string): CsvRow[] {
+    const rows = this.parse(text);
+    if (rows.length === 0) {
+      return [];
+    }
+    const headers = rows[0];
+    const result: CsvRow[] = [];
+    for (let i = 1; i < rows.length; i++) {
+      result.push(new CsvRow(headers, rows[i]));
+    }
+    return result;
+  }
+}
diff --git a/entry/src/main/ets/util/DataInputStream.ets b/entry/src/main/ets/util/DataInputStream.ets
new file mode 100644
index 0000000..c5d52fe
--- /dev/null
+++ b/entry/src/main/ets/util/DataInputStream.ets
@@ -0,0 +1,164 @@
+import { Bytes } from './Bytes';
+
+export class EOFException extends Error {
+  constructor(message?: string) {
+    super(message !== undefined ? message : 'Unexpected end of stream');
+    this.name = 'EOFException';
+  }
+}
+
+/**
+ * Port of the parts of java.io.DataInputStream (on top of a ByteArrayInputStream) that are needed to
+ * read Java serialized objects and other big endian binary formats.
+ */
+export class DataInputStream {
+  private readonly _data: Uint8Array;
+  private _pos: number = 0;
+  private _mark: number = 0;
+
+  constructor(data: Uint8Array, offset: number = 0) {
+    this._data = data;
+    this._pos = offset;
+  }
+
+  available(): number {
+    return this._data.length - this._pos;
+  }
+
+  getPosition(): number {
+    return this._pos;
+  }
+
+  mark(readLimit: number): void {
+    this._mark = this._pos;
+  }
+
+  reset(): void {
+    this._pos = this._mark;
+  }
+
+  private require(n: number): void {
+    if (this._pos + n > this._data.length) {
+      throw new EOFException();
+    }
+  }
+
+  read(): number {
+    if (this._pos >= this._data.length) {
+      return -1;
+    }
+    return this._data[this._pos++];
+  }
+
+  readByte(): number {
+    this.require(1);
+    const b = this._data[this._pos++];
+    return b >= 0x80 ? b - 0x100 : b;
+  }
+
+  readUnsignedByte(): number {
+    this.require(1);
+    return this._data[this._pos++];
+  }
+
+  readBoolean(): boolean {
+    return this.readUnsignedByte() !== 0;
+  }
+
+  readShort(): number {
+    const v = this.readUnsignedShort();
+    return v >= 0x8000 ? v - 0x10000 : v;
+  }
+
+  readUnsignedShort(): number {
+    this.require(2);
+    const v = (this._data[this._pos] << 8) | this._data[this._pos + 1];
+    this._pos += 2;
+    return v;
+  }
+
+  readChar(): string {
+    return String.fromCharCode(this.readUnsignedShort());
+  }
+
+  readInt(): number {
+    this.require(4);
+    const v = (this._data[this._pos] << 24) | (this._data[this._pos + 1] << 16) | (this._data[this._pos + 2] << 8) |
+      this._data[this._pos + 3];
+    this._pos += 4;
+    return v;
+  }
+
+  /**
+   * Reads a signed 64-bit big endian integer.
+   */
+  readLong(): bigint {
+    this.require(8);
+    let v = BigInt(0);
+    for (let i = 0; i < 8; i++) {
+      v = (v << BigInt(8)) | BigInt(this._data[this._pos + i]);
+    }
+    this._pos += 8;
+    return BigInt.asIntN(64, v);
+  }
+
+  readFully(b: Uint8Array): void {
+    this.require(b.length);
+    b.set(this._data.subarray(this._pos, this._pos + b.length));
+    this._pos += b.length;
+  }
+
+  readBytes(n: number): Uint8Array {
+    const b = new Uint8Array(n);
+    this.readFully(b);
+    return b;
+  }
+
+  /**
+   * Reads all of the remaining bytes.
+   */
+  readAll(): Uint8Array {
+    const b = Bytes.copyOfRange(this._data, this._pos, this._data.length);
+    this._pos = this._data.length;
+    return b;
+  }
+
+  skipBytes(n: number): number {
+    const skipped = Math.max(0, Math.min(n, this._data.length - this._pos));
+    this._pos += skipped;
+    return skipped;
+  }
+
+  /**
+   * Reads a string in modified UTF-8 format, prefixed with an unsigned 16-bit length.
+   */
+  readUTF(): string {
+    const len = this.readUnsignedShort();
+    const bytes = this.readBytes(len);
+    return DataInputStream.decodeModifiedUtf8(bytes);
+  }
+
+  static decodeModifiedUtf8(bytes: Uint8Array): string {
+    let out = '';
+    let i = 0;
+    while (i < bytes.length) {
+      const a = bytes[i];
+      if (a < 0x80) {
+        out += String.fromCharCode(a);
+        i++;
+      }
+      else if ((a & 0xe0) === 0xc0 && i + 1 < bytes.length) {
+        out += String.fromCharCode(((a & 0x1f) << 6) | (bytes[i + 1] & 0x3f));
+        i += 2;
+      }
+      else if ((a & 0xf0) === 0xe0 && i + 2 < bytes.length) {
+        out += String.fromCharCode(((a & 0x0f) << 12) | ((bytes[i + 1] & 0x3f) << 6) | (bytes[i + 2] & 0x3f));
+        i += 3;
+      }
+      else {
+        throw new Error('Malformed modified UTF-8 input');
+      }
+    }
+    return out;
+  }
+}
diff --git a/entry/src/main/ets/util/IOUtils.ets b/entry/src/main/ets/util/IOUtils.ets
new file mode 100644
index 0000000..f0bbe8c
--- /dev/null
+++ b/entry/src/main/ets/util/IOUtils.ets
@@ -0,0 +1,117 @@
+import { fileIo } from '@kit.CoreFileKit';
+
+export class IOUtils {
+  private constructor() {
+  }
+
+  /**
+   * Reads the full contents of the file at the given path or URI.
+   */
+  static readFile(pathOrUri: string): Uint8Array {
+    const file = fileIo.openSync(pathOrUri, fileIo.OpenMode.READ_ONLY);
+    try {
+      const stat = fileIo.statSync(file.fd);
+      return IOUtils.readAll(file.fd, stat.size);
+    } finally {
+      fileIo.closeSync(file);
+    }
+  }
+
+  static readAll(fd: number, sizeHint: number): Uint8Array {
+    const chunks: Uint8Array[] = [];
+    let total = 0;
+    const bufSize = sizeHint > 0 ? Math.max(sizeHint, 4096) : 65536;
+    while (true) {
+      const buf = new ArrayBuffer(bufSize);
+      const read = fileIo.readSync(fd, buf);
+      if (read <= 0) {
+        break;
+      }
+      chunks.push(new Uint8Array(buf, 0, read));
+      total += read;
+    }
+    const out = new Uint8Array(total);
+    let off = 0;
+    for (const c of chunks) {
+      out.set(c, off);
+      off += c.length;
+    }
+    return out;
+  }
+
+  /**
+   * Writes the given bytes to the file at the given path or URI, truncating it first.
+   */
+  static writeFile(pathOrUri: string, data: Uint8Array): void {
+    const file = fileIo.openSync(pathOrUri, fileIo.OpenMode.CREATE | fileIo.OpenMode.WRITE_ONLY | fileIo.OpenMode.TRUNC);
+    try {
+      let off = 0;
+      while (off < data.length) {
+        const slice = data.slice(off, Math.min(off + 65536, data.length));
+        const written = fileIo.writeSync(file.fd, slice.buffer);
+        if (written <= 0) {
+          throw new Error('Write failed');
+        }
+        off += written;
+      }
+      fileIo.fsyncSync(file.fd);
+    } finally {
+      fileIo.closeSync(file);
+    }
+  }
+
+  static copy(from: string, to: string): void {
+    IOUtils.writeFile(to, IOUtils.readFile(from));
+  }
+
+  static exists(path: string): boolean {
+    try {
+      return fileIo.accessSync(path);
+    } catch (e) {
+      return false;
+    }
+  }
+
+  static mkdirs(path: string): void {
+    if (!IOUtils.exists(path)) {
+      fileIo.mkdirSync(path, true);
+    }
+  }
+
+  static clearDirectory(dir: string, deleteRoot: boolean): void {
+    if (!IOUtils.exists(dir)) {
+      return;
+    }
+    let files: string[] = [];
+    try {
+      files = fileIo.listFileSync(dir);
+    } catch (e) {
+      files = [];
+    }
+    for (const name of files) {
+      const p = `${dir}/${name}`;
+      try {
+        if (fileIo.statSync(p).isDirectory()) {
+          IOUtils.clearDirectory(p, true);
+        } else {
+          fileIo.unlinkSync(p);
+        }
+      } catch (e) {
+        // ignore
+      }
+    }
+    if (deleteRoot) {
+      try {
+        fileIo.rmdirSync(dir);
+      } catch (e) {
+        // ignore
+      }
+    }
+  }
+
+  static getFileName(uri: string): string {
+    const decoded = decodeURIComponent(uri);
+    const idx = decoded.lastIndexOf('/');
+    return idx >= 0 ? decoded.substring(idx + 1) : decoded;
+  }
+}
diff --git a/entry/src/main/ets/util/JSONObject.ets b/entry/src/main/ets/util/JSONObject.ets
new file mode 100644
index 0000000..21a3ce9
--- /dev/null
+++ b/entry/src/main/ets/util/JSONObject.ets
@@ -0,0 +1,373 @@
+/**
+ * A small port of org.json's JSONObject/JSONArray API on top of the ArkTS JSON implementation.
+ * Values are stored as plain JSON values internally so that the result can be stringified directly.
+ */
+export class JSONException extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'JSONException';
+  }
+}
+
+export type JSONValue = string | number | boolean | null | JSONObject | JSONArray;
+
+export class JSONObject {
+  private _map: Record<string, Object | null>;
+
+  constructor(source?: string | Record<string, Object | null>) {
+    if (source === undefined) {
+      this._map = {};
+    } else if (typeof source === 'string') {
+      let parsed: Object | null = null;
+      try {
+        parsed = JSON.parse(source) as Object | null;
+      } catch (e) {
+        throw new JSONException(`Unable to parse JSON: ${(e as Error).message}`);
+      }
+      if (parsed === null || typeof parsed !== 'object' || parsed instanceof Array) {
+        throw new JSONException('Value is not a JSON object');
+      }
+      this._map = parsed as Record<string, Object | null>;
+    } else {
+      this._map = source;
+    }
+  }
+
+  static readonly NULL: null = null;
+
+  raw(): Record<string, Object | null> {
+    return this._map;
+  }
+
+  has(key: string): boolean {
+    return Object.keys(this._map).indexOf(key) >= 0 && this._map[key] !== undefined;
+  }
+
+  isNull(key: string): boolean {
+    return !this.has(key) || this._map[key] === null;
+  }
+
+  keys(): string[] {
+    return Object.keys(this._map);
+  }
+
+  length(): number {
+    return Object.keys(this._map).length;
+  }
+
+  remove(key: string): void {
+    const copy: Record<string, Object | null> = {};
+    for (const k of Object.keys(this._map)) {
+      if (k !== key) {
+        copy[k] = this._map[k];
+      }
+    }
+    this._map = copy;
+  }
+
+  put(key: string, value: JSONValue | undefined): JSONObject {
+    this._map[key] = JSONObject.unwrap(value === undefined ? null : value);
+    return this;
+  }
+
+  static unwrap(value: JSONValue): Object | null {
+    if (value instanceof JSONObject) {
+      return value.raw();
+    }
+    if (value instanceof JSONArray) {
+      return value.raw();
+    }
+    return value;
+  }
+
+  static wrap(value: Object | null): JSONValue {
+    if (value === null || value === undefined) {
+      return null;
+    }
+    if (value instanceof Array) {
+      return new JSONArray(value as Array<Object | null>);
+    }
+    if (typeof value === 'object') {
+      return new JSONObject(value as Record<string, Object | null>);
+    }
+    if (typeof value === 'string') {
+      return value as string;
+    }
+    if (typeof value === 'number') {
+      return value as number;
+    }
+    if (typeof value === 'boolean') {
+      return value as boolean;
+    }
+    return null;
+  }
+
+  get(key: string): JSONValue {
+    if (!this.has(key)) {
+      throw new JSONException(`No value for ${key}`);
+    }
+    return JSONObject.wrap(this._map[key]);
+  }
+
+  opt(key: string): JSONValue {
+    if (!this.has(key)) {
+      return null;
+    }
+    return JSONObject.wrap(this._map[key]);
+  }
+
+  getString(key: string): string {
+    const v = this._map[key];
+    if (v === undefined || !this.has(key)) {
+      throw new JSONException(`No value for ${key}`);
+    }
+    if (typeof v === 'string') {
+      return v as string;
+    }
+    if (typeof v === 'number' || typeof v === 'boolean') {
+      return String(v);
+    }
+    throw new JSONException(`Value for ${key} is not a string`);
+  }
+
+  optString(key: string, fallback: string = ''): string {
+    const v = this._map[key];
+    if (v === undefined || v === null || !this.has(key)) {
+      return fallback;
+    }
+    if (typeof v === 'string') {
+      return v as string;
+    }
+    if (typeof v === 'number' || typeof v === 'boolean') {
+      return String(v);
+    }
+    return fallback;
+  }
+
+  /**
+   * Returns null if the key is missing or null (like JsonUtils.optString).
+   */
+  optStringOrNull(key: string): string | null {
+    if (this.isNull(key)) {
+      return null;
+    }
+    return this.optString(key, '');
+  }
+
+  getNumber(key: string): number {
+    const v = this._map[key];
+    if (v === undefined || !this.has(key)) {
+      throw new JSONException(`No value for ${key}`);
+    }
+    if (typeof v === 'number') {
+      return v as number;
+    }
+    if (typeof v === 'string') {
+      const n = Number(v as string);
+      if (!isNaN(n) && (v as string).trim().length > 0) {
+        return n;
+      }
+    }
+    throw new JSONException(`Value for ${key} is not a number`);
+  }
+
+  getInt(key: string): number {
+    return Math.trunc(this.getNumber(key));
+  }
+
+  getLong(key: string): number {
+    return Math.trunc(this.getNumber(key));
+  }
+
+  getDouble(key: string): number {
+    return this.getNumber(key);
+  }
+
+  optInt(key: string, fallback: number = 0): number {
+    try {
+      return this.getInt(key);
+    } catch (e) {
+      return fallback;
+    }
+  }
+
+  optLong(key: string, fallback: number = 0): number {
+    return this.optInt(key, fallback);
+  }
+
+  getBoolean(key: string): boolean {
+    const v = this._map[key];
+    if (typeof v === 'boolean') {
+      return v as boolean;
+    }
+    if (typeof v === 'string') {
+      const s = (v as string).toLowerCase();
+      if (s === 'true') {
+        return true;
+      }
+      if (s === 'false') {
+        return false;
+      }
+    }
+    throw new JSONException(`Value for ${key} is not a boolean`);
+  }
+
+  optBoolean(key: string, fallback: boolean = false): boolean {
+    try {
+      return this.getBoolean(key);
+    } catch (e) {
+      return fallback;
+    }
+  }
+
+  getJSONObject(key: string): JSONObject {
+    const v = this._map[key];
+    if (v === undefined || v === null || typeof v !== 'object' || v instanceof Array) {
+      throw new JSONException(`Value for ${key} is not a JSONObject`);
+    }
+    return new JSONObject(v as Record<string, Object | null>);
+  }
+
+  optJSONObject(key: string): JSONObject | null {
+    try {
+      return this.getJSONObject(key);
+    } catch (e) {
+      return null;
+    }
+  }
+
+  getJSONArray(key: string): JSONArray {
+    const v = this._map[key];
+    if (v === undefined || v === null || !(v instanceof Array)) {
+      throw new JSONException(`Value for ${key} is not a JSONArray`);
+    }
+    return new JSONArray(v as Array<Object | null>);
+  }
+
+  optJSONArray(key: string): JSONArray | null {
+    try {
+      return this.getJSONArray(key);
+    } catch (e) {
+      return null;
+    }
+  }
+
+  toString(indent?: number): string {
+    if (indent !== undefined && indent > 0) {
+      return JSON.stringify(this._map, null, indent);
+    }
+    return JSON.stringify(this._map);
+  }
+}
+
+export class JSONArray {
+  private _list: Array<Object | null>;
+
+  constructor(source?: string | Array<Object | null>) {
+    if (source === undefined) {
+      this._list = [];
+    } else if (typeof source === 'string') {
+      let parsed: Object | null = null;
+      try {
+        parsed = JSON.parse(source) as Object | null;
+      } catch (e) {
+        throw new JSONException(`Unable to parse JSON: ${(e as Error).message}`);
+      }
+      if (!(parsed instanceof Array)) {
+        throw new JSONException('Value is not a JSON array');
+      }
+      this._list = parsed as Array<Object | null>;
+    } else {
+      this._list = source;
+    }
+  }
+
+  raw(): Array<Object | null> {
+    return this._list;
+  }
+
+  length(): number {
+    return this._list.length;
+  }
+
+  put(value: JSONValue): JSONArray {
+    this._list.push(JSONObject.unwrap(value));
+    return this;
+  }
+
+  isNull(i: number): boolean {
+    return i >= this._list.length || this._list[i] === null || this._list[i] === undefined;
+  }
+
+  get(i: number): JSONValue {
+    if (i < 0 || i >= this._list.length) {
+      throw new JSONException(`Index ${i} out of range`);
+    }
+    return JSONObject.wrap(this._list[i]);
+  }
+
+  getString(i: number): string {
+    const v = this._list[i];
+    if (typeof v === 'string') {
+      return v as string;
+    }
+    if (typeof v === 'number' || typeof v === 'boolean') {
+      return String(v);
+    }
+    throw new JSONException(`Value at ${i} is not a string`);
+  }
+
+  optString(i: number, fallback: string = ''): string {
+    try {
+      return this.getString(i);
+    } catch (e) {
+      return fallback;
+    }
+  }
+
+  getInt(i: number): number {
+    const v = this._list[i];
+    if (typeof v === 'number') {
+      return Math.trunc(v as number);
+    }
+    if (typeof v === 'string' && !isNaN(Number(v as string))) {
+      return Math.trunc(Number(v as string));
+    }
+    throw new JSONException(`Value at ${i} is not a number`);
+  }
+
+  getLong(i: number): number {
+    return this.getInt(i);
+  }
+
+  getJSONObject(i: number): JSONObject {
+    const v = this._list[i];
+    if (v === undefined || v === null || typeof v !== 'object' || v instanceof Array) {
+      throw new JSONException(`Value at ${i} is not a JSONObject`);
+    }
+    return new JSONObject(v as Record<string, Object | null>);
+  }
+
+  optJSONObject(i: number): JSONObject | null {
+    try {
+      return this.getJSONObject(i);
+    } catch (e) {
+      return null;
+    }
+  }
+
+  getJSONArray(i: number): JSONArray {
+    const v = this._list[i];
+    if (!(v instanceof Array)) {
+      throw new JSONException(`Value at ${i} is not a JSONArray`);
+    }
+    return new JSONArray(v as Array<Object | null>);
+  }
+
+  toString(indent?: number): string {
+    if (indent !== undefined && indent > 0) {
+      return JSON.stringify(this._list, null, indent);
+    }
+    return JSON.stringify(this._list);
+  }
+}
