@@ -0,0 +1,577 @@
+import { AegisActivity, PAGE_PREFS_SECURITY } from '../../AegisActivity';
+import { Toolbar } from '../../components/Toolbar';
+import { Dialogs, PasswordSlotListener } from '../../dialogs/Dialogs';
+import { PreferencesFragment } from './PreferencesFragment';
+import { Preference, PreferenceCategory, PreferenceScreen, SwitchPreferenceCompat } from '../../preferences/Preference';
+import { SwitchPreference } from '../../preferences/SwitchPreference';
+import { PreferenceResources } from '../../preferences/PreferenceResources';
+import { PreferenceScreenView } from '../../preferences/PreferenceScreenView';
+import { PreferenceDialogs } from '../../preferences/PreferenceDialogs';
+import { PasswordSlotDecryptResult, PasswordSlotDecryptTask } from '../../tasks/PasswordSlotDecryptTask';
+import { ThemeHelper } from '../../../helpers/ThemeHelper';
+import { BiometricSlotInitializer, BiometricSlotInitializerListener } from '../../../helpers/BiometricSlotInitializer';
+import { BiometricPromptInfo, BiometricsHelper } from '../../../helpers/BiometricsHelper';
+import { Preferences } from '../../../Preferences';
+import { PassReminderFreq, PassReminderFreqUtils } from '../../../PassReminderFreq';
+import { AegisModule } from '../../../AegisModule';
+import { AegisApplication } from '../../../AegisApplication';
+import { ResUtils } from '../../../util/ResUtils';
+import { VaultManager } from '../../../vault/VaultManager';
+import { VaultFileCredentials } from '../../../vault/VaultFileCredentials';
+import { PasswordSlot } from '../../../vault/slots/PasswordSlot';
+import { BiometricSlot } from '../../../vault/slots/BiometricSlot';
+import { Cipher } from '../../../crypto/Cipher';
+import { KeyStoreHandle } from '../../../crypto/KeyStoreHandle';
+
+function getStringArray(name: string): string[] {
+  return ResUtils.getStringArray(AegisModule.getContext(), name);
+}
+
