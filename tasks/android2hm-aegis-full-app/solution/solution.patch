+  private onActionItemClicked(itemId: string): void {
+    if (this._selectedEntries.length === 0) {
+      this.finishActionMode();
+      return;
+    }
+
+    const vault = this._activity.getVaultManager().getVault();
+    if (itemId === 'action_copy') {
+      this.copyEntryCode(this._selectedEntries[0]);
+      this.finishActionMode();
+    } else if (itemId === 'action_edit') {
+      const entry = this._selectedEntries[0];
+      this.finishActionMode();
+      this.startEditEntryActivityFor(entry);
+    } else if (itemId === 'action_toggle_favorite') {
+      for (const entry of this._selectedEntries) {
+        vault.editEntry(entry, (newEntry: VaultEntry) => {
+          newEntry.setIsFavorite(!newEntry.isFavorite());
+        });
+      }
+      this.saveAndBackupVault();
+      this.finishActionMode();
+      this._entryListView.setEntries(vault.getEntries());
+    } else if (itemId === 'action_share_qr') {
+      const authInfos: Transferable[] = [];
+      for (const entry of this._selectedEntries) {
+        authInfos.push(new GoogleAuthInfo(entry.getInfo(), entry.getName(), entry.getIssuer()));
+        this._activity.getAuditLogRepository().addEntrySharedEvent(entry.getUUID());
+      }
+      const intent = new Intent(PAGE_TRANSFER_ENTRIES);
+      intent.putExtra('authInfos', authInfos);
+      this._activity.startActivity(intent);
+      this.finishActionMode();
+    } else if (itemId === 'action_delete') {
+      Dialogs.showDeleteEntriesDialog(this.getUIContext(), this._selectedEntries, () => {
+        for (const entry of this._selectedEntries) {
+          vault.removeEntry(entry);
+        }
+        this.saveAndBackupVault();
+        this._entryListView.setGroups(vault.getUsedGroups());
+        this._entryListView.setEntries(vault.getEntries());
+        this.finishActionMode();
+        this.setGroups(vault.getUsedGroups());
+      });
+    } else if (itemId === 'action_select_all') {
+      this._selectedEntries = this._entryListView.selectAllEntries();
+      this.selectedCount = this._selectedEntries.length;
+      this.setFavoriteMenuItemVisiblity();
+      this.setIsMultipleSelected(this._selectedEntries.length > 1);
+    } else if (itemId === 'action_assign_icons') {
+      const entries = this._selectedEntries.slice();
+      this.finishActionMode();
+      this.startAssignIconsActivity(entries);
+    } else if (itemId === 'action_assign_groups') {
+      this.startAssignGroupsDialog();
+    }
+  }
