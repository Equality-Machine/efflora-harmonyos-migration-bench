index 0000000..e4098d5
--- /dev/null
+++ b/entry/src/main/ets/util/Uri.ets
@@ -0,0 +1,246 @@
+/**
+ * A port of the subset of android.net.Uri that is used throughout the app.
+ */
+export class UriQueryParam {
+  key: string;
+  value: string;
+
+  constructor(key: string, value: string) {
+    this.key = key;
+    this.value = value;
+  }
+}
+
+export class Uri {
+  private _scheme: string | null = null;
+  private _authority: string | null = null;
+  private _path: string | null = null;
+  private _query: string | null = null;
+  private _fragment: string | null = null;
+  private _raw: string = '';
+
+  static parse(s: string): Uri {
+    const uri = new Uri();
+    uri._raw = s;
+    let rest = s;
+    const hashIdx = rest.indexOf('#');
+    if (hashIdx >= 0) {
+      uri._fragment = rest.substring(hashIdx + 1);
+      rest = rest.substring(0, hashIdx);
+    }
+    const schemeMatch = new RegExp('^([a-zA-Z][a-zA-Z0-9+.-]*):').exec(rest);
+    if (schemeMatch !== null) {
+      uri._scheme = schemeMatch[1];
+      rest = rest.substring(schemeMatch[0].length);
+    }
+    const qIdx = rest.indexOf('?');
+    if (qIdx >= 0) {
+      uri._query = rest.substring(qIdx + 1);
+      rest = rest.substring(0, qIdx);
+    }
+    if (rest.startsWith('//')) {
+      rest = rest.substring(2);
+      const slash = rest.indexOf('/');
+      if (slash >= 0) {
+        uri._authority = rest.substring(0, slash);
+        uri._path = rest.substring(slash);
+      } else {
+        uri._authority = rest;
+        uri._path = '';
+      }
+    } else {
+      uri._path = rest;
+    }
+    return uri;
+  }
+
+  static decode(s: string, convertPlus: boolean = false): string {
+    let str = s;
+    if (convertPlus) {
+      str = str.replace(new RegExp('\\+', 'g'), ' ');
+    }
+    try {
+      return decodeURIComponent(str);
+    } catch (e) {
+      // decode as much as possible, leaving malformed sequences untouched
+      return str.replace(new RegExp('(%[0-9a-fA-F]{2})+', 'g'), (m: string) => {
+        try {
+          return decodeURIComponent(m);
+        } catch (e2) {
+          return m;
+        }
+      });
+    }
+  }
+
+  static encode(s: string, allow?: string): string {
+    let res = encodeURIComponent(s);
+    if (allow !== undefined) {
+      for (let i = 0; i < allow.length; i++) {
+        const c = allow.charAt(i);
+        res = res.split(encodeURIComponent(c)).join(c);
+      }
+    }
+    return res;
+  }
+
+  getScheme(): string | null {
+    return this._scheme;
+  }
+
+  getHost(): string | null {
+    if (this._authority === null) {
+      return null;
+    }
+    let host = this._authority;
+    const at = host.lastIndexOf('@');
+    if (at >= 0) {
+      host = host.substring(at + 1);
+    }
+    const colon = host.lastIndexOf(':');
+    if (colon >= 0 && !host.endsWith(']')) {
+      host = host.substring(0, colon);
+    }
+    return Uri.decode(host);
+  }
+
+  getAuthority(): string | null {
+    return this._authority === null ? null : Uri.decode(this._authority);
+  }
+
+  getPath(): string | null {
+    return this._path === null ? null : Uri.decode(this._path);
+  }
+
+  getEncodedPath(): string | null {
+    return this._path;
+  }
+
+  getQuery(): string | null {
+    return this._query === null ? null : Uri.decode(this._query);
+  }
+
+  getFragment(): string | null {
+    return this._fragment === null ? null : Uri.decode(this._fragment);
+  }
+
+  getLastPathSegment(): string | null {
+    const p = this.getPath();
+    if (p === null) {
+      return null;
+    }
+    const segs = p.split('/').filter((x: string) => x.length > 0);
+    return segs.length > 0 ? segs[segs.length - 1] : null;
+  }
+
+  getQueryParams(): UriQueryParam[] {
+    const res: UriQueryParam[] = [];
+    if (this._query === null || this._query.length === 0) {
+      return res;
+    }
+    for (const part of this._query.split('&')) {
+      if (part.length === 0) {
+        continue;
+      }
+      const eq = part.indexOf('=');
+      const k = eq >= 0 ? part.substring(0, eq) : part;
+      const v = eq >= 0 ? part.substring(eq + 1) : '';
+      res.push(new UriQueryParam(Uri.decode(k, true), Uri.decode(v, true)));
+    }
+    return res;
+  }
+
+  getQueryParameter(key: string): string | null {
+    for (const p of this.getQueryParams()) {
+      if (p.key === key) {
+        return p.value;
+      }
+    }
+    return null;
+  }
+
+  getQueryParameterNames(): string[] {
+    const names: string[] = [];
+    for (const p of this.getQueryParams()) {
+      if (names.indexOf(p.key) < 0) {
+        names.push(p.key);
+      }
+    }
+    return names;
+  }
+
+  toString(): string {
+    if (this._raw.length > 0) {
+      return this._raw;
+    }
+    let s = '';
+    if (this._scheme !== null) {
+      s += this._scheme + ':';
+    }
+    if (this._authority !== null) {
+      s += '//' + this._authority;
+    }
+    if (this._path !== null) {
+      s += this._path;
+    }
+    if (this._query !== null) {
+      s += '?' + this._query;
+    }
+    if (this._fragment !== null) {
+      s += '#' + this._fragment;
+    }
+    return s;
+  }
+
+  equals(other: Uri): boolean {
+    return this.toString() === other.toString();
+  }
+
+  static builder(): UriBuilder {
+    return new UriBuilder();
+  }
+
+  static fromParts(scheme: string | null, authority: string | null, path: string | null, query: string | null): Uri {
+    const uri = new Uri();
+    uri._scheme = scheme;
+    uri._authority = authority;
+    uri._path = path;
+    uri._query = query;
+    return uri;
+  }
+}
+
+export class UriBuilder {
+  private _scheme: string | null = null;
+  private _authority: string | null = null;
+  private _path: string = '';
+  private _query: string[] = [];
+
+  scheme(scheme: string): UriBuilder {
+    this._scheme = scheme;
+    return this;
+  }
+
+  authority(authority: string): UriBuilder {
+    this._authority = Uri.encode(authority, '@:');
+    return this;
+  }
+
+  path(path: string): UriBuilder {
+    this._path = Uri.encode(path, '/');
+    return this;
+  }
+
+  appendQueryParameter(key: string, value: string): UriBuilder {
+    this._query.push(`${Uri.encode(key)}=${Uri.encode(value)}`);
+    return this;
+  }
+
+  build(): Uri {
+    let path = this._path;
+    if (this._authority !== null && path.length > 0 && !path.startsWith('/')) {
+      path = '/' + path;
+    }
+    return Uri.fromParts(this._scheme, this._authority, path, this._query.length > 0 ? this._query.join('&') : null);
+  }
+}
