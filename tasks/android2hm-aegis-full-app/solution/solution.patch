index 0000000..50ff3f4
--- /dev/null
+++ b/entry/src/main/ets/encoding/Base32.ets
@@ -0,0 +1,65 @@
+import { EncodingException } from './EncodingException';
+import { Bytes } from '../util/Bytes';
+
+const ALPHABET: string = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
+
+export class Base32 {
+  private constructor() {
+  }
+
+  static decode(s: string): Uint8Array {
+    let str = s.toUpperCase();
+    // strip trailing padding
+    let end = str.length;
+    while (end > 0 && str.charAt(end - 1) === '=') {
+      end--;
+    }
+    if (end !== str.length && str.length % 8 !== 0) {
+      throw new EncodingException('Invalid input length');
+    }
+    str = str.substring(0, end);
+    const rem = str.length % 8;
+    if (rem === 1 || rem === 3 || rem === 6) {
+      throw new EncodingException(`Invalid input length ${str.length}`);
+    }
+
+    const out: number[] = [];
+    let buffer = 0;
+    let bitsLeft = 0;
+    for (let i = 0; i < str.length; i++) {
+      const val = ALPHABET.indexOf(str.charAt(i));
+      if (val < 0) {
+        throw new EncodingException(`Unrecognized character: ${str.charAt(i)}`);
+      }
+      buffer = ((buffer << 5) | val) & 0xffff;
+      bitsLeft += 5;
+      if (bitsLeft >= 8) {
+        out.push((buffer >> (bitsLeft - 8)) & 0xff);
+        bitsLeft -= 8;
+      }
+    }
+    return new Uint8Array(out);
+  }
+
+  static encode(data: Uint8Array): string {
+    let res = '';
+    let buffer = 0;
+    let bitsLeft = 0;
+    for (let i = 0; i < data.length; i++) {
+      buffer = ((buffer << 8) | data[i]) & 0xffff;
+      bitsLeft += 8;
+      while (bitsLeft >= 5) {
+        res += ALPHABET.charAt((buffer >> (bitsLeft - 5)) & 0x1f);
+        bitsLeft -= 5;
+      }
+    }
+    if (bitsLeft > 0) {
+      res += ALPHABET.charAt((buffer << (5 - bitsLeft)) & 0x1f);
+    }
+    return res;
+  }
+
+  static encodeString(s: string): string {
+    return Base32.encode(Bytes.fromUtf8(s));
+  }
+}
diff --git a/entry/src/main/ets/encoding/Base64.ets b/entry/src/main/ets/encoding/Base64.ets
new file mode 100644
index 0000000..af12190
--- /dev/null
+++ b/entry/src/main/ets/encoding/Base64.ets
@@ -0,0 +1,84 @@
+import { EncodingException } from './EncodingException';
+import { Bytes } from '../util/Bytes';
+
+const ALPHABET: string = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
+
+export class Base64 {
+  private constructor() {
+  }
+
+  static decode(s: string): Uint8Array {
+    return Base64.decodeWith(s, ALPHABET);
+  }
+
+  static decodeBytes(s: Uint8Array): Uint8Array {
+    return Base64.decode(Bytes.toUtf8(s));
+  }
+
+  /**
+   * Decodes URL-safe base64 (as used by some importers).
+   */
+  static decodeUrlSafe(s: string): Uint8Array {
+    return Base64.decodeWith(s.replace(new RegExp('-', 'g'), '+').replace(new RegExp('_', 'g'), '/'), ALPHABET);
+  }
+
+  /**
+   * Lenient decoding that ignores whitespace (like android.util.Base64.DEFAULT).
+   */
+  static decodeLenient(s: string): Uint8Array {
+    return Base64.decode(s.replace(new RegExp('\\s', 'g'), ''));
+  }
+
+  private static decodeWith(s: string, alphabet: string): Uint8Array {
+    let end = s.length;
+    while (end > 0 && s.charAt(end - 1) === '=') {
+      end--;
+    }
+    if (end !== s.length && s.length % 4 !== 0) {
+      throw new EncodingException('Invalid input length');
+    }
+    const str = s.substring(0, end);
+    if (str.length % 4 === 1) {
+      throw new EncodingException(`Invalid input length ${str.length}`);
+    }
+    const out: number[] = [];
+    let buffer = 0;
+    let bits = 0;
+    for (let i = 0; i < str.length; i++) {
+      const val = alphabet.indexOf(str.charAt(i));
+      if (val < 0) {
+        throw new EncodingException(`Unrecognized character: ${str.charAt(i)}`);
+      }
+      buffer = ((buffer << 6) | val) & 0xffffff;
+      bits += 6;
+      if (bits >= 8) {
+        out.push((buffer >> (bits - 8)) & 0xff);
+        bits -= 8;
+      }
+    }
+    return new Uint8Array(out);
+  }
+
+  static encode(data: Uint8Array): string {
+    let res = '';
+    let i = 0;
+    for (; i + 2 < data.length; i += 3) {
+      const n = (data[i] << 16) | (data[i + 1] << 8) | data[i + 2];
+      res += ALPHABET.charAt((n >> 18) & 63) + ALPHABET.charAt((n >> 12) & 63) +
+        ALPHABET.charAt((n >> 6) & 63) + ALPHABET.charAt(n & 63);
+    }
+    const rem = data.length - i;
+    if (rem === 1) {
+      const n = data[i] << 16;
+      res += ALPHABET.charAt((n >> 18) & 63) + ALPHABET.charAt((n >> 12) & 63) + '==';
+    } else if (rem === 2) {
+      const n = (data[i] << 16) | (data[i + 1] << 8);
+      res += ALPHABET.charAt((n >> 18) & 63) + ALPHABET.charAt((n >> 12) & 63) + ALPHABET.charAt((n >> 6) & 63) + '=';
+    }
+    return res;
+  }
+
+  static encodeUrlSafe(data: Uint8Array): string {
+    return Base64.encode(data).replace(new RegExp('\\+', 'g'), '-').replace(new RegExp('/', 'g'), '_');
+  }
+}
