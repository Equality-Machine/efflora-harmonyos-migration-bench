+}
+
+/**
+ * Port of MainActivity: the entry list with search, sorting, group filters, the action mode for
+ * selected entries and the floating action button menu to add new entries.
+ */
+@Entry
+@Component
+struct MainActivity {
+  private _activity: AegisActivity = new AegisActivity(this.getUIContext(), PAGE_MAIN);
+  private _entryListView: EntryListView = new EntryListView();
+  private _lockListener: MainLockListener = new MainLockListener((u: boolean) => this.onLocked(u));
+  private _fabMenuHelper: FabMenuHelper = new FabMenuHelper([]);
