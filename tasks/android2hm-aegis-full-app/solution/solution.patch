+ * skipped, entity references are resolved and adjacent text/CDATA sections are reported as one
+ * TEXT event. Empty element tags (<a/>) are reported as a START_TAG followed by an END_TAG.
+ */
+export class XmlPullParser {
+  static readonly START_DOCUMENT: number = 0;
+  static readonly END_DOCUMENT: number = 1;
+  static readonly START_TAG: number = 2;
+  static readonly END_TAG: number = 3;
+  static readonly TEXT: number = 4;
+  static readonly FEATURE_PROCESS_NAMESPACES: string = 'http://xmlpull.org/v1/doc/features.html#process-namespaces';
+  private _src: string = '';
+  private _pos: number = 0;
+  private _eventType: number = XmlPullParser.START_DOCUMENT;
+  private _name: string | null = null;
+  private _text: string | null = null;
+  private _attributes: XmlAttribute[] = [];
+  private _depth: number = 0;
+  private _pendingEndTag: string | null = null;
+  private _openTags: string[] = [];
+
+  /**
+   * Replacement for android.util.Xml.newPullParser().
+   */
+  static newPullParser(): XmlPullParser {
+    return new XmlPullParser();
+  }
+
+  setFeature(name: string, state: boolean): void {
+    if (name === XmlPullParser.FEATURE_PROCESS_NAMESPACES && state) {
+      throw new XmlPullParserException('Namespace processing is not supported');
+    }
+  }
+
+  /**
+   * Sets the input from raw bytes. The encoding is assumed to be UTF-8 (a BOM is skipped).
+   */
+  setInput(data: Uint8Array, encoding?: string | null): void {
+    if (encoding !== undefined && encoding !== null && encoding.toUpperCase() !== 'UTF-8') {
+      throw new XmlPullParserException(`Unsupported encoding: ${encoding}`);
+    }
+    this.setInputString(Bytes.toUtf8(data));
+  }
+
+  setInputString(s: string): void {
+    this._src = s.length > 0 && s.charCodeAt(0) === 0xfeff ? s.substring(1) : s;
+    this._pos = 0;
+    this._eventType = XmlPullParser.START_DOCUMENT;
+    this._name = null;
+    this._text = null;
+    this._attributes = [];
+    this._depth = 0;
+    this._pendingEndTag = null;
+    this._openTags = [];
+  }
+
+  getEventType(): number {
+    return this._eventType;
+  }
+
+  getName(): string | null {
+    return this._name;
+  }
+
+  getText(): string | null {
+    return this._text;
+  }
+
+  getDepth(): number {
+    return this._depth;
+  }
+
+  isWhitespace(): boolean {
+    if (this._eventType !== XmlPullParser.TEXT || this._text === null) {
+      throw new XmlPullParserException('Not a text event');
+    }
+    return this._text.trim().length === 0;
+  }
+
+  getAttributeCount(): number {
+    return this._eventType === XmlPullParser.START_TAG ? this._attributes.length : -1;
+  }
+
+  getAttributeName(index: number): string {
+    return this._attributes[index].name;
+  }
+
+  getAttributeValueAt(index: number): string {
+    return this._attributes[index].value;
+  }
+
+  getAttributeValue(namespace: string | null, name: string): string | null {
+    if (this._eventType !== XmlPullParser.START_TAG) {
+      throw new XmlPullParserException('Current event is not START_TAG');
+    }
