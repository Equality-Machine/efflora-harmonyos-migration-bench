+  @State _kropView: KropViewController = new KropViewController();
+
+  // fields
+  @State _textName: string = '';
+  @State _textIssuer: string = '';
+  @State _textGroup: string = '';
+  @State _textNote: string = '';
+  @State _textSecret: string = '';
+  @State _textPin: string = '';
+  @State _textPeriodCounter: string = '';
+  @State _textDigits: string = '';
+  @State _textUsageCount: string = '0';
+  @State _textLastUsed: string = '';
+  @State _dropdownType: string = '';
+  @State _dropdownAlgo: string = '';
+  @State _periodCounterHint: Resource = $r('app.string.period_hint');
+  @State _pinHint: Resource = $r('app.string.yandex_pin');
+  @State _pinVisible: boolean = false;
+  @State _advancedFieldsEnabled: boolean = true;
+
+  // layout
+  @State _secretInAdvanced: boolean = false;
+  @State _pinInAdvanced: boolean = false;
+  @State _advancedLayoutEnabled: boolean = true;
+  @State _advancedHeaderVisible: boolean = true;
+  @State _advancedHeaderOpacity: number = 1;
+  @State _advancedLayoutVisible: boolean = false;
+  @State _advancedLayoutOpacity: number = 0;
+
+  aboutToAppear(): void {
+    this._activity = new AegisActivity(this.getUIContext(), PAGE_EDIT_ENTRY);
+    this.onCreate();
+  }
+
+  onPageShow(): void {
+    if (this._activity !== null) {
+      this._activity.onResume();
+    }
+  }
+
+  aboutToDisappear(): void {
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  onBackPress(): boolean {
+    // the handler that was registered last has priority (like the OnBackPressedDispatcher)
+    if (this._iconBackPressHandler.isEnabled()) {
+      this._iconBackPressHandler.handleOnBackPressed();
+      return true;
+    }
+    if (this._backPressHandler.isEnabled()) {
+      this._backPressHandler.handleOnBackPressed();
+      return true;
+    }
+    return false;
+  }
+
+  private act(): AegisActivity {
+    return this._activity as AegisActivity;
+  }
+
+  private str(name: string, args?: Array<string | number>): string {
+    return ResUtils.getString(AegisModule.getContext(), name, args);
+  }
+
+  private onCreate(): void {
+    const activity = this.act();
+    activity.onCreate();
+    if (activity.abortIfOrphan()) {
+      return;
+    }
+
+    const vault = activity.getVaultManager().getVault();
+    this._groups = vault.getGroups();
+
+    // retrieve info from the calling page
+    const intent = activity.getIntent();
+    const entryUUID = intent.getStringExtra('entryUUID');
+    let origEntry: VaultEntry | null = null;
+    if (entryUUID !== null) {
+      try {
+        origEntry = vault.getEntryByUUID(entryUUID);
+      } catch (e) {
+        origEntry = null;
+      }
+    } else {
+      const newEntry = intent.getExtra('newEntry');
+      origEntry = newEntry instanceof VaultEntry ? newEntry as VaultEntry : null;
+      this._isManual = intent.getBooleanExtra('isManual', false);
+      this._isNew = true;
+      this._title = $r('app.string.add_new_entry');
+    }
+    if (origEntry === null) {
+      activity.finish();
+      return;
+    }
+    this._origEntry = origEntry;
+
+    const context = AegisModule.getContext();
+    this._typeOptions = DropdownHelper.fillDropdown(context, 'otp_types_array');
+    this._typeValues = ResUtils.getStringArray(context, 'otp_types_array');
+    this._algoOptions = DropdownHelper.fillDropdown(context, 'otp_algo_array');
+    this._algoValues = ResUtils.getStringArray(context, 'otp_algo_array');
+
+    // if this is NOT a manually entered entry, move the "Secret" field from basic to advanced settings
+    if (!this._isNew || !this._isManual) {
+      this._secretInAdvanced = true;
+      if (!this._isNew) {
+        this._pinInAdvanced = true;
+      }
+      if (this._isNew && !this._isManual) {
+        this._advancedLayoutEnabled = false;
+      }
+    }
+
+    // fill the fields with values if possible
+    this._iconKey = GlideHelper.getEntryIconKey(origEntry);
+    this._iconMode = ICON_MODE_ENTRY;
+    if (origEntry.hasIcon()) {
+      this._hasCustomIcon = true;
