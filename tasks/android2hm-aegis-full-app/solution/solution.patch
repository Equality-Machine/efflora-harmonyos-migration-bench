+export type FabMenuAction = () => void;
+
+export class FabMenuItem {
+  id: string;
+  label: Resource;
+  icon: Resource;
+  action: FabMenuAction;
+
+  constructor(id: string, label: Resource, icon: Resource, action: FabMenuAction) {
+    this.id = id;
+    this.label = label;
+    this.icon = icon;
+    this.action = action;
+  }
+}
+
+/**
+ * Port of FabMenuHelper: manages the state of the expandable floating action button menu
+ * (scan QR code, scan image, enter manually) and its scrim.
+ */
+export class FabMenuHelper {
+  private _open: boolean = false;
+  private _actions: FabMenuItem[];
+  private _listener: ((open: boolean) => void) | null = null;
+
+  constructor(actions: FabMenuItem[]) {
+    this._actions = actions;
+  }
+
+  setOnFabMenuStateChangeListener(listener: (open: boolean) => void): void {
+    this._listener = listener;
+  }
+
+  getActions(): FabMenuItem[] {
+    return this._actions;
+  }
+
+  isOpen(): boolean {
+    return this._open;
+  }
+
+  toggle(): void {
+    if (this._open) {
+      this.close();
+    } else {
+      this.open();
+    }
+  }
+
+  open(): void {
+    this.setOpen(true);
+  }
+
+  close(): void {
+    this.setOpen(false);
+  }
+
+  onItemClick(item: FabMenuItem): void {
+    this.close();
+    item.action();
+  }
+
+  private setOpen(open: boolean): void {
+    if (this._open === open) {
+      return;
+    }
+    this._open = open;
+    if (this._listener !== null) {
+      this._listener(open);
+    }
+  }
+}
