@@ -0,0 +1,32 @@
+import { common } from '@kit.AbilityKit';
+import { ResUtils } from './ResUtils';
+
+export class TimeUtils {
+  private constructor() {
+  }
+
+  static getElapsedSince(context: common.Context, date: Date): string {
+    let since = Math.floor((Date.now() - date.getTime()) / 1000);
+    if (since < 60) {
+      return TimeUtils.formatElapsedSince(context, since, 'seconds');
+    }
+    since = Math.floor(since / 60);
+    if (since < 60) {
+      return TimeUtils.formatElapsedSince(context, since, 'minutes');
+    }
+    since = Math.floor(since / 60);
+    if (since < 24) {
+      return TimeUtils.formatElapsedSince(context, since, 'hours');
+    }
+    since = Math.floor(since / 24);
+    if (since < 365) {
+      return TimeUtils.formatElapsedSince(context, since, 'days');
+    }
+    since = Math.floor(since / 365);
+    return TimeUtils.formatElapsedSince(context, since, 'years');
+  }
+
+  private static formatElapsedSince(context: common.Context, since: number, unit: string): string {
+    return ResUtils.getQuantityString(context, `time_elapsed_${unit}`, since);
+  }
+}
