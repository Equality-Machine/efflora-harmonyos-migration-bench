+import { ProgressDialogTask } from './ProgressDialogTask';
+import { PasswordSlot } from '../../vault/slots/PasswordSlot';
+import { CryptoUtils, SecretKey } from '../../crypto/CryptoUtils';
+import { SCryptParameters } from '../../crypto/SCryptParameters';
+
+export type KeyDerivationCallback = (slot: PasswordSlot, key: SecretKey | null, error: Error | null) => void;
+
+export class KeyDerivationTask extends ProgressDialogTask {
+  private _cb: KeyDerivationCallback;
+
+  constructor(uiContext: UIContext, cb: KeyDerivationCallback) {
+    super(uiContext, $r('app.string.encrypting_vault'));
+    this._cb = cb;
+  }
+
+  execute(slot: PasswordSlot, password: string): void {
+    this.run<SecretKey>(async () => KeyDerivationTask.doInBackground(slot, password))
+      .then((key: SecretKey) => this._cb(slot, key, null))
+      .catch((e: Error) => this._cb(slot, null, e));
+  }
+
+  static async doInBackground(slot: PasswordSlot, password: string): Promise<SecretKey> {
+    const salt = CryptoUtils.generateSalt();
+    const scryptParams = new SCryptParameters(
+      CryptoUtils.CRYPTO_SCRYPT_N,
+      CryptoUtils.CRYPTO_SCRYPT_r,
+      CryptoUtils.CRYPTO_SCRYPT_p,
+      salt
+    );
+    return slot.deriveKeyWithParams(password, scryptParams);
+  }
+}
diff --git a/entry/src/main/ets/ui/tasks/PBKDFTask.ets b/entry/src/main/ets/ui/tasks/PBKDFTask.ets
new file mode 100644
index 0000000..8db3fe8
--- /dev/null
+++ b/entry/src/main/ets/ui/tasks/PBKDFTask.ets
@@ -0,0 +1,107 @@
+import { ProgressDialogTask } from './ProgressDialogTask';
+import { CryptoUtils, SecretKey } from '../../crypto/CryptoUtils';
+
+export type PBKDFTaskCallback = (key: SecretKey) => void;
+
+export type PBKDFTaskErrorCallback = (e: Error) => void;
+
+export class PBKDFTaskParams {
+  private readonly _algorithm: string;
+  private readonly _keySize: number;
+  private readonly _password: string;
+  private readonly _salt: Uint8Array;
+  private readonly _iterations: number;
+
+  /**
+   * @param algorithm the name of the Java algorithm (e.g. PBKDF2WithHmacSHA1, PBKDF2withHmacSHA512)
+   * @param keySize the size of the key in bits
+   */
+  constructor(algorithm: string, keySize: number, password: string, salt: Uint8Array, iterations: number) {
+    this._algorithm = algorithm;
+    this._keySize = keySize;
+    this._iterations = iterations;
+    this._password = password;
+    this._salt = salt;
+  }
+
+  getAlgorithm(): string {
+    return this._algorithm;
+  }
+
+  getKeySize(): number {
+    return this._keySize;
+  }
+
+  getPassword(): string {
+    return this._password;
+  }
+
+  getIterations(): number {
+    return this._iterations;
+  }
+
+  getSalt(): Uint8Array {
+    return this._salt;
+  }
+}
+
+export class PBKDFTask extends ProgressDialogTask {
+  private readonly _cb: PBKDFTaskCallback;
+  private readonly _errorCb: PBKDFTaskErrorCallback | null;
+
+  constructor(uiContext: UIContext, cb: PBKDFTaskCallback, errorCb?: PBKDFTaskErrorCallback) {
+    super(uiContext, $r('app.string.unlocking_vault'));
+    this._cb = cb;
+    this._errorCb = errorCb !== undefined ? errorCb : null;
+  }
+
+  execute(params: PBKDFTaskParams): void {
+    this.run<SecretKey>(async () => PBKDFTask.doInBackground(params))
+      .then((key: SecretKey) => this.onTaskFinished(key))
+      .catch((e: Error) => {
+      if (this._errorCb !== null) {
+        this._errorCb(e);
+      }
+    });
+  }
+
+  private onTaskFinished(key: SecretKey): void {
+    this._cb(key);
+  }
+
+  static async doInBackground(params: PBKDFTaskParams): Promise<SecretKey> {
+    return PBKDFTask.deriveKey(params);
+  }
+
+  /**
+   * Derives a key using PBKDF2. The key derivation itself runs natively (cryptoFramework).
+   */
+  static async deriveKey(params: PBKDFTaskParams): Promise<SecretKey> {
+    const digest = PBKDFTask.getDigest(params.getAlgorithm());
+    const key = await CryptoUtils.pbkdf2(digest, CryptoUtils.toBytes(params.getPassword()), params.getSalt(), params.getIterations(), params.getKeySize() / 8);
+    return new SecretKey(key);
+  }
+
+  /**
+   * Maps a Java PBKDF2 algorithm name to the name of the digest used by cryptoFramework.
+   */
+  static getDigest(algorithm: string): string {
+    const algo = algorithm.toUpperCase();
+    if (algo === 'PBKDF2WITHHMACSHA1') {
+      return 'SHA1';
+    }
+    else if (algo === 'PBKDF2WITHHMACSHA224') {
+      return 'SHA224';
+    }
+    else if (algo === 'PBKDF2WITHHMACSHA256') {
+      return 'SHA256';
+    }
+    else if (algo === 'PBKDF2WITHHMACSHA384') {
+      return 'SHA384';
+    }
+    else if (algo === 'PBKDF2WITHHMACSHA512') {
+      return 'SHA512';
+    }
+    throw new Error(`Unsupported PBKDF2 algorithm: ${algorithm}`);
+  }
+}
diff --git a/entry/src/main/ets/ui/tasks/PasswordSlotDecryptTask.ets b/entry/src/main/ets/ui/tasks/PasswordSlotDecryptTask.ets
new file mode 100644
index 0000000..1904fb9
--- /dev/null
+++ b/entry/src/main/ets/ui/tasks/PasswordSlotDecryptTask.ets
@@ -0,0 +1,95 @@
+import { ProgressDialogTask } from './ProgressDialogTask';
+import { PasswordSlot } from '../../vault/slots/PasswordSlot';
+import { Slot } from '../../vault/slots/Slot';
+import { SlotIntegrityException } from '../../vault/slots/SlotIntegrityException';
+import { MasterKey } from '../../crypto/MasterKey';
+import { CryptoUtils, SecretKey } from '../../crypto/CryptoUtils';
+
+export class PasswordSlotDecryptResult {
+  private _key: MasterKey;
+  private _slot: PasswordSlot;
+  private _repaired: boolean;
+
+  constructor(key: MasterKey, slot: PasswordSlot, repaired: boolean) {
+    this._key = key;
+    this._slot = slot;
+    this._repaired = repaired;
+  }
+
+  getKey(): MasterKey {
+    return this._key;
+  }
+
+  getSlot(): Slot {
+    return this._slot;
+  }
+
+  isSlotRepaired(): boolean {
+    return this._repaired;
+  }
+}
+
+export type PasswordSlotDecryptCallback = (result: PasswordSlotDecryptResult | null, error: Error | null) => void;
+
+export class PasswordSlotDecryptTask extends ProgressDialogTask {
+  private _cb: PasswordSlotDecryptCallback;
+
+  constructor(uiContext: UIContext, cb: PasswordSlotDecryptCallback) {
+    super(uiContext, $r('app.string.unlocking_vault'));
+    this._cb = cb;
+  }
+
+  execute(slots: PasswordSlot[], password: string): void {
+    this.run<PasswordSlotDecryptResult | null>(async () => PasswordSlotDecryptTask.decrypt(slots, password))
+      .then((res: PasswordSlotDecryptResult | null) => this._cb(res, null))
+      .catch((e: Error) => this._cb(null, e));
+  }
+
+  static async decrypt(slots: PasswordSlot[], password: string): Promise<PasswordSlotDecryptResult | null> {
+    for (const slot of slots) {
+      try {
+        return await PasswordSlotDecryptTask.decryptPasswordSlot(slot, password);
+      } catch (e) {
+        if (!(e instanceof SlotIntegrityException)) {
+          throw e as Error;
+        }
+      }
+    }
+    return null;
+  }
+
+  static async decryptPasswordSlot(slot: PasswordSlot, password: string): Promise<PasswordSlotDecryptResult> {
+    let masterKey: MasterKey;
+    const key = await slot.deriveKey(password);
+    const oldPasswordBytes = CryptoUtils.toBytesOld(password);
+    try {
+      masterKey = await PasswordSlotDecryptTask.decryptPasswordSlotWithKey(slot, key);
+    } catch (e) {
+      // a bug introduced in afb9e59 caused passwords longer than 64 bytes to produce a different key than before
+      // so, try again with the old password encode function if the password is longer than 64 bytes
+      if (!(e instanceof SlotIntegrityException) || slot.isRepaired() || oldPasswordBytes.length <= 64) {
+        throw e as Error;
+      }
+
+      // try to decrypt the password slot with the old key
+      const oldKey = await slot.deriveKeyFromBytes(oldPasswordBytes);
+      masterKey = await PasswordSlotDecryptTask.decryptPasswordSlotWithKey(slot, oldKey);
+    }
+
+    // if necessary, repair the slot by re-encrypting the master key with the correct key
+    // slots with passwords smaller than 64 bytes also get this treatment to make sure those also have 'repaired' set to true
+    let repaired = false;
+    if (!slot.isRepaired()) {
+      const cipher = Slot.createEncryptCipher(key);
+      await slot.setKey(masterKey, cipher);
+      repaired = true;
+    }
+
+    return new PasswordSlotDecryptResult(masterKey, slot, repaired);
+  }
+
+  static async decryptPasswordSlotWithKey(slot: PasswordSlot, key: SecretKey): Promise<MasterKey> {
+    const cipher = slot.createDecryptCipher(key);
+    return slot.getKey(cipher);
+  }
+}
diff --git a/entry/src/main/ets/ui/tasks/ProgressDialogTask.ets b/entry/src/main/ets/ui/tasks/ProgressDialogTask.ets
