+export class SCryptParameters {
+  private _n: number;
+  private _r: number;
+  private _p: number;
+  private _salt: Uint8Array;
+
+  constructor(n: number, r: number, p: number, salt: Uint8Array) {
+    this._n = n;
+    this._r = r;
+    this._p = p;
+    this._salt = salt;
+  }
+
+  getSalt(): Uint8Array {
+    return this._salt;
+  }
+
+  getN(): number {
+    return this._n;
+  }
+
+  getR(): number {
+    return this._r;
+  }
+
+  getP(): number {
+    return this._p;
+  }
+}
