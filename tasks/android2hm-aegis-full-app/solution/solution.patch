index 0000000..e2ae3d7
--- /dev/null
+++ b/entry/src/main/ets/crypto/otp/HOTP.ets
@@ -0,0 +1,32 @@
+import { OTP } from './OTP';
+import { CryptoUtils } from '../CryptoUtils';
+import { Bytes } from '../../util/Bytes';
+
+export class HOTP {
+  private constructor() {
+  }
+
+  static generateOTP(secret: Uint8Array, algo: string, digits: number, counter: number): OTP {
+    const hash = HOTP.getHash(secret, algo, counter);
+
+    // truncate hash to get the HTOP value
+    // http://tools.ietf.org/html/rfc4226#section-5.4
+    const offset = hash[hash.length - 1] & 0xf;
+    const otp = ((hash[offset] & 0x7f) << 24)
+      | ((hash[offset + 1] & 0xff) << 16)
+      | ((hash[offset + 2] & 0xff) << 8)
+      | (hash[offset + 3] & 0xff);
+
+    return new OTP(otp, digits);
+  }
+
+  /**
+   * @param algo the algorithm name in Java notation ("HmacSHA1") or plain ("SHA1").
+   */
+  static getHash(secret: Uint8Array, algo: string, counter: number): Uint8Array {
+    const name = algo.startsWith('Hmac') ? algo.substring(4) : algo;
+    // encode counter in big endian
+    const counterBytes = Bytes.longToBytesBE(counter);
+    return CryptoUtils.hmac(name, secret, counterBytes);
+  }
+}
