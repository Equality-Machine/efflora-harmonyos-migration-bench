@@ -0,0 +1,45 @@
+import { pasteboard } from '@kit.BasicServicesKit';
+
+export class ClipboardUtils {
+  private constructor() {
+  }
+
+  /**
+   * Reads the text that's currently on the clipboard, or null if there is none or it couldn't be read.
+   */
+  static async readText(): Promise<string | null> {
+    try {
+      const board = pasteboard.getSystemPasteboard();
+      if (!board.hasDataSync()) {
+        return null;
+      }
+      const data = await board.getData();
+      if (data.getRecordCount() === 0) {
+        return null;
+      }
+      const text = data.getPrimaryText();
+      if (text === undefined || text === null) {
+        return null;
+      }
+      const trimmed = text.trim();
+      return trimmed.length === 0 ? null : trimmed;
+    } catch (e) {
+      return null;
+    }
+  }
+
+  /**
+   * Copies the given text to the clipboard. The data is marked as only being shareable within the
+   * current device, which is the closest equivalent to ClipDescription.EXTRA_IS_SENSITIVE.
+   */
+  static copyText(text: string, sensitive: boolean): void {
+    const data = pasteboard.createData(pasteboard.MIMETYPE_TEXT_PLAIN, text);
+    if (sensitive) {
+      const props = data.getProperty();
+      props.shareOption = pasteboard.ShareOption.LOCALDEVICE;
+      data.setProperty(props);
+    }
+    pasteboard.getSystemPasteboard().setData(data).catch(() => {
+    });
+  }
+}
