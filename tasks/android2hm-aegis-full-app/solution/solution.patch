diff --git a/entry/src/main/ets/helpers/comparators/Comparator.ets b/entry/src/main/ets/helpers/comparators/Comparator.ets
new file mode 100644
index 0000000..81ee1e1
--- /dev/null
+++ b/entry/src/main/ets/helpers/comparators/Comparator.ets
@@ -0,0 +1,70 @@
+export interface Comparator<T> {
+  compare(a: T, b: T): number;
+}
+
+export class Comparators {
+  static thenComparing<T>(first: Comparator<T>, second: Comparator<T>): Comparator<T> {
+    return new ChainedComparator<T>(first, second);
+  }
+
+  static reverseOrder<T>(cmp: Comparator<T>): Comparator<T> {
+    return new ReversedComparator<T>(cmp);
+  }
+
+  static compareIgnoreCase(a: string, b: string): number {
+    const la = a.toLowerCase();
+    const lb = b.toLowerCase();
+    return la < lb ? -1 : (la > lb ? 1 : 0);
+  }
+
+  /**
+   * Stable sort (Collections.sort semantics).
+   */
+  static sort<T>(list: T[], cmp: Comparator<T>): void {
+    const indexed: IndexedItem<T>[] = list.map((v: T, i: number) => new IndexedItem<T>(v, i));
+    indexed.sort((x: IndexedItem<T>, y: IndexedItem<T>) => {
+      const c = cmp.compare(x.value, y.value);
+      return c !== 0 ? c : x.index - y.index;
+    });
+    for (let i = 0; i < indexed.length; i++) {
+      list[i] = indexed[i].value;
+    }
+  }
+}
+
+class IndexedItem<T> {
+  value: T;
+  index: number;
+
+  constructor(value: T, index: number) {
+    this.value = value;
+    this.index = index;
+  }
+}
+
+class ChainedComparator<T> implements Comparator<T> {
+  private _first: Comparator<T>;
+  private _second: Comparator<T>;
+
+  constructor(first: Comparator<T>, second: Comparator<T>) {
+    this._first = first;
+    this._second = second;
+  }
+
+  compare(a: T, b: T): number {
+    const c = this._first.compare(a, b);
+    return c !== 0 ? c : this._second.compare(a, b);
+  }
+}
+
+class ReversedComparator<T> implements Comparator<T> {
+  private _cmp: Comparator<T>;
+
+  constructor(cmp: Comparator<T>) {
+    this._cmp = cmp;
+  }
+
+  compare(a: T, b: T): number {
+    return this._cmp.compare(b, a);
+  }
+}
