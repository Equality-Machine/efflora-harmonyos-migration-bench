+import { common, Want, bundleManager } from '@kit.AbilityKit';
+import { AegisActivity, PAGE_ABOUT, PAGE_LICENSES } from './AegisActivity';
+import { Intent } from './Intent';
+import { Toolbar } from './components/Toolbar';
+import { LicenseDialog } from './dialogs/LicenseDialog';
+import { ChangelogDialog } from './dialogs/ChangelogDialog';
+import { ThemeHelper } from '../helpers/ThemeHelper';
+import { ClipboardUtils } from '../util/ClipboardUtils';
+import { AegisModule } from '../AegisModule';
+import { ContextHelper } from '../helpers/ContextHelper';
+
+const GITHUB: string = 'https://github.com/beemdevelopment/Aegis';
+const WEBSITE_ALEXANDER: string = 'https://alexbakker.me';
+const GITHUB_MICHAEL: string = 'https://github.com/michaelschattgen';
+const MAIL_BEEMDEVELOPMENT: string = 'beemdevelopment@gmail.com';
+const WEBSITE_BEEMDEVELOPMENT: string = 'https://beem.dev/';
+const PLAYSTORE_BEEMDEVELOPMENT: string = 'https://play.google.com/store/apps/details?id=com.beemdevelopment.aegis';
+
+/**
+ * Port of AboutActivity.
+ */
+@Entry
+@Component
+struct AboutActivity {
+  private _activity: AegisActivity = new AegisActivity(this.getUIContext(), PAGE_ABOUT);
+
+  aboutToAppear(): void {
+    this._activity.onCreate();
+    this._activity.abortIfOrphan();
+  }
+
+  onPageShow(): void {
+    this._activity.onResume();
+  }
+
+  aboutToDisappear(): void {
+    this._activity.onDestroy();
+  }
+
+  private static getCurrentAppVersion(): string {
+    try {
+      const info = bundleManager.getBundleInfoForSelfSync(bundleManager.BundleFlag.GET_BUNDLE_INFO_DEFAULT);
+      return info.versionName;
+    } catch (e) {
+      return '';
+    }
+  }
+
+  private openUrl(url: string): void {
+    const want: Want = {
+      action: 'ohos.want.action.viewData',
+      entities: ['entity.system.browsable'],
+      uri: url
+    };
+    const context = ContextHelper.getUIAbilityContext();
+    if (context !== null) {
+      context.startAbility(want).catch(() => {
+      });
+    }
+  }
+
+  private copyToClipboard(text: string, message: Resource): void {
+    ClipboardUtils.copyText(text, false);
+    this._activity.showToast(message);
+  }
+
+  private openMail(mailaddress: string): void {
+    const want: Want = {
+      action: 'ohos.want.action.sendToData',
+      uri: `mailto:${mailaddress}?subject=${encodeURIComponent(this._activity.getString('app_name_full'))}`
+    };
+    AegisModule.getAbilityContext().startAbility(want).catch(() => {
+      this.copyToClipboard(mailaddress, $r('app.string.email'));
+    });
+  }
+
+  @Builder
+  Header(title: Resource) {
+    Text(title)
+      .fontSize(14)
+      .fontColor($r('app.color.theme_primary'))
+      .width('100%')
+      .padding({ left: 16, top: 24, bottom: 8 })
+  }
+
+  @Builder
+  Item(icon: Resource, title: ResourceStr, summary: ResourceStr, action: () => void) {
+    Row() {
+      Image(icon)
+        .width(24)
+        .height(24)
+        .fillColor($r('app.color.theme_onSurfaceVariant'))
+        .margin({ right: 24 })
+      Column() {
+        Text(title)
+          .fontSize(16)
+          .fontColor($r('app.color.theme_onSurface'))
+        if (summary !== '') {
+          Text(summary)
+            .fontSize(13)
+            .fontColor($r('app.color.theme_onSurfaceVariant'))
+        }
+      }
+      .alignItems(HorizontalAlign.Start)
+      .layoutWeight(1)
+    }
+    .width('100%')
+    .padding({ left: 16, right: 16, top: 12, bottom: 12 })
+    .onClick(action)
+  }
+
+  build() {
+    Column() {
+      Toolbar({ title: $r('app.string.title_activity_about'), onBack: () => this._activity.finish() })
+      Scroll() {
+        Column() {
+          Image($r('app.media.app_icon'))
+            .width(96)
+            .height(96)
+            .margin({ top: 24 })
+          Text($r('app.string.app_name_full'))
+            .fontSize(22)
+            .fontColor($r('app.color.theme_onSurface'))
+            .margin({ top: 12 })
+          this.Header($r('app.string.app_name'))
+          this.Item($r('app.media.ic_outline_info_24'), $r('app.string.version'), AboutActivity.getCurrentAppVersion(),
+            () => this.copyToClipboard(AboutActivity.getCurrentAppVersion(), $r('app.string.version_copied')))
+          this.Item($r('app.media.ic_outline_history_24'), $r('app.string.changelog'), $r('app.string.whats_new'), () => {
+            ChangelogDialog.create().setTheme(this._activity.getThemeHelper().getConfiguredTheme()).show(this.getUIContext());
+          })
+          this.Item($r('app.media.ic_outline_code_24'), $r('app.string.github'), $r('app.string.github_description'),
+            () => this.openUrl(GITHUB))
+          this.Item($r('app.media.ic_outline_description_24'), $r('app.string.license'), $r('app.string.license_description'), () => {
+            LicenseDialog.create().setTheme(this._activity.getThemeHelper().getConfiguredTheme()).show(this.getUIContext());
+          })
+          this.Item($r('app.media.ic_outline_layers_24'), $r('app.string.third_party_licenses'),
+            $r('app.string.third_party_licenses_description'), () => this._activity.startActivity(new Intent(PAGE_LICENSES)))
+          this.Header($r('app.string.org_name_full'))
+          this.Item($r('app.media.ic_outline_person_24'), $r('app.string.author_alex'), $r('app.string.country_netherlands'),
+            () => this.openUrl(WEBSITE_ALEXANDER))
+          this.Item($r('app.media.ic_outline_person_24'), $r('app.string.author_michael'), $r('app.string.country_netherlands'),
+            () => this.openUrl(GITHUB_MICHAEL))
+          this.Item($r('app.media.ic_outline_mail_24'), $r('app.string.email_us'), MAIL_BEEMDEVELOPMENT,
+            () => this.openMail(MAIL_BEEMDEVELOPMENT))
+          this.Item($r('app.media.ic_outline_public_24'), $r('app.string.visit_website'), WEBSITE_BEEMDEVELOPMENT,
+            () => this.openUrl(WEBSITE_BEEMDEVELOPMENT))
+          this.Header($r('app.string.about_support'))
+          this.Item($r('app.media.ic_outline_star_24'), $r('app.string.support_rate'), $r('app.string.support_rate_description'),
+            () => this.openUrl(PLAYSTORE_BEEMDEVELOPMENT))
+          Blank().height(32)
+        }
+        .width('100%')
+      }
+      .layoutWeight(1)
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
diff --git a/entry/src/main/ets/ui/AegisActivity.ets b/entry/src/main/ets/ui/AegisActivity.ets
new file mode 100644
index 0000000..0d9b88b
--- /dev/null
+++ b/entry/src/main/ets/ui/AegisActivity.ets
@@ -0,0 +1,204 @@
+import { promptAction } from '@kit.ArkUI';
+import { Preferences } from '../Preferences';
+import { VaultManager, LockListener } from '../vault/VaultManager';
+import { AuditLogRepository } from '../database/AuditLogRepository';
+import { IconPackManager } from '../icons/IconPackManager';
+import { ThemeHelper } from '../helpers/ThemeHelper';
+import { ThemeMap } from '../ThemeMap';
+import { AegisModule } from '../AegisModule';
+import { ActivityManager, Intent, RESULT_CANCELED } from './Intent';
+import { ResUtils } from '../util/ResUtils';
+
+export const PAGE_MAIN: string = 'ui/MainActivity';
+export const PAGE_AUTH: string = 'ui/AuthActivity';
+export const PAGE_INTRO: string = 'ui/IntroActivity';
+export const PAGE_EDIT_ENTRY: string = 'ui/EditEntryActivity';
+export const PAGE_SCANNER: string = 'ui/ScannerActivity';
+export const PAGE_ABOUT: string = 'ui/AboutActivity';
+export const PAGE_LICENSES: string = 'ui/LicensesActivity';
+export const PAGE_PREFERENCES: string = 'ui/PreferencesActivity';
+export const PAGE_GROUP_MANAGER: string = 'ui/GroupManagerActivity';
+export const PAGE_ASSIGN_ICONS: string = 'ui/AssignIconsActivity';
+export const PAGE_IMPORT_ENTRIES: string = 'ui/ImportEntriesActivity';
+export const PAGE_TRANSFER_ENTRIES: string = 'ui/TransferEntriesActivity';
+export const PAGE_PANIC_RESPONDER: string = 'ui/PanicResponderActivity';
+export const PAGE_PREFS_MAIN: string = 'ui/fragments/preferences/MainPreferencesFragment';
+export const PAGE_PREFS_APPEARANCE: string = 'ui/fragments/preferences/AppearancePreferencesFragment';
+export const PAGE_PREFS_BEHAVIOR: string = 'ui/fragments/preferences/BehaviorPreferencesFragment';
+export const PAGE_PREFS_SECURITY: string = 'ui/fragments/preferences/SecurityPreferencesFragment';
+export const PAGE_PREFS_BACKUPS: string = 'ui/fragments/preferences/BackupsPreferencesFragment';
+export const PAGE_PREFS_IMPORT_EXPORT: string = 'ui/fragments/preferences/ImportExportPreferencesFragment';
+export const PAGE_PREFS_ICON_PACKS: string = 'ui/fragments/preferences/IconPacksManagerFragment';
+export const PAGE_PREFS_AUDIT_LOG: string = 'ui/fragments/preferences/AuditLogPreferencesFragment';
+
+/**
+ * Port of the AegisActivity base class. ArkUI pages (structs) can't inherit, so every page owns an
+ * instance of this class and forwards its lifecycle callbacks (aboutToAppear -> onCreate,
+ * onPageShow -> onResume, aboutToDisappear -> onDestroy).
+ */
+export class AegisActivity implements LockListener {
+  protected _prefs: Preferences;
+  protected _themeHelper: ThemeHelper;
+  protected _vaultManager: VaultManager;
+  protected _auditLogRepository: AuditLogRepository;
+  protected _iconPackManager: IconPackManager;
+
+  private _uiContext: UIContext;
+  private _intent: Intent | null = null;
+  private _url: string;
+  private _lockCallback: ((userInitiated: boolean) => void) | null = null;
+
+  constructor(uiContext: UIContext, url: string) {
+    this._uiContext = uiContext;
+    this._url = url;
+    this._prefs = AegisModule.getPreferences();
+    this._themeHelper = new ThemeHelper(AegisModule.getContext(), this._prefs);
+    this._vaultManager = AegisModule.provideVaultManager();
+    this._auditLogRepository = AegisModule.provideAuditLogRepository();
+    this._iconPackManager = AegisModule.provideIconPackManager();
+  }
+
+  onCreate(): void {
+    this.getIntent();
+    // set the theme before creating the page
+    this.onSetTheme();
+    // register a callback to listen for lock events
+    this._vaultManager.registerLockListener(this);
+  }
+
+  onDestroy(): void {
+    this._vaultManager.unregisterLockListener(this);
+    ActivityManager.deliver(this.getIntent().id);
+  }
+
+  onResume(): void {
+    this._vaultManager.setBlockAutoLock(false);
+  }
+
+  /**
+   * Overrides the default behavior when the vault is locked.
+   */
+  setOnLockedCallback(cb: (userInitiated: boolean) => void): void {
+    this._lockCallback = cb;
+  }
+
+  onLocked(userInitiated: boolean): void {
+    if (this._lockCallback !== null) {
+      this._lockCallback(userInitiated);
+      return;
+    }
+    this.setResult(RESULT_CANCELED, null);
+  }
+
+  /**
+   * Called when the page is expected to set its theme.
+   */
+  protected onSetTheme(): void {
+    this._themeHelper.setTheme(ThemeMap.DEFAULT);
+  }
+
+  getIntent(): Intent {
+    if (this._intent === null) {
+      this._intent = ActivityManager.getIntent(this.getUIContext(), this._url);
+    }
+    return this._intent;
+  }
+
+  getUIContext(): UIContext {
+    if (this._uiContext === undefined || this._uiContext === null) {
+      const ctx = AegisModule.getUIContext();
+      if (ctx !== null) {
+        this._uiContext = ctx;
+      }
+    }
+    return this._uiContext;
+  }
+
+  getPreferences(): Preferences {
+    return this._prefs;
+  }
+
+  getVaultManager(): VaultManager {
+    return this._vaultManager;
+  }
+
+  getAuditLogRepository(): AuditLogRepository {
+    return this._auditLogRepository;
+  }
+
+  getIconPackManager(): IconPackManager {
+    return this._iconPackManager;
+  }
+
+  getThemeHelper(): ThemeHelper {
+    return this._themeHelper;
+  }
+
+  startActivity(intent: Intent): void {
+    ActivityManager.startActivity(this.getUIContext(), intent);
+  }
+
+  setResult(resultCode: number, data: Intent | null): void {
+    ActivityManager.setResult(this.getIntent(), resultCode, data);
+  }
+
+  finish(): void {
+    ActivityManager.finish(this.getUIContext());
+  }
+
+  getString(name: string, args?: Array<string | number>): string {
+    return ResUtils.getString(AegisModule.getContext(), name, args);
+  }
+
+  getQuantityString(name: string, quantity: number, args?: Array<string | number>): string {
+    return ResUtils.getQuantityString(AegisModule.getContext(), name, quantity, args);
+  }
+
+  showToast(message: ResourceStr, long?: boolean): void {
+    const opts: promptAction.ShowToastOptions = { message: message, duration: long === true ? 3500 : 2000 };
+    this.getUIContext().getPromptAction().showToast(opts);
+  }
+
+  saveVault(): boolean {
+    try {
+      this._vaultManager.save();
+      return true;
+    } catch (e) {
+      this.showToast($r('app.string.saving_error'), true);
+      return false;
+    }
+  }
+
+  saveAndBackupVault(): boolean {
+    try {
+      this._vaultManager.saveAndBackup();
+      return true;
+    } catch (e) {
+      this.showToast($r('app.string.saving_error'), true);
+      return false;
+    }
+  }
+
+  /**
+   * Closes this page if it has become an orphan (isOrphan() == true) and launches MainActivity.
+   * @return whether to abort onCreate.
+   */
+  abortIfOrphan(): boolean {
+    if (!this.isOrphan()) {
+      return false;
+    }
+    this.getUIContext().getRouter().clear();
+    this.getUIContext().getRouter().replaceUrl({ url: PAGE_MAIN }).catch(() => {
+    });
+    return true;
+  }
+
+  /**
+   * Reports whether this page instance has become an orphan. This can happen if
+   * the vault was killed/locked by an external trigger while the page was still open.
+   */
+  private isOrphan(): boolean {
+    return this._url !== PAGE_MAIN && this._url !== PAGE_AUTH && this._url !== PAGE_INTRO
+      && !this._vaultManager.isVaultLoaded();
+  }
+}
diff --git a/entry/src/main/ets/ui/AssignIconsActivity.ets b/entry/src/main/ets/ui/AssignIconsActivity.ets
new file mode 100644
index 0000000..c28d244
--- /dev/null
+++ b/entry/src/main/ets/ui/AssignIconsActivity.ets
@@ -0,0 +1,220 @@
+import { AegisActivity, PAGE_ASSIGN_ICONS } from './AegisActivity';
+import { Intent, RESULT_OK } from './Intent';
+import { Toolbar, ToolbarMenuItem } from './components/Toolbar';
+import { Dialogs } from './dialogs/Dialogs';
+import { IconPickerDialog } from './dialogs/IconPickerDialog';
+import { IconAdapterListener } from './views/IconAdapter';
+import { AssignIconAdapter, AssignIconAdapterListener } from './views/AssignIconAdapter';
+import { AssignIconHolder } from './views/AssignIconHolder';
+import { AssignIconEntry } from './models/AssignIconEntry';
+import { IconPack, IconPackIcon } from '../icons/IconPack';
+import { IOUtils } from '../util/IOUtils';
+import { VaultEntry } from '../vault/VaultEntry';
+import { VaultEntryIcon } from '../vault/VaultEntryIcon';
+
+function compareIconPacks(a: IconPack, b: IconPack): number {
+  return a.getName() < b.getName() ? -1 : (a.getName() > b.getName() ? 1 : 0);
+}
+
+/**
+ * Port of AssignIconsActivity. Extras: "entries" (string[] of entry UUIDs).
+ * Result: RESULT_OK with the extra "entryUUIDs" (string[] of the entries that got a new icon).
+ */
+@Entry
+@Component
+struct AssignIconsActivity {
+  private _activity: AegisActivity | null = null;
+  private _adapter: AssignIconAdapter = new AssignIconAdapter(new AssignIconAdapterListener(
+    (entry: AssignIconEntry) => this.onAssignIconEntryClick(entry)));
+  private _entries: AssignIconEntry[] = [];
+  private _favoriteIconPack: IconPack | null = null;
+  private _backPressHandlerEnabled: boolean = false;
+  @State _loaded: boolean = false;
+  @State _menuItems: ToolbarMenuItem[] = [];
+
+  aboutToAppear(): void {
+    this._activity = new AegisActivity(this.getUIContext(), PAGE_ASSIGN_ICONS);
+    this.onCreate();
+  }
+
+  onPageShow(): void {
+    if (this._activity !== null) {
+      this._activity.onResume();
+    }
+  }
+
+  aboutToDisappear(): void {
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  onBackPress(): boolean {
+    if (this._backPressHandlerEnabled) {
+      this.discardAndFinish();
+      return true;
+    }
+    return false;
+  }
+
+  private act(): AegisActivity {
+    return this._activity as AegisActivity;
+  }
+
+  private onCreate(): void {
+    const activity = this.act();
+    activity.onCreate();
+    if (activity.abortIfOrphan()) {
+      return;
+    }
+
+    const vault = activity.getVaultManager().getVault();
+    const extra = activity.getIntent().getExtra('entries');
+    const assignIconEntriesIds: string[] = Array.isArray(extra) ? extra as string[] : [];
+    for (const entryId of assignIconEntriesIds) {
+      if (vault.hasEntryByUUID(entryId)) {
+        const vaultEntry: VaultEntry = vault.getEntryByUUID(entryId);
+        this._entries.push(new AssignIconEntry(vaultEntry));
+      }
+    }
+
+    const iconPacks = activity.getIconPackManager().getIconPacks().sort(compareIconPacks);
+    if (iconPacks.length === 0) {
+      // started without any icon packs present
+      activity.finish();
+      return;
+    }
+
+    this._favoriteIconPack = iconPacks[0];
+
+    for (const entry of this._entries) {
+      const suggestedIcon = this.findSuggestedIcon(entry);
+      if (suggestedIcon !== null) {
+        entry.setNewIcon(suggestedIcon);
+      }
+    }
+
+    this._adapter.addEntries(this._entries);
+    this.onCreateOptionsMenu();
+    this._loaded = true;
+  }
+
+  private findSuggestedIcon(entry: AssignIconEntry): IconPackIcon | null {
+    if (this._favoriteIconPack === null) {
+      return null;
+    }
+    const suggestedIcons = this._favoriteIconPack.getSuggestedIcons(entry.getEntry().getIssuer());
+    if (suggestedIcons.length > 0) {
+      return suggestedIcons[0];
+    }
+
+    return null;
+  }
+
+  private saveAndFinish(): void {
+    const vault = this.act().getVaultManager().getVault();
+    const uuids: string[] = [];
+    for (const selectedEntry of this._entries) {
+      const entry = selectedEntry.getEntry();
+      const newIcon = selectedEntry.getNewIcon();
+      if (newIcon !== null) {
+        const file = newIcon.getFile();
+        if (file === null) {
+          throw new Error(`Icon file of ${newIcon.getName()} not found`);
+        }
+        const iconBytes = IOUtils.readFile(file);
+
+        const icon = new VaultEntryIcon(iconBytes, newIcon.getIconType());
+        entry.setIcon(icon);
+        uuids.push(entry.getUUID());
+
+        vault.replaceEntry(entry);
+      }
+    }
+
+    const intent = new Intent(PAGE_ASSIGN_ICONS);
+    intent.putExtra('entryUUIDs', uuids);
+
+    if (this.act().saveAndBackupVault()) {
+      this.act().setResult(RESULT_OK, intent);
+      this.act().finish();
+    }
+  }
+
+  private trySaveAndFinish(): void {
+    try {
+      this.saveAndFinish();
+    } catch (e) {
+      this.act().showToast($r('app.string.saving_assign_icons_error'));
+    }
+  }
+
+  private discardAndFinish(): void {
+    Dialogs.showDiscardDialog(this.getUIContext(),
+      () => this.trySaveAndFinish(),
+      () => this.act().finish());
+  }
+
+  private onCreateOptionsMenu(): void {
+    this._menuItems = [
+      new ToolbarMenuItem('action_save', $r('app.string.save'), $r('app.media.ic_outline_check_24'), true)
+    ];
+  }
+
+  private onOptionsItemSelected(itemId: string): boolean {
+    if (itemId === 'home') {
+      this.discardAndFinish();
+    } else if (itemId === 'action_save') {
+      this.trySaveAndFinish();
+    } else {
+      return false;
+    }
+
+    return true;
+  }
+
+  onAssignIconEntryClick(entry: AssignIconEntry): void {
+    const iconPacks = this.act().getIconPackManager().getIconPacks().sort(compareIconPacks);
+
+    IconPickerDialog.create(this.getUIContext(), iconPacks, entry.getEntry().getIssuer(), false, new IconAdapterListener(
+      (icon: IconPackIcon) => entry.setNewIcon(icon),
+      () => {
+      }
+    ));
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.title_activity_assign_icons'),
+        menuItems: this._menuItems,
+        onBack: () => {
+          this.onOptionsItemSelected('home');
+        },
+        onMenuItemClick: (id: string) => {
+          this.onOptionsItemSelected(id);
+        }
+      })
+      if (this._loaded) {
+        List({ space: 8 }) {
+          LazyForEach(this._adapter, (entry: AssignIconEntry) => {
+            ListItem() {
+              AssignIconHolder({
+                entry: entry,
+                onEntryClick: (e: AssignIconEntry) => this.onAssignIconEntryClick(e)
+              })
+            }
+          }, (entry: AssignIconEntry) => entry.getEntry().getUUID())
+        }
+        .layoutWeight(1)
+        .width('100%')
+        .padding({ left: 8, right: 8, top: 8, bottom: 8 })
+        .cachedCount(4)
+        .scrollBar(BarState.Auto)
+      }
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor($r('app.color.theme_background'))
+  }
+}
diff --git a/entry/src/main/ets/ui/AuthActivity.ets b/entry/src/main/ets/ui/AuthActivity.ets
new file mode 100644
index 0000000..95dec27
--- /dev/null
+++ b/entry/src/main/ets/ui/AuthActivity.ets
@@ -0,0 +1,396 @@
+import { common } from '@kit.AbilityKit';
+import { AegisActivity, PAGE_AUTH } from './AegisActivity';
+import { RESULT_CANCELED, RESULT_OK } from './Intent';
+import { Dialogs } from './dialogs/Dialogs';
+import { VaultFile } from '../vault/VaultFile';
+import { VaultRepository } from '../vault/VaultRepository';
+import { VaultFileCredentials } from '../vault/VaultFileCredentials';
+import { SlotList } from '../vault/slots/SlotList';
+import { Slot } from '../vault/slots/Slot';
+import { BiometricSlot } from '../vault/slots/BiometricSlot';
+import { MasterKey } from '../crypto/MasterKey';
+import { KeyStoreHandle } from '../crypto/KeyStoreHandle';
+import { KeyStoreCipher } from '../crypto/Cipher';
+import { PasswordSlotDecryptTask, PasswordSlotDecryptResult } from './tasks/PasswordSlotDecryptTask';
+import { BiometricPrompt, BiometricPromptInfo, BiometricsHelper, BiometricAuthenticationCallback } from '../helpers/BiometricsHelper';
+import { ThemeHelper } from '../helpers/ThemeHelper';
+import { AegisModule } from '../AegisModule';
+import { NoAutofillEditText } from './components/NoAutofillEditText';
+
+class BiometricPromptListener implements BiometricAuthenticationCallback {
+  private _page: AuthActivity;
+
+  constructor(page: AuthActivity) {
+    this._page = page;
+  }
+
+  onAuthenticationError(errorCode: number, errString: string): void {
+    this._page.onBiometricError(errorCode, errString);
+  }
+
+  onAuthenticationSucceeded(token: Uint8Array): void {
+    this._page.onBiometricSucceeded(token);
+  }
+}
+
+/**
+ * Port of AuthActivity: asks for the password (or biometrics) to unlock the vault.
+ */
+@Entry
+@Component
+struct AuthActivity {
+  private _activity: AegisActivity = new AegisActivity(this.getUIContext(), PAGE_AUTH);
+  private _vaultFile: VaultFile | null = null;
+  private _slots: SlotList = new SlotList();
+  private _bioSlot: BiometricSlot | null = null;
+  private _bioCipher: KeyStoreCipher | null = null;
+  private _bioPrompt: BiometricPrompt | null = null;
+  private _failedUnlockAttempts: number = 0;
+  // the first time this page is shown after creation, it's possible to inhibit showing the
+  // biometric prompt by setting 'inhibitBioPrompt' to true through the intent
+  private _inhibitBioPrompt: boolean = false;
+  private _finished: boolean = false;
+
+  @State password: string = '';
+  @State pinKeyboard: boolean = false;
+  @State decryptEnabled: boolean = true;
+  @State biometricsVisible: boolean = false;
+  @State biometricInfoVisible: boolean = false;
+  @State reminderVisible: boolean = false;
+
+  aboutToAppear(): void {
+    this._activity.onCreate();
+    this._activity.setOnLockedCallback((userInitiated: boolean) => {
+    });
+    this.pinKeyboard = this._activity.getPreferences().isPinKeyboardEnabled();
+    this._inhibitBioPrompt = this._activity.getIntent().getBooleanExtra('inhibitBioPrompt', false);
+
+    try {
+      this._vaultFile = VaultRepository.readVaultFile(AegisModule.getContext());
+    } catch (e) {
+      Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.vault_load_error'), e as Error, () => {
+        this.onBackPress();
+      });
+      return;
+    }
+
+    // only show the biometric prompt if a biometric slot is found and biometrics are available
+    this._slots = this._vaultFile.getHeader().getSlots();
+    if (this._slots.hasBiometricSlot() && BiometricsHelper.isAvailable()) {
+      this.findBiometricSlot().then(() => {
+        this.onResume();
+      });
+    } else {
+      this.onResume();
+    }
+
+    if (this._activity.getPreferences().isPasswordReminderNeeded() && this._slots.hasBiometricSlot()) {
+      this.showPasswordReminder();
+    }
+  }
+
+  /**
+   * Finds a biometric slot with an id that matches an alias in the keystore.
+   */
+  private async findBiometricSlot(): Promise<void> {
+    let invalidated = false;
+    try {
+      const handle = new KeyStoreHandle();
+      for (const slot of this._slots.getBiometricSlots()) {
+        const id = slot.getUUID();
+        if (await handle.containsKey(id)) {
+          const params = slot.getEncryptedMasterKeyParams();
+          if (params === null) {
+            continue;
+          }
+          // if the cipher can't be initialized, the key was permanently invalidated
+          const cipher = handle.createDecryptCipher(id, params);
+          try {
+            await cipher.init();
+          } catch (e) {
+            invalidated = true;
+            continue;
+          }
+          await cipher.abort();
+          this._bioSlot = slot;
+          this.biometricsVisible = true;
+          invalidated = false;
+          break;
+        }
+      }
+    } catch (e) {
+      Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.biometric_init_error'), e as Error);
+    }
+
+    // display a help message if a matching invalidated keystore entry was found
+    if (invalidated) {
+      this.biometricInfoVisible = true;
+      this.biometricsVisible = false;
+    }
+  }
+
+  onPageShow(): void {
+    this._activity.onResume();
+  }
+
+  private onResume(): void {
+    const remindPassword = this._activity.getPreferences().isPasswordReminderNeeded();
+    if (this._bioSlot !== null && this._bioPrompt === null && !this._inhibitBioPrompt && !remindPassword) {
+      this.showBiometricPrompt();
+    }
+    this._inhibitBioPrompt = false;
+  }
+
+  onPageHide(): void {
+    if (this._bioPrompt !== null) {
+      this._bioPrompt.cancelAuthentication();
+      this._bioPrompt = null;
+    }
+  }
+
+  aboutToDisappear(): void {
+    if (this._bioCipher !== null) {
+      this._bioCipher.abort();
+    }
+    this._activity.onDestroy();
+  }
+
+  onBackPress(): boolean {
+    // it doesn't make sense to go back to MainActivity when cancelling auth
+    this._activity.setResult(RESULT_CANCELED, null);
+    this._activity.finish();
+    return true;
+  }
+
+  private showPasswordReminder(): void {
+    this.reminderVisible = true;
+    setTimeout(() => {
+      this.reminderVisible = false;
+    }, 5000);
+  }
+
+  private onBiometricsButtonClick(): void {
+    if (this._activity.getPreferences().isPasswordReminderNeeded()) {
+      Dialogs.showSimpleDialog(this.getUIContext(), $r('app.string.password_reminder_dialog_title'),
+        $r('app.string.password_reminder_dialog_message'), $r('app.string.ok'), () => this.showBiometricPrompt(),
+        null, null, undefined, undefined, true);
+    } else {
+      this.showBiometricPrompt();
+    }
+  }
+
+  showBiometricPrompt(): void {
+    try {
+      this.getUIContext().getFocusController().clearFocus();
+    } catch (e) {
+      // ignore
+    }
+    const slot = this._bioSlot;
+    if (slot === null) {
+      return;
+    }
+    const params = slot.getEncryptedMasterKeyParams();
+    if (params === null) {
+      return;
+    }
+    const cipher = new KeyStoreHandle().createDecryptCipher(slot.getUUID(), params);
+    this._bioCipher = cipher;
+    cipher.init().then((challenge: Uint8Array) => {
+      const prompt = new BiometricPrompt();
+      this._bioPrompt = prompt;
+      const info = new BiometricPromptInfo(this._activity.getString('authentication'), '', this._activity.getString('cancel'));
+      prompt.authenticate(info, challenge, new BiometricPromptListener(this));
+    }).catch((e: Error) => {
+      Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.biometric_init_error'), e);
+    });
+  }
+
+  onBiometricError(errorCode: number, errString: string): void {
+    this._bioPrompt = null;
+    if (this._bioCipher !== null) {
+      this._bioCipher.abort();
+      this._bioCipher = null;
+    }
+    if (!BiometricsHelper.isCanceled(errorCode)) {
+      this._activity.getAuditLogRepository().addVaultUnlockFailedBiometricsEvent();
+      this._activity.showToast(errString, true);
+    }
+  }
+
+  onBiometricSucceeded(token: Uint8Array): void {
+    this._bioPrompt = null;
+    const cipher = this._bioCipher;
+    const slot = this._slots.findBiometricSlot();
+    if (cipher === null || slot === null) {
+      return;
+    }
+    cipher.setAuthToken(token);
+    slot.getKey(cipher).then((key: MasterKey) => {
+      this._bioCipher = null;
+      this.finishWithKey(key, false);
+    }).catch((e: Error) => {
+      Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.biometric_decrypt_error'), e);
+    });
+  }
+
+  private onDecryptClick(): void {
+    try {
+      this.getUIContext().getFocusController().clearFocus();
+    } catch (e) {
+      // ignore
+    }
+    const slots = this._slots.getPasswordSlots();
+    const task = new PasswordSlotDecryptTask(this.getUIContext(), (result: PasswordSlotDecryptResult | null, error: Error | null) => {
+      this.onTaskFinished(result, error);
+    });
+    task.execute(slots, this.password);
+    this.decryptEnabled = false;
+  }
+
+  private onTaskFinished(result: PasswordSlotDecryptResult | null, error: Error | null): void {
+    if (result !== null) {
+      // replace the old slot with the repaired one
+      if (result.isSlotRepaired()) {
+        this._slots.replace(result.getSlot());
+      }
+      if (result.getSlot().getType() === Slot.TYPE_PASSWORD) {
+        this._activity.getPreferences().resetPasswordReminderTimestamp();
+      }
+      this.finishWithKey(result.getKey(), result.isSlotRepaired());
+    } else {
+      this.decryptEnabled = true;
+      if (error !== null) {
+        Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.unlock_vault_error'), error);
+        return;
+      }
+      this._activity.getAuditLogRepository().addVaultUnlockFailedPasswordEvent();
+      this.onInvalidPassword();
+    }
+  }
+
+  private finishWithKey(key: MasterKey, isSlotRepaired: boolean): void {
+    if (this._finished || this._vaultFile === null) {
+      return;
+    }
+    const creds = new VaultFileCredentials(key, this._slots);
+    try {
+      this._activity.getVaultManager().loadFrom(this._vaultFile, creds);
+      if (isSlotRepaired) {
+        this._activity.saveAndBackupVault();
+      }
+    } catch (e) {
+      Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.decryption_corrupt_error'), e as Error);
+      return;
+    }
+
+    this._finished = true;
+    this._activity.setResult(RESULT_OK, null);
+    this._activity.finish();
+  }
+
+  private onInvalidPassword(): void {
+    Dialogs.showSimpleDialog(this.getUIContext(), $r('app.string.unlock_vault_error'),
+      $r('app.string.unlock_vault_error_description'), $r('app.string.ok'), () => this.selectPassword(), null, null);
+    this._failedUnlockAttempts++;
+    if (this._failedUnlockAttempts >= 3) {
+      this.pinKeyboard = false;
+    }
+  }
+
+  private selectPassword(): void {
+    this.password = '';
+  }
+
+  build() {
+    Column() {
+      Blank().layoutWeight(1)
+      Image($r('app.media.app_launcher'))
+        .width(96)
+        .height(96)
+        .margin({ bottom: 24 })
+      Text($r('app.string.authentication_multiline'))
+        .fontSize(22)
+        .textAlign(TextAlign.Center)
+        .fontColor($r('app.color.theme_onSurface'))
+        .margin({ bottom: 24 })
+      Column() {
+        if (this.pinKeyboard) {
+          NoAutofillEditText({
+            text: this.password,
+            hint: $r('app.string.password'),
+            numeric: true,
+            onTextChange: (v: string) => {
+              this.password = v;
+            },
+            onSubmitText: () => {
+              if (this.decryptEnabled) {
+                this.onDecryptClick();
+              }
+            }
+          })
+        } else {
+        TextInput({ text: this.password, placeholder: $r('app.string.password') })
+          .type(InputType.Password)
+          .enterKeyType(EnterKeyType.Done)
+          .defaultFocus(this._bioSlot === null || this._activity.getPreferences().isPasswordReminderNeeded())
+          .onChange((v: string) => {
+            this.password = v;
+          })
+          .onSubmit(() => {
+            if (this.decryptEnabled) {
+              this.onDecryptClick();
+            }
+          })
+          .bindPopup(this.reminderVisible, {
+            message: this._activity.getString('password_reminder'),
+            placementOnTop: true,
+            onStateChange: (e) => {
+              if (!e.isVisible) {
+                this.reminderVisible = false;
+              }
+            }
+          })
+        }
+        Button($r('app.string.unlock'))
+          .width('100%')
+          .margin({ top: 16 })
+          .enabled(this.decryptEnabled)
+          .backgroundColor($r('app.color.theme_primary'))
+          .fontColor($r('app.color.theme_onPrimary'))
+          .onClick(() => this.onDecryptClick())
+        if (this.biometricsVisible) {
+          Text($r('app.string.auth_use_biometrics'))
+            .fontSize(15)
+            .fontColor($r('app.color.theme_primary'))
+            .padding(12)
+            .margin({ top: 8 })
+            .onClick(() => this.onBiometricsButtonClick())
+        }
+        if (this.biometricInfoVisible) {
+          Row() {
+            Image($r('app.media.ic_outline_info_24'))
+              .width(20)
+              .height(20)
+              .fillColor($r('app.color.theme_onSurfaceVariant'))
+              .margin({ right: 8 })
+            Text($r('app.string.invalidated_biometrics'))
+              .fontSize(13)
+              .fontColor($r('app.color.theme_onSurfaceVariant'))
+              .layoutWeight(1)
+          }
+          .margin({ top: 16 })
+        }
+      }
+      .width('85%')
+      .constraintSize({ maxWidth: 420 })
+      Blank().layoutWeight(1)
+      Text($r('app.string.app_name_full'))
+        .fontSize(13)
+        .fontColor($r('app.color.theme_onSurfaceVariant'))
+        .margin({ bottom: 24 })
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
