+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterState, DecryptListener } from './DatabaseImporter';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { GoogleAuthUriImporter } from './GoogleAuthUriImporter';
+import { Dialogs } from '../ui/dialogs/Dialogs';
+import { Bytes } from '../util/Bytes';
+import { ZipInputStream } from '../util/zip/ZipInputStream';
+import { LocalFileHeader } from '../util/zip/LocalFileHeader';
+
+const FILENAME: string = 'Accounts.txt';
+
+export class AuthenticatorPlusImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    throw new DatabaseImporterException('Unsupported operation');
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    return new AuthenticatorPlusImporterEncryptedState(Bytes.copy(stream));
+  }
+}
+
+export class AuthenticatorPlusImporterEncryptedState extends DatabaseImporterState {
+  private readonly _data: Uint8Array;
+
+  constructor(data: Uint8Array) {
+    super(true);
+    this._data = data;
+  }
+
+  async decryptWithPassword(password: string): Promise<DatabaseImporterState> {
+    const zipStream = new ZipInputStream(this._data, password);
+    try {
+      let header: LocalFileHeader | null = zipStream.getNextEntry();
+      while (header !== null) {
+        const fileName = header.getFileName();
+        const name = fileName.substring(fileName.lastIndexOf('/') + 1);
+        if (name === FILENAME) {
+          const contents = await zipStream.readEntry();
+          return GoogleAuthUriImporter.readLines(contents);
+        }
+        header = zipStream.getNextEntry();
+      }
+      throw new DatabaseImporterException(`File not found: ${FILENAME}`);
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterException) {
+        throw e as DatabaseImporterException;
+      }
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    finally {
+      zipStream.close();
+    }
+  }
+
+  decrypt(uiContext: UIContext, listener: DecryptListener): void {
+    Dialogs.showPasswordInputDialog(uiContext, (password: string) => {
+      this.decryptWithPassword(password)
+        .then((state: DatabaseImporterState) => listener.onStateDecrypted(state))
+        .catch((e: Error) => listener.onError(e));
+    }, () => listener.onCanceled());
+  }
+}
diff --git a/entry/src/main/ets/importers/AuthyImporter.ets b/entry/src/main/ets/importers/AuthyImporter.ets
new file mode 100644
index 0000000..e403848
--- /dev/null
+++ b/entry/src/main/ets/importers/AuthyImporter.ets
@@ -0,0 +1,259 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState, DecryptListener } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { CryptoUtils } from '../crypto/CryptoUtils';
+import { Base32 } from '../encoding/Base32';
+import { Base64 } from '../encoding/Base64';
+import { Hex } from '../encoding/Hex';
+import { OtpInfo } from '../otp/OtpInfo';
+import { TotpInfo } from '../otp/TotpInfo';
+import { Dialogs } from '../ui/dialogs/Dialogs';
+import { JSONArray, JSONObject } from '../util/JSONObject';
+import { JsonUtils } from '../util/JsonUtils';
+import { Bytes } from '../util/Bytes';
+import { IOUtils } from '../util/IOUtils';
+import { PreferenceParser } from '../util/PreferenceParser';
+import { VaultEntry } from '../vault/VaultEntry';
+
+const _subPath: string = 'shared_prefs';
+
+const _pkgName: string = 'com.authy.authy';
+
+const _authFilename: string = 'com.authy.storage.tokens.authenticator';
+
+const _authyFilename: string = 'com.authy.storage.tokens.authy';
+
+const ITERATIONS: number = 1000;
+
+const KEY_SIZE: number = 256;
+
+const IV: Uint8Array = new Uint8Array(16);
+
+export class AuthyImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    return this.getAppPathForPackage(_pkgName, _subPath);
+  }
+
+  async readFromApp(): Promise<DatabaseImporterState> {
+    const path = this.getAppPath();
+    let array: JSONArray;
+    let authyArray: JSONArray;
+    try {
+      const file1 = `${path}/${_authFilename}.xml`;
+      const file2 = `${path}/${_authyFilename}.xml`;
+      array = AuthyImporter.readFile(file1, `${_authFilename}.key`);
+      authyArray = AuthyImporter.readFile(file2, `${_authyFilename}.key`);
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    try {
+      for (let i = 0; i < authyArray.length(); i++) {
+        array.put(authyArray.getJSONObject(i));
+      }
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    return AuthyImporter.readArray(array);
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    try {
+      let array = new JSONArray();
+      for (const entry of PreferenceParser.parseBytes(stream)) {
+        if (entry.Name === `${_authFilename}.key` || entry.Name === `${_authyFilename}.key`) {
+          array = new JSONArray(entry.Value);
+          break;
+        }
+      }
+      return AuthyImporter.readArray(array);
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterException) {
+        throw e as DatabaseImporterException;
+      }
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  private static readArray(array: JSONArray): DatabaseImporterState {
+    try {
+      for (let i = 0; i < array.length(); i++) {
+        const obj = array.getJSONObject(i);
+        if (!obj.has('decryptedSecret') && !obj.has('secretSeed')) {
+          return new AuthyImporterEncryptedState(array);
+        }
+      }
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    return new AuthyImporterDecryptedState(array);
+  }
+
+  private static readFile(file: string, key: string): JSONArray {
+    const bytes = IOUtils.readFile(file);
+    try {
+      for (const entry of PreferenceParser.parseBytes(bytes)) {
+        if (entry.Name === key) {
+          return new JSONArray(entry.Value);
+        }
+      }
+    }
+    catch (e) {
+      // ignored (JSONException)
+    }
+    return new JSONArray();
+  }
+}
+
+export class AuthyImporterEncryptedState extends DatabaseImporterState {
+  private _array: JSONArray;
+
+  constructor(array: JSONArray) {
+    super(true);
+    this._array = array;
+  }
+
+  async decryptWithPassword(password: string): Promise<AuthyImporterDecryptedState> {
+    try {
+      for (let i = 0; i < this._array.length(); i++) {
+        const obj = this._array.getJSONObject(i);
+        const secretString = JsonUtils.optString(obj, 'encryptedSecret');
+        if (secretString === null) {
+          continue;
+        }
+        const encryptedSecret = Base64.decode(secretString);
+        const salt = Bytes.fromUtf8(obj.getString('salt'));
+        const key = await CryptoUtils.pbkdf2('SHA1', CryptoUtils.toBytes(password), salt, ITERATIONS, KEY_SIZE / 8);
+        const secret = CryptoUtils.aes(false, 'CBC', 'PKCS7', key, IV, encryptedSecret);
+        obj.remove('encryptedSecret');
+        obj.remove('salt');
+        obj.put('decryptedSecret', Bytes.toUtf8(secret));
+        this.replace(i, obj);
+      }
+      return new AuthyImporterDecryptedState(this._array);
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  /**
+   * Makes sure the modified object ends up in the array (JSONObject.remove() creates a new backing map).
+   */
+  private replace(index: number, obj: JSONObject): void {
+    const raw = this._array.raw();
+    raw[index] = obj.raw();
+  }
+
+  decrypt(uiContext: UIContext, listener: DecryptListener): void {
+    Dialogs.showPasswordInputDialog(uiContext, (password: string) => {
+      this.decryptWithPassword(password)
+        .then((state: AuthyImporterDecryptedState) => listener.onStateDecrypted(state))
+        .catch((e: Error) => listener.onError(e));
+    }, () => listener.onCanceled(), $r('app.string.enter_password_authy_message'));
+  }
+}
+
+class AuthyEntryInfo {
+  OriginalName: string | null = null;
+  OriginalIssuer: string | null = null;
+  AccountType: string | null = null;
+  Issuer: string = '';
+  Name: string = '';
+}
+
+export class AuthyImporterDecryptedState extends DatabaseImporterState {
+  private _array: JSONArray;
+
+  constructor(array: JSONArray) {
+    super(false);
+    this._array = array;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    try {
+      for (let i = 0; i < this._array.length(); i++) {
+        const entryObj = this._array.getJSONObject(i);
+        try {
+          const entry = AuthyImporterDecryptedState.convertEntry(entryObj);
+          result.addEntry(entry);
+        }
+        catch (e) {
+          result.addError(e as DatabaseImporterEntryException);
+        }
+      }
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    return result;
+  }
+
+  private static convertEntry(entry: JSONObject): VaultEntry {
+    try {
+      const authyEntryInfo = new AuthyEntryInfo();
+      authyEntryInfo.OriginalName = JsonUtils.optString(entry, 'originalName');
+      authyEntryInfo.OriginalIssuer = JsonUtils.optString(entry, 'originalIssuer');
+      authyEntryInfo.AccountType = JsonUtils.optString(entry, 'accountType');
+      authyEntryInfo.Name = entry.optString('name');
+      const isAuthy = entry.has('secretSeed');
+      AuthyImporterDecryptedState.sanitizeEntryInfo(authyEntryInfo, isAuthy);
+      let secret: Uint8Array;
+      if (isAuthy) {
+        secret = Hex.decode(entry.getString('secretSeed'));
+      }
+      else {
+        secret = Base32.decode(entry.getString('decryptedSecret'));
+      }
+      const digits = entry.getInt('digits');
+      const info = new TotpInfo(secret, OtpInfo.DEFAULT_ALGORITHM, digits, isAuthy ? 10 : TotpInfo.DEFAULT_PERIOD);
+      return new VaultEntry(info, authyEntryInfo.Name, authyEntryInfo.Issuer);
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, entry.toString());
+    }
+  }
+
+  private static sanitizeEntryInfo(info: AuthyEntryInfo, isAuthy: boolean): void {
+    if (!isAuthy) {
+      let separator = '';
+      const originalName = info.OriginalName;
+      const originalIssuer = info.OriginalIssuer;
+      if (originalIssuer !== null) {
+        info.Issuer = originalIssuer;
+      }
+      else if (originalName !== null && originalName.indexOf(':') >= 0) {
+        info.Issuer = originalName.substring(0, originalName.indexOf(':'));
+        separator = ':';
+      }
+      else if (info.Name.indexOf(' - ') >= 0) {
+        info.Issuer = info.Name.substring(0, info.Name.indexOf(' - '));
+        separator = ' - ';
+      }
+      else {
+        const accountType = info.AccountType;
+        if (accountType === null || accountType.length === 0) {
+          throw new DatabaseImporterException('Unable to determine the issuer of the entry');
+        }
+        info.Issuer = accountType.substring(0, 1).toUpperCase() + accountType.substring(1);
+      }
+      info.Name = info.Name.split(info.Issuer + separator).join('');
+    }
+    else {
+      info.Issuer = info.Name;
+      info.Name = '';
+    }
+    if (info.Name.startsWith(': ')) {
+      info.Name = info.Name.substring(2);
+    }
+  }
+}
diff --git a/entry/src/main/ets/importers/BattleNetImporter.ets b/entry/src/main/ets/importers/BattleNetImporter.ets
new file mode 100644
index 0000000..fbfde2d
--- /dev/null
+++ b/entry/src/main/ets/importers/BattleNetImporter.ets
@@ -0,0 +1,97 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { Hex } from '../encoding/Hex';
+import { OtpInfo } from '../otp/OtpInfo';
+import { TotpInfo } from '../otp/TotpInfo';
+import { VaultEntry } from '../vault/VaultEntry';
+import { PreferenceParser } from '../util/PreferenceParser';
+
+const BATTLE_NET_KEY: Uint8Array = Hex.decode('398e27fc50276a656065b0e525f4c06c04c61075286b8e7aeda59da9813b5dd6c80d2fb38068773fa59ba47c17ca6c6479015c1d5b8b8f6b9a');
+
+export class BattleNetImporter extends DatabaseImporter {
+  private static readonly _pkgName: string = 'com.blizzard.messenger';
+  private static readonly _subPath: string = 'shared_prefs/com.blizzard.messenger.authenticator_preferences.xml';
+
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    return this.getAppPathForPackage(BattleNetImporter._pkgName, BattleNetImporter._subPath);
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    const serialKey = 'com.blizzard.messenger.AUTHENTICATOR_SERIAL';
+    const secretKey = 'com.blizzard.messenger.AUTHENTICATOR_DEVICE_SECRET';
+    let serial = '';
+    let secretValue: string | null = null;
+    try {
+      for (const entry of PreferenceParser.parseBytes(stream)) {
+        if (entry.Name === secretKey) {
+          secretValue = entry.Value;
+        }
+        else if (entry.Name === serialKey) {
+          serial = entry.Value;
+        }
+      }
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    if (secretValue === null) {
+      throw new DatabaseImporterException(`Key not found: ${secretKey}`);
+    }
+    return new BattleNetImporterState(serial, secretValue);
+  }
+}
+
+export class BattleNetImporterState extends DatabaseImporterState {
+  private readonly _serial: string;
+  private readonly _secretValue: string;
+
+  constructor(serial: string, secretValue: string) {
+    super(false);
+    this._serial = serial;
+    this._secretValue = secretValue;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    try {
+      const entry = BattleNetImporterState.convertEntry(this._serial, this._secretValue);
+      result.addEntry(entry);
+    }
+    catch (e) {
+      result.addError(e as DatabaseImporterEntryException);
+    }
+    return result;
+  }
+
+  private static convertEntry(serial: string, secretString: string): VaultEntry {
+    try {
+      if (serial.length > 0) {
+        serial = BattleNetImporterState.unmask(serial);
+      }
+      const secret = Hex.decode(BattleNetImporterState.unmask(secretString));
+      const info = new TotpInfo(secret, OtpInfo.DEFAULT_ALGORITHM, 8, TotpInfo.DEFAULT_PERIOD);
+      return new VaultEntry(info, serial, 'Battle.net');
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, secretString);
+    }
+  }
+
+  private static unmask(s: string): string {
+    const ds = Hex.decode(s);
+    let sb = '';
+    for (let i = 0; i < ds.length; i++) {
+      if (i >= BATTLE_NET_KEY.length) {
+        throw new DatabaseImporterException('Masked value is too long');
+      }
+      sb += String.fromCharCode(ds[i] ^ BATTLE_NET_KEY[i]);
+    }
+    return sb;
+  }
+}
diff --git a/entry/src/main/ets/importers/BitwardenImporter.ets b/entry/src/main/ets/importers/BitwardenImporter.ets
new file mode 100644
index 0000000..7926e2c
--- /dev/null
+++ b/entry/src/main/ets/importers/BitwardenImporter.ets
@@ -0,0 +1,107 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { Base32 } from '../encoding/Base32';
+import { GoogleAuthInfo } from '../otp/GoogleAuthInfo';
+import { GoogleAuthInfoException } from '../otp/GoogleAuthInfoException';
+import { SteamInfo } from '../otp/SteamInfo';
+import { VaultEntry } from '../vault/VaultEntry';
+import { JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+import { Uri } from '../util/Uri';
+import { CsvParser, CsvRow } from '../util/CsvParser';
+
+export class BitwardenImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    throw new DatabaseImporterException('Unsupported operation');
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    let fileString: string;
+    try {
+      fileString = Bytes.toUtf8(stream);
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    try {
+      const obj = new JSONObject(fileString);
+      const array = obj.getJSONArray('items');
+      const entries: string[] = [];
+      for (let i = 0; i < array.length(); i++) {
+        const entry = array.getJSONObject(i).getJSONObject('login').getString('totp');
+        if (entry.length > 0) {
+          entries.push(entry);
+        }
+      }
+      return new BitwardenImporterState(entries);
+    }
+    catch (e) {
+      try {
+        const rows = CsvParser.separator(',').rowIterator(fileString);
+        const entries: string[] = [];
+        rows.forEach((row: CsvRow) => {
+          const entry = row.get('login_totp');
+          if (entry !== null && entry.length > 0) {
+            entries.push(entry);
+          }
+        });
+        return new BitwardenImporterState(entries);
+      }
+      catch (e2) {
+        throw new DatabaseImporterException((e2 as Error).message);
+      }
+    }
+  }
+
+  static parseUri(s: string): GoogleAuthInfo {
+    const uri = Uri.parse(s);
+    if (uri.getScheme() === 'steam') {
+      const secretString = uri.getAuthority();
+      if (secretString === null) {
+        throw new GoogleAuthInfoException(uri, 'Empty secret (empty authority)');
+      }
+      const secret = Base32.decode(secretString);
+      return new GoogleAuthInfo(new SteamInfo(secret), 'Steam account', 'Steam');
+    }
+    return GoogleAuthInfo.parseUriObj(uri);
+  }
+}
+
+export class BitwardenImporterState extends DatabaseImporterState {
+  private readonly _entries: string[];
+
+  constructor(entries: string[]) {
+    super(false);
+    this._entries = entries;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    for (const obj of this._entries) {
+      try {
+        const entry = BitwardenImporterState.convertEntry(obj);
+        result.addEntry(entry);
+      }
+      catch (e) {
+        result.addError(e as DatabaseImporterEntryException);
+      }
+    }
+    return result;
+  }
+
+  private static convertEntry(obj: string): VaultEntry {
+    try {
+      const info = BitwardenImporter.parseUri(obj);
+      return VaultEntry.fromGoogleAuthInfo(info);
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, obj);
+    }
+  }
+}
diff --git a/entry/src/main/ets/importers/DatabaseImporter.ets b/entry/src/main/ets/importers/DatabaseImporter.ets
new file mode 100644
index 0000000..3524ff3
--- /dev/null
+++ b/entry/src/main/ets/importers/DatabaseImporter.ets
@@ -0,0 +1,182 @@
+import { common } from '@kit.AbilityKit';
+import { UUIDMap } from '../util/UUIDMap';
+import { VaultEntry } from '../vault/VaultEntry';
+import { VaultGroup } from '../vault/VaultGroup';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { IOUtils } from '../util/IOUtils';
+
+export type DatabaseImporterFactory = (context: common.Context) => DatabaseImporter;
+
+export class DatabaseImporterDefinition {
+  private readonly _name: string;
+  private readonly _factory: DatabaseImporterFactory;
+  private readonly _help: Resource;
+  private readonly _supportsDirect: boolean;
+
+  /**
+   * @param name The name of the Authenticator the importer handles.
+   * @param factory Creates the importer that does the importing.
+   * @param help The string that explains the type of file needed (and optionally where it can be obtained).
+   * @param supportsDirect Whether the importer can directly import the entries from the app's internal storage.
+   */
+  constructor(name: string, factory: DatabaseImporterFactory, help: Resource, supportsDirect: boolean) {
+    this._name = name;
+    this._factory = factory;
+    this._help = help;
+    this._supportsDirect = supportsDirect;
+  }
+
+  getName(): string {
+    return this._name;
+  }
+
+  getFactory(): DatabaseImporterFactory {
+    return this._factory;
+  }
+
+  getHelp(): Resource {
+    return this._help;
+  }
+
+  supportsDirect(): boolean {
+    return this._supportsDirect;
+  }
+}
+
+export interface DecryptListener {
+  onStateDecrypted(state: DatabaseImporterState): void;
+
+  onError(e: Error): void;
+
+  onCanceled(): void;
+}
+
+export abstract class DatabaseImporterState {
+  private _encrypted: boolean;
+
+  constructor(encrypted: boolean) {
+    this._encrypted = encrypted;
+  }
+
+  isEncrypted(): boolean {
+    return this._encrypted;
+  }
+
+  /**
+   * Decrypts the state, usually after asking the user for a password through a dialog.
+   */
+  decrypt(uiContext: UIContext, listener: DecryptListener): void {
+    if (!this._encrypted) {
+      throw new Error('Attempted to decrypt a plain text database');
+    }
+    throw new Error('Unsupported operation');
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    if (this._encrypted) {
+      throw new Error('Attempted to convert database before decrypting it');
+    }
+    throw new Error('Unsupported operation');
+  }
+}
+
+export class DatabaseImporterResult {
+  private _entries: UUIDMap<VaultEntry> = new UUIDMap<VaultEntry>();
+  private _groups: UUIDMap<VaultGroup> = new UUIDMap<VaultGroup>();
+  private _errors: DatabaseImporterEntryException[] = [];
+
+  addEntry(entry: VaultEntry): void {
+    this._entries.add(entry);
+  }
+
+  addGroup(group: VaultGroup): void {
+    this._groups.add(group);
+  }
+
+  addError(error: DatabaseImporterEntryException): void {
+    this._errors.push(error);
+  }
+
+  getEntries(): UUIDMap<VaultEntry> {
+    return this._entries;
+  }
+
+  getGroups(): UUIDMap<VaultGroup> {
+    return this._groups;
+  }
+
+  getErrors(): DatabaseImporterEntryException[] {
+    return this._errors;
+  }
+}
+
+export abstract class DatabaseImporter {
+  private _context: common.Context;
+  private static _importers: DatabaseImporterDefinition[] = [];
+
+  constructor(context: common.Context) {
+    this._context = context;
+  }
+
+  protected requireContext(): common.Context {
+    return this._context;
+  }
+
+  /**
+   * Registers the list of importers (see ImporterDefinitions.ets). Note: keep the list sorted alphabetically.
+   */
+  static registerImporters(importers: DatabaseImporterDefinition[]): void {
+    DatabaseImporter._importers = importers;
+  }
+
+  /**
+   * Returns the path of the database of the app in its internal storage. Reading the internal
+   * storage of other apps is not possible on HarmonyOS, which is why importing directly from an
+   * app is not supported.
+   */
+  protected getAppPath(): string {
+    throw new DatabaseImporterException('Importing directly from the internal storage of other apps is not supported');
+  }
+
+  /**
+   * Returns the path of the given file/directory in the internal storage of the app with the given
+   * package name. On Android this requires root access (libsu). HarmonyOS does not allow access to
+   * the sandbox of other apps at all, so this always throws a DatabaseImporterException.
+   */
+  protected getAppPathForPackage(pkgName: string, subPath: string): string {
+    throw new DatabaseImporterException(
+      `Importing directly from the internal storage of other apps is not supported on HarmonyOS (${pkgName}/${subPath})`);
+  }
+
+  isInstalledAppVersionSupported(): boolean {
+    return true;
+  }
+
+  /**
+   * Reads the given file contents and returns the state of the importer.
+   */
+  abstract read(stream: Uint8Array, isInternal?: boolean): Promise<DatabaseImporterState>;
+
+  async readFromApp(): Promise<DatabaseImporterState> {
+    const path = this.getAppPath();
+    let bytes: Uint8Array;
+    try {
+      bytes = IOUtils.readFile(path);
+    } catch (e) {
+      throw new DatabaseImporterException(`Unable to read ${path}: ${(e as Error).message}`);
+    }
+    return this.read(bytes, true);
+  }
+
+  static create(context: common.Context, definition: DatabaseImporterDefinition): DatabaseImporter {
+    return definition.getFactory()(context);
+  }
+
+  static getImporters(isDirect: boolean): DatabaseImporterDefinition[] {
+    if (isDirect) {
+      return DatabaseImporter._importers.filter((d: DatabaseImporterDefinition) => d.supportsDirect());
+    }
+    return DatabaseImporter._importers.slice();
+  }
+}
