diff --git a/entry/src/main/ets/vault/VaultEntryIcon.ets b/entry/src/main/ets/vault/VaultEntryIcon.ets
new file mode 100644
index 0000000..b001bc6
--- /dev/null
+++ b/entry/src/main/ets/vault/VaultEntryIcon.ets
@@ -0,0 +1,96 @@
+import { IconType, IconTypeUtils } from '../icons/IconType';
+import { CryptoUtils } from '../crypto/CryptoUtils';
+import { Base64 } from '../encoding/Base64';
+import { Hex } from '../encoding/Hex';
+import { Bytes } from '../util/Bytes';
+import { JSONObject } from '../util/JSONObject';
+import { JsonUtils } from '../util/JsonUtils';
+import { VaultEntryIconException } from './VaultEntryIconException';
+
+export class VaultEntryIcon {
+  private readonly _bytes: Uint8Array;
+  private readonly _hash: Uint8Array;
+  private readonly _type: IconType;
+
+  static readonly MAX_DIMENS: number = 512;
+
+  constructor(bytes: Uint8Array, type: IconType, hash?: Uint8Array) {
+    this._bytes = bytes;
+    this._type = type;
+    this._hash = hash !== undefined ? hash : VaultEntryIcon.generateHash(bytes, type);
+  }
+
+  getBytes(): Uint8Array {
+    return this._bytes;
+  }
+
+  getHash(): Uint8Array {
+    return this._hash;
+  }
+
+  getType(): IconType {
+    return this._type;
+  }
+
+  getHashString(): string {
+    return Hex.encode(this._hash);
+  }
+
+  equals(o: Object | null): boolean {
+    if (!(o instanceof VaultEntryIcon)) {
+      return false;
+    }
+    return Bytes.equals(this.getHash(), (o as VaultEntryIcon).getHash());
+  }
+
+  static iconsEqual(a: VaultEntryIcon | null, b: VaultEntryIcon | null): boolean {
+    if (a === null || b === null) {
+      return a === b;
+    }
+    return a.equals(b);
+  }
+
+  static toJson(icon: VaultEntryIcon | null, obj: JSONObject): void {
+    obj.put('icon', icon === null ? null : Base64.encode(icon.getBytes()));
+    if (icon !== null) {
+      obj.put('icon_mime', IconTypeUtils.toMimeType(icon.getType()));
+      obj.put('icon_hash', Hex.encode(icon.getHash()));
+    }
+  }
+
+  static fromJson(obj: JSONObject): VaultEntryIcon | null {
+    try {
+      if (obj.isNull('icon')) {
+        if (!obj.has('icon')) {
+          throw new VaultEntryIconException('No value for icon');
+        }
+        return null;
+      }
+
+      const mime = JsonUtils.optString(obj, 'icon_mime');
+      const iconType = mime === null ? IconType.JPEG : IconTypeUtils.fromMimeType(mime);
+      if (iconType === IconType.INVALID) {
+        throw new VaultEntryIconException(`Bad icon MIME type: ${mime}`);
+      }
+
+      const iconBytes = Base64.decode(obj.getString('icon'));
+      const iconHashStr = JsonUtils.optString(obj, 'icon_hash');
+      if (iconHashStr !== null) {
+        const iconHash = Hex.decode(iconHashStr);
+        return new VaultEntryIcon(iconBytes, iconType, iconHash);
+      }
+
+      return new VaultEntryIcon(iconBytes, iconType);
+    } catch (e) {
+      if (e instanceof VaultEntryIconException) {
+        throw e as VaultEntryIconException;
+      }
+      throw new VaultEntryIconException((e as Error).message);
+    }
+  }
+
+  private static generateHash(bytes: Uint8Array, type: IconType): Uint8Array {
+    const mime = Bytes.fromUtf8(IconTypeUtils.toMimeType(type));
+    return CryptoUtils.sha256(Bytes.concat([mime, bytes]));
+  }
+}
