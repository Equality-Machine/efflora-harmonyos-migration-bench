diff --git a/entry/src/main/ets/info/guardianproject/trustedintents/ApkSignaturePin.ets b/entry/src/main/ets/info/guardianproject/trustedintents/ApkSignaturePin.ets
new file mode 100644
index 0000000..b3b865d
--- /dev/null
+++ b/entry/src/main/ets/info/guardianproject/trustedintents/ApkSignaturePin.ets
@@ -0,0 +1,27 @@
+/**
+ * Port of ApkSignaturePin: a pinned signing certificate (by its SHA-256 fingerprint) of an app
+ * that is trusted to send intents.
+ */
+export abstract class ApkSignaturePin {
+  // hex-encoded SHA-256 hashes of the certs
+  protected fingerprints: string[] = [];
+  // bundle names of the HarmonyOS apps that are signed with these certs
+  protected bundleNames: string[] = [];
+
+  getSHA256Fingerprint(): string {
+    return this.fingerprints.length > 0 ? this.fingerprints[0] : '';
+  }
+
+  getFingerprints(): string[] {
+    return this.fingerprints;
+  }
+
+  getBundleNames(): string[] {
+    return this.bundleNames;
+  }
+
+  matchesFingerprint(fingerprint: string): boolean {
+    const f = fingerprint.toLowerCase().replace(new RegExp(':', 'g'), '');
+    return this.fingerprints.indexOf(f) >= 0;
+  }
+}
diff --git a/entry/src/main/ets/info/guardianproject/trustedintents/TrustedIntents.ets b/entry/src/main/ets/info/guardianproject/trustedintents/TrustedIntents.ets
new file mode 100644
index 0000000..f29bf04
--- /dev/null
+++ b/entry/src/main/ets/info/guardianproject/trustedintents/TrustedIntents.ets
@@ -0,0 +1,70 @@
+import { bundleManager, Want } from '@kit.AbilityKit';
+import { ApkSignaturePin } from './ApkSignaturePin';
+
+const CALLER_BUNDLE_KEY: string = 'ohos.aafwk.param.callerBundleName';
+
+/**
+ * Port of TrustedIntents: only accepts intents (wants) from callers that are signed with one of
+ * the pinned certificates.
+ */
+export class TrustedIntents {
+  private static _instance: TrustedIntents | null = null;
+  private _pinList: ApkSignaturePin[] = [];
+
+  private constructor() {
+  }
+
+  static get(): TrustedIntents {
+    if (TrustedIntents._instance === null) {
+      TrustedIntents._instance = new TrustedIntents();
+    }
+    return TrustedIntents._instance;
+  }
+
+  static getCallingPackageName(want: Want): string | null {
+    if (want.parameters === undefined) {
+      return null;
+    }
+    const caller = want.parameters[CALLER_BUNDLE_KEY];
+    return typeof caller === 'string' ? caller as string : null;
+  }
+
+  addTrustedSigner(pin: ApkSignaturePin): boolean {
+    if (this._pinList.some((p: ApkSignaturePin) => p.getSHA256Fingerprint() === pin.getSHA256Fingerprint())) {
+      return false;
+    }
+    this._pinList.push(pin);
+    return true;
+  }
+
+  removeAllTrustedSigners(): boolean {
+    this._pinList = [];
+    return true;
+  }
+
+  isPackageNameTrusted(packageName: string): boolean {
+    // check the signing certificate of the caller if it's available to us
+    try {
+      const info = bundleManager.getBundleInfoSync(packageName,
+        bundleManager.BundleFlag.GET_BUNDLE_INFO_WITH_SIGNATURE_INFO);
+      const fingerprint = info.signatureInfo.fingerprint;
+      if (this._pinList.some((p: ApkSignaturePin) => p.matchesFingerprint(fingerprint))) {
+        return true;
+      }
+    } catch (e) {
+      // information about other apps is not available to normal apps
+    }
+    return this._pinList.some((p: ApkSignaturePin) => p.getBundleNames().indexOf(packageName) >= 0);
+  }
+
+  /**
+   * Returns the given want if it was sent by a trusted app, null otherwise.
+   */
+  getIntentFromTrustedSender(want: Want): Want | null {
+    const packageName = TrustedIntents.getCallingPackageName(want);
+    if (packageName === null || packageName.length === 0) {
+      return null;
+    }
+    return this.isPackageNameTrusted(packageName) ? want : null;
+  }
+}
diff --git a/entry/src/main/ets/otp/GoogleAuthInfo.ets b/entry/src/main/ets/otp/GoogleAuthInfo.ets
new file mode 100644
index 0000000..d8a13c5
--- /dev/null
+++ b/entry/src/main/ets/otp/GoogleAuthInfo.ets
@@ -0,0 +1,462 @@
+import { Uri } from '../util/Uri';
+import { Base32 } from '../encoding/Base32';
+import { Base64 } from '../encoding/Base64';
+import { Hex } from '../encoding/Hex';
+import { Bytes } from '../util/Bytes';
+import { OtpInfo } from './OtpInfo';
+import { TotpInfo } from './TotpInfo';
+import { HotpInfo } from './HotpInfo';
+import { SteamInfo } from './SteamInfo';
+import { YandexInfo } from './YandexInfo';
+import { MotpInfo } from './MotpInfo';
+import { GoogleAuthInfoException } from './GoogleAuthInfoException';
+import { Transferable } from './Transferable';
+import { Algorithm, DigitCount, MigrationPayload, OtpParameters, OtpType } from './GoogleAuthProtos';
+
+export class GoogleAuthInfo implements Transferable {
+  static readonly SCHEME: string = 'otpauth';
+  static readonly SCHEME_EXPORT: string = 'otpauth-migration';
+
+  private _info: OtpInfo;
+  private _accountName: string;
+  private _issuer: string;
+
+  constructor(info: OtpInfo, accountName: string, issuer: string) {
+    this._info = info;
+    this._accountName = accountName;
+    this._issuer = issuer;
+  }
+
+  static parseUri(s: string): GoogleAuthInfo {
+    const uri = Uri.parse(s);
+    return GoogleAuthInfo.parseUriObj(uri);
+  }
+
+  static parseUriObj(uri: Uri): GoogleAuthInfo {
+    const scheme = uri.getScheme();
+    if (scheme === null || !(scheme === GoogleAuthInfo.SCHEME || scheme === MotpInfo.SCHEME)) {
+      throw new GoogleAuthInfoException(uri, `Unsupported protocol: ${scheme}`);
+    }
+
+    // 'secret' is a required parameter
+    const encodedSecret = uri.getQueryParameter('secret');
+    if (encodedSecret === null) {
+      throw new GoogleAuthInfoException(uri, 'Parameter \'secret\' is not present');
+    }
+
+    let secret: Uint8Array;
+    try {
+      secret = scheme === MotpInfo.SCHEME ? Hex.decode(encodedSecret) : GoogleAuthInfo.parseSecret(encodedSecret);
+    } catch (e) {
+      throw new GoogleAuthInfoException(uri, 'Bad secret', e as Error);
+    }
+    if (secret.length === 0) {
+      throw new GoogleAuthInfoException(uri, 'Secret is empty');
+    }
+
+    let info: OtpInfo;
+    let issuer = '';
+    try {
+      const type = scheme === MotpInfo.SCHEME ? MotpInfo.ID : uri.getHost();
+      if (type === null || type.length === 0) {
+        throw new GoogleAuthInfoException(uri, `Host not present in URI: ${uri.toString()}`);
+      }
+
+      switch (type) {
+        case 'totp': {
+          const totpInfo = new TotpInfo(secret);
+          const period = uri.getQueryParameter('period');
+          if (period !== null) {
+            totpInfo.setPeriod(GoogleAuthInfo.parseInt(period));
+          }
+          info = totpInfo;
+          break;
+        }
+        case 'steam': {
+          const steamInfo = new SteamInfo(secret);
+          const period = uri.getQueryParameter('period');
+          if (period !== null) {
+            steamInfo.setPeriod(GoogleAuthInfo.parseInt(period));
+          }
+          info = steamInfo;
+          break;
+        }
+        case 'hotp': {
+          const hotpInfo = new HotpInfo(secret);
+          const counter = uri.getQueryParameter('counter');
+          if (counter === null) {
+            throw new GoogleAuthInfoException(uri, 'Parameter \'counter\' is not present');
+          }
+          hotpInfo.setCounter(GoogleAuthInfo.parseInt(counter));
+          info = hotpInfo;
+          break;
+        }
+        case YandexInfo.HOST_ID: {
+          let pin = uri.getQueryParameter('pin');
+          if (pin !== null) {
+            pin = Bytes.toUtf8(GoogleAuthInfo.parseSecret(pin));
+          }
+          info = new YandexInfo(secret, pin);
+          issuer = info.getType();
+          break;
+        }
+        case MotpInfo.ID:
+          info = new MotpInfo(secret);
+          break;
+        default:
+          throw new GoogleAuthInfoException(uri, `Unsupported OTP type: ${type}`);
+      }
+    } catch (e) {
+      if (e instanceof GoogleAuthInfoException) {
+        throw e as GoogleAuthInfoException;
+      }
+      throw new GoogleAuthInfoException(uri, (e as Error).message);
+    }
+
+    // provider info used to disambiguate accounts
+    const path = uri.getPath();
+    const label = path !== null && path.length > 0 ? (path.startsWith('/') ? path.substring(1) : path) : '';
+
+    let accountName = '';
+
+    if (label.indexOf(':') >= 0) {
+      // a label can only contain one colon
+      // it's ok to fail if that's not the case
+      const strings = label.split(':');
+      if (strings.length === 2) {
+        issuer = strings[0];
+        accountName = strings[1];
+      } else {
+        // at this point, just dump the whole thing into the accountName
+        accountName = label;
+      }
+    } else {
+      // label only contains the account name
+      // grab the issuer's info from the 'issuer' parameter if it's present
+      const issuerParam = uri.getQueryParameter('issuer');
+      if (issuer.length === 0) {
+        issuer = issuerParam !== null ? issuerParam : '';
+      }
+      accountName = label;
+    }
+
+    // just use the defaults if these parameters aren't set
+    try {
+      const algorithm = uri.getQueryParameter('algorithm');
+      if (algorithm !== null) {
+        info.setAlgorithm(algorithm);
+      }
+      const digits = uri.getQueryParameter('digits');
+      if (digits !== null) {
+        info.setDigits(GoogleAuthInfo.parseInt(digits));
+      }
+    } catch (e) {
+      throw new GoogleAuthInfoException(uri, (e as Error).message);
+    }
+
+    return new GoogleAuthInfo(info, accountName, issuer);
+  }
+
+  private static parseInt(s: string): number {
+    if (!new RegExp('^[+-]?\\d+$').test(s.trim())) {
+      throw new Error(`For input string: "${s}"`);
+    }
+    return Number.parseInt(s.trim(), 10);
+  }
+
+  /**
+   * Decodes the given base 32 secret, while being tolerant of whitespace and dashes.
+   */
+  static parseSecret(s: string): Uint8Array {
+    const str = s.trim().replace(new RegExp('-', 'g'), '').replace(new RegExp(' ', 'g'), '');
+    return Base32.decode(str);
+  }
+
+  static parseExportUri(s: string): GoogleAuthInfoExport {
+    const uri = Uri.parse(s);
+    return GoogleAuthInfo.parseExportUriObj(uri);
+  }
+
+  static parseExportUriObj(uri: Uri): GoogleAuthInfoExport {
+    const scheme = uri.getScheme();
+    if (scheme === null || scheme !== GoogleAuthInfo.SCHEME_EXPORT) {
+      throw new GoogleAuthInfoException(uri, 'Unsupported protocol');
+    }
+
+    const host = uri.getHost();
+    if (host === null || host !== 'offline') {
+      throw new GoogleAuthInfoException(uri, 'Unsupported host');
+    }
+
+    const data = uri.getQueryParameter('data');
+    if (data === null) {
+      throw new GoogleAuthInfoException(uri, 'Parameter \'data\' is not set');
+    }
+
+    let payload: MigrationPayload;
+    try {
+      // getQueryParameter converts '+' into ' ', so convert it back
+      const bytes = Base64.decode(data.replace(new RegExp(' ', 'g'), '+'));
+      payload = MigrationPayload.parseFrom(bytes);
+    } catch (e) {
+      throw new GoogleAuthInfoException(uri, (e as Error).message);
+    }
+
+    const infos: GoogleAuthInfo[] = [];
+    for (const params of payload.otpParameters) {
+      let otp: OtpInfo;
+      try {
+        let digits: number;
+        switch (params.digits) {
+          case DigitCount.DIGIT_COUNT_UNSPECIFIED:
+          // intentional fallthrough
+          case DigitCount.DIGIT_COUNT_SIX:
+            digits = OtpInfo.DEFAULT_DIGITS;
+            break;
+          case DigitCount.DIGIT_COUNT_EIGHT:
+            digits = 8;
+            break;
+          default:
+            throw new GoogleAuthInfoException(uri, `Unsupported digits: ${params.digits}`);
+        }
+
+        let algo: string;
+        switch (params.algorithm) {
+          case Algorithm.ALGORITHM_UNSPECIFIED:
+          // intentional fallthrough
+          case Algorithm.ALGORITHM_SHA1:
+            algo = 'SHA1';
+            break;
+          case Algorithm.ALGORITHM_SHA256:
+            algo = 'SHA256';
+            break;
+          case Algorithm.ALGORITHM_SHA512:
+            algo = 'SHA512';
+            break;
+          default:
+            throw new GoogleAuthInfoException(uri, `Unsupported hash algorithm: ${params.algorithm}`);
+        }
+
+        const secret = params.secret;
+        if (secret.length === 0) {
+          throw new GoogleAuthInfoException(uri, 'Secret is empty');
+        }
+
+        switch (params.type) {
+          case OtpType.OTP_TYPE_UNSPECIFIED:
+          // intentional fallthrough
+          case OtpType.OTP_TYPE_TOTP:
+            otp = new TotpInfo(secret, algo, digits, TotpInfo.DEFAULT_PERIOD);
+            break;
+          case OtpType.OTP_TYPE_HOTP:
+            otp = new HotpInfo(secret, algo, digits, params.counter);
+            break;
+          default:
+            throw new GoogleAuthInfoException(uri, `Unsupported algorithm: ${params.type}`);
+        }
+      } catch (e) {
+        if (e instanceof GoogleAuthInfoException) {
+          throw e as GoogleAuthInfoException;
+        }
+        throw new GoogleAuthInfoException(uri, (e as Error).message);
+      }
+
+      let name = params.name;
+      let issuer = params.issuer;
+      const colonI = name.indexOf(':');
+      if (issuer.length === 0 && colonI !== -1) {
+        issuer = name.substring(0, colonI);
+        name = name.substring(colonI + 1);
+      }
+
+      infos.push(new GoogleAuthInfo(otp, name, issuer));
+    }
+
+    return new GoogleAuthInfoExport(infos, payload.batchId, payload.batchIndex, payload.batchSize);
+  }
+
+  getOtpInfo(): OtpInfo {
+    return this._info;
+  }
+
+  getUri(): Uri {
+    const builder = Uri.builder();
+
+    if (this._info instanceof MotpInfo) {
+      builder.scheme(MotpInfo.SCHEME);
+      builder.appendQueryParameter('secret', Hex.encode(this._info.getSecret()));
+    } else {
+      builder.scheme(GoogleAuthInfo.SCHEME);
+
+      if (this._info instanceof TotpInfo) {
+        if (this._info instanceof SteamInfo) {
+          builder.authority('steam');
+        } else if (this._info instanceof YandexInfo) {
+          builder.authority(YandexInfo.HOST_ID);
+        } else {
+          builder.authority('totp');
+        }
+        builder.appendQueryParameter('period', `${(this._info as TotpInfo).getPeriod()}`);
+      } else if (this._info instanceof HotpInfo) {
+        builder.authority('hotp');
+        builder.appendQueryParameter('counter', `${(this._info as HotpInfo).getCounter()}`);
+      } else {
+        throw new Error(`Unsupported OtpInfo type: ${this._info.getTypeId()}`);
+      }
+
+      builder.appendQueryParameter('digits', `${this._info.getDigits()}`);
+      builder.appendQueryParameter('algorithm', this._info.getAlgorithm(false));
+      builder.appendQueryParameter('secret', Base32.encode(this._info.getSecret()));
+
+      if (this._info instanceof YandexInfo) {
+        const pin = (this._info as YandexInfo).getPin();
+        builder.appendQueryParameter('pin', Base32.encodeString(pin !== null ? pin : ''));
+      }
+    }
+
+    if (this._issuer !== null && this._issuer.length > 0) {
+      builder.path(`${this._issuer}:${this._accountName}`);
+      builder.appendQueryParameter('issuer', this._issuer);
+    } else {
+      builder.path(this._accountName);
+    }
+
+    return builder.build();
+  }
+
+  getIssuer(): string {
+    return this._issuer;
+  }
+
+  getAccountName(): string {
+    return this._accountName;
+  }
+}
+
+/**
+ * Port of GoogleAuthInfo.Export
+ */
+export class GoogleAuthInfoExport implements Transferable {
+  private _batchId: number;
+  private _batchIndex: number;
+  private _batchSize: number;
+  private _entries: GoogleAuthInfo[];
+
+  constructor(entries: GoogleAuthInfo[], batchId: number, batchIndex: number, batchSize: number) {
+    this._batchId = batchId;
+    this._batchIndex = batchIndex;
+    this._batchSize = batchSize;
+    this._entries = entries;
+  }
+
+  getEntries(): GoogleAuthInfo[] {
+    return this._entries;
+  }
+
+  getBatchSize(): number {
+    return this._batchSize;
+  }
+
+  getBatchIndex(): number {
+    return this._batchIndex;
+  }
+
+  getBatchId(): number {
+    return this._batchId;
+  }
+
+  static getMissingIndices(exports: GoogleAuthInfoExport[]): number[] {
+    if (!GoogleAuthInfoExport.isSingleBatch(exports)) {
+      throw new Error('Export list contains entries from different batches');
+    }
+
+    const indicesMissing: number[] = [];
+    if (exports.length === 0) {
+      return indicesMissing;
+    }
+
+    const indicesPresent = new Set<number>(exports.map((e: GoogleAuthInfoExport) => e.getBatchIndex()));
+    for (let i = 0; i < exports[0].getBatchSize(); i++) {
+      if (!indicesPresent.has(i)) {
+        indicesMissing.push(i);
+      }
+    }
+    return indicesMissing;
+  }
+
+  static isSingleBatch(exports: GoogleAuthInfoExport[]): boolean {
+    if (exports.length === 0) {
+      return true;
+    }
+    const batchId = exports[0].getBatchId();
+    for (const exp of exports) {
+      if (exp.getBatchId() !== batchId) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  getUri(): Uri {
+    const payload = new MigrationPayload();
+    payload.batchId = this._batchId;
+    payload.batchIndex = this._batchIndex;
+    payload.batchSize = this._batchSize;
+    payload.version = 1;
+
+    for (const info of this._entries) {
+      const parameters = new OtpParameters();
+      parameters.secret = info.getOtpInfo().getSecret();
+      parameters.name = info.getAccountName();
+      parameters.issuer = info.getIssuer();
+
+      switch (info.getOtpInfo().getAlgorithm(false)) {
+        case 'SHA1':
+          parameters.algorithm = Algorithm.ALGORITHM_SHA1;
+          break;
+        case 'SHA256':
+          parameters.algorithm = Algorithm.ALGORITHM_SHA256;
+          break;
+        case 'SHA512':
+          parameters.algorithm = Algorithm.ALGORITHM_SHA512;
+          break;
+        case 'MD5':
+          parameters.algorithm = Algorithm.ALGORITHM_MD5;
+          break;
+        default:
+          throw new GoogleAuthInfoException(info.getUri(), `Unsupported Algorithm: ${info.getOtpInfo().getAlgorithm(false)}`);
+      }
+
+      switch (info.getOtpInfo().getDigits()) {
+        case 6:
+          parameters.digits = DigitCount.DIGIT_COUNT_SIX;
+          break;
+        case 8:
+          parameters.digits = DigitCount.DIGIT_COUNT_EIGHT;
+          break;
+        default:
+          throw new GoogleAuthInfoException(info.getUri(), `Unsupported number of digits: ${info.getOtpInfo().getDigits()}`);
+      }
+
+      switch (info.getOtpInfo().getType().toLowerCase()) {
+        case HotpInfo.ID:
+          parameters.type = OtpType.OTP_TYPE_HOTP;
+          parameters.counter = (info.getOtpInfo() as HotpInfo).getCounter();
+          break;
+        case TotpInfo.ID:
+          parameters.type = OtpType.OTP_TYPE_TOTP;
+          break;
+        default:
+          throw new GoogleAuthInfoException(info.getUri(), `Type unsupported by GoogleAuthProtos: ${info.getOtpInfo().getType()}`);
+      }
+
+      payload.otpParameters.push(parameters);
+    }
+
+    return Uri.builder()
+      .scheme(GoogleAuthInfo.SCHEME_EXPORT)
+      .authority('offline')
+      .appendQueryParameter('data', Base64.encode(payload.toByteArray()))
+      .build();
+  }
+}
diff --git a/entry/src/main/ets/otp/GoogleAuthInfoException.ets b/entry/src/main/ets/otp/GoogleAuthInfoException.ets
