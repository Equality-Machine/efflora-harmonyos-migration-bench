@@ -0,0 +1,38 @@
+export enum ViewMode {
+  NORMAL = 0,
+  COMPACT = 1,
+  SMALL = 2,
+  TILES = 3
+}
+
+export class ViewModeUtils {
+  static fromInteger(x: number): ViewMode {
+    return x >= 0 && x <= 3 ? x as ViewMode : ViewMode.NORMAL;
+  }
+
+  /**
+   * Retrieves the offset (in vp) that should exist between entries in this view mode.
+   */
+  static getItemOffset(mode: ViewMode): number {
+    if (mode === ViewMode.COMPACT) {
+      return 1;
+    } else if (mode === ViewMode.TILES) {
+      return 4;
+    }
+    return 8;
+  }
+
+  static getSpanCount(mode: ViewMode): number {
+    if (mode === ViewMode.TILES) {
+      return 2;
+    }
+    return 1;
+  }
+
+  static getFormattedAccountName(mode: ViewMode, accountName: string): string {
+    if (mode === ViewMode.TILES) {
+      return accountName;
+    }
+    return `(${accountName})`;
+  }
+}
diff --git a/entry/src/main/ets/crypto/Cipher.ets b/entry/src/main/ets/crypto/Cipher.ets
new file mode 100644
index 0000000..8df452e
--- /dev/null
+++ b/entry/src/main/ets/crypto/Cipher.ets
@@ -0,0 +1,132 @@
+import { huks } from '@kit.UniversalKeystoreKit';
+import { CryptoUtils, SecretKey } from './CryptoUtils';
+import { CryptResult } from './CryptResult';
+import { CryptParameters } from './CryptParameters';
+import { Bytes } from '../util/Bytes';
+
+/**
+ * Abstraction over javax.crypto.Cipher as used by the vault slots. A cipher is either backed by a
+ * key in memory (SoftwareCipher) or by a key in the HUKS keystore that requires user
+ * authentication (KeyStoreCipher).
+ */
+export interface Cipher {
+  encrypt(data: Uint8Array): Promise<CryptResult>;
+
+  decrypt(data: Uint8Array, params: CryptParameters): Promise<Uint8Array>;
+}
+
+export class SoftwareCipher implements Cipher {
+  private _key: SecretKey;
+  private _nonce: Uint8Array | null;
+
+  constructor(key: SecretKey, nonce: Uint8Array | null) {
+    this._key = key;
+    this._nonce = nonce;
+  }
+
+  async encrypt(data: Uint8Array): Promise<CryptResult> {
+    return CryptoUtils.encrypt(data, this._key);
+  }
+
+  async decrypt(data: Uint8Array, params: CryptParameters): Promise<Uint8Array> {
+    return CryptoUtils.decrypt(data, this._key, params).getData();
+  }
+
+  getNonce(): Uint8Array | null {
+    return this._nonce;
+  }
+}
+
+/**
+ * A cipher backed by a HUKS key. The session must be initialized with init(), after which the
+ * returned challenge needs to be authenticated through the user authentication framework. The
+ * resulting auth token is passed to setAuthToken() before the cipher can be used.
+ */
+export class KeyStoreCipher implements Cipher {
+  private _alias: string;
+  private _encrypt: boolean;
+  private _nonce: Uint8Array;
+  private _tag: Uint8Array | null;
+  private _handle: number = -1;
+  private _challenge: Uint8Array = new Uint8Array(0);
+  private _authToken: Uint8Array | null = null;
+
+  constructor(alias: string, encrypt: boolean, nonce: Uint8Array, tag: Uint8Array | null) {
+    this._alias = alias;
+    this._encrypt = encrypt;
+    this._nonce = nonce;
+    this._tag = tag;
+  }
+
+  private getProperties(): Array<huks.HuksParam> {
+    const props: Array<huks.HuksParam> = [
+      { tag: huks.HuksTag.HUKS_TAG_ALGORITHM, value: huks.HuksKeyAlg.HUKS_ALG_AES },
+      { tag: huks.HuksTag.HUKS_TAG_KEY_SIZE, value: huks.HuksKeySize.HUKS_AES_KEY_SIZE_256 },
+      {
+        tag: huks.HuksTag.HUKS_TAG_PURPOSE,
+        value: this._encrypt ? huks.HuksKeyPurpose.HUKS_KEY_PURPOSE_ENCRYPT : huks.HuksKeyPurpose.HUKS_KEY_PURPOSE_DECRYPT
+      },
+      { tag: huks.HuksTag.HUKS_TAG_PADDING, value: huks.HuksKeyPadding.HUKS_PADDING_NONE },
+      { tag: huks.HuksTag.HUKS_TAG_BLOCK_MODE, value: huks.HuksCipherMode.HUKS_MODE_GCM },
+      { tag: huks.HuksTag.HUKS_TAG_NONCE, value: this._nonce },
+      { tag: huks.HuksTag.HUKS_TAG_ASSOCIATED_DATA, value: new Uint8Array(0) }
+    ];
+    if (!this._encrypt && this._tag !== null) {
+      props.push({ tag: huks.HuksTag.HUKS_TAG_AE_TAG, value: this._tag });
+    }
+    return props;
+  }
+
+  /**
+   * Initializes the HUKS session and returns the challenge that must be authenticated.
+   */
+  async init(): Promise<Uint8Array> {
+    const options: huks.HuksOptions = { properties: this.getProperties() };
+    const session = await huks.initSession(this._alias, options);
+    this._handle = session.handle;
+    this._challenge = session.challenge !== undefined ? session.challenge : new Uint8Array(0);
+    return this._challenge;
+  }
+
+  getChallenge(): Uint8Array {
+    return this._challenge;
+  }
+
+  setAuthToken(token: Uint8Array): void {
+    this._authToken = token;
+  }
+
+  async abort(): Promise<void> {
+    if (this._handle >= 0) {
+      try {
+        await huks.abortSession(this._handle, { properties: this.getProperties() });
+      } catch (e) {
+        // ignore
+      }
+      this._handle = -1;
+    }
+  }
+
+  private async finish(data: Uint8Array): Promise<Uint8Array> {
+    const props = this.getProperties();
+    if (this._authToken !== null) {
+      props.push({ tag: huks.HuksTag.HUKS_TAG_AUTH_TOKEN, value: this._authToken });
+    }
+    const options: huks.HuksOptions = { properties: props, inData: data };
+    const res = await huks.finishSession(this._handle, options);
+    this._handle = -1;
+    return res.outData !== undefined ? Bytes.copy(res.outData) : new Uint8Array(0);
+  }
+
+  async encrypt(data: Uint8Array): Promise<CryptResult> {
+    const out = await this.finish(data);
+    const tagSize = CryptoUtils.CRYPTO_AEAD_TAG_SIZE;
+    const encrypted = Bytes.copyOfRange(out, 0, out.length - tagSize);
+    const tag = Bytes.copyOfRange(out, out.length - tagSize, out.length);
+    return new CryptResult(encrypted, new CryptParameters(this._nonce, tag));
+  }
+
+  async decrypt(data: Uint8Array, params: CryptParameters): Promise<Uint8Array> {
+    return this.finish(data);
+  }
+}
