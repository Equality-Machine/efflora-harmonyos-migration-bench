@@ -0,0 +1,32 @@
+/**
+ * Port of SlideIndicator: a row of dots that indicates the current slide.
+ */
+@Component
+export struct SlideIndicator {
+  @Prop slideCount: number = 0;
+  @Prop currentSlide: number = 0;
+  @Prop dotRadius: number = 5;
+  @Prop dotSeparation: number = 5;
+
+  private getIndices(): number[] {
+    const res: number[] = [];
+    for (let i = 0; i < this.slideCount; i++) {
+      res.push(i);
+    }
+    return res;
+  }
+
+  build() {
+    Row() {
+      ForEach(this.getIndices(), (i: number) => {
+        Circle()
+          .width(this.dotRadius * 2)
+          .height(this.dotRadius * 2)
+          .fill(i === this.currentSlide ? $r('app.color.theme_primary') : $r('app.color.theme_outlineVariant'))
+          .margin({ left: this.dotSeparation / 2, right: this.dotSeparation / 2 })
+      }, (i: number) => `${i}-${i === this.currentSlide}`)
+    }
+    .width('100%')
+    .justifyContent(FlexAlign.Center)
+  }
+}
