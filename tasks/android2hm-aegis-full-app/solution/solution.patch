+++ b/entry/src/main/ets/importers/FreeOtpPlusImporter.ets
@@ -0,0 +1,43 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterState } from './DatabaseImporter';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { FreeOtpImporter, FreeOtpImporterDecryptedStateV1 } from './FreeOtpImporter';
+import { JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+
+const _subPath: string = 'shared_prefs/tokens.xml';
+
+const _pkgName: string = 'org.liberty.android.freeotpplus';
+
+export class FreeOtpPlusImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    return this.getAppPathForPackage(_pkgName, _subPath);
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    let state: DatabaseImporterState;
+    if (isInternal) {
+      state = await new FreeOtpImporter(this.requireContext()).read(stream);
+    }
+    else {
+      try {
+        const json = Bytes.toUtf8(stream);
+        const obj = new JSONObject(json);
+        const array = obj.getJSONArray('tokens');
+        const entries: JSONObject[] = [];
+        for (let i = 0; i < array.length(); i++) {
+          entries.push(array.getJSONObject(i));
+        }
+        state = new FreeOtpImporterDecryptedStateV1(entries);
+      }
+      catch (e) {
+        throw new DatabaseImporterException((e as Error).message);
+      }
+    }
+    return state;
+  }
+}
diff --git a/entry/src/main/ets/importers/GoogleAuthImporter.ets b/entry/src/main/ets/importers/GoogleAuthImporter.ets
