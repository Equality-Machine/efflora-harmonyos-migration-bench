+        .fontSize(13)
+        .fontColor($r('app.color.theme_onSurface'))
+        .textAlign(TextAlign.Center)
+        .width('100%')
+        .maxLines(2)
+        .textOverflow({ overflow: TextOverflow.Ellipsis })
+    }
+    .width(this.cellWidth)
+    .padding(5)
+    .onClick(() => {
+      if (this.icon !== null) {
+        this.onIconClick(this.icon);
+      }
+    })
+  }
