+import { AegisActivity, PAGE_GROUP_MANAGER } from './AegisActivity';
+import { Toolbar, ToolbarMenuItem } from './components/Toolbar';
+import { Dialogs } from './dialogs/Dialogs';
+import { GroupAdapter, GroupAdapterListener } from './views/GroupAdapter';
+import { GroupHolder } from './views/GroupHolder';
+import { VaultGroup } from '../vault/VaultGroup';
+
+/**
+ * Port of GroupManagerActivity: rename, remove and reorder (long press + drag) the groups of the vault.
+ */
+@Entry
+@Component
+struct GroupManagerActivity {
+  private _activity: AegisActivity | null = null;
+  private _adapter: GroupAdapter = new GroupAdapter(new GroupAdapterListener(
+    (group: VaultGroup) => this.onEditGroup(group),
+    (group: VaultGroup) => this.onRemoveGroup(group)));
+  private _removedGroups: Set<string> = new Set<string>();
+  private _backPressHandlerEnabled: boolean = false;
+  @State _groups: VaultGroup[] = [];
+  @State _menuItems: ToolbarMenuItem[] = [];
+  @State _emptyState: boolean = false;
+
+  aboutToAppear(): void {
+    this._activity = new AegisActivity(this.getUIContext(), PAGE_GROUP_MANAGER);
+    this.onCreate();
+  }
+
+  onPageShow(): void {
+    if (this._activity !== null) {
+      this._activity.onResume();
+    }
+  }
+
+  aboutToDisappear(): void {
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  onBackPress(): boolean {
+    if (this._backPressHandlerEnabled) {
+      this.discardAndFinish();
+      return true;
+    }
+    return false;
+  }
+
+  private act(): AegisActivity {
+    return this._activity as AegisActivity;
+  }
+
+  private onCreate(): void {
+    const activity = this.act();
+    activity.onCreate();
+    if (activity.abortIfOrphan()) {
+      return;
+    }
+
+    this._adapter.registerObserver(() => {
+      this._groups = this._adapter.getGroups().slice();
+    });
+
+    for (const group of activity.getVaultManager().getVault().getGroups()) {
+      if (!this._removedGroups.has(group.getUUID())) {
+        this._adapter.addGroup(group);
+      }
+    }
+
+    this.onCreateOptionsMenu();
+    this.updateEmptyState();
+  }
+
+  onEditGroup(group: VaultGroup): void {
+    Dialogs.showTextInputDialog(this.getUIContext(), $r('app.string.rename_group'), $r('app.string.group_name_hint'),
+      (text: string) => {
+        const newGroupName = text.trim();
+        if (newGroupName.length > 0) {
+          const newGroup = group.clone();
+          newGroup.setName(newGroupName);
+          this._adapter.replaceGroup(group.getUUID(), newGroup);
+          this._backPressHandlerEnabled = true;
+        }
+      }, group.getName());
+  }
+
+  onRemoveGroup(group: VaultGroup): void {
+    Dialogs.showSimpleDialog(this.getUIContext(), $r('app.string.remove_group'), $r('app.string.remove_group_description'),
+      $r('app.string.yes'), () => {
+        this._removedGroups.add(group.getUUID());
+        this._adapter.removeGroup(group);
+        this._backPressHandlerEnabled = true;
+        this.updateEmptyState();
+      },
+      $r('app.string.no'), null, undefined, undefined, true);
+  }
+
+  onRemoveUnusedGroups(): void {
+    Dialogs.showSimpleDialog(this.getUIContext(), $r('app.string.remove_unused_groups'),
+      $r('app.string.remove_unused_groups_description'),
+      $r('app.string.yes'), () => {
+        const vault = this.act().getVaultManager().getVault();
+        const usedGroups = new Set<string>(vault.getUsedGroups().map((g: VaultGroup) => g.getUUID()));
+        const unusedGroups = vault.getGroups().filter((g: VaultGroup) => !usedGroups.has(g.getUUID()));
+
+        for (const group of unusedGroups) {
+          this._removedGroups.add(group.getUUID());
+          this._adapter.removeGroup(group);
+        }
+        this._backPressHandlerEnabled = true;
+        this.updateEmptyState();
+      },
+      $r('app.string.no'), null, undefined, undefined, true);
+  }
+
+  private saveAndFinish(): void {
+    const vault = this.act().getVaultManager().getVault();
+    if (this._removedGroups.size > 0) {
+      for (const uuid of Array.from(this._removedGroups)) {
+        if (vault.findGroupByUUID(uuid) !== null) {
+          vault.removeGroupByUUID(uuid);
+        }
+      }
+    }
+
+    vault.replaceGroups(this._adapter.getGroups());
+    this.act().saveAndBackupVault();
+
+    this.act().finish();
+  }
+
+  private discardAndFinish(): void {
+    if (this._removedGroups.size === 0) {
+      this.act().finish();
+      return;
+    }
+
+    Dialogs.showDiscardDialog(this.getUIContext(),
+      () => this.saveAndFinish(),
+      () => this.act().finish());
+  }
+
+  private onCreateOptionsMenu(): void {
+    this._menuItems = [
+      new ToolbarMenuItem('action_delete_unused_groups', $r('app.string.remove_unused_groups'), null, false),
+      new ToolbarMenuItem('action_save', $r('app.string.save'), $r('app.media.ic_outline_check_24'), true)
+    ];
+  }
+
+  private onOptionsItemSelected(itemId: string): boolean {
+    if (itemId === 'home') {
+      this.discardAndFinish();
+    } else if (itemId === 'action_save') {
+      this.saveAndFinish();
+    } else if (itemId === 'action_delete_unused_groups') {
+      this.onRemoveUnusedGroups();
+    } else {
+      return false;
+    }
+
+    return true;
+  }
+
+  private updateEmptyState(): void {
+    this._emptyState = this._adapter.getItemCount() === 0;
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.title_activity_manage_groups'),
+        menuItems: this._menuItems,
+        onBack: () => {
+          this.onOptionsItemSelected('home');
+        },
+        onMenuItemClick: (id: string) => {
+          this.onOptionsItemSelected(id);
+        }
+      })
+      if (!this._emptyState) {
+        List() {
+          ForEach(this._groups, (group: VaultGroup) => {
+            ListItem() {
+              GroupHolder({
+                groupName: group.getName(),
+                onEditClick: () => this._adapter.getListener().onEditGroup(group),
+                onDeleteClick: () => this._adapter.getListener().onRemoveGroup(group)
+              })
+            }
+          }, (group: VaultGroup) => `${group.getUUID()}:${group.getName()}`)
+            .onMove((from: number, to: number) => {
+              this._adapter.onItemMove(from, to);
+              this._backPressHandlerEnabled = true;
+            })
+        }
+        .layoutWeight(1)
+        .width('100%')
+        .divider({ strokeWidth: 0.5, color: $r('app.color.theme_outlineVariant') })
+      } else {
+        Column() {
+          Image($r('app.media.ic_outline_layers_24'))
+            .width(48)
+            .height(48)
+            .fillColor($r('app.color.theme_onSurfaceVariant'))
+          Text($r('app.string.empty_group_list_title'))
+            .fontSize(20)
+            .fontColor($r('app.color.theme_onSurface'))
+            .margin({ top: 16 })
+          Text($r('app.string.empty_group_list'))
+            .fontSize(15)
+            .fontColor($r('app.color.theme_onSurfaceVariant'))
+            .textAlign(TextAlign.Center)
+            .margin({ top: 8 })
+        }
+        .layoutWeight(1)
+        .width('100%')
+        .padding(32)
+        .justifyContent(FlexAlign.Center)
+      }
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor($r('app.color.theme_background'))
+  }
+}
diff --git a/entry/src/main/ets/ui/ImportEntriesActivity.ets b/entry/src/main/ets/ui/ImportEntriesActivity.ets
new file mode 100644
index 0000000..0575dbb
--- /dev/null
+++ b/entry/src/main/ets/ui/ImportEntriesActivity.ets
@@ -0,0 +1,398 @@
+import { AegisActivity, PAGE_IMPORT_ENTRIES, PAGE_ASSIGN_ICONS } from './AegisActivity';
+import { Intent, RESULT_OK } from './Intent';
+import { Dialogs } from './dialogs/Dialogs';
+import { Toolbar, ToolbarMenuItem } from './components/Toolbar';
+import { ImportEntry } from './models/ImportEntry';
+import { ImportEntriesAdapter } from './views/ImportEntriesAdapter';
+import { ImportEntryHolder } from './views/ImportEntryHolder';
+import { IconOptimizationTask } from './tasks/IconOptimizationTask';
+import { RootShellTask } from './tasks/RootShellTask';
+import {
+  DatabaseImporter, DatabaseImporterDefinition, DatabaseImporterResult, DatabaseImporterState, DecryptListener
+} from '../importers/DatabaseImporter';
+import { DatabaseImporterEntryException } from '../importers/DatabaseImporterEntryException';
+import { VaultEntry } from '../vault/VaultEntry';
+import { VaultEntryIcon } from '../vault/VaultEntryIcon';
+import { VaultGroup } from '../vault/VaultGroup';
+import { UUIDMap } from '../util/UUIDMap';
+import { IconType } from '../icons/IconType';
+import { BitmapHelper } from '../helpers/BitmapHelper';
+import { FabScrollHelper } from '../helpers/FabScrollHelper';
+import { ThemeHelper } from '../helpers/ThemeHelper';
+import { Bytes } from '../util/Bytes';
+import { IOUtils } from '../util/IOUtils';
+import { AegisModule } from '../AegisModule';
+
+class ImportDecryptListener implements DecryptListener {
+  private _page: ImportEntriesActivity;
+
+  constructor(page: ImportEntriesActivity) {
+    this._page = page;
+  }
+
+  onStateDecrypted(state: DatabaseImporterState): void {
+    this._page.processDecryptedImporterState(state);
+  }
+
+  onError(e: Error): void {
+    this._page.showErrorAndFinish($r('app.string.decryption_error'), e);
+  }
+
+  onCanceled(): void {
+    this._page.finish();
+  }
+}
+
+/**
+ * Port of ImportEntriesActivity: reads a file with the selected importer, decrypts it if needed and
+ * lets the user select the entries to import.
+ */
+@Entry
+@Component
+struct ImportEntriesActivity {
+  private _activity: AegisActivity = new AegisActivity(this.getUIContext(), PAGE_IMPORT_ENTRIES);
+  private _adapter: ImportEntriesAdapter = new ImportEntriesAdapter();
+  private _importedGroups: UUIDMap<VaultGroup> = new UUIDMap<VaultGroup>();
+  private _fabScrollHelper: FabScrollHelper = new FabScrollHelper((visible: boolean) => {
+    this.fabVisible = visible;
+  });
+  private _duplicateEntries: string[] = [];
+  private _listScroller: Scroller = new Scroller();
+  @State revision: number = 0;
+  @State wipeVault: boolean = false;
+  @State fabVisible: boolean = true;
+  @State duplicateMessage: string = '';
+
+  aboutToAppear(): void {
+    this._activity.onCreate();
+    if (this._activity.abortIfOrphan()) {
+      return;
+    }
+    this._adapter.setOnChangeListener(() => {
+      this.revision++;
+    });
+
+    const intent = this._activity.getIntent();
+    const importerDef = intent.getExtra('importerDef') as DatabaseImporterDefinition;
+    const file = intent.getStringExtra('file');
+    this.startImport(importerDef, file);
+  }
+
+  onPageShow(): void {
+    this._activity.onResume();
+  }
+
+  aboutToDisappear(): void {
+    this._activity.onDestroy();
+  }
+
+  finish(): void {
+    this._activity.finish();
+  }
+
+  showErrorAndFinish(message: ResourceStr, e: Error): void {
+    Dialogs.showErrorDialog(this.getUIContext(), message, e, () => this.finish());
+  }
+
+  private startImport(importerDef: DatabaseImporterDefinition, file: string | null): void {
+    const importer = DatabaseImporter.create(AegisModule.getContext(), importerDef);
+    if (file === null) {
+      if (importer.isInstalledAppVersionSupported()) {
+        this.startImportApp(importer);
+      } else {
+        Dialogs.showSimpleDialog(this.getUIContext(), $r('app.string.warning'),
+          this._activity.getString('app_version_error', [importerDef.getName()]),
+          $r('app.string.yes'), () => this.startImportApp(importer), $r('app.string.no'), () => this.finish(),
+          undefined, undefined, true);
+      }
+    } else {
+      this.startImportFile(importer, file);
+    }
+  }
+
+  private startImportFile(importer: DatabaseImporter, file: string): void {
+    let data: Uint8Array;
+    try {
+      data = IOUtils.readFile(file);
+    } catch (e) {
+      this._activity.showToast($r('app.string.file_not_found'));
+      this.finish();
+      return;
+    }
+    importer.read(data).then((state: DatabaseImporterState) => {
+      this.processImporterState(state);
+    }).catch((e: Error) => {
+      this.showErrorAndFinish($r('app.string.reading_file_error'), e);
+    });
+  }
+
+  private startImportApp(importer: DatabaseImporter): void {
+    const task = new RootShellTask(this.getUIContext(), (isRoot: boolean) => {
+      if (!isRoot) {
+        this._activity.showToast($r('app.string.root_error'));
+        this.finish();
+        return;
+      }
+      importer.readFromApp().then((state: DatabaseImporterState) => {
+        this.processImporterState(state);
+      }).catch((e: Error) => {
+        this.showErrorAndFinish($r('app.string.reading_file_error'), e);
+      });
+    });
+    task.execute();
+  }
+
+  private processImporterState(state: DatabaseImporterState): void {
+    try {
+      if (state.isEncrypted()) {
+        state.decrypt(this.getUIContext(), new ImportDecryptListener(this));
+      } else {
+        this.processDecryptedImporterState(state);
+      }
+    } catch (e) {
+      this.showErrorAndFinish($r('app.string.parsing_file_error'), e as Error);
+    }
+  }
+
+  processDecryptedImporterState(state: DatabaseImporterState): void {
+    state.convert().then((result: DatabaseImporterResult) => {
+      const icons = new Map<string, VaultEntryIcon>();
+      for (const e of result.getEntries().getValues()) {
+        const icon = e.getIcon();
+        if (icon !== null && icon.getType() !== IconType.SVG && !BitmapHelper.isVaultEntryIconOptimized(icon)) {
+          icons.set(e.getUUID(), icon);
+        }
+      }
+
+      if (icons.size > 0) {
+        const task = new IconOptimizationTask(this.getUIContext(), (newIcons: Map<string, VaultEntryIcon>) => {
+          newIcons.forEach((icon: VaultEntryIcon, uuid: string) => {
+            result.getEntries().getByUUID(uuid).setIcon(icon);
+          });
+          this.processImporterResult(result);
+        });
+        task.execute(icons);
+      } else {
+        this.processImporterResult(result);
+      }
+    }).catch((e: Error) => {
+      this.showErrorAndFinish($r('app.string.parsing_file_error'), e);
+    });
+  }
+
+  private processImporterResult(result: DatabaseImporterResult): void {
+    const importEntries: ImportEntry[] = [];
+    for (const entry of result.getEntries().getValues()) {
+      const importEntry = new ImportEntry(entry);
+      this._adapter.addEntry(importEntry);
+      importEntries.push(importEntry);
+    }
+
+    this._importedGroups = result.getGroups();
+
+    const errors: DatabaseImporterEntryException[] = result.getErrors();
+    if (errors.length > 0) {
+      const message = this._activity.getQuantityString('import_error_dialog', errors.length);
+      Dialogs.showMultiExceptionDialog(this.getUIContext(), $r('app.string.import_error_title'), message, errors, null);
+    }
+
+    this.findDuplicates(importEntries);
+  }
+
+  private showWipeEntriesDialog(): void {
+    Dialogs.showCheckboxDialog(this.getUIContext(), $r('app.string.dialog_wipe_entries_title'),
+      $r('app.string.dialog_wipe_entries_message'), $r('app.string.dialog_wipe_entries_checkbox'),
+      (checked: boolean) => this.saveAndFinish(checked));
+  }
+
+  private onFabClick(): void {
+    if (this._activity.getVaultManager().getVault().getEntries().length > 0 && this.wipeVault) {
+      this.showWipeEntriesDialog();
+    } else {
+      this.saveAndFinish(false);
+    }
+  }
+
+  private saveAndFinish(wipeEntries: boolean): void {
+    const vault = this._activity.getVaultManager().getVault();
+    if (wipeEntries) {
+      vault.wipeContents();
+    }
+
+    // Given the list of selected entries, collect the UUID's of all groups
+    // that we're actually going to import
+    const selectedEntries = this._adapter.getCheckedEntries();
+    const selectedGroupUuids = new Set<string>();
+    for (const entry of selectedEntries) {
+      for (const g of Array.from(entry.getEntry().getGroups())) {
+        selectedGroupUuids.add(g);
+      }
+    }
+
+    // Add all of the new groups to the vault. If a group with the same name already
+    // exists in the vault, rewrite all entries in that group to reference the existing group.
+    for (const importedGroup of this._importedGroups.getValues()) {
+      if (!selectedGroupUuids.has(importedGroup.getUUID())) {
+        continue;
+      }
+
+      let existingGroup = vault.findGroupByUUID(importedGroup.getUUID());
+      if (existingGroup !== null) {
+        continue;
+      }
+
+      existingGroup = vault.findGroupByName(importedGroup.getName());
+      if (existingGroup === null) {
+        vault.addGroup(importedGroup);
+      } else {
+        for (const entry of selectedEntries) {
+          const entryGroups = entry.getEntry().getGroups();
+          if (entryGroups.has(importedGroup.getUUID())) {
+            entryGroups.delete(importedGroup.getUUID());
+            entryGroups.add(existingGroup.getUUID());
+          }
+        }
+      }
+    }
+
+    for (const selectedEntry of selectedEntries) {
+      const entry = selectedEntry.getEntry();
+
+      // temporary: randomize the UUID of duplicate entries and add them anyway
+      if (vault.isEntryDuplicate(entry)) {
+        entry.resetUUID();
+      }
+
+      vault.addEntry(entry);
+    }
+
+    if (this._activity.saveAndBackupVault()) {
+      const toastMessage = this._activity.getQuantityString('imported_entries_count', selectedEntries.length);
+      this._activity.showToast(toastMessage);
+
+      this._activity.setResult(RESULT_OK, null);
+
+      if (this._activity.getIconPackManager().hasIconPack()) {
+        const assignIconEntriesIds: string[] = selectedEntries.map((e: ImportEntry) => e.getEntry().getUUID());
+        const assignIconIntent = new Intent(PAGE_ASSIGN_ICONS);
+        assignIconIntent.putExtra('entries', assignIconEntriesIds);
+
+        Dialogs.showSimpleDialog(this.getUIContext(), $r('app.string.import_assign_icons_dialog_title'),
+          $r('app.string.import_assign_icons_dialog_text'), $r('app.string.yes'), () => {
+            this.finish();
+            setTimeout(() => this._activity.startActivity(assignIconIntent), 300);
+          }, $r('app.string.no'), () => this.finish());
+      } else {
+        this.finish();
+      }
+    }
+  }
+
+  private findDuplicates(importEntries: ImportEntry[]): void {
+    const duplicateEntries: string[] = [];
+    const vaultEntries = this._activity.getVaultManager().getVault().getEntries();
+    for (const importEntry of importEntries) {
+      const exists = vaultEntries.some((item: VaultEntry) =>
+      item.getIssuer() === importEntry.getEntry().getIssuer() &&
+      Bytes.equals(item.getInfo().getSecret(), importEntry.getEntry().getInfo().getSecret()));
+      if (exists) {
+        duplicateEntries.push(importEntry.getEntry().getUUID());
+      }
+    }
+
+    if (duplicateEntries.length === 0) {
+      return;
+    }
+
+    this._duplicateEntries = duplicateEntries;
+    this._adapter.setCheckboxStates(false, duplicateEntries);
+    this.duplicateMessage = this._activity.getQuantityString('import_duplicate_toast', duplicateEntries.length);
+  }
+
+  private undoDuplicates(): void {
+    this._adapter.setCheckboxStates(true, this._duplicateEntries);
+    this.duplicateMessage = '';
+  }
+
+  private getMenuItems(): ToolbarMenuItem[] {
+    return [
+      new ToolbarMenuItem('toggle_checkboxes', $r('app.string.toggle_checkboxes'), $r('app.media.ic_outline_done_all_24'), true),
+      new ToolbarMenuItem('toggle_wipe_vault', $r('app.string.dialog_wipe_entries_checkbox'), null, false)
+        .setCheckable('wipe', this.wipeVault)
+    ];
+  }
+
+  private onOptionsItemSelected(id: string): void {
+    if (id === 'toggle_checkboxes') {
+      this._adapter.toggleCheckboxes();
+    } else if (id === 'toggle_wipe_vault') {
+      this.wipeVault = !this.wipeVault;
+    }
+  }
+
+  build() {
+    Stack({ alignContent: Alignment.BottomEnd }) {
+      Column() {
+        Toolbar({
+          title: $r('app.string.title_activity_import_entries'),
+          navigationIcon: $r('app.media.ic_outline_close_24'),
+          menuItems: this.getMenuItems(),
+          onBack: () => this.finish(),
+          onMenuItemClick: (id: string) => this.onOptionsItemSelected(id)
+        })
+        List({ space: 8, scroller: this._listScroller }) {
+          ForEach(this.revision >= 0 ? this._adapter.getEntries() : [], (entry: ImportEntry) => {
+            ListItem() {
+              ImportEntryHolder({ entry: entry, revision: this.revision })
+            }
+            .padding({ left: 16, right: 16 })
+          }, (entry: ImportEntry) => entry.getEntry().getUUID())
+        }
+        .layoutWeight(1)
+        .padding({ top: 8, bottom: 96 })
+        .onDidScroll((offset: number) => {
+          // never hide the FAB at the top of the list (the spring edge effect bounces back with a positive offset)
+          this._fabScrollHelper.onScroll(0, this._listScroller.currentOffset().yOffset <= 0 ? -1 : offset);
+        })
+
+        if (this.duplicateMessage.length > 0) {
+          Row() {
+            Text(this.duplicateMessage)
+              .fontSize(14)
+              .fontColor($r('app.color.theme_inverseOnSurface'))
+              .layoutWeight(1)
+            Text($r('app.string.undo'))
+              .fontSize(14)
+              .fontColor($r('app.color.theme_inversePrimary'))
+              .padding(8)
+              .onClick(() => this.undoDuplicates())
+          }
+          .width('100%')
+          .padding({ left: 16, right: 16, top: 8, bottom: 8 })
+          .backgroundColor($r('app.color.theme_inverseSurface'))
+        }
+      }
+      .width('100%')
+      .height('100%')
+      .backgroundColor(ThemeHelper.getBackgroundColor())
+
+      if (this.fabVisible) {
+        Stack() {
+          Image($r('app.media.ic_outline_check_24'))
+            .width(24)
+            .height(24)
+            .fillColor($r('app.color.theme_onPrimaryContainer'))
+        }
+        .width(56)
+        .height(56)
+        .borderRadius(16)
+        .backgroundColor($r('app.color.theme_primaryContainer'))
+        .margin({ right: 16, bottom: this.duplicateMessage.length > 0 ? 72 : 24 })
+        .id('fab')
+        .onClick(() => this.onFabClick())
+      }
+    }
+    .width('100%')
+    .height('100%')
+  }
+}
