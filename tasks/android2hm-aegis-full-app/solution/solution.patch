+import { formBindingData, FormExtensionAbility, formInfo } from '@kit.FormKit';
+import { Want } from '@kit.AbilityKit';
+import { QsTileRefreshReceiver } from '../receivers/QsTileRefreshReceiver';
+
+class FormData {
+  refreshed: number = Date.now();
+}
+
+/**
+ * Service widget that replaces the quick settings tiles (LaunchAppTileService and
+ * LaunchScannerTileService): it offers buttons to open the vault and to scan a QR code.
+ */
+export default class AegisFormAbility extends FormExtensionAbility {
+  onAddForm(want: Want): formBindingData.FormBindingData {
+    if (want.parameters !== undefined) {
+      const id = want.parameters[formInfo.FormParam.IDENTITY_KEY];
+      if (typeof id === 'string') {
+        QsTileRefreshReceiver.addForm(this.context, id as string);
+      }
+    }
+    return formBindingData.createFormBindingData(new FormData());
+  }
+
+  onCastToNormalForm(formId: string): void {
+  }
+
+  onUpdateForm(formId: string): void {
+  }
+
+  onFormEvent(formId: string, message: string): void {
+  }
+
+  onRemoveForm(formId: string): void {
+    QsTileRefreshReceiver.removeForm(this.context, formId);
+  }
+
+  onAcquireFormState(want: Want): formInfo.FormState {
+    return formInfo.FormState.READY;
+  }
+}
