@@ -0,0 +1,41 @@
+import { relationalStore } from '@kit.ArkData';
+import { common } from '@kit.AbilityKit';
+import { AuditLogDao } from './AuditLogDao';
+
+/**
+ * Port of the Room database, on top of @ohos.data.relationalStore.
+ */
+export class AppDatabase {
+  static readonly NAME: string = 'aegis.db';
+  static readonly VERSION: number = 1;
+
+  private _store: relationalStore.RdbStore | null = null;
+  private _context: common.Context;
+  private _dao: AuditLogDao;
+
+  constructor(context: common.Context) {
+    this._context = context;
+    this._dao = new AuditLogDao(this);
+  }
+
+  async getStore(): Promise<relationalStore.RdbStore> {
+    if (this._store !== null) {
+      return this._store;
+    }
+    const config: relationalStore.StoreConfig = {
+      name: AppDatabase.NAME,
+      securityLevel: relationalStore.SecurityLevel.S3
+    };
+    const store = await relationalStore.getRdbStore(this._context, config);
+    if (store.version === 0) {
+      await store.executeSql(AuditLogDao.CREATE_TABLE);
+      store.version = AppDatabase.VERSION;
+    }
+    this._store = store;
+    return store;
+  }
+
+  auditLogDao(): AuditLogDao {
+    return this._dao;
+  }
+}
diff --git a/entry/src/main/ets/database/AuditLogDao.ets b/entry/src/main/ets/database/AuditLogDao.ets
new file mode 100644
index 0000000..59bdccb
--- /dev/null
+++ b/entry/src/main/ets/database/AuditLogDao.ets
@@ -0,0 +1,52 @@
+import { relationalStore } from '@kit.ArkData';
+import { AuditLogEntry } from './AuditLogEntry';
+import { EventType } from '../EventType';
+import { AppDatabase } from './AppDatabase';
+
+export class AuditLogDao {
+  static readonly TABLE: string = 'audit_logs';
+  static readonly CREATE_TABLE: string = 'CREATE TABLE IF NOT EXISTS audit_logs (' +
+    'id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, ' +
+    'event_type INTEGER NOT NULL, ' +
+    'reference TEXT, ' +
+    'timestamp INTEGER NOT NULL)';
+
+  private _db: AppDatabase;
+
+  constructor(db: AppDatabase) {
+    this._db = db;
+  }
+
+  async insert(log: AuditLogEntry): Promise<void> {
+    const store = await this._db.getStore();
+    const values: relationalStore.ValuesBucket = {
+      'event_type': log.getEventType() as number,
+      'reference': log.getReference(),
+      'timestamp': log.getTimestamp()
+    };
+    await store.insert(AuditLogDao.TABLE, values);
+  }
+
+  /**
+   * Returns all entries of the last 30 days, newest first.
+   */
+  async getAll(): Promise<AuditLogEntry[]> {
+    const store = await this._db.getStore();
+    const since = Date.now() - 30 * 24 * 60 * 60 * 1000;
+    const rs = await store.querySql('SELECT * FROM audit_logs WHERE timestamp >= ? ORDER BY timestamp DESC', [since]);
+    const res: AuditLogEntry[] = [];
+    try {
+      while (rs.goToNextRow()) {
+        const id = rs.getLong(rs.getColumnIndex('id'));
+        const type = rs.getLong(rs.getColumnIndex('event_type'));
+        const refIdx = rs.getColumnIndex('reference');
+        const ref = rs.isColumnNull(refIdx) ? null : rs.getString(refIdx);
+        const ts = rs.getLong(rs.getColumnIndex('timestamp'));
+        res.push(new AuditLogEntry(type as EventType, ref, id, ts));
+      }
+    } finally {
+      rs.close();
+    }
+    return res;
+  }
+}
