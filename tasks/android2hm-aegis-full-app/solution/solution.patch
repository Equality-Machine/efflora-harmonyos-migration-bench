+import { VaultEntry } from '../../vault/VaultEntry';
+import { VaultGroup } from '../../vault/VaultGroup';
+import { EntryAdapter, EntryAdapterListener } from './EntryAdapter';
+import { EntryHolder } from './EntryHolder';
+import { ErrorCardHolder } from './ErrorCardHolder';
+import { TotpProgressBar } from './TotpProgressBar';
+import { ErrorCardInfo } from '../models/ErrorCardInfo';
+import { UiRefresher, UiRefresherListener } from '../../helpers/UiRefresher';
+import { VibrationHelper } from '../../helpers/VibrationHelper';
+import { SimpleItemTouchHelperCallback } from '../../helpers/SimpleItemTouchHelperCallback';
+import { VibrationPatterns } from '../../VibrationPatterns';
+import { TotpInfo } from '../../otp/TotpInfo';
+import { CodeGrouping } from '../../Preferences';
+import { AccountNamePosition } from '../../AccountNamePosition';
+import { CopyBehavior } from '../../CopyBehavior';
+import { SortCategory } from '../../SortCategory';
+import { ViewMode, ViewModeUtils } from '../../ViewMode';
+import { AegisModule } from '../../AegisModule';
+import { ResUtils } from '../../util/ResUtils';
+
+export interface EntryListViewListener {
+  onEntryClick(entry: VaultEntry): void;
+
+  onEntryMove(entry1: VaultEntry, entry2: VaultEntry): void;
+
+  onEntryDrop(entry: VaultEntry): void;
+
+  onEntryChange(entry: VaultEntry): void;
+
+  onEntryCopy(entry: VaultEntry): void;
+
+  onLongEntryClick(entry: VaultEntry): void;
+
+  onScroll(dx: number, dy: number): void;
+
+  onSelect(entry: VaultEntry): void;
+
+  onDeselect(entry: VaultEntry): void;
+
+  onListChange(): void;
+
+  onSaveGroupFilter(groupFilter: Set<string | null>): void;
+
+  onEntryListTouch(): void;
+}
+
+class ListRefresherListener implements UiRefresherListener {
+  private _view: EntryListView;
+
+  constructor(view: EntryListView) {
+    this._view = view;
+  }
+
+  onRefresh(): void {
+    this._view.refresh(false);
+    this._view.getVibrationHelper().vibratePattern(VibrationPatterns.REFRESH_CODE);
+  }
+
+  onExpiring(): void {
+    this._view.getVibrationHelper().vibratePattern(VibrationPatterns.EXPIRING);
+  }
+
+  getMillisTillNextRefresh(): number {
+    return TotpInfo.getMillisTillNextRotation(this._view.getAdapter().getMostFrequentPeriod());
+  }
+
+  getPeriodMillis(): number {
+    return this._view.getAdapter().getMostFrequentPeriod() * 1000;
+  }
+}
+
+/**
+ * Port of the EntryListView fragment. This class holds the adapter and the refresh logic; the
+ * EntryListViewComponent renders it.
+ */
+export class EntryListView implements EntryAdapterListener {
+  private _adapter: EntryAdapter;
+  private _listener: EntryListViewListener | null = null;
+  private _vibrationHelper: VibrationHelper;
+  private _refresher: UiRefresher;
+  private _viewMode: ViewMode = ViewMode.NORMAL;
+  private _showProgress: boolean = false;
+  private _uniformPeriod: number = -1;
+  private _tick: number = 0;
+  private _render: (() => void) | null = null;
+  private _scrollToIndex: ((index: number) => void) | null = null;
+  private _touchCallback: SimpleItemTouchHelperCallback = new SimpleItemTouchHelperCallback();
+  private _entriesAnimation: boolean = false;
+
+  constructor() {
+    this._adapter = new EntryAdapter(this);
+    this._vibrationHelper = new VibrationHelper(AegisModule.getPreferences());
+    this._refresher = new UiRefresher(new ListRefresherListener(this));
+    this._adapter.setOnChangeListener(() => this.invalidate());
+  }
+
+  /**
+   * Binds the rendering component.
+   */
+  bind(render: () => void, scrollToIndex: (index: number) => void): void {
+    this._render = render;
+    this._scrollToIndex = scrollToIndex;
+  }
+
+  unbind(): void {
+    this._render = null;
+    this._scrollToIndex = null;
+  }
+
+  invalidate(): void {
+    if (this._render !== null) {
+      this._render();
+    }
+  }
+
+  getAdapter(): EntryAdapter {
+    return this._adapter;
+  }
+
+  getVibrationHelper(): VibrationHelper {
+    return this._vibrationHelper;
+  }
+
+  getTick(): number {
+    return this._tick;
+  }
+
+  getViewMode(): ViewMode {
+    return this._viewMode;
+  }
+
+  isShowProgress(): boolean {
+    return this._showProgress;
+  }
+
+  getUniformPeriod(): number {
+    return this._uniformPeriod;
+  }
+
+  onDestroy(): void {
+    this._refresher.destroy();
+    this._adapter.destroy();
+  }
+
+  onRefreshStop(): void {
+    this._refresher.stop();
+  }
+
+  onRefreshStart(): void {
+    if (this._adapter.getMostFrequentPeriod() !== -1) {
+      this._refresher.start();
+    }
+  }
+
+  setGroups(groups: VaultGroup[]): void {
+    this._adapter.setGroups(groups);
+  }
+
+  setGroupFilter(groups: Set<string | null>): void {
+    this._adapter.setGroupFilter(groups);
+    this._touchCallback.setIsLongPressDragEnabled(this._adapter.isDragAndDropAllowed());
+  }
+
+  setIsLongPressDragEnabled(enabled: boolean): void {
+    this._touchCallback.setIsLongPressDragEnabled(enabled && this._adapter.isDragAndDropAllowed());
+    this.invalidate();
+  }
+
+  isLongPressDragEnabled(): boolean {
+    return this._touchCallback.isLongPressDragEnabled();
+  }
+
+  setCopyBehavior(copyBehavior: CopyBehavior): void {
+    this._adapter.setCopyBehavior(copyBehavior);
+  }
+
+  setSearchBehaviorMask(searchBehaviorMask: number): void {
+    this._adapter.setSearchBehaviorMask(searchBehaviorMask);
+  }
+
+  selectAllEntries(): VaultEntry[] {
+    return this._adapter.selectAllEntries();
+  }
+
+  setActionModeState(enabled: boolean, entry: VaultEntry | null): void {
+    this._touchCallback.setSelectedEntry(entry);
+    this._touchCallback.setIsLongPressDragEnabled(enabled && this._adapter.isDragAndDropAllowed());
+    if (enabled && entry !== null) {
+      this._adapter.addSelectedEntry(entry);
+    } else {
+      this._adapter.deselectAllEntries();
+    }
+  }
+
+  setSortCategory(sortCategory: SortCategory, apply: boolean): void {
+    this._adapter.setSortCategory(sortCategory, apply);
+    this._touchCallback.setIsLongPressDragEnabled(this._adapter.isDragAndDropAllowed());
+  }
+
+  setUsageCounts(usageCounts: Map<string, number>): void {
+    this._adapter.setUsageCounts(usageCounts);
+  }
+
+  getUsageCounts(): Map<string, number> {
+    return this._adapter.getUsageCounts();
+  }
+
+  setLastUsedTimestamps(lastUsedTimestamps: Map<string, number>): void {
+    this._adapter.setLastUsedTimestamps(lastUsedTimestamps);
+  }
+
+  getLastUsedTimestamps(): Map<string, number> {
+    return this._adapter.getLastUsedTimestamps();
+  }
+
+  setSearchFilter(search: string | null): void {
+    this._adapter.setSearchFilter(search);
+    this._touchCallback.setIsLongPressDragEnabled(this._adapter.isDragAndDropAllowed());
+  }
+
+  setSelectedEntry(entry: VaultEntry | null): void {
+    this._touchCallback.setSelectedEntry(entry);
+  }
+
+  setViewMode(mode: ViewMode): void {
+    this._viewMode = mode;
+    // up/down (and left/right for tiles)
+    this._touchCallback.setDragFlags(mode === ViewMode.TILES ? 15 : 3);
+    this._adapter.setViewMode(mode);
+    this.invalidate();
+  }
+
+  refresh(hard: boolean): void {
+    this._tick++;
+    this._adapter.refresh(hard);
+  }
+
+  setListener(listener: EntryListViewListener | null): void {
+    this._listener = listener;
+  }
+
+  onEntryClick(entry: VaultEntry): void {
+    if (this._listener !== null) {
+      this._listener.onEntryClick(entry);
+    }
+  }
+
+  onLongEntryClick(entry: VaultEntry): void {
+    if (this._listener !== null) {
+      this._listener.onLongEntryClick(entry);
+    }
+  }
+
+  onEntryMove(entry1: VaultEntry, entry2: VaultEntry): void {
+    if (this._listener !== null) {
+      this._listener.onEntryMove(entry1, entry2);
+    }
+  }
+
+  onEntryDrop(entry: VaultEntry): void {
+    if (this._listener !== null) {
+      this._listener.onEntryDrop(entry);
+    }
+  }
+
+  onEntryChange(entry: VaultEntry): void {
+    if (this._listener !== null) {
+      this._listener.onEntryChange(entry);
+    }
+  }
+
+  onEntryCopy(entry: VaultEntry): void {
+    if (this._listener !== null) {
+      this._listener.onEntryCopy(entry);
+    }
+  }
+
+  onSelect(entry: VaultEntry): void {
+    if (this._listener !== null) {
+      this._listener.onSelect(entry);
+    }
+  }
+
+  onDeselect(entry: VaultEntry): void {
+    if (this._listener !== null) {
+      this._listener.onDeselect(entry);
+    }
+  }
+
+  onPeriodUniformityChanged(isUniform: boolean, period: number): void {
+    this.setShowProgress(isUniform);
+    this._uniformPeriod = period;
+    if (this._showProgress) {
+      this._refresher.stop();
+      this._refresher.start();
+    } else {
+      this._refresher.stop();
+    }
+    this.invalidate();
+  }
+
+  onListChange(): void {
+    if (this._listener !== null) {
+      this._listener.onListChange();
+    }
+  }
+
+  onScroll(dx: number, dy: number): void {
+    if (this._listener !== null) {
+      this._listener.onScroll(dx, dy);
+    }
+  }
+
+  onEntryListTouch(): void {
+    if (this._listener !== null) {
+      this._listener.onEntryListTouch();
+    }
+  }
+
+  setCodeGroupSize(codeGrouping: CodeGrouping): void {
+    this._adapter.setCodeGroupSize(codeGrouping);
+  }
+
+  setAccountNamePosition(accountNamePosition: AccountNamePosition): void {
+    this._adapter.setAccountNamePosition(accountNamePosition);
+  }
+
+  setOnlyShowNecessaryAccountNames(onlyShowNecessaryAccountNames: boolean): void {
+    this._adapter.setOnlyShowNecessaryAccountNames(onlyShowNecessaryAccountNames);
+  }
+
+  setShowIcon(showIcon: boolean): void {
+    this._adapter.setShowIcon(showIcon);
+  }
+
+  setShowNextCode(showNextCode: boolean): void {
+    this._adapter.setShowNextCode(showNextCode);
+  }
+
+  setShowExpirationState(showExpirationState: boolean): void {
+    this._adapter.setShowExpirationState(showExpirationState);
+  }
+
+  setHighlightEntry(highlightEntry: boolean): void {
+    this._adapter.setHighlightEntry(highlightEntry);
+  }
+
+  setPauseFocused(pauseFocused: boolean): void {
+    this._adapter.setPauseFocused(pauseFocused);
+  }
+
+  setTapToReveal(tapToReveal: boolean): void {
+    this._adapter.setTapToReveal(tapToReveal);
+  }
+
+  setTapToRevealTime(n: number): void {
+    this._adapter.setTapToRevealTime(n);
+  }
+
+  setErrorCardInfo(info: ErrorCardInfo | null): void {
+    this._adapter.setErrorCardInfo(info);
+  }
+
+  onEntryAdded(entry: VaultEntry): void {
+    const position = this._adapter.getEntryPosition(entry);
+    if (position < 0) {
+      return;
+    }
+    if (this._scrollToIndex !== null) {
+      this._scrollToIndex(position);
+    }
+    this.tempHighlightEntry(entry);
+  }
+
+  tempHighlightEntry(entry: VaultEntry): void {
+    this._adapter.setTempHighlightEntry(true);
+    const secondsToFocus = 3;
+    this._adapter.focusEntry(entry, secondsToFocus);
+  }
+
+  setEntries(entries: VaultEntry[]): void {
+    this._adapter.setEntries(entries);
+  }
+
+  clearEntries(): void {
+    this._adapter.clearEntries();
+  }
+
+  runEntriesAnimation(): void {
+    this._entriesAnimation = true;
+    this.invalidate();
+  }
+
+  consumeEntriesAnimation(): boolean {
+    const v = this._entriesAnimation;
+    this._entriesAnimation = false;
+    return v;
+  }
+
+  private setShowProgress(showProgress: boolean): void {
+    this._showProgress = showProgress;
+  }
+
+  isEmptyStateShown(): boolean {
+    const filter = this._adapter.getSearchFilter();
+    return this._adapter.getShownEntriesCount() === 0 && (filter === null || filter.length === 0);
+  }
+
+  getFooterText(): string {
+    const n = this._adapter.getShownEntriesCount();
+    return ResUtils.getQuantityString(AegisModule.getContext(), 'entries_shown', n);
+  }
+
+  /**
+   * Returns whether the favorite at the given index is connected to the previous/next favorite
+   * (port of the VerticalSpaceItemDecoration favorite decoration).
+   */
+  isFavoriteTop(index: number): boolean {
+    return index === 0 || this._viewMode === ViewMode.TILES;
+  }
+
+  isFavoriteBottom(index: number): boolean {
+    const totalFavorites = this._adapter.getShownFavoritesCount();
+    return index >= totalFavorites - 1 || this._viewMode === ViewMode.TILES;
+  }
+
+  getItemMarginBottom(index: number): number {
+    const offset = ViewModeUtils.getItemOffset(this._viewMode);
+    const shown = this._adapter.getShownEntries();
+    const totalFavorites = this._adapter.getShownFavoritesCount();
+    if (index < shown.length && shown[index].isFavorite() && index < totalFavorites - 1) {
+      return 0;
+    }
+    return offset;
+  }
+}
+
+/**
+ * Renders the EntryListView (replacement for fragment_entry_list_view.xml with its RecyclerView).
+ */
+@Component
+export struct EntryListViewComponent {
+  view: EntryListView | null = null;
+  @State revision: number = 0;
+  @State listVersion: number = 0;
+  @State tick: number = 0;
+  @State entriesOpacity: number = 1;
+  private _scroller: Scroller = new Scroller();
+
+  aboutToAppear(): void {
+    const view = this.getView();
+    view.bind(() => {
+      this.revision = view.getAdapter().getVersion();
+      this.listVersion = view.getAdapter().getListVersion();
+      this.tick = view.getTick();
+      if (view.consumeEntriesAnimation()) {
+        this.entriesOpacity = 0;
+        this.getUIContext().animateTo({ duration: 300, curve: Curve.EaseOut }, () => {
+          this.entriesOpacity = 1;
+        });
+      }
+    }, (index: number) => {
+      this._scroller.scrollToIndex(index, true);
+    });
+  }
+
+  aboutToDisappear(): void {
+    this.getView().unbind();
+  }
+
+  private getView(): EntryListView {
+    return this.view as EntryListView;
+  }
+
+  private getEntries(): VaultEntry[] {
+    return this.getView().getAdapter().getShownEntries();
+  }
+
+  private getErrorCard(): ErrorCardInfo | null {
+    return this.getView().getAdapter().getErrorCardInfo();
+  }
+
+  private getErrorMessage(): string {
+    const info = this.getErrorCard();
+    return info !== null ? info.getMessage() : '';
+  }
+
+  private getLanes(): number {
+    return ViewModeUtils.getSpanCount(this.getView().getViewMode());
+  }
+
+  private getOffset(): number {
+    return ViewModeUtils.getItemOffset(this.getView().getViewMode());
+  }
+
+  private entryKey(entry: VaultEntry): string {
+    return `${entry.getUUID()}-${this.listVersion}-${this.getView().getViewMode()}`;
+  }
+
+  @Builder
+  DragPreview(entry: VaultEntry) {
+    Row() {
+      Text(entry.getIssuer().length > 0 ? entry.getIssuer() : entry.getName())
+        .fontSize(16)
+        .fontWeight(FontWeight.Bold)
+        .fontColor($r('app.color.theme_onSurface'))
+    }
+    .padding(16)
+    .borderRadius(16)
+    .backgroundColor($r('app.color.theme_secondaryContainer'))
+  }
+
+  @Builder
+  EmptyState() {
+    Column() {
+      Image($r('app.media.ic_qrcode_scan'))
+        .width(96)
+        .height(96)
+        .fillColor($r('app.color.theme_onSurfaceVariant'))
+        .opacity(0.6)
+      Text($r('app.string.empty_list_title'))
+        .fontSize(20)
+        .fontWeight(FontWeight.Medium)
+        .fontColor($r('app.color.theme_onSurface'))
+        .margin({ top: 16 })
+      Text($r('app.string.empty_list'))
+        .fontSize(14)
+        .fontColor($r('app.color.theme_onSurfaceVariant'))
+        .textAlign(TextAlign.Center)
+        .margin({ top: 8, left: 32, right: 32 })
+    }
+    .width('100%')
+    .layoutWeight(1)
+    .justifyContent(FlexAlign.Center)
+  }
+
+  build() {
+    Column() {
+      if (this.revision >= 0 && this.getView().isShowProgress() && this.getView().getUniformPeriod() > 0) {
+        TotpProgressBar({ period: this.getView().getUniformPeriod(), barHeight: 4 })
+      }
+      if (this.revision >= 0 && this.getView().isEmptyStateShown() && this.getErrorCard() === null) {
+        this.EmptyState()
+      } else {
+        List({ scroller: this._scroller }) {
+          if (this.revision >= 0 && this.getErrorCard() !== null) {
+            ListItem() {
+              ErrorCardHolder({ message: this.getErrorMessage(), info: this.getErrorCard() })
+            }
+            .padding({ left: this.getOffset(), right: this.getOffset(), top: this.getOffset(), bottom: this.getOffset() })
+          }
+          ForEach(this.revision >= 0 && this.listVersion >= 0 ? this.getEntries() : [], (entry: VaultEntry, index: number) => {
+            ListItem() {
+              EntryHolder({
+                entry: entry,
+                adapter: this.getView().getAdapter(),
+                revision: this.revision,
+                tick: this.tick,
+                viewMode: this.getView().getViewMode(),
+                codeGrouping: this.getView().getAdapter().getCodeGroupSize(),
+                showIcon: this.getView().getAdapter().isShowIcon(),
+                showDragHandle: this.getView().getAdapter().isEntryDraggable(entry) && this.revision >= 0,
+                favoriteTop: this.getView().isFavoriteTop(index),
+                favoriteBottom: this.getView().isFavoriteBottom(index)
+              })
+            }
+            .padding({
+              left: this.getView().getViewMode() === ViewMode.TILES ? this.getOffset() : 8,
+              right: this.getView().getViewMode() === ViewMode.TILES ? this.getOffset() : 8,
+              top: index === 0 && this.getErrorCard() === null ? this.getOffset() : 0,
+              bottom: this.getView().getItemMarginBottom(index)
+            })
+          }, (entry: VaultEntry) => this.entryKey(entry))
+          ListItem() {
+            Text(this.revision >= 0 ? this.getView().getFooterText() : '')
+              .fontSize(13)
+              .fontColor($r('app.color.theme_onSurfaceVariant'))
+              .width('100%')
+              .textAlign(TextAlign.Center)
+              .padding({ top: this.getOffset() * 2, bottom: 96 })
+          }
+        }
+        .lanes(this.getLanes())
+        .width('100%')
+        .layoutWeight(1)
+        .opacity(this.entriesOpacity)
+        .edgeEffect(EdgeEffect.Spring)
+        .onDidScroll((scrollOffset: number, scrollState: ScrollState) => {
+          // the spring edge effect bounces back with a positive offset at the top of the list: the list is
+          // not scrolled down there, so never hide the FAB at the top
+          const atTop: boolean = this._scroller.currentOffset().yOffset <= 0;
+          this.getView().onScroll(0, atTop ? -1 : scrollOffset);
+        })
+        .onTouch((event: TouchEvent) => {
+          if (event.type === TouchType.Down) {
+            this.getView().onEntryListTouch();
+          }
+        })
+        .onItemDragStart((event: ItemDragInfo, itemIndex: number) => {
+          const adapter = this.getView().getAdapter();
+          if (adapter.isPositionFooter(itemIndex) || adapter.isPositionErrorCard(itemIndex)) {
+            return;
+          }
+          const entry = adapter.getEntryAtPosition(itemIndex);
+          if (!this.getView().isLongPressDragEnabled() || !adapter.isEntryDraggable(entry)) {
+            return;
+          }
+          return this.DragPreview(entry);
+        })
+        .onItemDrop((event: ItemDragInfo, itemIndex: number, insertIndex: number, isSuccess: boolean) => {
+          const adapter = this.getView().getAdapter();
+          if (!isSuccess || itemIndex === insertIndex || insertIndex < 0) {
+            return;
+          }
+          const target = Math.min(insertIndex, adapter.getItemCount() - 2);
+          adapter.onItemMove(itemIndex, target);
+          adapter.onItemDrop(target);
+        })
+      }
+    }
+    .width('100%')
+    .height('100%')
+  }
+}
