+class SetPasswordListener implements PasswordSlotListener {
+  private _fragment: PreferencesFragment;
+  private _pinKeyboardPreference: SwitchPreferenceCompat;
+  private _updateEncryptionPreferences: () => void;
+
+  constructor(fragment: PreferencesFragment, pinKeyboardPreference: SwitchPreferenceCompat,
+    updateEncryptionPreferences: () => void) {
+    this._fragment = fragment;
+    this._pinKeyboardPreference = pinKeyboardPreference;
+    this._updateEncryptionPreferences = updateEncryptionPreferences;
+  }
+
+  onSlotResult(slot: PasswordSlot, cipher: Cipher): void {
+    this.setPasswordSlot(slot, cipher).catch((e: Error) => this.onException(e));
+  }
+
+  private async setPasswordSlot(slot: PasswordSlot, cipher: Cipher): Promise<void> {
+    const vaultManager = this._fragment.getVaultManager();
+    const creds = vaultManager.getVault().getCredentials() as VaultFileCredentials;
+    const slots = creds.getSlots();
+
+    // encrypt the master key for this slot
+    await slot.setKey(creds.getKey(), cipher);
+
+    // remove the old master password slot
+    const passSlots = creds.getSlots().findRegularPasswordSlots();
+    if (passSlots.length !== 0) {
+      slots.remove(passSlots[0]);
+    }
+
+    // add the new master password slot
+    slots.add(slot);
+
+    vaultManager.getVault().setCredentials(creds);
+    this._fragment.saveAndBackupVault();
+
+    if (this._fragment.getPreferences().isPinKeyboardEnabled()) {
+      this._pinKeyboardPreference.setChecked(false);
+      this._fragment.getActivity().showToast($r('app.string.pin_keyboard_disabled'));
+    }
+  }
+
+  onException(e: Error): void {
+    this._updateEncryptionPreferences();
+    Dialogs.showErrorDialog(this._fragment.requireContext(), $r('app.string.encryption_set_password_error'), e);
+  }
+}
+
+class SetBackupPasswordListener implements PasswordSlotListener {
+  private _fragment: PreferencesFragment;
+  private _updateEncryptionPreferences: () => void;
+
+  constructor(fragment: PreferencesFragment, updateEncryptionPreferences: () => void) {
+    this._fragment = fragment;
+    this._updateEncryptionPreferences = updateEncryptionPreferences;
+  }
+
+  onSlotResult(slot: PasswordSlot, cipher: Cipher): void {
+    this.setBackupPasswordSlot(slot, cipher).catch((e: Error) => this.onException(e));
+  }
+
+  private async setBackupPasswordSlot(slot: PasswordSlot, cipher: Cipher): Promise<void> {
+    slot.setIsBackup(true);
+
+    const vaultManager = this._fragment.getVaultManager();
+    const creds = vaultManager.getVault().getCredentials() as VaultFileCredentials;
+    const slots = creds.getSlots();
+
+    // encrypt the master key for this slot
+    await slot.setKey(creds.getKey(), cipher);
+
+    // remove the old backup password slot
+    for (const oldSlot of slots.findBackupPasswordSlots()) {
+      slots.remove(oldSlot);
+    }
+
+    // add the new backup password slot
+    slots.add(slot);
+
+    vaultManager.getVault().setCredentials(creds);
+    this._fragment.saveAndBackupVault();
+    this._updateEncryptionPreferences();
+  }
+
+  onException(e: Error): void {
+    this._updateEncryptionPreferences();
+    Dialogs.showErrorDialog(this._fragment.requireContext(), $r('app.string.encryption_set_password_error'), e);
+  }
+}
+
+class RegisterBiometricsListener implements BiometricSlotInitializerListener {
+  private _fragment: PreferencesFragment;
+  private _updateEncryptionPreferences: () => void;
+
+  constructor(fragment: PreferencesFragment, updateEncryptionPreferences: () => void) {
+    this._fragment = fragment;
+    this._updateEncryptionPreferences = updateEncryptionPreferences;
+  }
+
+  onInitializeSlot(slot: BiometricSlot, cipher: Cipher): void {
+    this.initializeSlot(slot, cipher).catch((e: Error) => {
+      this.onSlotInitializationFailed(0, `${e.name}: ${e.message}`);
+    });
+  }
+
+  private async initializeSlot(slot: BiometricSlot, cipher: Cipher): Promise<void> {
+    const vaultManager = this._fragment.getVaultManager();
+    const creds = vaultManager.getVault().getCredentials() as VaultFileCredentials;
+    await slot.setKey(creds.getKey(), cipher);
+    creds.getSlots().add(slot);
+    vaultManager.getVault().setCredentials(creds);
+
+    this._fragment.saveAndBackupVault();
+    this._updateEncryptionPreferences();
+  }
+
+  onSlotInitializationFailed(errorCode: number, errString: string): void {
+    if (!BiometricsHelper.isCanceled(errorCode)) {
+      Dialogs.showErrorDialog(this._fragment.requireContext(), $r('app.string.encryption_enable_biometrics_error'),
+        errString);
+    }
+    this._updateEncryptionPreferences();
+  }
+}
