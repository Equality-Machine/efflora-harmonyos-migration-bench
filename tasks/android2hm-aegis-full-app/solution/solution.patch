diff --git a/entry/src/main/ets/vault/VaultEntry.ets b/entry/src/main/ets/vault/VaultEntry.ets
new file mode 100644
index 0000000..072597c
--- /dev/null
+++ b/entry/src/main/ets/vault/VaultEntry.ets
@@ -0,0 +1,264 @@
+import { UUIDMapValue } from '../util/UUIDMap';
+import { UUID } from '../util/UUID';
+import { JSONArray, JSONObject } from '../util/JSONObject';
+import { JsonUtils } from '../util/JsonUtils';
+import { OtpInfo } from '../otp/OtpInfo';
+import { TotpInfo } from '../otp/TotpInfo';
+import { GoogleAuthInfo } from '../otp/GoogleAuthInfo';
+import { VaultEntryIcon } from './VaultEntryIcon';
+import { VaultEntryException } from './VaultEntryException';
+
+export class VaultEntry extends UUIDMapValue {
+  private _name: string = '';
+  private _issuer: string = '';
+  private _info: OtpInfo;
+  private _icon: VaultEntryIcon | null = null;
+  private _isFavorite: boolean = false;
+  private _usageCount: number = 0;
+  private _lastUsedTimestamp: number = 0;
+  private _note: string = '';
+  private _oldGroup: string | null = null;
+  private _groups: Set<string> = new Set<string>();
+
+  constructor(info: OtpInfo, name?: string, issuer?: string, uuid?: string) {
+    super(uuid);
+    this._info = info;
+    if (name !== undefined) {
+      this.setName(name);
+    }
+    if (issuer !== undefined) {
+      this.setIssuer(issuer);
+    }
+  }
+
+  static fromGoogleAuthInfo(info: GoogleAuthInfo): VaultEntry {
+    return new VaultEntry(info.getOtpInfo(), info.getAccountName(), info.getIssuer());
+  }
+
+  toJson(): JSONObject {
+    const obj = new JSONObject();
+    obj.put('type', this._info.getTypeId());
+    obj.put('uuid', this.getUUID());
+    obj.put('name', this._name);
+    obj.put('issuer', this._issuer);
+    obj.put('note', this._note);
+    obj.put('favorite', this._isFavorite);
+    VaultEntryIcon.toJson(this._icon, obj);
+    obj.put('info', this._info.toJson());
+
+    const groupUuids = new JSONArray();
+    for (const uuid of this.getSortedGroups()) {
+      groupUuids.put(uuid);
+    }
+    obj.put('groups', groupUuids);
+    return obj;
+  }
+
+  static fromJson(obj: JSONObject): VaultEntry {
+    try {
+      // if there is no uuid, generate a new one
+      let uuid: string;
+      if (!obj.has('uuid')) {
+        uuid = UUID.randomUUID();
+      } else {
+        uuid = UUID.fromString(obj.getString('uuid'));
+      }
+
+      const info = OtpInfo.fromJson(obj.getString('type'), obj.getJSONObject('info'));
+      const entry = new VaultEntry(info, undefined, undefined, uuid);
+      entry.setName(obj.getString('name'));
+      entry.setIssuer(obj.getString('issuer'));
+      entry.setNote(obj.optString('note', ''));
+      entry.setIsFavorite(obj.optBoolean('favorite', false));
+
+      // If the entry contains a list of group UUID's, assume conversion from the
+      // old group system has already taken place and ignore the old group field.
+      if (obj.has('groups')) {
+        const groups = obj.getJSONArray('groups');
+        for (let i = 0; i < groups.length(); i++) {
+          const groupUuid = groups.getString(i);
+          entry.addGroup(UUID.fromString(groupUuid));
+        }
+      } else if (obj.has('group')) {
+        entry.setOldGroup(JsonUtils.optString(obj, 'group'));
+      }
+
+      // Silently ignore any errors that occur when trying to parse the icon of an
+      // entry. This allows us to introduce new icon types in the future (e.g. WebP)
+      // without breaking compatibility with older versions of Aegis.
+      try {
+        const icon = VaultEntryIcon.fromJson(obj);
+        entry.setIcon(icon);
+      } catch (ignored) {
+      }
+
+      return entry;
+    } catch (e) {
+      throw new VaultEntryException((e as Error).message);
+    }
+  }
+
+  getName(): string {
+    return this._name;
+  }
+
+  getIssuer(): string {
+    return this._issuer;
+  }
+
+  getGroups(): Set<string> {
+    return this._groups;
+  }
+
+  getSortedGroups(): string[] {
+    return Array.from(this._groups).sort();
+  }
+
+  getIcon(): VaultEntryIcon | null {
+    return this._icon;
+  }
+
+  getInfo(): OtpInfo {
+    return this._info;
+  }
+
+  getUsageCount(): number {
+    return this._usageCount;
+  }
+
+  getLastUsedTimestamp(): number {
+    return this._lastUsedTimestamp;
+  }
+
+  getNote(): string {
+    return this._note;
+  }
+
+  isFavorite(): boolean {
+    return this._isFavorite;
+  }
+
+  setName(name: string): void {
+    this._name = name;
+  }
+
+  setIssuer(issuer: string): void {
+    this._issuer = issuer;
+  }
+
+  addGroup(group: string): void {
+    if (group === null || group === undefined) {
+      throw new Error('Attempt to add null group to entry\'s group list');
+    }
+    this._groups.add(group);
+  }
+
+  removeGroup(group: string): void {
+    this._groups.delete(group);
+  }
+
+  setGroups(groups: Set<string>): void {
+    this._groups = groups;
+  }
+
+  setInfo(info: OtpInfo): void {
+    this._info = info;
+  }
+
+  setIcon(icon: VaultEntryIcon | null): void {
+    this._icon = icon;
+  }
+
+  hasIcon(): boolean {
+    return this._icon !== null;
+  }
+
+  setUsageCount(usageCount: number): void {
+    this._usageCount = usageCount;
+  }
+
+  setLastUsedTimestamp(lastUsedTimestamp: number): void {
+    this._lastUsedTimestamp = lastUsedTimestamp;
+  }
+
+  setNote(note: string): void {
+    this._note = note;
+  }
+
+  setIsFavorite(isFavorite: boolean): void {
+    this._isFavorite = isFavorite;
+  }
+
+  setOldGroup(oldGroup: string | null): void {
+    this._oldGroup = oldGroup;
+  }
+
+  getOldGroup(): string | null {
+    return this._oldGroup;
+  }
+
+  equals(o: Object | null): boolean {
+    if (!(o instanceof VaultEntry)) {
+      return false;
+    }
+    const entry = o as VaultEntry;
+    return super.equals(entry) && this.equivalates(entry);
+  }
+
+  private static setsEqual(a: Set<string>, b: Set<string>): boolean {
+    if (a.size !== b.size) {
+      return false;
+    }
+    for (const v of Array.from(a)) {
+      if (!b.has(v)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  /**
+   * Reports whether this entry is equivalent to the given entry. The UUIDs of these
+   * entries are ignored during the comparison, so they are not necessarily the same
+   * instance.
+   */
+  equivalates(entry: VaultEntry): boolean {
+    return this.getName() === entry.getName()
+      && this.getIssuer() === entry.getIssuer()
+      && this.getInfo().equals(entry.getInfo())
+      && VaultEntryIcon.iconsEqual(this.getIcon(), entry.getIcon())
+      && this.getNote() === entry.getNote()
+      && this.isFavorite() === entry.isFavorite()
+      && VaultEntry.setsEqual(this.getGroups(), entry.getGroups());
+  }
+
+  hasSameNameAndIssuer(entry: VaultEntry): boolean {
+    return this.getName() === entry.getName() && this.getIssuer() === entry.getIssuer();
+  }
+
+  /**
+   * Reports whether this entry has its values set to the defaults.
+   */
+  isDefault(): boolean {
+    return this.equivalates(VaultEntry.getDefault());
+  }
+
+  static getDefault(): VaultEntry {
+    return new VaultEntry(new TotpInfo(null));
+  }
+
+  /**
+   * Returns a deep copy of this entry (replacement for Cloner.clone).
+   */
+  clone(): VaultEntry {
+    const copy = new VaultEntry(this._info.clone(), this._name, this._issuer, this.getUUID());
+    copy._icon = this._icon;
+    copy._isFavorite = this._isFavorite;
+    copy._usageCount = this._usageCount;
+    copy._lastUsedTimestamp = this._lastUsedTimestamp;
+    copy._note = this._note;
+    copy._oldGroup = this._oldGroup;
+    copy._groups = new Set<string>(Array.from(this._groups));
+    return copy;
+  }
+}
