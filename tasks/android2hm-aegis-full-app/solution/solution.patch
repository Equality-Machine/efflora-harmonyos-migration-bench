@@ -0,0 +1,72 @@
+import { common } from '@kit.AbilityKit';
+
+/**
+ * Helpers for resolving string resources from non-UI code (replacement for Context.getString()).
+ */
+export class ResUtils {
+  private constructor() {
+  }
+
+  static format(template: string, args: Array<string | number>): string {
+    let res = template;
+    // positional arguments: %1$s, %2$d
+    for (let i = 0; i < args.length; i++) {
+      res = res.replace(new RegExp(`%${i + 1}\\$[sdf]`, 'g'), `${args[i]}`);
+    }
+    // sequential arguments: %s, %d
+    let idx = 0;
+    res = res.replace(new RegExp('%[sdf]', 'g'), (m: string) => {
+      const v = idx < args.length ? `${args[idx]}` : m;
+      idx++;
+      return v;
+    });
+    return res.replace(new RegExp('%%', 'g'), '%');
+  }
+
+  static getString(context: common.Context, name: string, args?: Array<string | number>): string {
+    let s = '';
+    try {
+      s = context.resourceManager.getStringByNameSync(name);
+    } catch (e) {
+      s = name;
+    }
+    return args !== undefined ? ResUtils.format(s, args) : s;
+  }
+
+  static getStringRes(context: common.Context, res: Resource, args?: Array<string | number>): string {
+    let s = '';
+    try {
+      s = context.resourceManager.getStringSync(res.id);
+    } catch (e) {
+      s = '';
+    }
+    return args !== undefined ? ResUtils.format(s, args) : s;
+  }
+
+  static getQuantityString(context: common.Context, name: string, quantity: number, args?: Array<string | number>): string {
+    if (args !== undefined && args.length > 1) {
+      // plurals with several placeholders (e.g. "%d / %d QR codes") cannot be formatted with the
+      // quantity alone: format them with all arguments
+      try {
+        return context.resourceManager.getIntPluralStringByNameSync(name, quantity, ...args);
+      } catch (e) {
+        // fall through
+      }
+    }
+    let s = '';
+    try {
+      s = context.resourceManager.getPluralStringByNameSync(name, quantity);
+    } catch (e) {
+      s = `${quantity}`;
+    }
+    return ResUtils.format(s, args !== undefined ? args : [quantity]);
+  }
+
+  static getStringArray(context: common.Context, name: string): string[] {
+    try {
+      return context.resourceManager.getStringArrayByNameSync(name);
+    } catch (e) {
+      return [];
+    }
+  }
+}
