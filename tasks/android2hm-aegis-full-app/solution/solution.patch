diff --git a/entry/src/main/ets/crypto/CryptoUtils.ets b/entry/src/main/ets/crypto/CryptoUtils.ets
new file mode 100644
index 0000000..fd2ef21
--- /dev/null
+++ b/entry/src/main/ets/crypto/CryptoUtils.ets
@@ -0,0 +1,257 @@
+import { cryptoFramework } from '@kit.CryptoArchitectureKit';
+import { CryptParameters } from './CryptParameters';
+import { CryptResult } from './CryptResult';
+import { SCryptParameters } from './SCryptParameters';
+import { Bytes } from '../util/Bytes';
+import { SCrypt } from './bc/SCrypt';
+
+/**
+ * A raw symmetric key (replacement for javax.crypto.SecretKey).
+ */
+export class SecretKey {
+  private _encoded: Uint8Array;
+
+  constructor(encoded: Uint8Array) {
+    this._encoded = encoded;
+  }
+
+  getEncoded(): Uint8Array {
+    return this._encoded;
+  }
+}
+
+export class CryptoUtils {
+  static readonly CRYPTO_AEAD: string = 'AES256|GCM|NoPadding';
+  static readonly CRYPTO_AEAD_KEY_SIZE: number = 32;
+  static readonly CRYPTO_AEAD_TAG_SIZE: number = 16;
+  static readonly CRYPTO_AEAD_NONCE_SIZE: number = 12;
+
+  static readonly CRYPTO_SCRYPT_N: number = 1 << 15;
+  static readonly CRYPTO_SCRYPT_r: number = 8;
+  static readonly CRYPTO_SCRYPT_p: number = 1;
+
+  private constructor() {
+  }
+
+  /**
+   * Derives a key from the given input using scrypt. This runs natively off the UI thread.
+   */
+  static async deriveKey(input: Uint8Array, params: SCryptParameters): Promise<SecretKey> {
+    const bytes = await SCrypt.generate(input, params.getSalt(), params.getN(), params.getR(), params.getP(),
+      CryptoUtils.CRYPTO_AEAD_KEY_SIZE);
+    return new SecretKey(bytes);
+  }
+
+  static async deriveKeyFromPassword(password: string, params: SCryptParameters): Promise<SecretKey> {
+    return CryptoUtils.deriveKey(CryptoUtils.toBytes(password), params);
+  }
+
+  static async scrypt(input: Uint8Array, salt: Uint8Array, n: number, r: number, p: number, keySize: number): Promise<Uint8Array> {
+    const kdf = cryptoFramework.createKdf('SCRYPT');
+    const spec: cryptoFramework.ScryptSpec = {
+      algName: 'SCRYPT',
+      passphrase: input,
+      salt: salt,
+      n: n,
+      r: r,
+      p: p,
+      maxMemory: 128 * n * r * p + 128 * r * p * 2 + 1024 * 1024,
+      keySize: keySize
+    };
+    const secret = await kdf.generateSecret(spec);
+    return secret.data;
+  }
+
+  static async pbkdf2(digest: string, password: Uint8Array, salt: Uint8Array, iterations: number, keySize: number): Promise<Uint8Array> {
+    const kdf = cryptoFramework.createKdf(`PBKDF2|${digest}`);
+    const spec: cryptoFramework.PBKDF2Spec = {
+      algName: 'PBKDF2',
+      password: password,
+      salt: salt,
+      iterations: iterations,
+      keySize: keySize
+    };
+    const secret = await kdf.generateSecret(spec);
+    return secret.data;
+  }
+
+  static async hkdf(digest: string, key: Uint8Array, salt: Uint8Array, info: Uint8Array, keySize: number): Promise<Uint8Array> {
+    const kdf = cryptoFramework.createKdf(`HKDF|${digest}|EXTRACT_AND_EXPAND`);
+    const spec: cryptoFramework.HKDFSpec = {
+      algName: 'HKDF',
+      key: key,
+      salt: salt,
+      info: info,
+      keySize: keySize
+    };
+    const secret = await kdf.generateSecret(spec);
+    return secret.data;
+  }
+
+  private static aesAlgName(key: Uint8Array): string {
+    return `AES${key.length * 8}`;
+  }
+
+  static convertAesKey(key: Uint8Array): cryptoFramework.SymKey {
+    const gen = cryptoFramework.createSymKeyGenerator(CryptoUtils.aesAlgName(key));
+    return gen.convertKeySync({ data: key });
+  }
+
+  /**
+   * Encrypts the given data with AES-GCM. If no nonce is given, a random one is generated.
+   * The tag is split off and stored separately in the resulting CryptParameters.
+   */
+  static encrypt(data: Uint8Array, key: SecretKey, nonce?: Uint8Array): CryptResult {
+    const iv = nonce !== undefined ? nonce : CryptoUtils.generateRandomBytes(CryptoUtils.CRYPTO_AEAD_NONCE_SIZE);
+    const symKey = CryptoUtils.convertAesKey(key.getEncoded());
+    const cipher = cryptoFramework.createCipher(`${CryptoUtils.aesAlgName(key.getEncoded())}|GCM|NoPadding`);
+    const spec: cryptoFramework.GcmParamsSpec = {
+      algName: 'GcmParamsSpec',
+      iv: { data: iv },
+      aad: { data: new Uint8Array(0) },
+      authTag: { data: new Uint8Array(CryptoUtils.CRYPTO_AEAD_TAG_SIZE) }
+    };
+    cipher.initSync(cryptoFramework.CryptoMode.ENCRYPT_MODE, symKey, spec);
+    const encrypted = data.length > 0 ? cipher.updateSync({ data: data }).data : new Uint8Array(0);
+    const tag = cipher.doFinalSync(null).data;
+    return new CryptResult(Bytes.copy(encrypted), new CryptParameters(iv, Bytes.copy(tag)));
+  }
+
+  /**
+   * Decrypts the given AES-GCM ciphertext. Throws if the tag could not be verified.
+   */
+  static decrypt(encrypted: Uint8Array, key: SecretKey, params: CryptParameters): CryptResult {
+    const symKey = CryptoUtils.convertAesKey(key.getEncoded());
+    const cipher = cryptoFramework.createCipher(`${CryptoUtils.aesAlgName(key.getEncoded())}|GCM|NoPadding`);
+    const spec: cryptoFramework.GcmParamsSpec = {
+      algName: 'GcmParamsSpec',
+      iv: { data: params.getNonce() },
+      aad: { data: new Uint8Array(0) },
+      authTag: { data: params.getTag() }
+    };
+    cipher.initSync(cryptoFramework.CryptoMode.DECRYPT_MODE, symKey, spec);
+    let decrypted = new Uint8Array(0);
+    if (encrypted.length > 0) {
+      decrypted = Bytes.copy(cipher.updateSync({ data: encrypted }).data);
+    }
+    const fin = cipher.doFinalSync(null);
+    if (fin !== null && fin.data !== undefined && fin.data.length > 0) {
+      decrypted = Bytes.concat([decrypted, fin.data]);
+    }
+    return new CryptResult(decrypted, params);
+  }
+
+  /**
+   * Decrypts AES-GCM where the tag is appended to the ciphertext (Java style).
+   */
+  static decryptGcmWithAppendedTag(key: Uint8Array, nonce: Uint8Array, data: Uint8Array, aad?: Uint8Array): Uint8Array {
+    const tagSize = CryptoUtils.CRYPTO_AEAD_TAG_SIZE;
+    const ct = data.subarray(0, data.length - tagSize);
+    const tag = Bytes.copyOfRange(data, data.length - tagSize, data.length);
+    const symKey = CryptoUtils.convertAesKey(key);
+    const cipher = cryptoFramework.createCipher(`${CryptoUtils.aesAlgName(key)}|GCM|NoPadding`);
+    const spec: cryptoFramework.GcmParamsSpec = {
+      algName: 'GcmParamsSpec',
+      iv: { data: nonce },
+      aad: { data: aad !== undefined ? aad : new Uint8Array(0) },
+      authTag: { data: tag }
+    };
+    cipher.initSync(cryptoFramework.CryptoMode.DECRYPT_MODE, symKey, spec);
+    let decrypted = new Uint8Array(0);
+    if (ct.length > 0) {
+      decrypted = Bytes.copy(cipher.updateSync({ data: Bytes.copy(ct) }).data);
+    }
+    const fin = cipher.doFinalSync(null);
+    if (fin !== null && fin.data !== undefined && fin.data.length > 0) {
+      decrypted = Bytes.concat([decrypted, fin.data]);
+    }
+    return decrypted;
+  }
+
+  /**
+   * Encrypts with AES-GCM and returns ciphertext with the tag appended (Java style).
+   */
+  static encryptGcmWithAppendedTag(key: Uint8Array, nonce: Uint8Array, data: Uint8Array): Uint8Array {
+    const res = CryptoUtils.encrypt(data, new SecretKey(key), nonce);
+    return Bytes.concat([res.getData(), res.getParams().getTag()]);
+  }
+
+  /**
+   * Generic AES cipher operation for the given mode ("CBC", "ECB", "CTR") and padding ("PKCS7", "NoPadding").
+   */
+  static aes(encrypt: boolean, mode: string, padding: string, key: Uint8Array, iv: Uint8Array | null, data: Uint8Array): Uint8Array {
+    const symKey = CryptoUtils.convertAesKey(key);
+    const cipher = cryptoFramework.createCipher(`${CryptoUtils.aesAlgName(key)}|${mode}|${padding}`);
+    let params: cryptoFramework.IvParamsSpec | null = null;
+    if (iv !== null) {
+      params = { algName: 'IvParamsSpec', iv: { data: iv } };
+    }
+    cipher.initSync(encrypt ? cryptoFramework.CryptoMode.ENCRYPT_MODE : cryptoFramework.CryptoMode.DECRYPT_MODE, symKey, params);
+    const parts: Uint8Array[] = [];
+    if (data.length > 0) {
+      const upd = cipher.updateSync({ data: data });
+      if (upd !== null && upd.data !== undefined) {
+        parts.push(Bytes.copy(upd.data));
+      }
+    }
+    const fin = cipher.doFinalSync(null);
+    if (fin !== null && fin.data !== undefined) {
+      parts.push(Bytes.copy(fin.data));
+    }
+    return Bytes.concat(parts);
+  }
+
+  static generateKey(): SecretKey {
+    return new SecretKey(CryptoUtils.generateRandomBytes(CryptoUtils.CRYPTO_AEAD_KEY_SIZE));
+  }
+
+  static generateSalt(): Uint8Array {
+    return CryptoUtils.generateRandomBytes(CryptoUtils.CRYPTO_AEAD_KEY_SIZE);
+  }
+
+  static generateRandomBytes(length: number): Uint8Array {
+    const random = cryptoFramework.createRandom();
+    return Bytes.copy(random.generateRandomSync(length).data);
+  }
+
+  static toBytes(password: string): Uint8Array {
+    return Bytes.fromUtf8(password);
+  }
+
+  /**
+   * Reproduces the old (buggy) behavior of encoding a password: the backing array of the
+   * encoded ByteBuffer was used, which could contain trailing zero bytes.
+   * @deprecated
+   */
+  static toBytesOld(password: string): Uint8Array {
+    const bytes = Bytes.fromUtf8(password);
+    let n = Math.floor(password.length * 1.1);
+    while (n < bytes.length) {
+      n = 2 * n + 1;
+    }
+    const out = new Uint8Array(n);
+    out.set(bytes);
+    return out;
+  }
+
+  static hmac(algo: string, key: Uint8Array, data: Uint8Array): Uint8Array {
+    const mac = cryptoFramework.createMac(algo);
+    const gen = cryptoFramework.createSymKeyGenerator('HMAC');
+    const symKey = gen.convertKeySync({ data: key.length > 0 ? key : new Uint8Array(1) });
+    mac.initSync(symKey);
+    mac.updateSync({ data: data });
+    return Bytes.copy(mac.doFinalSync().data);
+  }
+
+  static digest(algo: string, data: Uint8Array): Uint8Array {
+    const md = cryptoFramework.createMd(algo);
+    if (data.length > 0) {
+      md.updateSync({ data: data });
+    }
+    return Bytes.copy(md.digestSync().data);
+  }
+
+  static sha256(data: Uint8Array): Uint8Array {
+    return CryptoUtils.digest('SHA256', data);
+  }
+}
diff --git a/entry/src/main/ets/crypto/KeyStoreHandle.ets b/entry/src/main/ets/crypto/KeyStoreHandle.ets
