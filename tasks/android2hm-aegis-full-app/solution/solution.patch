index 0000000..b5c7804
--- /dev/null
+++ b/entry/src/main/ets/crypto/KeyStoreHandle.ets
@@ -0,0 +1,111 @@
+import { huks } from '@kit.UniversalKeystoreKit';
+import { KeyStoreHandleException } from './KeyStoreHandleException';
+import { KeyStoreCipher } from './Cipher';
+import { CryptoUtils } from './CryptoUtils';
+import { CryptParameters } from './CryptParameters';
+import { AegisModule } from '../AegisModule';
+
+const ALIAS_PREFS_KEY: string = 'keystore_aliases';
+
+/**
+ * Wrapper around the HarmonyOS Universal Keystore (HUKS), the replacement for the Android KeyStore.
+ * Keys are bound to biometric authentication and are invalidated when new biometrics are enrolled.
+ */
+export class KeyStoreHandle {
+  private static emptyOptions(): huks.HuksOptions {
+    const props: Array<huks.HuksParam> = [];
+    return { properties: props };
+  }
+
+  async containsKey(id: string): Promise<boolean> {
+    try {
+      return await huks.isKeyItemExist(id, KeyStoreHandle.emptyOptions());
+    } catch (e) {
+      const code = (e as Record<string, Object>)['code'] as number;
+      if (code === huks.HuksExceptionErrCode.HUKS_ERR_CODE_ITEM_NOT_EXIST) {
+        return false;
+      }
+      throw new KeyStoreHandleException(`Unable to query key: ${(e as Error).message}`);
+    }
+  }
+
+  async generateKey(id: string): Promise<void> {
+    const props: Array<huks.HuksParam> = [
+      { tag: huks.HuksTag.HUKS_TAG_ALGORITHM, value: huks.HuksKeyAlg.HUKS_ALG_AES },
+      { tag: huks.HuksTag.HUKS_TAG_KEY_SIZE, value: huks.HuksKeySize.HUKS_AES_KEY_SIZE_256 },
+      {
+        tag: huks.HuksTag.HUKS_TAG_PURPOSE,
+        value: huks.HuksKeyPurpose.HUKS_KEY_PURPOSE_ENCRYPT | huks.HuksKeyPurpose.HUKS_KEY_PURPOSE_DECRYPT
+      },
+      { tag: huks.HuksTag.HUKS_TAG_PADDING, value: huks.HuksKeyPadding.HUKS_PADDING_NONE },
+      { tag: huks.HuksTag.HUKS_TAG_BLOCK_MODE, value: huks.HuksCipherMode.HUKS_MODE_GCM },
+      {
+        tag: huks.HuksTag.HUKS_TAG_USER_AUTH_TYPE,
+        value: huks.HuksUserAuthType.HUKS_USER_AUTH_TYPE_FINGERPRINT | huks.HuksUserAuthType.HUKS_USER_AUTH_TYPE_FACE
+      },
+      {
+        tag: huks.HuksTag.HUKS_TAG_KEY_AUTH_ACCESS_TYPE,
+        value: huks.HuksAuthAccessType.HUKS_AUTH_ACCESS_INVALID_NEW_BIO_ENROLL
+      },
+      { tag: huks.HuksTag.HUKS_TAG_CHALLENGE_TYPE, value: huks.HuksChallengeType.HUKS_CHALLENGE_TYPE_NORMAL }
+    ];
+    try {
+      await huks.generateKeyItem(id, { properties: props });
+      KeyStoreHandle.rememberAlias(id);
+    } catch (e) {
+      throw new KeyStoreHandleException(`Unable to generate key: ${(e as Error).message}`);
+    }
+  }
+
+  /**
+   * Creates a cipher for encrypting with the key that has the given id.
+   */
+  createEncryptCipher(id: string): KeyStoreCipher {
+    return new KeyStoreCipher(id, true, CryptoUtils.generateRandomBytes(CryptoUtils.CRYPTO_AEAD_NONCE_SIZE), null);
+  }
+
+  /**
+   * Creates a cipher for decrypting with the key that has the given id.
+   */
+  createDecryptCipher(id: string, params: CryptParameters): KeyStoreCipher {
+    return new KeyStoreCipher(id, false, params.getNonce(), params.getTag());
+  }
+
+  async deleteKey(id: string): Promise<void> {
+    try {
+      await huks.deleteKeyItem(id, KeyStoreHandle.emptyOptions());
+    } catch (e) {
+      throw new KeyStoreHandleException(`Unable to delete key: ${(e as Error).message}`);
+    } finally {
+      KeyStoreHandle.forgetAlias(id);
+    }
+  }
+
+  async clear(): Promise<void> {
+    for (const alias of KeyStoreHandle.getAliases()) {
+      try {
+        await this.deleteKey(alias);
+      } catch (e) {
+        // ignore
+      }
+    }
+  }
+
+  private static getAliases(): string[] {
+    const raw = AegisModule.getPreferences().getRawString(ALIAS_PREFS_KEY, '');
+    return raw.length === 0 ? [] : raw.split(',');
+  }
+
+  private static rememberAlias(id: string): void {
+    const aliases = KeyStoreHandle.getAliases();
+    if (aliases.indexOf(id) < 0) {
+      aliases.push(id);
+    }
+    AegisModule.getPreferences().putRawString(ALIAS_PREFS_KEY, aliases.join(','));
+  }
+
+  private static forgetAlias(id: string): void {
+    const aliases = KeyStoreHandle.getAliases().filter((a: string) => a !== id);
+    AegisModule.getPreferences().putRawString(ALIAS_PREFS_KEY, aliases.join(','));
+  }
+}
