diff --git a/entry/src/main/ets/encoding/Hex.ets b/entry/src/main/ets/encoding/Hex.ets
new file mode 100644
index 0000000..9f593f8
--- /dev/null
+++ b/entry/src/main/ets/encoding/Hex.ets
@@ -0,0 +1,33 @@
+import { EncodingException } from './EncodingException';
+
+const HEX_CHARS: string = '0123456789abcdef';
+
+export class Hex {
+  private constructor() {
+  }
+
+  static decode(s: string): Uint8Array {
+    const str = s.toLowerCase();
+    if (str.length % 2 !== 0) {
+      throw new EncodingException('Invalid input length');
+    }
+    const out = new Uint8Array(str.length / 2);
+    for (let i = 0; i < out.length; i++) {
+      const hi = HEX_CHARS.indexOf(str.charAt(i * 2));
+      const lo = HEX_CHARS.indexOf(str.charAt(i * 2 + 1));
+      if (hi < 0 || lo < 0) {
+        throw new EncodingException(`Unrecognized character: ${str.charAt(hi < 0 ? i * 2 : i * 2 + 1)}`);
+      }
+      out[i] = (hi << 4) | lo;
+    }
+    return out;
+  }
+
+  static encode(data: Uint8Array): string {
+    let res = '';
+    for (let i = 0; i < data.length; i++) {
+      res += HEX_CHARS.charAt((data[i] >> 4) & 0x0f) + HEX_CHARS.charAt(data[i] & 0x0f);
+    }
+    return res;
+  }
+}
