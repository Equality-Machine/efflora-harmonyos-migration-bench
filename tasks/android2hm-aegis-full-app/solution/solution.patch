+ * keyboard option of the authentication screen).
+ */
+@Component
+export struct NoAutofillEditText {
+  @Prop text: string = '';
+  @Prop hint: ResourceStr = '';
+  @Prop numeric: boolean = true;
+  onTextChange: (value: string) => void = (value: string) => {
+  };
