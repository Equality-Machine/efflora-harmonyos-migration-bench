+import { Hex } from '../encoding/Hex';
+import { JSONObject } from '../util/JSONObject';
+
+export class CryptParameters {
+  private _nonce: Uint8Array;
+  private _tag: Uint8Array;
+
+  constructor(nonce: Uint8Array, tag: Uint8Array) {
+    this._nonce = nonce;
+    this._tag = tag;
+  }
+
+  toJson(): JSONObject {
+    const obj = new JSONObject();
+    obj.put('nonce', Hex.encode(this._nonce));
+    obj.put('tag', Hex.encode(this._tag));
+    return obj;
+  }
+
+  static fromJson(obj: JSONObject): CryptParameters {
+    const nonce = Hex.decode(obj.getString('nonce'));
+    const tag = Hex.decode(obj.getString('tag'));
+    return new CryptParameters(nonce, tag);
+  }
+
+  getNonce(): Uint8Array {
+    return this._nonce;
+  }
+
+  getTag(): Uint8Array {
+    return this._tag;
+  }
+}
