diff --git a/entry/src/main/ets/helpers/PasswordStrengthHelper.ets b/entry/src/main/ets/helpers/PasswordStrengthHelper.ets
new file mode 100644
index 0000000..6ba6f5d
--- /dev/null
+++ b/entry/src/main/ets/helpers/PasswordStrengthHelper.ets
@@ -0,0 +1,125 @@
+/**
+ * Replacement for the zxcvbn based PasswordStrengthHelper. It implements a simplified version of the
+ * zxcvbn estimation (character class entropy, penalties for repeats, sequences and common
+ * passwords) that produces a score between 0 and 4 and an optional warning.
+ */
+export class PasswordStrength {
+  score: number;
+  warning: ResourceStr | null;
+
+  constructor(score: number, warning: ResourceStr | null) {
+    this.score = score;
+    this.warning = warning;
+  }
+}
+
+const COMMON_PASSWORDS: string[] = [
+  'password', '123456', '12345678', 'qwerty', 'abc123', 'monkey', 'letmein', 'dragon', '111111', 'baseball',
+  'iloveyou', 'trustno1', '1234567', 'sunshine', 'master', '123123', 'welcome', 'shadow', 'ashley', 'football',
+  'jesus', 'michael', 'ninja', 'mustang', 'password1', 'admin', 'qwertyuiop', 'login', 'princess', 'starwars',
+  'passw0rd', 'hello', 'freedom', 'whatever', 'qazwsx', 'zaq12wsx', 'aegis', 'secret', '000000', 'superman'
+];
+
+export class PasswordStrengthHelper {
+  // Limit the password length to prevent the estimator from exploding
+  static readonly MAX_PASSWORD_LENGTH: number = 64;
+  // Material design color palette
+  static readonly COLORS: string[] = ['#FF5252', '#FF5252', '#FFC107', '#8BC34A', '#4CAF50'];
+
+  static measure(password: string): PasswordStrength {
+    if (password.length === 0) {
+      return new PasswordStrength(0, null);
+    }
+
+    const lower = password.toLowerCase();
+    for (const common of COMMON_PASSWORDS) {
+      if (lower === common || lower.replace(new RegExp('[0-9!@#$%^&*]+$'), '') === common) {
+        return new PasswordStrength(0, $r('app.string.password_warning_common'));
+      }
+    }
+
+    let pool = 0;
+    if (new RegExp('[a-z]').test(password)) {
+      pool += 26;
+    }
+    if (new RegExp('[A-Z]').test(password)) {
+      pool += 26;
+    }
+    if (new RegExp('[0-9]').test(password)) {
+      pool += 10;
+    }
+    if (new RegExp('[^a-zA-Z0-9]').test(password)) {
+      pool += 33;
+    }
+
+    // count the effective length, penalizing repeats and sequences
+    let effective = 0;
+    let warning: ResourceStr | null = null;
+    let repeats = 0;
+    let sequences = 0;
+    for (let i = 0; i < password.length; i++) {
+      if (i > 0 && password.charAt(i) === password.charAt(i - 1)) {
+        repeats++;
+        effective += 0.25;
+        continue;
+      }
+      if (i > 1) {
+        const d1 = password.charCodeAt(i) - password.charCodeAt(i - 1);
+        const d2 = password.charCodeAt(i - 1) - password.charCodeAt(i - 2);
+        if (d1 === d2 && Math.abs(d1) === 1) {
+          sequences++;
+          effective += 0.25;
+          continue;
+        }
+      }
+      effective += 1;
+    }
+    if (repeats >= 2) {
+      warning = $r('app.string.password_warning_repeat');
+    } else if (sequences >= 2) {
+      warning = $r('app.string.password_warning_sequence');
+    }
+
+    const entropy = effective * Math.log2(Math.max(pool, 1));
+    // guesses ~ 2^entropy, map to zxcvbn-like thresholds (1e3, 1e6, 1e8, 1e10)
+    const log10Guesses = entropy * Math.log10(2);
+    let score: number;
+    if (log10Guesses < 3) {
+      score = 0;
+    } else if (log10Guesses < 6) {
+      score = 1;
+    } else if (log10Guesses < 8) {
+      score = 2;
+    } else if (log10Guesses < 10) {
+      score = 3;
+    } else {
+      score = 4;
+    }
+    if (warning === null && password.length < 8 && score < 3) {
+      warning = $r('app.string.password_warning_short');
+    }
+    return new PasswordStrength(score, warning);
+  }
+
+  static getString(score: number): Resource {
+    switch (score) {
+      case 0:
+        return $r('app.string.password_strength_very_weak');
+      case 1:
+        return $r('app.string.password_strength_weak');
+      case 2:
+        return $r('app.string.password_strength_fair');
+      case 3:
+        return $r('app.string.password_strength_good');
+      default:
+        return $r('app.string.password_strength_strong');
+    }
+  }
+
+  static getColor(score: number): string {
+    if (score < 0 || score > 4) {
+      throw new Error('Not a valid zxcvbn score');
+    }
+    return PasswordStrengthHelper.COLORS[score];
+  }
+}
diff --git a/entry/src/main/ets/helpers/PermissionHelper.ets b/entry/src/main/ets/helpers/PermissionHelper.ets
