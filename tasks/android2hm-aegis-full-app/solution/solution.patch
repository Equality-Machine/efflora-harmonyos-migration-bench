new file mode 100644
index 0000000..319ffd1
--- /dev/null
+++ b/entry/src/main/ets/helpers/VibrationHelper.ets
@@ -0,0 +1,57 @@
+import { vibrator } from '@kit.SensorServiceKit';
+import { Preferences } from '../Preferences';
+
+export class VibrationHelper {
+  private _preferences: Preferences;
+
+  constructor(preferences: Preferences) {
+    this._preferences = preferences;
+  }
+
+  /**
+   * Vibrates with the given Android style waveform: alternating off/on durations in milliseconds.
+   */
+  vibratePattern(pattern: number[]): void {
+    if (!this.isHapticFeedbackEnabled()) {
+      return;
+    }
+
+    try {
+      const builder = new vibrator.VibratorPatternBuilder();
+      let time = 0;
+      let events = 0;
+      for (let i = 0; i < pattern.length; i++) {
+        if (i % 2 === 1 && pattern[i] > 0) {
+          builder.addContinuousEvent(time, pattern[i]);
+          events++;
+        }
+        time += pattern[i];
+      }
+      if (events === 0) {
+        return;
+      }
+      const effect: vibrator.VibrateFromPattern = { type: 'pattern', pattern: builder.build() };
+      const attribute: vibrator.VibrateAttribute = { id: 0, usage: 'notification' };
+      vibrator.startVibration(effect, attribute).catch(() => {
+        this.vibrateFallback(pattern);
+      });
+    } catch (e) {
+      this.vibrateFallback(pattern);
+    }
+  }
+
+  private vibrateFallback(pattern: number[]): void {
+    let duration = 0;
+    for (let i = 1; i < pattern.length; i += 2) {
+      duration += pattern[i];
+    }
+    const effect: vibrator.VibrateTime = { type: 'time', duration: Math.max(duration, 1) };
+    const attribute: vibrator.VibrateAttribute = { id: 0, usage: 'notification' };
+    vibrator.startVibration(effect, attribute).catch(() => {
+    });
+  }
+
+  isHapticFeedbackEnabled(): boolean {
+    return this._preferences.isHapticFeedbackEnabled();
+  }
+}
