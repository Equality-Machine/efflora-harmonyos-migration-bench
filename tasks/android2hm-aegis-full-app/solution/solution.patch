diff --git a/entry/src/main/ets/ui/components/DropdownCheckBoxes.ets b/entry/src/main/ets/ui/components/DropdownCheckBoxes.ets
new file mode 100644
index 0000000..2f42e87
--- /dev/null
+++ b/entry/src/main/ets/ui/components/DropdownCheckBoxes.ets
@@ -0,0 +1,234 @@
+import { AegisModule } from '../../AegisModule';
+import { ResUtils } from '../../util/ResUtils';
+
+/**
+ * Model/controller of the DropdownCheckBoxes component (replacement for the methods of the
+ * DropdownCheckBoxes view). The label of every item is determined by its toString() method.
+ */
+export class DropdownCheckBoxesController {
+  private _selectedCountPlural: string = 'dropdown_checkboxes_default_count';
+  private _allowFiltering: boolean = false;
+  private _items: Object[] = [];
+  private _visibleItems: Object[] = [];
+  private _checkedItems: Set<Object> = new Set<Object>();
+  private _query: string = '';
+  private _onDismiss: (() => void) | null = null;
+  private _onChanged: (() => void) | null = null;
+
+  constructor(allowFiltering?: boolean) {
+    this._allowFiltering = allowFiltering === true;
+  }
+
+  /**
+   * Add items to be displayed as a checkbox in the dropdown view.
+   *
+   * @param items a list of the items you want to show in the dropdown
+   * @param startChecked whether the checkbox should be checked initially
+   */
+  addItems(items: Object[], startChecked: boolean): void {
+    for (const item of items) {
+      this._items.push(item);
+      this._visibleItems.push(item);
+      if (startChecked) {
+        this._checkedItems.add(item);
+      }
+    }
+
+    this.updateCheckedItemsCountText();
+  }
+
+  setCheckedItemsCountTextRes(pluralName: string): void {
+    this._selectedCountPlural = pluralName;
+    this.notifyChanged();
+  }
+
+  getCheckedItems(): Set<Object> {
+    return this._checkedItems;
+  }
+
+  getVisibleItems(): Object[] {
+    return this._visibleItems;
+  }
+
+  isAllowFiltering(): boolean {
+    return this._allowFiltering;
+  }
+
+  isChecked(item: Object): boolean {
+    return this._checkedItems.has(item);
+  }
+
+  setChecked(item: Object, checked: boolean): void {
+    if (checked) {
+      this._checkedItems.add(item);
+    } else {
+      this._checkedItems.delete(item);
+    }
+
+    this.updateCheckedItemsCountText();
+  }
+
+  /**
+   * Replacement for the Filter of the adapter: only shows the items that contain the query.
+   */
+  filter(query: string): void {
+    this._query = query;
+    if (query.length === 0) {
+      this._visibleItems = this._items.slice();
+    } else {
+      const q = query.toLowerCase();
+      this._visibleItems = this._items.filter((item: Object) => item.toString().toLowerCase().includes(q));
+    }
+    this.notifyChanged();
+  }
+
+  getQuery(): string {
+    return this._query;
+  }
+
+  /**
+   * Returns the text shown in the dropdown field ("x selected").
+   */
+  getText(): string {
+    const count = this._checkedItems.size;
+    return ResUtils.getQuantityString(AegisModule.getContext(), this._selectedCountPlural, count, [count]);
+  }
+
+  private updateCheckedItemsCountText(): void {
+    this.notifyChanged();
+  }
+
+  setOnDismissListener(listener: (() => void) | null): void {
+    this._onDismiss = listener;
+  }
+
+  onDismiss(): void {
+    if (this._onDismiss !== null) {
+      this._onDismiss();
+    }
+  }
+
+  setOnChangedListener(listener: (() => void) | null): void {
+    this._onChanged = listener;
+  }
+
+  private notifyChanged(): void {
+    if (this._onChanged !== null) {
+      this._onChanged();
+    }
+  }
+}
+
+/**
+ * Port of the DropdownCheckBoxes view: a dropdown field that shows a list of checkboxes.
+ */
+@Component
+export struct DropdownCheckBoxes {
+  controller: DropdownCheckBoxesController = new DropdownCheckBoxesController();
+  @Prop hint: ResourceStr = '';
+  @Prop errorText: ResourceStr = '';
+  @State tick: number = 0;
+  @State showPopup: boolean = false;
+
+  aboutToAppear(): void {
+    this.controller.setOnChangedListener(() => {
+      this.tick++;
+    });
+  }
+
+  aboutToDisappear(): void {
+    this.controller.setOnChangedListener(null);
+  }
+
+  private getItems(tick: number): Object[] {
+    return this.controller.getVisibleItems();
+  }
+
+  private getText(tick: number): string {
+    return this.controller.getText();
+  }
+
+  @Builder
+  CheckboxList() {
+    Column() {
+      if (this.controller.isAllowFiltering()) {
+        TextInput({ text: this.controller.getQuery() })
+          .margin(8)
+          .onChange((v: string) => this.controller.filter(v))
+      }
+      List() {
+        ForEach(this.getItems(this.tick), (item: Object, index: number) => {
+          ListItem() {
+            Row() {
+              Checkbox()
+                .select(this.controller.isChecked(item))
+                .onChange((v: boolean) => this.controller.setChecked(item, v))
+              Text(item.toString())
+                .fontSize(15)
+                .fontColor($r('app.color.theme_onSurface'))
+                .layoutWeight(1)
+                .margin({ left: 8 })
+            }
+            .width('100%')
+            .height(48)
+            .padding({ left: 8, right: 16 })
+            .onClick(() => this.controller.setChecked(item, !this.controller.isChecked(item)))
+          }
+        }, (item: Object, index: number) => `${index}-${item.toString()}-${this.tick}`)
+      }
+      .constraintSize({ maxHeight: 280 })
+    }
+    .width(280)
+    .padding({ top: 4, bottom: 4 })
+  }
+
+  build() {
+    Column() {
+      if (this.hint !== '') {
+        Text(this.hint)
+          .fontSize(12)
+          .fontColor(this.errorText !== '' ? $r('app.color.theme_error') : $r('app.color.theme_onSurfaceVariant'))
+          .width('100%')
+          .margin({ bottom: 4 })
+      }
+      Row() {
+        Text(this.getText(this.tick))
+          .fontSize(16)
+          .fontColor($r('app.color.theme_onSurface'))
+          .layoutWeight(1)
+        Image($r('app.media.ic_outline_expand_more_24'))
+          .width(24)
+          .height(24)
+          .fillColor($r('app.color.theme_onSurfaceVariant'))
+      }
+      .width('100%')
+      .height(52)
+      .padding({ left: 16, right: 12 })
+      .borderWidth(1)
+      .borderRadius(4)
+      .borderColor(this.errorText !== '' ? $r('app.color.theme_error') : $r('app.color.theme_outline'))
+      .onClick(() => {
+        this.showPopup = !this.showPopup;
+      })
+      .bindPopup(this.showPopup, {
+        builder: this.CheckboxList(),
+        placement: Placement.Bottom,
+        onStateChange: (e) => {
+          if (!e.isVisible) {
+            this.showPopup = false;
+            this.controller.onDismiss();
+          }
+        }
+      })
+
+      if (this.errorText !== '') {
+        Text(this.errorText)
+          .fontSize(12)
+          .fontColor($r('app.color.theme_error'))
+          .width('100%')
+          .margin({ top: 4, left: 16 })
+      }
+    }
+    .width('100%')
+  }
+}
diff --git a/entry/src/main/ets/ui/components/KropView.ets b/entry/src/main/ets/ui/components/KropView.ets
new file mode 100644
index 0000000..fb93d81
--- /dev/null
+++ b/entry/src/main/ets/ui/components/KropView.ets
@@ -0,0 +1,134 @@
+import { image } from '@kit.ImageKit';
+
+/**
+ * State of a KropView (replacement for com.avito.android.krop.KropView): the image is displayed
+ * behind a round crop frame and can be moved (pan) and zoomed (pinch).
+ */
+@Observed
+export class KropViewController {
+  bitmap: image.PixelMap | null = null;
+  imageWidth: number = 0;
+  imageHeight: number = 0;
+  viewWidth: number = 0;
+  viewHeight: number = 0;
+  frameSize: number = 200;
+  scale: number = 1;
+  minScale: number = 1;
+  offsetX: number = 0;
+  offsetY: number = 0;
+
+  setBitmap(bitmap: image.PixelMap): void {
+    const size = bitmap.getImageInfoSync().size;
+    this.bitmap = bitmap;
+    this.imageWidth = size.width;
+    this.imageHeight = size.height;
+    this.reset();
+  }
+
+  setViewSize(width: number, height: number): void {
+    this.viewWidth = width;
+    this.viewHeight = height;
+    this.frameSize = Math.max(1, Math.floor(Math.min(width, height) * 0.8));
+    this.reset();
+  }
+
+  private reset(): void {
+    if (this.imageWidth <= 0 || this.imageHeight <= 0) {
+      return;
+    }
+    this.minScale = this.frameSize / Math.min(this.imageWidth, this.imageHeight);
+    this.scale = this.minScale;
+    this.offsetX = 0;
+    this.offsetY = 0;
+  }
+
+  setTransform(scale: number, offsetX: number, offsetY: number): void {
+    this.scale = Math.min(Math.max(scale, this.minScale), this.minScale * 8);
+    const maxX = Math.max(0, (this.imageWidth * this.scale - this.frameSize) / 2);
+    const maxY = Math.max(0, (this.imageHeight * this.scale - this.frameSize) / 2);
+    this.offsetX = Math.min(Math.max(offsetX, -maxX), maxX);
+    this.offsetY = Math.min(Math.max(offsetY, -maxY), maxY);
+  }
+
+  /**
+   * Returns the part of the image that is inside the crop frame.
+   */
+  getCroppedBitmap(): image.PixelMap | null {
+    if (this.bitmap === null || this.scale <= 0) {
+      return null;
+    }
+    const displayWidth = this.imageWidth * this.scale;
+    const displayHeight = this.imageHeight * this.scale;
+    const left = (displayWidth / 2 - this.offsetX - this.frameSize / 2) / this.scale;
+    const top = (displayHeight / 2 - this.offsetY - this.frameSize / 2) / this.scale;
+    let size = Math.floor(this.frameSize / this.scale);
+    size = Math.max(1, Math.min(size, this.imageWidth, this.imageHeight));
+    const x = Math.min(Math.max(0, Math.round(left)), this.imageWidth - size);
+    const y = Math.min(Math.max(0, Math.round(top)), this.imageHeight - size);
+
+    const cropped = this.bitmap.cloneSync();
+    const region: image.Region = { x: x, y: y, size: { width: size, height: size } };
+    cropped.cropSync(region);
+    return cropped;
+  }
+}
+
+@Component
+export struct KropView {
+  @ObjectLink controller: KropViewController;
+  private _startScale: number = 1;
+  private _startX: number = 0;
+  private _startY: number = 0;
+
+  build() {
+    Stack() {
+      if (this.controller.bitmap !== null) {
+        Image(this.controller.bitmap)
+          .width(this.controller.imageWidth * this.controller.scale)
+          .height(this.controller.imageHeight * this.controller.scale)
+          .objectFit(ImageFit.Fill)
+          .offset({ x: this.controller.offsetX, y: this.controller.offsetY })
+      }
+      Column()
+        .width(this.controller.frameSize)
+        .height(this.controller.frameSize)
+        .borderRadius(this.controller.frameSize / 2)
+        .border({ width: 2, color: Color.White })
+        .shadow({ radius: 6, color: '#80000000' })
+        .hitTestBehavior(HitTestMode.Transparent)
+    }
+    .width('100%')
+    .height('100%')
+    .clip(true)
+    .backgroundColor('#99000000')
+    .onAreaChange((oldValue: Area, newValue: Area) => {
+      const w = Number(newValue.width);
+      const h = Number(newValue.height);
+      if (w !== this.controller.viewWidth || h !== this.controller.viewHeight) {
+        this.controller.setViewSize(w, h);
+      }
+    })
+    .gesture(
+      GestureGroup(GestureMode.Parallel,
+        PanGesture({ distance: 1 })
+          .onActionStart(() => {
+            this._startX = this.controller.offsetX;
+            this._startY = this.controller.offsetY;
+          })
+          .onActionUpdate((event: GestureEvent) => {
+            this.controller.setTransform(this.controller.scale, this._startX + event.offsetX, this._startY + event.offsetY);
+          }),
+        PinchGesture()
+          .onActionStart(() => {
+            this._startScale = this.controller.scale;
+            this._startX = this.controller.offsetX;
+            this._startY = this.controller.offsetY;
+          })
+          .onActionUpdate((event: GestureEvent) => {
+            const ratio = event.scale;
+            this.controller.setTransform(this._startScale * ratio, this._startX * ratio, this._startY * ratio);
+          })
+      )
+    )
+  }
+}
