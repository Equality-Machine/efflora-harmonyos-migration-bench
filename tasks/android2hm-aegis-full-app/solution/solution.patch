+    this._e = e;
+  }
+
+  getIconPack(): IconPack | null {
+    return this._pack;
+  }
+
+  getException(): Error | null {
+    return this._e;
+  }
+}
+
+export type ImportIconPackTaskCallback = (result: ImportIconPackTaskResult) => void;
+
+/**
+ * Copies the icon pack ZIP file that was picked by the user to the cache directory and imports it.
+ */
+export class ImportIconPackTask extends ProgressDialogTask {
+  private readonly _cb: ImportIconPackTaskCallback;
+
+  constructor(uiContext: UIContext, cb: ImportIconPackTaskCallback) {
+    super(uiContext, $r('app.string.importing_icon_pack'));
+    this._cb = cb;
+  }
+
+  execute(params: ImportIconPackTaskParams): void {
+    this.run<ImportIconPackTaskResult>(() => ImportIconPackTask.doInBackground(params))
+      .then((result: ImportIconPackTaskResult) => this._cb(result))
+      .catch((e: Error) => this._cb(new ImportIconPackTaskResult(null, e)));
+  }
+
+  static async doInBackground(param: ImportIconPackTaskParams): Promise<ImportIconPackTaskResult> {
+    let tempFile: string | null = null;
+    try {
+      tempFile = ImportFileTask.createTempFile('icon-pack-', '.zip', AegisModule.getContext().cacheDir);
+      IOUtils.copy(param.getUri(), tempFile);
+
+      const pack = await param.getManager().importPack(tempFile);
+      return new ImportIconPackTaskResult(pack, null);
+    } catch (e) {
+      return new ImportIconPackTaskResult(null, e as Error);
+    } finally {
+      if (tempFile !== null) {
+        try {
+          fileIo.unlinkSync(tempFile);
+        } catch (ignored) {
+        }
+      }
+    }
+  }
+}
