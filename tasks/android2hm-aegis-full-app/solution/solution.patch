+import { VaultGroup } from '../../vault/VaultGroup';
+import { CollectionUtils } from '../../util/CollectionUtils';
+
+/**
+ * Replacement for GroupAdapter.Listener.
+ */
+export class GroupAdapterListener {
+  private readonly _onEdit: (group: VaultGroup) => void;
+  private readonly _onRemove: (group: VaultGroup) => void;
+
+  constructor(onEdit: (group: VaultGroup) => void, onRemove: (group: VaultGroup) => void) {
+    this._onEdit = onEdit;
+    this._onRemove = onRemove;
+  }
+
+  onEditGroup(group: VaultGroup): void {
+    this._onEdit(group);
+  }
+
+  onRemoveGroup(group: VaultGroup): void {
+    this._onRemove(group);
+  }
+}
+
+/**
+ * Port of GroupAdapter: the (reorderable) list of groups of the GroupManagerActivity.
+ */
+export class GroupAdapter {
+  private readonly _listener: GroupAdapterListener;
+  private readonly _groups: VaultGroup[];
+  private _observers: Array<() => void> = [];
+
+  constructor(listener: GroupAdapterListener) {
+    this._listener = listener;
+    this._groups = [];
+  }
+
+  registerObserver(observer: () => void): void {
+    this._observers.push(observer);
+  }
+
+  private notifyDataSetChanged(): void {
+    for (const observer of this._observers) {
+      observer();
+    }
+  }
+
+  getListener(): GroupAdapterListener {
+    return this._listener;
+  }
+
+  addGroup(group: VaultGroup): void {
+    this._groups.push(group);
+    this.notifyDataSetChanged();
+  }
+
+  getGroups(): VaultGroup[] {
+    return this._groups;
+  }
+
+  replaceGroup(uuid: string, newGroup: VaultGroup): void {
+    const oldGroup = this.getGroupByUUID(uuid);
+    if (oldGroup === null) {
+      return;
+    }
+    const position = this._groups.indexOf(oldGroup);
+    this._groups[position] = newGroup;
+    this.notifyDataSetChanged();
+  }
+
+  removeGroup(group: VaultGroup): void {
+    let position = this._groups.indexOf(group);
+    if (position < 0) {
+      position = this._groups.findIndex((g: VaultGroup) => g.getUUID() === group.getUUID());
+    }
+    if (position >= 0) {
+      this._groups.splice(position, 1);
+      this.notifyDataSetChanged();
+    }
+  }
+
+  onItemMove(firstPosition: number, secondPosition: number): void {
+    CollectionUtils.move(this._groups, firstPosition, secondPosition);
+    this.notifyDataSetChanged();
+  }
+
+  onItemDismiss(position: number): void {
+  }
+
+  onItemDrop(position: number): void {
+  }
+
+  private getGroupByUUID(uuid: string): VaultGroup | null {
+    for (const group of this._groups) {
+      if (group.getUUID() === uuid) {
+        return group;
+      }
+    }
+    return null;
+  }
+
+  getItemCount(): number {
+    return this._groups.length;
+  }
+}
