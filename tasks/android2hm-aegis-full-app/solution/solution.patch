+      throw new XmlPullParserException(`unexpected type (position: ${this.getPositionDescription()})`);
+    }
+    return type;
+  }
+
+  nextText(): string {
+    if (this._eventType !== XmlPullParser.START_TAG) {
+      throw new XmlPullParserException('parser must be on START_TAG to read next text');
+    }
+    let type = this.next();
+    if (type === XmlPullParser.TEXT) {
