+import { PasswordSlot } from '../../vault/slots/PasswordSlot';
+import { BiometricSlot } from '../../vault/slots/BiometricSlot';
+import { Slot } from '../../vault/slots/Slot';
+import { Cipher } from '../../crypto/Cipher';
+import { SecretKey } from '../../crypto/CryptoUtils';
+import { KeyDerivationTask } from '../tasks/KeyDerivationTask';
+import { BiometricSlotInitializer, BiometricSlotInitializerListener } from '../../helpers/BiometricSlotInitializer';
+import { BiometricPromptInfo, BiometricsHelper } from '../../helpers/BiometricsHelper';
+import { PasswordStrength, PasswordStrengthHelper } from '../../helpers/PasswordStrengthHelper';
+import { ResUtils } from '../../util/ResUtils';
+import { AegisModule } from '../../AegisModule';
+
+class BiometricsListener implements BiometricSlotInitializerListener {
+  private _slide: SecuritySetupSlide;
+
+  constructor(slide: SecuritySetupSlide) {
+    this._slide = slide;
+  }
+
+  onInitializeSlot(slot: BiometricSlot, cipher: Cipher): void {
+    this._slide.onInitializeBiometricSlot(slot, cipher);
+  }
+
+  onSlotInitializationFailed(errorCode: number, errString: string): void {
+    if (!BiometricsHelper.isCanceled(errorCode)) {
+      Dialogs.showErrorDialog(this._slide.getUIContext(), $r('app.string.encryption_enable_biometrics_error'), errString);
+    }
+  }
+}
+
+export class SecuritySetupSlide extends SlideFragment {
+  static readonly TYPE: string = 'SecuritySetupSlide';
+
+  private _cryptType: number = SecurityPickerSlide.CRYPT_TYPE_INVALID;
+  private _creds: VaultFileCredentials = new VaultFileCredentials();
+  password: string = '';
+  passwordConfirm: string = '';
+
+  getType(): string {
+    return SecuritySetupSlide.TYPE;
+  }
+
+  getUIContext(): UIContext {
+    return this.requireUIContext();
+  }
+
+  onResume(): void {
+    this._cryptType = this.getState().cryptType;
+    if (this._cryptType === SecurityPickerSlide.CRYPT_TYPE_INVALID || this._cryptType === SecurityPickerSlide.CRYPT_TYPE_NONE) {
+      throw new Error(`State of SecuritySetupSlide not properly propagated, cryptType: ${this._cryptType}`);
+    }
+    this._creds = new VaultFileCredentials();
+  }
+
+  private showBiometricPrompt(): void {
+    const initializer = new BiometricSlotInitializer(new BiometricsListener(this));
+    const context = AegisModule.getContext();
+    const info = new BiometricPromptInfo(ResUtils.getString(context, 'set_up_biometric'), '',
+      ResUtils.getString(context, 'cancel'));
+    initializer.authenticate(info);
+  }
+
+  onInitializeBiometricSlot(slot: BiometricSlot, cipher: Cipher): void {
+    slot.setKey(this._creds.getKey(), cipher).then(() => {
+      this._creds.getSlots().add(slot);
+      this.deriveKey();
+    }).catch((e: Error) => {
+      Dialogs.showErrorDialog(this.requireUIContext(), $r('app.string.encryption_enable_biometrics_error'), e);
+    });
+  }
+
+  private deriveKey(): void {
+    const slot = new PasswordSlot();
+    const task = new KeyDerivationTask(this.requireUIContext(), (passSlot: PasswordSlot, key: SecretKey | null, e: Error | null) => {
+      this.onPasswordDerived(passSlot, key, e);
+    });
+    task.execute(slot, this.password);
+  }
+
+  private onPasswordDerived(slot: PasswordSlot, key: SecretKey | null, err: Error | null): void {
+    if (key === null) {
+      Dialogs.showErrorDialog(this.requireUIContext(), $r('app.string.enable_encryption_error'),
+        err !== null ? err : new Error('Key derivation failed'));
+      return;
+    }
+    const cipher = Slot.createEncryptCipher(key);
+    slot.setKey(this._creds.getKey(), cipher).then(() => {
+      this._creds.getSlots().add(slot);
+      this.goToNextSlide();
+    }).catch((e: Error) => {
+      Dialogs.showErrorDialog(this.requireUIContext(), $r('app.string.enable_encryption_error'), e);
+    });
+  }
+
+  private arePasswordsEqual(): boolean {
+    return this.password.length > 0 && this.password === this.passwordConfirm;
+  }
+
+  isFinished(): boolean {
+    switch (this._cryptType) {
+      case SecurityPickerSlide.CRYPT_TYPE_NONE:
+        return true;
+      case SecurityPickerSlide.CRYPT_TYPE_BIOMETRIC:
+        if (!this._creds.getSlots().hasBiometricSlot()) {
+          return false;
+        }
+        return this.arePasswordsEqual() && this._creds.getSlots().hasPasswordSlot();
+      case SecurityPickerSlide.CRYPT_TYPE_PASS:
+        return this.arePasswordsEqual() && this._creds.getSlots().hasPasswordSlot();
+      default:
+        return false;
+    }
+  }
+
+  onNotFinishedError(): void {
+    if (!this.arePasswordsEqual()) {
+      this.requireUIContext().getPromptAction().showToast({ message: $r('app.string.password_equality_error') });
+    } else if (this._cryptType !== SecurityPickerSlide.CRYPT_TYPE_BIOMETRIC) {
+      this.deriveKey();
+    } else if (!this._creds.getSlots().hasBiometricSlot()) {
+      this.showBiometricPrompt();
+    }
+  }
+
+  onSaveIntroState(introState: IntroState): void {
+    introState.creds = this._creds;
+  }
+}
+
+@Component
+export struct SecuritySetupSlideView {
+  slide: SecuritySetupSlide | null = null;
+  @State password: string = '';
+  @State confirm: string = '';
+  @State visible: boolean = false;
+  @State strength: PasswordStrength = new PasswordStrength(0, null);
+
+  build() {
+    Column() {
+      Text($r('app.string.choose_authentication_method'))
+        .fontSize(24)
+        .fontColor($r('app.color.theme_onSurface'))
+        .width('100%')
+      Text($r('app.string.authentication_method_password_explanation'))
+        .fontSize(14)
+        .fontColor($r('app.color.theme_onSurfaceVariant'))
+        .width('100%')
+        .margin({ top: 12, bottom: 16 })
+      TextInput({ text: this.password, placeholder: $r('app.string.set_password') })
+        .type(this.visible ? InputType.Normal : InputType.Password)
+        .showPasswordIcon(false)
+        .onChange((v: string) => {
+          this.password = v;
+          this.strength = PasswordStrengthHelper.measure(v);
+          if (this.slide !== null) {
+            this.slide.password = v;
+          }
+        })
+      TextInput({ text: this.confirm, placeholder: $r('app.string.set_password_confirm') })
+        .type(this.visible ? InputType.Normal : InputType.Password)
+        .showPasswordIcon(false)
+        .margin({ top: 12 })
+        .onChange((v: string) => {
+          this.confirm = v;
+          if (this.slide !== null) {
+            this.slide.passwordConfirm = v;
+          }
+        })
+      if (this.password.length > PasswordStrengthHelper.MAX_PASSWORD_LENGTH) {
+        Text($r('app.string.password_strength_unknown'))
+          .fontSize(12)
+          .width('100%')
+          .margin({ top: 8 })
+      } else {
+        Progress({ value: this.password.length === 0 ? 0 : this.strength.score + 1, total: 5, type: ProgressType.Linear })
+          .color(PasswordStrengthHelper.getColor(this.strength.score))
+          .width('100%')
+          .margin({ top: 12 })
+        Row() {
+          if (this.strength.warning !== null && this.password.length > 0) {
+            Text(this.strength.warning)
+              .fontSize(12)
+              .fontColor($r('app.color.theme_error'))
+              .layoutWeight(1)
+          } else {
+            Blank()
+          }
+          if (this.password.length > 0) {
+            Text(PasswordStrengthHelper.getString(this.strength.score))
+              .fontSize(12)
+              .fontColor($r('app.color.theme_onSurfaceVariant'))
+          }
+        }
+        .width('100%')
+      }
+      Row() {
+        Checkbox()
+          .select(this.visible)
+          .onChange((v: boolean) => {
+            this.visible = v;
+          })
+        Text($r('app.string.show_password'))
+          .fontSize(14)
+          .fontColor($r('app.color.theme_onSurface'))
+      }
+      .width('100%')
+      .margin({ top: 8 })
+    }
+    .width('100%')
+    .height('100%')
+    .padding(24)
+  }
+}
diff --git a/entry/src/main/ets/ui/slides/WelcomeSlide.ets b/entry/src/main/ets/ui/slides/WelcomeSlide.ets
new file mode 100644
index 0000000..aa4b0f5
--- /dev/null
