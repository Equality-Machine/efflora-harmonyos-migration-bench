new file mode 100644
index 0000000..8a8fe9a
--- /dev/null
+++ b/entry/src/main/ets/importers/GoogleAuthUriImporter.ets
@@ -0,0 +1,80 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { GoogleAuthInfo } from '../otp/GoogleAuthInfo';
+import { VaultEntry } from '../vault/VaultEntry';
+import { Bytes } from '../util/Bytes';
+
+export class GoogleAuthUriImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    throw new DatabaseImporterException('Unsupported operation');
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    return GoogleAuthUriImporter.readLines(stream);
+  }
+
+  /**
+   * Synchronous variant of read(), also used by other importers that wrap this one.
+   */
+  static readLines(stream: Uint8Array): GoogleAuthUriImporterState {
+    const lines: string[] = [];
+    let text: string;
+    try {
+      text = Bytes.toUtf8(stream);
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    // same line terminators as BufferedReader.readLine(): \n, \r or \r\n
+    for (const line of text.split(new RegExp('\\r\\n|\\r|\\n'))) {
+      if (line.length > 0) {
+        lines.push(line);
+      }
+    }
+    return new GoogleAuthUriImporterState(lines);
+  }
+}
+
+export class GoogleAuthUriImporterState extends DatabaseImporterState {
+  private _lines: string[];
+
+  constructor(lines: string[]) {
+    super(false);
+    this._lines = lines;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    for (const line of this._lines) {
+      try {
+        const entry = GoogleAuthUriImporterState.convertEntry(line);
+        result.addEntry(entry);
+      }
+      catch (e) {
+        if (e instanceof DatabaseImporterEntryException) {
+          result.addError(e);
+        }
+        else {
+          throw e as Error;
+        }
+      }
+    }
+    return result;
+  }
+
+  private static convertEntry(line: string): VaultEntry {
+    try {
+      const info = GoogleAuthInfo.parseUri(line);
+      return VaultEntry.fromGoogleAuthInfo(info);
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, line);
+    }
+  }
+}
