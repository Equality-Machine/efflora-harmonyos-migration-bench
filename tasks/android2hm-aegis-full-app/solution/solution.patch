+import { IconPack, IconPackIcon } from '../../icons/IconPack';
+import { IconType } from '../../icons/IconType';
+import { AegisModule } from '../../AegisModule';
+import { ResUtils } from '../../util/ResUtils';
+
+/**
+ * Replacement for IconAdapter.Listener.
+ */
+export class IconAdapterListener {
+  private readonly _onIconSelected: (icon: IconPackIcon) => void;
+  private readonly _onCustomSelected: () => void;
+
+  constructor(onIconSelected: (icon: IconPackIcon) => void, onCustomSelected: () => void) {
+    this._onIconSelected = onIconSelected;
+    this._onCustomSelected = onCustomSelected;
+  }
+
+  onIconSelected(icon: IconPackIcon): void {
+    this._onIconSelected(icon);
+  }
+
+  onCustomSelected(): void {
+    this._onCustomSelected();
+  }
+}
+
+/**
+ * Port of IconAdapter.DummyIcon: the "Custom" entry in the suggested icons category.
+ */
+export class IconAdapterDummyIcon extends IconPackIcon {
+  constructor(name: string) {
+    super(name, null, null, []);
+  }
+
+  getName(): string {
+    return this.getRelativeFilename();
+  }
+
+  getIconType(): IconType {
+    return IconType.INVALID;
+  }
+}
+
+/**
+ * Port of IconAdapter.CategoryHeader.
+ */
+export class IconAdapterCategoryHeader {
+  private readonly _category: string;
+  private _position: number = -1;
+  private readonly _icons: IconPackIcon[];
+  private _collapsed: boolean = true;
+
+  constructor(category: string) {
+    this._category = category;
+    this._icons = [];
+  }
+
+  getCategory(): string {
+    return this._category;
+  }
+
+  getPosition(): number {
+    return this._position;
+  }
+
+  setPosition(position: number): void {
+    this._position = position;
+  }
+
+  getIcons(): IconPackIcon[] {
+    return this._icons;
+  }
+
+  isCollapsed(): boolean {
+    return this._collapsed;
+  }
+
+  setIsCollapsed(collapsed: boolean): void {
+    this._collapsed = collapsed;
+  }
+}
+
+export const VIEW_TYPE_ICON: number = 0;
+export const VIEW_TYPE_CATEGORY: number = 1;
+
+/**
+ * Port of IconAdapter: the data of the icon grid of the IconPickerDialog. The items are either
+ * category headers or icons; collapsed categories don't contribute their icons.
+ */
+export class IconAdapter {
+  private readonly _issuer: string;
+  private readonly _listener: IconAdapterListener;
+  private _pack: IconPack | null = null;
+  private _icons: IconPackIcon[];
+  private readonly _categories: IconAdapterCategoryHeader[];
+  private _query: string | null = null;
+  private _observers: Array<() => void> = [];
+
+  constructor(issuer: string, listener: IconAdapterListener) {
+    this._issuer = issuer;
+    this._listener = listener;
+    this._icons = [];
+    this._categories = [];
+  }
+
+  /**
+   * Registers a callback that is invoked whenever the data set of this adapter changes.
+   */
+  registerObserver(observer: () => void): void {
+    this._observers.push(observer);
+  }
+
+  unregisterObserver(observer: () => void): void {
+    this._observers = this._observers.filter((o: () => void) => o !== observer);
+  }
+
+  notifyDataSetChanged(): void {
+    for (const observer of this._observers) {
+      observer();
+    }
+  }
+
+  getListener(): IconAdapterListener {
+    return this._listener;
+  }
+
+  getPack(): IconPack | null {
+    return this._pack;
+  }
+
+  /**
+   * Loads all icons from the given icon pack into this adapter. Any icons added before this call will be overwritten.
+   */
+  loadIcons(pack: IconPack, showAddCustom: boolean): void {
+    this._pack = pack;
+    this._query = null;
+    this._icons = pack.getIcons();
+    this._categories.length = 0;
+
+    this._icons.sort((i1: IconPackIcon, i2: IconPackIcon) => {
+      const c1 = this.getCategoryString(i1.getCategory());
+      const c2 = this.getCategoryString(i2.getCategory());
+      const res = IconAdapter.compareStrings(c1, c2);
+      return res !== 0 ? res : IconAdapter.compareStrings(i1.getName(), i2.getName());
+    });
+
+    const distinctCategories = new Set<string>();
+    for (const icon of this._icons) {
+      const c = icon.getCategory();
+      if (c !== null) {
+        distinctCategories.add(c);
+      }
+    }
+    const categoryCount = distinctCategories.size;
+
+    const suggested = pack.getSuggestedIcons(this._issuer);
+
+    if (showAddCustom) {
+      suggested.unshift(new IconAdapterDummyIcon(ResUtils.getString(AegisModule.getContext(), 'icon_custom')));
+    }
+
+    if (suggested.length > 0) {
+      const category = new IconAdapterCategoryHeader(ResUtils.getString(AegisModule.getContext(), 'suggested'));
+      category.setIsCollapsed(false);
+      for (const icon of suggested) {
+        category.getIcons().push(icon);
+      }
+      this._categories.push(category);
+    }
+
+    let category: IconAdapterCategoryHeader | null = null;
+    for (const icon of this._icons) {
+      const iconCategory = this.getCategoryString(icon.getCategory());
+      if (category === null || this.getCategoryString(category.getCategory()) !== iconCategory) {
+        const collapsed = !(categoryCount === 0 && category === null);
+        category = new IconAdapterCategoryHeader(iconCategory);
+        category.setIsCollapsed(collapsed);
+        this._categories.push(category);
+      }
+
+      category.getIcons().push(icon);
+    }
+
+    this._icons = suggested.concat(this._icons);
+    this.updateCategoryPositions();
+    this.notifyDataSetChanged();
+  }
+
+  setQuery(query: string | null): void {
+    this._query = query;
+
+    if (this._query === null) {
+      if (this._pack !== null) {
+        this.loadIcons(this._pack, false);
+      }
+    } else {
+      this._icons = this._pack !== null ? this._pack.getSuggestedIcons(query) : [];
+      this.notifyDataSetChanged();
+    }
+  }
+
+  getIconAt(position: number): IconPackIcon {
+    if (this.isQueryActive()) {
+      return this._icons[position];
+    }
+
+    return this._icons[this.translateIconPosition(position)];
+  }
+
+  getCategoryAt(position: number): IconAdapterCategoryHeader | null {
+    const category = this._categories.find((c: IconAdapterCategoryHeader) => c.getPosition() === position);
+    return category !== undefined ? category : null;
+  }
+
+  private getCategoryString(category: string | null): string {
+    return category === null ? ResUtils.getString(AegisModule.getContext(), 'uncategorized') : category;
+  }
+
+  isCategoryPosition(position: number): boolean {
+    if (this.isQueryActive()) {
+      return false;
+    }
+
+    return this.getCategoryAt(position) !== null;
+  }
+
+  private translateIconPosition(position: number): number {
+    let offset = 0;
+    for (const category of this._categories) {
+      if (category.getPosition() < position) {
+        offset++;
+        if (category.isCollapsed()) {
+          offset -= category.getIcons().length;
+        }
+      }
+    }
+
+    return position - offset;
+  }
+
+  private updateCategoryPositions(): void {
+    let i = 0;
+    for (const category of this._categories) {
+      category.setPosition(i);
+
+      let icons = 0;
+      if (!category.isCollapsed()) {
+        icons = category.getIcons().length;
+      }
+
+      i += 1 + icons;
+    }
+  }
+
+  /**
+   * Port of the click listener in onBindViewHolder.
+   */
+  onIconClick(icon: IconPackIcon): void {
+    if (icon instanceof IconAdapterDummyIcon) {
+      this._listener.onCustomSelected();
+    } else {
+      this._listener.onIconSelected(icon);
+    }
+  }
+
+  /**
+   * Port of the click listener of a category header in onBindViewHolder.
+   */
+  onCategoryClick(category: IconAdapterCategoryHeader): void {
+    const collapsed = !category.isCollapsed();
+    category.setIsCollapsed(collapsed);
+    this.updateCategoryPositions();
+    this.notifyDataSetChanged();
+  }
+
+  getItemCount(): number {
+    if (this.isQueryActive()) {
+      return this._icons.length;
+    }
+
+    let items = 0;
+    for (const c of this._categories) {
+      if (!c.isCollapsed()) {
+        items += c.getIcons().length;
+      }
+    }
+
+    return items + this._categories.length;
+  }
+
+  getItemViewType(position: number): number {
+    if (this.isCategoryPosition(position)) {
+      return VIEW_TYPE_CATEGORY;
+    }
+
+    return VIEW_TYPE_ICON;
+  }
+
+  private isQueryActive(): boolean {
+    return this._query !== null;
+  }
+
+  private static compareStrings(a: string, b: string): number {
+    return a < b ? -1 : (a > b ? 1 : 0);
+  }
+}
