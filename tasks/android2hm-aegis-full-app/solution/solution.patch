+
+  clearUsageCount(): void {
+    this.remove('pref_usage_count');
+  }
+
+  getLastUsedTimestamps(): Map<string, number> {
+    const lastUsedTimestamps = new Map<string, number>();
+    const raw = this.getRawString('pref_last_used_timestamps', '');
+    try {
+      const arr = new JSONArray(raw);
+      for (let i = 0; i < arr.length(); i++) {
+        const json = arr.getJSONObject(i);
+        lastUsedTimestamps.set(json.getString('uuid'), json.getLong('timestamp'));
+      }
+    } catch (ignored) {
+    }
+    return lastUsedTimestamps;
+  }
+
+  setLastUsedTimestamps(lastUsedTimestamps: Map<string, number>): void {
+    const arr = new JSONArray();
+    lastUsedTimestamps.forEach((value: number, key: string) => {
+      const entryJson = new JSONObject();
+      entryJson.put('uuid', key);
+      entryJson.put('timestamp', value);
+      arr.put(entryJson);
+    });
+    this.putRawString('pref_last_used_timestamps', arr.toString());
+  }
+
+  getUsageCounts(): Map<string, number> {
+    const usageCounts = new Map<string, number>();
+    const raw = this.getRawString('pref_usage_count', '');
+    try {
+      const arr = new JSONArray(raw);
+      for (let i = 0; i < arr.length(); i++) {
+        const json = arr.getJSONObject(i);
+        usageCounts.set(json.getString('uuid'), json.getInt('count'));
+      }
+    } catch (ignored) {
+    }
+    return usageCounts;
+  }
+
+  setUsageCount(usageCounts: Map<string, number>): void {
+    const arr = new JSONArray();
+    usageCounts.forEach((value: number, key: string) => {
+      const entryJson = new JSONObject();
+      entryJson.put('uuid', key);
+      entryJson.put('count', value);
+      arr.put(entryJson);
+    });
+    this.putRawString('pref_usage_count', arr.toString());
+  }
