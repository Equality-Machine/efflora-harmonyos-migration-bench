@@ -0,0 +1,73 @@
+import { OtpInfo } from './OtpInfo';
+import { OtpInfoException } from './OtpInfoException';
+import { TOTP } from '../crypto/otp/TOTP';
+import { JSONObject } from '../util/JSONObject';
+
+export class TotpInfo extends OtpInfo {
+  static readonly ID: string = 'totp';
+  static readonly DEFAULT_PERIOD: number = 30;
+
+  private _period: number = TotpInfo.DEFAULT_PERIOD;
+
+  constructor(secret: Uint8Array | null, algorithm?: string, digits?: number, period?: number) {
+    super(secret === null ? new Uint8Array(0) : secret, algorithm, digits);
+    this.setPeriod(period !== undefined ? period : TotpInfo.DEFAULT_PERIOD);
+  }
+
+  getOtp(time?: number): string {
+    this.checkSecret();
+    const t = time !== undefined ? time : Math.floor(Date.now() / 1000);
+    const otp = TOTP.generateOTP(this.getSecret(), this.getAlgorithm(true), this.getDigits(), this.getPeriod(), t);
+    return otp.toString();
+  }
+
+  getTypeId(): string {
+    return TotpInfo.ID;
+  }
+
+  toJson(): JSONObject {
+    const obj = super.toJson();
+    obj.put('period', this.getPeriod());
+    return obj;
+  }
+
+  getPeriod(): number {
+    return this._period;
+  }
+
+  static isPeriodValid(period: number): boolean {
+    if (!Number.isInteger(period) || period <= 0) {
+      return false;
+    }
+    // check for the possibility of an overflow when converting to milliseconds
+    return period <= Math.floor(2147483647 / 1000);
+  }
+
+  setPeriod(period: number): void {
+    if (!TotpInfo.isPeriodValid(period)) {
+      throw new OtpInfoException(`bad period: ${period}`);
+    }
+    this._period = period;
+  }
+
+  getMillisTillNextRotation(): number {
+    return TotpInfo.getMillisTillNextRotation(this._period);
+  }
+
+  static getMillisTillNextRotation(period: number): number {
+    const p = period * 1000;
+    return p - (Date.now() % p);
+  }
+
+  equals(o: Object | null): boolean {
+    if (!(o instanceof TotpInfo)) {
+      return false;
+    }
+    const info = o as TotpInfo;
+    return super.equals(o) && this.getPeriod() === info.getPeriod();
+  }
+}
+
+OtpInfo.registerFactory(TotpInfo.ID, (type: string, secret: Uint8Array, algo: string, digits: number, obj: JSONObject): OtpInfo => {
+  return new TotpInfo(secret, algo, digits, obj.getInt('period'));
+});
