+import { ColorGenerator } from '../textdrawable/util/ColorGenerator';
+
+export class TextDrawableInfo {
+  text: string;
+  color: number;
+
+  constructor(text: string, color: number) {
+    this.text = text;
+    this.color = color;
+  }
+}
+
+export class TextDrawableHelper {
+  // taken from: https://materialuicolors.co (level 700)
+  private static _generator: ColorGenerator = ColorGenerator.create([
+    0xFFD32F2F, 0xFFC2185B, 0xFF7B1FA2, 0xFF512DA8, 0xFF303F9F, 0xFF1976D2, 0xFF0288D1, 0xFF0097A7, 0xFF00796B,
+    0xFF388E3C, 0xFF689F38, 0xFFAFB42B, 0xFFFBC02D, 0xFFFFA000, 0xFFF57C00, 0xFFE64A19, 0xFF5D4037, 0xFF616161,
+    0xFF455A64
+  ]);
+
+  private constructor() {
+  }
+
+  /**
+   * Returns the letter and color of the TextDrawable for the given text, or null if both the text
+   * and fallback are empty.
+   */
+  static generate(text: string | null, fallback: string | null): TextDrawableInfo | null {
+    let t = text;
+    if (t === null || t.length === 0) {
+      if (fallback === null || fallback.length === 0) {
+        return null;
+      }
+      t = fallback;
+    }
+    const color = TextDrawableHelper._generator.getColor(t);
+    return new TextDrawableInfo(TextDrawableHelper.getFirstGrapheme(t).toUpperCase(), color);
+  }
+
+  private static getFirstGrapheme(text: string): string {
+    const cp = text.codePointAt(0);
+    if (cp === undefined) {
+      return '';
+    }
+    return String.fromCodePoint(cp);
+  }
+}
diff --git a/entry/src/main/ets/helpers/ThemeHelper.ets b/entry/src/main/ets/helpers/ThemeHelper.ets
new file mode 100644
index 0000000..6250173
--- /dev/null
+++ b/entry/src/main/ets/helpers/ThemeHelper.ets
@@ -0,0 +1,80 @@
+import { common, ConfigurationConstant } from '@kit.AbilityKit';
+import { resourceManager } from '@kit.LocalizationKit';
+import { Preferences } from '../Preferences';
+import { Theme } from '../Theme';
+import { ThemeMap } from '../ThemeMap';
+
+export const AMOLED_KEY: string = 'aegis_amoled';
+
+/**
+ * Applies the theme selected in the preferences by switching the color mode of the application.
+ * The AMOLED variants use the dark color mode with a pure black background.
+ */
+export class ThemeHelper {
+  private _context: common.Context;
+  private _prefs: Preferences;
+
+  constructor(context: common.Context, prefs: Preferences) {
+    this._context = context;
+    this._prefs = prefs;
+  }
+
+  setTheme(themeMap: Map<Theme, string>): void {
+    const theme = this.getConfiguredTheme();
+    let mode = ConfigurationConstant.ColorMode.COLOR_MODE_NOT_SET;
+    if (theme === Theme.LIGHT) {
+      mode = ConfigurationConstant.ColorMode.COLOR_MODE_LIGHT;
+    } else if (theme === Theme.DARK || theme === Theme.AMOLED) {
+      mode = ConfigurationConstant.ColorMode.COLOR_MODE_DARK;
+    }
+    try {
+      this._context.getApplicationContext().setColorMode(mode);
+    } catch (e) {
+      // ignore
+    }
+    const style = themeMap.get(theme);
+    AppStorage.setOrCreate<string>('aegis_theme_style', style !== undefined ? style : '');
+    AppStorage.setOrCreate<boolean>(AMOLED_KEY, theme === Theme.AMOLED ||
+      (theme === Theme.SYSTEM_AMOLED && ThemeHelper.isSystemDark(this._context)));
+  }
+
+  applyDefault(): void {
+    this.setTheme(ThemeMap.DEFAULT);
+  }
+
+  getConfiguredTheme(): Theme {
+    const theme = this._prefs.getCurrentTheme();
+    if (theme === Theme.SYSTEM || theme === Theme.SYSTEM_AMOLED) {
+      if (ThemeHelper.isSystemDark(this._context)) {
+        return theme === Theme.SYSTEM_AMOLED ? Theme.AMOLED : Theme.DARK;
+      }
+      return Theme.LIGHT;
+    }
+    return theme;
+  }
+
+  static isSystemDark(context: common.Context): boolean {
+    try {
+      return context.resourceManager.getConfigurationSync().colorMode === resourceManager.ColorMode.DARK;
+    } catch (e) {
+      return false;
+    }
+  }
+
+  static isAmoled(): boolean {
+    const v = AppStorage.get<boolean>(AMOLED_KEY);
+    return v === true;
+  }
+
+  static getBackgroundColor(): ResourceColor {
+    return ThemeHelper.isAmoled() ? '#000000' : $r('app.color.theme_background');
+  }
+
+  static getSurfaceColor(): ResourceColor {
+    return ThemeHelper.isAmoled() ? '#0F0F0F' : $r('app.color.theme_surfaceContainerLow');
+  }
+
+  static getCardColor(): ResourceColor {
+    return ThemeHelper.isAmoled() ? '#141414' : $r('app.color.theme_surfaceContainer');
+  }
+}
diff --git a/entry/src/main/ets/helpers/UiRefresher.ets b/entry/src/main/ets/helpers/UiRefresher.ets
new file mode 100644
index 0000000..f53409e
--- /dev/null
+++ b/entry/src/main/ets/helpers/UiRefresher.ets
@@ -0,0 +1,90 @@
+import { VibrationPatterns } from '../VibrationPatterns';
+
+export interface UiRefresherListener {
+  onRefresh(): void;
+
+  onExpiring(): void;
+
+  getMillisTillNextRefresh(): number;
+
+  getPeriodMillis(): number;
+}
+
+/**
+ * Port of UiRefresher: calls onRefresh() whenever the codes rotate and onExpiring() shortly before.
+ */
+export class UiRefresher {
+  private _running: boolean = false;
+  private _listener: UiRefresherListener | null;
+  private _refreshTimer: number = -1;
+  private _expiringTimer: number = -1;
+
+  constructor(listener: UiRefresherListener) {
+    this._listener = listener;
+  }
+
+  destroy(): void {
+    this.stop();
+    this._listener = null;
+  }
+
+  isRunning(): boolean {
+    return this._running;
+  }
+
+  start(): void {
+    if (this._running || this._listener === null) {
+      return;
+    }
+    this._running = true;
+    this.scheduleRefresh(this._listener.getMillisTillNextRefresh());
+    this.scheduleExpiring(this.getInitialRun());
+  }
+
+  private scheduleRefresh(delay: number): void {
+    this._refreshTimer = setTimeout(() => {
+      if (!this._running || this._listener === null) {
+        return;
+      }
+      this._listener.onRefresh();
+      this.scheduleRefresh(this._listener.getMillisTillNextRefresh());
+    }, Math.max(delay, 1));
+  }
+
+  private scheduleExpiring(delay: number): void {
+    this._expiringTimer = setTimeout(() => {
+      if (!this._running || this._listener === null) {
+        return;
+      }
+      this._listener.onExpiring();
+      this.scheduleExpiring(this.getNextRun());
+    }, Math.max(delay, 1));
+  }
+
+  private getInitialRun(): number {
+    const listener = this._listener as UiRefresherListener;
+    const sum = listener.getMillisTillNextRefresh() - VibrationPatterns.getLengthInMillis(VibrationPatterns.EXPIRING);
+    if (sum < 0) {
+      return this.getNextRun();
+    }
+    return sum;
+  }
+
+  private getNextRun(): number {
+    const listener = this._listener as UiRefresherListener;
+    return (listener.getMillisTillNextRefresh() + listener.getPeriodMillis())
+      - VibrationPatterns.getLengthInMillis(VibrationPatterns.EXPIRING);
+  }
+
+  stop(): void {
+    if (this._refreshTimer >= 0) {
+      clearTimeout(this._refreshTimer);
+      this._refreshTimer = -1;
+    }
+    if (this._expiringTimer >= 0) {
+      clearTimeout(this._expiringTimer);
+      this._expiringTimer = -1;
+    }
+    this._running = false;
+  }
+}
