+  private updateErrorCard(): void {
+    let info: ErrorCardInfo | null = null;
+    const prefs = this._activity.getPreferences();
+
+    const backupRes = prefs.getErroredBackupResult();
+    if (backupRes !== null) {
+      info = new ErrorCardInfo(this._activity.getString('backup_error_bar_message'), () => {
+        Dialogs.showBackupErrorDialog(this.getUIContext(), backupRes, () => {
+          this.startPreferencesActivity(PAGE_PREFS_BACKUPS, 'pref_backups');
+        });
+      });
+    } else if (prefs.isBackupsReminderNeeded() && prefs.isBackupReminderEnabled()) {
+      let text: string;
+      const date = prefs.getLatestBackupOrExportTime();
+      if (date !== null) {
+        text = this._activity.getString('backup_reminder_bar_message_with_latest',
+          [TimeUtils.getElapsedSince(AegisModule.getContext(), date)]);
+      } else {
+        text = this._activity.getString('backup_reminder_bar_message');
+      }
+      info = new ErrorCardInfo(text, () => {
+        Dialogs.showSimpleDialog(this.getUIContext(), $r('app.string.backup_reminder_bar_dialog_title'),
+          $r('app.string.backup_reminder_bar_dialog_summary'),
+          $r('app.string.backup_reminder_bar_dialog_accept'), () => {
+            this.startPreferencesActivity(PAGE_PREFS_BACKUPS, 'pref_backups');
+          }, $r('app.string.cancel'), null, undefined, undefined, true);
+      });
+    } else if (prefs.isPlaintextBackupWarningNeeded()) {
+      info = new ErrorCardInfo(this._activity.getString('backup_plaintext_export_warning'),
+        () => this.showPlaintextExportWarningOptions());
+    }
+
+    this._entryListView.setErrorCardInfo(info);
