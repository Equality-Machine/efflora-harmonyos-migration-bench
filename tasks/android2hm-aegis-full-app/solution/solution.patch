diff --git a/entry/src/main/ets/ui/preferences/PreferenceScreenView.ets b/entry/src/main/ets/ui/preferences/PreferenceScreenView.ets
new file mode 100644
index 0000000..fbeee5b
--- /dev/null
+++ b/entry/src/main/ets/ui/preferences/PreferenceScreenView.ets
@@ -0,0 +1,198 @@
+import { Preference, PreferenceScreen } from './Preference';
+
+/**
+ * Header row of a PreferenceCategory.
+ */
+@Component
+export struct PreferenceCategoryView {
+  @Prop title: ResourceStr = '';
+  @Prop iconSpaceReserved: boolean = false;
+
+  build() {
+    Text(this.title)
+      .fontSize(14)
+      .fontWeight(FontWeight.Medium)
+      .fontColor($r('app.color.theme_primary'))
+      .width('100%')
+      .padding({ left: this.iconSpaceReserved ? 72 : 16, right: 16, top: 24, bottom: 8 })
+  }
+}
+
+/**
+ * A regular preference row (title, summary, optional icon and optional switch).
+ */
+@Component
+export struct PreferenceView {
+  @Prop title: ResourceStr = '';
+  @Prop summary: ResourceStr = '';
+  @Prop prefEnabled: boolean = true;
+  @Prop selectable: boolean = true;
+  @Prop highlighted: boolean = false;
+  @Prop isSwitch: boolean = false;
+  @Prop checked: boolean = false;
+  @Prop summaryBold: boolean = false;
+  @Prop iconSpaceReserved: boolean = true;
+  @Prop hasSummaryColor: boolean = false;
+  @Prop hasIcon: boolean = false;
+  summaryColor: ResourceColor = $r('app.color.theme_onSurfaceVariant');
+  icon: Resource = $r('app.media.ic_outline_info_24');
+  onPreferenceClick: () => void = () => {
+  };
+
+  build() {
+    Row() {
+      if (this.hasIcon) {
+        Image(this.icon)
+          .width(24)
+          .height(24)
+          .fillColor($r('app.color.theme_onSurfaceVariant'))
+          .margin({ left: 16, right: 32 })
+      } else if (this.iconSpaceReserved) {
+        Blank()
+          .width(72)
+          .layoutWeight(0)
+      } else {
+        Blank()
+          .width(16)
+          .layoutWeight(0)
+      }
+      Column() {
+        if (this.title !== '') {
+          Text(this.title)
+            .fontSize(16)
+            .fontColor($r('app.color.theme_onSurface'))
+            .width('100%')
+        }
+        if (this.summary !== '') {
+          Text(this.summary)
+            .fontSize(14)
+            .fontWeight(this.summaryBold ? FontWeight.Bold : FontWeight.Normal)
+            .fontColor(this.hasSummaryColor ? this.summaryColor : $r('app.color.theme_onSurfaceVariant'))
+            .width('100%')
+            .margin({ top: this.title !== '' ? 2 : 0 })
+        }
+      }
+      .layoutWeight(1)
+      .alignItems(HorizontalAlign.Start)
+      .padding({ top: 16, bottom: 16 })
+
+      if (this.isSwitch) {
+        Toggle({ type: ToggleType.Switch, isOn: this.checked })
+          .hitTestBehavior(HitTestMode.None)
+          .enabled(this.prefEnabled)
+          .selectedColor($r('app.color.theme_primary'))
+          .margin({ left: 16, right: 16 })
+      } else {
+        Blank()
+          .width(16)
+          .layoutWeight(0)
+      }
+    }
+    .width('100%')
+    .opacity(this.prefEnabled ? 1 : 0.38)
+    .backgroundColor(this.highlighted ? $r('app.color.theme_secondaryContainer') : Color.Transparent)
+    .animation({ duration: 300 })
+    .onClick(() => {
+      if (this.prefEnabled && this.selectable) {
+        this.onPreferenceClick();
+      }
+    })
+  }
+}
+
+/**
+ * Renders a PreferenceScreen (replacement for the RecyclerView of PreferenceFragmentCompat).
+ * The parent page passes a tick that is incremented every time the screen model changes.
+ */
+@Component
+export struct PreferenceScreenView {
+  /**
+   * Returns the current screen of the page (the screen is replaced when the page is recreated).
+   */
+  screenProvider: () => PreferenceScreen = () => new PreferenceScreen('', []);
+  @Prop @Watch('onTickChanged') tick: number = 0;
+  private _scroller: Scroller = new Scroller();
+
+  aboutToAppear(): void {
+    this.handleScrollRequest();
+  }
+
+  onTickChanged(): void {
+    this.handleScrollRequest();
+  }
+
+  private handleScrollRequest(): void {
+    const key = this.screenProvider().consumeScrollRequest();
+    if (key === null) {
+      return;
+    }
+    const rows = this.screenProvider().getVisibleRows();
+    let index = -1;
+    for (let i = 0; i < rows.length; i++) {
+      if (rows[i].getKey() === key) {
+        index = i;
+        break;
+      }
+    }
+    if (index >= 0) {
+      setTimeout(() => {
+        this._scroller.scrollToIndex(index, true, ScrollAlign.CENTER);
+      }, 100);
+    }
+  }
+
+  private getRows(tick: number): Preference[] {
+    return this.screenProvider().getVisibleRows();
+  }
+
+  private isHighlighted(pref: Preference): boolean {
+    return this.screenProvider().getHighlightKey() === pref.getKey();
+  }
+
+  private getSummaryColor(pref: Preference): ResourceColor {
+    const color = pref.getSummaryColor();
+    return color !== null ? color : $r('app.color.theme_onSurfaceVariant');
+  }
+
+  private getIcon(pref: Preference): Resource {
+    const icon = pref.getIcon();
+    return icon !== null ? icon : $r('app.media.ic_outline_info_24');
+  }
+
+  build() {
+    List({ scroller: this._scroller }) {
+      ForEach(this.getRows(this.tick), (pref: Preference) => {
+        ListItem() {
+          if (pref.isCategory()) {
+            PreferenceCategoryView({ title: pref.getTitle(), iconSpaceReserved: pref.isIconSpaceReserved() })
+          } else {
+            PreferenceView({
+              title: pref.getTitle(),
+              summary: pref.getSummary(),
+              prefEnabled: pref.isEnabled(),
+              selectable: pref.isSelectable(),
+              highlighted: this.isHighlighted(pref),
+              isSwitch: pref.isSwitch(),
+              checked: pref.isChecked(),
+              summaryBold: pref.isSummaryBold(),
+              hasSummaryColor: pref.getSummaryColor() !== null,
+              summaryColor: this.getSummaryColor(pref),
+              iconSpaceReserved: pref.isIconSpaceReserved(),
+              hasIcon: pref.getIcon() !== null,
+              icon: this.getIcon(pref),
+              onPreferenceClick: () => pref.performClick()
+            })
+          }
+        }
+      }, (pref: Preference) => `${pref.getKey()}-${this.tick}`)
+      ListItem() {
+        Column()
+          .height(32)
+      }
+    }
+    .width('100%')
+    .layoutWeight(1)
+    .edgeEffect(EdgeEffect.Spring)
+    .scrollBar(BarState.Auto)
+  }
+}
diff --git a/entry/src/main/ets/ui/preferences/SwitchPreference.ets b/entry/src/main/ets/ui/preferences/SwitchPreference.ets
