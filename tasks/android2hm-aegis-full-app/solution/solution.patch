+  private onImagePicked(uri: string | null): void {
+    if (uri === null || uri.length === 0) {
+      return;
+    }
+
+    let bytes: Uint8Array;
+    try {
+      bytes = IOUtils.readFile(uri);
+    } catch (e) {
+      Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.reading_file_error'), e as Error);
+      return;
+    }
+
+    this._pickedMimeType = EditEntryActivity.getMimeType(uri, bytes);
+    if (this._pickedMimeType !== null && this._pickedMimeType === IconTypeUtils.toMimeType(IconType.SVG)) {
+      try {
+        const dir = `${AegisModule.getContext().cacheDir}/icons`;
+        IOUtils.mkdirs(dir);
+        const file = `${dir}/icon-${Date.now()}.svg`;
+        IOUtils.writeFile(file, bytes);
+        const icon = new EditEntryActivityCustomSvgIcon(file);
+        this.selectIcon(icon);
+      } catch (e) {
+        Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.reading_file_error'), e as Error);
+      }
+    } else {
+      this.startEditingIcon(bytes);
+    }
+  }
+
+  /**
+   * Port of SafHelper.getMimeType: determines the MIME type by the file name, or by the contents of the file.
+   */
+  private static getMimeType(uri: string, bytes: Uint8Array): string | null {
+    const type = IconTypeUtils.fromFilename(IOUtils.getFileName(uri));
+    if (type !== IconType.INVALID) {
+      return IconTypeUtils.toMimeType(type);
+    }
+    const name = IOUtils.getFileName(uri).toLowerCase();
+    if (name.endsWith('.webp')) {
+      return 'image/webp';
+    }
+    let source: image.ImageSource | null = null;
+    try {
+      source = image.createImageSource(BitmapHelper.toArrayBuffer(bytes));
+      const mime = source.getImageInfoSync().mimeType;
+      return mime !== undefined && mime.length > 0 ? mime : null;
+    } catch (e) {
+      // sniff SVG files
+      const head = new Uint8Array(bytes.subarray(0, Math.min(bytes.length, 512)));
+      let text = '';
+      for (let i = 0; i < head.length; i++) {
+        text += String.fromCharCode(head[i]);
+      }
+      return text.indexOf('<svg') >= 0 ? IconTypeUtils.toMimeType(IconType.SVG) : null;
+    } finally {
+      if (source !== null) {
+        source.release();
+      }
+    }
+  }
