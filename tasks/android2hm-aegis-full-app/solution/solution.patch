+        this._pos = end + 3;
+        continue;
+      }
+      if (this._src.startsWith('<?', this._pos)) {
+        const end = this._src.indexOf('?>', this._pos + 2);
+        if (end < 0) {
+          throw new XmlPullParserException('Unterminated processing instruction');
+        }
