+
+  static readonly PERIOD: number = 10;
+  static readonly DIGITS: number = 6;
+
+  private _pin: string | null = null;
+
+  constructor(secret: Uint8Array, pin?: string | null) {
+    super(secret, MotpInfo.ALGORITHM, MotpInfo.DIGITS, MotpInfo.PERIOD);
+    this._pin = pin === undefined ? null : pin;
+  }
+
+  getOtp(time?: number): string {
+    if (this._pin === null) {
+      throw new Error('PIN must be set before generating an OTP');
+    }
+    const t = time !== undefined ? time : Math.floor(Date.now() / 1000);
+    const otp = MOTP.generateOTP(this.getSecret(), this.getAlgorithm(false), this.getDigits(), this.getPeriod(), this._pin, t);
+    return otp.toString();
+  }
+
+  getTypeId(): string {
+    return MotpInfo.ID;
+  }
+
+  toJson(): JSONObject {
+    const result = super.toJson();
+    result.put('pin', this.getPin());
+    return result;
+  }
+
+  getPin(): string | null {
+    return this._pin;
+  }
+
+  setPin(pin: string): void {
+    this._pin = pin;
+  }
+
+  equals(o: Object | null): boolean {
+    if (!(o instanceof MotpInfo)) {
+      return false;
+    }
+    const info = o as MotpInfo;
+    return super.equals(o) && this.getPin() === info.getPin();
+  }
+}
+
+OtpInfo.registerFactory(MotpInfo.ID, (type: string, secret: Uint8Array, algo: string, digits: number, obj: JSONObject): OtpInfo => {
+  return new MotpInfo(secret, obj.getString('pin'));
+});
diff --git a/entry/src/main/ets/otp/OtpInfo.ets b/entry/src/main/ets/otp/OtpInfo.ets
new file mode 100644
index 0000000..f523351
--- /dev/null
+++ b/entry/src/main/ets/otp/OtpInfo.ets
@@ -0,0 +1,151 @@
+import { Base32 } from '../encoding/Base32';
+import { JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+import { OtpInfoException } from './OtpInfoException';
+
+export type OtpInfoFactory = (type: string, secret: Uint8Array, algo: string, digits: number, obj: JSONObject) => OtpInfo;
+
+export abstract class OtpInfo {
+  static readonly DEFAULT_DIGITS: number = 6;
+  static readonly DEFAULT_ALGORITHM: string = 'SHA1';
+
+  private static _factories: Map<string, OtpInfoFactory> = new Map<string, OtpInfoFactory>();
+
+  private _secret: Uint8Array = new Uint8Array(0);
+  private _algorithm: string = OtpInfo.DEFAULT_ALGORITHM;
+  private _digits: number = OtpInfo.DEFAULT_DIGITS;
+
+  constructor(secret: Uint8Array, algorithm?: string, digits?: number) {
+    this.setSecret(secret);
+    this.setAlgorithm(algorithm !== undefined ? algorithm : OtpInfo.DEFAULT_ALGORITHM);
+    this.setDigits(digits !== undefined ? digits : OtpInfo.DEFAULT_DIGITS);
+  }
+
+  /**
+   * Registers a factory for the given type ID. Subclasses register themselves when their module is
+   * loaded, which avoids a circular import between OtpInfo and its subclasses.
+   */
+  static registerFactory(type: string, factory: OtpInfoFactory): void {
+    OtpInfo._factories.set(type, factory);
+  }
+
+  abstract getOtp(time?: number): string;
+
+  protected checkSecret(): void {
+    if (this.getSecret().length === 0) {
+      throw new OtpInfoException('Secret is empty');
+    }
+  }
+
+  abstract getTypeId(): string;
+
+  getType(): string {
+    return this.getTypeId().toUpperCase();
+  }
+
+  toJson(): JSONObject {
+    const obj = new JSONObject();
+    obj.put('secret', Base32.encode(this.getSecret()));
+    obj.put('algo', this.getAlgorithm(false));
+    obj.put('digits', this.getDigits());
+    return obj;
+  }
+
+  getSecret(): Uint8Array {
+    return this._secret;
+  }
+
+  getAlgorithm(java: boolean): string {
+    if (java) {
+      return 'Hmac' + this._algorithm;
+    }
+    return this._algorithm;
+  }
+
+  getDigits(): number {
+    return this._digits;
+  }
+
+  setSecret(secret: Uint8Array): void {
+    this._secret = secret;
+  }
+
+  static isAlgorithmValid(algorithm: string): boolean {
+    return algorithm === 'SHA1' || algorithm === 'SHA256' || algorithm === 'SHA512' || algorithm === 'MD5';
+  }
+
+  setAlgorithm(algorithm: string): void {
+    let algo = algorithm;
+    if (algo.startsWith('Hmac')) {
+      algo = algo.substring(4);
+    }
+    algo = algo.toUpperCase();
+
+    if (!OtpInfo.isAlgorithmValid(algo)) {
+      throw new OtpInfoException(`unsupported algorithm: ${algo}`);
+    }
+    this._algorithm = algo;
+  }
+
+  static isDigitsValid(digits: number): boolean {
+    // allow a max of 10 digits, as truncation will only extract 31 bits
+    return Number.isInteger(digits) && digits > 0 && digits <= 10;
+  }
+
+  setDigits(digits: number): void {
+    if (!OtpInfo.isDigitsValid(digits)) {
+      throw new OtpInfoException(`unsupported amount of digits: ${digits}`);
+    }
+    this._digits = digits;
+  }
+
+  static fromJson(type: string, obj: JSONObject): OtpInfo {
+    let secret: Uint8Array;
+    let algo: string;
+    let digits: number;
+    try {
+      secret = Base32.decode(obj.getString('secret'));
+      algo = obj.getString('algo');
+      digits = obj.getInt('digits');
+    } catch (e) {
+      throw new OtpInfoException((e as Error).message);
+    }
+
+    // Special case to work around a bug where a user could accidentally
+    // set the hash algorithm of a non-mOTP entry to MD5
+    if (type !== 'motp' && algo === 'MD5') {
+      algo = OtpInfo.DEFAULT_ALGORITHM;
+    }
+
+    const factory = OtpInfo._factories.get(type);
+    if (factory === undefined) {
+      throw new OtpInfoException('unsupported otp type: ' + type);
+    }
+    try {
+      return factory(type, secret, algo, digits, obj);
+    } catch (e) {
+      if (e instanceof OtpInfoException) {
+        throw e as OtpInfoException;
+      }
+      throw new OtpInfoException((e as Error).message);
+    }
+  }
+
+  clone(): OtpInfo {
+    return OtpInfo.fromJson(this.getTypeId(), this.toJson());
+  }
+
+  equals(o: Object | null): boolean {
+    if (this === o) {
+      return true;
+    }
+    if (!(o instanceof OtpInfo)) {
+      return false;
+    }
+    const info = o as OtpInfo;
+    return this.getTypeId() === info.getTypeId()
+      && Bytes.equals(this.getSecret(), info.getSecret())
+      && this.getAlgorithm(false) === info.getAlgorithm(false)
+      && this.getDigits() === info.getDigits();
+  }
+}
