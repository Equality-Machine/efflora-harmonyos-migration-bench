@@ -0,0 +1,42 @@
+import { MasterKey } from '../crypto/MasterKey';
+import { CryptResult } from '../crypto/CryptResult';
+import { CryptParameters } from '../crypto/CryptParameters';
+import { SlotList } from './slots/SlotList';
+
+export class VaultFileCredentials {
+  private _key: MasterKey;
+  private _slots: SlotList;
+
+  constructor(key?: MasterKey, slots?: SlotList) {
+    this._key = key !== undefined ? key : MasterKey.generate();
+    this._slots = slots !== undefined ? slots : new SlotList();
+  }
+
+  encrypt(bytes: Uint8Array): CryptResult {
+    return this._key.encrypt(bytes);
+  }
+
+  decrypt(bytes: Uint8Array, params: CryptParameters): CryptResult {
+    return this._key.decrypt(bytes, params);
+  }
+
+  getKey(): MasterKey {
+    return this._key;
+  }
+
+  getSlots(): SlotList {
+    return this._slots;
+  }
+
+  /**
+   * Returns a copy of these VaultFileCredentials that is suitable for exporting.
+   * In case there's a backup password slot, any regular password slots are stripped.
+   */
+  exportable(): VaultFileCredentials {
+    return new VaultFileCredentials(this._key, this._slots.exportable());
+  }
+
+  clone(): VaultFileCredentials {
+    return new VaultFileCredentials(this._key, this._slots.clone());
+  }
+}
