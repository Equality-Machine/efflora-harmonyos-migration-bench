diff --git a/entry/src/main/ets/vault/slots/SlotList.ets b/entry/src/main/ets/vault/slots/SlotList.ets
new file mode 100644
index 0000000..54793cc
--- /dev/null
+++ b/entry/src/main/ets/vault/slots/SlotList.ets
@@ -0,0 +1,103 @@
+import { UUIDMap } from '../../util/UUIDMap';
+import { JSONArray } from '../../util/JSONObject';
+import { Slot } from './Slot';
+import { RawSlot } from './RawSlot';
+import { PasswordSlot } from './PasswordSlot';
+import { BiometricSlot } from './BiometricSlot';
+import { SlotListException } from './SlotListException';
+
+export class SlotList extends UUIDMap<Slot> {
+  toJson(): JSONArray {
+    const array = new JSONArray();
+    for (const slot of this.getValues()) {
+      array.put(slot.toJson());
+    }
+    return array;
+  }
+
+  static fromJson(array: JSONArray): SlotList {
+    const slots = new SlotList();
+    try {
+      for (let i = 0; i < array.length(); i++) {
+        const obj = array.getJSONObject(i);
+        const slot = Slot.fromJson(obj);
+        slots.add(slot);
+      }
+    } catch (e) {
+      throw new SlotListException((e as Error).message);
+    }
+    return slots;
+  }
+
+  getRawSlots(): RawSlot[] {
+    return this.getValues().filter((s: Slot) => s.getType() === Slot.TYPE_RAW).map((s: Slot) => s as RawSlot);
+  }
+
+  getPasswordSlots(): PasswordSlot[] {
+    return this.getValues().filter((s: Slot) => s instanceof PasswordSlot).map((s: Slot) => s as PasswordSlot);
+  }
+
+  getBiometricSlots(): BiometricSlot[] {
+    return this.getValues().filter((s: Slot) => s instanceof BiometricSlot).map((s: Slot) => s as BiometricSlot);
+  }
+
+  findPasswordSlot(): PasswordSlot | null {
+    const slots = this.getPasswordSlots();
+    return slots.length > 0 ? slots[0] : null;
+  }
+
+  findBiometricSlot(): BiometricSlot | null {
+    const slots = this.getBiometricSlots();
+    return slots.length > 0 ? slots[0] : null;
+  }
+
+  hasPasswordSlot(): boolean {
+    return this.getPasswordSlots().length > 0;
+  }
+
+  hasBiometricSlot(): boolean {
+    return this.getBiometricSlots().length > 0;
+  }
+
+  findBackupPasswordSlots(): PasswordSlot[] {
+    return this.getPasswordSlots().filter((s: PasswordSlot) => s.isBackup());
+  }
+
+  findRegularPasswordSlots(): PasswordSlot[] {
+    return this.getPasswordSlots().filter((s: PasswordSlot) => !s.isBackup());
+  }
+
+  /**
+   * Returns a copy of this SlotList that is suitable for exporting.
+   * Strips biometric slots.
+   * In case there's a backup password slot, any regular password slots are stripped.
+   */
+  exportable(): SlotList {
+    let hasBackupSlots = false;
+    for (const slot of this.getValues()) {
+      if (slot instanceof PasswordSlot && (slot as PasswordSlot).isBackup()) {
+        hasBackupSlots = true;
+        break;
+      }
+    }
+    const slots = new SlotList();
+    for (const slot of this.getValues()) {
+      if (slot instanceof BiometricSlot) {
+        continue;
+      }
+      if (hasBackupSlots && slot instanceof PasswordSlot && !(slot as PasswordSlot).isBackup()) {
+        continue;
+      }
+      slots.add(slot);
+    }
+    return slots;
+  }
+
+  clone(): SlotList {
+    const list = new SlotList();
+    for (const slot of this.getValues()) {
+      list.add(slot.clone());
+    }
+    return list;
+  }
+}
