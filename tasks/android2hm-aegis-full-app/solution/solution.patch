diff --git a/entry/src/main/ets/util/zip/ZipInputStream.ets b/entry/src/main/ets/util/zip/ZipInputStream.ets
new file mode 100644
index 0000000..5a936bc
--- /dev/null
+++ b/entry/src/main/ets/util/zip/ZipInputStream.ets
@@ -0,0 +1,333 @@
+import { Bytes } from '../Bytes';
+import { CryptoUtils } from '../../crypto/CryptoUtils';
+import { Crc32 } from './Crc32';
+import { Inflater } from './Inflater';
+import { LocalFileHeader } from './LocalFileHeader';
+import { ZipException } from './ZipException';
+
+const SIG_LOCAL_FILE_HEADER: number = 0x04034b50;
+
+const SIG_CENTRAL_DIRECTORY: number = 0x02014b50;
+
+const SIG_END_OF_CENTRAL_DIRECTORY: number = 0x06054b50;
+
+const SIG_DATA_DESCRIPTOR: number = 0x08074b50;
+
+const AES_EXTRA_DATA_RECORD: number = 0x9901;
+
+const STD_DEC_HDR_SIZE: number = 12;
+
+const AES_AUTH_LENGTH: number = 10;
+
+const AES_PASSWORD_VERIFIER_LENGTH: number = 2;
+
+const AES_KEY_DERIVATION_ITERATIONS: number = 1000;
+
+const COMPRESSION_STORE: number = 0;
+
+const COMPRESSION_DEFLATE: number = 8;
+
+/**
+ * Port of the parts of net.lingala.zip4j.io.inputstream.ZipInputStream that are used by the
+ * Authenticator Plus importer: reads the entries of a (password protected) ZIP archive. Supports
+ * the traditional PKWARE (ZipCrypto) encryption and WinZip AES (AE-1/AE-2, 128/192/256 bits), with
+ * stored and deflated entries.
+ *
+ * Instead of streaming, the entry is read in full with readEntry() after getNextEntry().
+ */
+export class ZipInputStream {
+  private readonly _data: Uint8Array;
+  private readonly _password: Uint8Array;
+  private _headers: LocalFileHeader[] | null = null;
+  private _index: number = -1;
+
+  constructor(data: Uint8Array, password: string | null) {
+    this._data = data;
+    // zip4j encodes passwords as UTF-8 by default
+    this._password = password !== null ? Bytes.fromUtf8(password) : new Uint8Array(0);
+  }
+
+  private u16(off: number): number {
+    if (off + 2 > this._data.length) {
+      throw new ZipException('Unexpected end of zip file');
+    }
+    return this._data[off] | (this._data[off + 1] << 8);
+  }
+
+  private u32(off: number): number {
+    if (off + 4 > this._data.length) {
+      throw new ZipException('Unexpected end of zip file');
+    }
+    return (this._data[off] | (this._data[off + 1] << 8) | (this._data[off + 2] << 16) | (this._data[off + 3] << 24)) >>> 0;
+  }
+
+  /**
+   * Returns the header of the next entry in the archive, or null if there are no more entries.
+   */
+  getNextEntry(): LocalFileHeader | null {
+    if (this._headers === null) {
+      this._headers = this.readHeaders();
+    }
+    this._index++;
+    if (this._index >= this._headers.length) {
+      return null;
+    }
+    return this._headers[this._index];
+  }
+
+  private readHeaders(): LocalFileHeader[] {
+    const eocd = this.findEndOfCentralDirectory();
+    if (eocd >= 0) {
+      return this.readCentralDirectory(eocd);
+    }
+    return this.readLocalHeaders();
+  }
+
+  private findEndOfCentralDirectory(): number {
+    const min = Math.max(0, this._data.length - 22 - 0xffff);
+    for (let i = this._data.length - 22; i >= min; i--) {
+      if (this.u32(i) === SIG_END_OF_CENTRAL_DIRECTORY) {
+        return i;
+      }
+    }
+    return -1;
+  }
+
+  private parseExtraField(header: LocalFileHeader, off: number, len: number): void {
+    let p = off;
+    while (p + 4 <= off + len) {
+      const id = this.u16(p);
+      const size = this.u16(p + 2);
+      if (id === AES_EXTRA_DATA_RECORD && size >= 7) {
+        header.aesVersion = this.u16(p + 4);
+        header.aesKeyStrength = this._data[p + 8];
+        header.aesCompressionMethod = this.u16(p + 9);
+      }
+      p += 4 + size;
+    }
+  }
+
+  private readCentralDirectory(eocd: number): LocalFileHeader[] {
+    const count = this.u16(eocd + 10);
+    let p = this.u32(eocd + 16);
+    const headers: LocalFileHeader[] = [];
+    for (let i = 0; i < count; i++) {
+      if (this.u32(p) !== SIG_CENTRAL_DIRECTORY) {
+        throw new ZipException('Invalid central directory header signature');
+      }
+      const header = new LocalFileHeader();
+      header.versionNeededToExtract = this.u16(p + 6);
+      header.generalPurposeFlag = this.u16(p + 8);
+      header.compressionMethod = this.u16(p + 10);
+      header.lastModifiedTime = this.u32(p + 12);
+      header.crc = this.u32(p + 16);
+      header.compressedSize = this.u32(p + 20);
+      header.uncompressedSize = this.u32(p + 24);
+      const nameLen = this.u16(p + 28);
+      const extraLen = this.u16(p + 30);
+      const commentLen = this.u16(p + 32);
+      header.localHeaderOffset = this.u32(p + 42);
+      header.fileName = this.decodeName(p + 46, nameLen, header.generalPurposeFlag);
+      this.parseExtraField(header, p + 46 + nameLen, extraLen);
+      headers.push(header);
+      p += 46 + nameLen + extraLen + commentLen;
+    }
+    return headers;
+  }
+
+  /**
+   * Fallback for archives without a central directory: walk the local file headers.
+   */
+  private readLocalHeaders(): LocalFileHeader[] {
+    const headers: LocalFileHeader[] = [];
+    let p = 0;
+    while (p + 30 <= this._data.length && this.u32(p) === SIG_LOCAL_FILE_HEADER) {
+      const header = new LocalFileHeader();
+      header.localHeaderOffset = p;
+      header.versionNeededToExtract = this.u16(p + 4);
+      header.generalPurposeFlag = this.u16(p + 6);
+      header.compressionMethod = this.u16(p + 8);
+      header.lastModifiedTime = this.u32(p + 10);
+      header.crc = this.u32(p + 14);
+      header.compressedSize = this.u32(p + 18);
+      header.uncompressedSize = this.u32(p + 22);
+      const nameLen = this.u16(p + 26);
+      const extraLen = this.u16(p + 28);
+      header.fileName = this.decodeName(p + 30, nameLen, header.generalPurposeFlag);
+      this.parseExtraField(header, p + 30 + nameLen, extraLen);
+      if (header.isDataDescriptorExists()) {
+        throw new ZipException('Zip files with data descriptors require a central directory');
+      }
+      headers.push(header);
+      p += 30 + nameLen + extraLen + header.compressedSize;
+    }
+    return headers;
+  }
+
+  private decodeName(off: number, len: number, flags: number): string {
+    const bytes = this._data.subarray(off, off + len);
+    if ((flags & 0x800) !== 0) {
+      return Bytes.toUtf8(bytes);
+    }
+    // zip4j falls back to UTF-8 as well if no charset was specified
+    return Bytes.toUtf8(bytes);
+  }
+
+  /**
+   * Reads and returns the (decrypted and decompressed) contents of the current entry.
+   */
+  async readEntry(): Promise<Uint8Array> {
+    if (this._headers === null || this._index < 0 || this._index >= this._headers.length) {
+      throw new ZipException('No current entry');
+    }
+    const header = this._headers[this._index];
+    // the local header may have a different extra field length than the central directory
+    const p = header.localHeaderOffset;
+    if (this.u32(p) !== SIG_LOCAL_FILE_HEADER) {
+      throw new ZipException('Invalid local file header signature');
+    }
+    const nameLen = this.u16(p + 26);
+    const extraLen = this.u16(p + 28);
+    const dataStart = p + 30 + nameLen + extraLen;
+    if (dataStart + header.compressedSize > this._data.length) {
+      throw new ZipException('Unexpected end of zip file');
+    }
+    let data = this._data.subarray(dataStart, dataStart + header.compressedSize);
+    let verifyCrc = true;
+    if (header.isEncrypted()) {
+      if (this._password.length === 0) {
+        throw new ZipException(`Password required for encrypted entry: ${header.fileName}`);
+      }
+      if (header.isAesEncrypted()) {
+        data = await this.decryptAes(header, data);
+        // AE-2 does not store a CRC, the authentication code is used instead
+        verifyCrc = header.aesVersion !== 2;
+      }
+      else {
+        data = this.decryptStandard(header, data);
+      }
+    }
+    let result: Uint8Array;
+    const method = header.getCompressionMethod();
+    if (method === COMPRESSION_STORE) {
+      result = Bytes.copy(data);
+    }
+    else if (method === COMPRESSION_DEFLATE) {
+      result = Inflater.inflate(data, header.uncompressedSize);
+    }
+    else {
+      throw new ZipException(`Unsupported compression method: ${method}`);
+    }
+    if (verifyCrc && Crc32.compute(result) !== header.crc) {
+      throw new ZipException(`Reached end of entry, but crc verification failed for ${header.fileName}`);
+    }
+    return result;
+  }
+
+  /**
+   * Traditional PKWARE encryption (ZipCrypto).
+   */
+  private decryptStandard(header: LocalFileHeader, data: Uint8Array): Uint8Array {
+    if (data.length < STD_DEC_HDR_SIZE) {
+      throw new ZipException('Invalid encrypted entry');
+    }
+    let k0 = 0x12345678;
+    let k1 = 0x23456789;
+    let k2 = 0x34567890;
+    const updateKeys = (c: number): void => {
+      k0 = Crc32.updateByte(k0, c);
+      k1 = (Math.imul((k1 + (k0 & 0xff)) >>> 0, 134775813) + 1) >>> 0;
+      k2 = Crc32.updateByte(k2, k1 >>> 24);
+    };
+    const decryptByte = (): number => {
+      const temp = (k2 | 2) & 0xffff;
+      return (Math.imul(temp, temp ^ 1) >>> 8) & 0xff;
+    };
+    for (let i = 0; i < this._password.length; i++) {
+      updateKeys(this._password[i]);
+    }
+    const out = new Uint8Array(data.length - STD_DEC_HDR_SIZE);
+    for (let i = 0; i < data.length; i++) {
+      const c = (data[i] ^ decryptByte()) & 0xff;
+      updateKeys(c);
+      if (i === STD_DEC_HDR_SIZE - 1) {
+        const crcByte = (header.crc >>> 24) & 0xff;
+        const timeByte = (header.lastModifiedTime >>> 8) & 0xff;
+        if (c !== crcByte && c !== timeByte) {
+          throw new ZipException('Wrong password!');
+        }
+      }
+      else if (i >= STD_DEC_HDR_SIZE) {
+        out[i - STD_DEC_HDR_SIZE] = c;
+      }
+    }
+    return out;
+  }
+
+  /**
+   * WinZip AES encryption: PBKDF2-HMAC-SHA1 key derivation, AES-CTR with a little endian counter and
+   * a truncated HMAC-SHA1 authentication code.
+   */
+  private async decryptAes(header: LocalFileHeader, data: Uint8Array): Promise<Uint8Array> {
+    let keyLength: number;
+    let saltLength: number;
+    switch (header.aesKeyStrength) {
+      case 1:
+        keyLength = 16;
+        saltLength = 8;
+        break;
+      case 2:
+        keyLength = 24;
+        saltLength = 12;
+        break;
+      case 3:
+        keyLength = 32;
+        saltLength = 16;
+        break;
+      default:
+        throw new ZipException(`Invalid AES key strength: ${header.aesKeyStrength}`);
+    }
+    if (data.length < saltLength + AES_PASSWORD_VERIFIER_LENGTH + AES_AUTH_LENGTH) {
+      throw new ZipException('Invalid AES encrypted entry');
+    }
+    const salt = data.subarray(0, saltLength);
+    const verifier = data.subarray(saltLength, saltLength + AES_PASSWORD_VERIFIER_LENGTH);
+    const encrypted = data.subarray(saltLength + AES_PASSWORD_VERIFIER_LENGTH, data.length - AES_AUTH_LENGTH);
+    const authCode = data.subarray(data.length - AES_AUTH_LENGTH, data.length);
+    const derived = await CryptoUtils.pbkdf2('SHA1', this._password, Bytes.copy(salt), AES_KEY_DERIVATION_ITERATIONS, 2 * keyLength + AES_PASSWORD_VERIFIER_LENGTH);
+    const aesKey = derived.subarray(0, keyLength);
+    const macKey = derived.subarray(keyLength, 2 * keyLength);
+    const derivedVerifier = derived.subarray(2 * keyLength, 2 * keyLength + AES_PASSWORD_VERIFIER_LENGTH);
+    if (!Bytes.equals(Bytes.copy(verifier), Bytes.copy(derivedVerifier))) {
+      throw new ZipException('Wrong Password');
+    }
+    const mac = CryptoUtils.hmac('SHA1', Bytes.copy(macKey), Bytes.copy(encrypted));
+    if (!Bytes.equals(Bytes.copyOfRange(mac, 0, AES_AUTH_LENGTH), Bytes.copy(authCode))) {
+      throw new ZipException('Reached end of data for this entry, but aes verification failed');
+    }
+    // AES-CTR with a little endian counter starting at 1: encrypt all counter blocks at once with ECB
+    const blocks = Math.ceil(encrypted.length / 16);
+    const counters = new Uint8Array(blocks * 16);
+    for (let i = 0; i < blocks; i++) {
+      let nonce = i + 1;
+      for (let j = 0; j < 8; j++) {
+        counters[i * 16 + j] = nonce % 256;
+        nonce = Math.floor(nonce / 256);
+      }
+    }
+    const keyStream = blocks > 0 ? CryptoUtils.aes(true, 'ECB', 'NoPadding', Bytes.copy(aesKey), null, counters) :
+      new Uint8Array(0);
+    const out = new Uint8Array(encrypted.length);
+    for (let i = 0; i < encrypted.length; i++) {
+      out[i] = encrypted[i] ^ keyStream[i];
+    }
+    return out;
+  }
+
+  close(): void {
+    this._headers = null;
+    this._index = -1;
+  }
+
+  static readonly SIG_DATA_DESCRIPTOR: number = SIG_DATA_DESCRIPTOR;
+}
diff --git a/entry/src/main/ets/vault/Vault.ets b/entry/src/main/ets/vault/Vault.ets
new file mode 100644
index 0000000..c26348c
--- /dev/null
+++ b/entry/src/main/ets/vault/Vault.ets
@@ -0,0 +1,133 @@
+import { UUIDMap } from '../util/UUIDMap';
+import { JSONArray, JSONObject } from '../util/JSONObject';
+import { VaultEntry } from './VaultEntry';
+import { VaultGroup } from './VaultGroup';
+import { VaultException } from './VaultException';
+
+export interface EntryFilter {
+  includeEntry(entry: VaultEntry): boolean;
+}
+
+export class Vault {
+  private static readonly VERSION: number = 3;
+  private readonly _entries: UUIDMap<VaultEntry> = new UUIDMap<VaultEntry>();
+  private readonly _groups: UUIDMap<VaultGroup> = new UUIDMap<VaultGroup>();
+  private _iconsOptimized: boolean = true;
+
+  // Whether we've migrated the group list to the new format while parsing the vault
+  private _isGroupsMigrationFresh: boolean = false;
+
+  toJson(filter?: EntryFilter | null): JSONObject {
+    const entriesArray = new JSONArray();
+    for (const e of this._entries.getValues()) {
+      if (filter === undefined || filter === null || filter.includeEntry(e)) {
+        entriesArray.put(e.toJson());
+      }
+    }
+
+    // Always include all groups, even if they're not assigned to any entry (before or after the entry filter)
+    const groupsArray = new JSONArray();
+    for (const group of this._groups.getValues()) {
+      groupsArray.put(group.toJson());
+    }
+
+    const obj = new JSONObject();
+    obj.put('version', Vault.VERSION);
+    obj.put('entries', entriesArray);
+    obj.put('groups', groupsArray);
+    obj.put('icons_optimized', this._iconsOptimized);
+    return obj;
+  }
+
+  static fromJson(obj: JSONObject): Vault {
+    const vault = new Vault();
+    const entries = vault.getEntries();
+    const groups = vault.getGroups();
+
+    try {
+      const ver = obj.getInt('version');
+      if (ver > Vault.VERSION) {
+        throw new VaultException('Unsupported version');
+      }
+
+      if (obj.has('groups')) {
+        const groupsArray = obj.getJSONArray('groups');
+        for (let i = 0; i < groupsArray.length(); i++) {
+          const group = VaultGroup.fromJson(groupsArray.getJSONObject(i));
+          if (!groups.has(group)) {
+            groups.add(group);
+          }
+        }
+      }
+
+      const array = obj.getJSONArray('entries');
+      for (let i = 0; i < array.length(); i++) {
+        const entry = VaultEntry.fromJson(array.getJSONObject(i));
+        if (vault.migrateOldGroup(entry)) {
+          vault.setGroupsMigrationFresh();
+        }
+
+        // check the vault has a group corresponding to each one the entry claims to be in
+        for (const groupUuid of Array.from(entry.getGroups())) {
+          if (!groups.hasUUID(groupUuid)) {
+            entry.removeGroup(groupUuid);
+          }
+        }
+
+        entries.add(entry);
+      }
+
+      if (!obj.optBoolean('icons_optimized', false)) {
+        vault.setIconsOptimized(false);
+      }
+    } catch (e) {
+      if (e instanceof VaultException) {
+        throw e as VaultException;
+      }
+      throw new VaultException((e as Error).message);
+    }
+
+    return vault;
+  }
+
+  private setGroupsMigrationFresh(): void {
+    this._isGroupsMigrationFresh = true;
+  }
+
+  isGroupsMigrationFresh(): boolean {
+    return this._isGroupsMigrationFresh;
+  }
+
+  setIconsOptimized(optimized: boolean): void {
+    this._iconsOptimized = optimized;
+  }
+
+  areIconsOptimized(): boolean {
+    return this._iconsOptimized;
+  }
+
+  migrateOldGroup(entry: VaultEntry): boolean {
+    const oldGroup = entry.getOldGroup();
+    if (oldGroup !== null) {
+      const optGroup = this.getGroups().getValues().find((g: VaultGroup) => g.getName() === oldGroup);
+      if (optGroup !== undefined) {
+        entry.addGroup(optGroup.getUUID());
+      } else {
+        const group = new VaultGroup(oldGroup);
+        this.getGroups().add(group);
+        entry.addGroup(group.getUUID());
+      }
+      entry.setOldGroup(null);
+      return true;
+    }
+    return false;
+  }
+
+  getEntries(): UUIDMap<VaultEntry> {
+    return this._entries;
+  }
+
+  getGroups(): UUIDMap<VaultGroup> {
+    return this._groups;
+  }
+}
diff --git a/entry/src/main/ets/vault/VaultBackupManager.ets b/entry/src/main/ets/vault/VaultBackupManager.ets
new file mode 100644
index 0000000..d86e772
--- /dev/null
+++ b/entry/src/main/ets/vault/VaultBackupManager.ets
@@ -0,0 +1,308 @@
+import { common } from '@kit.AbilityKit';
+import { fileIo, fileUri, fileShare } from '@kit.CoreFileKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { BackupsVersioningStrategy } from '../BackupsVersioningStrategy';
+import { Preferences, BackupResult } from '../Preferences';
+import { AuditLogRepository } from '../database/AuditLogRepository';
+import { VaultRepositoryException } from './VaultRepositoryException';
+import { VaultBackupPermissionException } from './VaultBackupPermissionException';
+import { IOUtils } from '../util/IOUtils';
+import { AegisModule } from '../AegisModule';
+
+const TAG: string = 'VaultBackupManager';
+
+function pad(n: number, len: number): string {
+  let s = `${n}`;
+  while (s.length < len) {
+    s = '0' + s;
+  }
+  return s;
+}
+
+export class FileInfo {
+  private _filename: string;
+  private _ext: string;
+  private _date: Date;
+
+  constructor(filename: string, extension?: string, date?: Date) {
+    this._filename = filename;
+    this._ext = extension !== undefined ? extension : 'json';
+    this._date = date !== undefined ? date : new Date();
+  }
+
+  static formatDate(d: Date): string {
+    return `${d.getFullYear()}${pad(d.getMonth() + 1, 2)}${pad(d.getDate(), 2)}-${pad(d.getHours(), 2)}${pad(d.getMinutes(), 2)}${pad(d.getSeconds(), 2)}`;
+  }
+
+  /**
+   * Strict parser for the yyyyMMdd-HHmmss format.
+   */
+  static parseDate(s: string): Date | null {
+    const m = new RegExp('^(\\d{4})(\\d{2})(\\d{2})-(\\d{2})(\\d{2})(\\d{2})$').exec(s);
+    if (m === null) {
+      return null;
+    }
+    const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]), Number(m[4]), Number(m[5]), Number(m[6]));
+    if (FileInfo.formatDate(d) !== s) {
+      return null;
+    }
+    return d;
+  }
+
+  static parseFilename(name: string | null): FileInfo {
+    if (name === null) {
+      throw new Error('The filename must not be null');
+    }
+
+    const ext = '.json';
+    if (!name.endsWith(ext)) {
+      throw new Error(`Bad backup filename format: ${name}`);
+    }
+    let filename = name.substring(0, name.length - ext.length);
+
+    const delim = '-';
+    const parts = filename.split(delim);
+    if (parts.length < 3) {
+      throw new Error(`Bad backup filename format: ${filename}`);
+    }
+
+    filename = parts.slice(0, parts.length - 2).join(delim);
+    if (filename !== VaultBackupManager.FILENAME_PREFIX) {
+      throw new Error(`Bad backup filename format: ${filename}`);
+    }
+
+    const date = FileInfo.parseDate(parts[parts.length - 2] + delim + parts[parts.length - 1]);
+    if (date === null) {
+      throw new Error(`Bad backup filename format: ${filename}`);
+    }
+
+    return new FileInfo(filename, 'json', date);
+  }
+
+  getFilename(): string {
+    return this._filename;
+  }
+
+  getExtension(): string {
+    return this._ext;
+  }
+
+  getDate(): Date {
+    return this._date;
+  }
+
+  toString(): string {
+    return `${this._filename}-${FileInfo.formatDate(this._date)}.${this._ext}`;
+  }
+}
+
+class BackupFile {
+  private _path: string;
+  private _info: FileInfo;
+
+  constructor(path: string, name: string) {
+    this._path = path;
+    this._info = FileInfo.parseFilename(name);
+  }
+
+  getPath(): string {
+    return this._path;
+  }
+
+  getInfo(): FileInfo {
+    return this._info;
+  }
+}
+
+export class VaultBackupManager {
+  static readonly FILENAME_PREFIX: string = 'aegis-backup';
+  static readonly FILENAME_SINGLE: string = `${VaultBackupManager.FILENAME_PREFIX}.json`;
+
+  private readonly _context: common.Context;
+  private readonly _auditLogRepository: AuditLogRepository;
+  private _queue: Promise<void> = Promise.resolve();
+
+  constructor(context: common.Context, auditLogRepository: AuditLogRepository) {
+    this._context = context;
+    this._auditLogRepository = auditLogRepository;
+  }
+
+  private getPrefs(): Preferences {
+    return AegisModule.getPreferences();
+  }
+
+  /**
+   * Schedules a backup on a serial queue (replacement for the single thread executor).
+   */
+  scheduleBackup(tempFile: string, strategy: BackupsVersioningStrategy, uri: string | null, versionsToKeep: number): void {
+    this._queue = this._queue.then(async () => {
+      try {
+        await this.createBackup(tempFile, strategy, uri, versionsToKeep);
+        this._auditLogRepository.addBackupCreatedEvent();
+        this.getPrefs().setBuiltInBackupResult(BackupResult.fromException(null));
+      } catch (e) {
+        hilog.error(0x0000, TAG, 'Unable to create backup: %{public}s', (e as Error).message);
+        this.getPrefs().setBuiltInBackupResult(BackupResult.fromException(e as Error));
+      }
+    });
+  }
+
+  private async createBackup(tempFile: string, strategy: BackupsVersioningStrategy, uri: string | null, versionsToKeep: number): Promise<void> {
+    if (uri === null) {
+      throw new VaultRepositoryException('getBackupsLocation returned null');
+    }
+    if (strategy === BackupsVersioningStrategy.SINGLE_BACKUP) {
+      await this.createSingleBackup(tempFile, uri);
+    } else if (strategy === BackupsVersioningStrategy.MULTIPLE_BACKUPS) {
+      await this.createVersionedBackup(tempFile, uri, versionsToKeep);
+    } else {
+      throw new VaultRepositoryException('Invalid backups versioning strategy');
+    }
+  }
+
+  private async createSingleBackup(tempFile: string, uri: string): Promise<void> {
+    hilog.info(0x0000, TAG, 'Creating backup at %{public}s', uri);
+    try {
+      if (!await this.hasPermissionsAt(uri)) {
+        throw new VaultBackupPermissionException('No persisted URI permissions');
+      }
+      try {
+        IOUtils.copy(tempFile, uri);
+      } catch (e) {
+        throw new VaultRepositoryException((e as Error).message);
+      }
+    } finally {
+      VaultBackupManager.deleteFile(tempFile);
+    }
+  }
+
+  private async createVersionedBackup(tempFile: string, dirUri: string, versionsToKeep: number): Promise<void> {
+    const fileInfo = new FileInfo(VaultBackupManager.FILENAME_PREFIX);
+    const dirPath = VaultBackupManager.toPath(dirUri);
+    try {
+      hilog.info(0x0000, TAG, 'Creating backup at %{public}s: %{public}s', dirPath, fileInfo.toString());
+
+      if (!await this.hasPermissionsAt(dirUri)) {
+        throw new VaultBackupPermissionException('No persisted URI permissions');
+      }
+
+      // We can't overwrite existing files, so avoid that altogether by checking beforehand.
+      const target = `${dirPath}/${fileInfo.toString()}`;
+      if (IOUtils.exists(target)) {
+        throw new VaultRepositoryException('Backup file already exists');
+      }
+
+      try {
+        IOUtils.copy(tempFile, target);
+      } catch (e) {
+        throw new VaultRepositoryException((e as Error).message);
+      }
+    } finally {
+      VaultBackupManager.deleteFile(tempFile);
+    }
+
+    this.enforceVersioning(dirPath, versionsToKeep);
+  }
+
+  static toPath(uri: string): string {
+    if (uri.startsWith('file://')) {
+      try {
+        return new fileUri.FileUri(uri).path;
+      } catch (e) {
+        return uri;
+      }
+    }
+    return uri;
+  }
+
+  private static deleteFile(path: string): void {
+    try {
+      fileIo.unlinkSync(path);
+    } catch (e) {
+      // ignore
+    }
+  }
+
+  static async persistPermission(uri: string): Promise<void> {
+    const policy: fileShare.PolicyInfo = {
+      uri: uri,
+      operationMode: fileShare.OperationMode.READ_MODE | fileShare.OperationMode.WRITE_MODE
+    };
+    try {
+      await fileShare.persistPermission([policy]);
+    } catch (e) {
+      hilog.warn(0x0000, TAG, 'persistPermission failed: %{public}s', (e as Error).message);
+    }
+  }
+
+  async hasPermissionsAt(uri: string): Promise<boolean> {
+    if (!uri.startsWith('file://')) {
+      return IOUtils.exists(uri);
+    }
+    const policy: fileShare.PolicyInfo = {
+      uri: uri,
+      operationMode: fileShare.OperationMode.READ_MODE | fileShare.OperationMode.WRITE_MODE
+    };
+    try {
+      const res = await fileShare.checkPersistentPermission([policy]);
+      if (res.length > 0 && res[0]) {
+        try {
+          await fileShare.activatePermission([policy]);
+        } catch (e) {
+          // the permission may already be active
+        }
+        return true;
+      }
+      // no persisted grant (persisting may not be available on this device): the location is still
+      // usable if the temporary grant from the picker is active
+      return VaultBackupManager.isAccessible(uri);
+    } catch (e) {
+      // persistent permissions are not supported on this device: assume the permission
+      // that was granted through the picker is still valid
+      return true;
+    }
+  }
+
+  private static isAccessible(uri: string): boolean {
+    try {
+      return fileIo.accessSync(VaultBackupManager.toPath(uri), fileIo.AccessModeType.WRITE);
+    } catch (e) {
+      return false;
+    }
+  }
+
+  private enforceVersioning(dirPath: string, versionsToKeep: number): void {
+    if (versionsToKeep <= 0) {
+      return;
+    }
+
+    hilog.info(0x0000, TAG, 'Scanning directory %{public}s for backup files', dirPath);
+
+    const files: BackupFile[] = [];
+    let names: string[] = [];
+    try {
+      names = fileIo.listFileSync(dirPath);
+    } catch (e) {
+      return;
+    }
+    for (const name of names) {
+      const path = `${dirPath}/${name}`;
+      try {
+        if (fileIo.statSync(path).isFile()) {
+          files.push(new BackupFile(path, name));
+        }
+      } catch (ignored) {
+      }
+    }
+
+    hilog.info(0x0000, TAG, 'Found %{public}d backup files, keeping the %{public}d most recent', files.length, versionsToKeep);
+
+    files.sort((a: BackupFile, b: BackupFile) => a.getInfo().getDate().getTime() - b.getInfo().getDate().getTime());
+    if (files.length > versionsToKeep) {
+      for (const file of files.slice(0, files.length - versionsToKeep)) {
+        hilog.info(0x0000, TAG, 'Deleting %{public}s', file.getPath());
+        VaultBackupManager.deleteFile(file.getPath());
+      }
+    }
+  }
+}
