diff --git a/entry/src/main/ets/vault/VaultFile.ets b/entry/src/main/ets/vault/VaultFile.ets
new file mode 100644
index 0000000..f16beb3
--- /dev/null
+++ b/entry/src/main/ets/vault/VaultFile.ets
@@ -0,0 +1,168 @@
+import { JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+import { Base64 } from '../encoding/Base64';
+import { CryptParameters } from '../crypto/CryptParameters';
+import { SlotList } from './slots/SlotList';
+import { VaultFileCredentials } from './VaultFileCredentials';
+import { VaultFileException } from './VaultFileException';
+
+export class VaultFileHeader {
+  private _slots: SlotList | null;
+  private _params: CryptParameters | null;
+
+  constructor(slots: SlotList | null, params: CryptParameters | null) {
+    this._slots = slots;
+    this._params = params;
+  }
+
+  static fromJson(obj: JSONObject): VaultFileHeader {
+    if (obj.isNull('slots') && obj.isNull('params')) {
+      return new VaultFileHeader(null, null);
+    }
+
+    try {
+      const slots = SlotList.fromJson(obj.getJSONArray('slots'));
+      const params = CryptParameters.fromJson(obj.getJSONObject('params'));
+      return new VaultFileHeader(slots, params);
+    } catch (e) {
+      throw new VaultFileException((e as Error).message);
+    }
+  }
+
+  toJson(): JSONObject {
+    const obj = new JSONObject();
+    obj.put('slots', this._slots !== null ? this._slots.toJson() : null);
+    obj.put('params', this._params !== null ? this._params.toJson() : null);
+    return obj;
+  }
+
+  getSlots(): SlotList {
+    return this._slots as SlotList;
+  }
+
+  getParams(): CryptParameters {
+    return this._params as CryptParameters;
+  }
+
+  isEmpty(): boolean {
+    return this._slots === null && this._params === null;
+  }
+}
+
+export class VaultFile {
+  static readonly VERSION: number = 1;
+
+  private _content: string | JSONObject | null = null;
+  private _header: VaultFileHeader = new VaultFileHeader(null, null);
+
+  constructor(content?: string | JSONObject, header?: VaultFileHeader) {
+    if (content !== undefined) {
+      this._content = content;
+    }
+    if (header !== undefined) {
+      this._header = header;
+    }
+  }
+
+  getHeader(): VaultFileHeader {
+    return this._header;
+  }
+
+  isEncrypted(): boolean {
+    return !this._header.isEmpty();
+  }
+
+  toJson(): JSONObject {
+    const obj = new JSONObject();
+    obj.put('version', VaultFile.VERSION);
+    obj.put('header', this._header.toJson());
+    if (this._content instanceof JSONObject) {
+      obj.put('db', this._content as JSONObject);
+    } else {
+      obj.put('db', this._content as string);
+    }
+    return obj;
+  }
+
+  toBytes(): Uint8Array {
+    const obj = this.toJson();
+    return Bytes.fromUtf8(obj.toString(4));
+  }
+
+  static fromJson(obj: JSONObject): VaultFile {
+    try {
+      if (obj.getInt('version') > VaultFile.VERSION) {
+        throw new VaultFileException('unsupported version');
+      }
+
+      const header = VaultFileHeader.fromJson(obj.getJSONObject('header'));
+      if (!header.isEmpty()) {
+        return new VaultFile(obj.getString('db'), header);
+      }
+
+      return new VaultFile(obj.getJSONObject('db'), header);
+    } catch (e) {
+      if (e instanceof VaultFileException) {
+        throw e as VaultFileException;
+      }
+      throw new VaultFileException((e as Error).message);
+    }
+  }
+
+  static fromBytes(data: Uint8Array): VaultFile {
+    try {
+      const obj = new JSONObject(Bytes.toUtf8(data));
+      return VaultFile.fromJson(obj);
+    } catch (e) {
+      if (e instanceof VaultFileException) {
+        throw e as VaultFileException;
+      }
+      throw new VaultFileException((e as Error).message);
+    }
+  }
+
+  getContent(): JSONObject {
+    return this._content as JSONObject;
+  }
+
+  getContentDecrypted(creds: VaultFileCredentials): JSONObject {
+    try {
+      const bytes = Base64.decode(this._content as string);
+      const result = creds.decrypt(bytes, this._header.getParams());
+      return new JSONObject(Bytes.toUtf8(result.getData()));
+    } catch (e) {
+      throw new VaultFileException((e as Error).message);
+    }
+  }
+
+  setContent(obj: JSONObject): void {
+    this._content = obj;
+    this._header = new VaultFileHeader(null, null);
+  }
+
+  setContentEncrypted(obj: JSONObject, creds: VaultFileCredentials): void {
+    try {
+      const str = obj.toString(4);
+      const vaultBytes = Bytes.fromUtf8(str);
+      const result = creds.encrypt(vaultBytes);
+      this._content = Base64.encode(result.getData());
+      this._header = new VaultFileHeader(creds.getSlots(), result.getParams());
+    } catch (e) {
+      throw new VaultFileException((e as Error).message);
+    }
+  }
+
+  /**
+   * Returns a copy of this VaultFile that's suitable for exporting.
+   * In case there's a backup password slot, any regular password slots are stripped.
+   */
+  exportable(): VaultFile {
+    if (!this.isEncrypted()) {
+      return this;
+    }
+    return new VaultFile(this._content as string, new VaultFileHeader(
+      this.getHeader().getSlots().exportable(),
+      this.getHeader().getParams()
+    ));
+  }
+}
diff --git a/entry/src/main/ets/vault/VaultFileCredentials.ets b/entry/src/main/ets/vault/VaultFileCredentials.ets
