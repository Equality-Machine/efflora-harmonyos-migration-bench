new file mode 100644
index 0000000..aaf8863
--- /dev/null
+++ b/entry/src/main/ets/receivers/VaultLockReceiver.ets
@@ -0,0 +1,49 @@
+import { commonEventManager } from '@kit.BasicServicesKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { Preferences } from '../Preferences';
+import { AegisModule } from '../AegisModule';
+
+/**
+ * Port of VaultLockReceiver: locks the vault when the screen is turned off or when the LOCK_VAULT
+ * event is received (sent by the notification of the NotificationService).
+ */
+export class VaultLockReceiver {
+  static readonly ACTION_LOCK_VAULT: string = 'com.a2h.migration.LOCK_VAULT';
+  static readonly ACTION_SCREEN_OFF: string = commonEventManager.Support.COMMON_EVENT_SCREEN_OFF;
+
+  private _subscriber: commonEventManager.CommonEventSubscriber | null = null;
+
+  async register(): Promise<void> {
+    const info: commonEventManager.CommonEventSubscribeInfo = {
+      events: [VaultLockReceiver.ACTION_LOCK_VAULT, VaultLockReceiver.ACTION_SCREEN_OFF]
+    };
+    try {
+      this._subscriber = await commonEventManager.createSubscriber(info);
+      commonEventManager.subscribe(this._subscriber, (err, data: commonEventManager.CommonEventData) => {
+        if (err !== null && err !== undefined && err.code !== 0) {
+          return;
+        }
+        this.onReceive(data.event);
+      });
+    } catch (e) {
+      hilog.error(0x0000, 'VaultLockReceiver', 'Unable to subscribe: %{public}s', JSON.stringify(e));
+    }
+  }
+
+  unregister(): void {
+    if (this._subscriber !== null) {
+      commonEventManager.unsubscribe(this._subscriber);
+      this._subscriber = null;
+    }
+  }
+
+  onReceive(action: string): void {
+    if (action !== VaultLockReceiver.ACTION_LOCK_VAULT && action !== VaultLockReceiver.ACTION_SCREEN_OFF) {
+      return;
+    }
+    const vaultManager = AegisModule.provideVaultManager();
+    if (vaultManager.isAutoLockEnabled(Preferences.AUTO_LOCK_ON_DEVICE_LOCK)) {
+      vaultManager.lock(false);
+    }
+  }
+}
