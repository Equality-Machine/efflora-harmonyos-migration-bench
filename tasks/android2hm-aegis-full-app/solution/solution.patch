@@ -0,0 +1,84 @@
+import { Want } from '@kit.AbilityKit';
+import { systemShare } from '@kit.ShareKit';
+import { uniformTypeDescriptor } from '@kit.ArkData';
+import { LaunchAppTileService } from '../services/LaunchAppTileService';
+
+export const ACTION_VIEW: string = 'ohos.want.action.viewData';
+export const ACTION_SEND: string = 'ohos.want.action.sendData';
+export const ACTION_SEND_MULTIPLE: string = 'ohos.want.action.sendMultipleData';
+export const ACTION_PANIC_TRIGGER: string = 'info.guardianproject.panic.action.TRIGGER';
+
+/**
+ * The intent the app was started with (replacement for getIntent() in MainActivity), extracted from
+ * the Want that started the ability.
+ */
+export class IncomingIntent {
+  action: string | null = null;
+  data: string | null = null;
+  text: string | null = null;
+  streams: string[] = [];
+  // the "action" extra used by the shortcuts and widgets (e.g. "scan")
+  extraAction: string | null = null;
+
+  private static _pending: IncomingIntent | null = null;
+
+  static setPending(intent: IncomingIntent | null): void {
+    IncomingIntent._pending = intent;
+  }
+
+  static getPending(): IncomingIntent | null {
+    return IncomingIntent._pending;
+  }
+
+  static async fromWant(want: Want): Promise<IncomingIntent> {
+    const intent = new IncomingIntent();
+    intent.action = want.action !== undefined && want.action.length > 0 ? want.action : null;
+    if (want.uri !== undefined && want.uri.length > 0) {
+      intent.data = want.uri;
+      if (intent.action === null) {
+        intent.action = ACTION_VIEW;
+      }
+    }
+    if (want.parameters !== undefined) {
+      const extra = want.parameters['action'];
+      if (typeof extra === 'string') {
+        intent.extraAction = extra as string;
+      }
+      // actions posted by the service widget (postCardAction) are wrapped in 'params'
+      const params = want.parameters['params'];
+      if (typeof params === 'string') {
+        try {
+          const obj = JSON.parse(params as string) as Record<string, Object>;
+          const a = obj['action'];
+          if (typeof a === 'string') {
+            intent.extraAction = a as string;
+          }
+        } catch (e) {
+          // ignore
+        }
+      }
+      if (intent.extraAction === LaunchAppTileService.ACTION) {
+        intent.extraAction = null;
+      }
+    }
+    if (intent.action === ACTION_SEND || intent.action === ACTION_SEND_MULTIPLE) {
+      try {
+        const shared = await systemShare.getSharedData(want);
+        for (const record of shared.getRecords()) {
+          if (record.utd === uniformTypeDescriptor.UniformDataType.PLAIN_TEXT || record.utd === uniformTypeDescriptor.UniformDataType.TEXT) {
+            if (record.content !== undefined) {
+              intent.text = record.content;
+            }
+          } else if (record.uri !== undefined) {
+            intent.streams.push(record.uri);
+          } else if (record.content !== undefined) {
+            intent.text = record.content;
+          }
+        }
+      } catch (e) {
+        // not shared through the share kit
+      }
+    }
+    return intent;
+  }
+}
diff --git a/entry/src/main/ets/ui/Intent.ets b/entry/src/main/ets/ui/Intent.ets
new file mode 100644
index 0000000..b30d651
--- /dev/null
+++ b/entry/src/main/ets/ui/Intent.ets
@@ -0,0 +1,186 @@
+import { hilog } from '@kit.PerformanceAnalysisKit';
+
+export const RESULT_OK: number = -1;
+export const RESULT_CANCELED: number = 0;
+
+/**
+ * Replacement for android.content.Intent when navigating between pages. Extras are kept in memory,
+ * so arbitrary objects (VaultEntry, lists, ...) can be passed without serialization.
+ */
+export class Intent {
+  private static _counter: number = 0;
+
+  readonly id: string;
+  readonly url: string;
+  private _action: string | null = null;
+  private _extras: Map<string, Object | null> = new Map<string, Object | null>();
+
+  constructor(url: string) {
+    Intent._counter++;
+    this.id = `intent-${Date.now()}-${Intent._counter}`;
+    this.url = url;
+  }
+
+  setAction(action: string | null): Intent {
+    this._action = action;
+    return this;
+  }
+
+  getAction(): string | null {
+    return this._action;
+  }
+
+  putExtra(key: string, value: Object | null): Intent {
+    this._extras.set(key, value);
+    return this;
+  }
+
+  removeExtra(key: string): void {
+    this._extras.delete(key);
+  }
+
+  hasExtra(key: string): boolean {
+    return this._extras.has(key);
+  }
+
+  getExtra(key: string): Object | null {
+    const v = this._extras.get(key);
+    return v === undefined ? null : v;
+  }
+
+  getStringExtra(key: string): string | null {
+    const v = this.getExtra(key);
+    return typeof v === 'string' ? v as string : null;
+  }
+
+  getBooleanExtra(key: string, def: boolean): boolean {
+    const v = this.getExtra(key);
+    return typeof v === 'boolean' ? v as boolean : def;
+  }
+
+  getNumberExtra(key: string, def: number): number {
+    const v = this.getExtra(key);
+    return typeof v === 'number' ? v as number : def;
+  }
+}
+
+export class ActivityResult {
+  resultCode: number;
+  data: Intent | null;
+
+  constructor(resultCode: number, data: Intent | null) {
+    this.resultCode = resultCode;
+    this.data = data;
+  }
+
+  isOk(): boolean {
+    return this.resultCode === RESULT_OK;
+  }
+}
+
+export type ActivityResultCallback = (result: ActivityResult) => void;
+
+export class RouterParams {
+  intentId: string = '';
+}
+
+class PendingResult {
+  callback: ActivityResultCallback | null;
+  result: ActivityResult = new ActivityResult(RESULT_CANCELED, null);
+  delivered: boolean = false;
+
+  constructor(callback: ActivityResultCallback | null) {
+    this.callback = callback;
+  }
+}
+
+/**
+ * Replacement for startActivity/startActivityForResult/setResult/finish on top of the ArkUI router.
+ */
+export class ActivityManager {
+  private static _intents: Map<string, Intent> = new Map<string, Intent>();
+  private static _pending: Map<string, PendingResult> = new Map<string, PendingResult>();
+
+  static startActivity(uiContext: UIContext, intent: Intent): void {
+    ActivityManager.startActivityForResult(uiContext, intent, null);
+  }
+
+  static startActivityForResult(uiContext: UIContext, intent: Intent, callback: ActivityResultCallback | null): void {
+    ActivityManager._intents.set(intent.id, intent);
+    ActivityManager._pending.set(intent.id, new PendingResult(callback));
+    const params = new RouterParams();
+    params.intentId = intent.id;
+    uiContext.getRouter().pushUrl({ url: intent.url, params: params }).catch((e: Error) => {
+      hilog.error(0x0000, 'ActivityManager', 'Unable to start %{public}s: %{public}s', intent.url, JSON.stringify(e));
+      ActivityManager.deliver(intent.id);
+    });
+  }
+
+  /**
+   * Replaces the current page with the given one (used for e.g. the intro and auth flows).
+   */
+  static replaceActivity(uiContext: UIContext, intent: Intent): void {
+    ActivityManager._intents.set(intent.id, intent);
+    const params = new RouterParams();
+    params.intentId = intent.id;
+    uiContext.getRouter().replaceUrl({ url: intent.url, params: params }).catch(() => {
+    });
+  }
+
+  /**
+   * Returns the intent the current page was started with.
+   */
+  static getIntent(uiContext: UIContext, defaultUrl: string): Intent {
+    try {
+      const params = uiContext.getRouter().getParams() as RouterParams;
+      if (params !== undefined && params !== null && params.intentId !== undefined) {
+        const intent = ActivityManager._intents.get(params.intentId);
+        if (intent !== undefined) {
+          return intent;
+        }
+      }
+    } catch (e) {
+      // ignore
+    }
+    return new Intent(defaultUrl);
+  }
+
+  static setResult(intent: Intent, resultCode: number, data: Intent | null): void {
+    const pending = ActivityManager._pending.get(intent.id);
+    if (pending !== undefined) {
+      pending.result = new ActivityResult(resultCode, data);
+    }
+  }
+
+  /**
+   * Finishes the current page. The result is delivered when the page is destroyed.
+   */
+  static finish(uiContext: UIContext): void {
+    try {
+      uiContext.getRouter().back();
+    } catch (e) {
+      // ignore
+    }
+  }
+
+  /**
+   * Delivers the result of the page that was started with the given intent. Called from
+   * AegisActivity.onDestroy (aboutToDisappear), so that results are also delivered when the user
+   * navigates back with a gesture.
+   */
+  static deliver(intentId: string): void {
+    const pending = ActivityManager._pending.get(intentId);
+    ActivityManager._pending.delete(intentId);
+    ActivityManager._intents.delete(intentId);
+    if (pending !== undefined && !pending.delivered) {
+      pending.delivered = true;
+      if (pending.callback !== null) {
+        try {
+          pending.callback(pending.result);
+        } catch (e) {
+          hilog.error(0x0000, 'ActivityManager', 'Result callback failed: %{public}s', (e as Error).message);
+        }
+      }
+    }
+  }
+}
