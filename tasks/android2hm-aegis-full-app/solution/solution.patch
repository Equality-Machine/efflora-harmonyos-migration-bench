+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { AegisActivity, PAGE_PREFS_BACKUPS } from '../../AegisActivity';
+import { Toolbar } from '../../components/Toolbar';
+import { Dialogs } from '../../dialogs/Dialogs';
+import { PreferencesFragment } from './PreferencesFragment';
+import { Preference, PreferenceScreen, SwitchPreferenceCompat } from '../../preferences/Preference';
+import { PreferenceResources } from '../../preferences/PreferenceResources';
+import { PreferenceScreenView } from '../../preferences/PreferenceScreenView';
+import { ThemeHelper } from '../../../helpers/ThemeHelper';
+import { SafHelper } from '../../../helpers/SafHelper';
+import { BackupResult, Preferences } from '../../../Preferences';
+import { BackupsVersioningStrategy } from '../../../BackupsVersioningStrategy';
+import { Theme } from '../../../Theme';
+import { AegisModule } from '../../../AegisModule';
+import { ResUtils } from '../../../util/ResUtils';
+import { Uri } from '../../../util/Uri';
+import { VaultManager } from '../../../vault/VaultManager';
+import { VaultBackupManager } from '../../../vault/VaultBackupManager';
+
+function getString(name: string, args?: Array<string | number>): string {
+  return ResUtils.getString(AegisModule.getContext(), name, args);
+}
+
+/**
+ * Port of BackupsPreferencesFragment (res/xml/preferences_backups.xml).
+ */
+@Entry
+@Component
+struct BackupsPreferencesFragment {
+  @State tick: number = 0;
+  private _activity: AegisActivity | null = null;
+  private _fragment: PreferencesFragment | null = null;
+  private _prefs: Preferences = AegisModule.getPreferences();
+  private _vaultManager: VaultManager = AegisModule.provideVaultManager();
+
+  private _androidBackupsPreference: SwitchPreferenceCompat | null = null;
+  private _backupsPreference: SwitchPreferenceCompat | null = null;
+  private _backupReminderPreference: SwitchPreferenceCompat | null = null;
+  private _versioningStrategyPreference: Preference | null = null;
+  private _backupsLocationPreference: Preference | null = null;
+  private _backupsTriggerPreference: Preference | null = null;
+  private _backupsVersionsPreference: Preference | null = null;
+  private _backupsPasswordWarningPreference: Preference | null = null;
+
+  private _builtinBackupStatusPreference: Preference | null = null;
+  private _androidBackupStatusPreference: Preference | null = null;
+
+  aboutToAppear(): void {
+    const activity = new AegisActivity(this.getUIContext(), PAGE_PREFS_BACKUPS);
+    this._activity = activity;
+    activity.onCreate();
+    if (activity.abortIfOrphan()) {
+      return;
+    }
+
+    this._fragment = new PreferencesFragment(activity, () => {
+      this.tick++;
+    });
+    this._prefs = activity.getPreferences();
+    this._vaultManager = activity.getVaultManager();
+    this.onCreatePreferences();
+  }
+
+  onPageShow(): void {
+    if (this._activity !== null) {
+      this._activity.onResume();
+    }
+    this.onResume();
+  }
+
+  aboutToDisappear(): void {
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  onResume(): void {
+    if (this._fragment === null || !this._vaultManager.isVaultLoaded()) {
+      return;
+    }
+    this._fragment.onResume();
+    this.updateBackupPreference();
+  }
+
+  private requireContext(): UIContext {
+    return this.getUIContext();
+  }
+
+  onCreatePreferences(): void {
+    const fragment = this._fragment as PreferencesFragment;
+    fragment.addPreferencesFromResource(PreferenceResources.preferences_backups());
+
+    this._backupsPasswordWarningPreference = fragment.requirePreference<Preference>('pref_backups_warning_password');
+    const builtinBackupStatusPreference = fragment.requirePreference<Preference>('pref_status_backup_builtin');
+    this._builtinBackupStatusPreference = builtinBackupStatusPreference;
+    builtinBackupStatusPreference.setOnPreferenceClickListener((preference: Preference) => {
+      const backupRes = this._prefs.getBuiltInBackupResult();
+      if (backupRes !== null && !backupRes.isSuccessful()) {
+        Dialogs.showBackupErrorDialog(this.requireContext(), backupRes, () => {
+        });
+      }
+      return true;
+    });
+    this._androidBackupStatusPreference = fragment.requirePreference<Preference>('pref_status_backup_android');
+    this._androidBackupStatusPreference.setOnPreferenceClickListener((preference: Preference) => {
+      const backupRes = this._prefs.getAndroidBackupResult();
+      if (backupRes !== null && !backupRes.isSuccessful()) {
+        Dialogs.showBackupErrorDialog(this.requireContext(), backupRes, () => {
+        });
+      }
+      return true;
+    });
+
+    this._backupsPreference = fragment.requirePreference<SwitchPreferenceCompat>('pref_backups');
+    this._backupsPreference.setOnPreferenceChangeListener((preference: Preference, newValue: Object) => {
+      if (newValue as boolean) {
+        Dialogs.showBackupsVersioningStrategy(this.requireContext(), BackupsVersioningStrategy.MULTIPLE_BACKUPS,
+          (strategy: BackupsVersioningStrategy) => {
+            if (strategy === BackupsVersioningStrategy.MULTIPLE_BACKUPS) {
+              this.selectBackupsLocation();
+            } else if (strategy === BackupsVersioningStrategy.SINGLE_BACKUP) {
+              this.createBackupFile();
+            }
+          });
+      } else {
+        this._prefs.setIsBackupsEnabled(false);
+        this.updateBackupPreference();
+      }
+
+      return false;
+    });
+
+    this._backupReminderPreference = fragment.requirePreference<SwitchPreferenceCompat>('pref_backup_reminder');
+    this._backupReminderPreference.setOnPreferenceChangeListener((preference: Preference, newValue: Object) => {
+      if (!(newValue as boolean)) {
+        Dialogs.showCheckboxDialog(this.requireContext(), $r('app.string.pref_backups_reminder_dialog_title'),
+          $r('app.string.pref_backups_reminder_dialog_summary'),
+          $r('app.string.understand_risk_accept'),
+          (understand: boolean) => this.saveAndDisableBackupReminder(understand)
+        );
+      } else {
+        this._prefs.setIsBackupReminderEnabled(true);
+        return true;
+      }
+
+      return false;
+    });
+
+    this._versioningStrategyPreference = fragment.requirePreference<Preference>('pref_versioning_strategy');
+    this.updateBackupsVersioningStrategySummary();
+    this._versioningStrategyPreference.setOnPreferenceClickListener((preference: Preference) => {
+      const currentStrategy = this._prefs.getBackupVersioningStrategy();
+      Dialogs.showBackupsVersioningStrategy(this.requireContext(), currentStrategy,
+        (strategy: BackupsVersioningStrategy) => {
+          if (strategy === currentStrategy) {
+            return;
+          }
+          if (strategy === BackupsVersioningStrategy.MULTIPLE_BACKUPS) {
+            this.selectBackupsLocation();
+          } else if (strategy === BackupsVersioningStrategy.SINGLE_BACKUP) {
+            this.createBackupFile();
+          }
+        });
+      return true;
+    });
+
+    this._androidBackupsPreference = fragment.requirePreference<SwitchPreferenceCompat>('pref_android_backups');
+    this._androidBackupsPreference.setOnPreferenceChangeListener((preference: Preference, newValue: Object) => {
+      this._prefs.setIsAndroidBackupsEnabled(newValue as boolean);
+      this.updateBackupPreference();
+      if (newValue as boolean) {
+        this._vaultManager.scheduleAndroidBackup();
+      }
+      return false;
+    });
+
+    this._backupsLocationPreference = fragment.requirePreference<Preference>('pref_backups_location');
+    this.updateBackupsLocationSummary();
+    this._backupsLocationPreference.setOnPreferenceClickListener((preference: Preference) => {
+      const currentStrategy = this._prefs.getBackupVersioningStrategy();
+      if (currentStrategy === BackupsVersioningStrategy.MULTIPLE_BACKUPS) {
+        this.selectBackupsLocation();
+      } else if (currentStrategy === BackupsVersioningStrategy.SINGLE_BACKUP) {
+        this.createBackupFile();
+      }
+      return false;
+    });
+
+    this._backupsTriggerPreference = fragment.requirePreference<Preference>('pref_backups_trigger');
+    this._backupsTriggerPreference.setOnPreferenceClickListener((preference: Preference) => {
+      if (this._prefs.isBackupsEnabled()) {
+        this.scheduleBackup();
+        builtinBackupStatusPreference.setVisible(false);
+      }
+      return true;
+    });
+
+    this._backupsVersionsPreference = fragment.requirePreference<Preference>('pref_backups_versions');
+    this.updateBackupsVersionsSummary();
+    this._backupsVersionsPreference.setOnPreferenceClickListener((preference: Preference) => {
+      Dialogs.showBackupVersionsPickerDialog(this.requireContext(), this._prefs.getBackupsVersionCount(),
+        (n: number) => {
+          this._prefs.setBackupsVersionCount(n);
+          this.updateBackupsVersionsSummary();
+        });
+      return false;
+    });
+
+    this.updateBackupPreference();
+  }
+
+  private saveAndDisableBackupReminder(understand: boolean): void {
+    if (understand) {
+      this._prefs.setIsBackupReminderEnabled(false);
+      this.updateBackupPreference();
+    }
+  }
+
+  /**
+   * Called with the URI that was picked by the user (replacement for the activity result).
+   * @param isDirectory whether the URI points to a directory (DocumentsContract.isTreeUri)
+   */
+  private onSelectBackupsLocationResult(uri: string | null, isDirectory: boolean): void {
+    if (uri === null) {
+      return;
+    }
+
+    VaultBackupManager.persistPermission(uri).then(() => {
+      this._prefs.setBackupsLocation(uri, isDirectory);
+      this._prefs.setIsBackupsEnabled(true);
+      this.updateBackupPreference();
+      this.scheduleBackup();
+      this.updateBackupsVersioningStrategySummary();
+      this.updateBackupsLocationSummary();
+    });
+  }
+
+  private updateBackupPreference(): void {
+    if (this._backupsPreference === null || this._androidBackupsPreference === null
+      || this._backupReminderPreference === null || this._versioningStrategyPreference === null
+      || this._backupsLocationPreference === null || this._backupsTriggerPreference === null
+      || this._backupsVersionsPreference === null || this._backupsPasswordWarningPreference === null
+      || this._builtinBackupStatusPreference === null || this._androidBackupStatusPreference === null
+      || !this._vaultManager.isVaultLoaded()) {
+      return;
+    }
+
+    const encrypted = this._vaultManager.getVault().isEncryptionEnabled();
+    const androidBackupEnabled = this._prefs.isAndroidBackupsEnabled() && encrypted;
+    const backupEnabled = this._prefs.isBackupsEnabled() && encrypted;
+    const backupReminderEnabled = this._prefs.isBackupReminderEnabled();
+    this._backupsPasswordWarningPreference.setVisible(this._vaultManager.getVault().isBackupPasswordSet());
+    this._androidBackupsPreference.setChecked(androidBackupEnabled);
+    this._androidBackupsPreference.setEnabled(encrypted);
+    this._backupsPreference.setChecked(backupEnabled);
+    this._backupsPreference.setEnabled(encrypted);
+    this._backupReminderPreference.setChecked(backupReminderEnabled);
+    this._versioningStrategyPreference.setVisible(backupEnabled);
+    this._backupsLocationPreference.setVisible(backupEnabled);
+    this._backupsTriggerPreference.setVisible(backupEnabled);
+    this._backupsVersionsPreference.setVisible(backupEnabled
+      && this._prefs.getBackupVersioningStrategy() !== BackupsVersioningStrategy.SINGLE_BACKUP);
+    if (backupEnabled) {
+      this.updateBackupStatus(this._builtinBackupStatusPreference, this._prefs.getBuiltInBackupResult());
+    }
+    if (androidBackupEnabled) {
+      this.updateBackupStatus(this._androidBackupStatusPreference, this._prefs.getAndroidBackupResult());
+    }
+    this._builtinBackupStatusPreference.setVisible(backupEnabled);
+    this._androidBackupStatusPreference.setVisible(androidBackupEnabled);
+  }
+
+  private updateBackupStatus(pref: Preference, res: BackupResult | null): void {
+    const backupFailed = res !== null && !res.isSuccessful();
+    pref.setStyledSummary(this.getBackupStatusMessage(res), this.getBackupStatusColor(res), true);
+    pref.setSelectable(backupFailed);
+
+    if (backupFailed) {
+      pref.setIcon($r('app.media.ic_outline_error_24'));
+    } else if (res !== null) {
+      pref.setIcon($r('app.media.ic_outline_check_24'));
+    } else {
+      pref.setIcon(null);
+    }
+  }
+
+  private getBackupStatusMessage(res: BackupResult | null): string {
+    if (res === null) {
+      return getString('backup_status_none');
+    } else if (res.isSuccessful()) {
+      return getString('backup_status_success', [res.getElapsedSince(AegisModule.getContext())]);
+    } else {
+      return getString('backup_status_failed', [res.getElapsedSince(AegisModule.getContext())]);
+    }
+  }
+
+  /**
+   * Replacement for the colorError/colorSuccess ForegroundColorSpan of the status message.
+   */
+  private getBackupStatusColor(res: BackupResult | null): ResourceColor {
+    if (res !== null && res.isSuccessful()) {
+      const theme = (this._activity as AegisActivity).getThemeHelper().getConfiguredTheme();
+      return theme === Theme.LIGHT ? $r('app.color.aegis_theme_light_success') : $r('app.color.aegis_theme_dark_success');
+    }
+    return $r('app.color.theme_error');
+  }
+
+  private createBackupFile(): void {
+    this._vaultManager.fireIntentLauncher<string | null>(() => SafHelper.createDocument(VaultBackupManager.FILENAME_SINGLE))
+      .then((uri: string | null) => this.onSelectBackupsLocationResult(uri, false))
+      .catch((e: Error) => {
+        hilog.error(0x0000, 'BackupsPreferences', 'Unable to pick backup file: %{public}s', e.message);
+      });
+  }
+
+  private selectBackupsLocation(): void {
+    this._vaultManager.fireIntentLauncher<string | null>(() => SafHelper.selectFolder())
+      .then((uri: string | null) => this.onSelectBackupsLocationResult(uri, true))
+      .catch((e: Error) => {
+        hilog.error(0x0000, 'BackupsPreferences', 'Unable to pick backup directory: %{public}s', e.message);
+      });
+  }
+
+  private scheduleBackup(): void {
+    try {
+      this._vaultManager.scheduleBackup();
+      (this._activity as AegisActivity).showToast($r('app.string.backup_successful'), true);
+    } catch (e) {
+      Dialogs.showErrorDialog(this.requireContext(), $r('app.string.backup_error'), e as Error);
+    }
+  }
+
+  private updateBackupsVersioningStrategySummary(): void {
+    if (this._versioningStrategyPreference === null) {
+      return;
+    }
+    const currentStrategy = this._prefs.getBackupVersioningStrategy();
+    if (currentStrategy === BackupsVersioningStrategy.MULTIPLE_BACKUPS) {
+      this._versioningStrategyPreference.setSummary($r('app.string.pref_backups_versioning_strategy_keep_x_versions'));
+    } else if (currentStrategy === BackupsVersioningStrategy.SINGLE_BACKUP) {
+      this._versioningStrategyPreference.setSummary($r('app.string.pref_backups_versioning_strategy_single_backup'));
+    }
+  }
+
+  private updateBackupsLocationSummary(): void {
+    if (this._backupsLocationPreference === null) {
+      return;
+    }
+    const backupsLocation = this._prefs.getBackupsLocation();
+    const currentStrategy = this._prefs.getBackupVersioningStrategy();
+    let text: string;
+    if (currentStrategy === BackupsVersioningStrategy.MULTIPLE_BACKUPS) {
+      text = getString('pref_backups_location_summary');
+    } else if (currentStrategy === BackupsVersioningStrategy.SINGLE_BACKUP) {
+      text = getString('pref_backup_location_summary');
+    } else {
+      return;
+    }
+    const location = backupsLocation !== null ? Uri.decode(backupsLocation) : '';
+    this._backupsLocationPreference.setSummary(`${text}: ${location}`);
+  }
+
+  private updateBackupsVersionsSummary(): void {
+    if (this._backupsVersionsPreference === null) {
+      return;
+    }
+    const count = this._prefs.getBackupsVersionCount();
+    if (count === Preferences.BACKUPS_VERSIONS_INFINITE) {
+      this._backupsVersionsPreference.setSummary($r('app.string.pref_backups_versions_infinite_summary'));
+    } else {
+      const summary = ResUtils.getQuantityString(AegisModule.getContext(), 'pref_backups_versions_summary', count, [count]);
+      this._backupsVersionsPreference.setSummary(summary);
+    }
+  }
+
+  private getScreen(): PreferenceScreen {
+    return (this._fragment as PreferencesFragment).getPreferenceScreen();
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.pref_section_backups_title'),
+        backgroundColorValue: ThemeHelper.isAmoled() ? '#000000' : $r('app.color.theme_surface'),
+        onBack: () => {
+          if (this._activity !== null) {
+            this._activity.finish();
+          }
+        }
+      })
+      if (this._fragment !== null) {
+        PreferenceScreenView({ screenProvider: () => this.getScreen(), tick: this.tick })
+      }
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
