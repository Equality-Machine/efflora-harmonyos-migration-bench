@@ -0,0 +1,160 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { SqlImporterHelper, SqlImporterHelperEntry, SqlImporterHelperCursor } from './SqlImporterHelper';
+import { GoogleAuthInfo } from '../otp/GoogleAuthInfo';
+import { HotpInfo } from '../otp/HotpInfo';
+import { OtpInfo } from '../otp/OtpInfo';
+import { TotpInfo } from '../otp/TotpInfo';
+import { ResUtils } from '../util/ResUtils';
+import { VaultEntry } from '../vault/VaultEntry';
+
+const TYPE_TOTP: number = 0;
+
+const TYPE_HOTP: number = 1;
+
+const _subPath: string = 'databases/databases';
+
+const _pkgName: string = 'com.google.android.apps.authenticator2';
+
+export class GoogleAuthImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    const file = this.getAppPathForPackage(_pkgName, _subPath);
+    return file;
+  }
+
+  /**
+   * The version of the installed Google Authenticator app can't be determined on HarmonyOS (Android
+   * apps can't be queried), which is treated the same as the app not being installed.
+   */
+  isInstalledAppVersionSupported(): boolean {
+    return false;
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    const context = this.requireContext();
+    const helper = new SqlImporterHelper(context);
+    const entries = await helper.read<GoogleAuthImporterEntry>((cursor: SqlImporterHelperCursor) => new GoogleAuthImporterEntry(cursor), stream, 'accounts');
+    return new GoogleAuthImporterState(entries, context);
+  }
+
+  async readFromApp(): Promise<DatabaseImporterState> {
+    const path = this.getAppPath();
+    const context = this.requireContext();
+    const helper = new SqlImporterHelper(context);
+    const entries = await helper.readFromPath<GoogleAuthImporterEntry>((cursor: SqlImporterHelperCursor) => new GoogleAuthImporterEntry(cursor), path, 'accounts');
+    return new GoogleAuthImporterState(entries, context);
+  }
+}
+
+export class GoogleAuthImporterState extends DatabaseImporterState {
+  private _entries: GoogleAuthImporterEntry[];
+  private _context: common.Context;
+
+  constructor(entries: GoogleAuthImporterEntry[], context: common.Context) {
+    super(false);
+    this._entries = entries;
+    this._context = context;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    for (const sqlEntry of this._entries) {
+      try {
+        const entry = GoogleAuthImporterState.convertEntry(sqlEntry, this._context);
+        result.addEntry(entry);
+      }
+      catch (e) {
+        result.addError(e as DatabaseImporterEntryException);
+      }
+    }
+    return result;
+  }
+
+  private static convertEntry(entry: GoogleAuthImporterEntry, context: common.Context): VaultEntry {
+    try {
+      if (entry.isEncrypted()) {
+        throw new DatabaseImporterException(ResUtils.getString(context, 'importer_encrypted_exception_google_authenticator', [entry.getEmail()]));
+      }
+      const secretString = entry.getSecret();
+      if (secretString === null) {
+        throw new DatabaseImporterException('Secret is empty');
+      }
+      const secret = GoogleAuthInfo.parseSecret(secretString);
+      let info: OtpInfo;
+      switch (entry.getType()) {
+        case TYPE_TOTP:
+          info = new TotpInfo(secret);
+          break;
+        case TYPE_HOTP:
+          info = new HotpInfo(secret, OtpInfo.DEFAULT_ALGORITHM, OtpInfo.DEFAULT_DIGITS, entry.getCounter());
+          break;
+        default:
+          throw new DatabaseImporterException('unsupported otp type: ' + entry.getType());
+      }
+      let name = entry.getEmail();
+      const parts = name.split(':');
+      if (parts.length === 2) {
+        name = parts[1];
+      }
+      return new VaultEntry(info, name, entry.getIssuer());
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, entry.toString());
+    }
+  }
+}
+
+export class GoogleAuthImporterEntry extends SqlImporterHelperEntry {
+  private _type: number;
+  private _isEncrypted: boolean;
+  private _secret: string | null;
+  private _email: string;
+  private _issuer: string;
+  private _counter: number;
+
+  constructor(cursor: SqlImporterHelperCursor) {
+    super(cursor);
+    this._type = SqlImporterHelper.getInt(cursor, 'type');
+    this._secret = SqlImporterHelper.getString(cursor, 'secret');
+    this._email = SqlImporterHelper.getStringOrDefault(cursor, 'email', '');
+    this._issuer = SqlImporterHelper.getStringOrDefault(cursor, 'issuer', '');
+    this._counter = SqlImporterHelper.getLong(cursor, 'counter');
+    this._isEncrypted = (SqlImporterHelper.getColumnIndex(cursor, 'isencrypted') !== -1
+      && SqlImporterHelper.getInt(cursor, 'isencrypted') > 0);
+  }
+
+  getType(): number {
+    return this._type;
+  }
+
+  isEncrypted(): boolean {
+    return this._isEncrypted;
+  }
+
+  getSecret(): string | null {
+    return this._secret;
+  }
+
+  getEmail(): string {
+    return this._email;
+  }
+
+  getIssuer(): string {
+    return this._issuer;
+  }
+
+  getCounter(): number {
+    return this._counter;
+  }
+
+  toString(): string {
+    return `GoogleAuthImporterEntry{type=${this._type}, email=${this._email}, issuer=${this._issuer}, ` +
+      `counter=${this._counter}, isEncrypted=${this._isEncrypted}}`;
+  }
+}
