@@ -0,0 +1,84 @@
+import { XmlPullParser, XmlPullParserException } from './XmlPullParser';
+
+export class PreferenceParserXmlEntry {
+  Name: string = '';
+  Value: string = '';
+}
+
+/**
+ * Parses the string entries of an Android SharedPreferences XML file.
+ */
+export class PreferenceParser {
+  private constructor() {
+  }
+
+  static parse(parser: XmlPullParser): PreferenceParserXmlEntry[] {
+    const entries: PreferenceParserXmlEntry[] = [];
+    parser.require(XmlPullParser.START_TAG, null, 'map');
+    while (parser.next() !== XmlPullParser.END_TAG) {
+      if (parser.getEventType() !== XmlPullParser.START_TAG) {
+        continue;
+      }
+      if (parser.getName() !== 'string') {
+        PreferenceParser.skip(parser);
+        continue;
+      }
+      entries.push(PreferenceParser.parseEntry(parser));
+    }
+    return entries;
+  }
+
+  /**
+   * Convenience method: creates a parser for the given SharedPreferences XML file contents and parses it.
+   */
+  static parseBytes(data: Uint8Array): PreferenceParserXmlEntry[] {
+    const parser = XmlPullParser.newPullParser();
+    parser.setFeature(XmlPullParser.FEATURE_PROCESS_NAMESPACES, false);
+    parser.setInput(data, null);
+    parser.nextTag();
+    return PreferenceParser.parse(parser);
+  }
+
+  private static parseEntry(parser: XmlPullParser): PreferenceParserXmlEntry {
+    parser.require(XmlPullParser.START_TAG, null, 'string');
+    const name = parser.getAttributeValue(null, 'name');
+    const value = PreferenceParser.parseText(parser);
+    parser.require(XmlPullParser.END_TAG, null, 'string');
+    const entry = new PreferenceParserXmlEntry();
+    entry.Name = name !== null ? name : '';
+    entry.Value = value;
+    return entry;
+  }
+
+  private static parseText(parser: XmlPullParser): string {
+    let text = '';
+    if (parser.next() === XmlPullParser.TEXT) {
+      const t = parser.getText();
+      text = t !== null ? t : '';
+      parser.nextTag();
+    }
+    return text;
+  }
+
+  private static skip(parser: XmlPullParser): void {
+    // source: https://developer.android.com/training/basics/network-ops/xml.html
+    if (parser.getEventType() !== XmlPullParser.START_TAG) {
+      throw new XmlPullParserException('Illegal state');
+    }
+    let depth = 1;
+    while (depth !== 0) {
+      switch (parser.next()) {
+        case XmlPullParser.END_TAG:
+          depth--;
+          break;
+        case XmlPullParser.START_TAG:
+          depth++;
+          break;
+        case XmlPullParser.END_DOCUMENT:
+          throw new XmlPullParserException('Unexpected end of document');
+        default:
+          break;
+      }
+    }
+  }
+}
diff --git a/entry/src/main/ets/util/Protobuf.ets b/entry/src/main/ets/util/Protobuf.ets
new file mode 100644
index 0000000..b2913f8
--- /dev/null
+++ b/entry/src/main/ets/util/Protobuf.ets
@@ -0,0 +1,137 @@
+import { Bytes } from './Bytes';
+
+/**
+ * Minimal protocol buffers wire format reader/writer (replacement for the protobuf-lite runtime).
+ */
+export class ProtoField {
+  fieldNumber: number;
+  wireType: number;
+  varint: bigint = BigInt(0);
+  bytes: Uint8Array = new Uint8Array(0);
+
+  constructor(fieldNumber: number, wireType: number) {
+    this.fieldNumber = fieldNumber;
+    this.wireType = wireType;
+  }
+
+  asNumber(): number {
+    return Number(BigInt.asIntN(64, this.varint));
+  }
+
+  asString(): string {
+    return Bytes.toUtf8(this.bytes);
+  }
+}
+
+export class ProtoReader {
+  private _data: Uint8Array;
+  private _pos: number = 0;
+
+  constructor(data: Uint8Array) {
+    this._data = data;
+  }
+
+  hasMore(): boolean {
+    return this._pos < this._data.length;
+  }
+
+  private readVarint(): bigint {
+    let result = BigInt(0);
+    let shift = BigInt(0);
+    while (true) {
+      if (this._pos >= this._data.length) {
+        throw new Error('Truncated varint');
+      }
+      const b = this._data[this._pos++];
+      result = result | (BigInt(b & 0x7f) << shift);
+      if ((b & 0x80) === 0) {
+        break;
+      }
+      shift += BigInt(7);
+      if (shift > BigInt(70)) {
+        throw new Error('Malformed varint');
+      }
+    }
+    return result;
+  }
+
+  readField(): ProtoField {
+    const key = Number(this.readVarint());
+    const field = new ProtoField(key >>> 3, key & 7);
+    switch (field.wireType) {
+      case 0:
+        field.varint = this.readVarint();
+        break;
+      case 1:
+        field.bytes = Bytes.copyOfRange(this._data, this._pos, this._pos + 8);
+        this._pos += 8;
+        break;
+      case 2: {
+        const len = Number(this.readVarint());
+        if (this._pos + len > this._data.length) {
+          throw new Error('Truncated message');
+        }
+        field.bytes = Bytes.copyOfRange(this._data, this._pos, this._pos + len);
+        this._pos += len;
+        break;
+      }
+      case 5:
+        field.bytes = Bytes.copyOfRange(this._data, this._pos, this._pos + 4);
+        this._pos += 4;
+        break;
+      default:
+        throw new Error(`Unsupported wire type: ${field.wireType}`);
+    }
+    return field;
+  }
+
+  readAll(): ProtoField[] {
+    const fields: ProtoField[] = [];
+    while (this.hasMore()) {
+      fields.push(this.readField());
+    }
+    return fields;
+  }
+}
+
+export class ProtoWriter {
+  private _parts: number[] = [];
+
+  private writeVarint(value: bigint): void {
+    let v = BigInt.asUintN(64, value);
+    while (v >= BigInt(0x80)) {
+      this._parts.push(Number(v & BigInt(0x7f)) | 0x80);
+      v = v >> BigInt(7);
+    }
+    this._parts.push(Number(v));
+  }
+
+  writeVarintField(fieldNumber: number, value: number): ProtoWriter {
+    if (value === 0) {
+      return this;
+    }
+    this.writeVarint(BigInt(fieldNumber << 3));
+    this.writeVarint(BigInt(Math.trunc(value)));
+    return this;
+  }
+
+  writeBytesField(fieldNumber: number, value: Uint8Array): ProtoWriter {
+    this.writeVarint(BigInt((fieldNumber << 3) | 2));
+    this.writeVarint(BigInt(value.length));
+    for (let i = 0; i < value.length; i++) {
+      this._parts.push(value[i]);
+    }
+    return this;
+  }
+
+  writeStringField(fieldNumber: number, value: string): ProtoWriter {
+    if (value.length === 0) {
+      return this;
+    }
+    return this.writeBytesField(fieldNumber, Bytes.fromUtf8(value));
+  }
+
+  toBytes(): Uint8Array {
+    return new Uint8Array(this._parts);
+  }
+}
