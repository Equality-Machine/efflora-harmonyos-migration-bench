@@ -0,0 +1,54 @@
+import { UUIDMapValue } from '../util/UUIDMap';
+import { UUID } from '../util/UUID';
+import { JSONObject } from '../util/JSONObject';
+import { VaultEntryException } from './VaultEntryException';
+
+export class VaultGroup extends UUIDMapValue {
+  private _name: string;
+
+  constructor(name: string, uuid?: string) {
+    super(uuid);
+    this._name = name;
+  }
+
+  toJson(): JSONObject {
+    const obj = new JSONObject();
+    obj.put('uuid', this.getUUID());
+    obj.put('name', this._name);
+    return obj;
+  }
+
+  static fromJson(obj: JSONObject): VaultGroup {
+    try {
+      const uuid = UUID.fromString(obj.getString('uuid'));
+      const groupName = obj.getString('name');
+      return new VaultGroup(groupName, uuid);
+    } catch (e) {
+      throw new VaultEntryException((e as Error).message);
+    }
+  }
+
+  equals(o: Object | null): boolean {
+    if (!(o instanceof VaultGroup)) {
+      return false;
+    }
+    const entry = o as VaultGroup;
+    return super.equals(entry) && this.getName() === entry.getName();
+  }
+
+  getName(): string {
+    return this._name;
+  }
+
+  setName(name: string): void {
+    this._name = name;
+  }
+
+  toString(): string {
+    return this._name;
+  }
+
+  clone(): VaultGroup {
+    return new VaultGroup(this._name, this.getUUID());
+  }
+}
diff --git a/entry/src/main/ets/vault/VaultHtmlExporter.ets b/entry/src/main/ets/vault/VaultHtmlExporter.ets
new file mode 100644
index 0000000..ccc598b
--- /dev/null
+++ b/entry/src/main/ets/vault/VaultHtmlExporter.ets
@@ -0,0 +1,102 @@
+import { common } from '@kit.AbilityKit';
+import { VaultEntry } from './VaultEntry';
+import { GoogleAuthInfo } from '../otp/GoogleAuthInfo';
+import { MotpInfo } from '../otp/MotpInfo';
+import { HotpInfo } from '../otp/HotpInfo';
+import { YandexInfo } from '../otp/YandexInfo';
+import { Hex } from '../encoding/Hex';
+import { Base32 } from '../encoding/Base32';
+import { QrCodeHelper } from '../helpers/QrCodeHelper';
+import { ResUtils } from '../util/ResUtils';
+
+export class VaultHtmlExporter {
+  private constructor() {
+  }
+
+  static async export(context: common.Context, entries: VaultEntry[]): Promise<string> {
+    const title = ResUtils.getString(context, 'export_html_title');
+    let ps = '';
+    ps += '<html><head><title>';
+    ps += title;
+    ps += '</title></head><body>';
+    ps += '<h1>';
+    ps += title;
+    ps += '</h1>';
+    ps += '<table>';
+    ps += '<tr>';
+    ps += '<th>Issuer</th>';
+    ps += '<th>Name</th>';
+    ps += '<th>Type</th>';
+    ps += '<th>QR Code</th>';
+    ps += '<th>UUID</th>';
+    ps += '<th>Note</th>';
+    ps += '<th>Favorite</th>';
+    ps += '<th>Algo</th>';
+    ps += '<th>Digits</th>';
+    ps += '<th>Secret</th>';
+    ps += '<th>Counter</th>';
+    ps += '<th>PIN</th>';
+    ps += '</tr>';
+    for (const entry of entries) {
+      ps += '<tr>';
+      const info = entry.getInfo();
+      const gaInfo = new GoogleAuthInfo(info, entry.getName(), entry.getIssuer());
+      ps += VaultHtmlExporter.appendRow(entry.getIssuer());
+      ps += VaultHtmlExporter.appendRow(entry.getName());
+      ps += VaultHtmlExporter.appendRow(info.getType());
+      ps += await VaultHtmlExporter.appendQrRow(gaInfo.getUri().toString());
+      ps += VaultHtmlExporter.appendRow(entry.getUUID());
+      ps += VaultHtmlExporter.appendRow(entry.getNote());
+      ps += VaultHtmlExporter.appendRow(`${entry.isFavorite()}`);
+      ps += VaultHtmlExporter.appendRow(info.getAlgorithm(false));
+      ps += VaultHtmlExporter.appendRow(`${info.getDigits()}`);
+      if (info instanceof MotpInfo) {
+        ps += VaultHtmlExporter.appendRow(Hex.encode(info.getSecret()));
+      } else {
+        ps += VaultHtmlExporter.appendRow(Base32.encode(info.getSecret()));
+      }
+      if (info instanceof HotpInfo) {
+        ps += VaultHtmlExporter.appendRow(`${(info as HotpInfo).getCounter()}`);
+      } else {
+        ps += VaultHtmlExporter.appendRow('-');
+      }
+      if (info instanceof YandexInfo) {
+        const pin = (info as YandexInfo).getPin();
+        ps += VaultHtmlExporter.appendRow(pin !== null ? pin : '');
+      } else if (info instanceof MotpInfo) {
+        const pin = (info as MotpInfo).getPin();
+        ps += VaultHtmlExporter.appendRow(pin !== null ? pin : '');
+      } else {
+        ps += VaultHtmlExporter.appendRow('-');
+      }
+      ps += '</tr>';
+    }
+    ps += '</table></body>';
+    ps += '<style>table,td,th{border:1px solid #000;border-collapse:collapse;text-align:center}td:not(.qr),th{padding:1em}</style>';
+    ps += '</html>';
+    return ps;
+  }
+
+  private static appendRow(s: string): string {
+    return `<td>${VaultHtmlExporter.escape(s)}</td>`;
+  }
+
+  private static async appendQrRow(s: string): Promise<string> {
+    try {
+      const encoded = await QrCodeHelper.encodeToBase64Png(s, 256, 256);
+      return `<td class='qr'><img src="data:image/png;base64,${encoded}"/></td>`;
+    } catch (e) {
+      // QR images cannot be generated on every device (e.g. no barcode generation service): export the
+      // rest of the table instead of failing the whole export
+      return `<td class='qr'></td>`;
+    }
+  }
+
+  private static escape(s: string): string {
+    return s.replace(new RegExp('&', 'g'), '&amp;')
+      .replace(new RegExp('<', 'g'), '&lt;')
+      .replace(new RegExp('>', 'g'), '&gt;')
+      .replace(new RegExp('"', 'g'), '&quot;')
+      .replace(new RegExp('\'', 'g'), '&#39;');
+  }
+}
diff --git a/entry/src/main/ets/vault/VaultManager.ets b/entry/src/main/ets/vault/VaultManager.ets
new file mode 100644
index 0000000..cb0827f
--- /dev/null
+++ b/entry/src/main/ets/vault/VaultManager.ets
@@ -0,0 +1,245 @@
+import { common } from '@kit.AbilityKit';
+import { Preferences, BackupResult } from '../Preferences';
+import { AuditLogRepository } from '../database/AuditLogRepository';
+import { KeyStoreHandle } from '../crypto/KeyStoreHandle';
+import { VaultRepository } from './VaultRepository';
+import { VaultFile } from './VaultFile';
+import { VaultFileCredentials } from './VaultFileCredentials';
+import { Vault } from './Vault';
+import { VaultBackupManager } from './VaultBackupManager';
+import { VaultRepositoryException } from './VaultRepositoryException';
+import { NotificationService } from '../services/NotificationService';
+import { IOUtils } from '../util/IOUtils';
+import { AegisModule } from '../AegisModule';
+import { AegisGlideModule } from '../ui/glide/AegisGlideModule';
+
+export interface LockListener {
+  /**
+   * Called when the vault lock status changes
+   * @param userInitiated whether or not the user initiated the lock in MainActivity.
+   */
+  onLocked(userInitiated: boolean): void;
+}
+
+export class VaultManager {
+  private readonly _context: common.Context;
+  private readonly _prefs: Preferences;
+
+  private _repo: VaultRepository | null = null;
+
+  private readonly _backups: VaultBackupManager;
+
+  private _lockListeners: LockListener[] = [];
+  private _blockAutoLock: boolean = false;
+
+  private readonly _auditLogRepository: AuditLogRepository;
+
+  constructor(context: common.Context, auditLogRepository: AuditLogRepository) {
+    this._context = context;
+    this._prefs = AegisModule.getPreferences();
+    this._backups = new VaultBackupManager(context, auditLogRepository);
+    this._auditLogRepository = auditLogRepository;
+  }
+
+  /**
+   * Initializes the vault repository with a new empty vault and the given creds. It can
+   * only be called if isVaultLoaded() returns false.
+   */
+  initNew(creds: VaultFileCredentials | null): VaultRepository {
+    if (this.isVaultLoaded()) {
+      throw new Error('Vault manager is already initialized');
+    }
+
+    const repo = new VaultRepository(this._context, new Vault(), creds);
+    repo.save();
+    this._repo = repo;
+
+    if (this.getVault().isEncryptionEnabled()) {
+      this.startNotificationService();
+    }
+
+    return this.getVault();
+  }
+
+  /**
+   * Initializes the vault repository by decrypting the given vaultFile with the given
+   * creds. It can only be called if isVaultLoaded() returns false.
+   */
+  loadFrom(vaultFile: VaultFile, creds?: VaultFileCredentials | null): VaultRepository {
+    if (this.isVaultLoaded()) {
+      throw new Error('Vault manager is already initialized');
+    }
+
+    this._repo = VaultRepository.fromFile(this._context, vaultFile, creds !== undefined ? creds : null);
+
+    if (this.getVault().isEncryptionEnabled()) {
+      this.startNotificationService();
+    }
+
+    return this.getVault();
+  }
+
+  /**
+   * Locks the vault and the app.
+   * @param userInitiated whether or not the user initiated the lock in MainActivity.
+   */
+  lock(userInitiated: boolean): void {
+    this._repo = null;
+    // don't keep decrypted icons in memory while the vault is locked
+    AegisGlideModule.clearMemory();
+
+    for (const listener of this._lockListeners.slice()) {
+      listener.onLocked(userInitiated);
+    }
+
+    this.stopNotificationService();
+  }
+
+  enableEncryption(creds: VaultFileCredentials): void {
+    this.getVault().setCredentials(creds);
+    this.saveAndBackup();
+    this.startNotificationService();
+  }
+
+  async disableEncryption(): Promise<void> {
+    this.getVault().setCredentials(null);
+    this.save();
+
+    // remove any keys that are stored in the KeyStore
+    try {
+      const handle = new KeyStoreHandle();
+      await handle.clear();
+    } catch (e) {
+      // this cleanup operation is not strictly necessary, so we ignore any exceptions here
+    }
+
+    this.stopNotificationService();
+  }
+
+  save(): void {
+    this.getVault().save();
+  }
+
+  saveAndBackup(): void {
+    this.save();
+
+    let backedUp = false;
+    if (this.getVault().isEncryptionEnabled()) {
+      if (this._prefs.isBackupsEnabled()) {
+        backedUp = true;
+        try {
+          this.scheduleBackup();
+        } catch (e) {
+          this._prefs.setBuiltInBackupResult(BackupResult.fromException(e as Error));
+        }
+      }
+
+      if (this._prefs.isAndroidBackupsEnabled()) {
+        backedUp = true;
+        this.scheduleAndroidBackup();
+      }
+    }
+
+    if (!backedUp) {
+      this._prefs.setIsBackupReminderNeeded(true);
+    }
+  }
+
+  scheduleBackup(): void {
+    this._prefs.setIsBackupReminderNeeded(false);
+
+    try {
+      const dir = `${this._context.cacheDir}/backup`;
+      IOUtils.mkdirs(dir);
+      const tempFile = `${dir}/${VaultBackupManager.FILENAME_PREFIX}-${Date.now()}.json`;
+      IOUtils.writeFile(tempFile, (this._repo as VaultRepository).export());
+
+      const strategy = this._prefs.getBackupVersioningStrategy();
+      const uri = this._prefs.getBackupsLocation();
+      const versionsToKeep = this._prefs.getBackupsVersionCount();
+
+      this._backups.scheduleBackup(tempFile, strategy, uri, versionsToKeep);
+    } catch (e) {
+      throw new VaultRepositoryException((e as Error).message);
+    }
+  }
+
+  /**
+   * The system backup (BackupExtensionAbility) is triggered by the system, so there is nothing to
+   * schedule here except for clearing the reminder (replacement for BackupManager.dataChanged()).
+   */
+  scheduleAndroidBackup(): void {
+    this._prefs.setIsBackupReminderNeeded(false);
+  }
+
+  getBackupManager(): VaultBackupManager {
+    return this._backups;
+  }
+
+  isAutoLockEnabled(autoLockType: number): boolean {
+    return this._prefs.isAutoLockTypeEnabled(autoLockType)
+      && this.isVaultLoaded()
+      && this.getVault().isEncryptionEnabled();
+  }
+
+  registerLockListener(listener: LockListener): void {
+    if (this._lockListeners.indexOf(listener) < 0) {
+      this._lockListeners.push(listener);
+    }
+  }
+
+  unregisterLockListener(listener: LockListener): void {
+    this._lockListeners = this._lockListeners.filter((l: LockListener) => l !== listener);
+  }
+
+  /**
+   * Sets whether to block automatic lock on minimization. This should only be called
+   * by pages before invoking a picker, because that action leads the app to believe that
+   * it has been minimized.
+   */
+  setBlockAutoLock(block: boolean): void {
+    this._blockAutoLock = block;
+  }
+
+  /**
+   * Reports whether automatic lock on minimization is currently blocked.
+   */
+  isAutoLockBlocked(): boolean {
+    return this._blockAutoLock;
+  }
+
+  isVaultLoaded(): boolean {
+    return this._repo !== null;
+  }
+
+  isVaultInitNeeded(): boolean {
+    return !this.isVaultLoaded() && !VaultRepository.fileExists(this._context);
+  }
+
+  getVault(): VaultRepository {
+    if (this._repo === null) {
+      throw new Error('Vault manager is not initialized');
+    }
+    return this._repo;
+  }
+
+  /**
+   * Starts an external picker, temporarily blocks automatic lock of Aegis.
+   */
+  async fireIntentLauncher<T>(launcher: () => Promise<T>): Promise<T> {
+    this.setBlockAutoLock(true);
+    try {
+      return await launcher();
+    } finally {
+      // the block is lifted again when the page is shown (see AegisActivity.onPageShow)
+    }
+  }
+
+  private startNotificationService(): void {
+    NotificationService.start(this._context);
+  }
+
+  private stopNotificationService(): void {
+    NotificationService.stop();
+  }
+}
diff --git a/entry/src/main/ets/vault/VaultRepository.ets b/entry/src/main/ets/vault/VaultRepository.ets
new file mode 100644
index 0000000..6914db9
--- /dev/null
+++ b/entry/src/main/ets/vault/VaultRepository.ets
@@ -0,0 +1,309 @@
+import { common } from '@kit.AbilityKit';
+import { fileIo } from '@kit.CoreFileKit';
+import { Vault, EntryFilter } from './Vault';
+import { VaultEntry } from './VaultEntry';
+import { VaultGroup } from './VaultGroup';
+import { VaultFile } from './VaultFile';
+import { VaultFileCredentials } from './VaultFileCredentials';
+import { VaultRepositoryException } from './VaultRepositoryException';
+import { VaultHtmlExporter } from './VaultHtmlExporter';
+import { GoogleAuthInfo } from '../otp/GoogleAuthInfo';
+import { JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+import { IOUtils } from '../util/IOUtils';
+import { Cloner } from '../util/Cloner';
+
+export type EntryEditor = (entry: VaultEntry) => void;
+
+export class VaultRepository {
+  static readonly FILENAME: string = 'aegis.json';
+  static readonly FILENAME_PREFIX_EXPORT: string = 'aegis-export';
+  static readonly FILENAME_PREFIX_EXPORT_PLAIN: string = 'aegis-export-plain';
+  static readonly FILENAME_PREFIX_EXPORT_URI: string = 'aegis-export-uri';
+  static readonly FILENAME_PREFIX_EXPORT_HTML: string = 'aegis-export-html';
+
+  private readonly _vault: Vault;
+  private _creds: VaultFileCredentials | null;
+  private readonly _context: common.Context;
+
+  constructor(context: common.Context, vault: Vault, creds: VaultFileCredentials | null) {
+    this._context = context;
+    this._vault = vault;
+    this._creds = creds;
+  }
+
+  private static getFilePath(context: common.Context): string {
+    return `${context.filesDir}/${VaultRepository.FILENAME}`;
+  }
+
+  private static getNewFilePath(context: common.Context): string {
+    return `${context.filesDir}/${VaultRepository.FILENAME}.new`;
+  }
+
+  static fileExists(context: common.Context): boolean {
+    const path = VaultRepository.getFilePath(context);
+    try {
+      return fileIo.accessSync(path) && fileIo.statSync(path).isFile();
+    } catch (e) {
+      return false;
+    }
+  }
+
+  static deleteFile(context: common.Context): void {
+    try {
+      fileIo.unlinkSync(VaultRepository.getFilePath(context));
+    } catch (e) {
+      // ignore
+    }
+  }
+
+  static readVaultFile(context: common.Context): VaultFile {
+    try {
+      const fileBytes = IOUtils.readFile(VaultRepository.getFilePath(context));
+      return VaultFile.fromBytes(fileBytes);
+    } catch (e) {
+      throw new VaultRepositoryException((e as Error).message);
+    }
+  }
+
+  /**
+   * Atomically writes the given data to the vault file (replacement for AtomicFile).
+   */
+  static writeToFile(context: common.Context, data: Uint8Array): void {
+    const newPath = VaultRepository.getNewFilePath(context);
+    IOUtils.writeFile(newPath, data);
+    fileIo.renameSync(newPath, VaultRepository.getFilePath(context));
+  }
+
+  static fromFile(context: common.Context, file: VaultFile, creds: VaultFileCredentials | null): VaultRepository {
+    if (file.isEncrypted() && creds === null) {
+      throw new Error('The VaultFile is encrypted but the given VaultFileCredentials is null');
+    }
+
+    let vault: Vault;
+    try {
+      let obj: JSONObject;
+      if (!file.isEncrypted()) {
+        obj = file.getContent();
+      } else {
+        obj = file.getContentDecrypted(creds as VaultFileCredentials);
+      }
+      vault = Vault.fromJson(obj);
+    } catch (e) {
+      throw new VaultRepositoryException((e as Error).message);
+    }
+
+    return new VaultRepository(context, vault, creds);
+  }
+
+  save(): void {
+    try {
+      const obj = this._vault.toJson();
+      const file = new VaultFile();
+      if (this.isEncryptionEnabled()) {
+        file.setContentEncrypted(obj, this._creds as VaultFileCredentials);
+      } else {
+        file.setContent(obj);
+      }
+      VaultRepository.writeToFile(this._context, file.toBytes());
+    } catch (e) {
+      throw new VaultRepositoryException((e as Error).message);
+    }
+  }
+
+  /**
+   * Exports the vault by serializing it. If encryption is enabled, the vault will be encrypted automatically.
+   */
+  export(): Uint8Array {
+    return this.exportFiltered(this.getCredentials(), null);
+  }
+
+  /**
+   * Exports the vault by serializing it. If creds is not null, it will be used to encrypt the
+   * vault first. If filter is not null only specified entries will be exported.
+   */
+  exportFiltered(credentials: VaultFileCredentials | null, filter: EntryFilter | null): Uint8Array {
+    let creds = credentials;
+    if (creds !== null) {
+      creds = creds.exportable();
+    }
+
+    try {
+      const vaultFile = new VaultFile();
+      if (creds !== null) {
+        vaultFile.setContentEncrypted(this._vault.toJson(filter), creds);
+      } else {
+        vaultFile.setContent(this._vault.toJson(filter));
+      }
+      return vaultFile.toBytes();
+    } catch (e) {
+      throw new VaultRepositoryException((e as Error).message);
+    }
+  }
+
+  /**
+   * Exports the vault by serializing the list of entries to a newline-separated list of
+   * Google Authenticator URI's.
+   */
+  exportGoogleUris(filter: EntryFilter | null): Uint8Array {
+    let s = '';
+    for (const entry of this.getEntries()) {
+      if (filter === null || filter.includeEntry(entry)) {
+        const info = new GoogleAuthInfo(entry.getInfo(), entry.getName(), entry.getIssuer());
+        s += info.getUri().toString() + '\n';
+      }
+    }
+    return Bytes.fromUtf8(s);
+  }
+
+  /**
+   * Exports the vault by serializing the list of entries to an HTML file containing the Issuer,
+   * Username and QR Code.
+   */
+  async exportHtml(filter: EntryFilter | null): Promise<Uint8Array> {
+    let entries = this.getEntries();
+    if (filter !== null) {
+      entries = entries.filter((e: VaultEntry) => filter.includeEntry(e));
+    }
+    try {
+      const html = await VaultHtmlExporter.export(this._context, entries);
+      return Bytes.fromUtf8(html);
+    } catch (e) {
+      throw new VaultRepositoryException((e as Error).message);
+    }
+  }
+
+  addEntry(entry: VaultEntry): void {
+    // Entries added by importing a file may contain an old group that needs to be migrated
+    this._vault.migrateOldGroup(entry);
+    this._vault.getEntries().add(entry);
+  }
+
+  hasEntryByUUID(uuid: string): boolean {
+    return this._vault.getEntries().hasUUID(uuid);
+  }
+
+  getEntryByUUID(uuid: string): VaultEntry {
+    return this._vault.getEntries().getByUUID(uuid);
+  }
+
+  removeEntry(entry: VaultEntry): VaultEntry {
+    return this._vault.getEntries().remove(entry);
+  }
+
+  /**
+   * Wipes all entries and groups from the vault.
+   */
+  wipeContents(): void {
+    this._vault.getEntries().wipe();
+    this._vault.getGroups().wipe();
+  }
+
+  replaceEntry(entry: VaultEntry): VaultEntry {
+    return this._vault.getEntries().replace(entry);
+  }
+
+  editEntry(entry: VaultEntry, editor: EntryEditor): VaultEntry {
+    const newEntry = Cloner.cloneEntry(entry);
+    editor(newEntry);
+    this.replaceEntry(newEntry);
+    return newEntry;
+  }
+
+  /**
+   * Moves entry1 to the position of entry2.
+   */
+  moveEntry(entry1: VaultEntry, entry2: VaultEntry): void {
+    this._vault.getEntries().move(entry1, entry2);
+  }
+
+  isEntryDuplicate(entry: VaultEntry): boolean {
+    return this._vault.getEntries().has(entry);
+  }
+
+  getEntries(): VaultEntry[] {
+    return this._vault.getEntries().getValues();
+  }
+
+  addGroup(group: VaultGroup): void {
+    this._vault.getGroups().add(group);
+  }
+
+  getGroupByUUID(uuid: string): VaultGroup {
+    return this._vault.getGroups().getByUUID(uuid);
+  }
+
+  findGroupByUUID(uuid: string): VaultGroup | null {
+    return this._vault.getGroups().hasUUID(uuid) ? this._vault.getGroups().getByUUID(uuid) : null;
+  }
+
+  findGroupByName(name: string): VaultGroup | null {
+    const group = this._vault.getGroups().getValues().find((g: VaultGroup) => g.getName() === name);
+    return group !== undefined ? group : null;
+  }
+
+  removeGroupByUUID(groupUuid: string): void {
+    const group = this._vault.getGroups().getByUUID(groupUuid);
+    this.removeGroup(group);
+  }
+
+  replaceGroups(groups: VaultGroup[]): void {
+    this._vault.getGroups().wipe();
+    for (const group of groups) {
+      this._vault.getGroups().add(group);
+    }
+  }
+
+  removeGroup(group: VaultGroup): void {
+    for (const entry of this.getEntries()) {
+      entry.removeGroup(group.getUUID());
+    }
+    this._vault.getGroups().remove(group);
+  }
+
+  getGroups(): VaultGroup[] {
+    return this._vault.getGroups().getValues();
+  }
+
+  getUsedGroups(): VaultGroup[] {
+    const usedGroups = new Set<string>();
+    for (const entry of this.getEntries()) {
+      for (const g of Array.from(entry.getGroups())) {
+        usedGroups.add(g);
+      }
+    }
+    return this.getGroups().filter((vg: VaultGroup) => usedGroups.has(vg.getUUID()));
+  }
+
+  isGroupsMigrationFresh(): boolean {
+    return this._vault.isGroupsMigrationFresh();
+  }
+
+  areIconsOptimized(): boolean {
+    return this._vault.areIconsOptimized();
+  }
+
+  setIconsOptimized(optimized: boolean): void {
+    this._vault.setIconsOptimized(optimized);
+  }
+
+  getCredentials(): VaultFileCredentials | null {
+    return this._creds === null ? null : Cloner.cloneCredentials(this._creds);
+  }
+
+  setCredentials(creds: VaultFileCredentials | null): void {
+    this._creds = creds === null ? null : creds.clone();
+  }
+
+  isEncryptionEnabled(): boolean {
+    return this._creds !== null;
+  }
+
+  isBackupPasswordSet(): boolean {
+    if (!this.isEncryptionEnabled()) {
+      return false;
+    }
+    const creds = this.getCredentials() as VaultFileCredentials;
+    return creds.getSlots().findBackupPasswordSlots().length > 0;
+  }
+}
