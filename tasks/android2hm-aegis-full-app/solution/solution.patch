diff --git a/entry/src/main/ets/services/NotificationService.ets b/entry/src/main/ets/services/NotificationService.ets
new file mode 100644
index 0000000..c8c61d2
--- /dev/null
+++ b/entry/src/main/ets/services/NotificationService.ets
@@ -0,0 +1,81 @@
+import { common, wantAgent, WantAgent } from '@kit.AbilityKit';
+import { notificationManager } from '@kit.NotificationKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+import { VaultLockReceiver } from '../receivers/VaultLockReceiver';
+import { ResUtils } from '../util/ResUtils';
+
+/**
+ * Port of the NotificationService: shows an ongoing notification while the vault is unlocked.
+ * Tapping the notification sends the LOCK_VAULT common event, which is handled by VaultLockReceiver.
+ */
+export class NotificationService {
+  private static readonly NOTIFICATION_VAULT_UNLOCKED: number = 1;
+  private static readonly CHANNEL_ID: string = 'lock_status_channel';
+  private static _running: boolean = false;
+
+  static start(context: common.Context): void {
+    NotificationService._running = true;
+    NotificationService.serviceMethod(context).catch((e: Error) => {
+      hilog.warn(0x0000, 'NotificationService', 'Unable to publish notification: %{public}s', JSON.stringify(e));
+    });
+  }
+
+  static isRunning(): boolean {
+    return NotificationService._running;
+  }
+
+  private static async serviceMethod(context: common.Context): Promise<void> {
+    const enabled = await notificationManager.isNotificationEnabled();
+    if (!enabled) {
+      return;
+    }
+
+    const agentInfo: wantAgent.WantAgentInfo = {
+      wants: [{ action: VaultLockReceiver.ACTION_LOCK_VAULT }],
+      actionType: wantAgent.OperationType.SEND_COMMON_EVENT,
+      requestCode: 1,
+      actionFlags: [wantAgent.WantAgentFlags.ONE_TIME_FLAG]
+    };
+    const agent: WantAgent = await wantAgent.getWantAgent(agentInfo);
+
+    const request: notificationManager.NotificationRequest = {
+      id: NotificationService.NOTIFICATION_VAULT_UNLOCKED,
+      notificationSlotType: notificationManager.SlotType.SERVICE_INFORMATION,
+      isOngoing: true,
+      isUnremovable: false,
+      content: {
+        notificationContentType: notificationManager.ContentType.NOTIFICATION_CONTENT_BASIC_TEXT,
+        normal: {
+          title: ResUtils.getString(context, 'app_name_full'),
+          text: ResUtils.getString(context, 'vault_unlocked_state')
+        }
+      },
+      wantAgent: agent,
+      groupName: NotificationService.CHANNEL_ID
+    };
+    if (NotificationService._running) {
+      await notificationManager.publish(request);
+    }
+  }
+
+  static stop(): void {
+    NotificationService._running = false;
+    notificationManager.cancel(NotificationService.NOTIFICATION_VAULT_UNLOCKED).catch(() => {
+    });
+  }
+
+  /**
+   * Requests the permission to post notifications (POST_NOTIFICATIONS on Android 13+).
+   */
+  static async requestPermission(context: common.UIAbilityContext): Promise<boolean> {
+    try {
+      if (await notificationManager.isNotificationEnabled()) {
+        return true;
+      }
+      await notificationManager.requestEnableNotification(context);
+      return await notificationManager.isNotificationEnabled();
+    } catch (e) {
+      return false;
+    }
+  }
+}
