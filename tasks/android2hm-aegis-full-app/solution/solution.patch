+import { ProgressDialogTask } from './ProgressDialogTask';
+import { QrCodeHelper } from '../../helpers/QrCodeHelper';
+import { IOUtils } from '../../util/IOUtils';
+
+export class QrDecodeTaskResult {
+  private readonly _uri: string;
+  private readonly _fileName: string;
+  private readonly _result: string | null;
+  private readonly _e: Error | null;
+
+  constructor(uri: string, fileName: string, result: string | null, e: Error | null) {
+    this._uri = uri;
+    this._fileName = fileName;
+    this._result = result;
+    this._e = e;
+  }
+
+  getUri(): string {
+    return this._uri;
+  }
+
+  getFileName(): string {
+    return this._fileName;
+  }
+
+  getResult(): string | null {
+    return this._result;
+  }
+
+  getException(): Error | null {
+    return this._e;
+  }
+}
+
+export type QrDecodeTaskCallback = (results: QrDecodeTaskResult[]) => void;
+
+/**
+ * Port of QrDecodeTask: decodes QR codes from the given image URIs with the Scan Kit.
+ */
+export class QrDecodeTask extends ProgressDialogTask {
+  private _cb: QrDecodeTaskCallback;
+
+  constructor(uiContext: UIContext, cb: QrDecodeTaskCallback) {
+    super(uiContext, $r('app.string.analyzing_qr'));
+    this._cb = cb;
+  }
+
+  execute(uris: string[]): void {
+    this.run<QrDecodeTaskResult[]>(async () => QrDecodeTask.doInBackground(uris))
+      .then((res: QrDecodeTaskResult[]) => this._cb(res))
+      .catch((e: Error) => this._cb([new QrDecodeTaskResult('', '', null, e)]));
+  }
+
+  static async doInBackground(uris: string[]): Promise<QrDecodeTaskResult[]> {
+    const res: QrDecodeTaskResult[] = [];
+    for (const uri of uris) {
+      const fileName = IOUtils.getFileName(uri);
+      try {
+        const results = await QrCodeHelper.decodeFromUri(uri);
+        if (results.length === 0) {
+          throw new Error('No QR code found in the image');
+        }
+        res.push(new QrDecodeTaskResult(uri, fileName, results[0], null));
+      } catch (e) {
+        const err = e instanceof Error ? e as Error : new Error(JSON.stringify(e));
+        res.push(new QrDecodeTaskResult(uri, fileName, null, err));
+      }
+    }
+    return res;
+  }
+}
