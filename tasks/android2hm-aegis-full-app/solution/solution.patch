index 0000000..2b3b6d0
--- /dev/null
+++ b/entry/src/main/ets/importers/SteamImporter.ets
@@ -0,0 +1,98 @@
+import { common } from '@kit.AbilityKit';
+import { fileIo } from '@kit.CoreFileKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { Base64 } from '../encoding/Base64';
+import { SteamInfo } from '../otp/SteamInfo';
+import { VaultEntry } from '../vault/VaultEntry';
+import { JSONObject } from '../util/JSONObject';
+import { Bytes } from '../util/Bytes';
+
+export class SteamImporter extends DatabaseImporter {
+  private static readonly _subDir: string = 'files';
+  private static readonly _pkgName: string = 'com.valvesoftware.android.steam.community';
+
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    const path = this.getAppPathForPackage(SteamImporter._pkgName, SteamImporter._subDir);
+    let files: string[] = [];
+    try {
+      files = fileIo.listFileSync(path).filter((name: string) => name.startsWith('Steamguard-'));
+    }
+    catch (e) {
+      files = [];
+    }
+    if (files.length === 0) {
+      throw new DatabaseImporterException(`Empty directory: ${path}`);
+    }
+    // note: only the first file is handled (multiple files are not expected to occur)
+    return `${path}/${files[0]}`;
+  }
+
+  /**
+   * The version of the installed Steam app can't be determined on HarmonyOS (Android apps can't be
+   * queried), which is treated the same as the app not being installed.
+   */
+  isInstalledAppVersionSupported(): boolean {
+    return false;
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    try {
+      const obj = new JSONObject(Bytes.toUtf8(stream));
+      const objs: JSONObject[] = [];
+      if (obj.has('accounts')) {
+        const accounts = obj.getJSONObject('accounts');
+        for (const key of accounts.keys()) {
+          objs.push(accounts.getJSONObject(key));
+        }
+      }
+      else {
+        objs.push(obj);
+      }
+      return new SteamImporterState(objs);
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+}
+
+export class SteamImporterState extends DatabaseImporterState {
+  private readonly _objs: JSONObject[];
+
+  constructor(objs: JSONObject[]) {
+    super(false);
+    this._objs = objs;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    for (const obj of this._objs) {
+      try {
+        const entry = SteamImporterState.convertEntry(obj);
+        result.addEntry(entry);
+      }
+      catch (e) {
+        result.addError(e as DatabaseImporterEntryException);
+      }
+    }
+    return result;
+  }
+
+  private static convertEntry(obj: JSONObject): VaultEntry {
+    try {
+      const secret = Base64.decode(obj.getString('shared_secret'));
+      const info = new SteamInfo(secret);
+      const account = obj.getString('account_name');
+      return new VaultEntry(info, account, 'Steam');
+    }
+    catch (e) {
+      throw new DatabaseImporterEntryException((e as Error).message, obj.toString());
+    }
+  }
+}
diff --git a/entry/src/main/ets/importers/StratumImporter.ets b/entry/src/main/ets/importers/StratumImporter.ets
