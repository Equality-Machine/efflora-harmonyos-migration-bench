+import { IconPackIcon } from '../../icons/IconPack';
+import { IconType } from '../../icons/IconType';
+import { IconAdapterDummyIcon } from './IconAdapter';
+import { GlideHelper } from '../glide/GlideHelper';
+
+/**
+ * Port of IconHolder (layout card_icon): an icon of an icon pack with its name below it.
+ */
+@Component
+export struct IconHolder {
+  icon: IconPackIcon | null = null;
+  @Prop columnWidth: number = 75;
+  @Prop cellWidth: number = 75;
+  onIconClick: (icon: IconPackIcon) => void = (icon: IconPackIcon) => {
+  };
+  @State private _iconFile: string = '';
+  @State private _iconName: string = '';
+  @State private _isCustom: boolean = false;
+  private _iconType: IconType = IconType.INVALID;
+
+  aboutToAppear(): void {
+    if (this.icon !== null) {
+      this.setData(this.icon);
+    }
+  }
+
+  setData(icon: IconPackIcon): void {
+    const file = icon.getFile();
+    this._iconFile = file !== null ? GlideHelper.loadIconFile(file) : '';
+    this._iconType = icon.getIconType();
+    this._isCustom = icon instanceof IconAdapterDummyIcon;
+    this._iconName = icon.getName();
+  }
+
+  build() {
+    Column() {
+      if (this._isCustom) {
+        Stack() {
+          Image($r('app.media.ic_outline_add_24'))
+            .width(32)
+            .height(32)
+            .fillColor($r('app.color.theme_onSurfaceVariant'))
+        }
+        .width('100%')
+        .height(this.columnWidth - 10)
+      } else {
+        Image(this._iconFile)
+          .width('100%')
+          .height(this.columnWidth - 10)
+          .objectFit(ImageFit.Contain)
+          .interpolation(ImageInterpolation.Medium)
+          .sourceSize({ width: 192, height: 192 })
+      }
