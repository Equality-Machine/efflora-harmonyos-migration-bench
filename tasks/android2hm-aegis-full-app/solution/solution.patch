+import { common } from '@kit.AbilityKit';
+import { SimpleWebViewDialog } from './SimpleWebViewDialog';
+
+export class LicenseDialog extends SimpleWebViewDialog {
+  constructor() {
+    super('license');
+  }
+
+  static create(): LicenseDialog {
+    return new LicenseDialog();
+  }
+
+  protected getContent(context: common.Context): string {
+    const license = SimpleWebViewDialog.readAssetAsString(context, 'LICENSE')
+      .replace(new RegExp('&', 'g'), '&amp;').replace(new RegExp('<', 'g'), '&lt;').replace(new RegExp('>', 'g'), '&gt;');
+    const html = SimpleWebViewDialog.readAssetAsString(context, 'license.html');
+    return html.split('%2$s').join(this.getBackgroundColor()).split('%3$s').join(this.getTextColor()).split('%1$s').join(license);
+  }
+}
diff --git a/entry/src/main/ets/ui/dialogs/SelectGroupDialog.ets b/entry/src/main/ets/ui/dialogs/SelectGroupDialog.ets
new file mode 100644
index 0000000..5f95f44
--- /dev/null
+++ b/entry/src/main/ets/ui/dialogs/SelectGroupDialog.ets
@@ -0,0 +1,127 @@
+import { DialogHandle } from './DialogHandle';
+import { DialogTitle, DialogMessage } from './DialogStyles';
+import { VaultGroupModel } from '../models/VaultGroupModel';
+
+@Extend(Column)
+function selectGroupContainer() {
+  .padding(24)
+  .width('90%')
+  .constraintSize({ maxWidth: 560 })
+  .borderRadius(28)
+  .backgroundColor($r('app.color.theme_surfaceContainerHigh'))
+}
+
+@Extend(Button)
+function selectGroupButton() {
+  .backgroundColor(Color.Transparent)
+  .fontColor($r('app.color.theme_primary'))
+  .fontSize(15)
+  .margin({ left: 8 })
+}
+
+export class SelectGroupDialogParams {
+  title: ResourceStr = $r('app.string.assign_groups');
+  message: ResourceStr = $r('app.string.assign_groups_dialog_summary');
+  groups: VaultGroupModel[] = [];
+  onResult: (group: VaultGroupModel, newGroupName: string) => void = (group: VaultGroupModel, newGroupName: string) => {
+  };
+  handle: DialogHandle = new DialogHandle();
+}
+
+/**
+ * Port of res/layout/dialog_select_group.xml: a dropdown with the groups and a "new group"
+ * placeholder that reveals a text field for the name of the new group.
+ */
+@Component
+export struct SelectGroupDialogView {
+  params: SelectGroupDialogParams = new SelectGroupDialogParams();
+  @State selected: number = -1;
+  @State newGroupName: string = '';
+  @State selectionError: boolean = false;
+  @State nameError: boolean = false;
+
+  private getNames(): SelectOption[] {
+    return this.params.groups.map((g: VaultGroupModel) => {
+      const opt: SelectOption = { value: g.getName() };
+      return opt;
+    });
+  }
+
+  private isNewGroup(): boolean {
+    return this.selected >= 0 && this.params.groups[this.selected].isPlaceholder();
+  }
+
+  private onConfirm(): void {
+    if (this.selected < 0) {
+      this.selectionError = true;
+      return;
+    }
+    const model = this.params.groups[this.selected];
+    if (model.isPlaceholder() && this.newGroupName.trim().length === 0) {
+      this.nameError = true;
+      return;
+    }
+    this.params.handle.dismiss();
+    this.params.onResult(model, this.newGroupName.trim());
+  }
+
+  build() {
+    Column() {
+      DialogTitle(this.params.title)
+      DialogMessage(this.params.message)
+      Select(this.getNames())
+        .value(this.selected >= 0 ? this.params.groups[this.selected].getName() :
+          getContext(this).resourceManager.getStringByNameSync('assign_groups_dialog_dropdown'))
+        .selected(this.selected)
+        .width('100%')
+        .onSelect((index: number) => {
+          this.selected = index;
+          this.selectionError = false;
+        })
+      if (this.selectionError) {
+        Text($r('app.string.error_required_field'))
+          .fontSize(12)
+          .fontColor($r('app.color.theme_error'))
+          .width('100%')
+      }
+      if (this.isNewGroup()) {
+        TextInput({ text: this.newGroupName, placeholder: $r('app.string.group_name_hint') })
+          .margin({ top: 12 })
+          .defaultFocus(true)
+          .onChange((v: string) => {
+            this.newGroupName = v;
+            this.nameError = false;
+          })
+        if (this.nameError) {
+          Text($r('app.string.error_required_field'))
+            .fontSize(12)
+            .fontColor($r('app.color.theme_error'))
+            .width('100%')
+        }
+      }
+      Row() {
+        Blank()
+        Button($r('app.string.cancel'))
+          .selectGroupButton()
+          .onClick(() => this.params.handle.dismiss())
+        Button($r('app.string.ok'))
+          .selectGroupButton()
+          .onClick(() => this.onConfirm())
+      }
+      .width('100%')
+      .margin({ top: 16 })
+    }
+    .selectGroupContainer()
+  }
+}
+
+@Builder
+export function buildSelectGroupDialog(params: SelectGroupDialogParams) {
+  SelectGroupDialogView({ params: params })
+}
+
+export class SelectGroupDialog {
+  static show(uiContext: UIContext, params: SelectGroupDialogParams): void {
+    DialogHandle.open<SelectGroupDialogParams>(uiContext, wrapBuilder(buildSelectGroupDialog), params, params.handle, true);
+  }
+}
