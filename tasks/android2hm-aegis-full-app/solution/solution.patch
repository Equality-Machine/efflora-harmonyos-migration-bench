index 0000000..a8eec28
--- /dev/null
+++ b/entry/src/main/ets/ui/tasks/ExportTask.ets
@@ -0,0 +1,55 @@
+import { fileIo } from '@kit.CoreFileKit';
+import { ProgressDialogTask } from './ProgressDialogTask';
+import { IOUtils } from '../../util/IOUtils';
+
+export class ExportTaskParams {
+  private readonly _file: string;
+  private readonly _destUri: string;
+
+  constructor(file: string, destUri: string) {
+    this._file = file;
+    this._destUri = destUri;
+  }
+
+  getFile(): string {
+    return this._file;
+  }
+
+  getDestUri(): string {
+    return this._destUri;
+  }
+}
+
+export type ExportTaskCallback = (e: Error | null) => void;
+
+/**
+ * Copies an exported (temporary) file to the destination URI that was picked by the user.
+ */
+export class ExportTask extends ProgressDialogTask {
+  private readonly _cb: ExportTaskCallback;
+
+  constructor(uiContext: UIContext, cb: ExportTaskCallback) {
+    super(uiContext, $r('app.string.exporting_vault'));
+    this._cb = cb;
+  }
+
+  execute(params: ExportTaskParams): void {
+    this.run<Error | null>(async () => ExportTask.doInBackground(params))
+      .then((e: Error | null) => this._cb(e))
+      .catch((e: Error) => this._cb(e));
+  }
+
+  static doInBackground(params: ExportTaskParams): Error | null {
+    try {
+      IOUtils.copy(params.getFile(), params.getDestUri());
+      return null;
+    } catch (e) {
+      return e as Error;
+    } finally {
+      try {
+        fileIo.unlinkSync(params.getFile());
+      } catch (ignored) {
+      }
+    }
+  }
+}
diff --git a/entry/src/main/ets/ui/tasks/IconOptimizationTask.ets b/entry/src/main/ets/ui/tasks/IconOptimizationTask.ets
new file mode 100644
index 0000000..7a2fbdf
--- /dev/null
+++ b/entry/src/main/ets/ui/tasks/IconOptimizationTask.ets
@@ -0,0 +1,128 @@
+import { image } from '@kit.ImageKit';
+import { ProgressDialogTask } from './ProgressDialogTask';
+import { DialogHandle } from '../dialogs/DialogHandle';
+import { VaultEntryIcon } from '../../vault/VaultEntryIcon';
+import { IconType } from '../../icons/IconType';
+import { BitmapHelper } from '../../helpers/BitmapHelper';
+import { AegisModule } from '../../AegisModule';
+import { ResUtils } from '../../util/ResUtils';
+
+export type IconOptimizationTaskCallback = (results: Map<string, VaultEntryIcon>) => void;
+
+@Observed
+class IconOptimizationProgress {
+  message: string = '';
+}
+
+class IconOptimizationDialogParams {
+  progress: IconOptimizationProgress = new IconOptimizationProgress();
+  handle: DialogHandle = new DialogHandle();
+}
+
+@Component
+struct IconOptimizationDialogView {
+  @ObjectLink progress: IconOptimizationProgress;
+
+  build() {
+    Column() {
+      Row() {
+        LoadingProgress()
+          .width(40)
+          .height(40)
+          .color($r('app.color.theme_primary'))
+        Text(this.progress.message)
+          .fontSize(16)
+          .fontColor($r('app.color.theme_onSurface'))
+          .margin({ left: 16 })
+          .layoutWeight(1)
+      }
+      .width('100%')
+    }
+    .padding(24)
+    .width('90%')
+    .constraintSize({ maxWidth: 560 })
+    .borderRadius(28)
+    .backgroundColor($r('app.color.theme_surfaceContainerHigh'))
+  }
+}
+
+@Builder
+function buildIconOptimizationDialog(params: IconOptimizationDialogParams) {
+  IconOptimizationDialogView({ progress: params.progress })
+}
+
+/**
+ * Port of IconOptimizationTask: re-encodes all icons that are larger than VaultEntryIcon.MAX_DIMENS.
+ * Usage: new IconOptimizationTask(uiContext, cb).execute(icons)
+ */
+export class IconOptimizationTask extends ProgressDialogTask {
+  private readonly _cb: IconOptimizationTaskCallback;
+  private _params: IconOptimizationDialogParams = new IconOptimizationDialogParams();
+
+  constructor(uiContext: UIContext, cb: IconOptimizationTaskCallback) {
+    super(uiContext, ResUtils.getString(AegisModule.getContext(), 'optimizing_icon'));
+    this._cb = cb;
+  }
+
+  protected onPreExecute(): void {
+    this._params = new IconOptimizationDialogParams();
+    this._params.progress.message = ResUtils.getString(AegisModule.getContext(), 'optimizing_icon');
+    DialogHandle.open<IconOptimizationDialogParams>(this.getUIContext(), wrapBuilder(buildIconOptimizationDialog),
+      this._params, this._params.handle, false);
+  }
+
+  protected onPostExecute(): void {
+    if (this._params.handle.isShowing()) {
+      this._params.handle.dismiss();
+    }
+  }
+
+  protected publishProgress(message: string): void {
+    this._params.progress.message = message;
+  }
+
+  execute(icons: Map<string, VaultEntryIcon>): void {
+    this.run<Map<string, VaultEntryIcon>>(async () => this.doInBackground(icons))
+      .then((results: Map<string, VaultEntryIcon>) => this._cb(results))
+      .catch(() => this._cb(new Map<string, VaultEntryIcon>()));
+  }
+
+  protected async doInBackground(icons: Map<string, VaultEntryIcon>): Promise<Map<string, VaultEntryIcon>> {
+    const res = new Map<string, VaultEntryIcon>();
+    const context = AegisModule.getContext();
+
+    let i = 0;
+    const entries = Array.from(icons.entries());
+    for (const entry of entries) {
+      if (icons.size > 1) {
+        this.publishProgress(ResUtils.getString(context, 'optimizing_icon_multiple', [i + 1, icons.size]));
+        // yield to the UI thread so the progress can be rendered
+        await new Promise<void>((resolve: () => void) => setTimeout(resolve, 0));
+      }
+      i++;
+
+      const oldIcon: VaultEntryIcon | null | undefined = entry[1];
+      if (oldIcon === null || oldIcon === undefined || oldIcon.getType() === IconType.SVG) {
+        continue;
+      }
+      if (BitmapHelper.isVaultEntryIconOptimized(oldIcon)) {
+        continue;
+      }
+
+      let bitmap: image.PixelMap | null = null;
+      try {
+        bitmap = await BitmapHelper.decodeByteArray(oldIcon.getBytes());
+        const newIcon = await BitmapHelper.toVaultEntryIcon(bitmap, oldIcon.getType());
+        res.set(entry[0], newIcon);
+      } catch (e) {
+        // leave icons that can't be decoded untouched
+      } finally {
+        if (bitmap !== null) {
+          bitmap.release();
+        }
+      }
+    }
+
+    return res;
+  }
+}
diff --git a/entry/src/main/ets/ui/tasks/ImportFileTask.ets b/entry/src/main/ets/ui/tasks/ImportFileTask.ets
