+    new EditEntryActivityBackPressHandler(false, () => this.discardAndFinish());
+  private _iconBackPressHandler: EditEntryActivityBackPressHandler =
+    new EditEntryActivityBackPressHandler(false, () => this.stopEditingIcon(false));
