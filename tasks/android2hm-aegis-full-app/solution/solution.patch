+  getLanguage(): string {
+    return this.getRawString('pref_lang', 'system');
+  }
+
+  setLanguage(lang: string): void {
+    this.putRawString('pref_lang', lang);
+  }
+
+  /**
+   * Returns the BCP 47 language tag for the configured language, or the system language.
+   */
+  getLocale(): string {
+    const lang = this.getLanguage();
+    if (lang === 'system') {
+      return i18n.System.getSystemLanguage();
+    }
+    const parts = lang.split('_');
+    if (parts.length === 1) {
+      return parts[0];
+    }
+    return `${parts[0]}-${parts[1]}`;
+  }
+
+  isAndroidBackupsEnabled(): boolean {
