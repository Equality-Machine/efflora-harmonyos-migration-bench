@@ -0,0 +1,139 @@
+import { IconPack, IconPackIcon } from '../../icons/IconPack';
+import { IconAdapter, IconAdapterListener } from '../views/IconAdapter';
+import { IconRecyclerView } from '../views/IconRecyclerView';
+import { DialogHandle } from './DialogHandle';
+import { BottomSheetDialog } from './BottomSheetDialog';
+
+export class IconPickerDialogParams {
+  iconPacks: IconPack[] = [];
+  showAddCustom: boolean = false;
+  adapter: IconAdapter | null = null;
+  handle: DialogHandle = new DialogHandle();
+}
+
+@Component
+struct IconPickerDialogView {
+  params: IconPickerDialogParams = new IconPickerDialogParams();
+  @State textIconPack: string = '';
+  @State iconSearch: string = '';
+
+  aboutToAppear(): void {
+    const iconPacks = this.params.iconPacks;
+    if (this.params.adapter !== null && iconPacks.length > 0) {
+      this.params.adapter.loadIcons(iconPacks[0], this.params.showAddCustom);
+      this.textIconPack = iconPacks[0].getName();
+    }
+  }
+
+  private onIconPackSelected(pack: IconPack): void {
+    const adapter = this.params.adapter;
+    if (adapter === null) {
+      return;
+    }
+    adapter.loadIcons(pack, this.params.showAddCustom);
+
+    const query = this.iconSearch;
+    if (query.length > 0) {
+      adapter.setQuery(query);
+    }
+
+    this.textIconPack = pack.getName();
+  }
+
+  private onTextChanged(s: string): void {
+    this.iconSearch = s;
+    if (this.params.adapter !== null) {
+      this.params.adapter.setQuery(s.length === 0 ? null : s);
+    }
+  }
+
+  @Builder
+  IconPackMenu() {
+    Menu() {
+      ForEach(this.params.iconPacks, (pack: IconPack) => {
+        MenuItem({ content: pack.getName() })
+          .onClick(() => this.onIconPackSelected(pack))
+      }, (pack: IconPack) => `${pack.getUUID()}:${pack.getVersion()}`)
+    }
+  }
+
+  build() {
+    Column() {
+      Stack({ alignContent: Alignment.TopEnd }) {
+        Column() {
+          Text($r('app.string.pick_icon'))
+            .fontSize(20)
+            .fontColor($r('app.color.theme_onSurface'))
+            .textAlign(TextAlign.Center)
+            .width('100%')
+          Text(this.textIconPack)
+            .fontSize(13)
+            .fontColor($r('app.color.theme_onSurfaceVariant'))
+            .textAlign(TextAlign.Center)
+            .width('100%')
+            .padding({ top: 2, bottom: 16 })
+        }
+        .width('100%')
+
+        Image($r('app.media.ic_outline_more_vert_24'))
+          .width(24)
+          .height(24)
+          .margin({ right: 8 })
+          .fillColor($r('app.color.theme_onSurfaceVariant'))
+          .bindMenu(this.IconPackMenu())
+      }
+      .width('100%')
+
+      Column() {
+        TextInput({ text: this.iconSearch, placeholder: $r('app.string.search') })
+          .width('100%')
+          .margin({ top: 10 })
+          .cancelButton({ style: CancelButtonStyle.INPUT })
+          .onChange((s: string) => this.onTextChanged(s))
+        IconRecyclerView({ adapter: this.params.adapter, columnWidth: 75 })
+          .layoutWeight(1)
+          .margin({ top: 10 })
+      }
+      .padding({ left: 15, right: 15 })
+      .layoutWeight(1)
+    }
+    .width('100%')
+    .height('100%')
+  }
+}
+
+@Builder
+function buildIconPickerDialog(params: IconPickerDialogParams) {
+  IconPickerDialogView({ params: params })
+}
+
+/**
+ * Port of IconPickerDialog: a bottom sheet with a searchable grid of the icons of the given icon packs.
+ */
+export class IconPickerDialog {
+  private constructor() {
+  }
+
+  /**
+   * Creates and shows the icon picker. The returned handle can be used to dismiss it.
+   */
+  static create(uiContext: UIContext, iconPacks: IconPack[], issuer: string, showAddCustom: boolean,
+    listener: IconAdapterListener): DialogHandle {
+    const params = new IconPickerDialogParams();
+    params.iconPacks = iconPacks;
+    params.showAddCustom = showAddCustom;
+    params.adapter = new IconAdapter(issuer, new IconAdapterListener(
+      (icon: IconPackIcon) => {
+        params.handle.dismiss();
+        listener.onIconSelected(icon);
+      },
+      () => {
+        params.handle.dismiss();
+        listener.onCustomSelected();
+      }
+    ));
+
+    return BottomSheetDialog.open<IconPickerDialogParams>(uiContext, wrapBuilder(buildIconPickerDialog), params,
+      params.handle, true, SheetSize.LARGE);
+  }
+}
diff --git a/entry/src/main/ets/ui/dialogs/LicenseDialog.ets b/entry/src/main/ets/ui/dialogs/LicenseDialog.ets
