+/**
+ * Single/multi choice list dialog (replacement for setSingleChoiceItems/setMultiChoiceItems and
+ * the importer list dialog).
+ */
+@Component
+export struct ChoiceDialogView {
+  params: ChoiceDialogParams = new ChoiceDialogParams();
+  @State selected: number = 0;
+  @State checkedItems: boolean[] = [];
+
+  aboutToAppear(): void {
+    this.selected = this.params.selected;
+    this.checkedItems = this.params.checkedItems.slice();
+    while (this.checkedItems.length < this.params.items.length) {
+      this.checkedItems.push(false);
+    }
+  }
+
+  build() {
+    Column() {
+      DialogTitle(this.params.title)
+      if (this.params.message !== '') {
+        DialogMessage(this.params.message)
+      }
+      List() {
+        ForEach(this.params.items, (item: string, index: number) => {
+          ListItem() {
+            Row() {
+              if (this.params.multiple) {
+                Checkbox()
+                  .select(this.checkedItems[index])
+                  .onChange((v: boolean) => {
+                    const copy = this.checkedItems.slice();
+                    copy[index] = v;
+                    this.checkedItems = copy;
+                  })
+              } else {
+                Radio({ value: `${index}`, group: 'choice' })
+                  .checked(this.selected === index)
+                  .onChange((v: boolean) => {
+                    if (v) {
+                      this.selected = index;
+                    }
+                  })
+              }
+              Text(item)
+                .fontSize(16)
+                .fontColor($r('app.color.theme_onSurface'))
+                .layoutWeight(1)
+                .margin({ left: 8 })
+            }
+            .width('100%')
+            .height(48)
+            .onClick(() => {
+              if (this.params.multiple) {
+                const copy = this.checkedItems.slice();
+                copy[index] = !copy[index];
+                this.checkedItems = copy;
+              } else {
+                this.selected = index;
+                if (this.params.dismissOnSelect) {
+                  this.params.handle.dismiss();
+                  this.params.onResult(index);
+                }
+              }
+            })
+          }
+        }, (item: string, index: number) => `${index}-${item}`)
+      }
+      .constraintSize({ maxHeight: 320 })
+      .scrollBar(BarState.Auto)
+
+      if (this.params.helpTexts.length > this.selected && !this.params.multiple) {
+        Text(this.params.helpTexts[this.selected])
+          .fontSize(13)
+          .fontColor($r('app.color.theme_onSurfaceVariant'))
+          .width('100%')
+          .margin({ top: 12 })
+      }
+      if (!this.params.dismissOnSelect) {
+        Row() {
+          Blank()
+          Button($r('app.string.cancel'))
+            .dialogButton()
+            .onClick(() => {
+              this.params.handle.dismiss();
+            })
+          Button($r('app.string.ok'))
+            .dialogButton()
+            .onClick(() => {
+              this.params.handle.dismiss();
+              if (this.params.multiple) {
+                this.params.onMultiResult(this.checkedItems);
+              } else {
+                this.params.onResult(this.selected);
+              }
+            })
+        }
+        .width('100%')
+        .margin({ top: 16 })
+      }
+    }
+    .dialogContainer()
+  }
+}
+
+@Builder
+export function buildChoiceDialog(params: ChoiceDialogParams) {
+  ChoiceDialogView({ params: params })
