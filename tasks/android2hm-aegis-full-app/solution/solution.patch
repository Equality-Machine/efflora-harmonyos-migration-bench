@@ -0,0 +1,146 @@
+import { picker } from '@kit.CoreFileKit';
+import { SlideFragment } from '../intro/SlideFragment';
+import { IntroState } from '../intro/IntroState';
+import { Dialogs } from '../dialogs/Dialogs';
+import { AegisImporter, AegisImporterDecryptedState } from '../../importers/AegisImporter';
+import { DatabaseImporterState, DecryptListener } from '../../importers/DatabaseImporter';
+import { VaultFileCredentials } from '../../vault/VaultFileCredentials';
+import { VaultRepository } from '../../vault/VaultRepository';
+import { IOUtils } from '../../util/IOUtils';
+import { AegisModule } from '../../AegisModule';
+
+class WelcomeDecryptListener implements DecryptListener {
+  private _slide: WelcomeSlide;
+  private _data: Uint8Array;
+
+  constructor(slide: WelcomeSlide, data: Uint8Array) {
+    this._slide = slide;
+    this._data = data;
+  }
+
+  onStateDecrypted(state: DatabaseImporterState): void {
+    this._slide.setCredentials((state as AegisImporterDecryptedState).getCredentials());
+    this._slide.importVault(this._data);
+  }
+
+  onError(e: Error): void {
+    this._slide.showError($r('app.string.decryption_error'), e);
+  }
+
+  onCanceled(): void {
+  }
+}
+
+export class WelcomeSlide extends SlideFragment {
+  static readonly TYPE: string = 'WelcomeSlide';
+
+  private _imported: boolean = false;
+  private _creds: VaultFileCredentials | null = null;
+
+  getType(): string {
+    return WelcomeSlide.TYPE;
+  }
+
+  onSaveIntroState(introState: IntroState): void {
+    introState.imported = this._imported;
+    introState.creds = this._creds;
+  }
+
+  setCredentials(creds: VaultFileCredentials | null): void {
+    this._creds = creds;
+  }
+
+  showError(message: ResourceStr, e: Error): void {
+    Dialogs.showErrorDialog(this.requireUIContext(), message, e);
+  }
+
+  /**
+   * Lets the user pick a vault file (replacement for ACTION_GET_CONTENT).
+   */
+  onImportClick(): void {
+    const documentPicker = new picker.DocumentViewPicker(AegisModule.getAbilityContext());
+    const options = new picker.DocumentSelectOptions();
+    options.maxSelectNumber = 1;
+    AegisModule.provideVaultManager().fireIntentLauncher<string[]>(() => documentPicker.select(options))
+      .then((uris: string[]) => {
+        if (uris.length > 0) {
+          this.startImportVault(uris[0]);
+        }
+      }).catch((e: Error) => {
+      this.showError($r('app.string.documentsui_error'), e);
+    });
+  }
+
+  private startImportVault(uri: string): void {
+    let data: Uint8Array;
+    try {
+      data = IOUtils.readFile(uri);
+    } catch (e) {
+      this.showError($r('app.string.reading_file_error'), e as Error);
+      return;
+    }
+
+    const importer = new AegisImporter(AegisModule.getContext());
+    importer.read(data, false).then((state: DatabaseImporterState) => {
+      if (state.isEncrypted()) {
+        state.decrypt(this.requireUIContext(), new WelcomeDecryptListener(this, data));
+      } else {
+        this.importVault(data);
+      }
+    }).catch((e: Error) => {
+      this.showError($r('app.string.intro_import_error_title'), e);
+    });
+  }
+
+  importVault(data: Uint8Array): void {
+    try {
+      VaultRepository.writeToFile(AegisModule.getContext(), data);
+    } catch (e) {
+      this.showError($r('app.string.intro_import_error_title'), e as Error);
+      return;
+    }
+    this._imported = true;
+    this.goToNextSlide();
+  }
+}
+
+@Component
+export struct WelcomeSlideView {
+  slide: WelcomeSlide | null = null;
+
+  build() {
+    Column() {
+      Text($r('app.string.welcome'))
+        .fontSize(28)
+        .fontWeight(FontWeight.Medium)
+        .fontColor($r('app.color.theme_onSurface'))
+      Text($r('app.string.app_description'))
+        .fontSize(16)
+        .textAlign(TextAlign.Center)
+        .fontColor($r('app.color.theme_onSurfaceVariant'))
+        .margin({ top: 12, left: 24, right: 24 })
+      Image($r('app.media.app_icon'))
+        .width(160)
+        .height(160)
+        .margin({ top: 40, bottom: 40 })
+      Button($r('app.string.import_vault'))
+        .backgroundColor(Color.Transparent)
+        .fontColor($r('app.color.theme_primary'))
+        .borderWidth(1)
+        .borderColor($r('app.color.theme_outline'))
+        .onClick(() => {
+          if (this.slide !== null) {
+            this.slide.onImportClick();
+          }
+        })
+      Text($r('app.string.import_vault_hint'))
+        .fontSize(13)
+        .textAlign(TextAlign.Center)
+        .fontColor($r('app.color.theme_onSurfaceVariant'))
+        .margin({ top: 8, left: 32, right: 32 })
+    }
+    .width('100%')
+    .height('100%')
+    .justifyContent(FlexAlign.Center)
+  }
+}
diff --git a/entry/src/main/ets/ui/tasks/Argon2Task.ets b/entry/src/main/ets/ui/tasks/Argon2Task.ets
new file mode 100644
index 0000000..214ee39
--- /dev/null
+++ b/entry/src/main/ets/ui/tasks/Argon2Task.ets
@@ -0,0 +1,110 @@
+import { taskpool } from '@kit.ArkTS';
+import { ProgressDialogTask } from './ProgressDialogTask';
+import { SecretKey } from '../../crypto/CryptoUtils';
+import { Argon2ParametersBuilder, Argon2Parameters } from '../../crypto/bc/Argon2Parameters';
+import { Argon2BytesGenerator } from '../../crypto/bc/Argon2BytesGenerator';
+import { Bytes } from '../../util/Bytes';
+
+export type Argon2TaskCallback = (key: SecretKey) => void;
+
+export type Argon2TaskErrorCallback = (e: Error) => void;
+
+/**
+ * Runs Argon2 in a TaskPool worker, so that the UI (progress dialog) stays responsive.
+ */
+@Concurrent
+function argon2Derive(password: Uint8Array, type: number, version: number, iterations: number, memory: number, lanes: number, salt: Uint8Array, secret: Uint8Array, additional: Uint8Array, keySize: number): Uint8Array {
+  const params = new Argon2ParametersBuilder(type)
+    .withVersion(version)
+    .withIterations(iterations)
+    .withMemoryAsKB(memory)
+    .withParallelism(lanes)
+    .withSalt(salt)
+    .withSecret(secret)
+    .withAdditional(additional)
+    .build();
+  const gen = new Argon2BytesGenerator();
+  gen.init(params);
+  const key = new Uint8Array(keySize);
+  gen.generateBytes(password, key);
+  return key;
+}
+
+export class Argon2TaskParams {
+  private readonly _password: string;
+  private readonly _argon2Params: Argon2Parameters;
+  private readonly _keySize: number;
+
+  /**
+   * @param keySize the size of the key in bytes
+   */
+  constructor(password: string, argon2Params: Argon2Parameters, keySize: number) {
+    this._password = password;
+    this._argon2Params = argon2Params;
+    this._keySize = keySize;
+  }
+
+  getPassword(): string {
+    return this._password;
+  }
+
+  getArgon2Params(): Argon2Parameters {
+    return this._argon2Params;
+  }
+
+  getKeySize(): number {
+    return this._keySize;
+  }
+}
+
+export class Argon2Task extends ProgressDialogTask {
+  private readonly _cb: Argon2TaskCallback;
+  private readonly _errorCb: Argon2TaskErrorCallback | null;
+
+  constructor(uiContext: UIContext, cb: Argon2TaskCallback, errorCb?: Argon2TaskErrorCallback) {
+    super(uiContext, $r('app.string.unlocking_vault'));
+    this._cb = cb;
+    this._errorCb = errorCb !== undefined ? errorCb : null;
+  }
+
+  execute(params: Argon2TaskParams): void {
+    this.run<SecretKey>(async () => Argon2Task.doInBackground(params))
+      .then((key: SecretKey) => this.onTaskFinished(key))
+      .catch((e: Error) => {
+      if (this._errorCb !== null) {
+        this._errorCb(e);
+      }
+    });
+  }
+
+  private onTaskFinished(key: SecretKey): void {
+    this._cb(key);
+  }
+
+  /**
+   * Derives the key in a background thread (TaskPool). Falls back to the current thread if the
+   * TaskPool is unavailable.
+   */
+  static async doInBackground(params: Argon2TaskParams): Promise<SecretKey> {
+    const p = params.getArgon2Params();
+    let key: Uint8Array;
+    try {
+      key = await taskpool.execute(argon2Derive, Bytes.fromUtf8(params.getPassword()), p.getType(), p.getVersion(), p.getIterations(), p.getMemory(), p.getLanes(), p.getSalt(), p.getSecret(), p.getAdditional(), params.getKeySize()) as Uint8Array;
+    }
+    catch (e) {
+      return Argon2Task.deriveKey(params);
+    }
+    return new SecretKey(new Uint8Array(key));
+  }
+
+  /**
+   * Derives the key synchronously on the current thread.
+   */
+  static deriveKey(params: Argon2TaskParams): SecretKey {
+    const gen = new Argon2BytesGenerator();
+    gen.init(params.getArgon2Params());
+    const key = new Uint8Array(params.getKeySize());
+    gen.generateBytesFromPassword(params.getPassword(), key);
+    return new SecretKey(key);
+  }
+}
diff --git a/entry/src/main/ets/ui/tasks/ExportTask.ets b/entry/src/main/ets/ui/tasks/ExportTask.ets
