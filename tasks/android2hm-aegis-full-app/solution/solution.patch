+
+/**
+ * Creates new credentials with the given password for an encrypted export of an unencrypted vault.
+ */
+class ExportPasswordSlotListener implements PasswordSlotListener {
+  private _uiContext: UIContext;
+  private _onCredentials: (creds: VaultFileCredentials) => void;
+
+  constructor(uiContext: UIContext, onCredentials: (creds: VaultFileCredentials) => void) {
+    this._uiContext = uiContext;
+    this._onCredentials = onCredentials;
+  }
+
+  onSlotResult(slot: PasswordSlot, cipher: Cipher): void {
+    const creds = new VaultFileCredentials();
+    slot.setKey(creds.getKey(), cipher).then(() => {
+      creds.getSlots().add(slot);
+      this._onCredentials(creds);
+    }).catch((e: Error) => this.onException(e));
+  }
+
+  onException(e: Error): void {
+    hilog.error(0x0000, TAG, 'Unable to create the export credentials: %{public}s', e.message);
+  }
+}
