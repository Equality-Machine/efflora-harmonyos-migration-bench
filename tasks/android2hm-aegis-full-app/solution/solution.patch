@@ -0,0 +1,47 @@
+import { AuditLogEntryModel } from '../models/AuditLogEntryModel';
+import { VaultEntry } from '../../vault/VaultEntry';
+
+/**
+ * Port of AuditLogAdapter: holds the audit log entry models shown in the list. The list itself is
+ * rendered by AuditLogPreferencesFragment with an AuditLogHolder per item.
+ */
+export class AuditLogAdapter {
+  private _auditLogEntryModels: AuditLogEntryModel[] = [];
+  private _referencedEntries: VaultEntry[] = [];
+  private _listener: (() => void) | null = null;
+
+  setOnDataSetChangedListener(listener: (() => void) | null): void {
+    this._listener = listener;
+  }
+
+  addAuditLogEntryModel(auditLogEntryModel: AuditLogEntryModel): void {
+    this._auditLogEntryModels.push(auditLogEntryModel);
+    this.notifyDataSetChanged();
+  }
+
+  /**
+   * Replaces all models at once (used when the observed audit log changes).
+   */
+  setAuditLogEntryModels(models: AuditLogEntryModel[]): void {
+    this._auditLogEntryModels = models.slice();
+    this.notifyDataSetChanged();
+  }
+
+  addReferencedEntry(vaultEntry: VaultEntry): void {
+    this._referencedEntries.push(vaultEntry);
+  }
+
+  getAuditLogEntryModels(): AuditLogEntryModel[] {
+    return this._auditLogEntryModels;
+  }
+
+  getItemCount(): number {
+    return this._auditLogEntryModels.length;
+  }
+
+  private notifyDataSetChanged(): void {
+    if (this._listener !== null) {
+      this._listener();
+    }
+  }
+}
diff --git a/entry/src/main/ets/ui/views/AuditLogHolder.ets b/entry/src/main/ets/ui/views/AuditLogHolder.ets
new file mode 100644
index 0000000..fd58ba7
--- /dev/null
+++ b/entry/src/main/ets/ui/views/AuditLogHolder.ets
@@ -0,0 +1,171 @@
+import { intl } from '@kit.LocalizationKit';
+import { EventType, EventTypeUtils } from '../../EventType';
+import { AuditLogEntry } from '../../database/AuditLogEntry';
+import { AuditLogEntryModel } from '../models/AuditLogEntryModel';
+import { AegisModule } from '../../AegisModule';
+import { ResUtils } from '../../util/ResUtils';
+
+/**
+ * Port of AuditLogHolder: the card that shows a single audit log event (res/layout/card_audit_log.xml).
+ */
+@Component
+export struct AuditLogHolder {
+  model: AuditLogEntryModel | null = null;
+
+  private getEntry(): AuditLogEntry {
+    return (this.model as AuditLogEntryModel).getAuditLogEntry();
+  }
+
+  private isError(): boolean {
+    const eventType = this.getEntry().getEventType();
+    return eventType === EventType.VAULT_UNLOCK_FAILED_PASSWORD || eventType === EventType.VAULT_UNLOCK_FAILED_BIOMETRICS;
+  }
+
+  /**
+   * Replacement for setCardBackgroundColor(): failed unlock attempts are shown with the error container color.
+   */
+  private getCardBackgroundColor(): ResourceColor {
+    return this.isError() ? $r('app.color.theme_errorContainer') : $r('app.color.theme_surfaceContainer');
+  }
+
+  private getIconBackgroundColor(): ResourceColor {
+    return this.isError() ? $r('app.color.theme_errorContainer') : $r('app.color.theme_tertiaryContainer');
+  }
+
+  private getReferenceText(): ResourceStr {
+    const model = this.model as AuditLogEntryModel;
+    const referencedVaultEntry = model.getReferencedVaultEntry();
+    if (referencedVaultEntry !== null) {
+      return `${referencedVaultEntry.getIssuer()} (${referencedVaultEntry.getName()})`;
+    } else if (model.getAuditLogEntry().getReference() !== null) {
+      return $r('app.string.audit_log_entry_deleted');
+    }
+    return '';
+  }
+
+  static getEventTypeDescriptionRes(eventType: EventType): Resource {
+    switch (eventType) {
+      case EventType.VAULT_UNLOCKED:
+        return $r('app.string.event_description_vault_unlocked');
+      case EventType.VAULT_BACKUP_CREATED:
+        return $r('app.string.event_description_backup_created');
+      case EventType.VAULT_ANDROID_BACKUP_CREATED:
+        return $r('app.string.event_description_android_backup_created');
+      case EventType.VAULT_EXPORTED:
+        return $r('app.string.event_description_vault_exported');
+      case EventType.ENTRY_SHARED:
+        return $r('app.string.event_description_entry_shared');
+      case EventType.VAULT_UNLOCK_FAILED_PASSWORD:
+        return $r('app.string.event_description_vault_unlock_failed_password');
+      case EventType.VAULT_UNLOCK_FAILED_BIOMETRICS:
+        return $r('app.string.event_description_vault_unlock_failed_biometrics');
+      default:
+        return $r('app.string.event_unknown');
+    }
+  }
+
+  static getIconResource(eventType: EventType): Resource {
+    switch (eventType) {
+      case EventType.VAULT_UNLOCKED:
+        return $r('app.media.ic_lock_open');
+      case EventType.VAULT_BACKUP_CREATED:
+      case EventType.VAULT_ANDROID_BACKUP_CREATED:
+        return $r('app.media.ic_folder_zip');
+      case EventType.VAULT_EXPORTED:
+        return $r('app.media.ic_export_notes');
+      case EventType.ENTRY_SHARED:
+        return $r('app.media.ic_share');
+      default:
+        return $r('app.media.ic_lock');
+    }
+  }
+
+  static formatTimestamp(epochMilli: number): string {
+    const context = AegisModule.getContext();
+    const now = new Date();
+    const timestamp = new Date(epochMilli);
+
+    const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
+    const startOfDay = new Date(timestamp.getFullYear(), timestamp.getMonth(), timestamp.getDate()).getTime();
+    const daysBetween = Math.round((startOfToday - startOfDay) / (24 * 60 * 60 * 1000));
+    const locale = AegisModule.getPreferences().getLocale();
+
+    if (daysBetween < 1) {
+      const formattedTime = AuditLogHolder.formatTime(timestamp);
+      return ResUtils.getString(context, 'today_at_time', [formattedTime]);
+    } else if (daysBetween < 7) {
+      let dayOfWeek: string;
+      try {
+        const options: intl.DateTimeOptions = { weekday: 'long' };
+        dayOfWeek = new intl.DateTimeFormat(locale, options).format(timestamp);
+      } catch (e) {
+        dayOfWeek = timestamp.toDateString().split(' ')[0];
+      }
+      const formattedTime = AuditLogHolder.formatTime(timestamp);
+      return ResUtils.getString(context, 'day_of_week_at_time', [dayOfWeek, formattedTime]);
+    } else {
+      try {
+        const options: intl.DateTimeOptions = { dateStyle: 'medium' };
+        return new intl.DateTimeFormat(locale, options).format(timestamp);
+      } catch (e) {
+        return timestamp.toDateString();
+      }
+    }
+  }
+
+  /**
+   * Formats the time with the pattern "h:mm a".
+   */
+  private static formatTime(d: Date): string {
+    const hours = d.getHours();
+    const h = hours % 12 === 0 ? 12 : hours % 12;
+    const m = d.getMinutes() < 10 ? `0${d.getMinutes()}` : `${d.getMinutes()}`;
+    return `${h}:${m} ${hours < 12 ? 'AM' : 'PM'}`;
+  }
+
+  build() {
+    Row() {
+      Column() {
+        Image(AuditLogHolder.getIconResource(this.getEntry().getEventType()))
+          .width(41)
+          .height(41)
+          .padding(8)
+          .fillColor($r('app.color.theme_onTertiaryContainer'))
+          .backgroundColor(this.getIconBackgroundColor())
+          .borderRadius(12)
+      }
+      .padding({ top: 12, left: 14 })
+      .alignSelf(ItemAlign.Start)
+
+      Column() {
+        Text(EventTypeUtils.getEventTitleRes(this.getEntry().getEventType()))
+          .fontSize(16)
+          .fontWeight(FontWeight.Bold)
+          .maxLines(1)
+          .textOverflow({ overflow: TextOverflow.Ellipsis })
+          .fontColor($r('app.color.theme_onSurface'))
+        Text(AuditLogHolder.getEventTypeDescriptionRes(this.getEntry().getEventType()))
+          .fontSize(14)
+          .margin({ top: 4 })
+          .fontColor($r('app.color.theme_onSurface'))
+        if (this.getReferenceText() !== '') {
+          Text(this.getReferenceText())
+            .fontSize(14)
+            .fontStyle(FontStyle.Italic)
+            .margin({ top: 4 })
+            .fontColor($r('app.color.theme_onSurface'))
+        }
+        Text(AuditLogHolder.formatTimestamp(this.getEntry().getTimestamp()).toLowerCase())
+          .fontSize(12)
+          .margin({ top: 8 })
+          .fontColor($r('app.color.theme_outline'))
+      }
+      .layoutWeight(1)
+      .alignItems(HorizontalAlign.Start)
+      .padding({ top: 16, bottom: 16, left: 12, right: 12 })
+    }
+    .width('100%')
+    .borderRadius(12)
+    .backgroundColor(this.getCardBackgroundColor())
+  }
+}
diff --git a/entry/src/main/ets/ui/views/EntryAdapter.ets b/entry/src/main/ets/ui/views/EntryAdapter.ets
new file mode 100644
index 0000000..f9253b7
--- /dev/null
+++ b/entry/src/main/ets/ui/views/EntryAdapter.ets
@@ -0,0 +1,819 @@
+import { VaultEntry } from '../../vault/VaultEntry';
+import { VaultGroup } from '../../vault/VaultGroup';
+import { CodeGrouping, Preferences } from '../../Preferences';
+import { AccountNamePosition } from '../../AccountNamePosition';
+import { CopyBehavior } from '../../CopyBehavior';
+import { SortCategory, SortCategoryUtils } from '../../SortCategory';
+import { ViewMode } from '../../ViewMode';
+import { TotpInfo } from '../../otp/TotpInfo';
+import { HotpInfo } from '../../otp/HotpInfo';
+import { OtpInfo } from '../../otp/OtpInfo';
+import { ErrorCardInfo } from '../models/ErrorCardInfo';
+import { Comparators } from '../../helpers/comparators/Comparator';
+import { FavoriteComparator } from '../../helpers/comparators/FavoriteComparator';
+import { CollectionUtils } from '../../util/CollectionUtils';
+import { ItemTouchHelperAdapter } from '../../helpers/ItemTouchHelperAdapter';
+
+export interface EntryAdapterListener {
+  onEntryClick(entry: VaultEntry): void;
+
+  onLongEntryClick(entry: VaultEntry): void;
+
+  onEntryMove(entry1: VaultEntry, entry2: VaultEntry): void;
+
+  onEntryDrop(entry: VaultEntry): void;
+
+  onEntryChange(entry: VaultEntry): void;
+
+  onEntryCopy(entry: VaultEntry): void;
+
+  onPeriodUniformityChanged(uniform: boolean, period: number): void;
+
+  onSelect(entry: VaultEntry): void;
+
+  onDeselect(entry: VaultEntry): void;
+
+  onListChange(): void;
+}
+
+/**
+ * Port of EntryList (the list model of the adapter).
+ */
+export class EntryList {
+  private readonly _entries: VaultEntry[];
+  private readonly _shownEntries: VaultEntry[];
+  private readonly _errorCardInfo: ErrorCardInfo | null;
+
+  constructor(entries?: VaultEntry[], shownEntries?: VaultEntry[], errorCardInfo?: ErrorCardInfo | null) {
+    this._entries = entries !== undefined ? entries : [];
+    this._shownEntries = shownEntries !== undefined ? shownEntries : [];
+    this._errorCardInfo = errorCardInfo !== undefined ? errorCardInfo : null;
+  }
+
+  getEntries(): VaultEntry[] {
+    return this._entries;
+  }
+
+  getShownEntries(): VaultEntry[] {
+    return this._shownEntries;
+  }
+
+  getItemCount(): number {
+    // Always at least one item because of the footer
+    // Two in case there's also an error card
+    let baseCount = 1;
+    if (this.isErrorCardShown()) {
+      baseCount++;
+    }
+    return baseCount + this.getShownEntries().length;
+  }
+
+  getErrorCardInfo(): ErrorCardInfo | null {
+    return this._errorCardInfo;
+  }
+
+  isErrorCardShown(): boolean {
+    return this._errorCardInfo !== null;
+  }
+
+  isPositionErrorCard(position: number): boolean {
+    return this.isErrorCardShown() && position === 0;
+  }
+
+  isPositionFooter(position: number): boolean {
+    return position === (this.getItemCount() - 1);
+  }
+
+  /**
+   * Translates the given entry position in the list, to its index in the shown entries list.
+   */
+  translateEntryPosToIndex(position: number): number {
+    if (position < 0) {
+      return -1;
+    }
+    return this.isErrorCardShown() ? position - 1 : position;
+  }
+
+  /**
+   * Translates the given entry index in the shown entries list, to its position in the list.
+   */
+  translateEntryIndexToPos(index: number): number {
+    if (index < 0) {
+      return -1;
+    }
+    return this.isErrorCardShown() ? index + 1 : index;
+  }
+}
+
+/**
+ * Port of EntryAdapter: holds the list of entries, applies search/group filters and sorting and
+ * keeps track of the focus/selection state. The EntryListView component renders it.
+ */
+export class EntryAdapter implements ItemTouchHelperAdapter {
+  static readonly DOUBLE_TAP_TIMEOUT: number = 300;
+
+  private _view: EntryAdapterListener | null;
+  private _entryList: EntryList = new EntryList();
+  private _selectedEntries: VaultEntry[] = [];
+  private _groups: VaultGroup[] = [];
+  private _usageCounts: Map<string, number> = new Map<string, number>();
+  private _lastUsedTimestamps: Map<string, number> = new Map<string, number>();
+  private _focusedEntry: VaultEntry | null = null;
+  private _clickedEntry: VaultEntry | null = null;
+  private _copiedEntry: string | null = null;
+  private _codeGroupSize: CodeGrouping = CodeGrouping.GROUPING_THREES;
+  private _accountNamePosition: AccountNamePosition = AccountNamePosition.END;
+  private _showIcon: boolean = true;
+  private _showNextCode: boolean = false;
+  private _showExpirationState: boolean = true;
+  private _onlyShowNecessaryAccountNames: boolean = false;
+  private _highlightEntry: boolean = false;
+  private _tempHighlightEntry: boolean = false;
+  private _tapToReveal: boolean = false;
+  private _tapToRevealTime: number = 30;
+  private _copyBehavior: CopyBehavior = CopyBehavior.NEVER;
+  private _searchBehaviorMask: number = Preferences.SEARCH_IN_ISSUER | Preferences.SEARCH_IN_NAME;
+  private _groupFilter: Set<string | null> = new Set<string | null>();
+  private _sortCategory: SortCategory | null = null;
+  private _viewMode: ViewMode = ViewMode.NORMAL;
+  private _searchFilter: string | null = null;
+  private _isPeriodUniform: boolean = true;
+  private _uniformPeriod: number = -1;
+  private _dimHandler: number = -1;
+  private _doubleTapHandler: number = -1;
+  private _copyHandler: number = -1;
+  private _pauseFocused: boolean = false;
+  private _version: number = 0;
+  private _listVersion: number = 0;
+  private _onChange: (() => void) | null = null;
+
+  constructor(view: EntryAdapterListener) {
+    this._view = view;
+  }
+
+  /**
+   * Registers the callback that re-renders the list view (replacement for notifyDataSetChanged).
+   */
+  setOnChangeListener(listener: (() => void) | null): void {
+    this._onChange = listener;
+  }
+
+  private notifyChanged(): void {
+    this._version++;
+    if (this._onChange !== null) {
+      this._onChange();
+    }
+  }
+
+  getVersion(): number {
+    return this._version;
+  }
+
+  getListVersion(): number {
+    return this._listVersion;
+  }
+
+  destroy(): void {
+    this.clearHandlers();
+    this._view = null;
+    this._onChange = null;
+  }
+
+  private clearHandlers(): void {
+    if (this._dimHandler >= 0) {
+      clearTimeout(this._dimHandler);
+      this._dimHandler = -1;
+    }
+    if (this._doubleTapHandler >= 0) {
+      clearTimeout(this._doubleTapHandler);
+      this._doubleTapHandler = -1;
+    }
+    if (this._copyHandler >= 0) {
+      clearTimeout(this._copyHandler);
+      this._copyHandler = -1;
+    }
+  }
+
+  setCodeGroupSize(codeGroupSize: CodeGrouping): void {
+    this._codeGroupSize = codeGroupSize;
+  }
+
+  getCodeGroupSize(): CodeGrouping {
+    return this._codeGroupSize;
+  }
+
+  setAccountNamePosition(accountNamePosition: AccountNamePosition): void {
+    this._accountNamePosition = accountNamePosition;
+  }
+
+  setOnlyShowNecessaryAccountNames(onlyShowNecessaryAccountNames: boolean): void {
+    this._onlyShowNecessaryAccountNames = onlyShowNecessaryAccountNames;
+  }
+
+  setShowIcon(showIcon: boolean): void {
+    this._showIcon = showIcon;
+  }
+
+  isShowIcon(): boolean {
+    return this._showIcon;
+  }
+
+  setShowNextCode(showNextCode: boolean): void {
+    this._showNextCode = showNextCode;
+  }
+
+  isShowNextCode(): boolean {
+    return this._showNextCode;
+  }
+
+  setShowExpirationState(showExpirationState: boolean): void {
+    this._showExpirationState = showExpirationState;
+  }
+
+  isShowExpirationState(): boolean {
+    return this._showExpirationState;
+  }
+
+  setTapToReveal(tapToReveal: boolean): void {
+    this._tapToReveal = tapToReveal;
+  }
+
+  setTapToRevealTime(n: number): void {
+    this._tapToRevealTime = n;
+  }
+
+  setHighlightEntry(highlightEntry: boolean): void {
+    this._highlightEntry = highlightEntry;
+  }
+
+  setTempHighlightEntry(highlightEntry: boolean): void {
+    this._tempHighlightEntry = highlightEntry;
+  }
+
+  setCopyBehavior(copyBehavior: CopyBehavior): void {
+    this._copyBehavior = copyBehavior;
+  }
+
+  setSearchBehaviorMask(searchBehaviorMask: number): void {
+    this._searchBehaviorMask = searchBehaviorMask;
+  }
+
+  setPauseFocused(pauseFocused: boolean): void {
+    this._pauseFocused = pauseFocused;
+  }
+
+  setErrorCardInfo(info: ErrorCardInfo | null): void {
+    const current = this._entryList.getErrorCardInfo();
+    if ((info === null && current === null) || (info !== null && info.equals(current))) {
+      return;
+    }
+    this.replaceEntryList(new EntryList(this._entryList.getEntries(), this._entryList.getShownEntries(), info));
+  }
+
+  getErrorCardInfo(): ErrorCardInfo | null {
+    return this._entryList.getErrorCardInfo();
+  }
+
+  getEntryAtPosition(position: number): VaultEntry {
+    return this._entryList.getShownEntries()[this._entryList.translateEntryPosToIndex(position)];
+  }
+
+  getEntryPosition(entry: VaultEntry): number {
+    return this._entryList.translateEntryIndexToPos(this.indexOfShown(entry));
+  }
+
+  private indexOfShown(entry: VaultEntry): number {
+    const shown = this._entryList.getShownEntries();
+    for (let i = 0; i < shown.length; i++) {
+      if (shown[i].getUUID() === entry.getUUID()) {
+        return i;
+      }
+    }
+    return -1;
+  }
+
+  setEntries(entries: VaultEntry[]): void {
+    for (const entry of entries) {
+      const count = this._usageCounts.get(entry.getUUID());
+      entry.setUsageCount(count !== undefined ? count : 0);
+      const ts = this._lastUsedTimestamps.get(entry.getUUID());
+      entry.setLastUsedTimestamp(ts !== undefined ? ts : 0);
+    }
+    this._listVersion++;
+    // keep the selection pointing at the new entry objects
+    this._selectedEntries = this._selectedEntries
+      .map((e: VaultEntry) => entries.find((n: VaultEntry) => n.getUUID() === e.getUUID()))
+      .filter((e: VaultEntry | undefined) => e !== undefined)
+      .map((e: VaultEntry | undefined) => e as VaultEntry);
+    this.replaceEntryList(new EntryList(entries, this.calculateShownEntries(entries), this._entryList.getErrorCardInfo()));
+  }
+
+  clearEntries(): void {
+    this._listVersion++;
+    this.replaceEntryList(new EntryList());
+  }
+
+  translateEntryPosToIndex(position: number): number {
+    return this._entryList.translateEntryPosToIndex(position);
+  }
+
+  private isEntryFiltered(entry: VaultEntry): boolean {
+    const groups = entry.getGroups();
+    const issuer = entry.getIssuer().toLowerCase();
+    const name = entry.getName().toLowerCase();
+    const note = entry.getNote().toLowerCase();
+
+    if (this._searchFilter !== null) {
+      const tokens = this._searchFilter.toLowerCase().split(new RegExp('\\s+')).filter((t: string) => t.length > 0);
+      // Return true if not all tokens match at least one of the relevant fields
+      return !tokens.every((token: string) =>
+      ((this._searchBehaviorMask & Preferences.SEARCH_IN_ISSUER) !== 0 && issuer.indexOf(token) >= 0) ||
+        ((this._searchBehaviorMask & Preferences.SEARCH_IN_NAME) !== 0 && name.indexOf(token) >= 0) ||
+        ((this._searchBehaviorMask & Preferences.SEARCH_IN_NOTE) !== 0 && note.indexOf(token) >= 0) ||
+        ((this._searchBehaviorMask & Preferences.SEARCH_IN_GROUPS) !== 0 && this.doesAnyGroupMatchSearchFilter(groups, token))
+      );
+    }
+
+    if (this._groupFilter.size > 0) {
+      if (groups.size === 0 && !this._groupFilter.has(null)) {
+        return true;
+      }
+      if (groups.size > 0) {
+        const nonNull = Array.from(this._groupFilter).filter((g: string | null) => g !== null);
+        if (!nonNull.some((g: string | null) => groups.has(g as string))) {
+          return true;
+        }
+      }
+    }
+
+    return false;
+  }
+
+  private doesAnyGroupMatchSearchFilter(entryGroupUUIDs: Set<string>, searchFilter: string): boolean {
+    return this._groups
+      .filter((group: VaultGroup) => entryGroupUUIDs.has(group.getUUID()))
+      .map((group: VaultGroup) => group.getName())
+      .some((groupName: string) => groupName.toLowerCase().indexOf(searchFilter.toLowerCase()) >= 0);
+  }
+
+  refresh(hard: boolean): void {
+    if (hard) {
+      this.refreshEntryList();
+    } else {
+      this.notifyChanged();
+    }
+  }
+
+  setGroupFilter(groups: Set<string | null>): void {
+    if (EntryAdapter.setsEqual(this._groupFilter, groups)) {
+      return;
+    }
+    this._groupFilter = groups;
+    this.refreshEntryList();
+  }
+
+  getGroupFilter(): Set<string | null> {
+    return this._groupFilter;
+  }
+
+  static setsEqual(a: Set<string | null>, b: Set<string | null>): boolean {
+    if (a.size !== b.size) {
+      return false;
+    }
+    for (const v of Array.from(a)) {
+      if (!b.has(v)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  setSortCategory(category: SortCategory, apply: boolean): void {
+    if (this._sortCategory === category) {
+      return;
+    }
+    this._sortCategory = category;
+    if (apply) {
+      this.refreshEntryList();
+    }
+  }
+
+  getSearchFilter(): string | null {
+    return this._searchFilter;
+  }
+
+  setSearchFilter(search: string | null): void {
+    const newSearchFilter = (search !== null && search.length > 0) ? search.toLowerCase().trim() : null;
+    if (this._searchFilter !== newSearchFilter) {
+      this._searchFilter = newSearchFilter !== null && newSearchFilter.length > 0 ? newSearchFilter : null;
+      this.refreshEntryList();
+    }
+  }
+
+  private refreshEntryList(): void {
+    this.replaceEntryList(new EntryList(
+      this._entryList.getEntries(),
+      this.calculateShownEntries(this._entryList.getEntries()),
+      this._entryList.getErrorCardInfo()
+    ));
+  }
+
+  private replaceEntryList(newEntryList: EntryList): void {
+    this._entryList = newEntryList;
+    this.updatePeriodUniformity();
+    this.notifyChanged();
+    if (this._view !== null) {
+      this._view.onListChange();
+    }
+  }
+
+  private calculateShownEntries(entries: VaultEntry[]): VaultEntry[] {
+    const res: VaultEntry[] = [];
+    for (const entry of entries) {
+      if (!this.isEntryFiltered(entry)) {
+        res.push(entry);
+      }
+    }
+    EntryAdapter.sortEntries(res, this._sortCategory);
+    return res;
+  }
+
+  private static sortEntries(entries: VaultEntry[], sortCategory: SortCategory | null): void {
+    if (sortCategory !== null) {
+      const comparator = SortCategoryUtils.getComparator(sortCategory);
+      if (comparator !== null) {
+        Comparators.sort<VaultEntry>(entries, comparator);
+      }
+    }
+    Comparators.sort<VaultEntry>(entries, new FavoriteComparator());
+  }
+
+  isEntryDraggable(entry: VaultEntry | null): boolean {
+    return entry !== null
+      && this.isDragAndDropAllowed()
+      && this._selectedEntries.length === 1
+      && !this._selectedEntries[0].isFavorite()
+      && this._selectedEntries[0].getUUID() === entry.getUUID();
+  }
+
+  setViewMode(viewMode: ViewMode): void {
+    this._viewMode = viewMode;
+  }
+
+  getViewMode(): ViewMode {
+    return this._viewMode;
+  }
+
+  setUsageCounts(usageCounts: Map<string, number>): void {
+    this._usageCounts = usageCounts;
+  }
+
+  getUsageCounts(): Map<string, number> {
+    return this._usageCounts;
+  }
+
+  setGroups(groups: VaultGroup[]): void {
+    this._groups = groups;
+  }
+
+  setLastUsedTimestamps(lastUsedTimestamps: Map<string, number>): void {
+    this._lastUsedTimestamps = lastUsedTimestamps;
+  }
+
+  getLastUsedTimestamps(): Map<string, number> {
+    return this._lastUsedTimestamps;
+  }
+
+  getShownFavoritesCount(): number {
+    return this._entryList.getShownEntries().filter((e: VaultEntry) => e.isFavorite()).length;
+  }
+
+  getShownEntries(): VaultEntry[] {
+    return this._entryList.getShownEntries();
+  }
+
+  onItemDismiss(position: number): void {
+  }
+
+  onItemDrop(position: number): void {
+    // moving entries is not allowed when a filter is applied
+    // footer cant be moved, nor can items be moved below it
+    if (this._groupFilter.size > 0 || this._entryList.isPositionFooter(position) || this._entryList.isPositionErrorCard(position)) {
+      return;
+    }
+    const index = this._entryList.translateEntryPosToIndex(position);
+    if (this._view !== null && index >= 0 && index < this._entryList.getShownEntries().length) {
+      this._view.onEntryDrop(this._entryList.getShownEntries()[index]);
+    }
+  }
+
+  onItemMove(firstPosition: number, secondPosition: number): void {
+    // Moving entries is not allowed when a filter is applied. The footer can't be
+    // moved, nor can items be moved below it
+    if (this._groupFilter.size > 0
+      || this._entryList.isPositionFooter(firstPosition) || this._entryList.isPositionFooter(secondPosition)
+      || this._entryList.isPositionErrorCard(firstPosition) || this._entryList.isPositionErrorCard(secondPosition)) {
+      return;
+    }
+
+    // Notify the vault about the entry position change first
+    const firstIndex = this._entryList.translateEntryPosToIndex(firstPosition);
+    const secondIndex = this._entryList.translateEntryPosToIndex(secondPosition);
+    const shown = this._entryList.getShownEntries();
+    if (firstIndex < 0 || secondIndex < 0 || firstIndex >= shown.length || secondIndex >= shown.length) {
+      return;
+    }
+    const firstEntry = shown[firstIndex];
+    const secondEntry = shown[secondIndex];
+    if (this._view !== null) {
+      this._view.onEntryMove(firstEntry, secondEntry);
+    }
+
+    // Then update the visual end
+    const newEntries = this._entryList.getEntries().slice();
+    CollectionUtils.move<VaultEntry>(newEntries, newEntries.indexOf(firstEntry), newEntries.indexOf(secondEntry));
+    this.replaceEntryList(new EntryList(newEntries, this.calculateShownEntries(newEntries), this._entryList.getErrorCardInfo()));
+  }
+
+  // --- per entry state that is used by EntryHolder ---
+
+  isHidden(entry: VaultEntry): boolean {
+    return this._tapToReveal && !this.isFocused(entry);
+  }
+
+  isPaused(entry: VaultEntry): boolean {
+    return this._pauseFocused && this.isFocused(entry);
+  }
+
+  isDimmed(entry: VaultEntry): boolean {
+    return (this._highlightEntry || this._tempHighlightEntry) && this._focusedEntry !== null && !this.isFocused(entry);
+  }
+
+  private isFocused(entry: VaultEntry): boolean {
+    return this._focusedEntry !== null && this._focusedEntry.getUUID() === entry.getUUID();
+  }
+
+  isSelected(entry: VaultEntry): boolean {
+    return this._selectedEntries.some((e: VaultEntry) => e.getUUID() === entry.getUUID());
+  }
+
+  isCopied(entry: VaultEntry): boolean {
+    return this._copiedEntry === entry.getUUID();
+  }
+
+  /**
+   * only show the progress bar if there is no uniform period and the entry type is TotpInfo
+   */
+  showProgress(entry: VaultEntry): boolean {
+    const info = entry.getInfo();
+    return info instanceof TotpInfo && (info as TotpInfo).getPeriod() !== this.getMostFrequentPeriod();
+  }
+
+  getAccountNamePositionFor(entry: VaultEntry): AccountNamePosition {
+    let showAccountName = true;
+    if (this._onlyShowNecessaryAccountNames) {
+      // Only show account name when there's multiple entries found with the same issuer.
+      showAccountName = this._entryList.getEntries().filter((x: VaultEntry) => x.getIssuer() === entry.getIssuer()).length > 1;
+    }
+    return showAccountName ? this._accountNamePosition : AccountNamePosition.HIDDEN;
+  }
+
+  /**
+   * Handles a click on the given entry (port of the click listener in onBindViewHolder).
+   */
+  onEntryClick(entry: VaultEntry): void {
+    let handled = false;
+    if (this._selectedEntries.length === 0) {
+      if (this._highlightEntry || this._tempHighlightEntry || this._tapToReveal) {
+        if (this.isFocused(entry)) {
+          this.resetFocus();
+        } else {
+          this.focusEntry(entry, this._tapToRevealTime);
+          // Prevent copying when singletap is set and the entry is being revealed
+          handled = this._copyBehavior === CopyBehavior.SINGLETAP && this._tapToReveal;
+        }
+      }
+
+      switch (this._copyBehavior) {
+        case CopyBehavior.SINGLETAP:
+          if (!handled) {
+            this.copyEntry(entry);
+            this._clickedEntry = null;
+          }
+          break;
+        case CopyBehavior.DOUBLETAP:
+          if (this._doubleTapHandler >= 0) {
+            clearTimeout(this._doubleTapHandler);
+          }
+          this._doubleTapHandler = setTimeout(() => {
+            this._clickedEntry = null;
+            this._doubleTapHandler = -1;
+          }, EntryAdapter.DOUBLE_TAP_TIMEOUT);
+          if (this._clickedEntry !== null && this._clickedEntry.getUUID() === entry.getUUID()) {
+            this.copyEntry(entry);
+            this._clickedEntry = null;
+          } else {
+            this._clickedEntry = entry;
+          }
+          break;
+        default:
+          break;
+      }
+
+      this.incrementUsageCount(entry);
+    } else {
+      if (this.isSelected(entry)) {
+        if (this._view !== null) {
+          this._view.onDeselect(entry);
+        }
+        this.removeSelectedEntry(entry);
+      } else {
+        this.addSelectedEntry(entry);
+        if (this._view !== null) {
+          this._view.onSelect(entry);
+        }
+      }
+    }
+
+    if (!handled && this._view !== null) {
+      this._view.onEntryClick(entry);
+    }
+    this.notifyChanged();
+  }
+
+  /**
+   * Copies the code of the entry and shows the "Copied" animation for 3 seconds.
+   */
+  private copyEntry(entry: VaultEntry): void {
+    if (this._view !== null) {
+      this._view.onEntryCopy(entry);
+    }
+    this.animateCopyText(entry);
+  }
+
+  animateCopyText(entry: VaultEntry): void {
+    if (this._copyHandler >= 0) {
+      clearTimeout(this._copyHandler);
+    }
+    this._copiedEntry = entry.getUUID();
+    this._copyHandler = setTimeout(() => {
+      this._copiedEntry = null;
+      this._copyHandler = -1;
+      this.notifyChanged();
+    }, 3000);
+  }
+
+  onEntryLongClick(entry: VaultEntry): void {
+    if (this._view !== null) {
+      this._view.onLongEntryClick(entry);
+    }
+    this.notifyChanged();
+  }
+
+  /**
+   * This will only be called if the entry is of type HotpInfo
+   */
+  onRefreshClick(entry: VaultEntry): void {
+    (entry.getInfo() as HotpInfo).incrementCounter();
+    this.focusEntry(entry, this._tapToRevealTime);
+
+    // notify the listener that the counter has been incremented
+    // this gives it a chance to save the vault
+    if (this._view !== null) {
+      this._view.onEntryChange(entry);
+    }
+
+    // finally, refresh the code in the UI
+    this.notifyChanged();
+  }
+
+  private updatePeriodUniformity(): void {
+    const mostFrequentPeriod = this.getMostFrequentPeriod();
+    const uniform = this.isPeriodUniform();
+    if (uniform === this._isPeriodUniform && mostFrequentPeriod === this._uniformPeriod) {
+      return;
+    }
+    this._isPeriodUniform = uniform;
+    this._uniformPeriod = mostFrequentPeriod;
+    if (this._view !== null) {
+      this._view.onPeriodUniformityChanged(this._isPeriodUniform, this._uniformPeriod);
+    }
+  }
+
+  getMostFrequentPeriod(): number {
+    const infos: TotpInfo[] = [];
+    for (const entry of this._entryList.getShownEntries()) {
+      const info: OtpInfo = entry.getInfo();
+      if (info instanceof TotpInfo) {
+        infos.push(info as TotpInfo);
+      }
+    }
+
+    if (infos.length === 0) {
+      return -1;
+    }
+    if (infos.length === 1) {
+      return infos[0].getPeriod();
+    }
+
+    const occurrences = new Map<number, number>();
+    for (const info of infos) {
+      const period = info.getPeriod();
+      const c = occurrences.get(period);
+      occurrences.set(period, c !== undefined ? c + 1 : 1);
+    }
+
+    let maxValue = 0;
+    let maxKey = 0;
+    occurrences.forEach((value: number, key: number) => {
+      if (value > maxValue) {
+        maxValue = value;
+        maxKey = key;
+      }
+    });
+
+    return maxValue > 1 ? maxKey : -1;
+  }
+
+  focusEntry(entry: VaultEntry, secondsToFocus: number): void {
+    this._focusedEntry = entry;
+    if (this._dimHandler >= 0) {
+      clearTimeout(this._dimHandler);
+    }
+    this._dimHandler = setTimeout(() => {
+      this._dimHandler = -1;
+      this.resetFocus();
+      this.notifyChanged();
+    }, secondsToFocus * 1000);
+    this.notifyChanged();
+  }
+
+  private resetFocus(): void {
+    this._focusedEntry = null;
+    this._tempHighlightEntry = false;
+  }
+
+  removeSelectedEntry(entry: VaultEntry): void {
+    this._selectedEntries = this._selectedEntries.filter((e: VaultEntry) => e.getUUID() !== entry.getUUID());
+    this.notifyChanged();
+  }
+
+  addSelectedEntry(entry: VaultEntry): void {
+    if (this._focusedEntry !== null) {
+      this.resetFocus();
+    }
+    if (!this.isSelected(entry)) {
+      this._selectedEntries.push(entry);
+    }
+    this.notifyChanged();
+  }
+
+  selectAllEntries(): VaultEntry[] {
+    this._selectedEntries = this._entryList.getShownEntries().slice();
+    this.notifyChanged();
+    return this._selectedEntries.slice();
+  }
+
+  deselectAllEntries(): void {
+    this._selectedEntries = [];
+    this.notifyChanged();
+  }
+
+  private incrementUsageCount(entry: VaultEntry): void {
+    const count = this._usageCounts.get(entry.getUUID());
+    this._usageCounts.set(entry.getUUID(), count === undefined ? 1 : count + 1);
+    this._lastUsedTimestamps.set(entry.getUUID(), Date.now());
+  }
+
+  isDragAndDropAllowed(): boolean {
+    return this._sortCategory === SortCategory.CUSTOM && this._groupFilter.size === 0 && this._searchFilter === null;
+  }
+
+  isPeriodUniform(): boolean {
+    return EntryAdapter.isPeriodUniformValue(this.getMostFrequentPeriod());
+  }
+
+  private static isPeriodUniformValue(period: number): boolean {
+    return period !== -1;
+  }
+
+  getItemCount(): number {
+    return this._entryList.getItemCount();
+  }
+
+  getShownEntriesCount(): number {
+    return this._entryList.getShownEntries().length;
+  }
+
+  isPositionFooter(position: number): boolean {
+    return this._entryList.isPositionFooter(position);
+  }
+
+  isPositionErrorCard(position: number): boolean {
+    return this._entryList.isPositionErrorCard(position);
+  }
+
+  isErrorCardShown(): boolean {
+    return this._entryList.isErrorCardShown();
+  }
+}
diff --git a/entry/src/main/ets/ui/views/EntryHolder.ets b/entry/src/main/ets/ui/views/EntryHolder.ets
new file mode 100644
index 0000000..e99b7ef
--- /dev/null
+++ b/entry/src/main/ets/ui/views/EntryHolder.ets
@@ -0,0 +1,588 @@
+import { VaultEntry } from '../../vault/VaultEntry';
+import { EntryAdapter } from './EntryAdapter';
+import { TotpInfo } from '../../otp/TotpInfo';
+import { HotpInfo } from '../../otp/HotpInfo';
+import { SteamInfo } from '../../otp/SteamInfo';
+import { YandexInfo } from '../../otp/YandexInfo';
+import { OtpInfo } from '../../otp/OtpInfo';
+import { CodeGrouping } from '../../Preferences';
+import { ViewMode, ViewModeUtils } from '../../ViewMode';
+import { AccountNamePosition } from '../../AccountNamePosition';
+import { EntryIconView, GlideHelper } from '../glide/GlideHelper';
+import { TotpProgressBar } from './TotpProgressBar';
+import { SimpleAnimationEndListener } from '../../helpers/SimpleAnimationEndListener';
+
+const DEFAULT_ALPHA: number = 1.0;
+const DIMMED_ALPHA: number = 0.2;
+const HIDDEN_CHAR: string = '●';
+
+/**
+ * Port of EntryHolder: the card that displays a single entry in the entry list.
+ */
+@Component
+export struct EntryHolder {
+  entry: VaultEntry | null = null;
+  adapter: EntryAdapter | null = null;
+  @Prop @Watch('onRevisionChanged') revision: number = 0;
+  @Prop @Watch('onTick') tick: number = 0;
+  @Prop viewMode: number = ViewMode.NORMAL;
+  @Prop codeGrouping: number = CodeGrouping.GROUPING_THREES;
+  @Prop showIcon: boolean = true;
+  @Prop showDragHandle: boolean = false;
+  @Prop favoriteTop: boolean = true;
+  @Prop favoriteBottom: boolean = true;
+
+  @State code: string = '';
+  @State nextCode: string = '';
+  @State hidden: boolean = false;
+  @State paused: boolean = false;
+  @State selected: boolean = false;
+  @State dimmed: boolean = false;
+  @State copied: boolean = false;
+  @State expiring: boolean = false;
+  @State codeOpacity: number = 1;
+  @State itemAlpha: number = DEFAULT_ALPHA;
+  @State showProgress: boolean = false;
+  @State period: number = TotpInfo.DEFAULT_PERIOD;
+
+  private _refreshTimer: number = -1;
+  private _expirationTimer: number = -1;
+  private _blinkTimer: number = -1;
+
+  aboutToAppear(): void {
+    this.updateState();
+    this.refreshCode();
+  }
+
+  aboutToDisappear(): void {
+    this.stopRefreshLoop();
+    this.stopExpirationAnimation();
+  }
+
+  private getEntry(): VaultEntry {
+    return this.entry as VaultEntry;
+  }
+
+  private getAdapter(): EntryAdapter {
+    return this.adapter as EntryAdapter;
+  }
+
+  onRevisionChanged(): void {
+    const wasHidden = this.hidden;
+    const wasPaused = this.paused;
+    this.updateState();
+    if (this.hidden && !wasHidden) {
+      this.hideCode();
+    } else if (!this.hidden && wasHidden) {
+      this.revealCode();
+    } else if (wasPaused && !this.paused) {
+      this.refreshCode();
+    } else if (this.paused && !wasPaused) {
+      this.stopExpirationAnimation();
+    } else {
+      this.refreshCode();
+    }
+  }
+
+  onTick(): void {
+    if (!this.showProgress) {
+      this.refreshCode();
+    }
+  }
+
+  private updateState(): void {
+    if (this.entry === null || this.adapter === null) {
+      return;
+    }
+    const adapter = this.getAdapter();
+    const entry = this.getEntry();
+    this.hidden = adapter.isHidden(entry);
+    this.paused = adapter.isPaused(entry);
+    this.selected = adapter.isSelected(entry);
+    this.copied = adapter.isCopied(entry);
+    const dimmed = adapter.isDimmed(entry);
+    if (dimmed !== this.dimmed) {
+      this.dimmed = dimmed;
+      this.animateAlphaTo(dimmed ? DIMMED_ALPHA : DEFAULT_ALPHA);
+    }
+    this.setShowProgress(adapter.showProgress(entry));
+  }
+
+  private setShowProgress(showProgress: boolean): void {
+    let show = showProgress;
+    const info = this.getEntry().getInfo();
+    if (info instanceof HotpInfo) {
+      show = false;
+    }
+    if (show === this.showProgress && (!show || this._refreshTimer >= 0)) {
+      return;
+    }
+    this.showProgress = show;
+    if (show) {
+      this.period = (info as TotpInfo).getPeriod();
+      this.startRefreshLoop();
+    } else {
+      this.stopRefreshLoop();
+    }
+  }
+
+  /**
+   * Refreshes the code of this entry on its own schedule (used if the period of the entry differs
+   * from the most frequent period in the list).
+   */
+  startRefreshLoop(): void {
+    this.stopRefreshLoop();
+    const info = this.getEntry().getInfo();
+    if (!(info instanceof TotpInfo)) {
+      return;
+    }
+    this._refreshTimer = setTimeout(() => {
+      this._refreshTimer = -1;
+      this.refreshCode();
+      if (this.showProgress) {
+        this.startRefreshLoop();
+      }
+    }, (info as TotpInfo).getMillisTillNextRotation() + 10);
+  }
+
+  stopRefreshLoop(): void {
+    if (this._refreshTimer >= 0) {
+      clearTimeout(this._refreshTimer);
+      this._refreshTimer = -1;
+    }
+  }
+
+  refreshCode(): void {
+    if (this.entry === null) {
+      return;
+    }
+    if (!this.hidden && !this.paused) {
+      this.updateCodes();
+      this.startExpirationAnimation();
+    } else if (this.hidden) {
+      this.hideCode();
+    }
+  }
+
+  private updateCodes(): void {
+    this.code = this.getOtp(0);
+    if (this.isShowNextCode()) {
+      this.nextCode = this.getOtp(1);
+    }
+  }
+
+  private isShowNextCode(): boolean {
+    return this.getEntry().getInfo() instanceof TotpInfo && this.getAdapter().isShowNextCode();
+  }
+
+  private isShowExpirationState(): boolean {
+    return this.getEntry().getInfo() instanceof TotpInfo && this.getAdapter().isShowExpirationState();
+  }
+
+  private getOtp(offset: number): string {
+    const info: OtpInfo = this.getEntry().getInfo();
+
+    // In previous versions of Aegis, it was possible to import entries with an empty
+    // secret. Attempting to generate OTP's for such entries would result in a crash.
+    // In case we encounter an old entry that has this issue, we display "ERROR" as
+    // the OTP, instead of crashing.
+    let otp: string;
+    try {
+      if (info instanceof TotpInfo) {
+        const totp = info as TotpInfo;
+        otp = totp.getOtp(Math.floor(Date.now() / 1000) + offset * totp.getPeriod());
+      } else {
+        otp = info.getOtp();
+      }
+      if (!(info instanceof SteamInfo || info instanceof YandexInfo)) {
+        otp = this.formatCode(otp);
+      }
+    } catch (e) {
+      otp = getContext(this).resourceManager.getStringByNameSync('error_all_caps');
+    }
+    return otp;
+  }
+
+  private formatCode(code: string): string {
+    let groupSize: number;
+    switch (this.codeGrouping) {
+      case CodeGrouping.NO_GROUPING:
+        groupSize = code.length;
+        break;
+      case CodeGrouping.HALVES:
+        groupSize = Math.floor(code.length / 2) + (code.length % 2);
+        break;
+      default:
+        groupSize = this.codeGrouping;
+        if (groupSize <= 0) {
+          throw new Error('Code group size cannot be zero or negative');
+        }
+    }
+
+    let sb = '';
+    for (let i = 0; i < code.length; i++) {
+      if (i !== 0 && groupSize > 0 && i % groupSize === 0) {
+        sb += ' ';
+      }
+      sb += code.charAt(i);
+    }
+    return sb;
+  }
+
+  revealCode(): void {
+    this.updateCodes();
+    this.startExpirationAnimation();
+    this.hidden = false;
+  }
+
+  hideCode(): void {
+    const code = this.getOtp(0);
+    const hiddenText = code.replace(new RegExp('\\S', 'g'), HIDDEN_CHAR);
+    this.stopExpirationAnimation();
+    this.code = hiddenText;
+    this.nextCode = hiddenText;
+    this.hidden = true;
+  }
+
+  startExpirationAnimation(): void {
+    this.stopExpirationAnimation();
+    if (!this.isShowExpirationState()) {
+      return;
+    }
+
+    const totalStateDuration = 7000;
+    const info = this.getEntry().getInfo() as TotpInfo;
+    if (info.getPeriod() * 1000 <= totalStateDuration) {
+      this.expiring = true;
+      return;
+    }
+
+    const millisTill = info.getMillisTillNextRotation();
+    if (millisTill < totalStateDuration) {
+      this.setExpiring();
+    } else {
+      this._expirationTimer = setTimeout(() => {
+        this._expirationTimer = -1;
+        this.setExpiring();
+      }, millisTill - totalStateDuration);
+    }
+  }
+
+  private setExpiring(): void {
+    this.getUIContext().animateTo({ duration: 300 }, () => {
+      this.expiring = true;
+    });
+    const blinkDuration = 3000;
+    const info = this.getEntry().getInfo() as TotpInfo;
+    const millisTill = info.getMillisTillNextRotation();
+    const delay = Math.max(0, millisTill - blinkDuration);
+    this._blinkTimer = setTimeout(() => {
+      this._blinkTimer = -1;
+      const remaining = info.getMillisTillNextRotation();
+      const iterations = Math.max(1, Math.floor(remaining / 500));
+      this.getUIContext().animateTo({ duration: 500, iterations: iterations, playMode: PlayMode.Alternate }, () => {
+        this.codeOpacity = 0.5;
+      });
+    }, delay);
+  }
+
+  private stopExpirationAnimation(): void {
+    if (this._expirationTimer >= 0) {
+      clearTimeout(this._expirationTimer);
+      this._expirationTimer = -1;
+    }
+    if (this._blinkTimer >= 0) {
+      clearTimeout(this._blinkTimer);
+      this._blinkTimer = -1;
+    }
+    this.expiring = false;
+    this.getUIContext().animateTo({ duration: 0 }, () => {
+      this.codeOpacity = 1;
+    });
+  }
+
+  private animateAlphaTo(alpha: number): void {
+    const listener = new SimpleAnimationEndListener(() => {
+      this.itemAlpha = alpha;
+    });
+    this.getUIContext().animateTo(listener.toAnimateParam(200), () => {
+      this.itemAlpha = alpha;
+    });
+  }
+
+  private getCodeColor(): ResourceColor {
+    if (this.hidden) {
+      return $r('app.color.theme_outlineVariant');
+    }
+    if (this.expiring) {
+      return $r('app.color.theme_error');
+    }
+    return $r('app.color.theme_primary');
+  }
+
+  private getAccountNamePosition(): AccountNamePosition {
+    let pos = this.getAdapter().getAccountNamePositionFor(this.getEntry());
+    if (this.viewMode === ViewMode.TILES && pos === AccountNamePosition.END) {
+      pos = AccountNamePosition.BELOW;
+    }
+    return pos;
+  }
+
+  private getProfileName(): string {
+    const issuer = this.getEntry().getIssuer();
+    let name = this.getEntry().getName();
+    if (issuer.length > 0 && name.length > 0 && this.getAccountNamePosition() === AccountNamePosition.END) {
+      name = ViewModeUtils.getFormattedAccountName(this.viewMode as ViewMode, name);
+    }
+    return name;
+  }
+
+  private getIconSize(): number {
+    switch (this.viewMode) {
+      case ViewMode.NORMAL:
+        return 60;
+      case ViewMode.TILES:
+        return 24;
+      default:
+        return 45;
+    }
+  }
+
+  private getCodeSize(): number {
+    switch (this.viewMode) {
+      case ViewMode.NORMAL:
+        return 34;
+      default:
+        return 26;
+    }
+  }
+
+  private getLabelSize(): number {
+    switch (this.viewMode) {
+      case ViewMode.NORMAL:
+        return 16;
+      case ViewMode.TILES:
+        return 11;
+      default:
+        return 13;
+    }
+  }
+
+  private getVerticalPadding(): number {
+    switch (this.viewMode) {
+      case ViewMode.NORMAL:
+        return 16;
+      case ViewMode.COMPACT:
+        return 6;
+      case ViewMode.SMALL:
+        return 8;
+      default:
+        return 10;
+    }
+  }
+
+  private isHotp(): boolean {
+    return this.getEntry().getInfo() instanceof HotpInfo;
+  }
+
+  private getRadius(): BorderRadiuses {
+    const r = this.viewMode === ViewMode.COMPACT ? 8 : 16;
+    const fav = this.getEntry().isFavorite() && this.viewMode !== ViewMode.TILES;
+    return {
+      topLeft: fav && !this.favoriteTop ? 0 : r,
+      topRight: fav && !this.favoriteTop ? 0 : r,
+      bottomLeft: fav && !this.favoriteBottom ? 0 : r,
+      bottomRight: fav && !this.favoriteBottom ? 0 : r
+    };
+  }
+
+  @Builder
+  IconBuilder() {
+    Stack() {
+      EntryIconView({
+        iconKey: GlideHelper.getEntryIconKey(this.getEntry()),
+        issuer: this.getEntry().getIssuer(),
+        name: this.getEntry().getName(),
+        iconSize: this.getIconSize()
+      })
+      if (this.selected) {
+        Stack() {
+          Image($r('app.media.ic_outline_check_24'))
+            .width(this.getIconSize() * 0.5)
+            .height(this.getIconSize() * 0.5)
+            .fillColor($r('app.color.theme_onPrimary'))
+        }
+        .width(this.getIconSize())
+        .height(this.getIconSize())
+        .borderRadius(this.getIconSize() / 2)
+        .backgroundColor($r('app.color.theme_primary'))
+        .transition(TransitionEffect.scale({ x: 0, y: 0 }).animation({ duration: 200 }))
+      }
+    }
+  }
+
+  @Builder
+  DescriptionBuilder() {
+    if (this.copied) {
+      Text($r('app.string.copied'))
+        .fontSize(this.getLabelSize())
+        .fontColor($r('app.color.theme_onSurface'))
+        .maxLines(1)
+        .transition(TransitionEffect.OPACITY.combine(TransitionEffect.translate({ y: -8 })).animation({ duration: 250 }))
+    } else if (this.getAccountNamePosition() === AccountNamePosition.BELOW) {
+      Column() {
+        Text(this.getEntry().getIssuer())
+          .fontSize(this.getLabelSize())
+          .fontWeight(FontWeight.Bold)
+          .fontColor($r('app.color.theme_onSurface'))
+          .maxLines(1)
+          .textOverflow({ overflow: TextOverflow.Ellipsis })
+        Text(this.getProfileName())
+          .fontSize(this.getLabelSize())
+          .fontColor($r('app.color.theme_onSurfaceVariant'))
+          .maxLines(1)
+          .textOverflow({ overflow: TextOverflow.Ellipsis })
+      }
+      .alignItems(HorizontalAlign.Start)
+      .transition(TransitionEffect.OPACITY.animation({ duration: 250 }))
+    } else {
+      Row() {
+        Text(this.getEntry().getIssuer())
+          .fontSize(this.getLabelSize())
+          .fontWeight(FontWeight.Bold)
+          .fontColor($r('app.color.theme_onSurface'))
+          .maxLines(1)
+          .textOverflow({ overflow: TextOverflow.Ellipsis })
+          .flexShrink(1)
+        if (this.getAccountNamePosition() === AccountNamePosition.END && this.getProfileName().length > 0) {
+          Text(this.getProfileName())
+            .fontSize(this.getLabelSize())
+            .fontColor($r('app.color.theme_onSurfaceVariant'))
+            .maxLines(1)
+            .textOverflow({ overflow: TextOverflow.Ellipsis })
+            .margin({ left: this.getEntry().getIssuer().length > 0 ? 6 : 0 })
+            .flexShrink(1)
+        }
+      }
+      .transition(TransitionEffect.OPACITY.animation({ duration: 250 }))
+    }
+  }
+
+  @Builder
+  CodeBuilder() {
+    Text(this.code)
+      .fontSize(this.getCodeSize())
+      .fontWeight(FontWeight.Bold)
+      .fontColor(this.getCodeColor())
+      .opacity(this.codeOpacity)
+      .maxLines(1)
+      .direction(Direction.Ltr)
+    if (this.isShowNextCode()) {
+      Text(this.nextCode)
+        .fontSize(this.viewMode === ViewMode.NORMAL ? 20 : 16)
+        .fontWeight(FontWeight.Bold)
+        .fontColor(this.hidden ? $r('app.color.theme_outlineVariant') : $r('app.color.theme_onSurfaceVariant'))
+        .maxLines(1)
+        .padding({ left: 2 })
+    }
+  }
+
+  @Builder
+  ActionsBuilder() {
+    if (this.isHotp()) {
+      Image($r('app.media.ic_outline_refresh_24'))
+        .width(28)
+        .height(28)
+        .fillColor($r('app.color.theme_onSurfaceVariant'))
+        .margin({ left: 8 })
+        .id('buttonRefresh')
+        .onClick(() => this.getAdapter().onRefreshClick(this.getEntry()))
+    }
+    if (this.showDragHandle) {
+      Image($r('app.media.ic_outline_menu_24'))
+        .width(24)
+        .height(24)
+        .fillColor($r('app.color.theme_onSurfaceVariant'))
+        .margin({ left: 8 })
+    }
+  }
+
+  build() {
+    Column() {
+      if (this.viewMode === ViewMode.TILES) {
+        Column() {
+          Row() {
+            if (this.showIcon) {
+              this.IconBuilder()
+            }
+            Column() {
+              this.DescriptionBuilder()
+            }
+            .alignItems(HorizontalAlign.Start)
+            .layoutWeight(1)
+            .margin({ left: this.showIcon ? 8 : 0 })
+          }
+          .width('100%')
+
+          Row() {
+            Column() {
+              this.CodeBuilder()
+            }
+            .alignItems(HorizontalAlign.Start)
+            .layoutWeight(1)
+
+            this.ActionsBuilder()
+          }
+          .width('100%')
+          .margin({ top: 6 })
+        }
+        .padding({ left: 12, right: 12, top: 12, bottom: 8 })
+      } else {
+        Row() {
+          if (this.getEntry().isFavorite()) {
+            Column()
+              .width(4)
+              .height(this.getIconSize())
+              .borderRadius(2)
+              .backgroundColor($r('app.color.aegis_theme_all_favorite'))
+              .margin({ right: 10 })
+          } else {
+            Blank().width(14).layoutWeight(0)
+          }
+          if (this.showIcon) {
+            this.IconBuilder()
+          }
+          Column() {
+            this.DescriptionBuilder()
+            this.CodeBuilder()
+          }
+          .alignItems(HorizontalAlign.Start)
+          .layoutWeight(1)
+          .padding({ left: 16, right: 8 })
+
+          this.ActionsBuilder()
+        }
+        .width('100%')
+        .padding({ top: this.getVerticalPadding(), bottom: this.getVerticalPadding(), right: 16 })
+        .alignItems(VerticalAlign.Center)
+      }
+
+      if (this.showProgress) {
+        TotpProgressBar({ period: this.period, barHeight: 3 })
+      }
+    }
+    .width('100%')
+    .clip(true)
+    .borderRadius(this.getRadius())
+    .backgroundColor(this.selected ? $r('app.color.theme_secondaryContainer') : $r('app.color.theme_surfaceContainer'))
+    .opacity(this.itemAlpha)
+    .gesture(
+      GestureGroup(GestureMode.Exclusive,
+        LongPressGesture({ repeat: false })
+          .onAction(() => this.getAdapter().onEntryLongClick(this.getEntry())),
+        TapGesture({ count: 1 })
+          .onAction(() => this.getAdapter().onEntryClick(this.getEntry()))
+      )
+    )
+  }
+}
diff --git a/entry/src/main/ets/ui/views/EntryListView.ets b/entry/src/main/ets/ui/views/EntryListView.ets
