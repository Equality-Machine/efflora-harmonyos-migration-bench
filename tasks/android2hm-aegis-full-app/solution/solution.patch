+          .onClick(() => {
+            this.params.handle.dismiss();
+            this.params.onResult(this.checkedId === 1);
+          })
+      }
+      .width('100%')
+      .margin({ top: 16 })
+    }
+    .dialogContainer()
+  }
+}
+
+@Builder
+export function buildBackupsVersioningStrategyDialog(params: BackupsVersioningStrategyParams) {
+  BackupsVersioningStrategyDialogView({ params: params })
+}
diff --git a/entry/src/main/ets/ui/dialogs/Dialogs.ets b/entry/src/main/ets/ui/dialogs/Dialogs.ets
new file mode 100644
index 0000000..e3af19e
--- /dev/null
+++ b/entry/src/main/ets/ui/dialogs/Dialogs.ets
@@ -0,0 +1,401 @@
+import { DialogHandle } from './DialogHandle';
+import {
+  buildGenericDialog, GenericDialogParams, DialogButtonSpec, NeutralMode, buildTextInputDialog, TextInputDialogParams,
+  buildSetPasswordDialog, SetPasswordDialogParams, buildNumberPickerDialog, NumberPickerDialogParams,
+  buildChoiceDialog, ChoiceDialogParams, buildBackupsVersioningStrategyDialog, BackupsVersioningStrategyParams
+} from './DialogViews';
+import { VaultEntry } from '../../vault/VaultEntry';
+import { PasswordSlot } from '../../vault/slots/PasswordSlot';
+import { Slot } from '../../vault/slots/Slot';
+import { Cipher } from '../../crypto/Cipher';
+import { KeyDerivationTask } from '../tasks/KeyDerivationTask';
+import { SecretKey } from '../../crypto/CryptoUtils';
+import { BackupResult, Preferences } from '../../Preferences';
+import { BackupsVersioningStrategy } from '../../BackupsVersioningStrategy';
+import { DatabaseImporter, DatabaseImporterDefinition } from '../../importers/DatabaseImporter';
+import { AegisModule } from '../../AegisModule';
+import { AegisApplication } from '../../AegisApplication';
+import { ResUtils } from '../../util/ResUtils';
+import '../../importers/ImporterDefinitions';
+
+export type OnClickListener = () => void;
+export type TextInputListener = (text: string) => void;
+export type NumberInputListener = (n: number) => void;
+export type CheckboxInputListener = (checked: boolean) => void;
+export type ImporterListener = (definition: DatabaseImporterDefinition) => void;
+export type BackupsVersioningStrategyListener = (strategy: BackupsVersioningStrategy) => void;
+
+export interface PasswordSlotListener {
+  onSlotResult(slot: PasswordSlot, cipher: Cipher): void;
+
+  onException(e: Error): void;
+}
+
+function str(name: string, args?: Array<string | number>): string {
+  return ResUtils.getString(AegisModule.getContext(), name, args);
+}
+
+function wrap(listener: OnClickListener | null | undefined): ((checked: boolean) => void) | null {
+  if (listener === null || listener === undefined) {
+    return null;
+  }
+  const l: OnClickListener = listener;
+  return (checked: boolean) => l();
+}
+
+/**
+ * Port of the Dialogs helper class. All dialogs are shown as custom dialogs on the given UIContext.
+ */
+export class Dialogs {
+  private constructor() {
+  }
+
+  /**
+   * Dialogs are shown in the main window, which has privacy mode (FLAG_SECURE) enabled when the
+   * secure screen preference is on, so there's nothing extra to do for individual dialogs.
+   */
+  static secureDialog(handle: DialogHandle): void {
+    if (AegisModule.getPreferences().isSecureScreenEnabled()) {
+      AegisApplication.refreshSecureScreen();
+    }
+  }
+
+  static showSecureDialog(uiContext: UIContext, params: GenericDialogParams): DialogHandle {
+    const handle = Dialogs.showGeneric(uiContext, params);
+    Dialogs.secureDialog(handle);
+    return handle;
+  }
+
+  static showGeneric(uiContext: UIContext, params: GenericDialogParams, cancelable: boolean = true): DialogHandle {
+    return DialogHandle.open<GenericDialogParams>(uiContext, wrapBuilder(buildGenericDialog), params, params.handle, cancelable);
+  }
+
+  /**
+   * Shows a simple dialog with a title, message and up to three buttons.
+   */
+  static showSimpleDialog(uiContext: UIContext, title: ResourceStr, message: ResourceStr,
+    positive: ResourceStr | null, onPositive: OnClickListener | null,
+    negative: ResourceStr | null, onNegative: OnClickListener | null,
+    neutral?: ResourceStr, onNeutral?: OnClickListener, warning?: boolean): DialogHandle {
+    const params = new GenericDialogParams();
+    params.title = title;
+    params.message = message;
+    if (positive !== null) {
+      params.positive = new DialogButtonSpec(positive, wrap(onPositive));
+    }
+    if (negative !== null) {
+      params.negative = new DialogButtonSpec(negative, wrap(onNegative));
+    }
+    if (neutral !== undefined) {
+      params.neutral = new DialogButtonSpec(neutral, wrap(onNeutral));
+    }
+    if (warning === true) {
+      params.icon = $r('app.media.ic_outline_warning_24');
+    }
+    return Dialogs.showGeneric(uiContext, params);
+  }
+
+  static showDeleteEntriesDialog(uiContext: UIContext, services: VaultEntry[], onDelete: OnClickListener): void {
+    const entries = services.map((entry: VaultEntry) => `• ${Dialogs.getVaultEntryName(entry)}`).join('\n');
+    const params = new GenericDialogParams();
+    params.explanation = str('delete_entry_explanation', [entries]);
+    if (services.length > 1) {
+      params.title = $r('app.string.delete_entries');
+      params.message = ResUtils.getQuantityString(AegisModule.getContext(), 'delete_entries_description', services.length);
+    } else {
+      params.title = $r('app.string.delete_entry');
+      params.message = $r('app.string.delete_entry_description');
+    }
+    params.icon = $r('app.media.ic_outline_warning_24');
+    params.positive = new DialogButtonSpec($r('app.string.yes'), wrap(onDelete));
+    params.negative = new DialogButtonSpec($r('app.string.no'), null);
+    Dialogs.showGeneric(uiContext, params);
+  }
+
+  static getVaultEntryName(entry: VaultEntry): string {
+    if (entry.getIssuer().length > 0 && entry.getName().length > 0) {
+      return `${entry.getIssuer()} (${entry.getName()})`;
+    } else if (entry.getIssuer().length === 0 && entry.getName().length === 0) {
+      return str('unknown_issuer');
+    } else if (entry.getIssuer().length === 0) {
+      return entry.getName();
+    } else {
+      return entry.getIssuer();
+    }
+  }
+
+  static showDiscardDialog(uiContext: UIContext, onSave: OnClickListener, onDiscard: OnClickListener): void {
+    const params = new GenericDialogParams();
+    params.title = $r('app.string.discard_changes');
+    params.message = $r('app.string.discard_changes_description');
+    params.icon = $r('app.media.ic_outline_warning_24');
+    params.positive = new DialogButtonSpec($r('app.string.save'), wrap(onSave));
+    params.negative = new DialogButtonSpec($r('app.string.discard'), wrap(onDiscard));
+    Dialogs.showGeneric(uiContext, params);
+  }
+
+  /**
+   * Asks the user for a new password, derives a key from it and creates a new password slot.
+   */
+  static showSetPasswordDialog(uiContext: UIContext, listener: PasswordSlotListener): void {
+    const params = new SetPasswordDialogParams();
+    params.onResult = (password: string) => {
+      const slot = new PasswordSlot();
+      const task = new KeyDerivationTask(uiContext, (passSlot: PasswordSlot, key: SecretKey | null, e: Error | null) => {
+        if (key === null) {
+          listener.onException(e !== null ? e : new Error('Key derivation failed'));
+          return;
+        }
+        let cipher: Cipher;
+        try {
+          cipher = Slot.createEncryptCipher(key);
+        } catch (err) {
+          listener.onException(err as Error);
+          return;
+        }
+        listener.onSlotResult(slot, cipher);
+      });
+      task.execute(slot, password);
+    };
+    DialogHandle.open<SetPasswordDialogParams>(uiContext, wrapBuilder(buildSetPasswordDialog), params, params.handle, false);
+  }
+
+  static showTextInputDialog(uiContext: UIContext, title: ResourceStr, hint: ResourceStr, listener: TextInputListener,
+    text?: string, message?: ResourceStr, isSecret?: boolean, cancelListener?: OnClickListener): void {
+    const params = new TextInputDialogParams();
+    params.title = title;
+    params.hint = hint;
+    params.text = text !== undefined ? text : '';
+    params.message = message !== undefined ? message : '';
+    params.isSecret = isSecret === true;
+    params.onResult = listener;
+    params.onCancel = cancelListener !== undefined ? cancelListener : null;
+    if (cancelListener !== undefined) {
+      const cl: OnClickListener = cancelListener;
+      params.handle.setOnDismissListener(() => {
+        // only called for dismissals by the system (back press / touch outside) or the cancel button
+      });
+      params.onCancel = cl;
+    }
+    DialogHandle.open<TextInputDialogParams>(uiContext, wrapBuilder(buildTextInputDialog), params, params.handle, true);
+  }
+
+  static showPasswordInputDialog(uiContext: UIContext, listener: TextInputListener, cancelListener?: OnClickListener,
+    messageId?: ResourceStr, titleId?: ResourceStr): void {
+    Dialogs.showTextInputDialog(uiContext, titleId !== undefined ? titleId : $r('app.string.set_password'),
+      $r('app.string.password'), listener, '', messageId, true, cancelListener);
+  }
+
+  static showCheckboxDialog(uiContext: UIContext, titleId: ResourceStr, messageId: ResourceStr, checkboxMessageId: ResourceStr,
+    listener: CheckboxInputListener): void {
+    const params = new GenericDialogParams();
+    params.title = titleId;
+    params.message = messageId;
+    params.checkboxLabel = checkboxMessageId;
+    params.checkboxRequired = true;
+    params.positive = new DialogButtonSpec($r('app.string.yes'), (checked: boolean) => listener(checked));
+    params.negative = new DialogButtonSpec($r('app.string.no'), (checked: boolean) => listener(false));
+    Dialogs.showGeneric(uiContext, params);
+  }
+
+  static showTapToRevealTimeoutPickerDialog(uiContext: UIContext, currentValue: number, listener: NumberInputListener): void {
+    const values: string[] = [];
+    for (let i = 1; i <= 60; i++) {
+      values.push(`${i}`);
+    }
+    const params = new NumberPickerDialogParams();
+    params.title = $r('app.string.set_number');
+    params.values = values;
+    params.selected = Math.max(0, Math.min(59, currentValue - 1));
+    params.onResult = (index: number) => listener(index + 1);
+    DialogHandle.open<NumberPickerDialogParams>(uiContext, wrapBuilder(buildNumberPickerDialog), params, params.handle, true);
+  }
+
+  static showBackupVersionsPickerDialog(uiContext: UIContext, currentVersionCount: number, listener: NumberInputListener): void {
+    const infinite = str('pref_backups_versions_infinite');
+    const values: string[] = ['5', '10', '15', '20', '25', '30', infinite];
+    const numbers: number[] = [5, 10, 15, 20, 25, 30, Preferences.BACKUPS_VERSIONS_INFINITE];
+    let selectedIndex: number;
+    if (currentVersionCount === Preferences.BACKUPS_VERSIONS_INFINITE) {
+      selectedIndex = numbers.length - 1;
+    } else {
+      selectedIndex = Math.max(0, Math.min(numbers.length - 2, Math.floor(currentVersionCount / 5) - 1));
+    }
+    const params = new NumberPickerDialogParams();
+    params.title = $r('app.string.set_number');
+    params.values = values;
+    params.selected = selectedIndex;
+    params.onResult = (index: number) => listener(numbers[index]);
+    DialogHandle.open<NumberPickerDialogParams>(uiContext, wrapBuilder(buildNumberPickerDialog), params, params.handle, true);
+  }
+
+  static errorToString(e: Error): string {
+    return `${e.name}: ${e.message}`;
+  }
+
+  /**
+   * Shows an error dialog with a message and expandable/copyable error details.
+   */
+  static showErrorDialog(uiContext: UIContext, message: ResourceStr, error: Error | string, listener?: OnClickListener): void {
+    const params = new GenericDialogParams();
+    params.title = $r('app.string.error_occurred');
+    params.message = message;
+    params.details = typeof error === 'string' ? error as string : Dialogs.errorToString(error as Error);
+    params.icon = $r('app.media.ic_outline_error_24');
+    params.positive = new DialogButtonSpec($r('app.string.ok'), wrap(listener));
+    params.neutral = new DialogButtonSpec($r('app.string.details'), null);
+    params.neutralMode = NeutralMode.DETAILS_THEN_COPY;
+    Dialogs.showGeneric(uiContext, params, false);
+  }
+
+  static showBackupErrorDialog(uiContext: UIContext, backupRes: BackupResult, listener: OnClickListener): void {
+    const system = str(backupRes.isBuiltIn() ? 'backup_system_builtin' : 'backup_system_android');
+    const details = backupRes.isPermissionError() ? 'backup_permission_error_dialog_details' : 'backup_error_dialog_details';
+    const message = str(details, [system, backupRes.getElapsedSince(AegisModule.getContext())]);
+    const err = backupRes.getError();
+    Dialogs.showErrorDialog(uiContext, message, err !== null ? err : '', listener);
+  }
+
+  static showMultiErrorDialog(uiContext: UIContext, title: ResourceStr, message: ResourceStr, messages: string[],
+    listener: OnClickListener | null): void {
+    const params = new GenericDialogParams();
+    params.title = title;
+    params.message = message;
+    params.icon = $r('app.media.ic_outline_error_24');
+    params.positive = new DialogButtonSpec($r('app.string.ok'), wrap(listener));
+    params.neutral = new DialogButtonSpec($r('app.string.details'), (checked: boolean) => {
+      Dialogs.showDetailedMultiErrorDialog(uiContext, title, messages, listener);
+    });
+    Dialogs.showGeneric(uiContext, params, false);
+  }
+
+  static showMultiExceptionDialog(uiContext: UIContext, title: ResourceStr, message: ResourceStr, errors: Error[],
+    listener: OnClickListener | null): void {
+    const messages = errors.map((e: Error) => Dialogs.errorToString(e));
+    Dialogs.showMultiErrorDialog(uiContext, title, message, messages, listener);
+  }
+
+  private static showDetailedMultiErrorDialog(uiContext: UIContext, title: ResourceStr, messages: string[],
+    listener: OnClickListener | null): void {
+    const params = new GenericDialogParams();
+    params.title = title;
+    params.details = messages.join('\n\n');
+    params.detailsVisible = true;
+    params.icon = $r('app.media.ic_outline_error_24');
+    params.positive = new DialogButtonSpec($r('app.string.ok'), wrap(listener));
+    params.neutral = new DialogButtonSpec($r('app.string.copy'), null);
+    params.neutralMode = NeutralMode.COPY;
+    params.copiedToast = $r('app.string.errors_copied');
+    Dialogs.showGeneric(uiContext, params, false);
+  }
+
+  static showTimeSyncWarningDialog(uiContext: UIContext, listener: OnClickListener | null): void {
+    const prefs = AegisModule.getPreferences();
+    const params = new GenericDialogParams();
+    params.title = $r('app.string.time_sync_warning_title');
+    params.message = $r('app.string.time_sync_warning_message');
+    params.checkboxLabel = $r('app.string.time_sync_warning_disable');
+    params.icon = $r('app.media.ic_outline_warning_24');
+    params.positive = new DialogButtonSpec($r('app.string.yes'), (checked: boolean) => {
+      if (checked) {
+        prefs.setIsTimeSyncWarningEnabled(false);
+      }
+      if (listener !== null) {
+        listener();
+      }
+    });
+    params.negative = new DialogButtonSpec($r('app.string.no'), (checked: boolean) => {
+      if (checked) {
+        prefs.setIsTimeSyncWarningEnabled(false);
+      }
+    });
+    Dialogs.showGeneric(uiContext, params, false);
+  }
+
+  static showImportersDialog(uiContext: UIContext, isDirect: boolean, listener: ImporterListener): void {
+    const importers = DatabaseImporter.getImporters(isDirect);
+    const names = importers.map((d: DatabaseImporterDefinition) => d.getName());
+
+    let i = 0;
+    if (!isDirect) {
+      i = Math.max(0, names.indexOf(str('app_name')));
+    }
+
+    const params = new ChoiceDialogParams();
+    params.title = $r('app.string.choose_application');
+    params.items = names;
+    params.helpTexts = importers.map((d: DatabaseImporterDefinition) => Dialogs.getImporterHelpText(d, isDirect));
+    params.selected = i;
+    params.onResult = (index: number) => listener(importers[index]);
+    DialogHandle.open<ChoiceDialogParams>(uiContext, wrapBuilder(buildChoiceDialog), params, params.handle, true);
+  }
+
+  private static getImporterHelpText(definition: DatabaseImporterDefinition, isDirect: boolean): ResourceStr {
+    if (isDirect) {
+      return str('importer_help_direct', [definition.getName()]);
+    }
+    return definition.getHelp();
+  }
+
+  static showPartialGoogleAuthImportWarningDialog(uiContext: UIContext, missingIndexes: number[], entries: number,
+    scanningErrors: string[], dismissHandler: OnClickListener): void {
+    const missingIndexesAsString = missingIndexes
+      .map((index: number) => str('missing_qr_code_descriptor', [index + 1]))
+      .join('\n');
+
+    const params = new GenericDialogParams();
+    params.title = $r('app.string.partial_google_auth_import');
+    params.message = str('partial_google_auth_import_warning', [missingIndexesAsString]);
+    params.details = scanningErrors.join('\n\n');
+    params.icon = $r('app.media.ic_outline_warning_24');
+    params.positive = new DialogButtonSpec(
+      ResUtils.getQuantityString(AegisModule.getContext(), 'import_partial_export_anyway', entries), wrap(dismissHandler));
+    params.negative = new DialogButtonSpec($r('app.string.cancel'), null);
+    if (scanningErrors.length > 0) {
+      params.neutral = new DialogButtonSpec($r('app.string.show_error_details'), null);
+      params.neutralMode = NeutralMode.SHOW_DETAILS;
+    }
+    Dialogs.showGeneric(uiContext, params, false);
+  }
+
+  static showBackupsVersioningStrategy(uiContext: UIContext, currentStrategy: BackupsVersioningStrategy,
+    listener: BackupsVersioningStrategyListener): void {
+    const params = new BackupsVersioningStrategyParams();
+    params.current = currentStrategy === BackupsVersioningStrategy.MULTIPLE_BACKUPS ? 1 :
+      (currentStrategy === BackupsVersioningStrategy.SINGLE_BACKUP ? 2 : 0);
+    params.onResult = (multiple: boolean) => {
+      listener(multiple ? BackupsVersioningStrategy.MULTIPLE_BACKUPS : BackupsVersioningStrategy.SINGLE_BACKUP);
+    };
+    DialogHandle.open<BackupsVersioningStrategyParams>(uiContext, wrapBuilder(buildBackupsVersioningStrategyDialog),
+      params, params.handle, true);
+  }
+
+  /**
+   * Shows a list of items to choose from (replacement for setSingleChoiceItems / setItems).
+   */
+  static showSingleChoiceDialog(uiContext: UIContext, title: ResourceStr, items: string[], selected: number,
+    listener: NumberInputListener, dismissOnSelect?: boolean): void {
+    const params = new ChoiceDialogParams();
+    params.title = title;
+    params.items = items;
+    params.selected = selected;
+    params.dismissOnSelect = dismissOnSelect === true;
+    params.onResult = listener;
+    DialogHandle.open<ChoiceDialogParams>(uiContext, wrapBuilder(buildChoiceDialog), params, params.handle, true);
+  }
+
+  /**
+   * Shows a list of items with checkboxes (replacement for setMultiChoiceItems).
+   */
+  static showMultiChoiceDialog(uiContext: UIContext, title: ResourceStr, message: ResourceStr, items: string[],
+    checked: boolean[], listener: (checked: boolean[]) => void): void {
+    const params = new ChoiceDialogParams();
+    params.title = title;
+    params.message = message;
+    params.items = items;
+    params.multiple = true;
+    params.checkedItems = checked;
+    params.onMultiResult = listener;
+    DialogHandle.open<ChoiceDialogParams>(uiContext, wrapBuilder(buildChoiceDialog), params, params.handle, true);
+  }
+}
