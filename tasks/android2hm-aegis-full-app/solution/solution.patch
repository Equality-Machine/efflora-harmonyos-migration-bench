+  private checkIconOptimization(): void {
+    const vault = this._activity.getVaultManager().getVault();
+    if (!vault.areIconsOptimized()) {
+      const oldIcons = new Map<string, VaultEntryIcon>();
+      for (const e of vault.getEntries()) {
+        const icon = e.getIcon();
+        if (icon !== null && icon.getType() !== IconType.SVG && !BitmapHelper.isVaultEntryIconOptimized(icon)) {
+          oldIcons.set(e.getUUID(), icon);
+        }
+      }
+
+      if (oldIcons.size > 0) {
+        const task = new IconOptimizationTask(this.getUIContext(), (newIcons: Map<string, VaultEntryIcon>) => {
+          this.onIconsOptimized(newIcons);
+        });
+        task.execute(oldIcons);
+      } else {
+        this.onIconsOptimized(new Map<string, VaultEntryIcon>());
+      }
+    }
+  }
+
+  private onIconsOptimized(newIcons: Map<string, VaultEntryIcon>): void {
+    const vault = this._activity.getVaultManager().getVault();
+    newIcons.forEach((icon: VaultEntryIcon, uuid: string) => {
+      if (vault.hasEntryByUUID(uuid)) {
+        vault.getEntryByUUID(uuid).setIcon(icon);
+      }
+    });
+
+    vault.setIconsOptimized(true);
+    this.saveAndBackupVault();
+
+    if (newIcons.size > 0) {
+      this._entryListView.setEntries(vault.getEntries());
+    }
+  }
