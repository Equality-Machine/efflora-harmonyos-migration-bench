+    this._text = null;
+    // an empty element tag produces an END_TAG event right after the START_TAG event
+    if (this._pendingEndTag !== null) {
+      this._name = this._pendingEndTag;
+      this._pendingEndTag = null;
+      this._eventType = XmlPullParser.END_TAG;
+      return this._eventType;
+    }
+    let text = '';
+    let hasText = false;
+    while (this._pos < this._src.length) {
+      const c = this._src.charAt(this._pos);
+      if (c !== '<') {
+        const end = this._src.indexOf('<', this._pos);
+        const stop = end < 0 ? this._src.length : end;
+        text += XmlPullParser.decodeEntities(this._src.substring(this._pos, stop));
