diff --git a/entry/src/main/ets/icons/IconPack.ets b/entry/src/main/ets/icons/IconPack.ets
new file mode 100644
index 0000000..c24cff2
--- /dev/null
+++ b/entry/src/main/ets/icons/IconPack.ets
@@ -0,0 +1,186 @@
+import { IconType, IconTypeUtils } from './IconType';
+import { JSONObject, JSONException } from '../util/JSONObject';
+import { JsonUtils } from '../util/JsonUtils';
+import { UUID } from '../util/UUID';
+import { Bytes } from '../util/Bytes';
+
+enum MatchType {
+  NORMAL = 0,
+  INVERSE = 1
+}
+
+export class IconPackIcon {
+  private readonly _relFilename: string;
+  private readonly _name: string | null;
+  private readonly _category: string | null;
+  private readonly _issuers: string[];
+  private _file: string | null = null;
+
+  constructor(filename: string, name: string | null, category: string | null, issuers: string[]) {
+    this._relFilename = filename;
+    this._name = name;
+    this._category = category;
+    this._issuers = issuers;
+  }
+
+  getRelativeFilename(): string {
+    return this._relFilename;
+  }
+
+  getFile(): string | null {
+    return this._file;
+  }
+
+  setFile(file: string): void {
+    this._file = file;
+  }
+
+  getIconType(): IconType {
+    return IconTypeUtils.fromFilename(this._relFilename);
+  }
+
+  getName(): string {
+    if (this._name !== null) {
+      return this._name;
+    }
+    const slash = this._relFilename.lastIndexOf('/');
+    const base = slash >= 0 ? this._relFilename.substring(slash + 1) : this._relFilename;
+    const dot = base.lastIndexOf('.');
+    return dot >= 0 ? base.substring(0, dot) : base;
+  }
+
+  getCategory(): string | null {
+    return this._category;
+  }
+
+  getIssuers(): string[] {
+    return this._issuers;
+  }
+
+  getMatchFor(issuer: string): MatchType | null {
+    const lowerEntryIssuer = issuer.toLowerCase();
+    let inverseMatch = false;
+    for (const is of this._issuers) {
+      const lowerIconIssuer = is.toLowerCase();
+      if (lowerIconIssuer.indexOf(lowerEntryIssuer) >= 0) {
+        return MatchType.NORMAL;
+      }
+      if (lowerEntryIssuer.indexOf(lowerIconIssuer) >= 0) {
+        inverseMatch = true;
+      }
+    }
+    if (inverseMatch) {
+      return MatchType.INVERSE;
+    }
+    return null;
+  }
+
+  static fromJson(obj: JSONObject): IconPackIcon {
+    const filename = obj.getString('filename');
+    const name = JsonUtils.optString(obj, 'name');
+    const category = obj.isNull('category') ? null : obj.getString('category');
+    const array = obj.getJSONArray('issuer');
+    const issuers: string[] = [];
+    for (let i = 0; i < array.length(); i++) {
+      issuers.push(array.getString(i));
+    }
+    return new IconPackIcon(filename, name, category, issuers);
+  }
+}
+
+export class IconPack {
+  private _uuid: string;
+  private _name: string;
+  private _version: number;
+  private _icons: IconPackIcon[];
+  private _dir: string | null = null;
+
+  private constructor(uuid: string, name: string, version: number, icons: IconPackIcon[]) {
+    this._uuid = uuid;
+    this._name = name;
+    this._version = version;
+    this._icons = icons;
+  }
+
+  getUUID(): string {
+    return this._uuid;
+  }
+
+  getName(): string {
+    return this._name;
+  }
+
+  getVersion(): number {
+    return this._version;
+  }
+
+  getIcons(): IconPackIcon[] {
+    return this._icons.slice();
+  }
+
+  /**
+   * Retrieves a list of icons suggested for the given issuer.
+   */
+  getSuggestedIcons(issuer: string | null): IconPackIcon[] {
+    if (issuer === null || issuer.length === 0) {
+      return [];
+    }
+
+    const icons: IconPackIcon[] = [];
+    for (const icon of this._icons) {
+      const matchType = icon.getMatchFor(issuer);
+      if (matchType !== null) {
+        // Inverse matches (entry issuer contains icon name) are less likely
+        // to be good, so position them at the end of the list.
+        if (matchType === MatchType.NORMAL) {
+          icons.unshift(icon);
+        } else if (matchType === MatchType.INVERSE) {
+          icons.push(icon);
+        }
+      }
+    }
+    return icons;
+  }
+
+  getDirectory(): string | null {
+    return this._dir;
+  }
+
+  setDirectory(dir: string): void {
+    this._dir = dir;
+  }
+
+  /**
+   * Equality of UUID and version will make this method return true.
+   */
+  equals(o: Object | null): boolean {
+    if (!(o instanceof IconPack)) {
+      return false;
+    }
+    const pack = o as IconPack;
+    return this === pack || (this.getUUID() === pack.getUUID() && this.getVersion() === pack.getVersion());
+  }
+
+  static fromJson(obj: JSONObject): IconPack {
+    const uuidString = obj.getString('uuid');
+    if (!UUID.isValid(uuidString)) {
+      throw new JSONException(`Bad UUID format: ${uuidString}`);
+    }
+    const uuid = UUID.fromString(uuidString);
+    const name = obj.getString('name');
+    const version = obj.getInt('version');
+    const array = obj.getJSONArray('icons');
+
+    const icons: IconPackIcon[] = [];
+    for (let i = 0; i < array.length(); i++) {
+      icons.push(IconPackIcon.fromJson(array.getJSONObject(i)));
+    }
+
+    return new IconPack(uuid, name, version, icons);
+  }
+
+  static fromBytes(data: Uint8Array): IconPack {
+    const obj = new JSONObject(Bytes.toUtf8(data));
+    return IconPack.fromJson(obj);
+  }
+}
