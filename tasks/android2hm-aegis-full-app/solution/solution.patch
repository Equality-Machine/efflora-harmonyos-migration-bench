diff --git a/entry/src/main/ets/crypto/otp/YAOTP.ets b/entry/src/main/ets/crypto/otp/YAOTP.ets
new file mode 100644
index 0000000..7e2b63c
--- /dev/null
+++ b/entry/src/main/ets/crypto/otp/YAOTP.ets
@@ -0,0 +1,50 @@
+import { HOTP } from './HOTP';
+import { CryptoUtils } from '../CryptoUtils';
+import { Bytes } from '../../util/Bytes';
+
+const EN_ALPHABET_LENGTH: number = 26;
+
+export class YAOTP {
+  private readonly _code: bigint;
+  private readonly _digits: number;
+
+  private constructor(code: bigint, digits: number) {
+    this._code = code;
+    this._digits = digits;
+  }
+
+  static generateOTP(secret: Uint8Array, pin: string, digits: number, otpAlgo: string, period: number, seconds?: number): YAOTP {
+    const time = seconds !== undefined ? seconds : Math.floor(Date.now() / 1000);
+    const pinBytes = Bytes.fromUtf8(pin);
+    const pinWithHash = Bytes.concat([pinBytes, secret]);
+
+    let keyHash = CryptoUtils.digest('SHA256', pinWithHash);
+    if (keyHash[0] === 0) {
+      keyHash = Bytes.copyOfRange(keyHash, 1, keyHash.length);
+    }
+
+    const counter = Math.floor(time / period);
+    const periodHash = HOTP.getHash(keyHash, otpAlgo, counter);
+    const offset = periodHash[periodHash.length - 1] & 0xf;
+    periodHash[offset] &= 0x7f;
+    let otp = BigInt(0);
+    for (let i = 0; i < 8; i++) {
+      otp = (otp << BigInt(8)) | BigInt(periodHash[offset + i]);
+    }
+    return new YAOTP(otp, digits);
+  }
+
+  toString(): string {
+    let mod = BigInt(1);
+    for (let i = 0; i < this._digits; i++) {
+      mod = mod * BigInt(EN_ALPHABET_LENGTH);
+    }
+    let code = this._code % mod;
+    const chars: string[] = [];
+    for (let i = this._digits - 1; i >= 0; i--) {
+      chars[i] = String.fromCharCode('a'.charCodeAt(0) + Number(code % BigInt(EN_ALPHABET_LENGTH)));
+      code = code / BigInt(EN_ALPHABET_LENGTH);
+    }
+    return chars.join('');
+  }
+}
