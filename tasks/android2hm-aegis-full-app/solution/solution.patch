+import { common } from '@kit.AbilityKit';
+import { ResUtils } from '../util/ResUtils';
+
+/**
+ * Port of DropdownHelper. ArkUI dropdowns (Select / bindMenu) take a list of options instead of an
+ * adapter, so these helpers return the options to show.
+ */
+export class DropdownHelper {
+  private constructor() {
+  }
+
+  /**
+   * Returns the options of a dropdown that is filled with the string array resource with the given name.
+   */
+  static fillDropdown(context: common.Context, textArrayResName: string): SelectOption[] {
+    return DropdownHelper.fillDropdownWithItems(ResUtils.getStringArray(context, textArrayResName));
+  }
+
+  /**
+   * Returns the options of a dropdown that is filled with the string representation of the given items.
+   */
+  static fillDropdownWithItems<T>(items: T[]): SelectOption[] {
+    return items.map((item: T) => {
+      const option: SelectOption = { value: `${item}` };
+      return option;
+    });
+  }
+}
