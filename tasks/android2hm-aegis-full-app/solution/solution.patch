+}
+
+/**
+ * Port of androidx.preference.Preference: a single row in a preference screen. The model is
+ * rendered by PreferenceScreenView. Every change to the model triggers a re-render of the screen.
+ */
+export class Preference {
+  private static _counter: number = 0;
+
+  protected _key: string;
+  protected _title: ResourceStr;
+  protected _summary: ResourceStr;
+  protected _summaryColor: ResourceColor | null = null;
+  protected _summaryBold: boolean = false;
+  protected _icon: Resource | null;
+  protected _iconSpaceReserved: boolean;
+  protected _visible: boolean;
+  protected _enabled: boolean = true;
+  protected _selectable: boolean;
+  protected _persistent: boolean;
+  protected _dependency: string | null;
+  protected _fragment: string | null;
+  protected _parent: PreferenceCategory | null = null;
+  protected _screen: PreferenceScreen | null = null;
+  private _clickListener: OnPreferenceClickListener | null = null;
+  protected _changeListener: OnPreferenceChangeListener | null = null;
+
+  constructor(attrs: PreferenceAttrs) {
+    Preference._counter++;
+    this._key = attrs.key !== undefined ? attrs.key : `__pref_${Preference._counter}`;
+    this._title = attrs.title !== undefined ? attrs.title : '';
+    this._summary = attrs.summary !== undefined ? attrs.summary : '';
+    this._icon = attrs.icon !== undefined ? attrs.icon : null;
+    this._iconSpaceReserved = attrs.iconSpaceReserved !== undefined ? attrs.iconSpaceReserved : true;
+    this._visible = attrs.visible !== undefined ? attrs.visible : true;
+    this._selectable = attrs.selectable !== undefined ? attrs.selectable : true;
+    this._persistent = attrs.persistent !== undefined ? attrs.persistent : true;
+    this._dependency = attrs.dependency !== undefined ? attrs.dependency : null;
+    this._fragment = attrs.fragment !== undefined ? attrs.fragment : null;
+  }
+
+  getKey(): string {
+    return this._key;
+  }
+
+  getTitle(): ResourceStr {
+    return this._title;
+  }
+
+  setTitle(title: ResourceStr): void {
+    this._title = title;
+    this.notifyChanged();
+  }
+
+  getSummary(): ResourceStr {
+    return this._summary;
+  }
+
+  setSummary(summary: ResourceStr): void {
+    this._summary = summary;
+    this._summaryColor = null;
+    this._summaryBold = false;
+    this.notifyChanged();
+  }
+
+  /**
+   * Replacement for setting a Spannable summary with a ForegroundColorSpan and a bold StyleSpan.
+   */
+  setStyledSummary(summary: ResourceStr, color: ResourceColor | null, bold: boolean): void {
+    this._summary = summary;
+    this._summaryColor = color;
+    this._summaryBold = bold;
+    this.notifyChanged();
+  }
+
+  getSummaryColor(): ResourceColor | null {
+    return this._summaryColor;
+  }
+
+  isSummaryBold(): boolean {
+    return this._summaryBold;
+  }
+
+  getIcon(): Resource | null {
+    return this._icon;
+  }
+
+  setIcon(icon: Resource | null): void {
+    this._icon = icon;
+    this.notifyChanged();
+  }
+
+  isIconSpaceReserved(): boolean {
+    return this._iconSpaceReserved;
+  }
+
+  isVisible(): boolean {
+    return this._visible;
+  }
+
+  setVisible(visible: boolean): void {
+    if (this._visible !== visible) {
+      this._visible = visible;
+      this.notifyChanged();
+    }
+  }
+
+  /**
+   * Reports whether this preference is enabled, taking its dependency into account.
+   */
+  isEnabled(): boolean {
+    return this._enabled && !this.isDependencyDisabled();
+  }
+
+  setEnabled(enabled: boolean): void {
+    if (this._enabled !== enabled) {
+      this._enabled = enabled;
+      this.notifyChanged();
+    }
+  }
+
+  isSelectable(): boolean {
+    return this._selectable;
+  }
+
+  setSelectable(selectable: boolean): void {
+    if (this._selectable !== selectable) {
+      this._selectable = selectable;
+      this.notifyChanged();
+    }
+  }
+
+  isPersistent(): boolean {
+    return this._persistent;
+  }
+
+  getDependency(): string | null {
+    return this._dependency;
+  }
+
+  getFragment(): string | null {
+    return this._fragment;
+  }
+
+  getParent(): PreferenceCategory | null {
+    return this._parent;
+  }
+
+  setParent(parent: PreferenceCategory | null): void {
+    this._parent = parent;
+  }
+
+  attach(screen: PreferenceScreen): void {
+    this._screen = screen;
+    this.onAttached();
+  }
+
+  /**
+   * Called when the preference was added to a screen. Persistent preferences load their value here.
+   */
+  protected onAttached(): void {
+  }
+
+  getPreferenceScreen(): PreferenceScreen | null {
+    return this._screen;
+  }
+
+  setOnPreferenceClickListener(listener: OnPreferenceClickListener | null): void {
+    this._clickListener = listener;
+  }
+
+  getOnPreferenceClickListener(): OnPreferenceClickListener | null {
+    return this._clickListener;
+  }
+
+  setOnPreferenceChangeListener(listener: OnPreferenceChangeListener | null): void {
+    this._changeListener = listener;
+  }
+
+  getOnPreferenceChangeListener(): OnPreferenceChangeListener | null {
+    return this._changeListener;
+  }
+
+  /**
+   * Calls the change listener (if any) and reports whether the new value should be persisted.
+   */
+  callChangeListener(newValue: Object): boolean {
+    return this._changeListener === null || this._changeListener(this, newValue);
+  }
+
+  /**
+   * Whether dependents of this preference should be disabled.
+   */
+  shouldDisableDependents(): boolean {
+    return !this.isEnabled();
+  }
+
+  protected isDependencyDisabled(): boolean {
+    if (this._dependency === null || this._screen === null) {
+      return false;
+    }
+    const dep = this._screen.findPreference(this._dependency);
+    if (dep === null || dep === this) {
+      return false;
+    }
+    return dep.shouldDisableDependents();
+  }
+
+  protected onClick(): void {
+  }
+
+  /**
+   * Called when the user taps the row.
+   */
+  performClick(): void {
+    if (!this.isEnabled() || !this.isSelectable()) {
+      return;
+    }
+    this.onClick();
+    if (this._clickListener !== null && this._clickListener(this)) {
+      return;
+    }
+    if (this._fragment !== null && this._screen !== null) {
+      this._screen.onPreferenceStartFragment(this);
+    }
+  }
+
+  isSwitch(): boolean {
+    return false;
+  }
+
+  isChecked(): boolean {
+    return false;
+  }
+
+  isCategory(): boolean {
+    return false;
+  }
+
+  notifyChanged(): void {
+    if (this._screen !== null) {
+      this._screen.notifyChanged();
+    }
+  }
+}
+
+/**
+ * Port of androidx.preference.PreferenceCategory.
+ */
+export class PreferenceCategory extends Preference {
+  private _children: Preference[] = [];
+
+  constructor(attrs: PreferenceAttrs, children: Preference[]) {
+    super(attrs);
+    for (const child of children) {
+      this.addPreference(child);
+    }
+  }
+
+  addPreference(preference: Preference): void {
+    preference.setParent(this);
+    this._children.push(preference);
+  }
+
+  getPreferences(): Preference[] {
+    return this._children;
+  }
+
+  isCategory(): boolean {
+    return true;
+  }
+
+  isSelectable(): boolean {
+    return false;
+  }
+}
+
+/**
+ * Port of androidx.preference.TwoStatePreference/SwitchPreferenceCompat.
+ */
+export class SwitchPreferenceCompat extends Preference {
+  protected _checked: boolean;
+  private readonly _defaultValue: boolean;
+
+  constructor(attrs: PreferenceAttrs) {
+    super(attrs);
+    this._defaultValue = attrs.defaultValue !== undefined ? attrs.defaultValue : false;
+    this._checked = this._defaultValue;
+  }
+
+  protected onAttached(): void {
+    if (this._persistent && !this._key.startsWith('__pref_')) {
+      this._checked = AegisModule.getPreferences().getBoolean(this._key, this._defaultValue);
+    }
+  }
+
+  isSwitch(): boolean {
+    return true;
+  }
+
+  isChecked(): boolean {
+    return this._checked;
+  }
+
+  setChecked(checked: boolean): void {
+    const changed = this._checked !== checked;
+    this._checked = checked;
+    if (this._persistent && !this._key.startsWith('__pref_')) {
+      AegisModule.getPreferences().putBoolean(this._key, checked);
+    }
+    if (changed) {
+      this.notifyChanged();
+    }
+  }
+
+  shouldDisableDependents(): boolean {
+    return !this._checked || super.shouldDisableDependents();
+  }
+
+  protected onClick(): void {
+    const newValue = !this.isChecked();
+    if (this.callChangeListener(newValue)) {
+      this.setChecked(newValue);
+    }
+  }
+}
+
+/**
+ * Port of androidx.preference.PreferenceScreen: the root of a preference hierarchy.
+ */
+export class PreferenceScreen {
+  private _title: ResourceStr;
+  private _preferences: Preference[] = [];
+  private _listener: (() => void) | null = null;
+  private _startFragmentCallback: OnPreferenceStartFragmentCallback | null = null;
+  private _highlightKey: string | null = null;
+  private _scrollRequest: string | null = null;
+  private _version: number = 0;
+
+  constructor(title: ResourceStr, preferences: Preference[]) {
+    this._title = title;
+    for (const pref of preferences) {
+      this.addPreference(pref);
+    }
+  }
+
+  getTitle(): ResourceStr {
+    return this._title;
+  }
+
+  addPreference(preference: Preference): void {
+    this._preferences.push(preference);
+    preference.attach(this);
+    if (preference instanceof PreferenceCategory) {
+      for (const child of (preference as PreferenceCategory).getPreferences()) {
+        child.attach(this);
+      }
+    }
+  }
+
+  getAllPreferences(): Preference[] {
+    const all: Preference[] = [];
+    for (const pref of this._preferences) {
+      all.push(pref);
+      if (pref instanceof PreferenceCategory) {
+        for (const child of (pref as PreferenceCategory).getPreferences()) {
+          all.push(child);
+        }
+      }
+    }
+    return all;
+  }
+
+  findPreference(key: string): Preference | null {
+    for (const pref of this.getAllPreferences()) {
+      if (pref.getKey() === key) {
+        return pref;
+      }
+    }
+    return null;
+  }
+
+  /**
+   * Returns the flattened list of visible rows (category headers followed by their visible children).
+   */
+  getVisibleRows(): Preference[] {
+    const rows: Preference[] = [];
+    for (const pref of this._preferences) {
+      if (!pref.isVisible()) {
+        continue;
+      }
+      rows.push(pref);
+      if (pref instanceof PreferenceCategory) {
+        for (const child of (pref as PreferenceCategory).getPreferences()) {
+          if (child.isVisible()) {
+            rows.push(child);
+          }
+        }
+      }
+    }
+    return rows;
+  }
+
+  setOnChangedListener(listener: (() => void) | null): void {
+    this._listener = listener;
+  }
+
+  getVersion(): number {
+    return this._version;
+  }
+
+  notifyChanged(): void {
+    this._version++;
+    if (this._listener !== null) {
+      this._listener();
+    }
+  }
+
+  setOnPreferenceStartFragmentCallback(cb: OnPreferenceStartFragmentCallback | null): void {
+    this._startFragmentCallback = cb;
+  }
+
+  onPreferenceStartFragment(preference: Preference): boolean {
+    if (this._startFragmentCallback === null) {
+      return false;
+    }
+    return this._startFragmentCallback(preference);
+  }
+
+  /**
+   * Scrolls to (and briefly highlights) the preference with the given key.
+   */
+  scrollToPreference(key: string): void {
+    this._highlightKey = key;
+    this._scrollRequest = key;
+    this.notifyChanged();
+    setTimeout(() => {
+      if (this._highlightKey === key) {
+        this._highlightKey = null;
+        this.notifyChanged();
+      }
+    }, 1500);
+  }
+
+  getHighlightKey(): string | null {
+    return this._highlightKey;
+  }
+
+  consumeScrollRequest(): string | null {
+    const req = this._scrollRequest;
+    this._scrollRequest = null;
+    return req;
+  }
+}
diff --git a/entry/src/main/ets/ui/preferences/PreferenceDialogs.ets b/entry/src/main/ets/ui/preferences/PreferenceDialogs.ets
new file mode 100644
index 0000000..c92ebca
--- /dev/null
+++ b/entry/src/main/ets/ui/preferences/PreferenceDialogs.ets
@@ -0,0 +1,122 @@
+import { DialogHandle } from '../dialogs/DialogHandle';
+import { DialogTitle } from '../dialogs/DialogStyles';
+
+@Extend(Button)
+function prefDialogButton() {
+  .backgroundColor(Color.Transparent)
+  .fontColor($r('app.color.theme_primary'))
+  .fontSize(15)
+  .margin({ left: 8 })
+}
+
+export class MultiChoicePreferenceDialogParams {
+  title: ResourceStr = '';
+  items: string[] = [];
+  checkedItems: boolean[] = [];
+  requireOneChecked: boolean = false;
+  onResult: (checked: boolean[]) => void = (checked: boolean[]) => {
+  };
+  handle: DialogHandle = new DialogHandle();
+}
+
+/**
+ * Replacement for MaterialAlertDialogBuilder.setMultiChoiceItems() with an OK button that can be
+ * disabled while no item is checked (used for the search behavior and auto lock preferences).
+ */
+@Component
+struct MultiChoicePreferenceDialogView {
+  params: MultiChoicePreferenceDialogParams = new MultiChoicePreferenceDialogParams();
+  @State checkedItems: boolean[] = [];
+
+  aboutToAppear(): void {
+    this.checkedItems = this.params.checkedItems.slice();
+    while (this.checkedItems.length < this.params.items.length) {
+      this.checkedItems.push(false);
+    }
+  }
+
+  private toggle(index: number, value: boolean): void {
+    const copy = this.checkedItems.slice();
+    copy[index] = value;
+    this.checkedItems = copy;
+  }
+
+  private canConfirm(): boolean {
+    if (!this.params.requireOneChecked) {
+      return true;
+    }
+    return this.checkedItems.some((b: boolean) => b);
+  }
+
+  build() {
+    Column() {
+      DialogTitle(this.params.title)
+      List() {
+        ForEach(this.params.items, (item: string, index: number) => {
+          ListItem() {
+            Row() {
+              Checkbox()
+                .select(this.checkedItems[index])
+                .onChange((v: boolean) => this.toggle(index, v))
+              Text(item)
+                .fontSize(16)
+                .fontColor($r('app.color.theme_onSurface'))
+                .layoutWeight(1)
+                .margin({ left: 8 })
+            }
+            .width('100%')
+            .height(48)
+            .onClick(() => this.toggle(index, !this.checkedItems[index]))
+          }
+        }, (item: string, index: number) => `${index}-${item}`)
+      }
+      .constraintSize({ maxHeight: 360 })
+
+      Row() {
+        Blank()
+        Button($r('app.string.cancel'))
+          .prefDialogButton()
+          .onClick(() => {
+            this.params.handle.dismiss();
+          })
+        Button($r('app.string.ok'))
+          .prefDialogButton()
+          .enabled(this.canConfirm())
+          .opacity(this.canConfirm() ? 1 : 0.4)
+          .onClick(() => {
+            this.params.handle.dismiss();
+            this.params.onResult(this.checkedItems);
+          })
+      }
+      .width('100%')
+      .margin({ top: 16 })
+    }
+    .padding(24)
+    .width('90%')
+    .constraintSize({ maxWidth: 560 })
+    .borderRadius(28)
+    .backgroundColor($r('app.color.theme_surfaceContainerHigh'))
+  }
+}
+
+@Builder
+function buildMultiChoicePreferenceDialog(params: MultiChoicePreferenceDialogParams) {
+  MultiChoicePreferenceDialogView({ params: params })
+}
+
+export class PreferenceDialogs {
+  private constructor() {
+  }
+
+  static showMultiChoiceDialog(uiContext: UIContext, title: ResourceStr, items: string[], checkedItems: boolean[],
+    requireOneChecked: boolean, listener: (checked: boolean[]) => void): void {
+    const params = new MultiChoicePreferenceDialogParams();
+    params.title = title;
+    params.items = items;
+    params.checkedItems = checkedItems;
+    params.requireOneChecked = requireOneChecked;
+    params.onResult = listener;
+    DialogHandle.open<MultiChoicePreferenceDialogParams>(uiContext, wrapBuilder(buildMultiChoicePreferenceDialog), params,
+      params.handle, true);
+  }
+}
