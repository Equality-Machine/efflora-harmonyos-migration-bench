diff --git a/entry/src/main/ets/receivers/QsTileRefreshReceiver.ets b/entry/src/main/ets/receivers/QsTileRefreshReceiver.ets
new file mode 100644
index 0000000..4e3b292
--- /dev/null
+++ b/entry/src/main/ets/receivers/QsTileRefreshReceiver.ets
@@ -0,0 +1,50 @@
+import { formProvider, formBindingData } from '@kit.FormKit';
+import { preferences } from '@kit.ArkData';
+import { common } from '@kit.AbilityKit';
+
+class FormData {
+  refreshed: number = Date.now();
+}
+
+/**
+ * Port of QsTileRefreshReceiver. On HarmonyOS the quick settings tiles are replaced by service
+ * widgets (see widget/AegisFormAbility). This class keeps track of the added widgets and refreshes
+ * them, e.g. after the device has booted.
+ */
+export class QsTileRefreshReceiver {
+  private static readonly PREFS: string = 'aegis_forms';
+  private static readonly KEY: string = 'form_ids';
+
+  static addForm(context: common.Context, formId: string): void {
+    const ids = QsTileRefreshReceiver.getFormIds(context);
+    if (ids.indexOf(formId) < 0) {
+      ids.push(formId);
+    }
+    QsTileRefreshReceiver.saveFormIds(context, ids);
+  }
+
+  static removeForm(context: common.Context, formId: string): void {
+    QsTileRefreshReceiver.saveFormIds(context, QsTileRefreshReceiver.getFormIds(context).filter((id: string) => id !== formId));
+  }
+
+  static getFormIds(context: common.Context): string[] {
+    const prefs = preferences.getPreferencesSync(context, { name: QsTileRefreshReceiver.PREFS });
+    const raw = prefs.getSync(QsTileRefreshReceiver.KEY, '') as string;
+    return raw.length === 0 ? [] : raw.split(',');
+  }
+
+  private static saveFormIds(context: common.Context, ids: string[]): void {
+    const prefs = preferences.getPreferencesSync(context, { name: QsTileRefreshReceiver.PREFS });
+    prefs.putSync(QsTileRefreshReceiver.KEY, ids.join(','));
+    prefs.flush().catch(() => {
+    });
+  }
+
+  static onReceive(context: common.Context): void {
+    for (const id of QsTileRefreshReceiver.getFormIds(context)) {
+      const data = formBindingData.createFormBindingData(new FormData());
+      formProvider.updateForm(id, data).catch(() => {
+      });
+    }
+  }
+}
