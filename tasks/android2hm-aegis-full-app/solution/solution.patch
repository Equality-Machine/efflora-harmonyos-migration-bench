@@ -0,0 +1,51 @@
+import { abilityAccessCtrl, bundleManager, common, Permissions } from '@kit.AbilityKit';
+
+/**
+ * Port of PermissionHelper on top of the ability access control framework.
+ */
+export class PermissionHelper {
+  private constructor() {
+  }
+
+  static granted(context: common.Context, permission: Permissions): boolean {
+    try {
+      const atManager = abilityAccessCtrl.createAtManager();
+      const info = bundleManager.getBundleInfoForSelfSync(bundleManager.BundleFlag.GET_BUNDLE_INFO_WITH_APPLICATION);
+      const status = atManager.checkAccessTokenSync(info.appInfo.accessTokenId, permission);
+      return status === abilityAccessCtrl.GrantStatus.PERMISSION_GRANTED;
+    } catch (e) {
+      return false;
+    }
+  }
+
+  /**
+   * Requests the given permissions from the user. Resolves to true if all of them were granted.
+   */
+  static async request(context: common.UIAbilityContext, permissions: Permissions[]): Promise<boolean> {
+    let allGranted = true;
+    for (const p of permissions) {
+      if (!PermissionHelper.granted(context, p)) {
+        allGranted = false;
+      }
+    }
+    if (allGranted) {
+      return true;
+    }
+    try {
+      const atManager = abilityAccessCtrl.createAtManager();
+      const result = await atManager.requestPermissionsFromUser(context, permissions);
+      return PermissionHelper.checkResults(result.authResults);
+    } catch (e) {
+      return false;
+    }
+  }
+
+  static checkResults(grantResults: number[]): boolean {
+    for (const result of grantResults) {
+      if (result !== abilityAccessCtrl.GrantStatus.PERMISSION_GRANTED) {
+        return false;
+      }
+    }
+    return grantResults.length > 0;
+  }
+}
diff --git a/entry/src/main/ets/helpers/QrCodeAnalyzer.ets b/entry/src/main/ets/helpers/QrCodeAnalyzer.ets
new file mode 100644
index 0000000..5f009ec
--- /dev/null
+++ b/entry/src/main/ets/helpers/QrCodeAnalyzer.ets
@@ -0,0 +1,107 @@
+import { customScan, scanBarcode, scanCore } from '@kit.ScanKit';
+import { BusinessError } from '@kit.BasicServicesKit';
+import { hilog } from '@kit.PerformanceAnalysisKit';
+
+export interface QrCodeAnalyzerListener {
+  onQrCodeDetected(result: string): void;
+}
+
+/**
+ * Port of QrCodeAnalyzer: analyzes the camera preview (through the Scan Kit custom scanner) and
+ * reports detected QR codes to the listener.
+ */
+export class QrCodeAnalyzer {
+  static readonly RESOLUTION_WIDTH: number = 1200;
+  static readonly RESOLUTION_HEIGHT: number = 1600;
+
+  private _listener: QrCodeAnalyzerListener;
+  private _running: boolean = false;
+  private _initialized: boolean = false;
+
+  constructor(listener: QrCodeAnalyzerListener) {
+    this._listener = listener;
+  }
+
+  start(surfaceId: string, width: number, height: number): void {
+    if (this._running) {
+      return;
+    }
+    if (!this._initialized) {
+      const options: scanBarcode.ScanOptions = {
+        scanTypes: [scanCore.ScanType.QR_CODE],
+        enableMultiMode: false,
+        enableAlbum: false
+      };
+      customScan.init(options);
+      this._initialized = true;
+    }
+    const viewControl: customScan.ViewControl = { width: width, height: height, surfaceId: surfaceId };
+    this._running = true;
+    customScan.start(viewControl, (err: BusinessError, results: Array<scanBarcode.ScanResult>) => {
+      if (!this._running) {
+        return;
+      }
+      if (err !== null && err !== undefined && err.code !== undefined && err.code !== 0) {
+        hilog.warn(0x0000, 'QrCodeAnalyzer', 'Scan error: %{public}s', JSON.stringify(err));
+        this.rescan();
+        return;
+      }
+      if (results !== undefined && results.length > 0) {
+        this._listener.onQrCodeDetected(results[0].originalValue);
+      } else {
+        this.rescan();
+      }
+    });
+  }
+
+  rescan(): void {
+    if (this._running) {
+      try {
+        customScan.rescan();
+      } catch (e) {
+        // ignore
+      }
+    }
+  }
+
+  setTorch(on: boolean): void {
+    try {
+      if (on) {
+        customScan.openFlashLight();
+      } else {
+        customScan.closeFlashLight();
+      }
+    } catch (e) {
+      // ignore
+    }
+  }
+
+  isTorchOn(): boolean {
+    try {
+      return customScan.getFlashLightStatus();
+    } catch (e) {
+      return false;
+    }
+  }
+
+  async stop(): Promise<void> {
+    this._running = false;
+    try {
+      await customScan.stop();
+    } catch (e) {
+      // ignore
+    }
+  }
+
+  async release(): Promise<void> {
+    await this.stop();
+    if (this._initialized) {
+      this._initialized = false;
+      try {
+        await customScan.release();
+      } catch (e) {
+        // ignore
+      }
+    }
+  }
+}
diff --git a/entry/src/main/ets/helpers/QrCodeHelper.ets b/entry/src/main/ets/helpers/QrCodeHelper.ets
new file mode 100644
index 0000000..09a6df4
--- /dev/null
+++ b/entry/src/main/ets/helpers/QrCodeHelper.ets
@@ -0,0 +1,55 @@
+import { generateBarcode, scanCore, detectBarcode, scanBarcode } from '@kit.ScanKit';
+import { image } from '@kit.ImageKit';
+import { Base64 } from '../encoding/Base64';
+
+/**
+ * Replacement for the ZXing based QrCodeHelper, on top of the HarmonyOS Scan Kit.
+ */
+export class QrCodeHelper {
+  private constructor() {
+  }
+
+  static async encodeToBitmap(data: string, width: number, height: number, backgroundColor: number): Promise<image.PixelMap> {
+    const options: generateBarcode.CreateOptions = {
+      scanType: scanCore.ScanType.QR_CODE,
+      width: width,
+      height: height,
+      backgroundColor: backgroundColor,
+      pixelMapColor: 0xFF000000,
+      margin: 1,
+      level: generateBarcode.ErrorCorrectionLevel.LEVEL_L
+    };
+    return generateBarcode.createBarcode(data, options);
+  }
+
+  static async encodeToPng(data: string, width: number, height: number): Promise<Uint8Array> {
+    const pixelMap = await QrCodeHelper.encodeToBitmap(data, width, height, 0xFFFFFFFF);
+    const packer = image.createImagePacker();
+    try {
+      const packOpts: image.PackingOption = { format: 'image/png', quality: 100 };
+      const buf = await packer.packToData(pixelMap, packOpts);
+      return new Uint8Array(buf);
+    } finally {
+      packer.release();
+      pixelMap.release();
+    }
+  }
+
+  static async encodeToBase64Png(data: string, width: number, height: number): Promise<string> {
+    return Base64.encode(await QrCodeHelper.encodeToPng(data, width, height));
+  }
+
+  /**
+   * Decodes all QR codes in the image at the given URI.
+   */
+  static async decodeFromUri(uri: string): Promise<string[]> {
+    const input: detectBarcode.InputImage = { uri: uri };
+    const options: scanBarcode.ScanOptions = {
+      scanTypes: [scanCore.ScanType.QR_CODE],
+      enableMultiMode: true,
+      enableAlbum: false
+    };
+    const results = await detectBarcode.decode(input, options);
+    return results.map((r: scanBarcode.ScanResult) => r.originalValue);
+  }
+}
diff --git a/entry/src/main/ets/helpers/SafHelper.ets b/entry/src/main/ets/helpers/SafHelper.ets
new file mode 100644
index 0000000..ccecef3
--- /dev/null
+++ b/entry/src/main/ets/helpers/SafHelper.ets
@@ -0,0 +1,107 @@
+import { picker } from '@kit.CoreFileKit';
+import { uniformTypeDescriptor } from '@kit.ArkData';
+import { AegisModule } from '../AegisModule';
+import { Uri } from '../util/Uri';
+
+/**
+ * Port of SafHelper. On HarmonyOS the Storage Access Framework is replaced by the
+ * DocumentViewPicker, so this class also contains the picker helpers (replacement for
+ * ACTION_GET_CONTENT, ACTION_OPEN_DOCUMENT_TREE and ACTION_CREATE_DOCUMENT).
+ */
+export class SafHelper {
+  private constructor() {
+  }
+
+  /**
+   * Returns the display name of the file at the given URI.
+   */
+  static getFileName(uri: string): string {
+    let path = uri;
+    const queryIndex = path.indexOf('?');
+    if (queryIndex >= 0) {
+      path = path.substring(0, queryIndex);
+    }
+    while (path.endsWith('/')) {
+      path = path.substring(0, path.length - 1);
+    }
+    const idx = path.lastIndexOf('/');
+    return Uri.decode(idx >= 0 ? path.substring(idx + 1) : path);
+  }
+
+  /**
+   * Returns the MIME type of the file at the given URI, based on its file extension.
+   */
+  static getMimeType(uri: string): string | null {
+    const name = SafHelper.getFileName(uri);
+    const idx = name.lastIndexOf('.');
+    if (idx < 0) {
+      return null;
+    }
+    try {
+      const typeId = uniformTypeDescriptor.getUniformDataTypeByFilenameExtension(name.substring(idx).toLowerCase());
+      const type = uniformTypeDescriptor.getTypeDescriptor(typeId);
+      if (type !== null && type.mimeTypes.length > 0) {
+        return type.mimeTypes[0];
+      }
+    } catch (e) {
+      // unknown type
+    }
+    return null;
+  }
+
+  /**
+   * Returns the uniform data type of the file at the given URI (used for sharing).
+   */
+  static getUniformDataType(uri: string): string {
+    const name = SafHelper.getFileName(uri);
+    const idx = name.lastIndexOf('.');
+    if (idx >= 0) {
+      try {
+        return uniformTypeDescriptor.getUniformDataTypeByFilenameExtension(name.substring(idx).toLowerCase());
+      } catch (e) {
+        // fall through
+      }
+    }
+    return uniformTypeDescriptor.UniformDataType.FILE;
+  }
+
+  private static createPicker(): picker.DocumentViewPicker {
+    return new picker.DocumentViewPicker(AegisModule.getAbilityContext());
+  }
+
+  /**
+   * Lets the user pick a single file (replacement for ACTION_GET_CONTENT). Resolves to null if canceled.
+   * @param suffixFilters optional file suffix filters, e.g. ['.zip']
+   */
+  static async selectFile(suffixFilters?: string[]): Promise<string | null> {
+    const options = new picker.DocumentSelectOptions();
+    options.maxSelectNumber = 1;
+    options.selectMode = picker.DocumentSelectMode.FILE;
+    if (suffixFilters !== undefined && suffixFilters.length > 0) {
+      options.fileSuffixFilters = suffixFilters;
+    }
+    const uris = await SafHelper.createPicker().select(options);
+    return uris !== undefined && uris !== null && uris.length > 0 ? uris[0] : null;
+  }
+
+  /**
+   * Lets the user pick a directory (replacement for ACTION_OPEN_DOCUMENT_TREE). Resolves to null if canceled.
+   */
+  static async selectFolder(): Promise<string | null> {
+    const options = new picker.DocumentSelectOptions();
+    options.maxSelectNumber = 1;
+    options.selectMode = picker.DocumentSelectMode.FOLDER;
+    const uris = await SafHelper.createPicker().select(options);
+    return uris !== undefined && uris !== null && uris.length > 0 ? uris[0] : null;
+  }
+
+  /**
+   * Lets the user create a new document (replacement for ACTION_CREATE_DOCUMENT). Resolves to null if canceled.
+   */
+  static async createDocument(fileName: string): Promise<string | null> {
+    const options = new picker.DocumentSaveOptions();
+    options.newFileNames = [fileName];
+    const uris = await SafHelper.createPicker().save(options);
+    return uris !== undefined && uris !== null && uris.length > 0 ? uris[0] : null;
+  }
+}
