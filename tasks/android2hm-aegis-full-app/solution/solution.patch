@@ -0,0 +1,57 @@
+import { TotpInfo } from '../../otp/TotpInfo';
+
+/**
+ * Port of TotpProgressBar: a horizontal progress bar that shows the time remaining until the codes
+ * of the given period rotate.
+ */
+@Component
+export struct TotpProgressBar {
+  @Prop @Watch('restart') period: number = TotpInfo.DEFAULT_PERIOD;
+  @Prop barHeight: number = 4;
+  @State progress: number = 1000;
+  private _timer: number = -1;
+
+  aboutToAppear(): void {
+    this.start();
+  }
+
+  aboutToDisappear(): void {
+    this.stop();
+  }
+
+  start(): void {
+    this.stop();
+    this.refresh();
+    this._timer = setInterval(() => this.refresh(), 100);
+  }
+
+  stop(): void {
+    if (this._timer >= 0) {
+      clearInterval(this._timer);
+      this._timer = -1;
+    }
+  }
+
+  restart(): void {
+    this.stop();
+    this.start();
+  }
+
+  private refresh(): void {
+    // calculate the current progress the bar should be at
+    if (this.period <= 0) {
+      return;
+    }
+    const millisTillRotation = TotpInfo.getMillisTillNextRotation(this.period);
+    this.progress = Math.floor(1000 * (millisTillRotation / (this.period * 1000)));
+  }
+
+  build() {
+    Progress({ value: this.progress, total: 1000, type: ProgressType.Linear })
+      .width('100%')
+      .height(this.barHeight)
+      .color($r('app.color.theme_primary'))
+      .style({ strokeWidth: this.barHeight, enableSmoothEffect: true })
+      .id('progressBar')
+  }
+}
