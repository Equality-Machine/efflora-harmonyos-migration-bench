+
+  aboutToDisappear(): void {
+    if (this._activity !== null) {
+      this._activity.onDestroy();
+    }
+  }
+
+  private requireActivity(): AegisActivity {
+    return this._activity as AegisActivity;
+  }
+
+  private requireContext(): UIContext {
+    return this.getUIContext();
+  }
+
+  onCreatePreferences(): void {
+    const fragment = this._fragment as PreferencesFragment;
+    fragment.addPreferencesFromResource(PreferenceResources.preferences_import_export());
+
+    const importPreference = fragment.requirePreference<Preference>('pref_import');
+    importPreference.setOnPreferenceClickListener((preference: Preference) => {
+      Dialogs.showImportersDialog(this.requireContext(), false, (definition: DatabaseImporterDefinition) => {
+        this._importerDef = definition;
+
+        this._vaultManager.fireIntentLauncher<string | null>(() => SafHelper.selectFile())
+          .then((uri: string | null) => this.onImportSelectResult(uri))
+          .catch((e: Error) => {
+            hilog.error(0x0000, TAG, 'Unable to pick a file: %{public}s', e.message);
+          });
+      });
+      return true;
+    });
+
+    const importAppPreference = fragment.requirePreference<Preference>('pref_import_app');
+    importAppPreference.setOnPreferenceClickListener((preference: Preference) => {
+      Dialogs.showImportersDialog(this.requireContext(), true, (definition: DatabaseImporterDefinition) => {
+        this.startImportEntriesActivity(definition, null);
+      });
+      return true;
+    });
+
+    const exportPreference = fragment.requirePreference<Preference>('pref_export');
+    exportPreference.setOnPreferenceClickListener((preference: Preference) => {
+      this.startExport();
+      return true;
+    });
+
+    const googleAuthStyleExportPreference = fragment.requirePreference<Preference>('pref_google_auth_style_export');
+    googleAuthStyleExportPreference.setOnPreferenceClickListener((preference: Preference) => {
+      this.startGoogleAuthenticatorStyleExport();
+      return true;
+    });
+  }
+
+  private onImportSelectResult(uri: string | null): void {
+    if (uri === null) {
+      return;
+    }
+
+    const params = new ImportFileTaskParams(uri, 'import', null);
+    const task = new ImportFileTask(this.requireContext(), (result: ImportFileTaskResult) => {
+      const error = result.getError();
+      if (error === null && this._importerDef !== null) {
+        this.startImportEntriesActivity(this._importerDef, result.getFile());
+      } else {
+        Dialogs.showErrorDialog(this.requireContext(), $r('app.string.reading_file_error'),
+          error !== null ? error : 'No importer selected');
+      }
+    });
+    task.execute(params);
+  }
+
+  private startImportEntriesActivity(importerDef: DatabaseImporterDefinition, file: string | null): void {
+    if (file === null) {
+      // direct import requires root access to the internal storage of other apps,
+      // which is not available on HarmonyOS
+      Dialogs.showErrorDialog(this.requireContext(), $r('app.string.root_error'),
+        getString('root_access_unavailable', [importerDef.getName()]));
+      return;
+    }
+
+    const intent = new Intent(PAGE_IMPORT_ENTRIES);
+    intent.putExtra('importerDef', importerDef);
+    intent.putExtra('file', file);
+    ActivityManager.startActivityForResult(this.requireContext(), intent, (result: ActivityResult) => {
+      if (result.resultCode === RESULT_OK) {
+        // the vault has changed: make sure the main list reloads its entries
+        this.requireActivity().setResult(RESULT_OK,
+          new Intent(PAGE_PREFS_IMPORT_EXPORT).putExtra('needsRecreate', true));
+      }
+    });
+  }
+
+  private startExport(): void {
+    const isBackupPasswordSet = this._vaultManager.getVault().isBackupPasswordSet();
+    const params = new ExportDialogParams();
+    params.isBackupPasswordSet = isBackupPasswordSet;
+    params.formats = ResUtils.getStringArray(AegisModule.getContext(), 'export_formats');
+
+    const groups: VaultGroup[] = this._vaultManager.getVault().getUsedGroups();
+    const groupsSelection = new DropdownCheckBoxesController(false);
+    if (groups.length > 0) {
+      params.hasGroups = true;
+
+      const groupsArray: Object[] = [];
+      groupsArray.push(VaultGroupModel.fromPlaceholder(GroupPlaceholderType.NO_GROUP));
+      for (const group of groups) {
+        groupsArray.push(VaultGroupModel.fromGroup(group));
+      }
+
+      groupsSelection.setCheckedItemsCountTextRes('export_groups_selected_count');
+      groupsSelection.addItems(groupsArray, false);
+    }
+    params.groupsSelection = groupsSelection;
+
+    params.onOk = (res: ExportDialogResult) => {
+      if (!res.encrypt && !res.accept) {
+        return;
+      }
+
+      if (!res.exportAllGroups) {
+        this._exportFilter = this.getVaultEntryFilter(groupsSelection);
+        if (this._exportFilter === null) {
+          this.requireActivity().showToast($r('app.string.export_no_groups_selected'));
+          return;
+        }
+      }
+
+      const pos = res.formatIndex;
+      const encrypt = res.encrypt;
+      const fileInfo = ImportExportPreferencesFragment.getExportFileInfo(pos, encrypt);
+      const requestCode = ImportExportPreferencesFragment.getExportRequestCode(pos, encrypt);
+
+      this._auditLogRepository.addVaultExportedEvent();
+      this._vaultManager.fireIntentLauncher<string | null>(() => SafHelper.createDocument(fileInfo.toString()))
+        .then((uri: string | null) => this.onExportResult(requestCode, uri))
+        .catch((e: Error) => {
+          hilog.error(0x0000, TAG, 'Unable to pick an export location: %{public}s', e.message);
+        });
+    };
+
+    params.onShare = (res: ExportDialogResult) => {
+      const pos = res.formatIndex;
+      if (!res.encrypt && !res.accept) {
+        return;
+      }
+
+      if (!res.exportAllGroups) {
+        this._exportFilter = this.getVaultEntryFilter(groupsSelection);
+        if (this._exportFilter === null) {
+          return;
+        }
+      }
+
+      let file: string;
+      const encrypt = res.encrypt;
+      try {
+        const fileInfo = ImportExportPreferencesFragment.getExportFileInfo(pos, encrypt);
+        file = `${this.getExportCacheDir()}/${fileInfo.toString()}`;
+      } catch (e) {
+        Dialogs.showErrorDialog(this.requireContext(), $r('app.string.exporting_vault_error'), e as Error);
+        return;
+      }
+
+      const requestCode = ImportExportPreferencesFragment.getExportRequestCode(pos, encrypt);
+      this.startExportVault(requestCode, (cb: FinishExportCallback) => {
+        cb().then((data: Uint8Array) => {
+          IOUtils.writeFile(file, data);
+
+          // if the user creates an export, hide the backup reminder
+          this._prefs.setLatestExportTimeNow();
+          this._auditLogRepository.addVaultExportedEvent();
+          this.shareFile(file);
+        }).catch((e: Error) => {
+          Dialogs.showErrorDialog(this.requireContext(), $r('app.string.exporting_vault_error'), e);
+        });
+      }, this._exportFilter);
+      this._exportFilter = null;
+    };
+
+    DialogHandle.open<ExportDialogParams>(this.requireContext(), wrapBuilder(buildExportDialog), params, params.handle,
+      true);
+  }
+
+  /**
+   * Replacement for the ACTION_SEND chooser: shares the exported file through the system share sheet.
+   */
+  private shareFile(file: string): void {
+    const record: systemShare.SharedRecord = {
+      utd: SafHelper.getUniformDataType(file),
+      uri: fileUri.getUriFromPath(file)
+    };
+    const data = new systemShare.SharedData(record);
+    const controller = new systemShare.ShareController(data);
+    const options: systemShare.ShareControllerOptions = {
+      previewMode: systemShare.SharePreviewMode.DETAIL,
+      selectionMode: systemShare.SelectionMode.SINGLE
+    };
+    this._vaultManager.fireIntentLauncher<void>(() => controller.show(AegisModule.getAbilityContext(), options))
+      .catch((e: Error) => {
+        Dialogs.showErrorDialog(this.requireContext(), $r('app.string.exporting_vault_error'), e);
+      });
+  }
+
+  private getVaultEntryFilter(dropdownCheckBoxes: DropdownCheckBoxesController): EntryFilter | null {
+    const groups = new Set<string | null>();
+    for (const item of Array.from(dropdownCheckBoxes.getCheckedItems())) {
+      groups.add((item as VaultGroupModel).getUUID());
+    }
+
+    return groups.size === 0 ? null : new GroupsEntryFilter(groups);
+  }
+
+  private startGoogleAuthenticatorStyleExport(): void {
+    const toExport: GoogleAuthInfo[] = [];
+    const entries = this._vaultManager.getVault().getEntries();
+    for (const entry of entries) {
+      const type = entry.getInfo().getType().toLowerCase();
+      const algo = entry.getInfo().getAlgorithm(false);
+      const digits = entry.getInfo().getDigits();
+
+      if ((type === TotpInfo.ID || type === HotpInfo.ID)
+        && digits === OtpInfo.DEFAULT_DIGITS
+        && algo === OtpInfo.DEFAULT_ALGORITHM) {
+        const info = new GoogleAuthInfo(entry.getInfo(), entry.getName(), entry.getIssuer());
+        toExport.push(info);
+      }
+    }
+
+    const entriesSkipped = entries.length - toExport.length;
+    if (entriesSkipped > 0) {
+      const text = ResUtils.getQuantityString(AegisModule.getContext(), 'pref_google_auth_export_incompatible_entries',
+        entriesSkipped, [entriesSkipped]);
+      this.requireActivity().showToast(text);
+    }
+
+    const qrSize = 10;
+    const batchId = Math.floor(Math.random() * 0x100000000) - 0x80000000;
+    const batchSize = Math.floor(toExport.length / qrSize) + (toExport.length % qrSize === 0 ? 0 : 1);
+    let infos: GoogleAuthInfo[] = [];
+    const exports: Transferable[] = [];
+    let batchIndex = 0;
+    for (let i = 0; i < toExport.length; i++) {
+      infos.push(toExport[i]);
+      if (infos.length === qrSize || toExport.length === i + 1) {
+        exports.push(new GoogleAuthInfoExport(infos, batchId, batchIndex++, batchSize));
+        infos = [];
+      }
+    }
+
+    if (exports.length === 0) {
+      this.requireActivity().showToast($r('app.string.pref_google_auth_export_no_data'));
+    } else {
+      const intent = new Intent(PAGE_TRANSFER_ENTRIES);
+      intent.putExtra('authInfos', exports);
+      this.requireActivity().startActivity(intent);
+    }
+  }
+
+  private static getExportRequestCode(spinnerPos: number, encrypt: boolean): number {
+    if (spinnerPos === 0) {
+      return encrypt ? PreferencesFragment.CODE_EXPORT : PreferencesFragment.CODE_EXPORT_PLAIN;
+    } else if (spinnerPos === 1) {
+      return PreferencesFragment.CODE_EXPORT_HTML;
+    }
+
+    return PreferencesFragment.CODE_EXPORT_GOOGLE_URI;
+  }
+
+  private static getExportFileInfo(spinnerPos: number, encrypt: boolean): FileInfo {
+    if (spinnerPos === 0) {
+      const filename = encrypt ? VaultRepository.FILENAME_PREFIX_EXPORT : VaultRepository.FILENAME_PREFIX_EXPORT_PLAIN;
+      return new FileInfo(filename);
+    } else if (spinnerPos === 1) {
+      return new FileInfo(VaultRepository.FILENAME_PREFIX_EXPORT_HTML, 'html');
+    }
+
+    return new FileInfo(VaultRepository.FILENAME_PREFIX_EXPORT_URI, 'txt');
+  }
+
+  private static getExportMimeType(requestCode: number): string {
+    if (requestCode === PreferencesFragment.CODE_EXPORT_GOOGLE_URI) {
+      return 'text/plain';
+    } else if (requestCode === PreferencesFragment.CODE_EXPORT_HTML) {
+      return 'text/html';
+    }
+    return 'application/json';
+  }
+
+  private getExportCacheDir(): string {
+    const dir = `${AegisModule.getContext().cacheDir}/export`;
+    try {
+      IOUtils.mkdirs(dir);
+    } catch (e) {
+      throw new Error(`Unable to create directory ${dir}`);
+    }
+
+    return dir;
+  }
+
+  private startExportVault(requestCode: number, cb: StartExportCallback, filter: EntryFilter | null): void {
+    const vault = this._vaultManager.getVault();
+    switch (requestCode) {
+      case PreferencesFragment.CODE_EXPORT:
+        if (vault.isEncryptionEnabled()) {
+          cb(async () => vault.exportFiltered(vault.getCredentials(), filter));
+        } else {
+          const listener = new ExportPasswordSlotListener(this.requireContext(), (creds: VaultFileCredentials) => {
+            cb(async () => vault.exportFiltered(creds, filter));
+          });
+          Dialogs.showSetPasswordDialog(this.requireContext(), listener);
+        }
+        break;
+      case PreferencesFragment.CODE_EXPORT_PLAIN:
+        cb(async () => vault.exportFiltered(null, filter));
+
+        this._prefs.setIsPlaintextBackupWarningNeeded(true);
+        break;
+      case PreferencesFragment.CODE_EXPORT_GOOGLE_URI:
+        cb(async () => vault.exportGoogleUris(filter));
+        this._prefs.setIsPlaintextBackupWarningNeeded(true);
+        break;
+      case PreferencesFragment.CODE_EXPORT_HTML:
+        cb(() => vault.exportHtml(filter));
+        this._prefs.setIsPlaintextBackupWarningNeeded(true);
+        break;
+      default:
+        break;
+    }
+  }
+
+  private onExportResult(requestCode: number, uri: string | null): void {
+    if (uri === null) {
+      return;
+    }
+
+    hilog.info(0x0000, TAG, 'Exporting as %{public}s', ImportExportPreferencesFragment.getExportMimeType(requestCode));
+    this.startExportVault(requestCode, (cb: FinishExportCallback) => {
+      let file: string;
+      try {
+        file = ImportFileTask.createTempFile(`${VaultRepository.FILENAME_PREFIX_EXPORT}-`, '.json',
+          this.getExportCacheDir());
+      } catch (e) {
+        Dialogs.showErrorDialog(this.requireContext(), $r('app.string.exporting_vault_error'), e as Error);
+        return;
+      }
+
+      cb().then((data: Uint8Array) => {
+        IOUtils.writeFile(file, data);
+        const listener = new ExportResultListener(this.requireActivity());
+        new ExportTask(this.requireContext(), (e: Error | null) => listener.onTaskFinished(e))
+          .execute(new ExportTaskParams(file, uri));
+      }).catch((e: Error) => {
+        Dialogs.showErrorDialog(this.requireContext(), $r('app.string.exporting_vault_error'), e);
+      });
+    }, this._exportFilter);
+    this._exportFilter = null;
+  }
+
+  private getScreen(): PreferenceScreen {
+    return (this._fragment as PreferencesFragment).getPreferenceScreen();
+  }
+
+  build() {
+    Column() {
+      Toolbar({
+        title: $r('app.string.pref_section_import_export_title'),
+        backgroundColorValue: ThemeHelper.isAmoled() ? '#000000' : $r('app.color.theme_surface'),
+        onBack: () => {
+          if (this._activity !== null) {
+            this._activity.finish();
+          }
+        }
+      })
+      if (this._fragment !== null) {
+        PreferenceScreenView({ screenProvider: () => this.getScreen(), tick: this.tick })
+      }
+    }
+    .width('100%')
+    .height('100%')
+    .backgroundColor(ThemeHelper.getBackgroundColor())
+  }
+}
diff --git a/entry/src/main/ets/ui/fragments/preferences/MainPreferencesFragment.ets b/entry/src/main/ets/ui/fragments/preferences/MainPreferencesFragment.ets
