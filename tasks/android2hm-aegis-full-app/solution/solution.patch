+import { IconAdapterCategoryHeader } from './IconAdapter';
+
+/**
+ * Port of IconCategoryHolder (layout card_icon_category): a collapsible category header.
+ */
+@Component
+export struct IconCategoryHolder {
+  header: IconAdapterCategoryHeader | null = null;
+  onCategoryClick: (header: IconAdapterCategoryHeader) => void = (header: IconAdapterCategoryHeader) => {
+  };
+  @State private _category: string = '';
+  @State private _rotation: number = 0;
+
+  aboutToAppear(): void {
+    if (this.header !== null) {
+      this.setData(this.header);
+    }
+  }
+
+  setData(header: IconAdapterCategoryHeader): void {
+    this._category = header.getCategory();
+    this._rotation = IconCategoryHolder.getRotation(header.isCollapsed());
+  }
+
+  setIsCollapsed(collapsed: boolean): void {
+    this.getUIContext().animateTo({ duration: 200 }, () => {
+      this._rotation = IconCategoryHolder.getRotation(collapsed);
+    });
+  }
+
+  private static getRotation(collapsed: boolean): number {
+    return collapsed ? 90 : 0;
+  }
+
+  build() {
+    Row() {
+      Text(this._category)
+        .fontSize(15)
+        .fontColor($r('app.color.theme_onSurface'))
+        .layoutWeight(1)
+      Image($r('app.media.ic_outline_expand_more_24'))
+        .width(24)
+        .height(24)
+        .fillColor($r('app.color.theme_onSurfaceVariant'))
+        .rotate({ angle: this._rotation })
+    }
+    .width('100%')
+    .padding({ top: 5, bottom: 5, left: 5 })
+    .onClick(() => {
+      if (this.header !== null) {
+        const header = this.header;
+        this.setIsCollapsed(!header.isCollapsed());
+        // let the indicator animation play before the adapter rebuilds the list
+        setTimeout(() => this.onCategoryClick(header), 120);
+      }
+    })
+  }
+}
