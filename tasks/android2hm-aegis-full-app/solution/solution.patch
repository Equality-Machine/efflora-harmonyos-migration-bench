+/**
+ * Port of FabScrollHelper: hides the floating action button when scrolling down and shows it
+ * again when scrolling up.
+ */
+export class FabScrollHelper {
+  private _visible: boolean = true;
+  private _listener: (visible: boolean) => void;
+
+  constructor(listener: (visible: boolean) => void) {
+    this._listener = listener;
+  }
+
+  onScroll(dx: number, dy: number): void {
+    if (dy > 0 && this._visible) {
+      this.setVisible(false);
+    } else if (dy < 0 && !this._visible) {
+      this.setVisible(true);
+    }
+  }
+
+  setVisible(visible: boolean): void {
+    if (this._visible === visible) {
+      return;
+    }
+    this._visible = visible;
+    this._listener(visible);
+  }
+
+  isVisible(): boolean {
+    return this._visible;
+  }
+}
