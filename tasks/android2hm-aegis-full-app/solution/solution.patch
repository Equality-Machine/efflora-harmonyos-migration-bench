+  private onStart(): void {
+    const vaultManager = this._activity.getVaultManager();
+    if (vaultManager.isVaultInitNeeded()) {
+      if (this._activity.getPreferences().isIntroDone()) {
+        this._activity.showToast($r('app.string.vault_not_found'));
+      }
+      this.startIntroActivity();
+      return;
+    }
+
+    // If the vault is not loaded yet, try to load it now in case it's plain text
+    if (!vaultManager.isVaultLoaded()) {
+      let vaultFile: VaultFile;
+      try {
+        vaultFile = VaultRepository.readVaultFile(AegisModule.getContext());
+      } catch (e) {
+        Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.vault_load_error'), e as Error, () => {
+          this.getUIAbilityContext().terminateSelf();
+        });
+        return;
+      }
+
+      if (!vaultFile.isEncrypted()) {
+        try {
+          vaultManager.loadFrom(vaultFile);
+        } catch (e) {
+          Dialogs.showErrorDialog(this.getUIContext(), $r('app.string.vault_load_error'), e as Error, () => {
+            this.getUIAbilityContext().terminateSelf();
+          });
+          return;
+        }
+      }
+    }
+
+    if (!vaultManager.isVaultLoaded()) {
+      this.startAuthActivity(false);
+      return;
+    } else if (this._loaded) {
+      // update the list of groups in the entry list view so that the chip gets updated
+      this.setGroups(vaultManager.getVault().getUsedGroups());
+
+      // update the usage counts in case they are edited outside of the EntryListView
+      this._entryListView.setUsageCounts(this._activity.getPreferences().getUsageCounts());
+      this._entryListView.setLastUsedTimestamps(this._activity.getPreferences().getLastUsedTimestamps());
+
+      // refresh all codes to prevent showing old ones
+      this._entryListView.refresh(false);
+      this._entryListView.onRefreshStart();
+    } else {
+      this.loadEntries();
+      this.checkTimeSyncSetting();
+      this.checkIconOptimization();
+      this._entryListView.onRefreshStart();
+    }
+
+    this._lockBackPressEnabled = vaultManager.isAutoLockEnabled(Preferences.AUTO_LOCK_ON_BACK_BUTTON);
+
+    this.handleIncomingIntent();
+    this.updateLockIcon();
+    this.updateSortCategoryMenu();
+    this.doShortcutActions();
+    this.updateErrorCard();
+  }
