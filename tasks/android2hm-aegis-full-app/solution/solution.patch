+import { common } from '@kit.AbilityKit';
+import { Preferences } from './Preferences';
+import { AppDatabase } from './database/AppDatabase';
+import { AuditLogRepository } from './database/AuditLogRepository';
+import { VaultManager } from './vault/VaultManager';
+import { IconPackManager } from './icons/IconPackManager';
+
+/**
+ * Replacement for the Hilt module: provides the application wide singletons.
+ */
+export class AegisModule {
+  private static _context: common.Context | null = null;
+  private static _abilityContext: common.UIAbilityContext | null = null;
+  private static _uiContext: UIContext | null = null;
+  private static _prefs: Preferences | null = null;
+  private static _db: AppDatabase | null = null;
+  private static _auditLogRepository: AuditLogRepository | null = null;
+  private static _vaultManager: VaultManager | null = null;
+  private static _iconPackManager: IconPackManager | null = null;
+
+  static init(context: common.Context): void {
+    AegisModule._context = context;
+  }
+
+  static setAbilityContext(context: common.UIAbilityContext): void {
+    AegisModule._abilityContext = context;
+    if (AegisModule._context === null) {
+      AegisModule._context = context;
+    }
+  }
+
+  static isInitialized(): boolean {
+    return AegisModule._context !== null;
+  }
+
+  static getContext(): common.Context {
+    if (AegisModule._context === null) {
+      throw new Error('AegisModule has not been initialized');
+    }
+    return AegisModule._context;
+  }
+
+  static getAbilityContext(): common.UIAbilityContext {
+    if (AegisModule._abilityContext === null) {
+      throw new Error('No UIAbility context available');
+    }
+    return AegisModule._abilityContext;
+  }
+
+  static hasAbilityContext(): boolean {
+    return AegisModule._abilityContext !== null;
+  }
+
+  static setUIContext(uiContext: UIContext): void {
+    AegisModule._uiContext = uiContext;
+  }
+
+  static getUIContext(): UIContext | null {
+    return AegisModule._uiContext;
+  }
+
+  static getPreferences(): Preferences {
+    if (AegisModule._prefs === null) {
+      AegisModule._prefs = new Preferences(AegisModule.getContext());
+    }
+    return AegisModule._prefs;
+  }
+
+  static provideAppDatabase(): AppDatabase {
+    if (AegisModule._db === null) {
+      AegisModule._db = new AppDatabase(AegisModule.getContext());
+    }
+    return AegisModule._db;
+  }
+
+  static provideAuditLogRepository(): AuditLogRepository {
+    if (AegisModule._auditLogRepository === null) {
+      AegisModule._auditLogRepository = new AuditLogRepository(AegisModule.provideAppDatabase().auditLogDao());
+    }
+    return AegisModule._auditLogRepository;
+  }
+
+  static provideVaultManager(): VaultManager {
+    if (AegisModule._vaultManager === null) {
+      AegisModule._vaultManager = new VaultManager(AegisModule.getContext(), AegisModule.provideAuditLogRepository());
+    }
+    return AegisModule._vaultManager;
+  }
+
+  static provideIconPackManager(): IconPackManager {
+    if (AegisModule._iconPackManager === null) {
+      AegisModule._iconPackManager = new IconPackManager(AegisModule.getContext());
+    }
+    return AegisModule._iconPackManager;
+  }
+}
