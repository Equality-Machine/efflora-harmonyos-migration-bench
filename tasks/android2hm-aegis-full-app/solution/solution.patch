+  }
+
+  setCurrentSortCategory(category: SortCategory): void {
+    this.putInt('pref_current_sort_category', category);
+  }
+
+  getCurrentSortCategory(): SortCategory {
+    return SortCategoryUtils.fromInteger(this.getInt('pref_current_sort_category', 0));
+  }
+
+  getTapToRevealTime(): number {
+    return this.getInt('pref_tap_to_reveal_time', 30);
+  }
+
+  getCurrentTheme(): Theme {
+    return ThemeUtils.fromInteger(this.getInt('pref_current_theme', Theme.SYSTEM));
+  }
+
+  setCurrentTheme(theme: Theme): void {
+    this.putInt('pref_current_theme', theme);
+  }
+
+  isDynamicColorsEnabled(): boolean {
+    return this.getBoolean('pref_dynamic_colors', false);
+  }
+
+  getCurrentViewMode(): ViewMode {
+    return ViewModeUtils.fromInteger(this.getInt('pref_current_view_mode', 0));
+  }
+
+  setCurrentViewMode(viewMode: ViewMode): void {
+    this.putInt('pref_current_view_mode', viewMode);
+  }
+
+  getAccountNamePosition(): AccountNamePosition {
+    return AccountNamePositionUtils.fromInteger(this.getInt('pref_account_name_position', AccountNamePosition.END));
+  }
+
+  setAccountNamePosition(accountNamePosition: AccountNamePosition): void {
+    this.putInt('pref_account_name_position', accountNamePosition);
+  }
+
+  getUsageCount(uuid: string): number {
+    const usageCount = this.getUsageCounts().get(uuid);
+    return usageCount !== undefined ? usageCount : 0;
+  }
+
+  resetUsageCount(uuid: string): void {
+    const usageCounts = this.getUsageCounts();
+    usageCounts.set(uuid, 0);
+    this.setUsageCount(usageCounts);
+  }
+
+  getLastUsedTimestamp(uuid: string): number {
+    const timestamps = this.getLastUsedTimestamps();
+    const timestamp = timestamps.get(uuid);
+    return timestamp !== undefined ? timestamp : 0;
