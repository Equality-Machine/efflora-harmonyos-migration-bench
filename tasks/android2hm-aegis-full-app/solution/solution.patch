+    try {
+      switch (lowerCasedType) {
+        case TotpInfo.ID:
+          info = new TotpInfo(secret, algo, digits, this.parsePeriod());
+          break;
+        case SteamInfo.ID:
+          info = new SteamInfo(secret, algo, digits, this.parsePeriod());
+          break;
+        case HotpInfo.ID: {
+          const counter = EditEntryActivity.parseInteger(this._textPeriodCounter);
+          if (counter === null) {
+            throw new EditEntryActivityParseException('Counter is not an integer.');
+          }
+          info = new HotpInfo(secret, algo, digits, counter);
+          break;
+        }
+        case YandexInfo.ID:
+          info = new YandexInfo(secret, this._textPin);
+          break;
+        case MotpInfo.ID:
+          info = new MotpInfo(secret, this._textPin);
+          break;
+        default:
+          throw new Error(`Unsupported OTP type: ${type}`);
+      }
+
+      info.setDigits(digits);
+      info.setAlgorithm(algo);
+    } catch (e) {
+      if (e instanceof OtpInfoException) {
+        throw new EditEntryActivityParseException('The entered info is incorrect: ' + (e as Error).message);
+      }
+      throw e as Error;
+    }
+
+    const origEntry = this._origEntry as VaultEntry;
+    const entry = origEntry.clone();
+    entry.setInfo(info);
+    entry.setIssuer(this._textIssuer);
+    entry.setName(this._textName);
+    entry.setNote(this._textNote);
+
+    if (this._selectedGroups.length === 0) {
+      entry.setGroups(new Set<string>());
+    } else {
+      entry.setGroups(new Set<string>(this._selectedGroups));
+    }
+
+    if (this._hasChangedIcon) {
+      if (this._hasCustomIcon) {
+        let icon: VaultEntryIcon;
+        const selectedIcon = this._selectedIcon;
+        if (selectedIcon === null) {
+          if (this._customIcon === null) {
+            if (this._iconMode === ICON_MODE_ENTRY && origEntry.getIcon() !== null) {
+              icon = origEntry.getIcon() as VaultEntryIcon;
+            } else {
+              throw new EditEntryActivityParseException('The icon is not ready yet.');
+            }
+          } else {
+            icon = this._customIcon;
+          }
+        } else {
+          let iconBytes: Uint8Array;
+          try {
+            const file = selectedIcon.getFile();
+            if (file === null) {
+              throw new Error('Icon file not found');
+            }
+            iconBytes = IOUtils.readFile(file);
+          } catch (e) {
+            throw new EditEntryActivityParseException((e as Error).message);
+          }
+          icon = new VaultEntryIcon(iconBytes, selectedIcon.getIconType());
+        }
+
+        entry.setIcon(icon);
+      } else {
+        entry.setIcon(null);
+      }
+    }
+
+    return entry;
+  }
+
+  private onSaveError(msg: string): void {
+    Dialogs.showSimpleDialog(this.getUIContext(), this.str('saving_profile_error'), msg,
+      $r('app.string.ok'), null, null, null, undefined, undefined, true);
+  }
+
+  private async onSave(): Promise<boolean> {
+    if (this._iconBackPressHandler.isEnabled()) {
+      this.stopEditingIcon(true);
+    }
+    await this.waitForPendingIcon();
+
+    let entry: VaultEntry;
+    try {
+      entry = this.parseEntry();
+    } catch (e) {
+      this.onSaveError((e as Error).message);
+      return false;
+    }
+
+    if (this._isNew) {
+      for (const existing of this.act().getVaultManager().getVault().getEntries()) {
+        if (entry.hasSameNameAndIssuer(existing)) {
+          this.showDuplicateBottomSheet(entry);
+          return false;
+        }
+      }
+    }
+
+    this.addAndFinish(entry);
+    return true;
+  }
+
+  private showDuplicateBottomSheet(newEntry: VaultEntry): void {
+    const vault = this.act().getVaultManager().getVault();
+    const params = new DuplicateEntryDialogParams();
+
+    const baseName = newEntry.getName();
+    const existingNames = new Set<string>();
+    for (const e of vault.getEntries()) {
+      if (e.getIssuer() === newEntry.getIssuer()) {
+        existingNames.add(e.getName());
+      }
+    }
+
+    let counter = 2;
+    let newName: string;
+    do {
+      newName = `${baseName} #${counter++}`;
+    } while (existingNames.has(newName));
+
+    params.suffixSubtitle = this.str('dialog_duplicate_entry_suffix_subtitle', [newName]);
+
+    params.onOverwrite = () => {
+      const duplicates: VaultEntry[] = [];
+      for (const existing of vault.getEntries()) {
+        if (existing.hasSameNameAndIssuer(newEntry)) {
+          duplicates.push(existing);
+        }
+      }
+
+      const message = this.act().getQuantityString('dialog_duplicate_entry_overwrite_dialog_message',
+        duplicates.length, [duplicates.length, newEntry.getIssuer(), newEntry.getName()]);
+
+      Dialogs.showSimpleDialog(this.getUIContext(), $r('app.string.dialog_duplicate_entry_overwrite_dialog_title'), message,
+        $r('app.string.action_delete'), () => {
+          for (const dup of duplicates) {
+            vault.removeEntry(dup);
+          }
+
+          params.handle.dismiss();
+          this.addAndFinish(newEntry);
+        },
+        $r('app.string.no'), null);
+    };
+
+    const finalNewName = newName;
+    params.onAddSuffix = () => {
+      newEntry.setName(finalNewName);
+      params.handle.dismiss();
+      this.addAndFinish(newEntry);
+    };
+
+    BottomSheetDialog.open<DuplicateEntryDialogParams>(this.getUIContext(), wrapBuilder(buildDuplicateEntryDialog), params,
+      params.handle, false);
+  }
+
+  private updateBackPressHandlerState(): void {
+    let entry: VaultEntry | null = null;
+    try {
+      entry = this.parseEntry();
+    } catch (ignored) {
+    }
+
+    const backEnabled = this.hasUnsavedChanges(entry);
+    this._backPressHandler.setEnabled(backEnabled);
+  }
