@@ -0,0 +1,38 @@
+const STEAM_ALPHABET: string = '23456789BCDFGHJKMNPQRTVWXY';
+
+export class OTP {
+  private readonly _code: number;
+  private readonly _digits: number;
+
+  constructor(code: number, digits: number) {
+    this._code = code;
+    this._digits = digits;
+  }
+
+  getCode(): number {
+    return this._code;
+  }
+
+  getDigits(): number {
+    return this._digits;
+  }
+
+  toString(): string {
+    const code = this._code % Math.pow(10, this._digits);
+    let res = Math.floor(code).toString();
+    while (res.length < this._digits) {
+      res = '0' + res;
+    }
+    return res;
+  }
+
+  toSteamString(): string {
+    let code = this._code;
+    let res = '';
+    for (let i = 0; i < this._digits; i++) {
+      res += STEAM_ALPHABET.charAt(code % STEAM_ALPHABET.length);
+      code = Math.floor(code / STEAM_ALPHABET.length);
+    }
+    return res;
+  }
+}
