new file mode 100644
index 0000000..c2010af
--- /dev/null
+++ b/entry/src/main/ets/importers/TwoFASImporter.ets
@@ -0,0 +1,186 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterResult, DatabaseImporterState, DecryptListener } from './DatabaseImporter';
+import { DatabaseImporterEntryException } from './DatabaseImporterEntryException';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { CryptoUtils, SecretKey } from '../crypto/CryptoUtils';
+import { Base64 } from '../encoding/Base64';
+import { GoogleAuthInfo } from '../otp/GoogleAuthInfo';
+import { HotpInfo } from '../otp/HotpInfo';
+import { OtpInfo } from '../otp/OtpInfo';
+import { SteamInfo } from '../otp/SteamInfo';
+import { TotpInfo } from '../otp/TotpInfo';
+import { Dialogs } from '../ui/dialogs/Dialogs';
+import { JSONArray, JSONObject } from '../util/JSONObject';
+import { JsonUtils } from '../util/JsonUtils';
+import { Bytes } from '../util/Bytes';
+import { VaultEntry } from '../vault/VaultEntry';
+
+const ITERATION_COUNT: number = 10000;
+
+const KEY_SIZE: number = 256; // bits
+
+/**
+ * Splits like Java's String.split(): trailing empty strings are removed.
+ */
+function javaSplit(s: string, separator: string): string[] {
+  const parts = s.split(separator);
+  while (parts.length > 1 && parts[parts.length - 1].length === 0) {
+    parts.pop();
+  }
+
+  return parts;
+}
+
+export class TwoFASImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    throw new DatabaseImporterException('Unsupported operation');
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    try {
+      const json = Bytes.toUtf8(stream);
+      const obj = new JSONObject(json);
+      const version = obj.getInt('schemaVersion');
+      if (version > 4) {
+        throw new DatabaseImporterException(`Unsupported schema version: ${version}`);
+      }
+      const encryptedString = JsonUtils.optString(obj, 'servicesEncrypted');
+      if (encryptedString === null) {
+        const array = obj.getJSONArray('services');
+        const entries = TwoFASImporter.arrayToList(array);
+        return new TwoFASImporterDecryptedState(entries);
+      }
+      const parts = javaSplit(encryptedString, ':');
+      if (parts.length < 3) {
+        throw new DatabaseImporterException(`Unexpected format of encrypted data (parts: ${parts.length})`);
+      }
+      const data = Base64.decode(parts[0]);
+      const salt = Base64.decode(parts[1]);
+      const iv = Base64.decode(parts[2]);
+      return new TwoFASImporterEncryptedState(data, salt, iv);
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterException) {
+        throw e as DatabaseImporterException;
+      }
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  static arrayToList(array: JSONArray): JSONObject[] {
+    const list: JSONObject[] = [];
+    for (let i = 0; i < array.length(); i++) {
+      list.push(array.getJSONObject(i));
+    }
+    return list;
+  }
+}
+
+export class TwoFASImporterEncryptedState extends DatabaseImporterState {
+  private readonly _data: Uint8Array;
+  private readonly _salt: Uint8Array;
+  private readonly _iv: Uint8Array;
+
+  constructor(data: Uint8Array, salt: Uint8Array, iv: Uint8Array) {
+    super(true);
+    this._data = data;
+    this._salt = salt;
+    this._iv = iv;
+  }
+
+  private async deriveKey(password: string): Promise<SecretKey> {
+    const key = await CryptoUtils.pbkdf2('SHA256', CryptoUtils.toBytes(password), this._salt, ITERATION_COUNT, KEY_SIZE / 8);
+    return new SecretKey(key);
+  }
+
+  async decryptWithPassword(password: string): Promise<TwoFASImporterDecryptedState> {
+    let key: SecretKey;
+    try {
+      key = await this.deriveKey(password);
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+    try {
+      const decrypted = CryptoUtils.decryptGcmWithAppendedTag(key.getEncoded(), this._iv, this._data);
+      const json = Bytes.toUtf8(decrypted);
+      return new TwoFASImporterDecryptedState(TwoFASImporter.arrayToList(new JSONArray(json)));
+    }
+    catch (e) {
+      throw new DatabaseImporterException((e as Error).message);
+    }
+  }
+
+  decrypt(uiContext: UIContext, listener: DecryptListener): void {
+    Dialogs.showPasswordInputDialog(uiContext, (password: string) => {
+      this.decryptWithPassword(password)
+        .then((state: TwoFASImporterDecryptedState) => listener.onStateDecrypted(state))
+        .catch((e: Error) => listener.onError(e));
+    }, () => listener.onCanceled(), $r('app.string.enter_password_2fas_message'), $r('app.string.set_password'));
+  }
+}
+
+export class TwoFASImporterDecryptedState extends DatabaseImporterState {
+  private readonly _entries: JSONObject[];
+
+  constructor(entries: JSONObject[]) {
+    super(false);
+    this._entries = entries;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = new DatabaseImporterResult();
+    for (const obj of this._entries) {
+      try {
+        const entry = TwoFASImporterDecryptedState.convertEntry(obj);
+        result.addEntry(entry);
+      }
+      catch (e) {
+        result.addError(e as DatabaseImporterEntryException);
+      }
+    }
+    return result;
+  }
+
+  private static convertEntry(obj: JSONObject): VaultEntry {
+    try {
+      const secret = GoogleAuthInfo.parseSecret(obj.getString('secret'));
+      const info = obj.getJSONObject('otp');
+      let issuer = obj.optString('name');
+      if (issuer.length === 0) {
+        issuer = info.optString('issuer');
+      }
+      const name = info.optString('account');
+      const digits = info.optInt('digits', OtpInfo.DEFAULT_DIGITS);
+      const algorithm = info.optString('algorithm', OtpInfo.DEFAULT_ALGORITHM);
+      let otp: OtpInfo;
+      const tokenType = JsonUtils.optString(info, 'tokenType');
+      if (tokenType === null || tokenType === 'TOTP') {
+        const period = info.optInt('period', TotpInfo.DEFAULT_PERIOD);
+        otp = new TotpInfo(secret, algorithm, digits, period);
+      }
+      else if (tokenType === 'HOTP') {
+        const counter = info.optLong('counter', 0);
+        otp = new HotpInfo(secret, algorithm, digits, counter);
+      }
+      else if (tokenType === 'STEAM') {
+        const period = info.optInt('period', TotpInfo.DEFAULT_PERIOD);
+        otp = new SteamInfo(secret, algorithm, digits, period);
+      }
+      else {
+        throw new DatabaseImporterEntryException(`Unrecognized tokenType: ${tokenType}`, obj.toString());
+      }
+      return new VaultEntry(otp, name, issuer);
+    }
+    catch (e) {
+      if (e instanceof DatabaseImporterEntryException) {
+        throw e as DatabaseImporterEntryException;
+      }
+      throw new DatabaseImporterEntryException((e as Error).message, obj.toString());
+    }
+  }
+}
diff --git a/entry/src/main/ets/importers/WinAuthImporter.ets b/entry/src/main/ets/importers/WinAuthImporter.ets
new file mode 100644
index 0000000..69d0549
--- /dev/null
+++ b/entry/src/main/ets/importers/WinAuthImporter.ets
@@ -0,0 +1,38 @@
+import { common } from '@kit.AbilityKit';
+import { DatabaseImporter, DatabaseImporterState, DatabaseImporterResult } from './DatabaseImporter';
+import { DatabaseImporterException } from './DatabaseImporterException';
+import { GoogleAuthUriImporter } from './GoogleAuthUriImporter';
+
+export class WinAuthImporter extends DatabaseImporter {
+  constructor(context: common.Context) {
+    super(context);
+  }
+
+  protected getAppPath(): string {
+    throw new DatabaseImporterException('Unsupported operation');
+  }
+
+  async read(stream: Uint8Array, isInternal: boolean = false): Promise<DatabaseImporterState> {
+    const importer = new GoogleAuthUriImporter(this.requireContext());
+    const state = await importer.read(stream);
+    return new WinAuthImporterState(state);
+  }
+}
+
+export class WinAuthImporterState extends DatabaseImporterState {
+  private _state: DatabaseImporterState;
+
+  constructor(state: DatabaseImporterState) {
+    super(false);
+    this._state = state;
+  }
+
+  async convert(): Promise<DatabaseImporterResult> {
+    const result = await this._state.convert();
+    for (const entry of result.getEntries().getValues()) {
+      entry.setIssuer(entry.getName());
+      entry.setName('WinAuth');
+    }
+    return result;
+  }
+}
